 			assert.equal(r.children[1], Layout.Invalidate(t)) -- a layer's child is free: placed on its own
 		end)
 
+		it("ignores a one-line text change inside a cell of a given width", function()
+			local t = text("12")
+			local column = box({ width = 200, position = "absolute", left = 0 }, { t })
+			run(root({ column }))
+			t.natW = 30
+			assert.is_false(Layout.TextResized(t, 12, LINE))
+			t.natW = 300 -- wraps now
+			assert.is_true(Layout.TextResized(t, 30, LINE))
+		end)
+
+		it("counts a one-line text change that sizes a column or its box", function()
+			local label = text("ab")
+			local row = box({ width = 200, columns = { "auto", "1fr" } }, { label, box({ height = 4 }) })
+			run(root({ row }))
+			label.natW = 30
+			assert.is_true(Layout.TextResized(label, 12, LINE))
+			local inner = text("ab")
+			local shrinkWrapped = box({}, { inner })
+			run(root({ shrinkWrapped }))
+			inner.natW = 30
+			assert.is_true(Layout.TextResized(inner, 12, LINE))
+		end)
+
+		it("ignores it through stretched levels down from a fixed width", function()
+			local leaf = text("1 / 1")
+			local node = leaf
+			for _ = 1, 5 do
+				node = box({ padding = 1 }, { node })
+			end
+			local top = box({ width = 300, height = 300 }, { node })
+			run(root({ top }))
+			leaf.natW = 42
+			assert.is_false(Layout.TextResized(leaf, 30, LINE))
+		end)
+
 		it("returns nil for a detached node", function()
 			assert.is_nil(Layout.Invalidate(text("x")))
 		end)
