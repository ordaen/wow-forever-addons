{
  "name": "wow-forever-addons",
  "private": true,
  "description": "Dev tooling only (commit linting). The addons themselves are LunaType, built by the lunatype compiler.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "../lunatype/zig-out/bin/lunatype build addons ../lunatype/zig-out/addons --watch --link \"C:/Program Files (x86)/World of Warcraft/_forever_/Interface/AddOns\"",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
