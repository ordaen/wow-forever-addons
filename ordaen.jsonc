// Settings shared by every addon in this repo. `ordaen build` (wow-dev-tools) writes them into each generated TOC.
// Per addon, addon.jsonc holds what its code can't say; the file list, dependencies and SavedVariables come from
// the code. See CLAUDE.md, "Build".
{
  // WoW Forever's interface version. A Forever patch that changes it is a one-line change here.
  "interface": 16001,

  // Languages every addon with a locales/ folder translates completely (enUS is the base and the fallback).
  "locales": ["enUS", "ruRU"],

  // Each category's name per client language (the `## Category-xxXX` lines), copied from Blizzard-installed
  // addons with the same category so ours share their group in the addon list.
  "categories": {
    "Chat": {
      "deDE": "Chat",
      "esES": "Chat",
      "esMX": "Chat",
      "frFR": "Discussion",
      "itIT": "Chat",
      "koKR": "대화",
      "ptBR": "Bate-papo",
      "ruRU": "Чат",
      "zhCN": "聊天",
      "zhTW": "對話"
    },
    "Libraries": {
      "deDE": "Bibliotheken",
      "esES": "Bibliotecas",
      "esMX": "Bibliotecas",
      "frFR": "Bibliothèques",
      "itIT": "Librerie",
      "koKR": "라이브러리",
      "ptBR": "Bibliotecas",
      "ruRU": "Библиотеки",
      "zhCN": "函数库",
      "zhTW": "函式庫"
    },
    "Inventory": {
      "deDE": "Inventar",
      "esES": "Inventario",
      "esMX": "Inventario",
      "frFR": "Inventaire",
      "itIT": "Inventario",
      "koKR": "소지품",
      "ptBR": "Inventário",
      "ruRU": "Инвентарь",
      "zhCN": "物品栏",
      "zhTW": "物品欄"
    },
    "User Interface": {
      "deDE": "Benutzerinterface",
      "esES": "Interfaz de usuario",
      "esMX": "Interfaz de usuario",
      "frFR": "Interface utilisateur",
      "itIT": "Interfaccia utente",
      "koKR": "사용자 인터페이스",
      "ptBR": "Interface do usuário",
      "ruRU": "Интерфейс пользователя",
      "zhCN": "用户界面",
      "zhTW": "使用者介面"
    }
  }
}
