{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "lunatype hook pre-tool-use 2>/dev/null || true",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
