// «Legacy»: Forever's own system, as its window has it, under two sub tabs. «Tree»: its three trees (Professions,
// Adventure, Resourcefulness) in a column at the left, the picked one drawn as the talents are (Ordaen's
// `TalentTreeView`: the client's frames and arrows), bought with the account's Legacy points, which each character
// spends on its own: a left click buys a rank, a right one gives it back, held until «Apply»; «Undo» takes the changes
// back (a tree is reset at the game's own NPC alone). The points left and the buttons are the footer's. «Rewards»: the
// reward track as the game's window draws it, its art and its layout: the rank in the emblem, the bar, four cards of
// levels at a time, each its reward, the arrows turning the track a card at a time. Everything waits for the track's
// first rank, as the game's window does.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Align, ByInteractionState, Edges, Position, Track } from "$ltml"
import { BUTTON_HEIGHT, ButtonPlate, Component, FooterBand, PushButton, TITLE_TEXT, Tabs, TalentTreeView } from "Ordaen"
import Locale from "@/locales"
import Style from "@/style"

// The reward track's faction (`Constants.LegacyConsts.LEGACY_REWARD_TRACK_FACTION_ID`).
public const TRACK = 2802
// A Legacy tree: its trait tree, its name and its emblem (`LegacyTreeData`).
public struct TreeKind {
  id: integer
  name: string
  icon: Atlas
}
const TREES: array<TreeKind> = [
  { id: 1187, name: Locale::TREE_PROFESSIONS, icon: "UI-Legacy-Tree-Professions" },
  { id: 1188, name: Locale::TREE_ADVENTURE, icon: "UI-Legacy-Tree-Adventure" },
  { id: 1189, name: Locale::TREE_PROGRESSION, icon: "UI-Legacy-Tree-Progression" }
]
const SUBS: array<string> = [Locale::SUB_TREE, Locale::SUB_REWARDS]
const BUTTON: number<Length> = 140dp
// The footer's band: the points in its middle, the buttons at its right.
const FOOTER: array<Track> = [{ fr: 1 }, "max-content", { fr: 1 }]
// The trees' column: each a row edge to edge, its emblem large.
const TREE_EMBLEM: number<Length> = 44dp
const TREE_ROW: array<Track> = [TREE_EMBLEM, { fr: 1 }]
const TREE_PAD: Edges = { top: 4sp, right: 4sp, bottom: 4sp, left: 6sp }
const TREE_SHADE: ByInteractionState<Color> = { default: Color::hex("#00000000"), hover: Color::hex("#ffffff14") }
const TREE_PICKED: Color = Color::hex("#00000059")
const TREE_LIGHT: Color = Color::hex("#d6a56b")
const CLEAR: Color = Color::hex("#00000000")
const RULE: Color = Color::hex("#d6a56b33")

// The reward track's art and sizes, the game's (`Blizzard_LegacyRewardTrack.xml`).
const TRACK_BACK: Atlas = "Legacy-Rewards-Tracker-background"
const TRACK_EMBLEM: Atlas = "Legacy-Rewards-Tracker-Icon"
const BAR_BACK: Atlas = "Legacy-Progressbar-BG"
const BAR_FILL: Atlas = "Legacy-Progressbar-Fill"
const BAR_FRAME: Atlas = "Legacy-Progressbar-Frame"
const CARD_EARNED: Atlas = "Legacy-Rewards-Tracker-Cards"
const CARD_LAST: Atlas = "Legacy-Rewards-Tracker-Cards-Green"
const CARD_LOCKED: Atlas = "Legacy-Rewards-Tracker-Cards-Disable"
const DIAMOND: Atlas = "Legacy-Rewards-Tracker-Diamond"
const DIAMOND_LOCKED: Atlas = "Legacy-Rewards-Tracker-Diamond-Disable"
const ICON_FRAME: Atlas = "Legacy-Rewards-Tracker-Icons-Frame"
const ICON_FRAME_LOCKED: Atlas = "Legacy-Rewards-Tracker-Icons-Frame-Disable"
const CHECK: Atlas = "worldquest-tracker-checkmark"
const ARROW: Atlas = "Legacy-Rewards-Tracker-Arrow-Big-Left"
const ARROW_OFF: Atlas = "Legacy-Rewards-Tracker-Arrow-Big-Left-disable"
const EMBLEM_WIDTH = 108ui
const EMBLEM_HEIGHT = 155ui
const BAR_WIDTH = 850ui
const BAR_HEIGHT = 12ui
const CARD_WIDTH = 216ui
const CARD_HEIGHT = 241ui
// Four cards at a time, side by side under the bar.
const CARDS = 4
const ARROW_WIDTH = 25ui
const ARROW_HEIGHT = 40ui
const DIAMOND_SIZE = 56ui
const ICON_SIZE = 64ui
const ICON_FRAME_SIZE = 80ui
const CHECK_WIDTH = 40ui
const CHECK_HEIGHT = 35ui
// Where each of the four cards stands along the bar, out of 100 (`STATIC_CARD_POSITION_TO_PROGRESS`).
const CARD_AT: array<number> = [12, 38, 63, 88]
const WHITE: Color = Color::hex("#ffffff")
const DISABLED: Color = Color::hex("#7f7f7f")

// Whether the player has the reward track's first level: what opens every page.
public function legacyOpen(): boolean { return Client::C_MajorFactions::GetCurrentRenownLevel(TRACK) > 0 }

// A level of the reward track and its first reward (and how many more it gives).
public struct Level {
  level: integer
  reached: boolean
  // The level the player has now: its card is green.
  last: boolean
  name: string
  icon: FileId | nil
}

function levelsOf(): array<Level> {
  const reached = Client::C_MajorFactions::GetCurrentRenownLevel(TRACK).floor()
  const list: array<Level> = mut []
  for (info of Client::C_MajorFactions::GetRenownLevels(TRACK)) {
    const level = info.level.floor()
    const rewards: array<Client::MajorFactionRenownRewardInfo> = mut []
    for (reward of Client::C_MajorFactions::GetRenownRewardsForLevel(TRACK, level)) { rewards.push(reward) }
    rewards.sort((a, b) => a.uiOrder < b.uiOrder)
    const first = rewards[1]
    const more = rewards.length > 1 ? " +" + string::of(rewards.length - 1) : ""
    list.push({ level: level, reached: level <= reached, last: level == reached, name: (first?.name ?? "") + more, icon: first?.icon })
  }
  return list
}

// How far the bar is filled, out of 100, with the cards from `first` shown: Blizzard's `SetupProgressDetails` for a
// track of cards that stand still. Under the first card's level it fills from the bar's start to the first card; between
// two cards, by how far the player is from the one to the next.
function filledOf(levels: array<Level>, rank: integer, earned: number, threshold: number, first: integer): number {
  let reachedAt = 0
  let toNext: number = rank
  let gap = 100.0
  let last = 0
  for (index, level of levels) {
    if (rank >= level.level) {
      reachedAt = index
      toNext -= level.level - last
    } else {
      gap = level.level - last
      break
    }
    last = level.level
  }
  // Within a level, how far by the reputation earned toward the next.
  const part = threshold > 0 ? (toNext + earned / threshold) / gap : toNext / gap
  if (reachedAt < 1 && first <= 1) { return CARD_AT[1] * part.min(1) }
  if (reachedAt < first) { return 0 }
  if (reachedAt >= first + CARDS) { return 100 }
  const at = reachedAt - first + 1
  const here = CARD_AT[at] ?? 100
  const next = CARD_AT[at + 1] ?? 100
  return here + (next - here) * part.min(1)
}

// The four levels from `first`, as many as there are.
function windowOf(levels: array<Level>, first: integer): array<Level> {
  const list: array<Level> = mut []
  for (index, level of levels) {
    if (index >= first && index < first + CARDS) { list.push(level) }
  }
  return list
}

// A tree in the trees' column: its emblem and its name, the picked one shaded with a light along its left.
public class TreeChoice implements Component {
  public pick: Event<integer> = new Event()
  derived picked: boolean = self.index == self.chosen
  derived background: Color | ByInteractionState<Color> = self.picked ? TREE_PICKED : TREE_SHADE
  derived light: Color = self.picked ? TREE_LIGHT : CLEAR
  derived ink: Color = self.picked ? Style::WHITE_INK : Style::INK

  tree: Signal<TreeKind>
  const index: integer
  chosen: Signal<integer>
  constructor(tree: Signal<TreeKind>, index: integer, chosen: Signal<integer>) {
    self.tree = tree
    self.index = index
    self.chosen = chosen
  }

  mut onPick() { self.pick.emit(self.index) }

  public render(): Template {
    return $ltml {
      <box columns={TREE_ROW} gap={4sp} padding={TREE_PAD} yAlign={Align::Center} background={self.background}
           @pointerPress(.Left)={self.onPick} @keyPress(.Enter)={self.onPick} @keyPress(.Space)={self.onPick}>
        <box position={Position::Absolute} left={0ui} top={0ui} bottom={0ui} width={3ui} background={self.light} />
        <box width={TREE_EMBLEM} height={TREE_EMBLEM} icon={self.tree.icon} />
        <text value={self.tree.name} textSize={TITLE_TEXT} textFont={.Title} textColor={self.ink} wrap={.None} />
      </box>
    }
  }
}

// A card of the reward track: the game's card, its level in the diamond over its top, its reward's icon in its frame,
// the reward's name under it, a check while earned.
public class RewardCard implements Component {
  derived back: Atlas = self.level.last ? CARD_LAST : self.level.reached ? CARD_EARNED : CARD_LOCKED
  derived diamond: Atlas = self.level.reached ? DIAMOND : DIAMOND_LOCKED
  derived frame: Atlas = self.level.reached ? ICON_FRAME : ICON_FRAME_LOCKED
  derived ink: Color = self.level.reached ? WHITE : DISABLED

  level: Signal<Level>
  constructor(level: Signal<Level>) { self.level = level }

  public render(): Template {
    return $ltml {
      <box width={CARD_WIDTH} height={CARD_HEIGHT} background={self.back} xAlign={Align::Center}>
        <box position={Position::Absolute} top={-18ui} left={(CARD_WIDTH - DIAMOND_SIZE) / 2} width={DIAMOND_SIZE} height={DIAMOND_SIZE}
             background={self.diamond} xAlign={Align::Center} yAlign={Align::Center}>
          <text value={"%d"} arguments={[self.level.level]} textColor={self.ink} textFont={.Numbers} wrap={.None} leading={.Tight} />
        </box>
        <box $if={self.level.reached} position={Position::Absolute} top={15ui} right={20ui} width={CHECK_WIDTH} height={CHECK_HEIGHT}
             background={CHECK} />
        <box position={Position::Absolute} top={60ui - (ICON_FRAME_SIZE - ICON_SIZE) / 2} left={(CARD_WIDTH - ICON_FRAME_SIZE) / 2}
             width={ICON_FRAME_SIZE} height={ICON_FRAME_SIZE} xAlign={Align::Center} yAlign={Align::Center}>
          <box width={ICON_SIZE} height={ICON_SIZE} icon={self.level.icon} desaturate={!self.level.reached} />
          <box position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} background={self.frame} />
        </box>
        <box position={Position::Absolute} top={60ui + ICON_SIZE + (ICON_FRAME_SIZE - ICON_SIZE) / 2 + 10ui} left={(CARD_WIDTH - 120ui) / 2}
             width={120ui} xAlign={Align::Center}>
          <text value={self.level.name} textColor={self.ink} textAlign={.Center} />
        </box>
      </box>
    }
  }
}

// The page: its sub tabs and pages (`content`) and its footer, the points and the tree's buttons (`footer`).
public class Legacy {
  // While the page shows: its tree's configuration is asked then.
  public state visible = false
  // Moves when the game says a tree or the track changed: what is shown is read again.
  state touched = 0
  state sub = 1
  state treeIndex = 1
  // The first of the four cards shown.
  state first = 1
  state config: mut any Game::TalentConfig | nil = nil
  derived open: boolean = self.readOpen()
  derived treeKind: TreeKind = TREES[self.treeIndex] ?? panic("three trees")
  derived tree: Game::TalentTree | nil = self.readTree()
  derived points: integer = self.readPoints()
  derived staged: boolean = self.readStaged()
  derived treeShown: boolean = self.sub == 1
  derived levels: array<Level> = self.readLevels()
  derived rank: integer = self.readRank()
  derived shownLevels: array<Level> = windowOf(self.levels, self.first)
  derived filled: number = self.readFilled()
  derived fillTracks: array<Track> = [{ fr: self.filled.max(0.001) }, { fr: (100 - self.filled).max(0.001) }]
  derived canBack: boolean = self.first > 1
  derived canOn: boolean = self.first + CARDS <= self.levels.length
  // Changes wait to be applied, on the tree's page.
  derived changing: boolean = self.staged && self.treeShown && self.open
  const treePage: Template = $ltml {
    <box columns={[Style::SIDE_LIST, { fr: 1 }]} rows={[{ fr: 1 }]}>
      <box border={{ width: 1ui, color: RULE, sides: ["right"] }}>
        <TreeChoice $for={index, tree of TREES} tree={tree} index={index} chosen={self.treeIndex} @pick={self.onTree} />
      </box>
      <box padding={6sp} xAlign={Align::Center} yAlign={Align::Center}>
        <TalentTreeView $if={self.tree != nil} tree={self.tree ?? panic("tested")} titled={false} fraction={true} @spend={self.onBuy}
                        @refund={self.onRefund} />
      </box>
    </box>
  }
  const rewardsPage: Template = $ltml {
    <box background={TRACK_BACK} rows={["max-content", "max-content", "max-content", { fr: 1 }]} xAlign={Align::Center} padding={{ top: 6sp }}>
      <box width={EMBLEM_WIDTH} height={EMBLEM_HEIGHT} background={TRACK_EMBLEM} xAlign={Align::Center} yAlign={Align::Center}>
        <text value={"%d"} arguments={[self.rank]} textSize={2.2rem} textFont={.Numbers} textColor={WHITE} textOutline={1} wrap={.None} />
      </box>
      <text value={Locale::TRACK_POINTS} textSize={TITLE_TEXT} textColor={Style::GOLD} wrap={.None} />
      <box padding={{ top: 12sp }}>
        <box width={BAR_WIDTH} height={BAR_HEIGHT} background={BAR_BACK} columns={self.fillTracks}>
          <box background={BAR_FILL} />
          <box />
          <box position={Position::Absolute} left={-8ui} top={-7ui} right={-8ui} bottom={-10ui} background={BAR_FRAME} />
        </box>
      </box>
      <box columns={[ARROW_WIDTH, { fr: 1 }, ARROW_WIDTH]} yAlign={Align::Center} padding={{ top: 8sp }}>
        <box width={ARROW_WIDTH} height={ARROW_HEIGHT} background={self.canBack ? ARROW : ARROW_OFF} disabled={!self.canBack}
             @pointerPress(.Left)={self.onBack} />
        <box columns={[CARD_WIDTH, CARD_WIDTH, CARD_WIDTH, CARD_WIDTH]} xAlign={Align::Center}>
          <RewardCard $for={level of self.shownLevels} $key={level.level} level={level} />
        </box>
        <box width={ARROW_WIDTH} height={ARROW_HEIGHT} background={self.canOn ? ARROW : ARROW_OFF} rotation={180deg}
             disabled={!self.canOn} @pointerPress(.Left)={self.onOn} />
      </box>
    </box>
  }
  public const content: Template = $ltml {
    <box columns={1} rows={["max-content", { fr: 1 }]}>
      // The sub tabs' band runs to the frame's line on every side.
      <Tabs tabs={SUBS} selected={mut self.sub} />
      <box $if={!self.open} xAlign={Align::Center} yAlign={Align::Center}>
        <text value={Locale::LEGACY_LOCKED} textColor={Style::DIM} />
      </box>
      <box $elseif={self.treeShown} rows={[{ fr: 1 }]}>
        {self.treePage}
      </box>
      <box $else rows={[{ fr: 1 }]}>
        {self.rewardsPage}
      </box>
    </box>
  }
  // The points left in the band's middle, large; Undo and Apply at its right while changes wait (a tree is reset at
  // the game's own NPC, not here). The buttons' room is kept while they are gone: the band keeps its height.
  public const footer: Template = $ltml {
    <FooterBand>
      <box columns={FOOTER} yAlign={Align::Center}>
        <box />
        <box columns={["max-content", "max-content"]} gap={3sp} yAlign={Align::Center}>
          <text value={Locale::POINTS_LEFT} textSize={TITLE_TEXT} textFont={.Title} textColor={Style::GOLD} wrap={.None} />
          <text value={"%d"} arguments={[self.points]} textSize={TITLE_TEXT} textFont={.Numbers} textColor={Style::WHITE_INK} wrap={.None} />
        </box>
        <box height={BUTTON_HEIGHT} columns={["max-content", "max-content"]} gap={3sp} xAlign={Align::End} yAlign={Align::Center}>
          <PushButton $if={self.changing} label={Locale::UNDO} width={BUTTON} @click={self.onUndo} />
          <PushButton $if={self.changing} label={Locale::APPLY} width={BUTTON} plate={ButtonPlate::Accent} @click={self.onApply} />
        </box>
      </box>
    </FooterBand>
  }

  constructor() {
    Events::TRAIT_CONFIG_UPDATED.listen(self.onChanged)
    Events::TRAIT_TREE_CURRENCY_INFO_UPDATED.listen(self.onChanged)
    Events::MAJOR_FACTION_RENOWN_LEVEL_CHANGED.listen(self.onChanged)
    // The picked tree's configuration, asked again as another is picked or the game says the trees changed.
    watch {
      if (!self.visible) { return }
      _ = self.touched
      self.config = Game::talentTrees.of((TREES[self.treeIndex] ?? panic("three trees")).id)
    }
  }

  mut onChanged() { self.touched += 1 }

  readOpen(): boolean {
    _ = self.touched
    return legacyOpen()
  }

  readTree(): Game::TalentTree | nil {
    _ = self.touched
    const trees = self.config?.trees() ?? []
    return trees.find(tree => tree.id == self.treeKind.id) ?? trees[1]
  }

  readPoints(): integer {
    _ = self.touched
    return self.config?.unspent() ?? 0
  }

  readStaged(): boolean {
    _ = self.touched
    return self.config?.staged() == true
  }

  readLevels(): array<Level> {
    _ = self.touched
    return levelsOf()
  }

  readRank(): integer {
    _ = self.touched
    return Client::C_MajorFactions::GetCurrentRenownLevel(TRACK).floor()
  }

  readFilled(): number {
    const data = Client::C_MajorFactions::GetMajorFactionData(TRACK)
    if (data == nil) { return 0 }
    return filledOf(self.levels, self.rank, data.renownReputationEarned, data.renownLevelThreshold, self.first)
  }

  mut onTree(index: integer) { self.treeIndex = index }
  mut onBack() { self.first = (1).max(self.first - 1) }
  mut onOn() { self.first = self.first + 1 }

  mut onBuy(node: integer) {
    _ = self.config?.spend(node)
    self.touched += 1
  }

  mut onRefund(node: integer) {
    _ = self.config?.refund(node)
    self.touched += 1
  }

  mut onApply() {
    _ = self.config?.commit()
    self.touched += 1
  }

  mut onUndo() {
    _ = self.config?.rollback()
    self.touched += 1
  }
}
