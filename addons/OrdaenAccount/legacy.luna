// «Legacy»: Forever's own system, as its window has it. «Tree»: its three trees (Professions, Adventure,
// Progression), bought with the account's Legacy points, which each character spends on its own; a node bought with a
// left click, given back with a right one, the changes held until «Apply», taken back by «Undo», every node given back
// by «Reset». «Rewards»: the reward track, a renown with a hidden faction, each level its rewards. Everything is
// locked until the player has the track's first level, as the game's own window is.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Align, Event, Frame, Position, Track } from "$ltml"
import { ButtonPlate, Component, ListTab, ProgressBar, PushButton, SECONDARY_TEXT, ScrolledList, TITLE_TEXT } from "Ordaen"
import { LEGACY_POINTS } from "@/challenges"
import Locale from "@/locales"
import Style from "@/style"

// The reward track's faction (`Constants.LegacyConsts.LEGACY_REWARD_TRACK_FACTION_ID`).
public const TRACK = 2802
// The trees, in the game's order (`LegacyTreeData`).
public struct TreeKind {
  id: Integer
  name: String
  icon: Atlas
}
const TREES: Array<TreeKind> = [
  { id: 1187, name: Locale.TREE_PROFESSIONS, icon: "UI-Legacy-Tree-Professions" },
  { id: 1188, name: Locale.TREE_ADVENTURE, icon: "UI-Legacy-Tree-Adventure" },
  { id: 1189, name: Locale.TREE_PROGRESSION, icon: "UI-Legacy-Tree-Progression" }
]
// The canvas a tree's nodes are laid out in, and a node's size.
const CANVAS_WIDTH: Number<Length> = 560dp
const CANVAS_HEIGHT: Number<Length> = 380dp
const NODE: Number<Length> = 40dp
const BUTTON: Number<Length> = 120dp
const REWARD_ROW: Array<Track> = [56dp, { fr: 1 }]

// Whether the player has the reward track's first level: what opens every page.
public function legacyOpen(): Boolean { return Client.C_MajorFactions.GetCurrentRenownLevel(TRACK) > 0 }

// One node of a tree, where it stands in the canvas.
public struct Node {
  id: Integer
  left: Number<Length>
  top: Number<Length>
  icon: FileId | nil
  spell: Integer | nil
  rank: Integer
  ranks: Integer
  canBuy: Boolean
  canRefund: Boolean
  // Its edges' requirements are met: it may be bought.
  open: Boolean
}

// A level of the reward track and its rewards.
public struct Level {
  level: Integer
  reached: Boolean
  rewards: Array<Reward>
}
public struct Reward {
  name: String
  icon: FileId | nil
}

function nodesOf(config: Integer, tree: Integer): Array<Node> {
  const ids = Client.C_Traits.GetTreeNodes(tree) ?? []
  const infos: Array<Client.TraitNodeInfo> = []
  for (id of ids) {
    const info = Client.C_Traits.GetNodeInfo(config, id)
    if (info != nil && info.isVisible) { infos.push(info) }
  }
  if (infos.length == 0) { return [] }
  let left: Number = infos[1]?.posX ?? 0
  let right: Number = left
  let top: Number = infos[1]?.posY ?? 0
  let bottom: Number = top
  for (info of infos) {
    left = left.min(info.posX)
    right = right.max(info.posX)
    top = top.min(info.posY)
    bottom = bottom.max(info.posY)
  }
  // The tree laid out in the canvas, a node's middle at its place, the whole as large as fits.
  const across = (right - left).max(1)
  const down = (bottom - top).max(1)
  const room = ((CANVAS_WIDTH - NODE) / across).min((CANVAS_HEIGHT - NODE) / down)
  const nodes: Array<Node> = []
  for (info of infos) {
    const entry = info.activeEntry?.entryID ?? info.entryIDs[1]
    let spell: Integer | nil = nil
    let icon: FileId | nil = nil
    if (entry != nil) {
      const definition = Client.C_Traits.GetEntryInfo(config, entry)?.definitionID
      const shown = definition != nil ? Client.C_Traits.GetDefinitionInfo(definition) : nil
      spell = shown?.spellID?.floor()
      icon = fileOfNumber(shown?.overrideIcon) ?? spellIcon(spell)
    }
    nodes.push({
      id: info.ID.floor(), left: (info.posX - left) * room, top: (info.posY - top) * room, icon: icon, spell: spell,
      rank: info.currentRank.floor(), ranks: info.maxRanks.floor(), canBuy: info.canPurchaseRank, canRefund: info.canRefundRank,
      open: info.meetsEdgeRequirements
    })
  }
  return nodes
}

function spellIcon(spell: Integer | nil): FileId | nil {
  if (spell == nil) { return nil }
  const icon, _, _ = Client.C_Spell.GetSpellTexture(spell)
  return icon
}

function fileOfNumber(icon: Number | nil): FileId | nil {
  if (icon == nil) { return nil }
  const whole = icon.floor()
  return whole is FileId ? whole : nil
}

function levelsOf(): Array<Level> {
  const reached = Client.C_MajorFactions.GetCurrentRenownLevel(TRACK)
  const list: Array<Level> = []
  for (info of Client.C_MajorFactions.GetRenownLevels(TRACK)) {
    const rewards: Array<Reward> = []
    for (reward of Client.C_MajorFactions.GetRenownRewardsForLevel(TRACK, info.level)) {
      rewards.push({ name: reward.name ?? "", icon: reward.icon })
    }
    list.push({ level: info.level.floor(), reached: info.level <= reached, rewards: rewards })
  }
  return list
}

// A node: its icon, its rank under it; gold while it has ranks, dimmed while it can't be bought.
public class NodeButton implements Component {
  public buy: Event<Integer> = new Event()
  public refund: Event<Integer> = new Event()

  derived rank: String = "%d/%d".format(self.node.rank, self.node.ranks)
  derived tint: Color = self.node.rank > 0 || self.node.canBuy ? Style.INK : Style.MISSING
  derived ink: Color = self.node.rank >= self.node.ranks ? Style.GOLD : self.node.rank > 0 ? Style.GREEN : Style.DIM

  node: Signal<Node>
  constructor(node: Signal<Node>) { self.node = node }

  onBuy(mut self) { self.buy.emit(self.node.id) }
  onRefund(mut self) { self.refund.emit(self.node.id) }
  onEnter(self, frame: any Frame) {
    const spell = self.node.spell
    if (spell != nil) { Game.items.showSpell(frame, spell) }
  }

  public render(self): Template {
    return $ltml {
      <box position={Position.Absolute} left={self.node.left} top={self.node.top} width={NODE} height={NODE}
           icon={self.node.icon} tint={self.tint} @pointerPress(.Left)={self.onBuy} @pointerPress(.Right)={self.onRefund}
           @pointerEnter={self.onEnter} xAlign={Align.End} yAlign={Align.End}>
        <text value={self.rank} textColor={self.ink} textFont={.Numbers} textSize={SECONDARY_TEXT} wrap={.None} />
      </box>
    }
  }
}

public class RewardRow implements Component {
  derived ink: Color = self.level.reached ? Style.INK : Style.MISSING
  derived names: String = self.level.rewards.map(reward => reward.name).join(", ")
  derived icon: FileId | nil = self.level.rewards[1]?.icon

  level: Signal<Level>
  constructor(level: Signal<Level>) { self.level = level }

  public render(self): Template {
    return $ltml {
      <box columns={REWARD_ROW} gap={3sp} yAlign={Align.Center} padding={2sp}>
        <text value={"%d"} arguments={[self.level.level]} textColor={self.ink} textFont={.Numbers} textSize={TITLE_TEXT} wrap={.None} />
        <box columns={[Style.ICON, { fr: 1 }]} gap={3sp} yAlign={Align.Center}>
          <box width={Style.ICON} height={Style.ICON} icon={self.icon} tint={self.ink} />
          <text value={self.names} textColor={self.ink} />
        </box>
      </box>
    }
  }
}

public class TreeChoice implements Component {
  public pick: Event<Integer> = new Event()
  derived picked: Boolean = self.index == self.chosen

  tree: Signal<TreeKind>
  const index: Integer
  chosen: Signal<Integer>
  constructor(tree: Signal<TreeKind>, index: Integer, chosen: Signal<Integer>) {
    self.tree = tree
    self.index = index
    self.chosen = chosen
  }

  onPick(mut self) { self.pick.emit(self.index) }

  public render(self): Template {
    return $ltml { <ListTab label={self.tree.name} icon={self.tree.icon} selected={self.picked} @pick={self.onPick} /> }
  }
}

public class Legacy implements Component {
  // Moves when the game says a tree or the track changed: what is shown is read again.
  state touched = 0
  state treeIndex = 1
  derived open: Boolean = self.readOpen()
  derived tree: TreeKind = TREES[self.treeIndex] ?? panic("three trees")
  derived config: Integer | nil = self.readConfig()
  derived nodes: Array<Node> = self.readNodes()
  derived points: Integer = self.readPoints()
  derived pointsText: String = Locale.POINTS_AVAILABLE.format(self.points)
  derived staged: Boolean = self.readStaged()
  derived bought: Boolean = self.nodes.any(node => node.rank > 0)
  derived levels: Array<Level> = self.readLevels()
  derived rank: Integer = self.readRank()
  derived progress: Number = self.readProgress()
  derived rankText: String = Locale.LEGACY_RANK.format(self.rank)

  sub: Signal<Integer>
  constructor(sub: Signal<Integer>) {
    self.sub = sub
    Events.TRAIT_CONFIG_UPDATED.listen(self.onChanged)
    Events.TRAIT_TREE_CURRENCY_INFO_UPDATED.listen(self.onChanged)
    Events.MAJOR_FACTION_RENOWN_LEVEL_CHANGED.listen(self.onChanged)
  }

  onChanged(mut self) { self.touched += 1 }

  readOpen(self): Boolean {
    _ = self.touched
    return legacyOpen()
  }

  readConfig(self): Integer | nil {
    _ = self.touched
    return Client.C_Traits.GetConfigIDByTreeID(self.tree.id)?.floor()
  }

  readNodes(self): Array<Node> {
    _ = self.touched
    const config = self.config
    return config != nil ? nodesOf(config, self.tree.id) : []
  }

  readPoints(self): Integer {
    _ = self.touched
    const config = self.config
    if (config == nil) { return 0 }
    const info = Client.C_Traits.GetTreeCurrencyInfo(config, self.tree.id, false)
    return (info.find(one => one.traitCurrencyID == LEGACY_POINTS) ?? info[1])?.quantity?.floor() ?? 0
  }

  readStaged(self): Boolean {
    _ = self.touched
    const config = self.config
    return config != nil && Client.C_Traits.ConfigHasStagedChanges(config)
  }

  readLevels(self): Array<Level> {
    _ = self.touched
    return levelsOf()
  }

  readRank(self): Integer {
    _ = self.touched
    return Client.C_MajorFactions.GetCurrentRenownLevel(TRACK).floor()
  }

  // How far to the next level, 0 to 1.
  readProgress(self): Number {
    _ = self.touched
    const data = Client.C_MajorFactions.GetMajorFactionData(TRACK)
    if (data == nil || data.renownLevelThreshold <= 0) { return 0 }
    return (data.renownReputationEarned / data.renownLevelThreshold).min(1)
  }

  onTree(mut self, index: Integer) { self.treeIndex = index }

  onBuy(mut self, node: Integer) {
    const config = peek self.config
    if (config == nil) { return }
    _ = Client.C_Traits.PurchaseRank(config, node)
    self.touched += 1
  }

  onRefund(mut self, node: Integer) {
    const config = peek self.config
    if (config == nil) { return }
    _ = Client.C_Traits.RefundRank(config, node)
    self.touched += 1
  }

  onApply(mut self) {
    const config = peek self.config
    if (config != nil) { _ = Client.C_Traits.CommitConfig(config) }
    self.touched += 1
  }

  onUndo(mut self) {
    const config = peek self.config
    if (config != nil) { _ = Client.C_Traits.RollbackConfig(config) }
    self.touched += 1
  }

  onReset(mut self) {
    const config = peek self.config
    if (config != nil) { _ = Client.C_Traits.ResetTree(config, (peek self.tree).id) }
    self.touched += 1
  }

  public render(self): Template {
    return $ltml {
      <box $if={!self.open} xAlign={Align.Center} yAlign={Align.Center}>
        <text value={Locale.LEGACY_LOCKED} textColor={Style.DIM} />
      </box>
      <box $elseif={self.sub == 1} columns={[Style.SIDE_LIST, { fr: 1 }]} rows={[{ fr: 1 }]} gap={6sp}>
        <box rows={["max-content", "max-content", "max-content", { fr: 1 }]} gap={3sp}>
          <TreeChoice $for={index, tree of TREES} tree={tree} index={index} chosen={self.treeIndex} @pick={self.onTree} />
          <text value={self.pointsText} textColor={Style.GOLD} />
        </box>
        <box rows={["max-content", { fr: 1 }, "max-content"]} gap={3sp}>
          <text value={self.tree.name} textSize={TITLE_TEXT} textFont={.Title} textColor={Style.GOLD} />
          <box width={CANVAS_WIDTH} height={CANVAS_HEIGHT} xAlignSelf={Align.Center}>
            <NodeButton $for={node of self.nodes} $key={node.id} node={node} @buy={self.onBuy} @refund={self.onRefund} />
          </box>
          <box columns={[{ fr: 1 }, "max-content", "max-content"]} gap={3sp} yAlign={Align.Center}>
            <box />
            <PushButton $if={self.staged} label={Locale.UNDO} width={BUTTON} @click={self.onUndo} />
            <PushButton $else label={Locale.RESET} width={BUTTON} disabled={!self.bought} @click={self.onReset} />
            <PushButton label={Locale.APPLY} width={BUTTON} plate={ButtonPlate.Accent} disabled={!self.staged} @click={self.onApply} />
          </box>
        </box>
      </box>
      <box $else rows={["max-content", "max-content", { fr: 1 }]} gap={3sp}>
        <text value={self.rankText} textSize={TITLE_TEXT} textFont={.Title} textColor={Style.GOLD} />
        <ProgressBar fraction={self.progress} />
        <ScrolledList virtual={true}>
          <RewardRow $for={level of self.levels} $key={level.level} level={level} />
        </ScrolledList>
      </box>
    }
  }
}
