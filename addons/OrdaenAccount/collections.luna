// «Collections»: the mounts, the companion pets and the toys, each a list as every list window has it: the toolbar's
// search, filter (collected, not collected), sort (collected first, or by name) and view (rows, or icons). A mount's or
// a pet's card stands beside the list while one is picked: its figure (turned by a drag, brought nearer by the wheel),
// its words, where it is found, and the button that rides or summons it. A toy has no card: a click on it uses it, as
// the game's toy box does, its tooltip the game's. The footer counts what is collected. The appearances are the game's
// own window. What a list holds is read as its tab shows, and again when the game says the collection changed.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Action, Align, Columns, Frame, Track } from "$ltml"
import root Ordaen from "Ordaen"
import {
  ARTWORK, Choice, Component, Ground, FilterButton, ItemButton, FilterGroup, FooterCount, ListFooter, PickRow, PushButton, SECONDARY_TEXT, ScrolledList,
  TITLE_TEXT, Tabs, ToolPick, Toolbar, WindowSide
} from "Ordaen"
import Locale from "@/locales"
import Style from "@/style"

// What a list collects.
public enum Kind { Mounts, Pets, Toys }
// What the filter shows.
public enum Owned { Collected, Missing }
// How a list is ordered, and how it is shown.
public enum EntrySort { Collected, Name }
public enum EntryView { Rows, Icons }

const SUBS: Array<String> = [Locale.SUB_MOUNTS, Locale.SUB_PETS, Locale.SUB_TOYS, Locale.SUB_TRANSMOG]
const SUB_TRANSMOG = 4
// The game's journal's appearances tab.
const JOURNAL_APPEARANCES = 5
const SORTS: Array<Choice<EntrySort>> = [
  { value: EntrySort.Collected, label: Locale.SORT_COLLECTED },
  { value: EntrySort.Name, label: Locale.SORT_NAME }
]
const VIEWS: Array<Choice<EntryView>> = [
  { value: EntryView.Rows, label: Locale.VIEW_LIST, icon: ARTWORK.ctl.tool.list },
  { value: EntryView.Icons, label: Locale.VIEW_ICONS, icon: ARTWORK.ctl.tool.table }
]
const FILTERS: Array<FilterGroup<Owned>> = [
  { label: nil, options: [{ key: Owned.Collected, label: Locale.SHOW_COLLECTED }, { key: Owned.Missing, label: Locale.SHOW_MISSING }] }
]
const EVERY_OWNED: Map<Owned, Boolean> = { [Owned.Collected]: true, [Owned.Missing]: true }

// One entry of a list.
public struct Entry {
  // What tells it from the others of its list.
  key: String
  name: String
  icon: FileId | nil
  owned: Boolean
  // The player may use it now (a mount where it may be ridden, a toy of the player's class).
  usable: Boolean
  // A mount's number; a pet's species; a toy's item.
  id: Integer
  // An owned pet's own ID, what summons it.
  pet: String | nil
  // The spell a mount is ridden with: its tooltip.
  spell: Integer | nil
}

// The picked entry's card: its figure (a creature's look by its display ID) and its words, read as it is picked.
public struct Card {
  model: Integer | nil
  description: String
  source: String
}

const NO_CARD: Card = { model: nil, description: "", source: "" }
const ROW: Array<Track> = [Style.ICON, { fr: 1 }]
const PREVIEW: Number<Length> = 320dp
const BUTTON: Number<Length> = 180dp
const TILE: Number<Length> = 46dp
const TILES: Columns = { autoFit: TILE }
const CARD_HEAD: Array<Track> = [Style.CARD_ICON, { fr: 1 }]
const CARD_PARTS: Array<Track> = ["max-content", PREVIEW, "max-content", "max-content", { fr: 1 }, "max-content"]

// The client gives some icons as plain numbers: a file's number, or nothing.
function fileOf(icon: Number | nil): FileId | nil {
  if (icon == nil) { return nil }
  const whole = icon.floor()
  return whole is FileId ? whole : nil
}

function mounts(): Array<Entry> {
  const list: Array<Entry> = []
  for (id of Client.C_MountJournal.GetMountIDs()) {
    const name, spell, icon, _, usable, _, _, _, _, hidden, owned, _, _ = Client.C_MountJournal.GetMountInfoByID(id)
    if (name != nil && hidden != true) {
      list.push({
        key: String.of(id), name: name, icon: icon, owned: owned == true, usable: usable == true, id: id.floor(), pet: nil,
        spell: spell?.floor()
      })
    }
  }
  return list
}

function pets(): Array<Entry> {
  // The journal's own search would leave pets out: every pet is read, the list searched here.
  Client.C_PetJournal.ClearSearchFilter()
  const list: Array<Entry> = []
  const count, _ = Client.C_PetJournal.GetNumPets()
  for (index of 1..count.floor()) {
    const pet, species, owned, custom, _, _, revoked, name, icon, _, _, _, _, _, _, _, _, _ = Client.C_PetJournal.GetPetInfoByIndex(index)
    if (!revoked) {
      list.push({
        key: pet ?? "species:" + String.of(species), name: custom ?? name, icon: icon, owned: owned, usable: owned,
        id: species, pet: pet, spell: nil
      })
    }
  }
  return list
}

function toys(): Array<Entry> {
  Client.C_ToyBox.SetFilterString("")
  const list: Array<Entry> = []
  for (index of 1..Client.C_ToyBox.GetNumFilteredToys().floor()) {
    const item = Client.C_ToyBox.GetToyFromIndex(index)
    if (item > 0) {
      const _, name, icon, _, _ = Client.C_ToyBox.GetToyInfo(item)
      list.push({
        key: String.of(item), name: name, icon: fileOf(icon), owned: Client.PlayerHasToy(item),
        usable: Client.C_ToyBox.IsToyUsable(item), id: item.floor(), pet: nil, spell: nil
      })
    }
  }
  return list
}

function entriesOf(kind: Kind): Array<Entry> {
  return match (kind) {
    .Mounts => mounts()
    .Pets => pets()
    .Toys => toys()
  }
}

// A mount's figure: its own display, else the first of its displays, as the game's journal falls back.
function mountModel(id: Integer, display: Number | nil): Integer | nil {
  if (display != nil) { return display.floor() }
  const first = (Client.C_MountJournal.GetMountAllCreatureDisplayInfoByID(id) ?? [])[1]
  return first?.creatureDisplayID?.floor()
}

function cardOf(kind: Kind, entry: Entry): Card {
  if (kind == .Mounts) {
    const display, description, source, _, _, _, _, _, _ = Client.C_MountJournal.GetMountInfoExtraByID(entry.id)
    return { model: mountModel(entry.id, display), description: description ?? "", source: source ?? "" }
  }
  if (kind == .Pets) {
    const _, _, _, _, source, description, _, _, _, _, _, display = Client.C_PetJournal.GetPetInfoBySpeciesID(entry.id)
    return { model: display, description: description ?? "", source: source ?? "" }
  }
  return NO_CARD
}

// A mount's or a pet's row: its icon and its name, dimmed while not collected.
public class EntryRow implements Component {
  public pick: Event<String> = new Event()

  derived picked: Boolean = self.entry.key == self.chosen
  derived ink: Color = self.entry.owned ? Style.INK : Style.MISSING

  entry: Signal<Entry>
  chosen: Signal<String>
  constructor(entry: Signal<Entry>, chosen: Signal<String>) {
    self.entry = entry
    self.chosen = chosen
  }

  onPick(mut self) { self.pick.emit(self.entry.key) }

  public render(self): Template {
    return $ltml {
      <PickRow columns={ROW} picked={self.picked} @pick={self.onPick}>
        <box width={Style.ICON} height={Style.ICON} icon={self.entry.icon} desaturate={!self.entry.owned} />
        <text value={self.entry.name} textColor={self.ink} wrap={.Cut} />
      </PickRow>
    }
  }
}

// A mount's or a pet's icon in the icons' view: picked by a click, gold while picked.
public class EntryTile implements Component {
  public pick: Event<String> = new Event()

  derived picked: Boolean = self.entry.key == self.chosen
  derived ring = self.picked ? Ordaen.art.ctl.well.rim : nil

  entry: Signal<Entry>
  chosen: Signal<String>
  constructor(entry: Signal<Entry>, chosen: Signal<String>) {
    self.entry = entry
    self.chosen = chosen
  }

  onPick(mut self) { self.pick.emit(self.entry.key) }

  public render(self): Template {
    return $ltml {
      <box width={TILE} height={TILE} icon={self.entry.icon} desaturate={!self.entry.owned} border={self.ring}
           @pointerPress(.Left)={self.onPick} @keyPress(.Enter)={self.onPick} />
    }
  }
}

// A toy: the game's item button, a click on it using the toy (where the player has it and may), its tooltip the game's;
// its name beside it in the rows' view.
public class ToyRow implements Component {
  derived ink: Color = self.entry.owned ? Style.INK : Style.MISSING
  derived action: Action | nil = self.entry.owned && self.entry.usable ? Action.UseItem { item: self.entry.id } : nil

  entry: Signal<Entry>
  const icons: Boolean
  constructor(entry: Signal<Entry>, icons: Boolean = false) {
    self.entry = entry
    self.icons = icons
  }

  public render(self): Template {
    return $ltml {
      <ItemButton $if={self.icons} item={self.entry.id} art={self.entry.icon} dimmed={!self.entry.owned} size={TILE} action={self.action} />
      <box $else columns={ROW} gap={2sp} padding={2sp} yAlign={Align.Center}>
        <ItemButton item={self.entry.id} art={self.entry.icon} dimmed={!self.entry.owned} size={Style.ICON} action={self.action} />
        <text value={self.entry.name} textColor={self.ink} wrap={.Cut} />
      </box>
    }
  }
}

// The page: its sub tabs, toolbar and list (`content`), the picked mount's or pet's card (`side`) and its counts
// (`footer`).
public class Collections {
  // While the page shows: what it holds is read then, and heard of the game then alone.
  public state visible = false
  state sub = 1
  // What the list holds, read as it shows and again when the game says it changed.
  state entries: Array<Entry> = []
  state search = ""
  state owned: Map<Owned, Boolean> = EVERY_OWNED
  state sort: EntrySort = .Collected
  state view: EntryView = .Rows
  // The picked entry, by its key, and its card.
  state chosen = ""
  derived kind: Kind = self.sub == 1 ? .Mounts : self.sub == 2 ? .Pets : .Toys
  derived transmog: Boolean = self.sub == SUB_TRANSMOG
  derived toys: Boolean = self.kind == .Toys
  derived icons: Boolean = self.view == .Icons
  derived narrowed: Boolean = self.owned[Owned.Collected] != true || self.owned[Owned.Missing] != true
  derived shown: Array<Entry> = self.filtered()
  derived picked: Entry | nil = self.toys || self.chosen == "" ? nil : self.entries.find(entry => entry.key == self.chosen)
  derived card: Card = self.picked != nil ? cardOf(self.kind, self.picked ?? panic("tested")) : NO_CARD
  derived counts: Array<FooterCount> = [
    { label: Locale.COUNT_COLLECTED, value: "%d / %d".format(self.entries.count(entry => entry.owned), self.entries.length) }
  ]
  derived action: String = self.kind == .Mounts ? Locale.MOUNT : Locale.SUMMON
  derived usable: Boolean = self.picked?.usable == true
  derived modelShown: Boolean = self.card.model != nil
  const cardView: Template = $ltml {
    <box rows={CARD_PARTS} gap={3sp}>
      <box columns={CARD_HEAD} gap={3sp} yAlign={Align.Center} @pointerEnter={self.onEnter}>
        <box width={Style.CARD_ICON} height={Style.CARD_ICON} icon={self.picked?.icon} />
        <text value={self.picked?.name ?? ""} textSize={TITLE_TEXT} textFont={.Title} textColor={Style.GOLD} />
      </box>
      <box background={Style.STAGE} model={self.card.model} xAlign={Align.Center} yAlign={Align.Center}>
        <text $if={!self.modelShown} value={Locale.NO_PREVIEW} textColor={Style.DIM} />
      </box>
      <text value={self.card.description} textColor={Style.INK} leading={.Prose} />
      <text value={self.card.source} textColor={Style.DIM} textSize={SECONDARY_TEXT} leading={.Prose} />
      <box />
      <PushButton label={self.action} width={BUTTON} disabled={!self.usable} @click={self.onUse} />
    </box>
  }
  public derived side: WindowSide | nil = self.picked == nil ? nil : { width: Style.CARD, content: self.cardView }

  public const content: Template = $ltml {
    <box columns={1} rows={["max-content", "max-content", { fr: 1 }]} gap={3sp}>
      <box padding={Style.TOP_ROOM}>
        <Tabs tabs={SUBS} selected={mut self.sub} />
      </box>
      <box $if={self.transmog} padding={Style.SIDE_ROOM} gap={3sp}>
        <text value={Locale.TRANSMOG_GAME} textColor={Style.DIM} />
        <PushButton label={Locale.OPEN_APPEARANCES} width={220dp} @click={self.onTransmog} />
      </box>
      <box $else padding={Style.SIDE_ROOM}>
        <Toolbar search={mut self.search} placeholder={Locale.SEARCH}>
          <FilterButton values={mut self.owned} start={EVERY_OWNED} groups={FILTERS} />
          <ToolPick value={mut self.sort} choices={SORTS} icon={Ordaen.art.ctl.tool.sort} title={Locale.SORT} />
          <ToolPick value={mut self.view} choices={VIEWS} icon={Ordaen.art.ctl.tool.columns} title={Locale.VIEW} />
        </Toolbar>
      </box>
      <box $if={self.transmog} />
      <ScrolledList $elseif={self.icons} columns={TILES} gap={2sp} ground={Ground.Wood}>
        <$if={self.toys}> <ToyRow $for={entry of self.shown} $key={entry.key} entry={entry} icons={true} /> </>
        <$else> <EntryTile $for={entry of self.shown} $key={entry.key} entry={entry} chosen={self.chosen} @pick={self.onPick} /> </>
      </ScrolledList>
      <ScrolledList $else virtual={true} ground={Ground.Wood}>
        <$if={self.toys}> <ToyRow $for={entry of self.shown} $key={entry.key} entry={entry} /> </>
        <$else> <EntryRow $for={entry of self.shown} $key={entry.key} entry={entry} chosen={self.chosen} @pick={self.onPick} /> </>
      </ScrolledList>
    </box>
  }
  public const footer: Template = $ltml { <ListFooter counts={self.counts} /> }
  // The appearances: the game's own journal, which the window lets through.
  public const asked: Event<Integer> = new Event()

  constructor() {
    watch {
      if (!self.visible) { return }
      const kind = self.kind
      self.chosen = ""
      self.read()
      match (kind) {
        .Mounts => {
          Events.NEW_MOUNT_ADDED.listen(self.read)
          Events.COMPANION_LEARNED.listen(self.read)
          Events.MOUNT_JOURNAL_USABILITY_CHANGED.listen(self.read)
        }
        .Pets => Events.PET_JOURNAL_LIST_UPDATE.listen(self.read)
        .Toys => {
          Events.TOYS_UPDATED.listen(self.read)
          Events.NEW_TOY_ADDED.listen(self.read)
        }
      }
    }
  }

  read(mut self) { self.entries = entriesOf(peek self.kind) }

  filtered(self): Array<Entry> {
    const words = self.search.lower()
    const list = self.entries.filter(entry =>
      (entry.owned ? self.owned[Owned.Collected] == true : self.owned[Owned.Missing] == true) &&
        (words == "" || entry.name.lower().contains(words))
    )
    if (self.sort == .Collected) {
      list.sort((a, b) => a.owned != b.owned ? a.owned : a.name < b.name)
    } else {
      list.sort((a, b) => a.name < b.name)
    }
    return list
  }

  onPick(mut self, key: String) { self.chosen = key }

  onEnter(self, frame: any Frame) {
    const spell = (peek self.picked)?.spell
    if (spell != nil) { Game.items.showSpell(frame, spell) }
  }

  // Ride the mount, summon the pet.
  onUse(self) {
    const entry = peek self.picked
    if (entry == nil) { return }
    if (peek self.kind == .Mounts) {
      Client.C_MountJournal.SummonByID(entry.id)
    } else if (entry.pet != nil) {
      Client.C_PetJournal.SummonPetByGUID(entry.pet)
    }
  }

  onTransmog(mut self) { self.asked.emit(JOURNAL_APPEARANCES) }
}
