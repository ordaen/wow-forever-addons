// The land no zone's map covers, as `gaps.lua` reads OpenMap's tables: blank paper through a mask of the land on each
// continent's gap tiles, Blizzard's classic maps of the zones Forever's tables don't use, and the gaps Santiago Reyes
// painted by hand.

// A gap tile of a continent: its column and row, each `tile()` world units square from the continent map's top left
// corner (its land mask `media/openmap/gapLand/<continent>_<col>_<row>`).
public struct GapTile {
  const col: Integer
  const row: Integer
}

// One of Blizzard's classic maps: its box on the world (0 to 1), its 1002 by 668 art's tiles row by row (a file id,
// or the path of OpenMap's copy where the client may not have it; 0: a tile its mask leaves nothing of), drawn
// through `media/openmap/coastArt/<name>`.
public struct ClassicMap {
  const name: String
  const left: Number
  const top: Number
  const right: Number
  const bottom: Number
  const files: Array<Number | String>
}

// A gap painted by hand: its tiles' prefix (`media/openmap/gapFill/<name>_<tile>`), its box on the world (0 to 1),
// its size in pixels, its columns of 256-pixel tiles, and the tiles drawn (row by row, from 1).
public struct GapFill {
  const name: String
  const left: Number
  const top: Number
  const right: Number
  const bottom: Number
  const width: Number
  const height: Number
  const columns: Integer
  const tiles: Array<Integer>
}

// A gap tile's side, in world units.
public function tile(): Number
// The paper's tile, in world units.
public function paper(): Number
public function tilesOf(continent: Integer): Array<GapTile>
public function classic(): Array<ClassicMap>
public function fills(): Array<GapFill>
