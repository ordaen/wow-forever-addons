// Ordaen Map: built for OpenMap, which draws the seamless world map inside Blizzard's `WorldMapFrame`; Map draws no
// map. It owns how the map and the quest log open (the client's `questLogOpen`: apart by default, docked as Blizzard
// has it by the player's switch) and the pins other modules put on the map: each module adds its layers to `layers`,
// and Map places their pins on OpenMap's map while it shows, with a switch for each on its settings page and in
// OpenMap's menu.
//
// Its own window (alpha, the player's switch): the game's map key (M) opens Ordaen's map, every zone stitched into
// one canvas (`canvas.luna`); an override of the player's own binding, so the game's Key Bindings window stays where
// it is changed.
import Client from "$client"
import Events from "$events"
import { Position, Track } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { KeptWindow, Module, Settings, SettingsPage, Window, WindowTabSpec, playSound } from "Ordaen"
import { WorldCanvas } from "@/canvas"
import { DungeonSection, Layer, Pin, SidePanel } from "@/extend"
import { MapHost, OpenMapHost, Placed } from "@/host"
import Locale from "@/locales"
import { Choices, GeneralPage } from "@/settings"

// A pin to draw, what its tooltip says, and the layer a click on it goes to.
struct Mark {
  pin: Pin
  lines: Array<String>
  layer: any Layer
}

// How near, on the canvas (0 to 1), a pin stands to one drawn before it to be drawn as that one.
const CLUSTER: Number = 0.015

// OpenMap's menu switch for the docked log.
const DOCKED_SWITCH = "docked"
// The button the game's map key clicks: the client binds a key to a button by its name.
const TOGGLE = "OrdaenMapToggle"
// The game's binding of the world map.
const MAP_BINDING = "TOGGLEWORLDMAP"
const FILL: Array<Track> = [{ fr: 1 }]
const MAP_ICON: Asset = "Interface/Icons/INV_Misc_Map02"

// The marks, the lit ones first.
function litFirst(marks: Array<Mark>): Array<Mark> {
  const ordered: Array<Mark> = marks.filter(mark => mark.pin.lit)
  if (ordered.length == 0) { return marks }
  for (mark of marks) {
    if (!mark.pin.lit) { ordered.push(mark) }
  }
  return ordered
}

// The placed pin (from 1) that one placed at `at` stands on; 0 for none.
function nearestOf(placed: Array<Placed>, at: Placed): Integer {
  for (index, other of placed) {
    if ((other.x - at.x).abs() < CLUSTER && (other.y - at.y).abs() < CLUSTER) { return index }
  }
  return 0
}

public class Maps implements Module, App {
  public const title: String = "Ordaen Map"
  // The layers on the map, added by the modules that draw them.
  public const layers = new Registry<any Layer>()
  // What the modules say on a dungeon's card.
  public const dungeons = new Registry<any DungeonSection>()
  public settings: mut Settings<Choices> = new Settings<Choices>({ hidden: {}, primed: false, ownWindow: true })
  public const pages: Array<SettingsPage> = [
    {
      title: Locale.TAB_GENERAL,
      content: $ltml {
        <GeneralPage openMap={self.openMap} docked={mut self.docked} layers={self.layers} hidden={self.settings.values.hidden}
                     settings={mut self.settings} @flip={self.flip} />
      }
    }
  ]
  // Ordaen's own map window, and the canvas it holds.
  public window: mut KeptWindow = new KeptWindow("map", self.title, { x: 0ui, y: 0ui, width: 900ui, height: 640ui })
  public state open = false
  state windowTab = 1
  derived tabs: Array<WindowTabSpec> = [{ title: Locale.MAP_WINDOW, icon: MAP_ICON }]
  canvas: mut WorldCanvas = new WorldCanvas()
  const toggle: any Client.Frame
  // Docked or apart: the client's `questLogOpen`, read as the map changes and written by the switch.
  public state docked = false
  // OpenMap is there, of the API Map is written against: without it, nothing is drawn and the page says so.
  state openMap = false
  // The game's map, OpenMap and the client's setting: a test gives its own.
  public state host: mut any MapHost = new OpenMapHost()
  // The map's side panel while it shows (docked, the map open): Quests draws its log over it.
  public state side: SidePanel | nil = nil
  // Whether the world map shows: what a module shows on it stays until it hides (Quests' «Show on map»).
  public state showing = false
  // The marks drawn, in the host's order: what a click on one goes to.
  drawn: Array<Mark> = []
  // The pins of the layers the player shows, asked again when what a layer read changes.
  derived marks: Array<Mark> {
    const marks: Array<Mark> = []
    for (layer of self.layers) {
      if (self.settings.values.hidden[layer.id] != true) {
        for (pin of layer.pins()) { marks.push({ pin: pin, lines: layer.lines(pin), layer: layer }) }
      }
    }
    return marks
  }

  constructor() {
    self.toggle = Client.CreateFrame("Button", TOGGLE, Client.UIParent, nil)
    Ordaen.modules.add(self)
    self.toggle.SetScript("OnClick", (): nil => {
      self.flipWindow()
      return nil
    })
    watch (on of self.open) {
      if (on) {
        self.canvas.show()
      } else {
        self.canvas.hide()
      }
    }
    watch {
      if (!self.settings.values.ownWindow) { self.open = false }
      Ordaen.afterCombat(() => self.bind())
    }
    Events.UPDATE_BINDINGS.listen(self.rebind)
    self.docked = self.host.docked()
    self.openMap = self.host.present()
    // The first start sets the default, apart; after that the setting is the player's.
    if (!self.settings.values.primed) {
      self.settings.values.primed = true
      if (self.docked) {
        self.host.dock(false)
        self.docked = false
      }
    }
    watch (on of self.docked) {
      if (on != self.host.docked()) { self.host.dock(on) }
    }
    // Heard of the host Map has now: a test gives its own.
    watch (host of self.host) {
      host.changed.listen(self.onChanged)
      host.pressed.listen(self.onPressed)
    }
    self.host.start()
    self.host.dungeonSection((map: Integer, names: Array<String>) => self.cardOf(map, names))
    watch (marks of self.marks) { self.place(marks) }
    watch (list of self.layers) { self.addSwitches(list) }
  }

  destructor() {
    self.host.stop()
    const toggle = self.toggle
    Ordaen.afterCombat(() => Client.ClearOverrideBindings(toggle))
  }

  // The window opens or closes: the game's map key, and the close button.
  public flipWindow(mut self) {
    self.open = !self.open
    playSound(self.open ? "IG_QUEST_LOG_OPEN" : "IG_QUEST_LOG_CLOSE")
  }

  onClose(mut self) { self.open = false }
  onSettings(self) { Ordaen.toggleSettings(Runtime.Addon.of(self)) }

  rebind(mut self) { Ordaen.afterCombat(() => self.bind()) }

  // The player's own keys of the game's map click Map's button while its window is the player's choice; out of a
  // fight alone, as the client takes no binding in one.
  bind(self) {
    Client.ClearOverrideBindings(self.toggle)
    if (!(peek self.settings.values.ownWindow)) { return }
    let first, second = Client.GetBindingKey(MAP_BINDING)
    if (first != nil) { Client.SetOverrideBindingClick(self.toggle, false, first, TOGGLE, "LeftButton") }
    if (second != nil) { Client.SetOverrideBindingClick(self.toggle, false, second, TOGGLE, "LeftButton") }
  }

  // The map showed, hid, turned or moved: the pins are placed again, and the setting read as the client has it.
  onChanged(mut self) {
    self.docked = self.host.docked()
    self.side = self.host.sidePanel()
    self.showing = self.host.shown()
    self.place(peek self.marks)
  }

  // The world map opened where the area is: a module's «Show on map».
  public show(mut self, area: Integer) { self.host.open(area) }

  // The marks in view placed and drawn; one standing on a pin drawn before it adds its lines to that one's tooltip.
  // A lit one goes first, so it is the one drawn.
  place(mut self, marks: Array<Mark>) {
    const placed: Array<Placed> = []
    const lines: Array<mut Array<String>> = []
    const drawn: Array<Mark> = []
    if (self.host.shown()) {
      for (mark of litFirst(marks)) {
        const at = self.host.place(mark.pin)
        if (at != nil) {
          const near = nearestOf(placed, at)
          if (near == 0) {
            placed.push(at)
            lines.push(mark.lines.map(line => line))
            drawn.push(mark)
          } else {
            for (line of mark.lines) { lines[near]?.push(line) }
          }
        }
      }
    }
    self.drawn = drawn
    self.host.draw(placed, lines)
  }

  // Map's section of a dungeon's card: its title, then each entry's lines; none where no entry has any.
  public cardOf(self, map: Integer, names: Array<String>): Array<String> {
    const said: Array<String> = []
    for (section of self.dungeons) {
      for (line of section.lines(names)) { said.push(line) }
    }
    if (said.length == 0) { return said }
    said.insert(1, Locale.DUNGEON_CARD)
    return said
  }

  // A drawn pin clicked: its layer's.
  onPressed(mut self, index: Integer, shift: Boolean) {
    const mark = self.drawn[index]
    if (mark != nil) { mark.layer.press(mark.pin, shift) }
  }

  // A layer's switch on the settings page or in OpenMap's menu.
  public flip(mut self, id: String) {
    self.settings.values.hidden[id] = self.settings.values.hidden[id] != true
  }

  public shows(self, id: String): Boolean { return self.settings.values.hidden[id] != true }

  // OpenMap's menu: the docked switch, and one for each layer.
  addSwitches(mut self, list: Array<any Layer>) {
    self.host.menuSwitch(DOCKED_SWITCH, Locale.SETTING_DOCKED, () => peek self.docked, (on: Boolean): nil => {
      self.docked = on
      return nil
    })
    for (layer of list) {
      const id = layer.id
      self.host.menuSwitch(id, layer.title, () => self.shows(id), (on: Boolean): nil => {
        if (on != self.shows(id)) { self.flip(id) }
        return nil
      })
    }
  }

  public render(self): Template {
    return $ltml {
      <Window $if={self.open} tabs={self.tabs} selected={mut self.windowTab} declared={mut self.window} withSettings={true}
              @close={self.onClose} @settings={self.onSettings}>
        <box rows={FILL} columns={FILL}>
          <embed frame={self.canvas.view} position={Position.Absolute} left={0dp} top={0dp} right={0dp} bottom={0dp} />
        </box>
      </Window>
    }
  }
}
