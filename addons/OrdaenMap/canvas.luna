// The world map's canvas: every zone's own art stitched on one plane, in Azeroth's (947) art units, each zone placed
// by its rectangle on Azeroth's map and cut to its own land by OpenMap's territory mask (a soft feather where it has
// none; a round one for a city), its explored pieces over it. A plain frame of the client's, without reactivity: the
// window embeds `view`, and the canvas draws, pans (a drag) and zooms (the wheel, at the cursor) itself. Only the
// zones near the view are drawn, each built the first time it comes near. The player's arrow stands over it.
// OpenMap (MIT): https://github.com/openmap-world/openmap, its masks in `media/openmap`.
import Client from "$client"
import Debug from "$debug"
import Gaps from "@/gaps"
import Reveal from "@/reveal"

// Azeroth's map: the plane every zone is placed on.
const WORLD = 947
const MEDIA = "Interface/AddOns/OrdaenMap/media/openmap/"
// The zones OpenMap measured a territory for (`MapTerritory`): their land and the sea off their coasts.
const TERRITORIES: Map<Integer, Boolean> = {
  [1411]: true, [1412]: true, [1413]: true, [1416]: true, [1417]: true, [1418]: true, [1419]: true, [1420]: true,
  [1421]: true, [1422]: true, [1423]: true, [1424]: true, [1425]: true, [1426]: true, [1427]: true, [1428]: true,
  [1429]: true, [1430]: true, [1431]: true, [1432]: true, [1433]: true, [1434]: true, [1435]: true, [1436]: true,
  [1437]: true, [1438]: true, [1439]: true, [1440]: true, [1441]: true, [1442]: true, [1443]: true, [1444]: true,
  [1445]: true, [1446]: true, [1447]: true, [1448]: true, [1449]: true, [1450]: true, [1451]: true, [1452]: true,
  [2482]: true, [2521]: true, [2548]: true, [2652]: true
}
// How far in the wheel zooms: the most screen pixels to a unit of Azeroth's art, and one notch's step.
const MOST_SCALE: Number = 60
const STEP: Number = 1.25
// What of the view, past each side, counts as near: zones there are drawn before they come in.
const NEAR: Number = 0.25
// A city's own map shows once it is this wide a share of the view: under that, its zone's painting of it.
const CITY_SHARE: Number = 0.15
// How often the arrow follows the player, in seconds.
const ARROW_EVERY: Number = 0.1
const ARROW_SIZE: Number = 28
// A zone's layers, bottom to top: its base art, the pieces the player hasn't explored, those explored.
const BASE_SUB = 0
const UNEXPLORED_SUB = 1
const EXPLORED_SUB = 2
// The sea, one picture under the whole world: the deep ocean (`media/openmap/seaDeep`) stretched over the plane and
// mirrored past its edges, `SEA_REACH` world widths each side; round each continent its shallow shelf
// (`seaShelf/<map>`, the land's shape widened and blurred, in the zones' coastal sea colour) over a square twice the
// continent's size; and over all of it a seamless tile of ripples for close zoom. `SEA_SCALE_MAP`: the zone whose art
// pixels measure the ripples; `SEA_RIPPLE_PIXELS`: one tile's side in them; `SEA_RIPPLE_ALPHA`: their strength.
const SEA_REACH: Number = 1.5
const SEA_SCALE_MAP = 1436
const SEA_RIPPLE_PIXELS: Number = 640
const SEA_RIPPLE_ALPHA: Number = 0.35
// The continents whose land is kept as land over the sea (OpenMap's `MapLand`: a smooth colour field of the
// continent art's land, its ink and names left out), warmed toward the zones' parchment.
const CONTINENTS: Array<Integer> = [1414, 1415]
const LAND_R: Number = 0.96
const LAND_G: Number = 0.92
const LAND_B: Number = 0.84
const LAND_DESATURATION: Number = 0.25
// The parchment grain over that land, twice at sizes and offsets that never line up: { size, offset, strength }.
const GRAIN_TILE: Number = 14
const GRAIN_OCTAVES: Array<Array<Number>> = [[1, 0, 0.55], [2.618, 0.37, 0.5]]
// The blank map paper over the land no zone covers, twice at sizes and offsets that never line up:
// { size, offset (tiles), strength }.
const PAPER_LAYERS: Array<Array<Number>> = [[1, 0, 1], [2.618, 0.41, 0.5]]
// A classic map's art, as every zone map's.
const CLASSIC_WIDTH: Number = 1002
const CLASSIC_HEIGHT: Number = 668

// The smallest power of two from 16 up that holds `n`: an explored piece's last tile is a file that wide.
function powerOver(n: Number): Number {
  let size: Number = 16
  for (step of 1..12) {
    if (size >= n) { break }
    size = size * 2
  }
  return size
}

// A zone's art, which OpenMap's table of pieces is keyed by; 0 for none.
function artOf(map: Integer): Integer {
  return (Client.C_Map.GetMapArtID(map) ?? 0).floor()
}

// A piece's key, as OpenMap's table writes it and the client's explored pieces are told by: `"width:height:x:y"`.
function pieceKey(width: Number, height: Number, x: Number, y: Number): String {
  return `${width.floor()}:${height.floor()}:${x.floor()}:${y.floor()}`
}

// A map's first art layer: its size and its tiles' size.
function firstLayer(map: Integer): Client.UiMapLayerInfo | nil {
  const layers = Client.C_Map.GetMapArtLayers(map)
  if (layers == nil) { return nil }
  return layers[1]
}

// Where an art stands on the plane: its top left corner, the plane's units to one of its pixels across and down, and
// its tiles' size in pixels.
struct ArtPlace {
  const left: Number
  const top: Number
  const sx: Number
  const sy: Number
  const tileWidth: Number
  const tileHeight: Number
}

// An image `width` by `height` at `x`, `y` of an art, cut into its tiles (file ids or paths, row by row; 0 or none: a
// tile not drawn), on `frame` (which covers the plane), each through `mask` (and `also`, where given). A whole art's
// tile is a whole file cut at the art's edge; an explored piece's (`piece`) last tile is a file of the next power of
// two.
function drawTiles(
  frame: any Client.Frame,
  at: ArtPlace,
  files: Array<Number | String>,
  x: Number,
  y: Number,
  width: Number,
  height: Number,
  piece: Boolean,
  drawLayer: String,
  sub: Integer,
  mask: any Client.MaskTexture,
  also: any Client.MaskTexture | nil = nil
) {
  const tw = at.tileWidth
  const th = at.tileHeight
  const cols = (width / tw).ceil()
  const rows = (height / th).ceil()
  for (j of 1..rows) {
    const ph = j < rows ? th : height - (rows - 1) * th
    const fh = j < rows || !piece ? th : powerOver(ph)
    for (k of 1..cols) {
      const file = files[(j - 1) * cols + k] ?? 0
      const pw = k < cols ? tw : width - (cols - 1) * tw
      const fw = k < cols || !piece ? tw : powerOver(pw)
      if (file != 0 && pw > 0 && ph > 0) {
        const tex = frame.CreateTexture(nil, drawLayer, nil, sub)
        _ = tex.SetTexture(file, nil, nil, "TRILINEAR")
        tex.SetTexCoord(0, pw / fw, 0, ph / fh)
        tex.AddMaskTexture(mask)
        if (also != nil) { tex.AddMaskTexture(also) }
        tex.SetPoint("TOPLEFT", frame, "TOPLEFT", at.left + (x + (k - 1) * tw) * at.sx, -(at.top + (y + (j - 1) * th) * at.sy))
        tex.SetSize(pw * at.sx, ph * at.sy)
      }
    }
  }
}

// One zone's art: its frame on the canvas, built when it first comes near the view.
class ZoneArt {
  const id: Integer
  // Its rectangle on the plane, in Azeroth's art units.
  public const left: Number
  public const top: Number
  public const right: Number
  public const bottom: Number
  // A city: its own map shows only once it is wide enough in the view.
  public const city: Boolean
  public const frame: mut any Client.Frame
  public built = false

  constructor(id: Integer, left: Number, top: Number, right: Number, bottom: Number, city: Boolean, parent: any Client.Frame) {
    self.id = id
    self.left = left
    self.top = top
    self.right = right
    self.bottom = bottom
    self.city = city
    self.frame = Client.CreateFrame("Frame", nil, parent, nil)
    self.frame.SetAllPoints(parent)
    self.frame.Hide()
  }

  // The zone's tiles and explored pieces, each through its mask.
  public build(mut self) {
    self.built = true
    const layer = firstLayer(self.id)
    const files = Client.C_Map.GetMapArtLayerTextures(self.id, 1)
    if (layer == nil || files == nil) { return }
    const sx = (self.right - self.left) / layer.layerWidth
    const sy = (self.bottom - self.top) / layer.layerHeight
    const mask = self.frame.CreateMaskTexture()
    const file = TERRITORIES[self.id] == true ? `${MEDIA}territory/${self.id}` : (self.city ? MEDIA + "featherRound" : MEDIA + "feather")
    _ = mask.SetTexture(file, "CLAMPTOBLACKADDITIVE", "CLAMPTOBLACKADDITIVE")
    self.place(mask, 0, 0, layer.layerWidth * sx, layer.layerHeight * sy)
    const at: ArtPlace = { left: self.left, top: self.top, sx: sx, sy: sy, tileWidth: layer.tileWidth, tileHeight: layer.tileHeight }
    drawTiles(self.frame, at, files, 0, 0, layer.layerWidth, layer.layerHeight, false, "ARTWORK", BASE_SUB, mask)
    // The explored pieces as the client gives them, over the rest of the zone's pieces from OpenMap's table; a piece
    // the client shows only under the cursor isn't drawn.
    const seen: Map<String, Boolean> = {}
    for (piece of Client.C_MapExplorationInfo.GetExploredMapTextures(self.id) ?? []) {
      seen[pieceKey(piece.textureWidth, piece.textureHeight, piece.offsetX, piece.offsetY)] = true
      if (!piece.isShownByMouseOver) {
        drawTiles(self.frame, at, piece.fileDataIDs, piece.offsetX, piece.offsetY, piece.textureWidth, piece.textureHeight, true, "ARTWORK", EXPLORED_SUB, mask)
      }
    }
    for (piece of Reveal.piecesOf(artOf(self.id))) {
      if (seen[piece.key] != true) {
        drawTiles(self.frame, at, piece.files, piece.x, piece.y, piece.width, piece.height, true, "ARTWORK", UNEXPLORED_SUB, mask)
      }
    }
  }

  // A region at `x`, `y` of the zone's rectangle, `width` by `height`, in Azeroth's art units.
  place(self, region: any Client.MaskTexture, x: Number, y: Number, width: Number, height: Number) {
    region.SetPoint("TOPLEFT", self.frame, "TOPLEFT", self.left + x, -(self.top + y))
    region.SetSize(width, height)
  }

  // Whether it meets the rectangle `left` to `right`, `top` to `bottom`.
  public meets(self, left: Number, top: Number, right: Number, bottom: Number): Boolean {
    return self.right > left && self.left < right && self.bottom > top && self.top < bottom
  }
}

// Art over the land no zone's map covers, under every zone: one of Blizzard's classic maps, or a gap painted by hand.
// Its frame on the canvas, built when it first comes near the view.
class Patch {
  const art: Gaps.ClassicMap | Gaps.GapFill
  // Its rectangle on the plane, in Azeroth's art units.
  public const left: Number
  public const top: Number
  public const right: Number
  public const bottom: Number
  public const frame: mut any Client.Frame
  public built = false

  constructor(art: Gaps.ClassicMap | Gaps.GapFill, width: Number, height: Number, parent: any Client.Frame) {
    self.art = art
    self.left = art.left * width
    self.top = art.top * height
    self.right = art.right * width
    self.bottom = art.bottom * height
    self.frame = Client.CreateFrame("Frame", nil, parent, nil)
    self.frame.SetAllPoints(parent)
    self.frame.Hide()
  }

  public build(mut self) {
    self.built = true
    const art = self.art
    if (art is Gaps.GapFill) {
      // A fill painted by hand: its 256-pixel tiles, the last of a row or a column cut where the painting ends.
      const sx = (self.right - self.left) / art.width
      const sy = (self.bottom - self.top) / art.height
      for (tile of art.tiles) {
        const col = (tile - 1) % art.columns
        const row = (tile - 1 - col) / art.columns
        const pw = (256.0).min(art.width - col * 256)
        const ph = (256.0).min(art.height - row * 256)
        const tex = self.frame.CreateTexture(nil, "ARTWORK", nil, 1)
        _ = tex.SetTexture(`${MEDIA}gapFill/${art.name}_${tile}`, nil, nil, "TRILINEAR")
        tex.SetTexCoord(0, pw / 256, 0, ph / 256)
        self.place(tex, col * 256 * sx, row * 256 * sy, pw * sx, ph * sy)
      }
      return
    }
    // A classic map: its 1002 by 668 art's tiles, through its land and shallows where no zone paints.
    const sx = (self.right - self.left) / CLASSIC_WIDTH
    const sy = (self.bottom - self.top) / CLASSIC_HEIGHT
    const mask = self.frame.CreateMaskTexture()
    _ = mask.SetTexture(`${MEDIA}coastArt/${art.name}`, "CLAMPTOBLACKADDITIVE", "CLAMPTOBLACKADDITIVE")
    self.place(mask, 0, 0, self.right - self.left, self.bottom - self.top)
    const at: ArtPlace = { left: self.left, top: self.top, sx: sx, sy: sy, tileWidth: 256, tileHeight: 256 }
    drawTiles(self.frame, at, art.files, 0, 0, CLASSIC_WIDTH, CLASSIC_HEIGHT, false, "ARTWORK", 0, mask)
  }

  place(self, region: any Client.MaskTexture, x: Number, y: Number, width: Number, height: Number) {
    region.SetPoint("TOPLEFT", self.frame, "TOPLEFT", self.left + x, -(self.top + y))
    region.SetSize(width, height)
  }

  public meets(self, left: Number, top: Number, right: Number, bottom: Number): Boolean {
    return self.right > left && self.left < right && self.bottom > top && self.top < bottom
  }
}

public class WorldCanvas {
  // What the window embeds: it clips the plane and takes the drag and the wheel.
  public const view: mut any Client.Frame
  // The plane, Azeroth's art size, scaled and moved under the view.
  const plane: mut any Client.Frame
  const over: mut any Client.Frame
  const arrow: mut any Client.Texture
  // Azeroth's art size: the plane's units.
  width: Number = 0
  height: Number = 0
  zones: mut Array<mut ZoneArt> = []
  patches: mut Array<mut Patch> = []
  // Each map's rectangle on the plane, asked once: left, top, right, bottom.
  rects: mut Map<Integer, Array<Number>> = {}
  // The point of the plane at the view's top left corner, and screen pixels to a unit.
  x: Number = 0
  y: Number = 0
  scale: Number = 1
  // The view's frame level the zones stand over, as last told.
  level: Number = -1
  // A drag: where it began on the screen and where the view stood.
  dragging = false
  fromX: Number = 0
  fromY: Number = 0
  startX: Number = 0
  startY: Number = 0
  sinceArrow: Number = 0
  // The sea's mottling (dark, light, then the finer dark and light), and its tile in the plane's units.
  // Whether it has been laid out once: the first opening finds the player.
  placed = false

  constructor() {
    self.view = Client.CreateFrame("Frame", nil, Client.UIParent, nil)
    self.view.Hide()
    self.view.SetClipsChildren(true)
    self.view.EnableMouse(true)
    self.view.EnableMouseWheel(true)
    self.plane = Client.CreateFrame("Frame", nil, self.view, nil)
    self.over = Client.CreateFrame("Frame", nil, self.view, nil)
    self.over.SetAllPoints(self.view)
    self.arrow = self.over.CreateTexture(nil, "OVERLAY", nil, 0)
    _ = self.arrow.SetTexture("Interface/Minimap/MinimapArrow")
    self.arrow.SetSize(ARROW_SIZE, ARROW_SIZE)
    self.arrow.Hide()
    self.view.SetScript("OnShow", (): nil => {
      self.opened()
      return nil
    })
    self.view.SetScript("OnSizeChanged", (): nil => {
      self.layout()
      return nil
    })
    self.view.SetScript("OnMouseWheel", (frame: Unknown, delta: Number): nil => {
      self.zoomAt(delta)
      return nil
    })
    self.view.SetScript("OnMouseDown", (frame: Unknown, button: String): nil => {
      if (button == "LeftButton") { self.startDrag() }
      return nil
    })
    self.view.SetScript("OnMouseUp", (): nil => {
      self.dragging = false
      return nil
    })
    self.view.SetScript("OnUpdate", (frame: Unknown, elapsed: Number): nil => {
      self.tick(elapsed)
      return nil
    })
  }

  // Ended with Map: hidden, and its scripts taken off, as the client keeps a frame's scripts after.
  destructor() {
    self.view.Hide()
    for (script of ["OnShow", "OnSizeChanged", "OnMouseWheel", "OnMouseDown", "OnMouseUp", "OnUpdate"]) {
      self.view.SetScript(script, nil)
    }
  }

  public show(self) { self.view.Show() }
  public hide(mut self) {
    self.dragging = false
    self.view.Hide()
  }

  // The plane and its zones, made the first time the map opens.
  build(mut self) {
    const layer = firstLayer(WORLD)
    if (layer == nil) { return }
    self.width = layer.layerWidth
    self.height = layer.layerHeight
    self.plane.SetSize(self.width, self.height)
    const found: Array<mut ZoneArt> = []
    for (info of Client.C_Map.GetMapChildrenInfo(WORLD, .Zone, true) ?? []) {
      const id = info.mapID.floor()
      const rect = self.rectOf(id)
      if (rect != nil) {
        // A city: a map with no explored-area pieces, in the client's list or OpenMap's, and no territory.
        const explored = Client.C_MapExplorationInfo.GetExploredMapTextures(id) ?? []
        const city = explored.length == 0 && Reveal.piecesOf(artOf(id)).length == 0 && TERRITORIES[id] != true
        found.push(new ZoneArt(id, rect[1] ?? 0, rect[2] ?? 0, rect[3] ?? 0, rect[4] ?? 0, city, self.plane))
      }
    }
    // The biggest first, so a small zone stands over the big ones round it; the cities over every zone.
    found.sort((a, b) => {
      if (a.city != b.city) { return b.city }
      return (a.right - a.left) * (a.bottom - a.top) > (b.right - b.left) * (b.bottom - b.top)
    })
    self.zones = found
    // Under every zone: Blizzard's classic maps, then the gaps painted by hand over them.
    const patches: Array<mut Patch> = []
    for (art of Gaps.classic()) { patches.push(new Patch(art, self.width, self.height, self.plane)) }
    for (art of Gaps.fills()) { patches.push(new Patch(art, self.width, self.height, self.plane)) }
    self.patches = patches
    self.level = -1
    self.buildSea()
  }

  // The sea under every zone: the deep ocean, each continent's shelf, the ripples; the zones' painted coasts fade into
  // it through their masks. Then each continent's land.
  buildSea(mut self) {
    const left = -SEA_REACH * self.width
    const top = -SEA_REACH * self.height
    const width = (1 + 2 * SEA_REACH) * self.width
    const height = (1 + 2 * SEA_REACH) * self.height
    const deep = self.plane.CreateTexture(nil, "BACKGROUND", nil, 0)
    _ = deep.SetTexture(MEDIA + "seaDeep", "MIRROR", "MIRROR", "TRILINEAR")
    deep.SetTexCoord(left / self.width, (left + width) / self.width, top / self.height, (top + height) / self.height)
    self.onPlane(deep, left, top, width, height)
    for (map of CONTINENTS) {
      const rect = self.rectOf(map)
      if (rect != nil) {
        const across = (rect[3] ?? 0) - (rect[1] ?? 0)
        const down = (rect[4] ?? 0) - (rect[2] ?? 0)
        const shelf = self.plane.CreateTexture(nil, "BACKGROUND", nil, 1)
        _ = shelf.SetTexture(`${MEDIA}seaShelf/${map}`, "CLAMP", "CLAMP", "TRILINEAR")
        self.onPlane(shelf, (rect[1] ?? 0) - across / 2, (rect[2] ?? 0) - down / 2, across * 2, down * 2)
      }
    }
    const zone = self.rectOf(SEA_SCALE_MAP)
    const art = firstLayer(SEA_SCALE_MAP)
    const pixel: Number = zone != nil && art != nil ? ((zone[3] ?? 0) - (zone[1] ?? 0)) / art.layerWidth : 0.05
    const side = SEA_RIPPLE_PIXELS * pixel
    const ripples = self.plane.CreateTexture(nil, "BACKGROUND", nil, 2)
    _ = ripples.SetTexture(MEDIA + "seaRipples", "REPEAT", "REPEAT", "TRILINEAR")
    ripples.SetTexCoord(left / side, (left + width) / side, top / side, (top + height) / side)
    ripples.SetAlpha(SEA_RIPPLE_ALPHA)
    self.onPlane(ripples, left, top, width, height)
    for (map of CONTINENTS) { self.buildLand(map) }
  }

  // A continent's land over the sea: its colour field and the parchment grain on it. Under every zone, filling the
  // land between them.
  buildLand(mut self, map: Integer) {
    const rect = self.rectOf(map)
    if (rect == nil) { return }
    const left = rect[1] ?? 0
    const top = rect[2] ?? 0
    const width = (rect[3] ?? 0) - left
    const height = (rect[4] ?? 0) - top
    const fade = self.plane.CreateMaskTexture()
    _ = fade.SetTexture(MEDIA + "featherWide", "CLAMPTOBLACKADDITIVE", "CLAMPTOBLACKADDITIVE")
    self.onPlane(fade, left, top, width, height)
    const land = self.plane.CreateMaskTexture()
    _ = land.SetTexture(`${MEDIA}land/${map}`, "CLAMPTOBLACKADDITIVE", "CLAMPTOBLACKADDITIVE")
    self.onPlane(land, left, top, width, height)
    const field = self.plane.CreateTexture(nil, "BORDER", nil, 2)
    _ = field.SetTexture(`${MEDIA}land/${map}`, nil, nil, "LINEAR")
    field.SetVertexColor(LAND_R, LAND_G, LAND_B)
    field.SetDesaturation(LAND_DESATURATION)
    self.onPlane(field, left, top, width, height)
    field.AddMaskTexture(fade)
    for (octave of GRAIN_OCTAVES) {
      const size = GRAIN_TILE * (octave[1] ?? 1)
      const offset = octave[2] ?? 0
      const grain = self.plane.CreateTexture(nil, "BORDER", nil, 6)
      _ = grain.SetTexture(MEDIA + "grain", "REPEAT", "REPEAT")
      grain.SetTexCoord(offset, offset + width / size, offset * 1.7, offset * 1.7 + height / size)
      grain.SetVertexColor(1, 1, 1, octave[3] ?? 0.5)
      self.onPlane(grain, left, top, width, height)
      grain.AddMaskTexture(fade)
      grain.AddMaskTexture(land)
    }
    // The gaps between and round its zones: the blank paper through a mask of where the land is, each tile's.
    const size = Gaps.tile()
    const paper = Gaps.paper()
    for (gap of Gaps.tilesOf(map)) {
      const x = left + gap.col * size
      const y = top + gap.row * size
      const ground = self.plane.CreateMaskTexture()
      _ = ground.SetTexture(`${MEDIA}gapLand/${map}_${gap.col}_${gap.row}`, "CLAMPTOBLACKADDITIVE", "CLAMPTOBLACKADDITIVE")
      self.onPlane(ground, x, y, size, size)
      for (index, layer of PAPER_LAYERS) {
        const tile = paper * (layer[1] ?? 1)
        const offset = layer[2] ?? 0
        const sheet = self.plane.CreateTexture(nil, "BORDER", nil, 2 + index)
        _ = sheet.SetTexture(MEDIA + "paper", "REPEAT", "REPEAT")
        sheet.SetTexCoord(x / tile + offset, (x + size) / tile + offset, y / tile + offset * 1.7, (y + size) / tile + offset * 1.7)
        sheet.SetVertexColor(1, 1, 1, layer[3] ?? 1)
        self.onPlane(sheet, x, y, size, size)
        sheet.AddMaskTexture(ground)
        sheet.AddMaskTexture(fade)
      }
    }
  }

  // A region over the plane's rectangle at `left`, `top`, `width` by `height`, in the plane's units.
  onPlane(self, region: any Client.MaskTexture, left: Number, top: Number, width: Number, height: Number) {
    region.SetPoint("TOPLEFT", self.plane, "TOPLEFT", left, -top)
    region.SetSize(width, height)
  }

  // A map's rectangle on the plane (left, top, right, bottom), or nil where it isn't on Azeroth's map.
  rectOf(mut self, id: Integer): Array<Number> | nil {
    const known = self.rects[id]
    if (known != nil) { return known }
    let left, right, top, bottom = Client.C_Map.GetMapRectOnMap(id, WORLD)
    if (left == nil || right == nil || top == nil || bottom == nil || right <= left || bottom <= top) { return nil }
    const rect = [left * self.width, top * self.height, right * self.width, bottom * self.height]
    self.rects[id] = rect
    return rect
  }

  // The map opened: built the first time, the first time on the player's zone, filling the view.
  opened(mut self) {
    if (self.zones.length == 0) {
      self.build()
      Debug.log("MAPARROW built: world %s x %s, %s zones, view %s x %s", self.width, self.height, self.zones.length, self.view.GetWidth(), self.view.GetHeight())
    }
    if (!self.placed) {
      self.placed = true
      self.findPlayer()
    }
    self.layout()
  }

  // The view on the player's zone, the zone filling it.
  findPlayer(mut self) {
    const map = Client.C_Map.GetBestMapForUnit("player")
    const rect = map != nil ? self.rectOf(map.floor()) : nil
    const width = self.view.GetWidth()
    const height = self.view.GetHeight()
    if (rect == nil || width <= 0 || height <= 0) {
      self.scale = self.least()
      self.x = 0
      self.y = 0
      return
    }
    const left = rect[1] ?? 0
    const top = rect[2] ?? 0
    const right = rect[3] ?? 0
    const bottom = rect[4] ?? 0
    self.scale = (width / (right - left)).min(height / (bottom - top)) * 0.95
    self.x = (left + right) / 2 - width / self.scale / 2
    self.y = (top + bottom) / 2 - height / self.scale / 2
  }

  // The least zoom: the whole world in the view.
  least(self): Number {
    const width = self.view.GetWidth()
    const height = self.view.GetHeight()
    if (self.width <= 0 || width <= 0) { return 1 }
    return (width / self.width).min(height / self.height) * 0.9
  }

  // The plane placed under the view as `x`, `y` and `scale` say, kept in reach, and the zones near the view drawn.
  layout(mut self) {
    if (self.width <= 0) { return }
    const width = self.view.GetWidth()
    const height = self.view.GetHeight()
    if (width <= 0 || height <= 0) { return }
    self.scale = self.scale.max(self.least()).min(MOST_SCALE)
    const across = width / self.scale
    const down = height / self.scale
    self.x = self.x.max(-across / 2).min(self.width - across / 2)
    self.y = self.y.max(-down / 2).min(self.height - down / 2)
    self.plane.SetScale(self.scale)
    self.plane.ClearAllPoints()
    self.plane.SetPoint("TOPLEFT", self.view, "TOPLEFT", -self.x, self.y)
    self.relevel()
    const left = self.x - across * NEAR
    const top = self.y - down * NEAR
    const right = self.x + across * (1 + NEAR)
    const bottom = self.y + down * (1 + NEAR)
    for (patch of self.patches) {
      if (patch.meets(left, top, right, bottom)) {
        if (!patch.built) { patch.build() }
        patch.frame.Show()
      } else {
        patch.frame.Hide()
      }
    }
    for (zone of self.zones) {
      const wide = !zone.city || (zone.right - zone.left) * self.scale >= width * CITY_SHARE
      if (wide && zone.meets(left, top, right, bottom)) {
        if (!zone.built) { zone.build() }
        zone.frame.Show()
      } else {
        zone.frame.Hide()
      }
    }
    self.placeArrow()
  }

  // Over the view's level, in their order: the plane (the sea and the land), the patches over the gaps, the zones,
  // and the arrow's frame over them. The window tells the view its level as it lays out.
  relevel(mut self) {
    const level = self.view.GetFrameLevel()
    if (level == self.level) { return }
    self.level = level
    self.plane.SetFrameLevel(level + 1)
    for (index, patch of self.patches) { patch.frame.SetFrameLevel(level + 1 + index) }
    const zonesFrom = level + 1 + self.patches.length
    for (index, zone of self.zones) { zone.frame.SetFrameLevel(zonesFrom + index) }
    self.over.SetFrameLevel(zonesFrom + self.zones.length + 1)
  }

  // The cursor on the view, in the view's units from its top left corner.
  cursor(self): Array<Number> {
    let x, y = Client.GetCursorPosition()
    const scale = self.view.GetEffectiveScale()
    return [x / scale - (self.view.GetLeft() ?? 0), (self.view.GetTop() ?? 0) - y / scale]
  }

  // A notch of the wheel: in or out, the point under the cursor staying under it.
  zoomAt(mut self, delta: Number) {
    const at = self.cursor()
    const cx = at[1] ?? 0
    const cy = at[2] ?? 0
    const wx = self.x + cx / self.scale
    const wy = self.y + cy / self.scale
    self.scale = (delta > 0 ? self.scale * STEP : self.scale / STEP).max(self.least()).min(MOST_SCALE)
    self.x = wx - cx / self.scale
    self.y = wy - cy / self.scale
    self.layout()
  }

  startDrag(mut self) {
    const at = self.cursor()
    self.dragging = true
    self.fromX = at[1] ?? 0
    self.fromY = at[2] ?? 0
    self.startX = self.x
    self.startY = self.y
  }

  // Each frame while the map shows: a drag moves the plane; the arrow follows the player every tenth of a second.
  tick(mut self, elapsed: Number) {
    if (self.dragging) {
      const at = self.cursor()
      self.x = self.startX - ((at[1] ?? 0) - self.fromX) / self.scale
      self.y = self.startY - ((at[2] ?? 0) - self.fromY) / self.scale
      self.layout()
      return
    }
    self.sinceArrow += elapsed
    if (self.sinceArrow < ARROW_EVERY) { return }
    self.sinceArrow = 0
    self.relevel()
    self.placeArrow()
  }

  // The player's arrow where the player is on the plane, turned as the player faces; hidden where the client gives
  // no place (an instance).
  placeArrow(mut self) {
    const map = Client.C_Map.GetBestMapForUnit("player")
    const at = map != nil ? Client.C_Map.GetPlayerMapPosition(map, "player") : nil
    const rect = map != nil ? self.rectOf(map.floor()) : nil
    if (at == nil || rect == nil) {
      if (self.arrow.IsShown() || !self.placed) { Debug.log("MAPARROW hidden: map %s, place %s, rect %s", map, at != nil, rect != nil) }
      self.arrow.Hide()
      return
    }
    const left = rect[1] ?? 0
    const top = rect[2] ?? 0
    const wx = left + at.x * ((rect[3] ?? 0) - left)
    const wy = top + at.y * ((rect[4] ?? 0) - top)
    self.arrow.ClearAllPoints()
    self.arrow.SetPoint("CENTER", self.over, "TOPLEFT", (wx - self.x) * self.scale, -(wy - self.y) * self.scale)
    self.arrow.SetRotation(Client.GetPlayerFacing() ?? 0)
    if (!self.arrow.IsShown()) {
      Debug.log("MAPARROW shown: map %s at %s, %s; on the view %s, %s; levels view %s over %s", map, wx, wy, (wx - self.x) * self.scale, (wy - self.y) * self.scale, self.view.GetFrameLevel(), self.over.GetFrameLevel())
    }
    self.arrow.Show()
  }
}
