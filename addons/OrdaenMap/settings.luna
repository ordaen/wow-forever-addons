// Ordaen Map's page in the settings window: whether the quest log opens beside the map (Map's own setting, which the
// client's `questLogOpen` follows), and a switch for each layer other modules put on the map, its hint naming what it
// shows. The same switches stand in OpenMap's menu, under «Ordaen».
import { Component, Section, SettingRow, Shown, ShownToggle, Switch } from "Ordaen"
import type { Layer } from "@/extend"
import Locale from "@/locales"

const RED: Color = Color::hex("#ff4040")

public struct Choices implements Plain {
  // The layers the player switched off, by their ids: one not named shows.
  hidden: mut map<string, boolean>
  // Whether the quest log stands docked on the map; apart by default. The client's `questLogOpen` follows it, never
  // the other way: Blizzard's map opening its side panel by itself leaves the quest log key Quests'.
  docked: boolean = false
}

// One layer's row: its title, its hint, and its switch, which the page flips through its owner.
class LayerRow implements Component {
  // Its switch was clicked: the layer's id.
  public flip: Event<string> = new Event()

  derived state: Shown = self.on ? .On : .Off

  id: Signal<string>
  title: Signal<string>
  hint: Signal<string>
  on: Signal<boolean>
  constructor(id: Signal<string>, title: Signal<string>, hint: Signal<string>, on: Signal<boolean>) {
    self.id = id
    self.title = title
    self.hint = hint
    self.on = on
  }

  mut onFlip() { self.flip.emit(self.id) }

  public render(): Template {
    return $ltml {
      <SettingRow label={self.title} hint={self.hint}>
        <ShownToggle state={self.state} @flip={self.onFlip} />
      </SettingRow>
    }
  }
}

public class GeneralPage implements Component {
  // A layer's switch was clicked: its id.
  public flip: Event<string> = new Event()

  openMap: Signal<boolean>
  docked: mut Signal<boolean>
  layers: Signal<array<any Layer>>
  hidden: Signal<map<string, boolean>>
  constructor(openMap: Signal<boolean>, docked: mut Signal<boolean>, layers: Signal<array<any Layer>>, hidden: Signal<map<string, boolean>>) {
    self.openMap = openMap
    self.docked = docked
    self.layers = layers
    self.hidden = hidden
  }

  mut onFlip(id: string) { self.flip.emit(id) }

  public render(): Template {
    return $ltml {
      <Section title={Locale::SECTION_MAP}>
        <text $if={!self.openMap} value={Locale::NO_OPENMAP} textColor={RED} />
        <Switch label={Locale::SETTING_DOCKED} hint={Locale::SETTING_DOCKED_TIP} value={mut self.docked} />
      </Section>
      <Section title={Locale::SECTION_LAYERS}>
        <text $if={self.layers.length == 0} value={Locale::NO_LAYERS} />
        <LayerRow $for={layer of self.layers} id={layer.id} title={layer.title} hint={layer.hint}
                  on={self.hidden[layer.id] != true} @flip={self.onFlip} />
      </Section>
    }
  }
}
