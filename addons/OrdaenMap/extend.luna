import Client from "$client"

// What other modules put on the world map: the contract, imported by type alone
// (`import type { Layer, Pin } from "OrdaenMap"`). A layer is an entry of Map's `layers` registry, added in a watch
// that follows Map's root, so it ends when either module ends. Map places a layer's pins on OpenMap's map wherever
// their zone is in view, and says what a pin's `lines` give while the cursor is on it. Pins that would stand on one
// another are drawn as one, its tooltip saying each one's lines; a click on it is the first one's layer's.

// A pin: where it stands (an `AreaTable` area, QuestieDB's and the client's zones alike, and where in it, 0 to 1
// across and down), what it shows, and what it is a pin of (the layer's own number: a quest's id).
public struct Pin {
  public of: integer
  public area: integer
  public x: number
  public y: number
  public icon: Asset
  // Drawn larger, over the others: the pin of what the player points at elsewhere (a quest under the cursor in the log).
  public lit: boolean = false
}

// A set of pins on the world map. Its pins are asked while the map shows, and again when what they read changes
// (a quest tracked, an objective done); never per frame.
public trait Layer {
  // Its own, stable: what the player's switch for it is kept by.
  public const id: string
  public const title: string
  // What it shows, on Map's settings page under its switch.
  public const hint: string
  public pins(): array<Pin>
  // What the pin's tooltip says, its first line its title.
  public lines(pin: Pin): array<string>
  // The player clicked the pin, with Shift held or not.
  public press(pin: Pin, shift: boolean)
}

// The map's side panel while it shows, docked (Blizzard's quest log, `WorldMapFrame.QuestLog`): the frame and its size
// in UI units. Quests draws its log over exactly that rectangle, a level above it, taking its clicks.
public struct SidePanel {
  public frame: any Client::Frame
  public width: number
  public height: number
}

// What a module says on a dungeon's card on OpenMap's map (Quests: the log's quests of that dungeon): an entry of Map's
// `dungeons`, added as a layer is. Map's section of the card holds every entry's lines, under its title.
public trait DungeonSection {
  // Its lines for a dungeon of these instances (their names, the client's); none where it has nothing to say.
  public lines(names: array<string>): array<string>
}
