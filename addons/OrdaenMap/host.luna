// What Map asks of the world map: OpenMap's API, Blizzard's map frame through `worldMap.lua`, and the client's
// `questLogOpen`. While it runs, OpenMap's townsfolk come from QuestieDB. `MapHost` is what Map asks; `OpenMapHost` asks the game. Everything Map places goes through here:
// where a pin stands on the canvas, the pins' own frames, OpenMap's menu.
import Client from "$client"
import { OpenMapAPI } from "OpenMap"
import { LibQuestieDB } from "QuestieDB"
import { mapOfArea } from "@/areas"
import type { Pin, SidePanel } from "@/extend"
import WorldMap from "@/worldMap"

// The API Map is written against: major 1, from version 4 on.
const API_MAJOR = 1
const API_VERSION = 4

// A pin placed: where it stands on the canvas, 0 to 1.
public struct Placed {
  pin: Pin
  x: Number
  y: Number
}

public trait MapHost {
  // The map showed or hid, turned to another map, or OpenMap's view moved.
  public const changed: Event<nil>
  // A drawn pin clicked: its place in what `draw` was given (from 1), and whether Shift was held.
  public const pressed: Event<(Integer, Boolean)>
  public start(mut self)
  public stop(mut self)
  // Whether OpenMap is there, of the API Map is written against.
  public present(self): Boolean
  // Whether the world map shows.
  public shown(self): Boolean
  // Docked: the client's `questLogOpen`, which Blizzard's map opens its side panel by.
  public docked(self): Boolean
  public dock(mut self, on: Boolean)
  // The world map opened at the map that holds the area (an `AreaTable` area), as the game's «Show on map» turns it;
  // the map it shows where the area is none of a map's.
  public open(mut self, area: Integer)
  // The game's quest marks (its pins, a quest's shaded area) of this quest alone, its area drawn; 0: every quest's.
  public onlyQuest(mut self, quest: Integer)
  // Where the pin stands on the canvas, 0 to 1; nil where its zone isn't in view.
  public place(mut self, pin: Pin): Placed | nil
  // The pins on the canvas, each with its tooltip's lines.
  public draw(mut self, placed: Array<Placed>, lines: Array<Array<String>>)
  // A switch in OpenMap's menu.
  public menuSwitch(mut self, id: String, label: String, get: () => Boolean, set: (on: Boolean) => nil)
  // Ordaen's section of a dungeon's card: `run` gives its title and lines for the dungeon's map and instances.
  public dungeonSection(mut self, run: (map: Integer, names: Array<String>) => Array<String>)
  // The map's side panel while it shows; nil while it doesn't.
  public sidePanel(self): SidePanel | nil
}

// How big a pin is on the screen, in UI units.
const PIN_SIZE = 20
// How much larger a lit pin is drawn.
const LIT_SCALE: Number = 1.5
// How far past the canvas's edges a pin still stands (the stitched view shows past the map underneath).
const REACH: Number = 0.5
// How much of the stitched view a map opened at fills.
const MAP_FILL: Number = 0.8

public class OpenMapHost implements MapHost {
  public const changed: Event<nil> = new Event()
  public const pressed: Event<(Integer, Boolean)> = new Event()
  // The pins' frames, kept and used again.
  pins: mut Array<any Client.Button> = []

  // Who OpenMap's callbacks are registered for (CallbackHandler keys them by a table).
  owner: Table = {}

  public start(mut self) {
    WorldMap.listen((): nil => {
      self.changed.emit()
      return nil
    })
    if (self.present()) {
      const heard = (event: String): nil => {
        self.changed.emit()
        return nil
      }
      OpenMapAPI.RegisterCallback(self.owner, "OpenMap_ViewChanged", heard)
      OpenMapAPI.RegisterCallback(self.owner, "OpenMap_StitchedChanged", heard)
      // Read as Quests reads it: contract 4.
      let held, _ = LibQuestieDB.RequireContract(4)
      if (held) { WorldMap.townsfolk(mapOfArea) }
    }
  }

  public stop(mut self) {
    WorldMap.forget()
    WorldMap.onlyQuest(0)
    if (self.present()) {
      OpenMapAPI.UnregisterAllCallbacks(self.owner)
      WorldMap.noTownsfolk()
      WorldMap.noDungeonSection()
    }
    self.draw([], [])
  }

  public present(self): Boolean { return OpenMapAPI.major == API_MAJOR && OpenMapAPI.version >= API_VERSION }

  public shown(self): Boolean { return WorldMap.shownMap() != 0 }

  public docked(self): Boolean { return Client.C_CVar.GetCVarBool("questLogOpen") == true }

  public dock(mut self, on: Boolean) { _ = Client.C_CVar.SetCVar("questLogOpen", on ? "1" : "0") }

  // OpenMap's stitched map keeps its own view whatever map the client opens at: it is glided to the area's map, the
  // map filling most of it.
  public open(mut self, area: Integer) {
    const map = mapOfArea[area]
    // The map already open there isn't opened again: the game would make every pin anew.
    if (map == nil || WorldMap.shownMap() != map) { Client.C_Map.OpenWorldMap(map) }
    if (map == nil || !self.present() || !OpenMapAPI.IsStitched()) { return }
    let left, top = OpenMapAPI.WorldFromMap(map, 0, 0)
    let right, bottom = OpenMapAPI.WorldFromMap(map, 1, 1)
    if (left == nil || top == nil || right == nil || bottom == nil) { return }
    const span = (right - left).max(bottom - top)
    _ = OpenMapAPI.ShowWorld((left + right) / 2, (top + bottom) / 2, span > 0 ? MAP_FILL / span : nil)
  }

  public onlyQuest(mut self, quest: Integer) { WorldMap.onlyQuest(quest) }

  public place(mut self, pin: Pin): Placed | nil {
    const shown = WorldMap.shownMap()
    const map = mapOfArea[pin.area] ?? 0
    if (shown == 0 || map == 0) { return nil }
    if (self.present() && OpenMapAPI.IsStitched()) {
      let u, v = OpenMapAPI.WorldFromMap(map, pin.x, pin.y)
      if (u == nil || v == nil) { return nil }
      let x, y = OpenMapAPI.MapFromWorld(shown, u, v)
      return x != nil && y != nil ? OpenMapHost.within(pin, x, y) : nil
    }
    if (map == shown) { return { pin: pin, x: pin.x, y: pin.y } }
    let left, right, top, bottom = Client.C_Map.GetMapRectOnMap(map, shown)
    if (left == nil || right == nil || top == nil || bottom == nil) { return nil }
    return OpenMapHost.within(pin, left + pin.x * (right - left), top + pin.y * (bottom - top))
  }

  within(pin: Pin, x: Number, y: Number): Placed | nil {
    const near = x > -REACH && x < 1 + REACH && y > -REACH && y < 1 + REACH
    return near ? { pin: pin, x: x, y: y } : nil
  }

  public draw(mut self, placed: Array<Placed>, lines: Array<Array<String>>) {
    const canvas = WorldMap.canvas()
    if (canvas == nil) { return }
    const width = canvas.GetWidth()
    const height = canvas.GetHeight()
    // A pin keeps its size on the screen whatever the canvas's zoom.
    const size = PIN_SIZE * Client.UIParent.GetEffectiveScale() / canvas.GetEffectiveScale()
    // Above OpenMap's art; none built yet (nil), above the canvas alone.
    const level = (self.present() ? OpenMapAPI.ArtTopLevel() ?? 0 : 0) + 1
    for (index, at of placed) {
      const frame = self.pinFrame(index, canvas)
      const said = lines[index] ?? []
      const drawnSize = at.pin.lit ? size * LIT_SCALE : size
      frame.SetSize(drawnSize, drawnSize)
      frame.ClearAllPoints()
      frame.SetPoint("CENTER", canvas, "TOPLEFT", width * at.x, -height * at.y)
      frame.SetFrameLevel(at.pin.lit ? level + 1 : level)
      frame.SetNormalTexture(at.pin.icon)
      frame.SetScript("OnEnter", (): nil => {
        WorldMap.tip(frame, said)
        return nil
      })
      frame.Show()
    }
    for (index of placed.length + 1..self.pins.length) {
      self.pins[index]?.Hide()
    }
  }

  pinFrame(mut self, index: Integer, canvas: any Client.Frame): any Client.Button {
    const kept = self.pins[index]
    if (kept != nil) { return kept }
    const made = new Client.Button(canvas)
    // The frame stands for the index-th pin drawn, whichever pin that is now.
    made.SetScript("OnClick", (): nil => {
      self.pressed.emit(index, Client.IsShiftKeyDown())
      return nil
    })
    made.SetScript("OnLeave", (): nil => {
      WorldMap.untip()
      return nil
    })
    self.pins.push(made)
    return made
  }

  public menuSwitch(mut self, id: String, label: String, get: () => Boolean, set: (on: Boolean) => nil) {
    if (!self.present()) { return }
    OpenMapAPI.RegisterMenuToggle("OrdaenMap", { id: id, label: label, get: get, set: set, tab: "show", section: "Ordaen" })
  }

  public dungeonSection(mut self, run: (map: Integer, names: Array<String>) => Array<String>) {
    if (self.present()) { WorldMap.dungeonSection(run) }
  }

  public sidePanel(self): SidePanel | nil {
    let frame, width, height = WorldMap.sidePanel()
    return frame == nil ? nil : { frame: frame, width: width, height: height }
  }
}
