// Many options: a Stormwind guard's

// A guard's directions: seventeen places.
function guard(): Test.Npc {
  let options: Array<Client.GossipOptionUIInfo> = []
  for (index of 1..17) { options.push(option(500 + index, `Place ${index}`, index - 1, TALK)) }
  return { name: "Stormwind City Guard", id: 68, text: "Where would you like to go?", options: options }
}

test "many options flow into columns of nine, the window wider and never past the screen's foot" {
  Test.mount(nil, SCREEN)
  Test.talk(guard())
  const page = Test.page().window("Stormwind City Guard")
  const first = page.text("Place 1").rect()
  const ninth = page.text("Place 9").rect()
  const tenth = page.text("Place 10").rect()
  Test.expect(tenth.left > first.right && (tenth.top - first.top).abs() < 1 && ninth.top > first.top)
  Test.expect(page.text("Place 17").rect().bottom < 900)
}

test "the window widens for the columns: the last one stands inside it" {
  Test.mount(nil, SCREEN)
  Test.talk(guard())
  const page = Test.page().window("Stormwind City Guard")
  Test.expect(page.text("Place 17").rect().right <= page.rect().right)
}

test "the keys 1–9 are the first column's as the list shows" {
  Test.mount(nil, SCREEN)
  Test.talk(guard())
  Test.flush()
  const page = Test.page().window("Stormwind City Guard")
  // One keycap a line of the first column: «1» to «9» once each.
  Test.expect(page.text("9").count() == 1 && page.text("Tab: the keys move to the next column").shown())
  Test.shot("a guard's seventeen places in two columns, the keys on the first")
  _ = Test.keyBound("2")
  Test.expect(asked() == "option 502")
}

test "Tab gives the keys to the next column" {
  Test.mount(nil, SCREEN)
  Test.talk(guard())
  Test.flush()
  _ = Test.key(Test.Move.Next)
  Test.flush()
  _ = Test.keyBound("2")
  Test.expect(asked() == "option 511")
}

test "Shift+Tab gives them back to the column before" {
  Test.mount(nil, SCREEN)
  Test.talk(guard())
  Test.flush()
  _ = Test.key(Test.Move.Next)
  Test.flush()
  _ = Test.key(Test.Move.Back)
  Test.flush()
  _ = Test.keyBound("3")
  Test.expect(asked() == "option 503")
}

test "past nine lines no key but 1–9 is the window's" {
  Test.mount(nil, SCREEN)
  Test.talk(guard())
  Test.flush()
  Test.expect(!Test.keyBound("0") && !Test.keyBound("Q"))
}

test "a list the digits reach has one column and no word of Tab" {
  Test.mount(nil, SCREEN)
  Test.talk(innkeeper())
  Test.flush()
  Test.expect(!window().text("Tab: the keys move to the next column").shown())
}

// The scroll from its sheet's top left corner to its bottom right.
function scrollOf(page: Test.Part): Test.Rect {
  const top = page.box(SHEET_ART.topLeft).rect()
  const bottom = page.box(SHEET_ART.bottomRight).rect()
  return { left: top.left, right: bottom.right, top: top.top, bottom: bottom.bottom }
}

test "the NPC's words stand on the window, no parchment: it holds the lore alone" {
  Test.mount(nil, SCREEN)
  Test.talk(guard())
  const page = Test.page().window("Stormwind City Guard")
  Test.expect(page.text("Where would you like to go?").shown())
  Test.expect(!page.box(SHEET_ART.topLeft).shown())
  Test.shot("the guard's words and list on the window, without the parchment")
}

test "over the well the scroll is as high as its words, from its least height up" {
  Test.mount(nil, SCREEN)
  Test.talk(innkeeper())
  Test.quest({ text: "Short.", ..pie() })
  Events.QUEST_DETAIL.emit(nil)
  const short = scrollOf(window())
  Test.quest({ text: "Maggie bakes a pie each morning.\n\nShe needs apples.\n\nAnd flour.\n\nAnd a good oven.\n\nBring them.", ..pie() })
  Events.QUEST_DETAIL.emit(nil)
  const longer = scrollOf(window())
  // Its words all shown, none scrolled away: the scroll grows, the window with it, and it stays on the screen.
  Test.expect(longer.bottom - longer.top > short.bottom - short.top + 200)
  Test.expect(window().rect().bottom <= 900)
}

test "the scroll stands at one size, 5:3, on every quest page" {
  Test.mount(nil, SCREEN)
  Test.talk(innkeeper())
  Test.quest({ text: "Short.", ..pie() })
  Events.QUEST_DETAIL.emit(nil)
  const page = window()
  const listed = scrollOf(page)
  const height = listed.bottom - listed.top
  Test.expect(height > 150)
  Test.expect(((listed.right - listed.left) / height - 5 / 3).abs() < 0.01)
  // The words stand on the paper, inside its torn edges.
  const paper = page.box(SHEET_ART.middle).rect()
  const words = page.text("A Pie for Maggie").rect()
  Test.expect(words.top >= paper.top && words.bottom <= paper.bottom)
  Test.expect(words.left >= listed.left + (listed.right - listed.left) * 0.05 && words.right - words.left > 50)
  // A long quest's page keeps the same size (its text scrolls).
  Test.quest(pie())
  Events.QUEST_DETAIL.emit(nil)
  const quest = scrollOf(window())
  Test.expect((listed.bottom - listed.top - (quest.bottom - quest.top)).abs() < 0.5)
}
