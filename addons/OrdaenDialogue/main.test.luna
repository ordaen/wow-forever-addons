  Test.talk(innkeeper())
  Test.quest({ id: 32, title: "Friends", text: "Be friends." })
  Events.QUEST_DETAIL.emit(nil)
  Test.expect(Quests == nil && Test.errors().length == 0)
  Test.expect(window().text("Be friends.").shown() && !window().texts().join("|").contains("Stormwind"))
}

