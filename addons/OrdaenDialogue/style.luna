// The dialogue window's look: its size, and the colours of what each says. The parchment above and the dark well
// below are the library's quest page (`Scroll`, the `SCROLL_` and `WELL_` colours), shared with Quests' log.
import { Line } from "$ltml"
import { SCROLL_DIM, SCROLL_HEAD, SCROLL_INK, WELL_DIM, WELL_GOLD, WELL_GREEN, WELL_RED, WELL_RULE, WELL_TEXT } from "OrdaenQuestPage"

// What Ordaen's window frame takes across past the room the window was sized for.
const FRAME_ACROSS = 3.7ui
public const WIDTH: number<Length> = 515.625dp + FRAME_ACROSS
public const HEIGHT: number<Length> = 820.3125dp

// On the parchment.
public const INK: color = SCROLL_INK
public const INK_HEAD: color = SCROLL_HEAD
public const INK_DIM: color = SCROLL_DIM
// In the well.
public const TEXT: color = WELL_TEXT
public const NAME: color = #ffd100
public const DIM: color = WELL_DIM
public const RED: color = WELL_RED
public const GREEN: color = WELL_GREEN
public const GOLD: color = WELL_GOLD
public const RULE: Line = WELL_RULE
public const GROUP_TAG: color = #7a1e00
public const ICON: number<Length> = 18.75dp
