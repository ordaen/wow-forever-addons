// The NPC's list in the well, in columns of nine: each line of the column the keys are on with its key (`LINE_KEYS`),
// the other columns' the keycap's room alone,
// its icon (the game's gossip icon, or the quest's «!» and «?», a quest in progress greyed), a quest's level in the
// quest log's difficulty colour (a too-easy quest's title dimmed), its title, and «auto» on an option picked on its
// own. Left-click, Enter or Space picks a line; right-click on a plain option opens its menu: «Always pick this
// option».
import { Frame, Key, Track } from "$ltml"
import { Component, Menu, MenuEntry, PickRow, SECONDARY_TEXT, colorOf } from "Ordaen"
import { Keycap } from "OrdaenQuestPage"
import Locale from "@/locales"
import { Line, LineKind } from "@/read"
import Style from "@/style"

// The title as wide as it is, never wrapped (the window widens to hold the longest); «auto» right after it.
const COLUMNS: Array<Track> = ["max-content", "max-content", "max-content", "max-content", "max-content"]
// A key that picks a line, and its name on the keycap.
public struct LineKey {
  const key: Key
  const name: String
}

// The keys the window hears: the digits 1–9, a line's place in the column the keys are on (and a quest's reward).
// Past nine lines the list has columns, and Tab moves the keys to the next.
public const LINE_KEYS: Array<LineKey> = [
  { key: Key::Digit1, name: "1" }, { key: Key::Digit2, name: "2" }, { key: Key::Digit3, name: "3" },
  { key: Key::Digit4, name: "4" }, { key: Key::Digit5, name: "5" }, { key: Key::Digit6, name: "6" },
  { key: Key::Digit7, name: "7" }, { key: Key::Digit8, name: "8" }, { key: Key::Digit9, name: "9" }
]

// The name of the key at that place in a column; "" past the keys.
public function keyName(place: Integer): String { return LINE_KEYS[place]?.name ?? "" }

// The place of the line a key picks; 0 for a key that picks none.
public function placeOf(key: Key): Integer {
  for (index, lineKey of LINE_KEYS) {
    if (lineKey.key == key) { return index }
  }
  return 0
}

// The most lines a column of the list holds, one a key: past it they flow into the next column, the window widening.
public const COLUMN_LINES: Integer = LINE_KEYS.length

// A line of the list: its place among the lines, which a pick goes by, and its place in its column, its key.
public struct Placed {
  const line: Line
  const index: Integer
  const place: Integer
}

// The lines in columns of as many as the most a column holds lets them be even, each column top to bottom.
public function columnsOf(lines: Array<Line>): Array<Array<Placed>> {
  const count = ((lines.length + COLUMN_LINES - 1) / COLUMN_LINES).floor().max(1)
  const tall = ((lines.length + count - 1) / count).floor()
  let columns: Array<Array<Placed>> = []
  let column: Array<Placed> = []
  for (index, line of lines) {
    column.push({ line: line, index: index, place: column.length + 1 })
    if (column.length == tall) {
      columns.push(column)
      column = []
    }
  }
  if (column.length > 0) { columns.push(column) }
  return columns
}

const GREY: Color = Color::hex("#8c8c8c")
const WHITE: Color = Color::hex("#ffffff")

// What a line's title is drawn in: a quest's gold, a quest in progress or a too-easy one dimmed, an option the ink.
function titleColor(line: Line): Color {
  if (line.kind == LineKind::Option) { return Style::TEXT }
  if (line.kind == LineKind::InProgress || line.difficulty == .Trivial) { return Style::DIM }
  return Style::NAME
}

// An answer to the question the window asks (Yes, No): its key, its word; a click, Enter or Space gives it.
public class AnswerRow implements Component {
  public pick: Event<Integer> = new Event()

  derived key: String = keyName(self.index)

  label: Signal<String>
  index: Signal<Integer>
  hints: Signal<Boolean>
  constructor(label: Signal<String>, index: Signal<Integer>, hints: Signal<Boolean>) {
    self.label = label
    self.index = index
    self.hints = hints
  }

  onPick(mut self) { self.pick.emit(peek self.index) }

  public render(self): Template {
    return $ltml {
      <PickRow columns={ANSWER_COLUMNS} @pick={self.onPick}>
        <Keycap $if={self.hints} key={self.key} />
        <box $else />
        <text value={self.label} textColor={Style::TEXT} wrap={.None} />
      </PickRow>
    }
  }
}

const ANSWER_COLUMNS: Array<Track> = ["max-content", "max-content"]

// A column of the list: a stop of the keyboard's focus (Tab, Shift+Tab), its rows none; the keys 1–9 are its lines'
// while it has the focus, the first column's as the list shows. The column the keys are on is where Tab counts from
// while nothing has the focus, so the first Tab gives them to the next.
public class OptionColumn implements Component {
  public pick: Event<Integer> = new Event()
  public mark: Event<Integer> = new Event()
  public focus: Event<Integer> = new Event()

  lines: Signal<Array<Placed>>
  number: Signal<Integer>
  keysHere: Signal<Boolean>
  hints: Signal<Boolean>
  // The NPC's options the player marked, by their IDs.
  marked: Signal<Array<Integer>>
  constructor(
    lines: Signal<Array<Placed>>,
    number: Signal<Integer>,
    keysHere: Signal<Boolean>,
    hints: Signal<Boolean>,
    marked: Signal<Array<Integer>>
  ) {
    self.lines = lines
    self.number = number
    self.keysHere = keysHere
    self.hints = hints
    self.marked = marked
  }

  onFocus(mut self, frame: any Frame) { self.focus.emit(peek self.number) }
  isMarked(self, line: Line): Boolean { return line.kind == LineKind::Option && self.marked.any(option => option == line.id) }
  onPick(mut self, index: Integer) { self.pick.emit(index) }
  onMark(mut self, index: Integer) { self.mark.emit(index) }

  public render(self): Template {
    return $ltml {
      <box gap={0.5sp} tabStop={true} tabStart={self.keysHere} @focusEnter={self.onFocus}>
        <OptionRow $for={placed of self.lines} line={placed.line} index={placed.index} place={placed.place}
                   keysHere={self.keysHere} hints={self.hints}
                   marked={self.isMarked(placed.line)}
                   @pick={self.onPick} @mark={self.onMark} />
      </box>
    }
  }
}

public class OptionRow implements Component {
  public pick: Event<Integer> = new Event()
  public mark: Event<Integer> = new Event()

  derived keyed: Boolean = self.hints
  // Its key while the keys are on its column; else the keycap's room alone.
  derived key: String = self.keysHere ? keyName(self.place) : ""
  derived leveled: Boolean = self.line.level > 0
  derived levelColor: Color = colorOf(self.line.difficulty)
  derived levelText: String = `(${self.line.level})`
  derived color: Color = titleColor(self.line)
  derived iconTint: Color = self.line.kind == LineKind::InProgress ? GREY : WHITE
  derived greyed: Boolean = self.line.kind == LineKind::InProgress
  derived entries: Array<MenuEntry> = [{ label: Locale::ALWAYS_PICK, on: self.marked }]
  state menuOpen = false

  line: Signal<Line>
  index: Signal<Integer>
  place: Signal<Integer>
  keysHere: Signal<Boolean>
  hints: Signal<Boolean>
  marked: Signal<Boolean>
  constructor(
    line: Signal<Line>,
    index: Signal<Integer>,
    place: Signal<Integer>,
    keysHere: Signal<Boolean>,
    hints: Signal<Boolean>,
    marked: Signal<Boolean>
  ) {
    self.line = line
    self.index = index
    self.place = place
    self.keysHere = keysHere
    self.hints = hints
    self.marked = marked
  }

  onPick(mut self) { self.pick.emit(peek self.index) }

  // Only a plain option is marked: quests have their own settings.
  onRight(mut self) {
    if ((peek self.line).kind == LineKind::Option) { self.menuOpen = true }
  }

  onMenu(mut self, entry: Integer) {
    self.menuOpen = false
    self.mark.emit(peek self.index)
  }

  onMenuClose(mut self) { self.menuOpen = false }

  public render(self): Template {
    return $ltml {
      <box @pointerPress(.Right)={self.onRight}>
        <PickRow columns={COLUMNS} tabStop={false} @pick={self.onPick}>
          <Keycap $if={self.keyed} key={self.key} />
          <box $else />
          <box width={Style::ICON} height={Style::ICON} icon={self.line.icon} tint={self.iconTint} desaturate={self.greyed} />
          <text value={self.line.title} textColor={self.color} wrap={.None} />
          // A quest's level after its title, «(12)», in its difficulty's colour.
          <text $if={self.leveled} value={self.levelText} textColor={self.levelColor} textSize={SECONDARY_TEXT}
                textFont={.Numbers} wrap={.None} />
          <box $else />
          <text $if={self.marked} value={Locale::AUTO_MARK} textColor={Style::DIM} textSize={SECONDARY_TEXT} wrap={.None} />
          <box $else />
        </PickRow>
        <Menu $if={self.menuOpen} entries={self.entries} @pick={self.onMenu} @close={self.onMenuClose} />
      </box>
    }
  }
}
