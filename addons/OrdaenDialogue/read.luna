// What the client says of a talk, read into the dialogue's own data: the NPC's list (the gossip window's, or a quest
// giver's greeting), a quest's page (its texts, what it needs, its rewards) and a book's pages. Nothing here keeps
// anything: each is read as the game tells that it changed. The reputations a quest changes are Ordaen Quests'
// (QuestieDB's): the client says none; without Quests the band has none.
import Client from "$client"
import Game from "$game"
import { Art } from "$ltml"
import { Difficulty, Quality, difficultyOf } from "Ordaen"
import { Named, Reward, Standing, artOf, itemReward } from "OrdaenQuestPage"
import root Quests from "OrdaenQuests"
import Locale from "@/locales"

// Where the NPC's list came from: the gossip window (`GOSSIP_SHOW`), or a quest giver's greeting (`QUEST_GREETING`),
// whose quests are picked by their place.
public enum Source { Gossip, Greeting }

// What a line of the NPC's list is, in the game's order: quests to hand in, new quests, quests in progress, then
// the plain options.
public enum LineKind { TurnIn, RepeatTurnIn, New, Daily, Legendary, InProgress, Option }

// One line of the NPC's list.
public struct Line {
  const kind: LineKind
  const title: string
  // A quest's level; 0 for a plain option.
  const level: integer
  const difficulty: Difficulty
  const icon: Art
  // Which it is: a gossip option's ID (what its mark keeps; 0 for an option the client gives none, a vendor's), a
  // gossip quest's ID, or a greeting quest's place.
  const id: integer
  // An option's place, which picks it as the game's own window does (`SelectOptionByIndex`); 0 for a quest.
  const order: integer = 0
  // An option that leads somewhere (a vendor's goods, a trainer, a flight, the bank, an inn), not a line of talk:
  // what the one-option skip picks.
  const leads: boolean = false
  const source: Source
}

// The game's icon of a line of talk (`GossipGossipIcon`); a vendor's, a trainer's, a banker's, an inn's and the like
// are their own.
const TALK_ICON = 132053

// Whether an option leads somewhere: not the talk icon, and no quest's or film's flag (`flags` 1, 4) on it.
function leadsSomewhere(option: Client::GossipOptionUIInfo): boolean {
  return option.icon != TALK_ICON && option.flags == 0
}

// What a quest needs handed in: an item with how many the player has and how many it takes.
public struct Need {
  const name: string
  const icon: Art | nil
  const item: integer | nil
  const have: integer
  const need: integer
}

// What the client says of the quest a quest giver shows.
// The reward to pick for the player, by its place among the choices: the one worth most more than what is worn
// (`upgradeOf`, of those the player can use), else the one that sells for most; 0 where none sells either.
public function bestReward(choices: array<Reward>, upgradeOf: (link: string) => number | nil): integer {
  let best = 0
  let bestShare: number = 0
  for (reward of choices) {
    const link = reward.link
    const share = link != nil && !reward.unusable ? upgradeOf(link) ?? 0 : 0
    if (share > bestShare) {
      best = reward.index
      bestShare = share
    }
  }
  if (best > 0) { return best }
  let most = 0
  for (reward of choices) {
    if (reward.sell > most) {
      best = reward.index
      most = reward.sell
    }
  }
  return best
}

public struct Quest {
  const id: integer
  const title: string
  // The page's text: the description (details), what the NPC says of it (progress), the thanks (reward).
  const text: string
  const objectives: string
  const group: integer
  const choices: array<Reward>
  const also: array<Reward>
  const money: integer
  const xp: integer
  const standings: array<Standing>
  // The things its words name (QuestieDB's, while Quests is on), marked on the parchment.
  const names: array<Named>
  const needs: array<Need>
  const moneyNeeded: integer
  const completable: boolean
  // Accepting it flags the player for PvP: asked first, as the game's own window asks.
  const pvp: boolean
  // The game accepts it itself (`QuestGetAutoAccept`): there is nothing to decline, its accept acknowledges.
  const autoAccepted: boolean
}

// The game's quest icons.
const TURN_IN: Art = "QuestTurnin"
const REPEAT_TURN_IN: Art = "QuestRepeatableTurnin"
const NEW: Art = "QuestNormal"
const DAILY: Art = "QuestDaily"
const LEGENDARY: Art = "QuestLegendary"
const UNKNOWN: Asset = "Interface/Icons/INV_Misc_QuestionMark"

function questIcon(kind: LineKind): Art {
  return match (kind) {
    .TurnIn => TURN_IN
    .InProgress => TURN_IN
    .RepeatTurnIn => REPEAT_TURN_IN
    .Daily => DAILY
    .Legendary => LEGENDARY
    else => NEW
  }
}

function questLine(kind: LineKind, title: string, level: integer, trivial: boolean, id: integer, source: Source): Line {
  return {
    // The client's own word that it is trivial stands; else the quest log's reckoning.
    kind: kind, title: title, level: level,
    difficulty: trivial ? Difficulty::Trivial : difficultyOf(level, peek Game::player.level),
    icon: questIcon(kind), id: id, source: source
  }
}

// A new quest's kind by how often it may be done.
function offerKind(frequency: number | nil, legendary: boolean): LineKind {
  if (legendary) { return .Legendary }
  if (frequency != nil && frequency > 0) { return .Daily }
  return .New
}

// A quest in the player's log: to hand in, blue where it may be done again, or in progress.
function activeKind(complete: boolean, repeatable: boolean): LineKind {
  if (!complete) { return .InProgress }
  return repeatable ? .RepeatTurnIn : .TurnIn
}

// The order the list shows its kinds in.
function rank(kind: LineKind): integer {
  return match (kind) {
    .TurnIn, .RepeatTurnIn => 1
    .New, .Daily, .Legendary => 2
    .InProgress => 3
    .Option => 4
  }
}

function inOrder(lines: mut array<Line>): array<Line> {
  let ordered: array<Line> = mut []
  for (step of 1..4) {
    for (line of lines) {
      if (rank(line.kind) == step) { ordered.push(line) }
    }
  }
  return ordered
}

// The gossip window's list: its quests, then its options in the game's order.
public function gossipLines(): array<Line> {
  let lines: array<Line> = mut []
  for (quest of Client::C_GossipInfo::GetActiveQuests()) {
    const kind = activeKind(quest.isComplete == true, quest.repeatable == true || (quest.frequency ?? 0) > 0)
    lines.push(questLine(kind, quest.title, quest.questLevel.floor(), quest.isTrivial, quest.questID.floor(), .Gossip))
  }
  for (quest of Client::C_GossipInfo::GetAvailableQuests()) {
    const kind = quest.repeatable == true ? LineKind::Daily : offerKind(quest.frequency, quest.isLegendary)
    lines.push(questLine(kind, quest.title, quest.questLevel.floor(), quest.isTrivial, quest.questID.floor(), .Gossip))
  }
  let options: array<Client::GossipOptionUIInfo> = mut []
  for (given of Client::C_GossipInfo::GetOptions()) { options.push(given) }
  options.sort((a, b) => a.orderIndex < b.orderIndex)
  for (option of options) {
    lines.push({
      kind: .Option, title: option.name, level: 0, difficulty: .Even, icon: option.overrideIconID ?? option.icon,
      id: (option.gossipOptionID ?? 0).floor(), order: option.orderIndex.floor(), leads: leadsSomewhere(option),
      source: .Gossip
    })
  }
  return inOrder(lines)
}

// A quest giver's greeting: its quests in progress and to hand in, then the new ones, each by its place.
public function greetingLines(): array<Line> {
  let lines: array<Line> = mut []
  for (index of 1..Client::GetNumActiveQuests().floor()) {
    const (title, complete) = Client::GetActiveTitle(index)
    const kind = activeKind(complete, false)
    const level = Client::GetActiveLevel(index).floor()
    lines.push(questLine(kind, title ?? "", level, Client::IsActiveQuestTrivial(index), index, .Greeting))
  }
  for (index of 1..Client::GetNumAvailableQuests().floor()) {
    const (title, _) = Client::GetAvailableTitle(index)
    const (trivial, frequency, repeatable, legendary, _, _, _, _) = Client::GetAvailableQuestInfo(index)
    const kind = repeatable ? LineKind::Daily : offerKind(frequency, legendary)
    lines.push(questLine(kind, title ?? "", Client::GetAvailableLevel(index).floor(), trivial, index, .Greeting))
  }
  return inOrder(lines)
}

// A quest's item of a kind (`choice`, `reward`) at its place.
function questItem(kind: string, index: integer): Reward {
  const (name, texture, count, _, usable, itemID) = Client::GetQuestItemInfo(kind, index)
  const item = itemID != nil ? itemID.floor() : nil
  return itemReward(item, count.floor(), name ?? "", artOf(texture), usable, Client::GetQuestItemLink(kind, index),
    kind == "choice" ? index : 0)
}

// A currency the quest gives, to choose (its place among the choices) or anyway (0).
function currencyReward(info: Client::QuestRewardCurrencyInfo, index: integer): Reward {
  return {
    kind: .Currency, name: info.name, icon: artOf(info.texture), count: info.totalRewardAmount.floor(),
    quality: QUALITIES[info.quality.floor() + 1] ?? .Common, item: nil, link: Client::C_CurrencyInfo::GetCurrencyLink(info.currencyID, nil),
    detail: "", unusable: false, sell: 0, index: index, currency: info.currencyID.floor()
  }
}

// A choice at its place: an item, or a currency where the client says the place holds one.
function choiceReward(index: integer): Reward {
  if (Client::GetQuestItemInfoLootType("choice", index) == CURRENCY_LOOT) {
    const info = Client::C_QuestOffer::GetQuestRewardCurrencyInfo("choice", index)
    if (info != nil) { return currencyReward(info, index) }
  }
  return questItem("choice", index)
}

// A currency's quality as the client numbers it (`Enum.ItemQuality`, from 0), in the order of its numbers.
const QUALITIES: array<Quality> = [.Poor, .Common, .Uncommon, .Rare, .Epic, .Legendary, .Artifact, .Heirloom]

// `GetQuestItemInfoLootType` of a currency (0 is an item).
const CURRENCY_LOOT = 1

// What a quest gives besides its items to choose: its items and currencies, spells learned, a title, a skill's points.
function givenRewards(questID: integer): array<Reward> {
  let given: array<Reward> = mut []
  for (index of 1..Client::GetNumQuestRewards()) { given.push(questItem("reward", index)) }
  for (info of Client::C_QuestInfoSystem::GetQuestRewardCurrencies(questID) ?? []) { given.push(currencyReward(info, 0)) }
  for (spell of Client::C_QuestInfoSystem::GetQuestRewardSpells(questID) ?? []) {
    const info = Client::C_QuestInfoSystem::GetQuestRewardSpellInfo(questID, spell)
    if (info != nil && !info.isSpellLearned) {
      given.push({
        kind: .Spell, name: info.name, icon: info.texture, count: 1, quality: .Common, item: nil, link: nil,
        detail: Locale::SPELL_LEARN, unusable: false, sell: 0, index: 0
      })
    }
  }
  const title = Client::GetRewardTitle()
  if (title != nil && title != "") {
    given.push({
      kind: .Title, name: title, icon: UNKNOWN, count: 1, quality: .Common, item: nil, link: nil,
      detail: Locale::TITLE_REWARD, unusable: false, sell: 0, index: 0
    })
  }
  const (skill, skillIcon, points) = Client::GetRewardSkillPoints()
  if (skill != nil && points != nil && points > 0) {
    given.push({
      kind: .Skill, name: Locale::SKILL_POINTS.format(points.floor(), skill), icon: skillIcon ?? UNKNOWN, count: 1,
      quality: .Common, item: nil, link: nil, detail: "", unusable: false, sell: 0, index: 0
    })
  }
  return given
}

// What a quest needs handed in, with how many of each the player has: its items (none where the quest hides them, nor
// one it hides) and its currencies.
function needsOf(): array<Need> {
  let needs: array<Need> = mut []
  if (!Client::C_QuestOffer::GetHideRequiredItems()) {
    for (index of 1..Client::GetNumQuestItems()) {
      if (!Client::IsQuestItemHidden(index)) {
        const (name, texture, count, _, _, itemID) = Client::GetQuestItemInfo("required", index)
        const item = itemID != nil ? itemID.floor() : nil
        const have = item != nil ? Client::C_Item::GetItemCount(item, nil, nil, nil, nil).floor() : 0
        needs.push({ name: name ?? "", icon: artOf(texture), item: item, have: have, need: count.floor() })
      }
    }
  }
  for (index of 1..Client::GetNumQuestCurrencies().floor()) {
    const info = Client::C_QuestOffer::GetQuestRequiredCurrencyInfo(index)
    if (info != nil) {
      const held = Client::C_CurrencyInfo::GetCurrencyInfo(info.currencyID)?.quantity ?? 0
      needs.push({ name: info.name, icon: artOf(info.texture), item: nil, have: held.floor(), need: info.requiredAmount.floor() })
    }
  }
  return needs
}

// The page a quest giver shows, with its text: the details' description, the progress' words or the reward's thanks.
public function questOf(text: string): Quest {
  const id = Client::GetQuestID().floor()
  let choices: array<Reward> = mut []
  for (index of 1..Client::GetNumQuestChoices()) { choices.push(choiceReward(index)) }
  return {
    id: id, title: Client::GetTitleText(), text: text, objectives: Client::GetObjectiveText(),
    group: Client::GetSuggestedGroupSize().floor(), choices: choices, also: givenRewards(id),
    money: Client::GetRewardMoney().floor(), xp: Client::GetRewardXP().floor(), standings: Quests?.reputationOf(id) ?? [], names: Quests?.questNames(id) ?? [], needs: needsOf(),
    moneyNeeded: Client::GetQuestMoneyToGet().floor(), completable: Client::IsQuestCompletable(),
    pvp: Client::QuestFlagsPVP(), autoAccepted: Client::QuestGetAutoAccept()
  }
}

// A book's pages, every one read: the client turns to the next while it has one, each turn another `ITEM_TEXT_READY`.
public function bookPage(): string { return Client::ItemTextGetText() }
