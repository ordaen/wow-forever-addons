// Ordaen Dialogue: talking to NPCs and quest givers in one window. Blizzard's `GossipFrame`, `QuestFrame` and
// `ItemTextFrame` stay the owners and keep running (other addons hook them); while ours shows they stand away, unseen
// and taking no mouse. Ours shows on the game's word (`GOSSIP_SHOW`, `QUEST_GREETING`, `QUEST_DETAIL`,
// `QUEST_PROGRESS`, `QUEST_COMPLETE`, `ITEM_TEXT_READY`) and goes on its word (`GOSSIP_CLOSED`, `QUEST_FINISHED`,
// `ITEM_TEXT_CLOSED`: walking away too). Every action is the game's own call, in the player's click or key. What is
// done on its own (the one-option skip, the options marked, quests accepted and handed in) happens as the talk starts,
// never with Shift held, and prints nothing.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Align, Bounds, Edges, Event, Overflow, Position, Track } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { ButtonKey, ButtonPlate, KeptWindow, Module, Money, PushButton, SECONDARY_TEXT, Settings, SettingsPage, TipText, Window, WindowTabSpec, WindowsPage, windowsTitle } from "Ordaen"
import { Reward, RewardView, Rewards, SCROLL_WIDTH, Scroll, WIDE_SCROLL, choiceViews, scrollOverflows } from "OrdaenQuestPage"
import { AutoEquip } from "@/autoEquip"
import { AnswerRow, LINE_KEYS, LineKey, OptionColumn, Placed, columnsOf, placeOf } from "@/list"
import Locale from "@/locales"
import { Needs, Said } from "@/pages"
import { Line, LineKind, Quest, Source, bestReward, bookPage, gossipLines, greetingLines, questOf } from "@/read"
import { Auto, Choices, ConveniencePage, DEFAULTS, GeneralPage } from "@/settings"
import Style from "@/style"
import { MARKS_KEPT, Marked, Page, Prompt, Speaker, bookSpeaker, itemSpeaker, npcOf, speakerOf } from "@/talk"

// The game's sounds of its own windows (`SOUNDKIT`).
const SOUND_OPEN = 875
const SOUND_CLOSE = 876
const SOUND_SELECT = 877
const SOUND_CANCEL = 879
const MARKS_KEY = "alwaysPick"

function isQuest(line: Line): boolean { return line.kind != LineKind::Option }
function isTurnIn(line: Line): boolean { return line.kind == LineKind::TurnIn || line.kind == LineKind::RepeatTurnIn }
function isOffer(line: Line): boolean {
  return line.kind == LineKind::New || line.kind == LineKind::Daily || line.kind == LineKind::Legendary
}

function sound(kit: integer) { _ = Client::C_Sound::PlaySound(kit, nil) }

// An option picked by its place, as the game's own window picks it: a vendor's or a trainer's has no option ID.
function pickOption(line: Line) { Client::C_GossipInfo::SelectOptionByIndex(line.order, nil, nil) }

function isQuestPage(page: Page): boolean { return page == Page::Detail || page == Page::Progress || page == Page::Reward }

// The game's option that shows a quest's text at once ("1"), or lets it fade in ("0").
const INSTANT_TEXT = "instantQuestText"
// The game's pace: 70 letters a second (`QUEST_DESCRIPTION_GRADIENT_CPS`), let in a tenth of a second at a time.
const FADE_STEP = 0.1
const FADE_LETTERS = 7
// The scroll's height on every page, 5:3 at its width: a short greeting and a long quest alike (a long one scrolls).
const SCROLL_HEIGHT: number<Length> = 281.25dp
// What the window holds besides the scroll over the well, at most: its title, the needs and rewards, the buttons.
const UNDER_SCROLL_ROOM: number<Length> = 421.875dp
const FILL: array<Track> = [{ fr: 1 }]
// The share of the screen's height a window stands higher than to stand a long quest's scroll beside the well.
const TALL = 0.6
// The well under the scroll, off it; beside it, off it by a gap and never narrower than the window's own width.
const UNDER_SCROLL: Edges = { top: 2sp, right: 0sp, bottom: 0sp, left: 0sp }
const WIDE_WELL: Edges = { top: 0sp, right: 0sp, bottom: 0sp, left: 4sp }
const WELL_LEAST: Bounds = { min: 375dp, max: nil }
// The NPC's words and a question on the window: in from its sides as the list's lines are.
const SPOKEN_PAD: Edges = { top: 2sp, right: 2sp, bottom: 2sp, left: 2sp }
// A question's answers, by their place in the list and their key.
const YES = 1
const NO = 2

// The end of the word at `at` or after it (a byte before a space, or the text's end): a text cut there wraps as the
// whole does, and never inside a letter.
function wordEnd(text: string, at: integer): integer {
  for (stop of at..text.length) {
    if (text.sub(stop + 1, stop + 1) == " ") { return stop }
  }
  return text.length
}

public class Dialogue implements Module, App {
  public const title: string = "Ordaen Dialogue"
  public window: mut KeptWindow = new KeptWindow("main", self.title, { x: -560ui, y: -40ui, width: Style::WIDTH, height: Style::HEIGHT })
  public const windows: mut array<mut KeptWindow> = [self.window]
  public const pages: array<SettingsPage> = [
    { title: Locale::TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
    { title: Locale::TAB_CONVENIENCE, content: $ltml { <ConveniencePage settings={mut self.settings} /> } },
    { title: windowsTitle(), content: $ltml { <WindowsPage windows={mut self.windows} /> } }
  ]
  public settings: mut Settings<Choices> = new Settings<Choices>(DEFAULTS)
  // The reward taken, put on as it comes where it is worth enough more.
  const equipper: mut AutoEquip = new AutoEquip()

  public state page: Page = .Closed
  public state source: Source = .Gossip
  public state lines: array<Line> = []
  public state said = ""
  public state quest: Quest | nil = nil
  public state book = ""
  // The reward picked, by its place among the choices; 0: none yet. Picked for the player (`bestReward`) until the
  // player picks one.
  public state choice = 0
  choiceByPlayer = false
  public state speaker: Speaker = { name: "" }
  public state prompt: Prompt | nil = nil
  // The marked options, kept for the account.
  public state marks: array<Marked> = []
  // The NPC talked to, for its marks.
  state npc = 0
  // The quest page came from the NPC's list: back and Esc go there.
  state fromList = false
  // A quest with no NPC (an item's, an object's): declining closes the window.
  state alone = false
  // What the next quest page is answered with on its own: accepted, or handed in.
  state acceptNext = false
  state completeNext = false
  // Walking the NPC's quests one at a time as the talk starts («All»): the list's return goes on with the next.
  state walking = false
  // The quests tried on their own this talk: never tried twice.
  tried: mut array<integer> = []
  // Shift was held as the talk started: nothing is done on its own.
  state held = false
  // How much better each reward is than what is worn, by Ordaen's worth: a test's answer stands in its place.
  upgradeOf: (link: string) => number | nil = (link: string): number | nil => Ordaen.worth.upgradeOf(link)
  // The upgrade column, while the player's spec weighs items.
  public derived upgradesShown: boolean = Ordaen.worth.weights != nil
  // How much of the quest's text shows as it fades in, as the game's own window lets it in (`instantQuestText` "0"):
  // bytes to a word's end, -1 for all of it. Its steps run only while it fades in.
  public state revealed = -1
  fading: Task<nil> | nil = nil

  // Something was done on its own (the one-option skip, a marked option, a quest walked): the game answers with its next
  // window (a trainer, a vendor, the next page), and until it does the talk is ours and nothing of it shows.
  state acting = false
  // A question asked is the window's page, its answers the list.
  derived prompted: boolean = self.prompt != nil
  derived shown: boolean = self.page != Page::Closed || self.prompted
  derived listShown: boolean = self.page == Page::List
  // A quest's page as it opens, its parchment folded to its title where the settings say so; a click unfolds it.
  state scrollFolded = false
  derived onQuest: boolean = isQuestPage(self.page) && !self.prompted
  // The parchment holds the lore alone: a quest's pages and what is read (a book, a letter, a plaque). The NPC's
  // words and a question stand on the window itself.
  derived onParchment: boolean = self.onQuest || (self.page == Page::Book && !self.prompted)
  derived spoken: string = self.prompted ? self.promptText : self.said
  derived questPageShown: string = self.onQuest ? `${self.page}:${self.quest?.id ?? 0}` : ""
  derived scrollTitle: string = self.onQuest ? self.quest?.title ?? "" : ""
  // Under a question its answers, with their keys; the buttons say them too.
  derived listed: boolean = self.listShown && !self.prompted
  derived tabs: array<WindowTabSpec> = [
    { title: self.speaker.name, desc: self.speaker.subtitle, icon: self.speaker.icon, portrait: self.speaker.portrait }
  ]

  constructor() {
    Ordaen.modules.add(self)
    self.marks = decode<array<Marked>>(Game::saved.stored(.Own, MARKS_KEY), [])
    watch (lines of self.lines) { self.column = 1 }
    watch (shown of self.questPageShown) { self.scrollFolded = shown != "" && peek self.settings.values.foldedScroll }
    Events::GOSSIP_SHOW.listen(self.onGossip)
    Events::GOSSIP_CLOSED.listen(self.onGossipClosed)
    Events::GOSSIP_CONFIRM.listen(self.onConfirm)
    Events::GOSSIP_CONFIRM_CANCEL.listen(self.onConfirmCancel)
    Events::QUEST_GREETING.listen(self.onGreeting)
    Events::QUEST_DETAIL.listen(self.onDetail)
    Events::QUEST_PROGRESS.listen(self.onProgress)
    Events::QUEST_COMPLETE.listen(self.onComplete)
    Events::QUEST_FINISHED.listen(self.onQuestFinished)
    Events::QUEST_ACCEPT_CONFIRM.listen(self.onEscort)
    Events::CONFIRM_BINDER.listen(self.onBinder)
    Events::ITEM_TEXT_BEGIN.listen(self.onBookBegin)
    Events::ITEM_TEXT_READY.listen(self.onBookPage)
    Events::ITEM_TEXT_CLOSED.listen(self.onBookClosed)
    // A reward's sell price may come after the page: the page is read again.
    watch (on of self.shown) {
      if (on) { Events::GET_ITEM_INFO_RECEIVED.listen(self.onItemInfo) }
    }
  }

  // ——— The talk starting: the NPC's list, or what is done on its own first.

  mut onGossip(kit: string | nil) { self.startList(.Gossip) }
  mut onGreeting() { self.startList(.Greeting) }

  mut startList(source: Source) {
    const fresh = !(peek self.walking) && !(peek self.shown)
    if (fresh) {
      self.held = Game::input.shiftDown()
      self.tried.clear()
      self.npc = npcOf(Client::UnitGUID("npc"))
      self.speaker = speakerOf()
    }
    self.source = source
    self.said = source == Source::Gossip ? Client::C_GossipInfo::GetText() : Client::GetGreetingText()
    const lines = source == Source::Gossip ? gossipLines() : greetingLines()
    self.lines = lines
    self.alone = false
    if (!(peek self.held) && self.actAlone(lines, fresh)) {
      self.acting = true
      return
    }
    self.walking = false
    self.show(.List)
  }

  // What is done on its own as the talk starts, and as the list comes back while the NPC's quests are walked; true
  // where something was picked (the game answers with its next page).
  mut actAlone(lines: array<Line>, fresh: boolean): boolean {
    const choices = peek self.settings.values
    if (choices.autoComplete == Auto::All) {
      const turnIn = lines.find(line => isTurnIn(line) && !self.tried.any(id => id == line.id))
      if (turnIn != nil) { return self.walk(turnIn, false) }
    }
    if (choices.autoAccept == Auto::All && !self.logFull()) {
      const offer = lines.find(line => isOffer(line) && !self.tried.any(id => id == line.id))
      if (offer != nil) { return self.walk(offer, true) }
    }
    if (!fresh) { return false }
    if (choices.alwaysPick && (peek self.source) == Source::Gossip) {
      const marked = lines.find(line => line.kind == LineKind::Option && self.isMarked(line.id))
      if (marked != nil) {
        pickOption(marked)
        return true
      }
    }
    if (choices.skipSingle && self.onlyOption(lines)) {
      const only = lines[1] ?? panic("one line")
      pickOption(only)
      return true
    }
    return false
  }

  // The one-option skip: one option that leads somewhere (a vendor's goods, a trainer, a flight), no quests; a line
  // of talk always shows. `C_GossipInfo.ForceGossip()` isn't asked: Forever's client gives true for an ordinary
  // vendor, whose menu the skip is for.
  onlyOption(lines: array<Line>): boolean {
    return (peek self.source) == Source::Gossip && lines.length == 1 && lines.all(line => line.leads)
  }

  // The game says how many quests the log holds and how many it takes.
  logFull(): boolean {
    const (_, quests) = Client::C_QuestLog::GetNumQuestLogEntries()
    return quests >= Client::C_QuestLog::GetMaxNumQuestsCanAccept()
  }

  // One quest of the walk: picked, and its pages answered on their own.
  mut walk(line: Line, accepting: boolean): boolean {
    self.tried.push(line.id)
    self.walking = true
    if (accepting) { self.acceptNext = true } else { self.completeNext = true }
    self.select(line)
    return true
  }

  // ——— The game's pages.

  mut onDetail(startItem: number | nil) {
    if (peek self.acceptNext) {
      self.acceptNext = false
      const quest = questOf(Client::GetQuestText())
      // A quest the game asks about (PvP) isn't accepted on its own: its page shows.
      if (!quest.pvp) {
        self.acting = true
        if (quest.autoAccepted) { Client::AcknowledgeAutoAcceptQuest() } else { Client::AcceptQuest() }
        return
      }
    }
    const item = startItem != nil && startItem > 0 ? startItem.floor() : nil
    if (!(peek self.shown)) {
      self.fromList = false
      self.alone = item != nil || !Client::UnitExists("npc")
      if (item != nil) {
        const name = Client::C_Item::GetItemNameByID(item)
        self.speaker = itemSpeaker(name ?? "", Game::items.icon(item))
      } else {
        self.speaker = speakerOf()
      }
    }
    self.quest = questOf(Client::GetQuestText())
    self.show(.Detail)
  }

  mut onProgress() {
    if (peek self.completeNext) {
      if (Client::IsQuestCompletable()) {
        self.acting = true
        Client::CompleteQuest()
        return
      }
      self.completeNext = false
      self.walking = false
    }
    self.quest = questOf(Client::GetProgressText())
    self.show(.Progress)
  }

  mut onComplete() {
    self.choice = 0
    const choices = Client::GetNumQuestChoices()
    if (peek self.completeNext) {
      self.completeNext = false
      // A reward to choose is the player's: its page shows, and the walk stops.
      if (choices <= 1) {
        self.acting = true
        self.takeReward(choices)
        return
      }
      self.walking = false
    }
    self.choiceByPlayer = false
    self.quest = questOf(Client::GetRewardText())
    self.preselect()
    self.show(.Reward)
  }

  mut onItemInfo(item: number, fine: boolean) {
    const page = peek self.page
    if (page == Page::Detail || page == Page::Reward) { self.quest = questOf((peek self.quest)?.text ?? "") }
    if (page == Page::Reward) { self.preselect() }
  }

  // ——— Books: every page read as it opens, then shown as one.

  mut onBookBegin() { self.book = "" }

  mut onBookPage() {
    const page = bookPage()
    const before = peek self.book
    self.book = before == "" ? page : `${before}\n\n${page}`
    if (Client::ItemTextHasNextPage()) {
      Client::ItemTextNextPage()
      return
    }
    self.speaker = bookSpeaker()
    self.show(.Book)
  }

  mut onBookClosed() {
    if (peek self.page == Page::Book) { self.hide() }
  }

  // ——— The game closing its windows.

  mut onGossipClosed(continuing: boolean) {
    if (continuing) { return }
    self.walking = false
    self.acting = false
    if (peek self.page == Page::List) { self.hide() }
  }

  mut onQuestFinished() {
    // While the NPC's quests are walked the list comes back after each.
    if (peek self.walking) { return }
    self.acting = false
    const page = peek self.page
    if (page != Page::List && page != Page::Book) { self.hide() }
  }

  // ——— What is asked first.

  mut onConfirm(option: number, text: string, cost: number) {
    Client::StaticPopup_Hide("GOSSIP_CONFIRM")
    // An option that asks is never picked on its own again.
    self.unmark(option.floor())
    self.prompt = .Paid { option: option.floor(), text: text, cost: cost.floor() }
  }

  mut onConfirmCancel() { self.prompt = nil }

  // The innkeeper asks whether the inn is to be home: the game's own question stands away, the window asks it.
  mut onBinder(place: string) {
    Client::StaticPopup_Hide("CONFIRM_BINDER")
    if (!(peek self.shown)) { sound(SOUND_OPEN) }
    self.prompt = .Binder { place: place }
  }

  mut onEscort(who: string, quest: string, from: number) {
    Client::StaticPopup_Hide("QUEST_ACCEPT")
    self.prompt = .Escort { text: Locale::ESCORT.format(who, quest) }
  }

  public mut confirmPrompt() {
    const prompt = peek self.prompt
    self.prompt = nil
    if (prompt == nil) { return }
    match (prompt) {
      .Binder => {
        Client::C_PlayerInteractionManager::ConfirmationInteraction(Client::PlayerInteractionType::Binder)
        Client::C_PlayerInteractionManager::ClearInteraction(Client::PlayerInteractionType::Binder)
      }
      .Paid => Client::C_GossipInfo::SelectOption(prompt.option, "", true)
      .Escort => Client::ConfirmAcceptQuest()
      .Pvp => self.acceptQuest()
      .Expensive => self.takeReward(peek self.choice)
    }
  }

  // No: the question goes, and the game is told where it waits for an answer (the inn's, as its own window's Cancel).
  public mut cancelPrompt() {
    const prompt = peek self.prompt
    self.prompt = nil
    if (prompt is Prompt::Binder) { Client::C_PlayerInteractionManager::ClearInteraction(Client::PlayerInteractionType::Binder) }
  }

  // ——— The player's actions.

  // A line of the NPC's list, by its place.
  public mut pickLine(index: integer) {
    const line = (peek self.lines)[index]
    if (line == nil) { return }
    const shift = Game::input.shiftDown()
    const choices = peek self.settings.values
    if (isOffer(line) && choices.autoAccept != Auto::Off && !shift) { self.acceptNext = true }
    if (isTurnIn(line) && choices.autoComplete != Auto::Off && !shift) { self.completeNext = true }
    self.fromList = isQuest(line)
    self.select(line)
  }

  mut select(line: Line) {
    if (line.kind == LineKind::Option) {
      pickOption(line)
      return
    }
    sound(SOUND_SELECT)
    const active = !isOffer(line)
    if (line.source == Source::Gossip) {
      if (active) { Client::C_GossipInfo::SelectActiveQuest(line.id) } else { Client::C_GossipInfo::SelectAvailableQuest(line.id) }
    } else if (active) {
      Client::SelectActiveQuest(line.id)
    } else {
      Client::SelectAvailableQuest(line.id)
    }
  }

  // The page's main action (Space, the accent button): on the list its first line.
  public mut main() {
    if (peek self.prompted) {
      self.confirmPrompt()
      return
    }
    match (peek self.page) {
      .List => self.pickLine(1)
      .Detail => self.accept()
      .Progress => self.proceed()
      .Reward => self.finish()
      else => {}
    }
  }

  // Back (Esc, the left button): from a quest picked in the list, the list; else the page is declined or closed.
  public mut back() {
    if (peek self.prompted) {
      sound(SOUND_CANCEL)
      self.cancelPrompt()
      return
    }
    const page = peek self.page
    if (page == Page::List || page == Page::Book) {
      self.close()
      return
    }
    if (peek self.fromList) {
      sound(SOUND_CANCEL)
      self.page = .List
      return
    }
    if (page == Page::Detail) { Client::DeclineQuest() }
    self.close()
  }

  public mut accept() {
    const quest = peek self.quest
    if (quest == nil) { return }
    if (quest.pvp) {
      self.prompt = .Pvp
      return
    }
    self.acceptQuest()
  }

  mut acceptQuest() {
    const quest = peek self.quest
    if (quest != nil && quest.autoAccepted) { Client::AcknowledgeAutoAcceptQuest() } else { Client::AcceptQuest() }
  }

  public mut proceed() {
    if (!Client::IsQuestCompletable()) { return }
    Client::CompleteQuest()
    sound(SOUND_OPEN)
  }

  public mut finish() {
    const quest = peek self.quest
    if (quest == nil) { return }
    const choice = peek self.choice
    if (quest.choices.length > 1 && choice == 0) {
      Client::QuestChooseRewardError()
      return
    }
    const picked = quest.choices.length == 1 ? 1 : choice
    self.choice = picked
    if (quest.moneyNeeded > 0) {
      self.prompt = .Expensive { cost: quest.moneyNeeded }
      return
    }
    self.takeReward(picked)
  }

  // A reward to choose, by its place; on the reward page alone.
  public mut choose(index: integer) {
    const quest = peek self.quest
    if (peek self.page != Page::Reward || quest == nil || index > quest.choices.length) { return }
    self.choiceByPlayer = true
    self.choice = index
  }

  // A key of 1–9: a line of the list's column the keys are on, an answer, or a reward to choose.
  public mut pickNumber(number: integer) {
    if (peek self.prompted) {
      self.answer(number)
    } else if (peek self.page == Page::List) {
      const column = (peek self.optionColumns)[peek self.column] ?? []
      const placed = column[number]
      if (placed != nil) { self.pickLine(placed.index) }
    } else {
      self.choose(number)
    }
  }

  // An answer to the question by its place: 1 is Yes, 2 No; another place is none.
  public mut answer(place: integer) {
    if (place == YES) { self.main() }
    if (place == NO) { self.back() }
  }

  // The window closed (its ✕, Escape on the list or a book): the game's window is told, as its own close does.
  public mut close() {
    const page = peek self.page
    self.hide()
    sound(SOUND_CLOSE)
    if (page == Page::Book) {
      Client::CloseItemText()
    } else if (page == Page::List && (peek self.source) == Source::Gossip) {
      Client::C_GossipInfo::CloseGossip()
    } else {
      Client::CloseQuest()
    }
  }

  mut show(page: Page) {
    if (!(peek self.shown)) {
      sound(SOUND_OPEN)
    }
    self.page = page
    self.acting = false
    // A new talk drops a question left unanswered (the inn's, which outlives its talk).
    self.prompt = nil
    self.fadeIn(page)
  }

  // A quest's page lets its text in at the game's pace, unless the game's option shows it at once.
  mut fadeIn(page: Page) {
    self.stopFading()
    const text = (peek self.quest)?.text ?? ""
    if (!isQuestPage(page) || text == "" || Client::C_CVar::GetCVar(INSTANT_TEXT) != "0") { return }
    self.revealed = 0
    self.fading = self.fade(text)
  }

  async mut fade(text: string) {
    let shown = 0
    // Each step lets in at least a letter: the text is in at most as many steps as it has.
    for (step of 1..text.length) {
      await Game::delay(FADE_STEP)
      shown = wordEnd(text, shown + FADE_LETTERS)
      if (shown >= text.length) { break }
      self.revealed = shown
    }
    self.revealed = -1
    self.fading = nil
  }

  mut stopFading() {
    if (self.fading != nil) {
      destroy self.fading
      self.fading = nil
    }
    self.revealed = -1
  }

  mut hide() {
    self.stopFading()
    self.page = .Closed
    self.acting = false
    // The inn's question outlives the talk, as the game's own does: it is answered or cancelled.
    if (!((peek self.prompt) is Prompt::Binder)) { self.prompt = nil }
    self.fromList = false
    self.acceptNext = false
    self.completeNext = false
  }

  // ——— The marks.

  public isMarked(option: integer): boolean {
    const npc = peek self.npc
    return (peek self.marks).any(mark => mark.npc == npc && mark.option == option)
  }

  // Right-click's «Always pick this option»: marked, or unmarked again.
  public mut toggleMark(index: integer) {
    const line = (peek self.lines)[index]
    // An option the client gives no ID can't be told again at the next talk: it is never marked.
    if (line == nil || line.kind != LineKind::Option || line.id == 0) { return }
    if (self.isMarked(line.id)) {
      self.unmark(line.id)
      return
    }
    let marks = (peek self.marks).clone()
    marks.push({ npc: peek self.npc, option: line.id })
    if (marks.length > MARKS_KEPT) { _ = marks.remove(1) }
    self.keepMarks(marks)
  }

  mut unmark(option: integer) {
    const npc = peek self.npc
    const marks = (peek self.marks).filter(mark => !(mark.npc == npc && mark.option == option))
    if (marks.length != (peek self.marks).length) { self.keepMarks(marks) }
  }

  mut keepMarks(marks: array<Marked>) {
    self.marks = marks
    Game::saved.store(.Own, MARKS_KEY, marks)
  }

  // ——— Rewards' worth.

  // The reward taken, by its place among the choices (0: what is given): noted to be put on where it is worth enough.
  mut takeReward(index: integer) {
    const choices = peek self.settings.values
    if (choices.autoEquip && index > 0) {
      const link = Client::GetQuestItemLink("choice", index)
      self.equipper.note(link, link == nil ? nil : self.upgradeOf(link), choices.equipFrom / 100)
    }
    Client::GetQuestReward(index)
  }

  // The reward picked for the player, while the player hasn't picked one: the only one, else `bestReward`.
  mut preselect() {
    const quest = peek self.quest
    if (self.choiceByPlayer || quest == nil) { return }
    self.choice = quest.choices.length == 1 ? 1 : bestReward(quest.choices, self.upgradeOf)
  }

  public upgrade(reward: Reward): number | nil {
    const link = reward.link
    if (!(peek self.upgradesShown) || link == nil) { return nil }
    return self.upgradeOf(link)
  }

  onSettings() { Ordaen.toggleSettings(Runtime::Addon::of(self)) }

  // ——— Keys: heard in the whole game while the window shows and the keyboard is on, out of a fight (the client's
  // bindings wait for its end); every other key stays the game's.

  mut onKey(stroke: Event::Keystroke) {
    const place = placeOf(stroke.key)
    if (place > 0) { self.pickNumber(place) }
  }

  mut onSpace() { self.main() }

  // Tab: the keys move to the list's next column, from the last back to the first.
  // A column took the keyboard's focus (Tab, Shift+Tab): the keys 1–9 are its lines'.
  mut onColumn(number: integer) { self.column = number }
  mut onEscape() { self.back() }

  // ——— What the window draws.

  derived keysOn: boolean = self.settings.values.keyboard && !Game::situation.combat
  derived hints: boolean = self.settings.values.keyboard && self.settings.values.keyHints
  derived combatNote: boolean = self.settings.values.keyboard && Game::situation.combat
  derived isBook: boolean = self.page == Page::Book
  // The list's options are as wide as they are, never wrapped: it takes the room they need, which widens the window
  // (a scrolled box would keep its width); a quest's rewards scroll.
  derived wellOverflow: Overflow = self.listShown ? Overflow::Visible : Overflow::Scroll
  // Under the scroll a quest's needs and rewards stand at the well's foot, right over the buttons that act on them;
  // beside it, at its top, the buttons at its foot.
  derived wellAlign: Align = self.listShown || self.wide ? Align::Start : Align::End
  // A quest whose words would overflow the scroll at its least height stands the scroll beside the well, the window's
  // whole height (OrdaenQuestPage's estimate, erring long), where the window stands higher than `TALL` of the screen:
  // a lower one keeps the scroll over the well, its words scrolled. A folded scroll, a book and a question stand as
  // they do.
  derived wide: boolean = self.onQuest && !self.scrollFolded &&
    self.window.placing.height > Client::UIParent.GetHeight() * 1ui * TALL &&
    scrollOverflows(self.scrollTitle, [self.quest?.text ?? "", self.page == Page::Detail ? self.quest?.objectives ?? "" : ""])
  // The scroll at its one size, what is under it the rest; wide, the scroll half again as wide and the well side by
  // side.
  derived scrollWidth: number<Length> = self.wide ? WIDE_SCROLL : SCROLL_WIDTH
  derived rows: array<Track> = self.wide ? FILL : ["max-content", { fr: 1 }]
  derived columns: array<Track> = self.wide ? [WIDE_SCROLL, { fr: 1 }] : FILL
  // Over the well the scroll is as high as its words, from its least height up to what leaves the well and the
  // window's room on the screen; past that its words scroll.
  derived scrollHeight: Bounds | nil = self.wide ? nil : { min: SCROLL_HEIGHT, max: (Client::UIParent.GetHeight() * 1ui - UNDER_SCROLL_ROOM).max(SCROLL_HEIGHT) }
  derived wellPad: Edges = self.wide ? WIDE_WELL : UNDER_SCROLL
  derived wellWidth: Bounds | nil = self.wide ? WELL_LEAST : nil
  // The list's lines in columns, as many as their count needs; the window widens for each.
  derived optionColumns: array<array<Placed>> = columnsOf(self.lines)
  derived listColumns: array<Track> = self.optionColumns.map((column): Track => "max-content")
  // The keys the window hears: 1–9, and on the list one for each line past them.
  derived lineKeys: array<LineKey> = self.keysOn ? LINE_KEYS : []
  // The column of the list the keys are on: the first as a list shows, the next on each Tab.
  state column = 1
  derived columned: boolean = self.listed && self.optionColumns.length > 1
  derived tabHint: boolean = self.keysOn && self.columned && self.hints
  // The NPC's options the player marked, by their IDs.
  derived markedOptions: array<integer> = self.marks.filter(mark => mark.npc == self.npc).map(mark => mark.option)
  derived pickable: boolean = self.page == Page::Reward
  derived rewardViews: array<RewardView> = choiceViews(self.quest?.choices ?? [], self.upgrades())
  derived backLabel: string = self.prompted ? Locale::CANCEL : self.pageBack
  derived pageBack: string = match (self.page) {
    .Detail => self.fromList ? Locale::BACK : Locale::DECLINE
    .Book => Locale::CLOSE
    else => Locale::BACK
  }
  derived mainLabel: string = self.prompted ? Locale::YES : self.pageMain
  derived pageMain: string = match (self.page) {
    .Detail => Locale::ACCEPT
    .Progress => Locale::CONTINUE
    else => Locale::COMPLETE
  }
  derived mainOff: boolean = self.mainOffNow()
  derived mainTip: TipText | nil = self.mainOff ? { title: self.mainLabel, text: self.page == Page::Progress ? Locale::NOT_READY : Locale::PICK_A_REWARD, rows: [] } : nil
  derived backKey: ButtonKey = self.hints ? ButtonKey::Named { name: Locale::KEY_ESC } : ButtonKey::None
  derived mainKey: ButtonKey = self.hints ? ButtonKey::Space : ButtonKey::None
  derived promptText: string = self.promptTextNow()
  derived promptCost: integer = self.promptCostNow()
  state tab = 1

  mainOffNow(): boolean {
    if (self.prompted) { return false }
    const quest = self.quest
    if (quest == nil) { return false }
    if (self.page == Page::Progress) { return !quest.completable }
    if (self.page == Page::Reward) { return quest.choices.length > 1 && self.choice == 0 }
    return false
  }

  promptTextNow(): string {
    const prompt = self.prompt
    if (prompt == nil) { return "" }
    return match (prompt) {
      .Binder => Locale::BINDER_CONFIRM.format(prompt.place)
      .Paid => prompt.text
      .Escort => prompt.text
      .Pvp => Locale::PVP_CONFIRM
      .Expensive => Locale::EXPENSIVE_CONFIRM.format(Game::money.format(prompt.cost))
    }
  }

  promptCostNow(): integer {
    const prompt = self.prompt
    if (prompt is Prompt::Paid) { return prompt.cost }
    if (prompt is Prompt::Expensive) { return prompt.cost }
    return 0
  }

  upgrades(): array<number> {
    const quest = self.quest
    if (quest == nil || !self.upgradesShown) { return [] }
    return quest.choices.map(reward => self.upgrade(reward) ?? 0)
  }

  public render(): Template {
    return $ltml {
      // Every talk of the game's three windows is ours while Dialogue runs: they stand away, unseen, from its load to
      // its end, so the game's window manager, which gives a window one of its three places as it shows, never gives
      // them one (shown in a talk, they would take a place, and a fourth window would close ours).
      <frame of={Game::frames.Gossip} opacity={0} away={true} />
      <frame of={Game::frames.Quest} opacity={0} away={true} />
      <frame of={Game::frames.ItemText} opacity={0} away={true} />
      <Window $if={self.shown} tabs={self.tabs} selected={mut self.tab} declared={mut self.window} withSettings={true}
              @close={self.close} @settings={self.onSettings}>
        <box columns={self.columns} rows={self.rows} gap={0sp}>
          <box $if={self.keysOn} position={Position::Absolute} left={0ui} top={0ui} width={0ui} height={0ui}
               @keyPress.globalScope(.Space)={self.onSpace} @keyPress.globalScope(.Escape)={self.onEscape} />
          <box $for={lineKey of self.lineKeys} position={Position::Absolute} left={0ui} top={0ui} width={0ui} height={0ui}
               @keyPress.globalScope(lineKey.key)={self.onKey} />
          <box $if={self.onParchment} xAlign={Align::Center} rows={FILL}>
            <box $if={self.scrollFolded} width={SCROLL_WIDTH} rows={FILL}>
              <Scroll title={self.scrollTitle} folded={mut self.scrollFolded} />
            </box>
            <box $else width={self.scrollWidth} height={self.scrollHeight} rows={FILL}>
              <Scroll title={self.scrollTitle} folded={mut self.scrollFolded} grows={!self.wide}>
                <Said page={self.page} quest={self.quest} said={self.said} book={self.book} revealed={self.revealed} />
              </Scroll>
            </box>
          </box>
          <box $else width={SCROLL_WIDTH} gap={1sp} padding={SPOKEN_PAD}>
            <text value={self.spoken} textColor={Style::TEXT} leading={.Row} />
            <Money $if={self.promptCost > 0} amount={self.promptCost} />
          </box>
          <box $if={!self.isBook || self.prompted} width={self.wellWidth} rows={[{ fr: 1 }, "max-content"]} gap={1.5sp}
               padding={self.wellPad}>
            <box overflow={self.wellOverflow} gap={0.5sp} yAlign={self.wellAlign}>
              <box $if={self.prompted} gap={0.5sp}>
                <AnswerRow label={Locale::YES} index={YES} hints={self.hints} @pick={self.answer} />
                <AnswerRow label={Locale::NO} index={NO} hints={self.hints} @pick={self.answer} />
              </box>
              <box $elseif={self.listShown} gap={1sp}>
                <box columns={self.listColumns} gap={2sp}>
                  <OptionColumn $for={number, column of self.optionColumns} lines={column} number={number}
                                keysHere={number == self.column} hints={self.hints} marked={self.markedOptions}
                                @pick={self.pickLine} @mark={self.toggleMark} @focus={self.onColumn} />
                </box>
                <text $if={self.tabHint} value={Locale::TAB_COLUMNS} textColor={Style::DIM} textSize={SECONDARY_TEXT} />
              </box>
              <Needs $elseif={self.page == Page::Progress} quest={self.quest} />
              <Rewards $else views={self.rewardViews} also={self.quest?.also ?? []} xp={self.quest?.xp ?? 0}
                       money={self.quest?.money ?? 0} standings={self.quest?.standings ?? []} pickable={self.pickable} choice={self.choice}
                       hints={self.hints} upgradeColumn={self.upgradesShown} @choose={self.choose} />
            </box>
            <text $if={self.combatNote} value={Locale::KEYS_IN_COMBAT} textColor={Style::DIM} textSize={SECONDARY_TEXT} />
            <box $if={!self.listed} columns={["max-content", { fr: 1 }, "max-content"]}>
              <PushButton label={self.backLabel} width={199.21875dp} key={self.backKey} @click={self.back} />
              <box />
              <PushButton label={self.mainLabel} width={199.21875dp} plate={ButtonPlate::Accent} disabled={self.mainOff}
                          tip={self.mainTip} key={self.mainKey} @click={self.main} />
            </box>
          </box>
          <box $else padding={{ top: 2sp }} xAlign={Align::End}>
            <PushButton label={Locale::CLOSE} width={199.21875dp} key={self.backKey} @click={self.close} />
          </box>
        </box>
      </Window>
    }
  }
}
