// The «Выгода» tab (`professions/worth`): what is worth making across the characters this one reaches, in four modes,
// read from the recipe book (`@/book`), Ordaen Alts' records (who is reached, what each holds, when a cooldown is
// ready) and Ordaen Auction's prices, never from the open profession. One run of every known recipe when the mode, the
// book, Alts' records or a price changes while the tab shows; nothing while another tab does.
import Client from "$client"
import Game from "$game"
import { Align, MouseButton, Track } from "$ltml"
import { Choice, Column, Component, Hour, ItemId, Money, PushButton, SECONDARY_TEXT, Segmented, Table, TableRow, space, tracksOf } from "Ordaen"
import root Alts from "OrdaenAlts"
import root Auction from "OrdaenAuction"
import type { PriceKey, PriceSource } from "OrdaenAuction"
import { Book, Entry, Reagent, yieldOfEntry } from "@/book"
import { unitOf } from "@/cost"
import Locale from "@/locales"
import Style from "@/style"

// What the tab asks: sold at the house, sold to a merchant, made from what is held, a cooldown ready now.
public enum Mode { Auction = "auction", Vendor = "vendor", Held = "held", Cooldowns = "cooldowns" }

const MODES: Array<Choice<Mode>> = [
  { value: Mode.Auction, label: Locale.WORTH_MODE_AUCTION },
  { value: Mode.Vendor, label: Locale.WORTH_MODE_VENDOR },
  { value: Mode.Held, label: Locale.WORTH_MODE_HELD },
  { value: Mode.Cooldowns, label: Locale.WORTH_MODE_COOLDOWNS }
]
const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_RECIPE, width: { fr: 1 }, sortable: true },
  { title: Locale.WORTH_WHO, width: 175.78125dp, sortable: true },
  { title: Locale.COLUMN_COST, width: 105.46875dp, align: Align.End, sortable: true },
  { title: Locale.WORTH_SALE, width: 105.46875dp, align: Align.End, sortable: true },
  { title: Locale.COLUMN_PROFIT, width: 105.46875dp, align: Align.End, sortable: true },
  { title: "%", width: 58.59375dp, align: Align.End, sortable: true },
  { title: Locale.WORTH_AGE, width: 70.3125dp, align: Align.End, sortable: true },
  { title: Locale.WORTH_CAN, width: 105.46875dp, align: Align.End, sortable: true }
]
const TRACKS: Array<Track> = tracksOf(COLUMNS)
const PAGE: Array<Track> = ["max-content", "max-content", { fr: 1 }, "max-content"]
const NONE = "—"
const DAY = 24

// A recipe a character knows, as the tab weighs it: its prices for one making, and how many the holdings make now.
public struct Worth {
  // The character's GUID and the recipe: one row of the table.
  key: String
  recipe: Integer
  name: String
  who: String
  profession: String
  cost: Integer | nil
  sale: Integer | nil
  profit: Integer | nil
  percent: Integer | nil
  // Hours the oldest house price it took is old; none where it took none.
  age: Integer | nil
  can: Integer
  // What one making lacks of what the reached characters hold.
  missing: Array<Reagent>
}

// A character the book has a page of, reached by the one being played.
struct Reached {
  guid: String
  name: String
  // The hour each recipe with a cooldown is ready again, as Ordaen Alts recorded it.
  ready: Map<Integer, Integer>
}

// The page's text for an age in hours.
function ageText(hours: Integer | nil): String {
  if (hours == nil) { return NONE }
  if (hours < 2 * DAY) { return Locale.WORTH_AGE_HOURS.format(hours) }
  return Locale.WORTH_AGE_DAYS.format((hours / DAY).floor())
}

// What a merchant gives for one of an item; none where the client says nothing.
function merchantPrice(item: Integer): Integer | nil {
  const _, _, _, _, _, _, _, _, _, _, price, _, _, _, _, _, _, _ = Client.C_Item.GetItemInfo(item)
  if (price == nil || price <= 0) { return nil }
  return price.floor()
}

// Whether the mode lists a recipe: one that makes an item to sell, any to make from what is held, one whose cooldown
// Ordaen Alts records ready by now.
function wanted(mode: Mode, entry: Entry, ready: Integer | nil, now: Integer): Boolean {
  return match (mode) {
    Mode.Auction, Mode.Vendor => entry.makes != nil
    Mode.Held => true
    Mode.Cooldowns => ready != nil && ready <= now
  }
}

// Whether `a` stands before `b` in the column's order; a cell of no value stands last either way.
function before(column: Integer, descending: Boolean, a: Worth, b: Worth): Boolean {
  if (column == 1 || column == 0) { return descending ? a.name > b.name : a.name < b.name }
  if (column == 2) { return descending ? a.who > b.who : a.who < b.who }
  const x = numberOf(column, a)
  const y = numberOf(column, b)
  if (x == nil) { return false }
  if (y == nil) { return true }
  return descending ? x > y : x < y
}

function numberOf(column: Integer, worth: Worth): Integer | nil {
  return match (column) {
    3 => worth.cost
    4 => worth.sale
    5 => worth.profit
    6 => worth.percent
    7 => worth.age
    else => worth.can
  }
}

// One row of the table.
public class WorthLine implements Component {
  public pick: Event<String> = new Event()

  derived picked: Boolean = self.chosen == self.worth.key
  derived hasCost: Boolean = self.worth.cost != nil
  derived cost: Integer = self.worth.cost ?? 0
  derived hasSale: Boolean = self.worth.sale != nil
  derived sale: Integer = self.worth.sale ?? 0
  derived hasProfit: Boolean = self.worth.profit != nil
  derived profit: Integer = self.worth.profit ?? 0
  derived profitColor: Color = self.profit < 0 ? Style.RED : Style.WHITE
  derived percent: String = self.worth.percent == nil ? NONE : String.of(self.worth.percent)
  derived age: String = ageText(self.worth.age)
  derived can: String = String.of(self.worth.can)
  derived who: String = `${self.worth.who}, ${self.worth.profession}`

  worth: Signal<Worth>
  chosen: Signal<String>
  constructor(worth: Signal<Worth>, chosen: Signal<String>) {
    self.worth = worth
    self.chosen = chosen
  }

  onPick(self, button: MouseButton) { self.pick.emit((peek self.worth).key) }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={TRACKS} selected={self.picked} @pick={self.onPick}>
        <text value={self.worth.name} textColor={Style.WHITE} wrap={false} />
        <text value={self.who} textColor={Style.DIM} wrap={false} />
        <box xAlign={Align.End}>
          <Money $if={self.hasCost} amount={self.cost} />
          <text $else value={NONE} textColor={Style.DIM} />
        </box>
        <box xAlign={Align.End}>
          <Money $if={self.hasSale} amount={self.sale} />
          <text $else value={NONE} textColor={Style.DIM} />
        </box>
        <box xAlign={Align.End}>
          <Money $if={self.hasProfit} amount={self.profit} color={self.profitColor} />
          <text $else value={NONE} textColor={Style.DIM} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.percent} textColor={Style.WHITE} textFont={.Numbers} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.age} textColor={Style.DIM} textFont={.Numbers} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.can} textColor={Style.WHITE} textFont={.Numbers} />
        </box>
      </TableRow>
    }
  }
}

public class WorthPage implements Component {
  state mode: Mode = Mode.Auction
  state sorted = 5
  state descending = true
  // The picked row's key; "" for none.
  state chosen = ""
  derived reached: Array<Reached> = self.reachedOf()
  derived rows: Array<Worth> = self.rowsOf()
  derived alone: Boolean = self.reached.length < 2
  derived noPrices: Boolean = self.prices == nil
  derived unopened: String = self.unopenedOf()
  derived hasUnopened: Boolean = self.unopened != ""
  derived unopenedLine: String = Locale.WORTH_UNOPENED.format(self.unopened)
  derived emptyLine: String = self.empty ? Locale.WORTH_EMPTY : ""
  derived picked: Worth | nil = self.rows.find(row => row.key == self.chosen)
  derived canShop: Boolean = Auction != nil && self.picked != nil && (self.picked?.missing?.length ?? 0) > 0
  derived empty: Boolean = self.rows.length == 0

  book: Signal<Book>
  prices: Signal<any PriceSource | nil>
  constructor(book: Signal<Book>, prices: Signal<any PriceSource | nil>) {
    self.book = book
    self.prices = prices
  }

  // The characters whose rows the table has: the one being played, and each the book has a page of that Ordaen Alts
  // says it reaches (the same realm and side); the one being played alone while Ordaen Alts is off.
  reachedOf(self): Array<Reached> {
    const book = self.book
    const own = Game.player.guid
    const list: Array<Reached> = []
    const alts = Alts
    if (alts == nil) {
      const shelf = book.characters[own]
      if (shelf != nil) { list.push({ guid: own, name: shelf.name, ready: {} }) }
      return list
    }
    _ = alts.revision
    for (id, character of alts.characters) {
      const shelf = book.characters[id]
      if (shelf != nil && (id == own || alts.reaches(id))) {
        const ready: Map<Integer, Integer> = {}
        for (known of character.professions) {
          for (recipe, hour of known.ready) { ready[recipe] = hour }
        }
        list.push({ guid: id, name: shelf.name, ready: ready })
      }
    }
    return list
  }

  // The first reached character Ordaen Alts knows a profession of that the book has no page of; "" for none.
  unopenedOf(self): String {
    const alts = Alts
    if (alts == nil) { return "" }
    _ = alts.revision
    for (id, character of alts.characters) {
      if (id != Game.player.guid && alts.reaches(id)) {
        const shelf = self.book.characters[id]
        for (known of character.professions) {
          if (known.name != "" && (shelf == nil || shelf.professions[known.skillLine] == nil)) { return character.name }
        }
      }
    }
    return ""
  }

  // How many of an item the reached characters hold: Ordaen Alts' records, or this character's bags while it is off.
  heldOf(self, item: Integer): Integer {
    const alts = Alts
    if (alts == nil) { return (Game.bags.holdings() ?? {})[item] ?? 0 }
    let count = 0
    for (held of alts.holders(ItemId.of(item))) {
      if (held.who == Game.player.guid || alts.reaches(held.who)) { count += held.count }
    }
    return count
  }

  rowsOf(self): Array<Worth> {
    const prices = self.prices
    if (prices != nil) { _ = prices.revision }
    const book = self.book
    const mode = self.mode
    const now: Integer = Hour.now()
    const held: Map<Integer, Integer> = {}
    const list: Array<Worth> = []
    for (character of self.reached) {
      const shelf = book.characters[character.guid]
      if (shelf != nil) {
        for (_, learned of shelf.professions) {
          for (recipe of learned.recipes) {
            const entry = book.recipes[recipe]
            const ready = character.ready[recipe]
            if (entry != nil && wanted(mode, entry, ready, now)) {
              const row = self.worthOf(prices, mode, character, learned.name, recipe, entry, mut held)
              if (mode != Mode.Held || row.can > 0 || row.missing.length == 1) { list.push(row) }
            }
          }
        }
      }
    }
    const column = self.sorted
    const descending = self.descending
    list.sort((a, b) => before(column, descending, a, b))
    return list
  }

  worthOf(
    self, prices: any PriceSource | nil, mode: Mode, character: Reached, profession: String, recipe: Integer, entry: Entry,
    held: mut Map<Integer, Integer>
  ): Worth {
    let cost: Integer | nil = prices == nil ? nil : 0
    let age: Integer | nil = nil
    let can = Number.huge
    const missing: Array<Reagent> = []
    for (part of entry.parts) {
      const have: Integer = held[part.item] ?? self.heldOf(part.item)
      held[part.item] = have
      can = can.min((have / part.count).floor())
      if (have < part.count) { missing.push({ item: part.item, count: part.count - have }) }
      if (prices != nil) {
        const one = unitOf(prices, part.item)
        const unit = one.unit
        if (unit == nil) { cost = nil } else if (cost != nil) { cost = cost + unit * part.count }
        const old = one.age
        if (old != nil) { age = (age ?? old).max(old) }
      }
    }
    let sale: Integer | nil = nil
    const makes = entry.makes
    if (makes != nil) {
      if (mode == Mode.Vendor) {
        const one = merchantPrice(makes)
        if (one != nil) { sale = (one * yieldOfEntry(entry)).floor() }
      } else if (prices != nil) {
        const quote = prices.sell(PriceKey.of(makes))
        if (quote != nil) {
          sale = (quote.copper() * yieldOfEntry(entry)).floor()
          const old: Integer = quote.age()
          age = (age ?? old).max(old)
        }
      }
    }
    const profit: Integer | nil = sale != nil && cost != nil ? sale - cost : nil
    const percent: Integer | nil = profit != nil && cost != nil && cost > 0 ? (profit * 100 / cost).floor() : nil
    return {
      key: `${character.guid}:${recipe}`, recipe: recipe, name: entry.name, who: character.name, profession: profession,
      cost: cost, sale: sale, profit: profit, percent: percent, age: age, can: entry.parts.length == 0 ? 0 : can.floor(),
      missing: missing
    }
  }

  onPick(mut self, key: String) { self.chosen = self.chosen == key ? "" : key }

  // «В список покупок»: what one making of the picked row lacks, onto Ordaen Auction's list.
  onShop(self) {
    const auction = Auction
    const row = peek self.picked
    if (auction == nil || row == nil) { return }
    for (part of row.missing) {
      auction.shopping.add(ItemId.of(part.item), part.count, .Queue { recipe: row.recipe, crafts: 1, character: row.who })
    }
  }

  public render(self): Template {
    return $ltml {
      <box rows={PAGE} gap={space(.Item)}>
        <Segmented value={mut self.mode} choices={MODES} />
        <box rows={["max-content", "max-content", "max-content"]}>
          <text $if={self.alone} value={Locale.WORTH_ALONE} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
          <text $if={self.hasUnopened} value={self.unopenedLine} textSize={SECONDARY_TEXT}
                textColor={Style.DIM} />
          <text $if={self.noPrices} value={Locale.NO_PRICES} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
        </box>
        <box rows={[{ fr: 1 }]} border={{ width: 1.171875dp, color: Style.LINE }} background={Style.LISTS_BACK}>
          <Table columns={COLUMNS} sorted={mut self.sorted} descending={mut self.descending}>
            <WorthLine $for={row of self.rows} worth={row} chosen={self.chosen} @pick={self.onPick} />
          </Table>
        </box>
        <box columns={[{ fr: 1 }, "max-content"]} yAlign={Align.Center}>
          <text value={self.emptyLine} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
          <PushButton label={Locale.TO_SHOPPING} width={210.9375dp} disabled={!self.canShop} @click={self.onShop} />
        </box>
      </box>
    }
  }
}
