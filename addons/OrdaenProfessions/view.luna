// What the professions window's lists share: the views of a profession's recipes, how they are ordered, what a click on
// a row asks of the window, and the groups the recipes fall into.
import Game from "$game"
import { sortedBefore, sortsThen } from "Ordaen"
import { BothSources, betterOf } from "@/split"

// How the recipes are laid out: the categories beside the category's recipes (ours, the default), one list with the
// categories as headings, one flat list, a table.
public enum View implements Plain { Columns = "columns", Categories = "categories", Table = "table" }

// How the recipes of a group are ordered: the game's (by difficulty, the ones learned first), by name, by how many
// the bags can make.
public enum SortBy implements Plain { Difficulty = "difficulty", Name = "name", Makeable = "makeable" }

// How the recipes not learned are grouped: by the game's categories, as the learned are, or as What's Training files
// them, by what the player can learn now (`READINESS`).
public enum Grouping implements Plain { Type = "type", Readiness = "readiness" }

// How the player left a profession's recipe list: its view, its sort, and the table's sorts (`Table`'s). The search
// isn't kept: a list cut short by an old search at the next opening says nothing of why.
public struct ListView implements Plain {
  view: View = View.Columns
  sort: SortBy = SortBy.Difficulty
  tableSorts: Array<Integer> = [1]
  grouping: Grouping = Grouping.Readiness
}
public const LIST_VIEW: ListView = {}

// Each profession's list as the player left it, by its skill line, the profile's (`ModuleMemory`): a profession opens
// as it was left, never as another was.
public struct ListViews implements Plain {
  byLine: Map<Integer, ListView>
}

// How many «Create» makes: the count written, as many as it takes to raise the skill by the count, or all the
// bags allow.
public enum MakeMode { Count = "count", Skill = "skill" }

// What a row of a list asks of the window: it names a recipe by its number.
public enum Act { Pick = 1, Menu = 2, Favorite = 3, Track = 4, Make = 5, Close = 6, Link = 7 }

// The group of the recipes the player starred: it stands first, with no category of the game's number.
public const FAVORITES = -1

// What waits for a recipe not learned, as What's Training files it, each a group of its own with no category of the
// game's number: learned now (the skill, the level and the standing it asks are reached), something else asked first
// (or nothing known of the skill), within 10 points of the skill (and under its most), later.
public const READY_NOW = -11
public const READY_MISSING = -12
public const READY_SOON = -13
public const READY_LATER = -14
public const READINESS: Array<Integer> = [READY_NOW, READY_MISSING, READY_SOON, READY_LATER]

// A category of the game's with the recipes of it the search and the filter let through, and how many of those the
// bags can make now; or the favorites.
public struct Group {
  id: Integer
  name: String
  total: Integer
  makeable: Integer
}

function rank(difficulty: Game.Difficulty): Integer {
  return match (difficulty) {
    Game.Difficulty.Always => 0
    Game.Difficulty.Usually => 1
    Game.Difficulty.Rarely => 2
    Game.Difficulty.Never => 3
  }
}

// Whether `a` stands before `b`: a total order (the name and then the number settle a tie), as Lua's sort asks.
public function before(sort: SortBy, a: Game.Recipe, b: Game.Recipe): Boolean {
  if (sort == SortBy.Makeable) {
    if (a.craftable > b.craftable) { return true }
    if (a.craftable < b.craftable) { return false }
  }
  if (sort == SortBy.Difficulty) {
    if (a.learned != b.learned) { return a.learned }
    const x = rank(a.difficulty)
    const y = rank(b.difficulty)
    if (x < y) { return true }
    if (y < x) { return false }
  }
  if (a.name != b.name) { return a.name < b.name }
  return a.id < b.id
}

// What the table shows of a recipe besides the game's: the skill it is learned at (its orange point), how far it raises
// the skill (`difficultyAt`'s edges: orange below `yellow`, yellow from there below `green`; none where the client's
// table hasn't the recipe), the made item's subclass («Ткань») and where it is worn («Спина»), or its class where it
// isn't worn («Расходуемые»), its totals at the house and at a merchant (none while prices aren't shown).
public struct TableFacts {
  skill: Integer | nil
  yellow: Integer | nil
  green: Integer | nil
  subtype: String | nil
  kind: String | nil
  both: BothSources | nil
}

// The table's columns by their place, which is what it sorts by: the name, the skill it is learned at, how far it
// raises the skill (by where it turns yellow), the made item's class and type, how many the bags make; with prices, the
// cost at the house and at a merchant, what the made item brings at each, the profit at the better.
public const COLUMN_NAME = 1
public const COLUMN_SKILL = 2
public const COLUMN_SKILL_UP = 3
public const COLUMN_CLASS = 4
public const COLUMN_TYPE = 5
public const COLUMN_MAKEABLE = 6
public const COLUMN_COST_AUCTION = 7
public const COLUMN_COST_MERCHANT = 8
public const COLUMN_SALE_AUCTION = 9
public const COLUMN_SALE_MERCHANT = 10
public const COLUMN_PROFIT = 11

// A recipe's text in a column; none for a column of numbers, or where it has none.
function textAt(column: Integer, facts: TableFacts | nil): String | nil {
  if (column == COLUMN_CLASS) { return facts?.subtype }
  if (column == COLUMN_TYPE) { return facts?.kind }
  return nil
}

// A recipe's number in a column; none where it has none (no price, no skill known).
function numberAt(column: Integer, facts: TableFacts | nil, recipe: Game.Recipe): Integer | nil {
  const both = facts?.both
  if (column == COLUMN_SKILL) { return facts?.skill }
  if (column == COLUMN_SKILL_UP) { return facts?.yellow }
  if (column == COLUMN_MAKEABLE) { return recipe.craftable }
  if (both == nil) { return nil }
  if (column == COLUMN_COST_AUCTION) { return both.auction.cost }
  if (column == COLUMN_COST_MERCHANT) { return both.merchant.cost }
  if (column == COLUMN_SALE_AUCTION) { return both.auction.sale }
  if (column == COLUMN_SALE_MERCHANT) { return both.merchant.sale }
  if (column == COLUMN_PROFIT) { return betterOf(both).profit }
  return nil
}

// Whether `a` stands before `b` by one column, ascending (`sortedBefore`), of recipes that have something there (`facts`
// by recipe): the name, then the number.
function columnBefore(column: Integer, facts: Map<Integer, TableFacts>, a: Game.Recipe, b: Game.Recipe): Boolean {
  if (column == COLUMN_NAME) { return a.name < b.name || (a.name == b.name && a.id < b.id) }
  const x = facts[a.id]
  const y = facts[b.id]
  if (column == COLUMN_CLASS || column == COLUMN_TYPE) { return (textAt(column, x) ?? "") < (textAt(column, y) ?? "") }
  return (numberAt(column, x, a) ?? 0) < (numberAt(column, y, b) ?? 0)
}

// Whether a recipe has nothing in a column (no price, no skill known): it stands after every one with something, either
// way.
function missingAt(column: Integer, facts: Map<Integer, TableFacts>, recipe: Game.Recipe): Boolean {
  if (column == COLUMN_NAME) { return false }
  const at = facts[recipe.id]
  if (column == COLUMN_CLASS || column == COLUMN_TYPE) { return textAt(column, at) == nil }
  return numberAt(column, at, recipe) == nil
}

// The table's rows: by its sorts (`sortedBefore`), then by name and number the first sort's way.
public function tableRows(recipes: Array<Game.Recipe>, sorts: Array<Integer>, facts: Map<Integer, TableFacts>): Array<Game.Recipe> {
  const list = recipes.map(recipe => recipe)
  const order = sortsThen(sorts, COLUMN_NAME)
  const recipeBefore = (a: Game.Recipe, b: Game.Recipe, column: Integer): Boolean => columnBefore(column, facts, a, b)
  const missing = (recipe: Game.Recipe, column: Integer): Boolean => missingAt(column, facts, recipe)
  list.sort((a, b) => sortedBefore(a, b, order, recipeBefore, missing))
  return list
}

// Whether a number is among the ones listed.
public function has(list: Array<Integer>, id: Integer): Boolean {
  for (entry of list) {
    if (entry == id) { return true }
  }
  return false
}

// A list of the game's (`of`) as the window shows it: filtered and in its order.
public struct Sorted {
  const of: Array<Game.Recipe>
  const list: Array<Game.Recipe>
}

const NO_RECIPES: Array<Game.Recipe> = []

// The recipes by their category, each category's in the order they are given in: the list is read once for every
// group there is.
public function sorted(recipes: Array<Game.Recipe>): Map<Integer, Array<Game.Recipe>> {
  let lists: Map<Integer, mut Array<Game.Recipe>> = {}
  for (recipe of recipes) {
    let list = lists[recipe.categoryID]
    if (list == nil) {
      lists[recipe.categoryID] = [recipe]
    } else {
      list.push(recipe)
    }
  }
  return lists
}

// The recipes of a group, in the order they are given in: a category's as they were sorted (`sorted`, of the same
// recipes), the favorites picked out of them all.
public function members(
  recipes: Array<Game.Recipe>, byCategory: Map<Integer, Array<Game.Recipe>>, group: Integer, starred: Array<Integer>
): Array<Game.Recipe> {
  if (group != FAVORITES) { return byCategory[group] ?? NO_RECIPES }
  let list: Array<Game.Recipe> = []
  for (recipe of recipes) {
    if (has(starred, recipe.id)) { list.push(recipe) }
  }
  return list
}

// The profession's own tabs: the camp's while it has recipes.
public enum Page { Recipes = "recipes", Camp = "camp", Unlearned = "unlearned", Queue = "queue", Overview = "overview", Guide = "guide", Shopping = "shopping" }

// A recipe in the queue: what «Create» asked for, with how many are still to make, under its profession (whose
// «Queue» tab shows it and runs it), and its name (the game names only the open profession's recipes).
public struct Queued implements Plain {
  skillLine: Integer
  recipe: Integer
  name: String
  count: Integer
}

// Why a profession's queue waits for the player's click to go on: for nothing (its next recipe is ready, or nothing
// is left); the client interrupted the run (the player moved, cancelled it); it refused a craft (a reagent, a tool, a
// place); a fight began; the bags hold no reagents for the next.
public enum Pause implements Plain {
  None = "none", Interrupted = "interrupted", Failed = "failed", Combat = "combat", Missing = "missing"
}

// The most recipes waiting: past it the oldest goes.
public const MOST_QUEUED = 50

// The most of a recipe waiting in the queue: three digits fill the count's room.
public const MOST_COUNT = 999

// What a line of the queue asks of the window: the recipe taken out, the recipe opened in its list; and the queue's
// next run started.
public enum QueueAct { Drop = 1, Open = 2, Next = 3 }

// The last category and recipe the player had chosen in a profession.
public struct Seen implements Plain {
  category: Integer
  recipe: Integer
}

// What the window remembers for the character, kept at once: the profession last open (by its skill line, 0 before
// any was), what was last chosen in each profession, the recipes starred and the ones tracked (each capped, the oldest
// dropped first), and the queue (every profession's lines, in the order they were asked for) and why each
// profession's waits, by its skill line (none for one that waits for nothing). Where the window stands is the
// window's own (`Window`, the profile's).
public struct Kept implements Plain {
  last: Integer
  seen: Map<Integer, Seen>
  favorites: Array<Integer>
  tracked: Array<Integer>
  queue: Array<Queued>
  paused: Map<Integer, Pause>
}

// The most recipes starred, or tracked.
public const MOST_MARKED = 100
