// The recipe book and the «Worth it» tab as the player meets them: a profession opened writes what its recipes take and
// make into the account's book; the tab lists every recipe of the characters reached, priced by Ordaen Trading, with
// what the holdings make now; the modes; the picked row's missing reagents onto the shopping list; a character played
// later keeps the first one's book.
import Client from "$client"
import Game from "$game"
import Test from "$test"

const SCREEN: Test::Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const TAILORING = 197
const CLOAK_RECIPE = 2387
const BOLT_RECIPE = 2963
const CLOTH = 2996
const THREAD = 2320
const LINEN = 2589
const CLOAK = 2570
const NOW = 1790002800

function recipe(id: Integer, name: String): Game::Recipe {
  return {
    id: id, name: name, icon: "Interface/Icons/INV_Misc_Note_01", categoryID: 11, learned: true,
    difficulty: Game::Difficulty::Always, craftable: 0
  }
}

function recipes(): Array<Game::Recipe> { return [recipe(CLOAK_RECIPE, "Linen Cloak"), recipe(BOLT_RECIPE, "Bolt of Linen Cloth")] }

function reagents(id: Integer): Array<Game::Reagent> { return [] }

// A cloak takes a bolt and a thread; a bolt takes two linen.
function schematic(id: Integer): Game::Schematic | nil {
  if (id == CLOAK_RECIPE) {
    return { recipe: id, makes: CLOAK, least: 1, most: 1, parts: [{ item: CLOTH, count: 1 }, { item: THREAD, count: 1 }] }
  }
  return { recipe: id, makes: CLOTH, least: 1, most: 1, parts: [{ item: LINEN, count: 2 }] }
}

function professions(): Array<Game::Profession> {
  return [{ skillLine: TAILORING, name: "Tailoring", icon: 136249, rank: 31, max: 75, kind: Game::ProfessionKind::Crafting }]
}

function categories(): Array<Game::Category> {
  return [{ id: 1, name: "Tailoring" }, { id: 11, name: "Cloth armour", parentID: 1 }]
}

// The house: a bolt at 1 s, a thread at 15 c, a cloak at 5 s, linen at 20 c.
function house(): Array<Game::Offer> {
  return [
    { key: CLOTH, copper: 100, quantity: 5 }, { key: THREAD, copper: 15, quantity: 20 }, { key: CLOAK, copper: 500, quantity: 2 },
    { key: LINEN, copper: 20, quantity: 40 }
  ]
}

// The bags: one bolt and four linen.
function bags(): Map<Integer, Integer> | nil { return { [CLOTH]: 1, [LINEN]: 4 } }

function window(): Test::Part {
  return Test::page().window("Worth it")
}

function row(name: String): String {
  return window().text(name).item().texts().join(" | ")
}

function reads(said: String, expected: String): Boolean {
  if (said != expected) { panic(`it reads «${said}», not «${expected}»`) }
  return true
}

test "the tab prices each known recipe for one making, the profit and how many the holdings make" {
  Game::clock.server = NOW
  Game::auctionQuery.results.emit(house())
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.reagents = reagents
  Game::recipeReader.schematic = schematic
  Game::bags.holdings = bags
  Test::mount(nil, SCREEN)
  Game::bags.changed.emit()
  Game::tradeSkill.open = TAILORING
  Test::page().button("Worth it").click()
  Test::shot("auction")
  // A cloak: a bolt at 1 s and a thread at 15 c, sold at 5 s less 5%; the bags hold no thread. A bolt: two linen at
  // 20 c, sold at 1 s less 5%; four linen make two.
  Test::expect(reads(row("Linen Cloak"), "Linen Cloak | Player | Tailoring | 0g 1s 15c | 0g 4s 75c | 0g 3s 60c | 313 | 0 h | 0"))
  Test::expect(reads(row("Bolt of Linen Cloth"), "Bolt of Linen Cloth | Player | Tailoring | 0g 0s 40c | 0g 0s 95c | 0g 0s 55c | 137 | 0 h | 2"))
}

test "«From what you have» lists what the holdings make now and what one missing reagent would" {
  Game::clock.server = NOW
  Game::auctionQuery.results.emit(house())
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.reagents = reagents
  Game::recipeReader.schematic = schematic
  Game::bags.holdings = bags
  Test::mount(nil, SCREEN)
  Game::bags.changed.emit()
  Game::tradeSkill.open = TAILORING
  Test::page().button("Worth it").click()
  window().button("From what you have").click()
  // The bags make two bolts; a cloak lacks a thread alone.
  Test::expect(reads(row("Bolt of Linen Cloth"), "Bolt of Linen Cloth | Player | Tailoring | 0g 0s 40c | 0g 0s 95c | 0g 0s 55c | 137 | 0 h | 2"))
  Test::expect(window().text("Linen Cloak").shown())
  // Cooldowns: none of these has one.
  window().button("Cooldowns").click()
  Test::expect(!window().text("Linen Cloak").shown() && window().text("Nothing to make in this mode.").shown())
}

test "the picked row's missing reagents go onto the shopping list" {
  Game::clock.server = NOW
  Game::auctionQuery.results.emit(house())
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.reagents = reagents
  Game::recipeReader.schematic = schematic
  Game::bags.holdings = bags
  Test::mount(nil, SCREEN)
  Game::bags.changed.emit()
  Game::tradeSkill.open = TAILORING
  Test::page().button("Worth it").click()
  window().text("Linen Cloak").click()
  window().button("To the shopping list").click()
  Test::shot("shopped")
}

test "a character is named in the book as Forever names it: its name and its surname" {
  Game::clock.server = NOW
  Game::auctionQuery.results.emit(house())
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.reagents = reagents
  Game::recipeReader.schematic = schematic
  Test::mount(nil, SCREEN)
  Test::login({ guid: "Player-1-0000003", name: "Regy", surname: "Ironsight", realm: "Stand-in", faction: "Alliance", classTag: "WARRIOR" })
  Game::tradeSkill.open = TAILORING
  Test::page().button("Worth it").click()
  Test::expect(row("Bolt of Linen Cloth").contains("| Regy Ironsight | Tailoring |"))
}

test "the book is the account's: another character played reads the first one's recipes" {
  Game::clock.server = NOW
  Game::auctionQuery.results.emit(house())
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.reagents = reagents
  Game::recipeReader.schematic = schematic
  Game::bags.holdings = bags
  Test::mount(nil, SCREEN)
  Game::bags.changed.emit()
  Game::tradeSkill.open = TAILORING
  Test::flush()
  Game::tradeSkill.open = nil
  Test::flush()
  Test::login({ guid: "Player-1-0000002", name: "Regron", surname: "", realm: "Stand-in", faction: "Alliance", classTag: "WARRIOR" })
  // Regron's tailoring: the same list, none of it learned.
  Game::tradeSkill.recipes = recipes().map(one => ({ learned: false, ..one }))
  Game::tradeSkill.open = TAILORING
  Test::page().button("Worth it").click()
  // Player's recipes from the book, while Regron is played; Regron's bags and Player's hold four linen each.
  Test::expect(!window().text("Only this character: turn on Ordaen Alts and log in on your other characters to see theirs.").shown())
  Test::expect(reads(row("Bolt of Linen Cloth"), "Bolt of Linen Cloth | Player | Tailoring | — | — | — | — | — | 4"))
}
