// The recipe book: for each character of the account, the recipes it knows of each profession, and for every recipe met
// what it takes and makes. Saved for the account, so «Выгода» prices any character's recipes while no profession is
// open, or while that character isn't played. A profession's page is read as it opens and each time its list changes:
// one client call a recipe it knows.
import Debug from "$debug"
import Game from "$game"

// One of a recipe's reagents: its item and how many one making takes.
public struct Reagent implements Plain {
  public mut item: integer = 0
  public mut count: integer = 1
}

// What a recipe takes and makes, as the client gave it.
public struct Entry implements Plain {
  public mut name: string = ""
  // The item it makes; none for one that makes no item (an enchant).
  public mut makes: integer | nil
  // How many one making gives: from the least to the most.
  public mut least: integer = 1
  public mut most: integer = 1
  public mut parts: array<Reagent> = []
}

// A profession of a character: its name in the player's language, and the recipes it knows.
public struct Learned implements Plain {
  public mut name: string = ""
  public mut recipes: array<integer> = []
  // The character's skill in it, when last opened.
  public mut rank: integer = 0
}

// A character's page of the book.
public struct Shelf implements Plain {
  public mut name: string = ""
  public mut realm: string = ""
  // By skill line.
  public mut professions: mut map<integer, Learned> = {}
}

public struct Book implements Plain {
  public mut recipes: mut map<integer, Entry> = {}
  // By the character's GUID.
  public mut characters: mut map<string, Shelf> = {}
}

// The most characters and recipes the book keeps: a character or a recipe past them isn't written, and the seam says so.
public const MOST_CHARACTERS = 40
public const MOST_RECIPES = 6000

// How many one making gives: the mean of its least and most.
public function yieldOfEntry(entry: Entry): number { return (entry.least + entry.most) / 2 }

// The character being played as Forever names it: its name and its surname («Regy Ironsight»), its name alone where it
// has none.
public function playerName(): string {
  const surname = Game::player.surname ?? ""
  return surname == "" ? Game::player.name : Game::player.name + " " + surname
}

// The book with the open profession's page of the character being played written in: the recipes learned of the
// list the game holds for it (`Game.tradeSkill.recipes`, never another profession's); none where nothing changed or
// no list came yet.
public function written(book: Book, skillLine: integer, recipes: array<Game::Recipe>): Book | nil {
  if (recipes.length == 0) { return nil }
  const known = recipes.filter(recipe => recipe.learned).map(recipe => recipe.id)
  const guid = Game::player.guid
  const next = book.clone()
  const shelf = next.characters[guid]
  if (shelf == nil) {
    let count = 0
    for (key, _ of next.characters) { count += 1 }
    if (count >= MOST_CHARACTERS) {
      Debug::fault("Professions", "the recipe book keeps " + string::of(MOST_CHARACTERS) + " characters at most")
      return nil
    }
  }
  let entries = 0
  for (key, _ of next.recipes) { entries += 1 }
  const names: map<integer, string> = mut {}
  for (recipe of recipes) { names[recipe.id] = recipe.name }
  for (id of known) {
    if (next.recipes[id] == nil) {
      const schematic = Game::recipeReader.schematic(id)
      if (schematic != nil && entries < MOST_RECIPES) {
        next.recipes[id] = {
          name: names[id] ?? "", makes: schematic.makes, least: schematic.least, most: schematic.most,
          parts: schematic.parts.map(part => Reagent { item: part.item, count: part.count })
        }
        entries += 1
      } else if (schematic != nil) {
        Debug::fault("Professions", "the recipe book keeps " + string::of(MOST_RECIPES) + " recipes at most")
      }
    }
  }
  let name = ""
  let rank = 0
  for (profession of Game::professions.list) {
    if (profession.skillLine == skillLine) {
      name = profession.name
      rank = profession.rank
    }
  }
  const professions: map<integer, Learned> = shelf == nil ? {} : shelf.professions.clone()
  professions[skillLine] = { name: name, recipes: known.filter(id => next.recipes[id] != nil), rank: rank }
  next.characters[guid] = { name: playerName(), realm: Game::player.realm, professions: professions }
  if (next.equal(book)) { return nil }
  return next
}
