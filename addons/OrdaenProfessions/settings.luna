// Ordaen Professions' page in the settings window: what the window does about the recipes it shows. Each control
// writes one entry of the settings' draft.
import { Checkbox, Component, Settings } from "Ordaen"
import Locale from "@/locales"

// What the player chooses.
public struct Choices implements Plain {
  // The window opens a profession at the category and recipe the player left it at.
  remember: Boolean
  // The filter starts with the recipes the character hasn't learned in the list.
  showUnlearned: Boolean
}

public class GeneralPage implements Component {
  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Checkbox label={Locale.SETTING_REMEMBER} hint={Locale.SETTING_REMEMBER_TIP}
                value={mut self.settings.draft.remember} />
      <Checkbox label={Locale.SETTING_UNLEARNED} hint={Locale.SETTING_UNLEARNED_TIP}
                value={mut self.settings.draft.showUnlearned} />
    }
  }
}
