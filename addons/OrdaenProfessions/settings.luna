// Ordaen Professions' page in the settings window: what the window does about the recipes it shows. Each control
// writes one entry of the settings, at once.
import { Checkbox, Component, Settings } from "Ordaen"
import root Trading from "OrdaenTrading"
import Locale from "@/locales"

// What the player chooses.
public struct Choices implements Plain {
  // The recipe's card and the lists show Ordaen Trading's prices: the cost, the sale and the profit. Greyed while
  // Ordaen Trading is off, which has them.
  prices: Boolean
  // The window opens a profession at the category and recipe the player left it at.
  remember: Boolean
}

public class GeneralPage implements Component {
  derived noAuction: Boolean = Trading == nil
  derived pricesTip: String = self.noAuction ? Locale::SETTING_PRICES_OFF : Locale::SETTING_PRICES_TIP

  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Checkbox label={Locale::SETTING_PRICES} hint={self.pricesTip} value={mut self.settings.values.prices}
                disabled={self.noAuction} />
      <Checkbox label={Locale::SETTING_REMEMBER} hint={Locale::SETTING_REMEMBER_TIP}
                value={mut self.settings.values.remember} />
    }
  }
}
