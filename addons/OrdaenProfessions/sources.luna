// Where a recipe not learned is learned, as What's Training has it (`recipes.luna`): its trainer and price, the
// vendors that sell its teaching item, the quests that give it, a drop, another player's making, an object in the
// world; the standing it asks with a faction and the merchant favor it costs. Read for the profession open alone, as
// its window opens, and said as the recipe's card says it, a line each.
import Client from "$client"
import Game from "$game"
import Runtime from "$runtime"
import root Quests from "OrdaenQuests"
import Locale from "@/locales"
import Recipes from "@/recipes"
import { READY_LATER, READY_MISSING, READY_NOW, READY_SOON } from "@/view"

// A place a recipe is learned at, by its side (0 both, 1 the Alliance, 2 the Horde).
public struct Sided {
  id: Integer
  area: Integer
  side: Integer
}

// A standing a recipe asks with a faction (the client's reaction, 1 hated to 8 exalted).
public struct Asked {
  faction: Integer
  standing: Integer
}

// Where a recipe is learned.
public struct RecipeSource {
  skill: Integer
  // The player's level a rank asks (0 for none).
  level: Integer = 0
  sources: Array<String>
  // At its trainer, in copper; 0 for none.
  cost: Integer
  favor: Integer
  reputation: Array<Asked>
  quests: Array<Sided>
  vendors: Array<Sided>
}

function numberAt(parts: Array<String>, at: Integer): Integer { return (parts[at] ?? "").toNumber()?.floor() ?? 0 }

function partsOf(text: String, between: String): Array<String> { return text == "" ? [] : text.split(between) }

// `id:area:side:level/...` or `npc:area+area:side/...`: each place, its first area.
function sidedOf(text: String): Array<Sided> {
  const list: Array<Sided> = []
  for (entry of partsOf(text, "/")) {
    const parts = entry.split(":")
    const area = (parts[2] ?? "").split("+")[1] ?? ""
    list.push({ id: numberAt(parts, 1), area: area.toNumber()?.floor() ?? 0, side: numberAt(parts, 3) })
  }
  return list
}

// A profession's recipes' sources, by the recipe's spell; none for a profession the table hasn't.
public function sourcesOf(skillLine: Integer | nil): Map<Integer, RecipeSource> {
  const sources: Map<Integer, RecipeSource> = {}
  const text = skillLine == nil ? nil : Recipes::recipes[skillLine]
  if (text == nil) { return sources }
  for (entry of text.split(";")) {
    const parts = entry.split(",")
    const reputation: Array<Asked> = []
    for (asked of partsOf(parts[13] ?? "", "/")) {
      const pair = asked.split(":")
      reputation.push({ faction: numberAt(pair, 1), standing: numberAt(pair, 2) })
    }
    sources[numberAt(parts, 1)] = {
      skill: numberAt(parts, 2), level: numberAt(parts, 8), sources: partsOf(parts[6] ?? "", "/"), cost: numberAt(parts, 7), favor: numberAt(parts, 11),
      reputation: reputation, quests: sidedOf(parts[14] ?? ""), vendors: sidedOf(parts[15] ?? "")
    }
  }
  return sources
}

// The points of skill ahead within which a recipe is «coming soon», as What's Training counts them.
const SOON_SKILL = 10

// Whether the player stands with a faction as a recipe asks, any of its standings will do; true for one asking none.
function standingMet(source: RecipeSource): Boolean {
  if (source.reputation.length == 0) { return true }
  return source.reputation.any(asked => (Client::C_Reputation::GetFactionDataByID(asked.faction)?.reaction ?? 0) >= asked.standing)
}

// What waits for a recipe not learned, as What's Training files it, at the profession's skill and most.
public function readinessOf(source: RecipeSource | nil, skill: Integer, most: Integer): Integer {
  if (source == nil || source.skill == 0) { return READY_MISSING }
  if (source.skill <= skill) {
    return !standingMet(source) || source.level > Game::player.level ? READY_MISSING : READY_NOW
  }
  if (source.skill <= skill + SOON_SKILL && source.skill <= most) { return READY_SOON }
  return READY_LATER
}

function forSide(place: Sided, side: Integer): Boolean { return place.side == 0 || place.side == side }

// The player's side, as the table writes it: 1 the Alliance, 2 the Horde.
public function sideOfPlayer(): Integer { return Game::player.faction == Game::Faction::Horde ? 2 : 1 }

// A way a recipe is learned, as the filter of the recipes' list tells them apart.
public enum Way { Trainer, Vendor, Quest, Drop, Other }

public function wayOf(name: String): Way {
  if (name == "trainer") { return .Trainer }
  if (name == "vendor") { return .Vendor }
  if (name == "quest") { return .Quest }
  if (name == "drop") { return .Drop }
  return .Other
}

// Whether a recipe is learned from the other side alone: its every way a vendor or a quest, and none of them the
// player's side's.
public function otherSideOnly(source: RecipeSource, side: Integer): Boolean {
  const ways = source.sources.map(wayOf)
  if (ways.length == 0 || ways.any(way => way != Way::Vendor && way != Way::Quest)) { return false }
  return !source.vendors.any(place => forSide(place, side)) && !source.quests.any(place => forSide(place, side))
}

function areaName(area: Integer): String { return Client::C_Map::GetAreaInfo(area) ?? "" }

function vendorName(id: Integer): String { return Quests?.npc(id)?.name ?? Locale::LEARN_NPC.format(id) }

function questName(id: Integer): String {
  return Client::C_QuestLog::GetTitleForQuestID(id) ?? Quests?.questFacts(id)?.name ?? Locale::LEARN_NPC.format(id)
}

// A place or a way a recipe is learned, a row of its card: how (`Trainer`, `Vendor`, ...), whom or what, the zone, the
// trainer's price (0 for none), and what a click opens: the quest (0 for none) or the vendor on the map (0 for none).
public struct LearnPlace {
  way: String
  name: String
  zone: String
  cost: Integer
  quest: Integer
  npc: Integer
}

function placeOf(way: String, name: String): LearnPlace { return { way: way, name: name, zone: "", cost: 0, quest: 0, npc: 0 } }

// Where a recipe is learned, for the player's side: its trainer, each vendor, each quest, a drop, a player's making, an
// object in the world.
public function placesOf(source: RecipeSource, side: Integer): Array<LearnPlace> {
  const places: Array<LearnPlace> = []
  for (way of source.sources) {
    if (way == "trainer") {
      places.push({ way: Locale::WAY_TRAINER, name: Locale::LEARN_TRAINER.format(source.skill), zone: "", cost: source.cost, quest: 0, npc: 0 })
    } else if (way == "vendor") {
      const vendors = source.vendors.filter(place => forSide(place, side))
      if (vendors.length == 0) { places.push(placeOf(Locale::WAY_SELLER, Locale::LEARN_VENDOR_ANY)) }
      for (place of vendors) {
        places.push({ way: Locale::WAY_SELLER, name: vendorName(place.id), zone: areaName(place.area), cost: 0, quest: 0, npc: place.id })
      }
    } else if (way == "quest") {
      const quests = source.quests.filter(place => forSide(place, side))
      if (quests.length == 0) { places.push(placeOf(Locale::WAY_QUEST, Locale::LEARN_QUEST_ANY)) }
      for (place of quests) {
        places.push({ way: Locale::WAY_QUEST, name: questName(place.id), zone: areaName(place.area), cost: 0, quest: place.id, npc: 0 })
      }
    } else if (way == "drop") {
      places.push(placeOf(Locale::WAY_DROP, Locale::LEARN_DROP))
    } else if (way == "crafted") {
      places.push(placeOf(Locale::WAY_CRAFTED, Locale::LEARN_CRAFTED))
    } else if (way == "world_object") {
      places.push(placeOf(Locale::WAY_OBJECT, Locale::LEARN_OBJECT))
    }
  }
  return places
}

// What learning a recipe asks besides its place, a line each: a standing with a faction, merchant favor.
public function asksOf(source: RecipeSource): Array<String> {
  const lines: Array<String> = []
  for (asked of source.reputation) {
    const faction = Client::C_Reputation::GetFactionDataByID(asked.faction)?.name ?? String::of(asked.faction)
    const standing = Runtime::text(`FACTION_STANDING_LABEL${asked.standing}`) ?? String::of(asked.standing)
    lines.push(Locale::LEARN_REPUTATION.format(standing, faction))
  }
  if (source.favor > 0) { lines.push(Locale::LEARN_FAVOR.format(source.favor)) }
  return lines
}
