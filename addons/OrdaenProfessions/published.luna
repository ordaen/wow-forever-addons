// What Ordaen Professions answers other modules on its root, read from the recipe book and the craft queue: the
// recipes that take an item (`uses`), and what the character's queue takes (`queue`). Read-only views; another module
// asks who knows a recipe of Ordaen Alts (`knowers`).
import { Book } from "@/book"
import { Queued } from "@/view"

// A recipe that takes an item: the recipe, its profession (by skill line and name), and how many one making takes.
public struct Use {
  public mut recipe: integer
  public mut skillLine: integer
  public mut profession: string
  public mut count: integer
}

// An item the queue takes, and how many of it every line still to make takes together.
public struct QueueItem {
  public mut item: integer
  public mut count: integer
}

// Every recipe of the book by the items it takes: made once as the book changes, a map read for each question.
public function usesOf(book: Book): map<integer, array<Use>> {
  const lines: map<integer, integer> = mut {}
  const names: map<integer, string> = mut {}
  for (_, shelf of book.characters) {
    for (skillLine, learned of shelf.professions) {
      names[skillLine] = learned.name
      for (recipe of learned.recipes) { lines[recipe] = skillLine }
    }
  }
  const uses: map<integer, mut array<Use>> = mut {}
  for (recipe, entry of book.recipes) {
    const skillLine = lines[recipe]
    if (skillLine != nil) {
      for (part of entry.parts) {
        const use: Use = { recipe: recipe, skillLine: skillLine, profession: names[skillLine] ?? "", count: part.count }
        const list = uses[part.item]
        if (list == nil) { uses[part.item] = mut [use] } else { list.push(use) }
      }
    }
  }
  return uses
}

// What the queue's lines take together, by item, in the order first met.
public function needsOf(book: Book, queue: array<Queued>): array<QueueItem> {
  const needs: array<QueueItem> = mut []
  const at: map<integer, integer> = mut {}
  for (line of queue) {
    const entry = book.recipes[line.recipe]
    if (entry != nil) {
      for (part of entry.parts) {
        const index = at[part.item]
        if (index == nil) {
          needs.push({ item: part.item, count: part.count * line.count })
          at[part.item] = needs.length
        } else {
          const need = needs[index] ?? throw Error { message: "an index it gave" }
          needs[index] = { item: need.item, count: need.count + part.count * line.count }
        }
      }
    }
  }
  return needs
}
