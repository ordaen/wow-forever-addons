// Ordaen Professions: one window for the character's professions, in place of the game's. The window's tabs are the
// professions (icon, name, skill); under its top line the skill bar, then the profession's own tabs («Recipes», and
// «Camp» while it has camp recipes), then the recipes' side (the search, the filter, the sort and the view, and under
// them the recipes in one of four views) and the chosen recipe beside it. The profession shown is the one the game
// has open (it has one open at a time): a tab opens its profession through the game, and the window shows while one
// is open. The game's own window stays open with it, unseen and off the screen: hiding it would close the profession.
import Game from "$game"
import { Action, Align, Line, Overflow, Side, Track } from "$ltml"
import Runtime from "$runtime"
import { ARTWORK, Choice, Column, Memory, Module, Placing, PushButton, PX, SettingsPage, Settings, space, Table, tracksOf, Tabs, ToolPick, Toolbar, Window, WindowTabSpec } from "Ordaen"
import root Ordaen from "Ordaen"
import Locale from "@/locales"
import { RecipeDetails } from "@/details"
import { QueuePage } from "@/queue"
import { knownSpellName, OverviewPage } from "@/overview"
import { FilterButton } from "@/filter"
import { CategoryGroup, CategoryRow, RecipeRow, RecipeTableRow } from "@/rows"
import { Choices, GeneralPage } from "@/settings"
import { SkillBar } from "@/skillBar"
import { Thresholds, thresholdsOf } from "@/skillUps"
import Style from "@/style"
import {
  Act, before, FAVORITES, Group, Kept, LIST_VIEW, ListView, MakeMode, members, MOST_MARKED, Page, Pause, Queued, QueueAct, Seen, SortBy,
  tableBefore, View,
} from "@/view"
import { CraftQueue } from "@/crafting"

const FILL: Array<Track> = [{ fr: 1 }]
// The skill bar, the page tabs, and the recipes' side with the chosen recipe in the rest.
const BODY: Array<Track> = ["auto", "auto", { fr: 1 }]
const GRID: Array<Track> = [Style.LEFT, { fr: 1 }]
const SIDE: Array<Track> = ["auto", { fr: 1 }]
const LISTS: Array<Track> = [Style.CATEGORIES, { fr: 1 }]
const FRAME: Line = { width: 1 * PX, color: Style.LINE }
const COLUMN_RULE: Line = { width: 1 * PX, color: Style.LINE, sides: [Side.Left] }
const TRACK_WIDTH = 170 * PX
// The footer: the profession's spell, and what the page puts beside it; the queue's status and «Create next».
const TRACK_FOOT: Array<Track> = ["auto", { fr: 1 }]
const QUEUE_FOOT: Array<Track> = [{ fr: 1 }, "auto"]
// Mining's and Herbalism's finding on the minimap, by their skill lines: Find Minerals, Find Herbs.
const MINING = 186
const HERBALISM = 182
const FIND_MINERALS = 2580
const FIND_HERBS = 2383

// The spell a profession has at the right end of its tabs' line; none for one that has none.
function trackSpellOf(skillLine: Integer | nil): Integer | nil {
  return match (skillLine) {
    MINING => FIND_MINERALS,
    HERBALISM => FIND_HERBS,
    else => nil,
  }
}
const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_RECIPE, width: { fr: 1 }, sortable: true },
  { title: Locale.COLUMN_MAKEABLE, width: 80 * PX, align: Align.End, sortable: true },
]
const VIEWS: Array<Choice<View>> = [
  { value: View.Columns, label: Locale.VIEW_COLUMNS, icon: ARTWORK.ctl.tool.columns },
  { value: View.Categories, label: Locale.VIEW_CATEGORIES, icon: ARTWORK.ctl.tool.categories },
  { value: View.List, label: Locale.VIEW_LIST, icon: ARTWORK.ctl.tool.list },
  { value: View.Table, label: Locale.VIEW_TABLE, icon: ARTWORK.ctl.tool.table },
]
const SORTS: Array<Choice<SortBy>> = [
  { value: SortBy.Difficulty, label: Locale.SORT_DIFFICULTY },
  { value: SortBy.Name, label: Locale.SORT_NAME },
  { value: SortBy.Makeable, label: Locale.SORT_MAKEABLE },
]
const NOTHING_KEPT: Kept = {
  last: 0, seen: {}, favorites: [], tracked: [], queue: [], paused: Pause.None,
}

public class Professions implements Module, App {
  public const title: String = "Ordaen Professions"
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
  ]
  // The window's footer: the profession's own spell («Find Minerals») at its left; on the queue's page what the queue
  // is doing and «Create next». The make row is the chosen recipe's card's (`RecipeDetails`).
  const footer: Template = $ltml {
    <box columns={self.footColumns} gap={space(.Group)} yAlign={Align.Center}>
      <PushButton $if={self.hasTrack} label={self.trackName} width={TRACK_WIDTH} action={self.trackAction} />
      <box $if={self.queueShown} columns={QUEUE_FOOT} gap={space(.Group)} yAlign={Align.Center}>
        <text value={self.queueStatus} textSize={.Secondary} textColor={Style.DIM} />
        <PushButton label={Locale.QUEUE_NEXT_BUTTON} width={180 * PX} disabled={!self.queueReady}
                    @click={self.onNext} />
      </box>
      <box $else />
    </box>
  }

  public settings: mut Settings<Choices> = new Settings<Choices>({ remember: true, showUnlearned: true })
  public memory: mut Memory<Kept> = new Memory<Kept>(NOTHING_KEPT, .Character)
  // How the player left the recipe list: its view, its sort and the table's order, the profile's (`redesign/kept.md`).
  public list: mut Memory<ListView> = new Memory<ListView>(LIST_VIEW)
  // The queue, the root's and not the window's: it runs while the window is shut.
  public crafting: mut CraftQueue

  // The window's tab: the open profession's place among the character's, and nothing else. It is a cell the window
  // is handed (`mut`, which a `derived` can't be) written by its one watch alone; a tab's click only asks the game.
  public state tab = 0
  derived openTab: Integer = self.openTabOf()
  state page = 1
  // What the player chose, by id; 0 while nothing was: the first one there is stands for it.
  public state category = 0
  public state recipe = 0
  state count = 1
  state makeMode: MakeMode = MakeMode.Count
  public state search = ""
  public state placing: Placing = { x: 0, y: 0, width: Style.WIDTH, height: Style.HEIGHT }
  // The filter: the menu, and each option.
  public state filterOpen = false
  public state onlyMake = false
  public state onlySkill = false
  public state showLearned = true
  public state showUnlearned = true
  // The recipe whose menu is open; 0 for none.
  public state menuFor = 0
  // Every recipe the search and the filter let through, in the sort's order: worked out again when any of them
  // changes, by a watch (the search keeps what it has read in a cache).
  public state shown: Array<Game.Recipe> = []
  // The profession the lists were last drawn for.
  skillLine: Integer = 0
  // Each recipe's name and reagents' names, lower case: what the search looks in, made as the search first asks.
  texts: mut Map<Integer, String> = {}
  // A recipe opened from elsewhere chose itself as its page changed: the page's change keeps it.
  opening = false

  // The game's own window came up with no profession open (its overview): this window stands in its place with
  // nothing chosen, and a tab opens its profession. The client opens a profession from nothing but a click.
  state waiting = false
  derived isOpen: Boolean = Game.tradeSkill.open != nil || self.waiting
  derived hasOpen: Boolean = Game.tradeSkill.open != nil
  public derived kept: Kept = self.memory.values
  derived tabs: Array<WindowTabSpec> = self.tabsOf()
  derived profession: Game.Profession | nil = self.professionOf()
  // The camp category: the first under the profession's heading, by its place and never its name; 0 for none.
  derived camp: Integer = self.campOf()
  // The profession's own tabs, and which the picked one is.
  derived pageKinds: Array<Page> = self.pageKindsOf()
  derived pageNames: Array<String> = self.pageNamesOf()
  derived pageKind: Page = self.pageKinds[self.page] ?? Page.Recipes
  derived onCamp: Boolean = self.pageKind == Page.Camp
  derived queueShown: Boolean = self.pageKind == Page.Queue
  derived overviewShown: Boolean = self.pageKind == Page.Overview
  // The profession's own spell on its tabs' line: a secure button casts it from the player's click.
  derived trackSpell: Integer | nil = trackSpellOf(Game.tradeSkill.open)
  derived trackName: String = knownSpellName(self.trackSpell)
  derived hasTrack: Boolean = self.trackName != ""
  derived footColumns: Array<Track> = self.hasTrack ? TRACK_FOOT : FILL
  derived trackAction: Action | nil = Action.CastSpell { spell: self.trackName }
  // The queue, every profession's, in the order it was asked for; what it is doing, or why it waits; whether «Create
  // next» starts its next run.
  public derived queued: Array<Queued> = self.crafting.lines
  derived queueStatus: String = self.queueStatusOf()
  derived queueReady: Boolean = !self.crafting.running && self.queued.length > 0 && !Game.situation.combat
  // What became of the last «Create» that didn't start: it waits in the queue.
  state note = ""
  // The window closed while a run goes: it is out of sight, and the profession stays open in the client until the
  // run ends, so nothing of the window's closing reaches the craft.
  state hidden = false
  derived drawn: Boolean = !self.hidden
  derived isTable: Boolean = self.list.values.view == View.Table
  // Whether any option of the filter is off what the window starts with.
  public derived filtered: Boolean = self.onlyMake || self.onlySkill || !self.showLearned || self.showUnlearned != self.settings.values.showUnlearned
  // The same but the camp's: what the lists but the camp's page hold.
  public derived mains: Array<Game.Recipe> = self.mainsOf()
  public derived groups: Array<Group> = self.groupsOf()
  public derived chosenCategory: Integer = self.chosenCategoryOf()
  // The recipes of the chosen category, and the table's rows in the table's order.
  public derived recipes: Array<Game.Recipe> = members(self.shown, self.listed, self.kept.favorites)
  derived tableRows: Array<Game.Recipe> = self.tableRowsOf()
  derived tracks: Array<Track> = tracksOf(COLUMNS)
  // The category whose recipes are listed.
  derived listed: Integer = self.onCamp ? self.camp : self.chosenCategory
  // The recipes the lists hold in the order they are drawn, of which one is the chosen.
  public derived listing: Array<Game.Recipe> = self.listingOf()
  public derived chosenRecipe: Integer = self.chosenRecipeOf()
  derived chosen: Game.Recipe | nil = self.chosenOf()
  // Where the open profession's recipes turn yellow and grey: read once each time another profession opens.
  derived thresholds: Thresholds = thresholdsOf(Game.tradeSkill.open)
  derived chosenYellow: Integer | nil = self.thresholds.yellow[self.chosenRecipe]
  derived chosenGrey: Integer | nil = self.thresholds.grey[self.chosenRecipe]
  derived empty: Boolean = self.listing.length == 0
  derived inColumns: Boolean = self.list.values.view == View.Columns
  derived inGroups: Boolean = self.list.values.view == View.Categories
  derived inList: Boolean = self.list.values.view == View.List

  constructor() {
    self.crafting = new CraftQueue(mut self.memory)
    Ordaen.modules.add(self)
    // The run the window was closed during ended: the profession closes now; another opened shows the window.
    watch (running of self.crafting.running) { self.runEnded(running) }
    watch (open of Game.tradeSkill.open) { self.hidden = false }
    watch (at of self.openTab) { self.tab = at }
    watch { self.followOpen() }
    watch { self.onPage() }
    watch { self.shown = self.shownOf() }
    // Another recipe chosen, or another profession open: the count starts again at one.
    watch (recipe of self.chosenRecipe) { self.count = 1 }
    watch (open of Game.tradeSkill.open) { self.count = 1 }
    watch (values of self.settings.values) { self.showUnlearned = values.showUnlearned }
    Game.tradeSkill.shownEmpty.listen(self.onShownEmpty)
  }

  // Each profession the character has: its icon, its name and its skill (`31 / 75`).
  tabsOf(self): Array<WindowTabSpec> {
    let list: Array<WindowTabSpec> = []
    for (profession of Game.professions.list) {
      list.push({
        title: profession.name, icon: profession.icon,
        desc: "%d / %d".format(profession.rank, profession.max),
      })
    }
    return list
  }

  openTabOf(self): Integer {
    for (index, profession of Game.professions.list) {
      if (profession.skillLine == Game.tradeSkill.open) { return index }
    }
    return 0
  }

  professionOf(self): Game.Profession | nil {
    for (profession of Game.professions.list) {
      if (profession.skillLine == Game.tradeSkill.open) { return profession }
    }
    return nil
  }

  campOf(self): Integer {
    for (category of Game.tradeSkill.categories) {
      if (category.parentID != nil) { return category.id }
    }
    return 0
  }

  hasRecipes(self, category: Integer): Boolean {
    for (recipe of Game.tradeSkill.recipes) {
      if (recipe.categoryID == category) { return true }
    }
    return false
  }

  pageKindsOf(self): Array<Page> {
    let kinds: Array<Page> = [Page.Recipes]
    if (self.camp != 0 && self.hasRecipes(self.camp)) { kinds.push(Page.Camp) }
    kinds.push(Page.Queue)
    kinds.push(Page.Overview)
    return kinds
  }

  // «Queue (2)» while two of the profession's recipes wait.
  pageNamesOf(self): Array<String> {
    const waiting = self.queued.length
    let names: Array<String> = []
    for (kind of self.pageKinds) {
      names.push(match (kind) {
        Page.Recipes => Locale.TAB_RECIPES,
        Page.Camp => Locale.TAB_CAMP,
        Page.Queue => waiting > 0 ? Locale.TAB_QUEUE_COUNT.format(waiting) : Locale.TAB_QUEUE,
        Page.Overview => Locale.TAB_OVERVIEW,
      })
    }
    return names
  }

  // What the search looks in for a recipe: its name and its reagents' names, one to a line.
  textOf(mut self, recipe: Game.Recipe): String {
    const cached = self.texts[recipe.id]
    if (cached != nil) { return cached }
    let text = recipe.name.lower()
    for (reagent of Game.tradeSkill.reagents(recipe.id)) { text = text + "\n" + reagent.name.lower() }
    self.texts[recipe.id] = text
    return text
  }

  passes(mut self, recipe: Game.Recipe, sought: String): Boolean {
    if (sought != "" && !self.textOf(recipe).contains(sought)) { return false }
    if (self.onlyMake && recipe.craftable < 1) { return false }
    if (self.onlySkill && recipe.difficulty == Game.Difficulty.Never) { return false }
    return recipe.learned ? self.showLearned : self.showUnlearned
  }

  shownOf(mut self): Array<Game.Recipe> {
    let list: Array<Game.Recipe> = []
    const sought = self.search.lower()
    for (recipe of Game.tradeSkill.recipes) {
      if (self.passes(recipe, sought)) { list.push(recipe) }
    }
    const sort = self.list.values.sort
    list.sort((a, b) => before(sort, a, b))
    return list
  }

  mainsOf(self): Array<Game.Recipe> {
    let list: Array<Game.Recipe> = []
    for (recipe of self.shown) {
      if (recipe.categoryID != self.camp) { list.push(recipe) }
    }
    return list
  }

  // The categories with recipes the lists let through but the camp's, which has a tab of its own, the favorites first.
  groupsOf(self): Array<Group> {
    let list: Array<Group> = []
    const starred = self.kept.favorites
    const hearts = members(self.mains, FAVORITES, starred)
    if (hearts.length > 0) { list.push(self.groupOf(FAVORITES, Locale.FAVORITES, hearts)) }
    for (category of Game.tradeSkill.categories) {
      if (category.parentID != nil && category.id != self.camp) {
        const own = members(self.mains, category.id, starred)
        if (own.length > 0) { list.push(self.groupOf(category.id, category.name, own)) }
      }
    }
    return list
  }

  groupOf(self, id: Integer, name: String, recipes: Array<Game.Recipe>): Group {
    let makeable = 0
    for (recipe of recipes) {
      if (recipe.craftable > 0) { makeable += 1 }
    }
    return { id: id, name: name, total: recipes.length, makeable: makeable }
  }

  chosenCategoryOf(self): Integer {
    for (group of self.groups) {
      if (group.id == self.category) { return group.id }
    }
    const first = self.groups[1]
    if (first == nil) { return 0 }
    return first.id
  }

  tableRowsOf(self): Array<Game.Recipe> {
    let list: Array<Game.Recipe> = []
    for (recipe of self.mains) { list.push(recipe) }
    const column = self.list.values.tableColumn
    const descending = self.list.values.tableDescending
    list.sort((a, b) => tableBefore(column, descending, a, b))
    return list
  }

  listingOf(self): Array<Game.Recipe> {
    if (self.onCamp) { return self.recipes }
    return match (self.list.values.view) {
      View.Columns => self.recipes,
      View.Categories => self.grouped(),
      View.List => self.mains,
      View.Table => self.tableRows,
    }
  }

  // The recipes of every group, one group after another.
  grouped(self): Array<Game.Recipe> {
    let list: Array<Game.Recipe> = []
    for (group of self.groups) {
      for (recipe of members(self.mains, group.id, self.kept.favorites)) { list.push(recipe) }
    }
    return list
  }

  chosenRecipeOf(self): Integer {
    for (recipe of self.listing) {
      if (recipe.id == self.recipe) { return recipe.id }
    }
    const first = self.listing[1]
    if (first == nil) { return 0 }
    return first.id
  }

  chosenOf(self): Game.Recipe | nil {
    for (recipe of self.listing) {
      if (recipe.id == self.chosenRecipe) { return recipe }
    }
    return nil
  }

  // The game opened another profession: what the player had chosen in it, if the window remembers that, is chosen
  // again.
  followOpen(mut self) {
    const open = Game.tradeSkill.open
    if (open != nil) {
      self.waiting = false
      const now = peek self.memory.values
      self.memory.write({ last: open, ..now })
    }
    if (open != nil && open != self.skillLine) {
      self.skillLine = open
      self.texts = {}
      self.category = 0
      self.recipe = 0
      self.page = 1
      self.menuFor = 0
      self.note = ""
      const seen = (peek self.memory.values).seen[open]
      if (seen != nil && (peek self.settings.values).remember) {
        self.category = seen.category
        self.recipe = seen.recipe
      }
    }
  }

  // A tab opens its profession through the game, in the click's own call: the client takes it from nothing
  // else. The tab shows picked once the game has opened it, with its lists.
  onTab(mut self, index: Integer) {
    const picked = (peek Game.professions.list)[index]
    if (picked != nil && picked.skillLine != peek Game.tradeSkill.open) {
      Game.tradeSkill.show(picked.skillLine)
    }
  }

  // Another page of the profession: nothing in it is chosen yet, unless a recipe opened from elsewhere chose it.
  onPage(mut self) {
    if (self.page != 0 && !self.opening) { self.recipe = 0 }
    self.note = ""
    self.opening = false
  }

  // The game's own window came up with no profession open, on the player's key: the profession last open is
  // asked for in its place. Where the client doesn't take that (the key wasn't the player's own), the window
  // waits with its tabs.
  onShownEmpty(mut self) {
    if (peek Game.tradeSkill.open != nil) { return }
    self.waiting = true
    const last = (peek self.memory.values).last
    for (profession of peek Game.professions.list) {
      if (profession.skillLine == last) {
        Game.tradeSkill.show(last)
        return
      }
    }
  }

  // What the player chose in this profession, kept for the next time it is open.
  remember(mut self) {
    const open = peek Game.tradeSkill.open
    if (open == nil || !(peek self.settings.values).remember) { return }
    const now = peek self.memory.values
    let seen = now.seen.clone()
    seen[open] = Seen { category: peek self.category, recipe: peek self.recipe }
    self.memory.write({ seen: seen, ..now })
  }

  pickCategory(mut self, id: Integer) {
    self.category = id
    self.recipe = 0
    self.menuFor = 0
    self.remember()
  }

  // A row of a list asked for something of a recipe.
  onAct(mut self, act: Act, id: Integer) {
    match (act) {
      Act.Pick => { self.pickRecipe(id) },
      Act.Menu => { self.menuFor = id },
      Act.Favorite => { self.starFavorite(id) },
      Act.Track => { self.starTracked(id) },
      Act.Make => { self.onMake(id) },
      Act.Close => { self.closeMenu(id) },
      Act.Link => { self.onLink(id) },
    }
  }

  pickRecipe(mut self, id: Integer) {
    self.recipe = id
    self.note = ""
    self.menuFor = 0
    self.remember()
  }

  closeMenu(mut self, id: Integer) {
    if (peek self.menuFor == id) { self.menuFor = 0 }
  }

  // The recipe's number added to a list, or taken off it where it is there; the oldest goes where the list is full.
  toggled(self, list: Array<Integer>, id: Integer): Array<Integer> {
    let out: Array<Integer> = []
    for (entry of list) {
      if (entry != id) { out.push(entry) }
    }
    if (out.length == list.length) {
      out.push(id)
      if (out.length > MOST_MARKED) { _ = out.remove(1) }
    }
    return out
  }

  starFavorite(mut self, id: Integer) {
    const now = peek self.memory.values
    self.memory.write({ favorites: self.toggled(now.favorites, id), ..now })
  }

  starTracked(mut self, id: Integer) {
    const now = peek self.memory.values
    self.memory.write({ tracked: self.toggled(now.tracked, id), ..now })
  }

  // The item the recipe makes put into the chat's line; a recipe that makes none has no link.
  onLink(mut self, id: Integer) {
    self.menuFor = 0
    const schematic = Game.recipeReader.schematic(id)
    if (schematic != nil && schematic.makes != nil) { Game.chat.link(schematic.makes) }
  }

  // From the menu's click, as «Create» with all the bags make: the game takes making only from one.
  onMake(mut self, id: Integer) {
    self.menuFor = 0
    const open = peek Game.tradeSkill.open
    for (recipe of peek Game.tradeSkill.recipes) {
      if (open != nil && recipe.id == id && recipe.craftable > 0) {
        self.note = self.crafting.add(open, id, recipe.name, recipe.craftable) ? Locale.QUEUED_AFTER : ""
      }
    }
  }

  // The filter's «Reset»: every option back to what the window starts with.
  resetFilter(mut self) {
    self.onlyMake = false
    self.onlySkill = false
    self.showLearned = true
    self.showUnlearned = (peek self.settings.values).showUnlearned
  }

  // «Create», from the button's click, where the game takes making from: the recipe joins the queue, and its run
  // starts at once where nothing waits ahead of it; else the note says it waits.
  onCreate(mut self, count: Integer) {
    const recipe = self.chosen
    const open = peek Game.tradeSkill.open
    if (recipe == nil || open == nil) { return }
    self.note = self.crafting.add(open, recipe.id, recipe.name, count) ? Locale.QUEUED_AFTER : ""
  }

  // A line's stepper set its recipe's count.
  onQueueCount(mut self, recipe: Integer, count: Integer) { self.crafting.recount(recipe, count) }

  // A line of the queue asked for something; «Create next» starts the next run, in the click.
  // «Create next», in the player's click: the client starts a craft from nothing else.
  onNext(mut self) { self.onQueueAct(QueueAct.Next, 0) }

  onQueueAct(mut self, act: QueueAct, id: Integer) {
    match (act) {
      QueueAct.Drop => { self.crafting.recount(id, 0) },
      QueueAct.Open => { self.openRecipe(id) },
      QueueAct.Next => { self.crafting.next() },
    }
  }

  // What the queue is doing, or why it waits for the player's click.
  queueStatusOf(self): String {
    const first = self.queued[1]
    if (first == nil) { return "" }
    if (self.crafting.running) { return Locale.QUEUE_MAKING.format(first.name, self.crafting.left) }
    return match (self.crafting.paused) {
      Pause.Interrupted => Locale.PAUSE_INTERRUPTED,
      Pause.Failed => Locale.PAUSE_FAILED,
      Pause.Combat => Locale.PAUSE_COMBAT,
      Pause.Closed => Locale.PAUSE_CLOSED.format(self.professionName(first.skillLine)),
      Pause.Missing => Locale.PAUSE_MISSING.format(first.name),
      Pause.None => Locale.QUEUE_NEXT.format(first.name, first.count),
    }
  }

  professionName(self, skillLine: Integer): String {
    for (profession of Game.professions.list) {
      if (profession.skillLine == skillLine) { return profession.name }
    }
    return ""
  }

  // A run ended: where the window was closed during it, the profession closes now.
  runEnded(mut self, running: Boolean) {
    if (running || !peek self.hidden) { return }
    self.hidden = false
    Game.tradeSkill.close()
  }

  // A recipe opened from elsewhere: the recipes' tab (the camp's for one of the camp), its category and it chosen.
  openRecipe(mut self, id: Integer) {
    const recipe = (peek Game.tradeSkill.recipes).find(r => r.id == id)
    if (recipe == nil) { return }
    const hasCamp = (peek self.pageKinds).any(k => k == Page.Camp)
    const inCamp = hasCamp && recipe.categoryID == peek self.camp
    const page = inCamp ? 2 : 1
    self.opening = page != peek self.page
    self.page = page
    self.category = recipe.categoryID
    self.pickRecipe(id)
  }

  // The settings window, at this module's page.
  onSettings(self) { Ordaen.toggleSettings(Runtime.Addon.of(self)) }

  // Closing the window (the close button, Escape) closes the profession, which hides it; while a run goes it only
  // hides it, and the profession closes once the run ends.
  onClose(mut self) {
    self.waiting = false
    if (peek self.crafting.running) {
      self.hidden = true
      return
    }
    Game.tradeSkill.close()
  }

  public render(self): Template {
    return $ltml {
      <$if={self.isOpen}>
        <frame of={Game.frames.Professions} opacity={0} away={true} />
        <Window keep={"main"} $if={self.drawn} tabs={self.tabs} selected={mut self.tab} asks={true} placing={mut self.placing} withSettings={true}
                footer={self.footer} @close={self.onClose} @picked={self.onTab} @settings={self.onSettings}>
          <box $if={!self.hasOpen} xAlign={Align.Center} yAlign={Align.Center}>
            <text value={Locale.PICK} textColor={Style.DIM} />
          </box>
          <box $else rows={BODY} gap={space(.Group)}>
            <SkillBar profession={self.profession} />
            <Tabs tabs={self.pageNames} selected={mut self.page} />
            <QueuePage $if={self.queueShown} queued={self.queued} @act={self.onQueueAct} @counted={self.onQueueCount} />
            <OverviewPage $elseif={self.overviewShown} profession={self.profession} thresholds={self.thresholds}
                          kept={self.kept} @pick={self.openRecipe} />
            <box $else columns={GRID} rows={FILL} gap={space(.Group)}>
              <box rows={SIDE} gap={space(.Item)}>
                <Toolbar search={mut self.search} placeholder={Locale.SEARCH}>
                  <FilterButton open={mut self.filterOpen} makeable={mut self.onlyMake} skillUp={mut self.onlySkill}
                                learned={mut self.showLearned} unlearned={mut self.showUnlearned}
                                filtered={self.filtered} @reset={self.resetFilter} />
                  <ToolPick $if={!self.isTable} value={mut self.list.values.sort} choices={SORTS} icon={Ordaen.art.ctl.tool.sort}
                            title={Locale.SORT} />
                  <ToolPick $if={!self.onCamp} value={mut self.list.values.view} choices={VIEWS} icon={Ordaen.art.ctl.tool.columns}
                            title={Locale.VIEW} />
                </Toolbar>
                <box $if={self.onCamp} rows={FILL} border={FRAME} background={Style.LISTS_BACK}>
                  <box overflow={Overflow.Scroll}>
                    <RecipeRow $for={index, recipe of self.recipes} $key={recipe.id} recipe={recipe} index={index}
                               chosen={self.chosenRecipe} kept={self.kept} menuFor={self.menuFor}
                               @act={self.onAct} />
                  </box>
                </box>
                <box $elseif={self.inColumns} columns={LISTS} rows={FILL} border={FRAME}
                     background={Style.LISTS_BACK}>
                  <box overflow={Overflow.Scroll}>
                    <CategoryRow $for={index, group of self.groups} $key={group.id} group={group} index={index}
                                 chosen={self.chosenCategory} @pick={self.pickCategory} />
                  </box>
                  <box overflow={Overflow.Scroll} border={COLUMN_RULE}>
                    <RecipeRow $for={index, recipe of self.recipes} $key={recipe.id} recipe={recipe} index={index}
                               chosen={self.chosenRecipe} kept={self.kept} menuFor={self.menuFor}
                               @act={self.onAct} />
                  </box>
                </box>
                <box $elseif={self.inGroups} rows={FILL} border={FRAME} background={Style.LISTS_BACK}>
                  <box overflow={Overflow.Scroll}>
                    <CategoryGroup $for={group of self.groups} $key={group.id} group={group} shown={self.mains}
                                   chosen={self.chosenRecipe} kept={self.kept} menuFor={self.menuFor}
                                   @act={self.onAct} />
                  </box>
                </box>
                <box $elseif={self.inList} rows={FILL} border={FRAME} background={Style.LISTS_BACK}>
                  <box overflow={Overflow.Scroll}>
                    <RecipeRow $for={index, recipe of self.mains} $key={recipe.id} recipe={recipe} index={index}
                               chosen={self.chosenRecipe} kept={self.kept} menuFor={self.menuFor}
                               @act={self.onAct} />
                  </box>
                </box>
                <box $else rows={FILL} border={FRAME} background={Style.LISTS_BACK}>
                  <Table columns={COLUMNS} sorted={mut self.list.values.tableColumn} descending={mut self.list.values.tableDescending}>
                    <RecipeTableRow $for={recipe of self.tableRows} $key={recipe.id} recipe={recipe}
                                    tracks={self.tracks} chosen={self.chosenRecipe} kept={self.kept}
                                    menuFor={self.menuFor} @act={self.onAct} />
                  </Table>
                </box>
              </box>
              <RecipeDetails recipe={self.chosen} note={self.note} kept={self.kept} count={mut self.count}
                             mode={mut self.makeMode} profession={self.profession} yellow={self.chosenYellow}
                             grey={self.chosenGrey} @act={self.onAct} @create={self.onCreate} />
            </box>
          </box>
        </Window>
      </>
    }
  }
}
