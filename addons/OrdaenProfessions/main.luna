// Ordaen Professions: one window for the character's professions, in place of the game's. The window's tabs are the
// professions (icon, name, skill); under its top line a band of marble with the skill bar and the profession's own
// tabs («Recipes», and «Camp» while it has camp recipes), then the recipes' side (the search, the filter, the sort and
// the view, and under them the recipes in one of three views) and the chosen recipe beside it. The profession shown
// is the one the game has open (it has one open at a time): a tab opens its profession through the game, and the
// window shows while one is open. The game's own window stays open with it, unseen and off the screen: hiding it would close the profession.
import Client from "$client"
import Game from "$game"
import { Action, Align, Edges, Track } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { ARTWORK, Choice, Column, FOOTER_ROOM, FilterButton, FilterGroup, ItemId, KeptWindow, Module, ModuleMemory, PushButton, SECONDARY_TEXT, Settings, SettingsPage, Table, ToolPick, Toolbar, WINDOW_ROOM, Window, WindowTabSpec, WindowsPage, tracksOf, windowsTitle } from "Ordaen"
import root Auction from "OrdaenAuction"
import type { PriceSource } from "OrdaenAuction"
import { TrainerIgnored, TrainerList, TrainerView, TrainerWindow } from "OrdaenTrainer"
import { BandBar } from "@/bandBar"
import { Book, written } from "@/book"
import { Totals, makesOf, partsOf, totalsOf, yieldOf } from "@/cost"
import { CraftQueue } from "@/crafting"
import { RecipeDetails } from "@/details"
import { Learning, Taught, learnedFrom } from "@/learn"
import Locale from "@/locales"
import { OverviewPage, knownSpellName } from "@/overview"
import { PageTabs } from "@/pageTabs"
import { QueueItem, Use, needsOf, usesOf } from "@/published"
import { Need, QueuePage } from "@/queue"
import { CategoryGroup, CategoryRow, RecipeRow, RecipeTableRow } from "@/rows"
import { Choices, GeneralPage } from "@/settings"
import { SideList } from "@/sideList"
import { Thresholds, thresholdsOf } from "@/skillUps"
import { RecipeSource, Way, otherSideOnly, readinessOf, sideOfPlayer, sourcesOf, wayOf } from "@/sources"
import Style from "@/style"
import {
  Act, before, FAVORITES, Group, Grouping, Kept, LIST_VIEW, ListView, MakeMode, members, MOST_MARKED, Page, Pause, Queued, QueueAct, READINESS, READY_MISSING, READY_NOW, READY_SOON, Seen, SortBy,
  Sorted, sorted, tableBefore, View
} from "@/view"
import { WorthPage } from "@/worth"

const FILL: Array<Track> = [{ fr: 1 }]
// The trainer's tab: the client's book of a trade.
const TRAINER_TAB: WindowTabSpec = { title: Locale.TRAINER, desc: nil, icon: "Interface/Icons/INV_Misc_Book_11" }
// The band of the skill bar and the page tabs across the window's whole width (its page keeps no room of the
// window's), and the page in the rest, in the window's room.
const BODY: Array<Track> = ["max-content", { fr: 1 }]
const NO_ROOM: Edges = { top: 0sp, right: 0sp, bottom: 0sp, left: 0sp }
const PAGE_ROOM: Edges = { top: 4sp, right: WINDOW_ROOM, bottom: 4sp, left: WINDOW_ROOM }
// The recipes page runs to the window's edges: its toolbar keeps the window's room at the left.
const TOOL_ROOM: Edges = { top: 6sp, right: 3sp, bottom: 3sp, left: WINDOW_ROOM }
// The recipes' side and the card share the width alike, the side never narrower than its lists' least; the
// categories and the recipes share the side's, each never narrower than its least. The toolbar over the region.
const GRID: Array<Track> = [{ fr: 1 }, { fr: 1 }]
const TOOLED: Array<Track> = ["max-content", { fr: 1 }]
const LISTS: Array<Track> = [{ fr: 2 }, { fr: 3 }]
const TRACK_WIDTH = 199.21875dp
// The trainer's window: its list; the card's column widens it.
const TRAINER_WIDTH = 960.9375dp
const TRAINER_HEIGHT = 609.375dp
// The band: the skill bar, the profession's spell at its right.
const BAND_WITH_TRACK: Array<Track> = [{ fr: 1 }, "max-content"]
// The footer: the queue's status and «Create next».
const QUEUE_FOOT: Array<Track> = [{ fr: 1 }, "max-content"]
// Mining's and Herbalism's finding on the minimap, by their skill lines: Find Minerals, Find Herbs.
const MINING = 186
const HERBALISM = 182
const FIND_MINERALS = 2580
const FIND_HERBS = 2383

// The spell a profession has at the right end of its tabs' line; none for one that has none.
function trackSpellOf(skillLine: Integer | nil): Integer | nil {
  return match (skillLine) {
    MINING => FIND_MINERALS
    HERBALISM => FIND_HERBS
    else => nil
  }
}
const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_RECIPE, width: { fr: 1 }, sortable: true },
  { title: Locale.COLUMN_MAKEABLE, width: 103.125dp, align: Align.End, sortable: true }
]
// With Ordaen Auction's prices: one making's cost and profit.
const PRICED_COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_RECIPE, width: { fr: 1 }, sortable: true },
  { title: Locale.COLUMN_MAKEABLE, width: 103.125dp, align: Align.End, sortable: true },
  { title: Locale.COLUMN_COST, width: 128.90625dp, align: Align.End, sortable: true },
  { title: Locale.COLUMN_PROFIT, width: 128.90625dp, align: Align.End, sortable: true }
]
const VIEWS: Array<Choice<View>> = [
  { value: View.Columns, label: Locale.VIEW_COLUMNS, icon: ARTWORK.ctl.tool.columns },
  { value: View.Categories, label: Locale.VIEW_CATEGORIES, icon: ARTWORK.ctl.tool.categories },
  { value: View.Table, label: Locale.VIEW_TABLE, icon: ARTWORK.ctl.tool.table }
]
const GROUPINGS: Array<Choice<Grouping>> = [
  { value: Grouping.Readiness, label: Locale.GROUP_READINESS }, { value: Grouping.Type, label: Locale.GROUP_TYPE }
]
const SORTS: Array<Choice<SortBy>> = [
  { value: SortBy.Difficulty, label: Locale.SORT_DIFFICULTY },
  { value: SortBy.Name, label: Locale.SORT_NAME },
  { value: SortBy.Makeable, label: Locale.SORT_MAKEABLE }
]
// The filter: the game's own options («Фильтр»).
enum RecipeFilter { Makeable, SkillUp, Trainer, Vendor, Quest, Drop, OtherWay, NoReputation, OtherSide }
const FILTERS: Array<FilterGroup<RecipeFilter>> = [
  {
    options: [{ key: RecipeFilter.Makeable, label: Locale.FILTER_MAKEABLE }, { key: RecipeFilter.SkillUp, label: Locale.FILTER_SKILLUP }]
  },
  {
    options: [
      { key: RecipeFilter.Trainer, label: Locale.FILTER_TRAINER }, { key: RecipeFilter.Vendor, label: Locale.FILTER_VENDOR },
      { key: RecipeFilter.Quest, label: Locale.FILTER_QUEST }, { key: RecipeFilter.Drop, label: Locale.FILTER_DROP },
      { key: RecipeFilter.OtherWay, label: Locale.FILTER_OTHER_WAY }
    ]
  },
  {
    options: [{ key: RecipeFilter.NoReputation, label: Locale.FILTER_NO_REPUTATION }, { key: RecipeFilter.OtherSide, label: Locale.FILTER_OTHER_SIDE }]
  }
]
// The options that narrow the recipes not learned to the ways that are on: none on, every way.
const WAY_FILTERS: Array<RecipeFilter> = [RecipeFilter.Trainer, RecipeFilter.Vendor, RecipeFilter.Quest, RecipeFilter.Drop, RecipeFilter.OtherWay]

function filterOf(way: Way): RecipeFilter {
  return match (way) {
    .Trainer => RecipeFilter.Trainer
    .Vendor => RecipeFilter.Vendor
    .Quest => RecipeFilter.Quest
    .Drop => RecipeFilter.Drop
    .Other => RecipeFilter.OtherWay
  }
}

// What is on, an option after another in the filter's order.
function keyOf(filter: Map<RecipeFilter, Boolean>): String {
  let key = ""
  for (group of FILTERS) {
    for (option of group.options) { key = key + (filter[option.key] == true ? "1" : "0") }
  }
  return key
}

// The filter as the window starts it, as What's Training's does: the recipes not learned from a trainer, a vendor or a
// quest, none asking a standing (the other side's alone left out).
const FILTER_START: Map<RecipeFilter, Boolean> = {
  [RecipeFilter.Trainer]: true, [RecipeFilter.Vendor]: true, [RecipeFilter.Quest]: true, [RecipeFilter.NoReputation]: true
}

// A group of What's Training's by its name.
function readinessName(readiness: Integer): String {
  if (readiness == READY_NOW) { return Locale.READY_NOW }
  if (readiness == READY_MISSING) { return Locale.READY_MISSING }
  if (readiness == READY_SOON) { return Locale.READY_SOON }
  return Locale.READY_LATER
}

// What's Training's order within a group: by the skill a recipe is learned at, then by name.
function bySkill(sources: Map<Integer, RecipeSource>, a: Game.Recipe, b: Game.Recipe): Boolean {
  const x = sources[a.id]?.skill ?? 1000
  const y = sources[b.id]?.skill ?? 1000
  if (x != y) { return x < y }
  if (a.name != b.name) { return a.name < b.name }
  return a.id < b.id
}

const NO_USES: Array<Use> = []

const NOTHING_KEPT: Kept = {
  last: 0, seen: {}, favorites: [], tracked: [], queue: [], paused: {}
}

public class Professions implements Module, App {
  public const title: String = "Ordaen Professions"
  // Its window, declared: where it stands and what the player does with it, kept in the profile.
  public window: mut KeptWindow = new KeptWindow("main", self.title, { x: 0ui, y: 0ui, width: Style.WIDTH, height: Style.HEIGHT })
  public trainerWindow: mut KeptWindow = new KeptWindow("trainer", Locale.TRAINER, { x: 0ui, y: 0ui, width: TRAINER_WIDTH, height: TRAINER_HEIGHT })
  public const windows: mut Array<mut KeptWindow> = [self.window, self.trainerWindow]
  // How the player left the trainer's window, the profile's.
  public trainerList: mut ModuleMemory<TrainerList> = new ModuleMemory<TrainerList>({ view: TrainerView.Table }, .Profile, "trainer")
  // The recipes the player ignored, the character's.
  public ignored: mut ModuleMemory<TrainerIgnored> = new ModuleMemory<TrainerIgnored>({}, .Character, "ignored")
  // The player stands at a profession's trainer (a class's and a pet's are Ordaen Spells' and the game's), what it
  // teaches.
  state atTrainer = false
  state services: Array<Game.TrainerService> = []
  // The game's trainer window (`Game.frames.Trainer`, there from its load) stands away while ours shows, and while no trainer is open, so the game's window manager
  // never counts it (it holds three windows): it is away already as the game shows it. A trainer of another kind open (a
  // class's, Ordaen Spells'), it is let be.
  derived holdsTrainer: Boolean = Game.frames.Trainer != nil && (!Game.trainer.open || self.atTrainer)
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
    { title: windowsTitle(), content: $ltml { <WindowsPage windows={mut self.windows} /> } }
  ]
  // The window's footer, on the queue's page alone: what the queue is doing and «Create next». The make row is the
  // chosen recipe's card's (`RecipeDetails`); the profession's own spell stands beside the skill bar. Elsewhere there
  // is no footer: the page runs to the window's bottom line.
  const footer: Template = $ltml {
    <box $if={self.queueShown} padding={FOOTER_ROOM} columns={QUEUE_FOOT} gap={6sp} yAlign={Align.Center}>
      <text value={self.queueStatus} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
      <PushButton label={Locale.QUEUE_NEXT_BUTTON} width={210.9375dp} disabled={!self.queueReady}
                  @click={self.onNext} />
    </box>
  }

  public settings: mut Settings<Choices> = new Settings<Choices>({ prices: true, remember: true })
  public memory: mut ModuleMemory<Kept> = new ModuleMemory<Kept>(NOTHING_KEPT, .Character)
  // What the profession trainers met teach, the account's: every character meets the same trainers.
  public learning: mut ModuleMemory<Learning> = new ModuleMemory<Learning>({ recipes: {} }, .Account)
  // The recipe book, the account's: what every character knows, and what each recipe takes and makes («Выгода»).
  public book: mut ModuleMemory<Book> = new ModuleMemory<Book>({ recipes: {}, characters: {} }, .Account, "book")
  derived written: Book = self.book.values
  // Every known recipe by the items it takes, for `uses`.
  derived usedBy: Map<Integer, Array<Use>> = usesOf(self.written)
  // What this character's craft queue takes, every line still to make together: another module's read.
  public derived queue: Array<QueueItem> = needsOf(self.written, self.crafting.lines)
  derived taught: Map<String, Taught> = self.learning.values.recipes
  // How the player left the recipe list: its view, its sort and the table's order, the profile's.
  public list: mut ModuleMemory<ListView> = new ModuleMemory<ListView>(LIST_VIEW)
  // The queue, the root's and not the window's: it runs while the window is shut.
  public crafting: mut CraftQueue

  // The window's tab: the open profession's place among the character's, and nothing else. It is a cell the window
  // is handed (`mut`, which a `derived` can't be) written by its one watch alone; a tab's click only asks the game.
  public state tab = 0
  derived openTab: Integer = self.openTabOf()
  // The recipes' page at first: the overview stands before it.
  state page = 2
  // What the player chose, by id; 0 while nothing was: the first one there is stands for it.
  public state category = 0
  public state recipe = 0
  state count = 1
  state makeMode: MakeMode = MakeMode.Count
  public state search = ""
  // The filter's options on, and each as the passing reads it.
  public state filter: Map<RecipeFilter, Boolean> = FILTER_START
  derived onlyMake: Boolean = self.filter[RecipeFilter.Makeable] == true
  derived onlySkill: Boolean = self.filter[RecipeFilter.SkillUp] == true
  // Where the recipes of the profession open are learned, read as it opens.
  derived sources: Map<Integer, RecipeSource> = sourcesOf(self.profession?.skillLine)
  // What is on, as a text: the sorted lists are kept while it stands.
  derived filterKey: String = keyOf(self.filter)
  // The recipe whose menu is open; 0 for none.
  public state menuFor = 0
  // Every recipe the search and the filter let through, in the sort's order: worked out again when any of them
  // changes, by a watch (the search keeps what it has read in a cache).
  public state shown: Array<Game.Recipe> = []
  // The profession the lists were last drawn for.
  skillLine: Integer = 0
  // Each recipe's name and reagents' names, lower case: what the search looks in, made as the search first asks.
  texts: mut Map<Integer, String> = {}
  // Each profession's list as it was last filtered and sorted, while what is sought, the filter and the order
  // stand (`sortedAs`): a profession opened again, the game's list of it the same, is sorted no second time.
  sortedOf: mut Map<Integer, Sorted> = {}
  sortedAs: String = ""
  // A recipe opened from elsewhere chose itself as its page changed: the page's change keeps it.
  opening = false

  // The game's own window came up with no profession open (its overview): this window stands in its place with
  // nothing chosen, and a tab opens its profession. The client opens a profession from nothing but a click.
  state waiting = false
  derived isOpen: Boolean = Game.tradeSkill.open != nil || self.waiting
  derived hasOpen: Boolean = Game.tradeSkill.open != nil
  public derived kept: Kept = self.memory.values
  derived tabs: Array<WindowTabSpec> = self.tabsOf()
  derived profession: Game.Profession | nil = self.professionOf()
  // The camp category: the first under the profession's heading, by its place and never its name; 0 for none.
  derived camp: Integer = self.campOf()
  // The profession's own tabs, and which the picked one is.
  derived pageKinds: Array<Page> = self.pageKindsOf()
  derived pageNames: Array<String> = self.pageNamesOf()
  derived pageKind: Page = self.pageKinds[self.page] ?? Page.Recipes
  derived onCamp: Boolean = self.pageKind == Page.Camp
  // The recipes not learned have a page of their own; every other page lists what is learned.
  derived unlearnedShown: Boolean = self.pageKind == Page.Unlearned
  // The recipes not learned grouped by what waits for them (What's Training's), not by the game's categories.
  derived byReadiness: Boolean = self.unlearnedShown && self.list.values.grouping == Grouping.Readiness
  derived queueShown: Boolean = self.pageKind == Page.Queue
  derived overviewShown: Boolean = self.pageKind == Page.Overview
  derived worthShown: Boolean = self.pageKind == Page.Worth
  // The recipes run to the window's edges; every other page keeps the window's room.
  derived pageRoom: Edges = self.queueShown || self.overviewShown || self.worthShown ? PAGE_ROOM : NO_ROOM
  // The profession's own spell on its tabs' line: a secure button casts it from the player's click.
  derived trackSpell: Integer | nil = trackSpellOf(Game.tradeSkill.open)
  derived trackName: String = knownSpellName(self.trackSpell)
  derived hasTrack: Boolean = self.trackName != ""
  derived bandColumns: Array<Track> = self.hasTrack ? BAND_WITH_TRACK : FILL
  derived trackAction: Action | nil = Action.CastSpell { spell: self.trackName, chord: .Left, selfCast: false }
  // The open profession's queue, in the order it was asked for; what it is doing, or why it waits; whether «Create
  // next» starts its next run.
  public derived queued: Array<Queued> = self.crafting.linesOf(Game.tradeSkill.open)
  derived queueStatus: String = self.queueStatusOf()
  derived queueReady: Boolean = !self.crafting.running && self.queued.length > 0 && !Game.situation.combat
  // What became of the last «Create» that didn't start: it waits in the queue.
  state note = ""
  // The window closed while a run goes: it is out of sight, and the profession stays open in the client until the
  // run ends, so nothing of the window's closing reaches the craft.
  state hidden = false
  derived drawn: Boolean = !self.hidden
  derived isTable: Boolean = self.list.values.view == View.Table
  // The same but the camp's: what the lists but the camp's page hold.
  public derived mains: Array<Game.Recipe> = self.mainsOf()
  public derived groups: Array<Group> = self.groupsOf()
  public derived chosenCategory: Integer = self.chosenCategoryOf()
  // The recipes of the chosen category, and the table's rows in the table's order.
  public derived recipes: Array<Game.Recipe> = members(self.shown, self.byCategory, self.listed, self.kept.favorites)
  // What is shown by its category: every group's recipes come of one reading of the list.
  derived byCategory: Map<Integer, Array<Game.Recipe>> = self.byReadiness ? self.readinessGroups() : sorted(self.shown)
  derived tableRows: Array<Game.Recipe> = self.tableRowsOf()
  derived priced: Boolean = self.prices != nil
  derived tableColumns: Array<Column> = self.priced ? PRICED_COLUMNS : COLUMNS
  derived tracks: Array<Track> = tracksOf(self.tableColumns)
  // One making's totals of each recipe the table lists, worked out while the table shows with prices.
  derived worth: Map<Integer, Totals> = self.worthOf()
  // The category whose recipes are listed.
  derived listed: Integer = self.onCamp ? self.camp : self.chosenCategory
  // The recipes the lists hold in the order they are drawn, of which one is the chosen.
  public derived listing: Array<Game.Recipe> = self.listingOf()
  public derived chosenRecipe: Integer = self.chosenRecipeOf()
  derived chosen: Game.Recipe | nil = self.chosenOf()
  // Ordaen Auction's prices, while it is on and «Prices» is: nothing of it is read while it is off.
  derived prices: any PriceSource | nil = self.pricesOf()
  // Where the open profession's recipes turn yellow and grey: read once each time another profession opens.
  derived thresholds: Thresholds = thresholdsOf(Game.tradeSkill.open)
  derived chosenYellow: Integer | nil = self.thresholds.yellow[self.chosenRecipe]
  derived chosenGrey: Integer | nil = self.thresholds.grey[self.chosenRecipe]
  derived empty: Boolean = self.listing.length == 0
  derived inColumns: Boolean = self.list.values.view == View.Columns
  derived inGroups: Boolean = self.list.values.view == View.Categories

  constructor() {
    self.crafting = new CraftQueue(mut self.memory)
    Ordaen.modules.add(self)
    // The run the window was closed during ended: the profession closes now; another opened shows the window.
    watch (running of self.crafting.running) { self.runEnded(running) }
    watch (open of Game.tradeSkill.open) { self.hidden = false }
    watch (at of self.openTab) { self.tab = at }
    // The page's watch stands before the open profession's: what the profession chose again as it opens is kept.
    watch (page of self.page) { self.onPage() }
    watch { self.followOpen() }
    watch { self.writeBook(Game.tradeSkill.open, Game.tradeSkill.recipes) }
    watch { self.shown = self.shownOf() }
    // Another recipe chosen, or another profession open: the count starts again at one.
    watch (recipe of self.chosenRecipe) { self.count = 1 }
    watch (open of Game.tradeSkill.open) { self.count = 1 }
    Game.tradeSkill.shownEmpty.listen(self.onShownEmpty)
    Game.trainer.changed.listen(self.onTrainer)
    watch (opened of Game.trainer.open) {
      if (!opened) { self.atTrainer = false }
    }
  }

  // The recipes of every character's book that take an item: another module's read.
  public uses(self, item: Integer): Array<Use> { return self.usedBy[item] ?? NO_USES }

  // A profession's trainer shows, or its services change: the skill and the price of each recipe it teaches are kept,
  // and its window shows them.
  onTrainer(mut self) {
    if (!Game.trainer.open || Game.trainer.teachesClass()) { return }
    const services = Game.trainer.services()
    const now = peek self.learning.values
    self.learning.write({ recipes: learnedFrom(now.recipes, services) })
    if (!Client.IsTradeskillTrainer()) { return }
    self.services = services
    self.atTrainer = true
  }

  // The open profession's page of the book, as it opens and each time its list changes.
  writeBook(mut self, open: Integer | nil, recipes: Array<Game.Recipe>) {
    if (open == nil) { return }
    const next = written(peek self.book.values, open, recipes)
    if (next != nil) { self.book.write(next) }
  }

  // Each profession the character has: its icon, its name and its skill (`31 / 75`).
  tabsOf(self): Array<WindowTabSpec> {
    let list: Array<WindowTabSpec> = []
    for (profession of Game.professions.list) {
      list.push({
        title: profession.name, icon: profession.icon,
        desc: "%d / %d".format(profession.rank, profession.max), padding: NO_ROOM
      })
    }
    return list
  }

  // «To the shopping list» on «Queue»: each missing reagent onto Ordaen Auction's list, as asked by the first line
  // that needs it (the list takes nothing of one that lacks none); one the game names no item of can't go on it.
  onShop(self, needs: Array<Need>) {
    const auction = Auction
    if (auction == nil) { return }
    for (need of needs) {
      const item = need.item
      if (item != nil) {
        auction.shopping.add(ItemId.of(item), need.missing,
          .Queue { recipe: need.recipe, crafts: need.crafts, character: Game.player.name })
      }
    }
  }

  pricesOf(self): any PriceSource | nil {
    const auction = Auction
    if (auction == nil || !self.settings.values.prices) { return nil }
    return auction.prices
  }

  openTabOf(self): Integer {
    for (index, profession of Game.professions.list) {
      if (profession.skillLine == Game.tradeSkill.open) { return index }
    }
    return 0
  }

  professionOf(self): Game.Profession | nil {
    for (profession of Game.professions.list) {
      if (profession.skillLine == Game.tradeSkill.open) { return profession }
    }
    return nil
  }

  campOf(self): Integer {
    for (category of Game.tradeSkill.categories) {
      if (category.parentID != nil) { return category.id }
    }
    return 0
  }

  hasRecipes(self, category: Integer): Boolean {
    for (recipe of Game.tradeSkill.recipes) {
      if (recipe.categoryID == category) { return true }
    }
    return false
  }

  // The overview first, then the recipes (the page it opens at), the camp's, the ones not learned, the queue, the
  // worth.
  pageKindsOf(self): Array<Page> {
    let kinds: Array<Page> = [Page.Overview, Page.Recipes]
    if (self.camp != 0 && self.hasRecipes(self.camp)) { kinds.push(Page.Camp) }
    kinds.push(Page.Unlearned)
    kinds.push(Page.Queue)
    kinds.push(Page.Worth)
    return kinds
  }

  // A page's place among the tabs; the recipes' where it has none.
  pageAt(self, kind: Page): Integer {
    const kinds = peek self.pageKinds
    for (i, each of kinds) {
      if (each == kind) { return i }
    }
    return 2
  }

  // «Queue (2)» while two recipes of the open profession wait.
  pageNamesOf(self): Array<String> {
    const waiting = self.queued.length
    let names: Array<String> = []
    for (kind of self.pageKinds) {
      names.push(match (kind) {
        Page.Recipes => Locale.TAB_RECIPES
        Page.Camp => Locale.TAB_CAMP
        Page.Unlearned => Locale.TAB_UNLEARNED
        Page.Queue => waiting > 0 ? Locale.TAB_QUEUE_COUNT.format(waiting) : Locale.TAB_QUEUE
        Page.Overview => Locale.TAB_OVERVIEW
        Page.Worth => Locale.TAB_WORTH
      })
    }
    return names
  }

  // What the search looks in for a recipe: its name and its reagents' names, one to a line.
  textOf(mut self, recipe: Game.Recipe): String {
    const cached = self.texts[recipe.id]
    if (cached != nil) { return cached }
    let text = recipe.name.lower()
    for (reagent of Game.tradeSkill.reagents(recipe.id)) { text = text + "\n" + reagent.name.lower() }
    self.texts[recipe.id] = text
    return text
  }

  passes(mut self, recipe: Game.Recipe, sought: String): Boolean {
    if (sought != "" && !self.textOf(recipe).contains(sought)) { return false }
    if (self.onlyMake && recipe.craftable < 1) { return false }
    if (self.onlySkill && recipe.difficulty == Game.Difficulty.Never) { return false }
    // Learned on every page but the one of the recipes not learned, which shows those alone.
    if (recipe.learned) { return !self.unlearnedShown }
    if (!self.unlearnedShown) { return false }
    const source = self.sources[recipe.id]
    return source == nil || self.learnedFromShown(source)
  }

  // A recipe not learned is shown by where it is learned: a way that is on (where any is), no reputation where those
  // are left out, the other side's alone where those are shown.
  learnedFromShown(self, source: RecipeSource): Boolean {
    if (self.filter[RecipeFilter.NoReputation] == true && source.reputation.length > 0) { return false }
    if (self.filter[RecipeFilter.OtherSide] != true && otherSideOnly(source, sideOfPlayer())) { return false }
    const anyWay = WAY_FILTERS.any(key => self.filter[key] == true)
    return !anyWay || source.sources.any(way => self.filter[filterOf(wayOf(way))] == true)
  }

  shownOf(mut self): Array<Game.Recipe> {
    const sought = self.search.lower()
    const sort = self.list.values.sort
    const asked = `${sought}\n${sort}\n${self.filterKey}\n${self.unlearnedShown}\n${self.byReadiness}`
    if (asked != self.sortedAs) {
      self.sortedAs = asked
      self.sortedOf = {}
    }
    const all = Game.tradeSkill.recipes
    const open = Game.tradeSkill.open
    const kept = open == nil ? nil : self.sortedOf[open]
    if (kept != nil && kept.of == all) { return kept.list }
    let list: Array<Game.Recipe> = []
    for (recipe of all) {
      if (self.passes(recipe, sought)) { list.push(recipe) }
    }
    if (self.byReadiness) {
      const sources = self.sources
      list.sort((a, b) => bySkill(sources, a, b))
    } else {
      list.sort((a, b) => before(sort, a, b))
    }
    if (open != nil) { self.sortedOf[open] = { of: all, list: list } }
    return list
  }

  mainsOf(self): Array<Game.Recipe> {
    let list: Array<Game.Recipe> = []
    for (recipe of self.shown) {
      if (recipe.categoryID != self.camp) { list.push(recipe) }
    }
    return list
  }

  // The categories with recipes the lists let through but the camp's, which has a tab of its own, the favorites first.
  groupsOf(self): Array<Group> {
    let list: Array<Group> = []
    const starred = self.kept.favorites
    const byCategory = self.byCategory
    const hearts = members(self.mains, byCategory, FAVORITES, starred)
    if (hearts.length > 0) { list.push(self.groupOf(FAVORITES, Locale.FAVORITES, hearts)) }
    if (self.byReadiness) {
      for (readiness of READINESS) {
        const own = members(self.mains, byCategory, readiness, starred)
        if (own.length > 0) { list.push(self.groupOf(readiness, readinessName(readiness), own)) }
      }
      return list
    }
    for (category of Game.tradeSkill.categories) {
      if (category.parentID != nil && category.id != self.camp) {
        const own = members(self.mains, byCategory, category.id, starred)
        if (own.length > 0) { list.push(self.groupOf(category.id, category.name, own)) }
      }
    }
    return list
  }

  // The recipes shown by what waits for each, at the profession's skill.
  readinessGroups(self): Map<Integer, Array<Game.Recipe>> {
    const lists: Map<Integer, mut Array<Game.Recipe>> = {}
    const skill = self.profession?.rank ?? 0
    const most = self.profession?.max ?? 0
    for (recipe of self.shown) {
      const at = readinessOf(self.sources[recipe.id], skill, most)
      const list = lists[at]
      if (list == nil) { lists[at] = [recipe] } else { list.push(recipe) }
    }
    return lists
  }

  groupOf(self, id: Integer, name: String, recipes: Array<Game.Recipe>): Group {
    let makeable = 0
    for (recipe of recipes) {
      if (recipe.craftable > 0) { makeable += 1 }
    }
    return { id: id, name: name, total: recipes.length, makeable: makeable }
  }

  chosenCategoryOf(self): Integer {
    for (group of self.groups) {
      if (group.id == self.category) { return group.id }
    }
    const first = self.groups[1]
    if (first == nil) { return 0 }
    return first.id
  }

  tableRowsOf(self): Array<Game.Recipe> {
    let list: Array<Game.Recipe> = []
    for (recipe of self.mains) { list.push(recipe) }
    const column = self.list.values.tableColumn
    const descending = self.list.values.tableDescending
    const worth = self.worth
    list.sort((a, b) => tableBefore(column, descending, worth, a, b))
    return list
  }

  // Read again when a price may have moved; nothing while the table doesn't show or prices are off.
  worthOf(self): Map<Integer, Totals> {
    const prices = self.prices
    const worth: Map<Integer, Totals> = {}
    if (prices == nil || self.list.values.view != View.Table || self.onCamp) { return worth }
    _ = prices.revision
    for (recipe of self.mains) {
      const parts = partsOf(prices, Game.tradeSkill.reagents(recipe.id), 1)
      worth[recipe.id] = totalsOf(prices, parts, makesOf(recipe.id), yieldOf(recipe.id), 1)
    }
    return worth
  }

  listingOf(self): Array<Game.Recipe> {
    if (self.onCamp) { return self.recipes }
    return match (self.list.values.view) {
      View.Columns => self.recipes
      View.Categories => self.grouped()
      View.Table => self.tableRows
    }
  }

  // The recipes of every group, one group after another.
  grouped(self): Array<Game.Recipe> {
    let list: Array<Game.Recipe> = []
    for (group of self.groups) {
      for (recipe of members(self.mains, self.byCategory, group.id, self.kept.favorites)) { list.push(recipe) }
    }
    return list
  }

  chosenRecipeOf(self): Integer {
    for (recipe of self.listing) {
      if (recipe.id == self.recipe) { return recipe.id }
    }
    const first = self.listing[1]
    if (first == nil) { return 0 }
    return first.id
  }

  chosenOf(self): Game.Recipe | nil {
    for (recipe of self.listing) {
      if (recipe.id == self.chosenRecipe) { return recipe }
    }
    return nil
  }

  // The game opened another profession: what the player had chosen in it, if the window remembers that, is chosen
  // again.
  followOpen(mut self) {
    const open = Game.tradeSkill.open
    if (open != nil) {
      self.waiting = false
      const now = peek self.memory.values
      self.memory.write({ last: open, ..now })
    }
    if (open != nil && open != self.skillLine) {
      self.skillLine = open
      self.texts = {}
      self.category = 0
      self.recipe = 0
      self.page = self.pageAt(Page.Recipes)
      self.menuFor = 0
      self.note = ""
      const seen = (peek self.memory.values).seen[open]
      if (seen != nil && (peek self.settings.values).remember) {
        self.category = seen.category
        self.recipe = seen.recipe
      }
    }
  }

  // A tab opens its profession through the game, in the click's own call: the client takes it from nothing
  // else. The tab shows picked once the game has opened it, with its lists.
  onTab(mut self, index: Integer) {
    const picked = (peek Game.professions.list)[index]
    if (picked != nil && picked.skillLine != peek Game.tradeSkill.open) {
      Game.tradeSkill.show(picked.skillLine)
    }
  }

  // Another page of the profession: nothing in it is chosen yet, unless a recipe opened from elsewhere chose it.
  onPage(mut self) {
    if (!self.opening) { self.recipe = 0 }
    self.note = ""
    self.opening = false
  }

  // The game's own window came up with no profession open, on the player's key: the profession last open is
  // asked for in its place. Where the client doesn't take that (the key wasn't the player's own), the window
  // waits with its tabs.
  onShownEmpty(mut self) {
    if (peek Game.tradeSkill.open != nil) { return }
    self.waiting = true
    const last = (peek self.memory.values).last
    for (profession of peek Game.professions.list) {
      if (profession.skillLine == last) {
        Game.tradeSkill.show(last)
        return
      }
    }
  }

  // What the player chose in this profession, kept for the next time it is open.
  remember(mut self) {
    const open = peek Game.tradeSkill.open
    if (open == nil || !(peek self.settings.values).remember) { return }
    const now = peek self.memory.values
    let seen = now.seen.clone()
    seen[open] = Seen { category: peek self.category, recipe: peek self.recipe }
    self.memory.write({ seen: seen, ..now })
  }

  pickCategory(mut self, id: Integer) {
    self.category = id
    self.recipe = 0
    self.menuFor = 0
    self.remember()
  }

  // A row of a list asked for something of a recipe.
  onAct(mut self, act: Act, id: Integer) {
    match (act) {
      Act.Pick => { self.pickRecipe(id) }
      Act.Menu => { self.menuFor = id }
      Act.Favorite => { self.starFavorite(id) }
      Act.Track => { self.starTracked(id) }
      Act.Make => { self.onMake(id) }
      Act.Close => { self.closeMenu(id) }
      Act.Link => { self.onLink(id) }
    }
  }

  pickRecipe(mut self, id: Integer) {
    self.recipe = id
    self.note = ""
    self.menuFor = 0
    self.remember()
  }

  closeMenu(mut self, id: Integer) {
    if (peek self.menuFor == id) { self.menuFor = 0 }
  }

  // The recipe's number added to a list, or taken off it where it is there; the oldest goes where the list is full.
  toggled(self, list: Array<Integer>, id: Integer): Array<Integer> {
    let out: Array<Integer> = []
    for (entry of list) {
      if (entry != id) { out.push(entry) }
    }
    if (out.length == list.length) {
      out.push(id)
      if (out.length > MOST_MARKED) { _ = out.remove(1) }
    }
    return out
  }

  starFavorite(mut self, id: Integer) {
    const now = peek self.memory.values
    self.memory.write({ favorites: self.toggled(now.favorites, id), ..now })
  }

  starTracked(mut self, id: Integer) {
    const now = peek self.memory.values
    self.memory.write({ tracked: self.toggled(now.tracked, id), ..now })
  }

  // The item the recipe makes put into the chat's line; a recipe that makes none has no link.
  onLink(mut self, id: Integer) {
    self.menuFor = 0
    const made = Game.recipeReader.schematic(id)?.makes
    if (made != nil) { Game.chat.link(made) }
  }

  // From the menu's click, as «Create» with all the bags make: the game takes making only from one. The menu's line
  // takes no click while the bags make none. The menu stands on a listed recipe of the open profession; the card's
  // note is empty where its run starts at once (nothing waits, so nothing was queued since a recipe was picked).
  onMake(mut self, id: Integer) {
    self.menuFor = 0
    const open = (peek Game.tradeSkill.open) ?? panic("the menu stands in the open profession's window")
    const recipe = (peek Game.tradeSkill.recipes).find(r => r.id == id) ?? panic("the menu stands on a listed recipe")
    if (self.crafting.add(open, id, recipe.name, recipe.craftable)) { self.note = Locale.QUEUED_AFTER }
  }

  // «Create», from the button's click, where the game takes making from: the recipe joins the queue, and its run
  // starts at once where nothing waits ahead of it; else the note says it waits.
  onCreate(mut self, count: Integer) {
    const recipe = self.chosen
    const open = peek Game.tradeSkill.open
    if (recipe == nil || open == nil) { return }
    self.note = self.crafting.add(open, recipe.id, recipe.name, count) ? Locale.QUEUED_AFTER : ""
  }

  // A line's stepper set its recipe's count.
  onQueueCount(mut self, recipe: Integer, count: Integer) { self.crafting.recount(recipe, count) }

  // «Create next», in the player's click: the client starts a craft from nothing else.
  onNext(mut self) { self.onQueueAct(QueueAct.Next, 0) }

  // A line of the queue asked for something, or «Create next» the next run.
  onQueueAct(mut self, act: QueueAct, id: Integer) {
    match (act) {
      QueueAct.Drop => { self.crafting.recount(id, 0) }
      QueueAct.Open => { self.openRecipe(id) }
      QueueAct.Next => { self.crafting.next() }
    }
  }

  // What the open profession's queue is doing, or why it waits for the player's click; while a run goes, what it
  // makes (the client makes one run at a time).
  queueStatusOf(self): String {
    const first = self.queued[1]
    if (first == nil) { return "" }
    if (self.crafting.running) {
      const making = self.crafting.making
      const line = self.crafting.lines.find(entry => entry.recipe == making)
      return Locale.QUEUE_MAKING.format(line?.name ?? first.name, self.crafting.left)
    }
    return match (self.crafting.pauseOf(Game.tradeSkill.open)) {
      Pause.Interrupted => Locale.PAUSE_INTERRUPTED
      Pause.Failed => Locale.PAUSE_FAILED
      Pause.Combat => Locale.PAUSE_COMBAT
      Pause.Missing => Locale.PAUSE_MISSING.format(first.name)
      Pause.None => Locale.QUEUE_NEXT.format(first.name, first.count)
    }
  }

  // A run ended: where the window was closed during it, the profession closes now (and its closing shows the window
  // again for the next one opened).
  runEnded(mut self, running: Boolean) {
    if (running || !peek self.hidden) { return }
    Game.tradeSkill.close()
  }

  // A recipe opened from elsewhere: the recipes' tab (the camp's for one of the camp), its category and it chosen.
  openRecipe(mut self, id: Integer) {
    const recipe = (peek Game.tradeSkill.recipes).find(r => r.id == id)
    if (recipe == nil) { return }
    const hasCamp = (peek self.pageKinds).any(k => k == Page.Camp)
    const inCamp = hasCamp && recipe.categoryID == peek self.camp
    const page = self.pageAt(inCamp ? Page.Camp : recipe.learned ? Page.Recipes : Page.Unlearned)
    self.opening = page != peek self.page
    self.page = page
    // One the filter leaves out is shown: the filter lets every way through.
    const source = (peek self.sources)[id]
    if (!recipe.learned && source != nil && !self.learnedFromShown(source)) { self.filter = {} }
    const grouped = !recipe.learned && (peek self.list.values).grouping == Grouping.Readiness
    const profession = peek self.profession
    self.category = grouped ? readinessOf(source, profession?.rank ?? 0, profession?.max ?? 0) : recipe.categoryID
    self.pickRecipe(id)
  }

  // The settings window, at this module's page.
  onSettings(self) { Ordaen.toggleSettings(Runtime.Addon.of(self)) }

  // Closing the window (the close button, Escape) closes the profession, which hides it; while a run goes it only
  // hides it, and the profession closes once the run ends.
  onClose(mut self) {
    self.waiting = false
    if (peek self.crafting.running) {
      self.hidden = true
      return
    }
    Game.tradeSkill.close()
  }

  public render(self): Template {
    return $ltml {
      // The game's windows stand away whenever they exist, out of the game's window manager (see `holdsTrainer`).
      <frame $if={Game.frames.Professions != nil} of={Game.frames.Professions} opacity={0} away={true} />
      <frame $if={self.holdsTrainer} of={Game.frames.Trainer} opacity={0} away={true} />
      <$if={self.atTrainer}>
        <TrainerWindow services={self.services} declared={mut self.trainerWindow} list={mut self.trainerList} ignored={mut self.ignored}
                       tabSpec={TRAINER_TAB} noun={Locale.COLUMN_RECIPE} trade={true} @settings={self.onSettings} />
      </>
      <$if={self.isOpen}>
        <Window $if={self.drawn} tabs={self.tabs} selected={mut self.tab} asks={true} declared={mut self.window} withSettings={true}
                footer={self.footer} @close={self.onClose} @picked={self.onTab} @settings={self.onSettings}>
          <box $if={!self.hasOpen} xAlign={Align.Center} yAlign={Align.Center}>
            <text value={Locale.PICK} textColor={Style.DIM} />
          </box>
          <box $else rows={BODY}>
            <PageTabs tabs={self.pageNames} selected={mut self.page}>
              <box columns={self.bandColumns} gap={4sp} yAlign={Align.Center}>
                <BandBar rank={self.profession?.rank ?? 0} most={self.profession?.max ?? 0} />
                <PushButton $if={self.hasTrack} label={self.trackName} width={TRACK_WIDTH} action={self.trackAction} />
              </box>
            </PageTabs>
            <box rows={FILL} padding={self.pageRoom}>
              <QueuePage $if={self.queueShown} queued={self.queued} prices={self.prices} @act={self.onQueueAct}
                         @counted={self.onQueueCount} @shop={self.onShop} />
              <OverviewPage $elseif={self.overviewShown} profession={self.profession} thresholds={self.thresholds}
                            kept={self.kept} taught={self.taught} @pick={self.openRecipe} />
              <WorthPage $elseif={self.worthShown} book={self.written} prices={self.prices} />
              // The recipes, from the band to the window's bottom and side to side: the toolbar over the lists on the
              // wood, and the recipe beside both, the full height, on the quest scroll's paper. The categories stand on
              // the wood, parted by a groove from the recipes on the wood stained dark: a chosen category takes the
              // recipes' surface, a tab cut into the groove; a chosen recipe a plain light (`TabItem`).
              <box $else columns={GRID} rows={FILL}>
                <box rows={TOOLED} width={Style.LISTS_BOUNDS}>
                  <box padding={TOOL_ROOM}>
                    <Toolbar search={mut self.search} placeholder={Locale.SEARCH}>
                      <FilterButton values={mut self.filter} start={FILTER_START} groups={FILTERS} />
                      <ToolPick $if={!self.isTable && !self.byReadiness} value={mut self.list.values.sort} choices={SORTS}
                                icon={Ordaen.art.ctl.tool.sort} title={Locale.SORT} />
                      <ToolPick $if={self.unlearnedShown && !self.isTable} value={mut self.list.values.grouping} choices={GROUPINGS}
                                icon={Ordaen.art.ctl.tool.list} title={Locale.GROUP} />
                      <ToolPick $if={!self.onCamp} value={mut self.list.values.view} choices={VIEWS} icon={Ordaen.art.ctl.tool.columns}
                                title={Locale.VIEW} />
                    </Toolbar>
                  </box>
                  <SideList $if={self.onCamp} surface={Style.RECIPES} room={Style.RECIPES_ROOM}>
                    <RecipeRow $for={index, recipe of self.recipes} recipe={recipe} index={index}
                               chosen={self.chosenRecipe} kept={self.kept} menuFor={self.menuFor}
                               @act={self.onAct} />
                  </SideList>
                  <box $elseif={self.inColumns} columns={LISTS} rows={FILL}>
                    <SideList width={Style.CATEGORIES_BOUNDS} groove={true}>
                      <CategoryRow $for={index, group of self.groups} group={group} index={index}
                                   chosen={self.chosenCategory} @pick={self.pickCategory} />
                    </SideList>
                    <SideList width={Style.RECIPES_BOUNDS} surface={Style.RECIPES} room={Style.RECIPES_ROOM}>
                      <RecipeRow $for={index, recipe of self.recipes} recipe={recipe} index={index}
                                 chosen={self.chosenRecipe} kept={self.kept} menuFor={self.menuFor}
                                 @act={self.onAct} />
                    </SideList>
                  </box>
                  <SideList $elseif={self.inGroups} surface={Style.RECIPES} room={Style.RECIPES_ROOM}>
                    <CategoryGroup $for={group of self.groups} $key={group.id} group={group} shown={self.mains}
                                   byCategory={self.byCategory}
                                   chosen={self.chosenRecipe} kept={self.kept} menuFor={self.menuFor}
                                   @act={self.onAct} />
                  </SideList>
                  <box $else rows={FILL}>
                    <Table $if={self.priced} columns={PRICED_COLUMNS} sorted={mut self.list.values.tableColumn}
                           descending={mut self.list.values.tableDescending}>
                      <RecipeTableRow $for={recipe of self.tableRows} recipe={recipe}
                                      tracks={self.tracks} chosen={self.chosenRecipe} kept={self.kept}
                                      menuFor={self.menuFor} worth={self.worth} priced={true} @act={self.onAct} />
                    </Table>
                    <Table $else columns={COLUMNS} sorted={mut self.list.values.tableColumn} descending={mut self.list.values.tableDescending}>
                      <RecipeTableRow $for={recipe of self.tableRows} recipe={recipe}
                                      tracks={self.tracks} chosen={self.chosenRecipe} kept={self.kept}
                                      menuFor={self.menuFor} @act={self.onAct} />
                    </Table>
                  </box>
                </box>
                <RecipeDetails recipe={self.chosen} note={self.note} kept={self.kept} prices={self.prices}
                               count={mut self.count}
                               mode={mut self.makeMode} profession={self.profession} yellow={self.chosenYellow}
                               grey={self.chosenGrey} sources={self.sources} @act={self.onAct} @create={self.onCreate} />
              </box>
            </box>
          </box>
        </Window>
      </>
    }
  }
}
