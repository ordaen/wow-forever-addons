// The professions window with a stand-in game: the profession the game has open, its categories and recipes, the
// search, the chosen recipe and making it.
import Client from "$client"
import Game from "$game"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Professions from "OrdaenProfessions"

// The screen Ordaen draws its modules on.
const PAGE: Test.Page = { left: 20, top: 20, width: 200, height: 100, screen: true }

// What the game sends when it opens a profession.
function recipe(
  id: Integer, name: String, category: Integer, difficulty: Game.Difficulty, craftable: Integer, learned: Boolean,
): Game.Recipe {
  return {
    id: id, name: name, icon: "Interface/Icons/INV_Misc_Note_01", categoryID: category, learned: learned, difficulty: difficulty,
    craftable: craftable,
  }
}

// Tailoring as the game opens it: its categories, its recipes, and what it says of a recipe.
function tailoringCategories(): Array<Game.Category> {
  return [
    { id: 1, name: "Tailoring" },
    { id: 10, name: "Resting at camp", parentID: 1 },
    { id: 11, name: "Cloth armour", parentID: 1 },
    { id: 12, name: "Bags", parentID: 1 },
    { id: 13, name: "Nothing known here", parentID: 1 },
  ]
}

function tailoringRecipes(): Array<Game.Recipe> {
  return [
    recipe(100, "Linen Bandage", 10, Game.Difficulty.Rarely, 4, true),
    recipe(110, "Linen Cloak", 11, Game.Difficulty.Always, 1, true),
    recipe(111, "Brown Linen Vest", 11, Game.Difficulty.Usually, 0, true),
    recipe(112, "Woolen Cape", 11, Game.Difficulty.Never, 0, false),
    recipe(120, "Linen Bag", 12, Game.Difficulty.Usually, 2, true),
    recipe(121, "Woolen Bag", 12, Game.Difficulty.Always, 0, true),
  ]
}

function description(id: Integer): String {
  return id == 110 ? "A plain cloak of linen." : id == 120 ? "Holds six things." : ""
}

function requirements(id: Integer): Array<Game.Requirement> {
  if (id == 110) { return [{ name: "Sewing kit", met: true }, { name: "Loom", met: false }] }
  return []
}

function reagents(id: Integer): Array<Game.Reagent> {
  if (id == 110) {
    return [
      { name: "Bolt of Linen Cloth", icon: "Interface/Icons/INV_Fabric_Linen_01", have: 3, need: 1 },
      { name: "Coarse Thread", icon: "Interface/Icons/INV_Misc_Thread_01", have: 0, need: 1 },
    ]
  }
  if (id == 120) { return [{ name: "Bolt of Linen Cloth", icon: "Interface/Icons/INV_Fabric_Linen_01", have: 6, need: 3 }] }
  return []
}

// Blacksmithing has no camp recipes: the camp's category stands first all the same, and has no tab.
function blacksmithingCategories(): Array<Game.Category> {
  return [
    { id: 2, name: "Blacksmithing" },
    { id: 20, name: "Resting at camp", parentID: 2 },
    { id: 21, name: "Weapons", parentID: 2 },
  ]
}

function show(title: String, own: any Client.Frame) {
  Test.shot(title)
  let left = (own.GetLeft() ?? 0).floor()
  let top = (Client.GetScreenHeight() - (own.GetTop() ?? 0)).floor()
  Test.note(`the game's own window: at ${left},${top}, opacity ${own.GetAlpha()}`)
  Test.note("")
}

// A click, and what it changed drawn.
function click(at: Test.Point) {
  Test.click(at, nil)
  Test.flush()
}

function isIcon(file: String | Integer): Boolean {
  if (file is String) { return file.match("^icons/") != nil }
  return file == 136249
}

test "loaded by Ordaen, the module's root is made and is among Ordaen's modules" {
  Test.flush()
  const ordaen = Ordaen
  let found = 0
  for (entry of ordaen.modules) {
    if (entry.title == "Ordaen Professions") { found += 1 }
  }
  Test.expect(found == 1)
}

test "the professions window: the open profession, its lists, the search, a recipe made" {
  // The game's own professions window: ours shows in its place.
  let ui = Client.C_UI.GetUIParent()
  let own = Client.CreateFrame("Frame", "ProfessionsFrame", ui, nil)
  own.SetSize(400, 500)
  own.SetPoint("TOPLEFT", ui, "TOPLEFT", 16, -116)
  Game.frames.Professions = own
  Game.professions.list = [
    // The game gives an icon as its file's number, or as its path.
    { skillLine: 197, name: "Tailoring", icon: 136249, rank: 31, max: 75, kind: Game.ProfessionKind.Crafting },
    { skillLine: 182, name: "Herbalism", icon: "Interface/Icons/Trade_Herbalism", rank: 12, max: 75, kind: Game.ProfessionKind.Gathering },
    {
      skillLine: 164, name: "Blacksmithing", icon: "Interface/Icons/Trade_BlackSmithing", rank: 120, max: 150,
      kind: Game.ProfessionKind.Crafting,
    },
  ]

  // The module's root, made as the addon loaded and drawn by Ordaen on the screen, which the page is: a second one
  // would hear the game as well, and ask it twice.
  Test.mount(nil, PAGE)
  show("mounted: no profession is open, nothing is drawn", own)

  Game.tradeSkill.shownEmpty.emit()
  show("the game's own window came up with no profession open: ours stands in its place, its tabs to choose from", own)

  Game.tradeSkill.categories = tailoringCategories()
  Game.tradeSkill.recipes = tailoringRecipes()
  Game.tradeSkill.description = description
  Game.tradeSkill.requirements = requirements
  Game.tradeSkill.reagents = reagents
  Game.tradeSkill.open = 197
  show("the game opened Tailoring: its tab picked, its skill, its first category's recipes, the first recipe's details", own)

  // Every icon is drawn without the rim the client's icons carry: a file by its number as one by its path.
  let icons = 0
  let whole = 0
  for (texture of Test.drawn()) {
    if (isIcon(texture.file)) {
      icons += 1
      if (texture.left == 0 && texture.right == 1) { whole += 1 }
    }
  }
  Test.note(`icons drawn: ${icons > 0 ? "some" : "none"}; with their own rim left on: ${whole}`)

  // With the cursor over the window its corner's buttons show: the skill bar ends before them.
  Test.moveTo(Test.holding("Bags", nil))
  Test.flush()
  const ordaen = Ordaen
  let bar = Test.edges(ordaen.lookArt.xpFill, 2)
  let corner = Test.edges(ordaen.art.ctl.cornerClose, 2)
  Test.note("the skill bar ends %d before the corner's buttons".format((corner.left - bar.right + 0.5).floor()))
  Test.moveTo({ x: -10, y: -10 })
  Test.flush()

  click(Test.holding("Bags", nil))
  show("«Bags» picked: its recipes, the first of them chosen", own)

  click(Test.holding("Woolen Bag", nil))
  show("a recipe picked that the bags can't make: Create is disabled", own)

  click(Test.holding("Cloth armour", nil))
  click(Test.field(nil))
  Test.type("LINEN")
  show("back in «Cloth armour», «LINEN» typed into the search: the recipes with it in their names, in any case", own)

  Test.erase(5)
  Test.flush()
  click(Test.holding("+", nil))
  click(Test.holding("+", nil))
  click(Test.holding("Create", nil))
  show("the search emptied, + clicked twice and Create: three asked for, the one the bags can make is made", own)

  click(Test.holding("Camp", nil))
  show("the profession's «Camp» tab: the camp's recipes in one column", own)

  click(Test.holding("Blacksmithing", nil))
  show("the Blacksmithing tab clicked: it shows picked, and the game is asked to open it", own)

  Game.tradeSkill.categories = blacksmithingCategories()
  Game.tradeSkill.recipes = [recipe(200, "Copper Mace", 21, Game.Difficulty.Never, 0, true)]
  Game.tradeSkill.open = 164
  show("the game opened Blacksmithing: its lists, back on «Recipes» with no «Camp» tab, its one recipe", own)

  Test.key(Test.Key.Escape)
  show("Escape: the game is asked to close the profession", own)

  // The game hides its own window as the profession closes: given back, it stays hidden. Shown again, it would
  // come up with no profession open, and the first profession would be opened in its place.
  own.Hide()
  Game.tradeSkill.open = nil
  show("the game closed it: our window is gone, the game's own stands where it stood", own)
  Test.note(`the game's own window shows: ${own.IsShown()}`)

  // The player's key brings the game's own window up again with no profession open: the one last open is asked
  // for, in the key's own call.
  own.Show()
  Test.inKey((): nil => Game.tradeSkill.shownEmpty.emit())
  show("the game's own window came up again on the player's key: the profession last open is asked for", own)

  (Runtime.Addon.of(Professions) ?? panic("the module is installed")).disable()
  Test.expect(Test.blank())
}
