// A recipe's right-click menu, the library's `Menu` under the row that was clicked: «Link in chat» (the item the
// recipe makes; dim for one that makes none), «Create [N]» (the ones the bags can make), then after a rule the recipe's
// two switches. It says which `Act` the line clicked is and which recipe it is of; the window does it.
import Game from "$game"
import { Component, Menu, MenuEntry } from "Ordaen"
import Locale from "@/locales"
import { Act, has, Kept } from "@/view"

// What each line asks, by its place in the menu.
const ACTS: Array<Act> = [Act.Link, Act.Make, Act.Favorite, Act.Track]

public class RecipeMenu implements Component {
  public act: Event<(Act, Integer)> = new Event()

  derived entries: Array<MenuEntry> = self.entriesOf()

  recipe: Signal<Game.Recipe>
  kept: Signal<Kept>
  constructor(
    recipe: Signal<Game.Recipe>,
    kept: Signal<Kept>,
  ) {
    self.recipe = recipe
    self.kept = kept
  }

  entriesOf(self): Array<MenuEntry> {
    const schematic = Game.recipeReader.schematic(self.recipe.id)
    return [
      { label: Locale.MENU_LINK, disabled: schematic == nil || schematic.makes == nil },
      { label: Locale.MENU_CREATE.format(self.recipe.craftable), disabled: self.recipe.craftable == 0 },
      { label: Locale.FAVORITE, on: has(self.kept.favorites, self.recipe.id), group: true },
      { label: Locale.TRACK, on: has(self.kept.tracked, self.recipe.id), disabled: !self.recipe.learned },
    ]
  }

  onPick(self, index: Integer) {
    self.act.emit(ACTS[index] ?? panic("a menu line the recipe's menu doesn't have"), self.recipe.id)
  }

  onClose(self) { self.act.emit(Act.Close, self.recipe.id) }

  public render(self): Template {
    return $ltml {
      <Menu entries={self.entries} @pick={self.onPick} @close={self.onClose} />
    }
  }
}
