// TabItem: an item of a list that stands edge to edge with the section it selects for (the categories beside the
// recipes, the recipes beside the recipe), drawn as a tab into it: the selected one takes that section's surface
// (`into`), so it reads as part of it; the others stand on their own list's. Where its list is parted from the section
// by a groove (`groove`), the selected one carries the groove along its top and bottom, a tab cut into it. A faint rule
// above every item but the first; a light under the cursor. A click of either button reports `pick` (a right-click
// opens the item's menu); the cursor coming onto it reports `enter` with its frame, a list's row a tooltip stands beside.
//
// A prototype of the professions window's design: Ordaen's `SelectItem` takes the same arguments but `into`, so it
// can become an option of it once the design holds.
import Game from "$game"
import { Align, Art, ByInteractionState, Edges, Event, Frame, Line, MouseButton, Overflow, Position, Side, Track } from "$ltml"
import { Component } from "Ordaen"
import Style from "@/style"

const CLEAR: Color = Color::hex("#00000000")
const SHADE: ByInteractionState<Color> = { default: CLEAR, hover: Color::hex("#d6a56b1f"), focus: Color::hex("#d6a56b1f") }
const RULE: Line = { width: 1.171875dp, color: Color::hex("#d6a56b14"), sides: [Side::Top] }
const ONE: Array<Track> = [{ fr: 1 }]

public class TabItem implements Component {
  public pick: Event<MouseButton> = new Event()
  public enter: Event<any Frame> = new Event()

  derived background: Art | Color | ByInteractionState<Color> = self.selected ? self.into.art : SHADE
  derived tint: Color | nil = self.selected ? self.into.tint : nil
  derived rule: Line | nil = self.first ? nil : RULE
  derived grooved: Boolean = self.selected && self.groove

  selected: Signal<Boolean>
  into: Signal<Style::Surface>
  groove: Signal<Boolean>
  first: Signal<Boolean>
  columns: Signal<Array<Track>>
  padding: Signal<Edges>
  constructor(
    selected: Signal<Boolean>,
    // The surface of the section the item selects for: the selected one's.
    into: Signal<Style::Surface>,
    // Its list is parted from the section by a groove.
    groove: Signal<Boolean> = false,
    // The list's first item: no rule above it.
    first: Signal<Boolean> = false,
    columns: Signal<Array<Track>> = ONE,
    padding: Signal<Edges>
  ) {
    self.selected = selected
    self.into = into
    self.groove = groove
    self.first = first
    self.columns = columns
    self.padding = padding
  }

  onClick(mut self, click: Event::Press) { self.pick.emit(click.button) }
  onKey(mut self) { self.pick.emit(.Left) }
  onEnter(mut self, frame: any Frame) {
    Game::tooltip.rowAt(frame)
    self.enter.emit(frame)
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} gap={2.5sp} padding={self.padding} yAlign={Align::Center} border={self.rule}
           background={self.background} tint={self.tint} overflow={Overflow::Hidden} @pointerPress={self.onClick} @keyPress(.Enter)={self.onKey}
           @keyPress(.Space)={self.onKey} @pointerEnter={self.onEnter}>
        <$if={self.grooved}>
          <box position={Position::Absolute} left={0ui} right={0ui} top={0ui} height={Style::GROOVE} background={Style::GROOVE_DARK} />
          <box position={Position::Absolute} left={0ui} right={0ui} top={Style::GROOVE} height={Style::GROOVE}
               background={Style::GROOVE_LIGHT} />
          <box position={Position::Absolute} left={0ui} right={0ui} bottom={Style::GROOVE} height={Style::GROOVE}
               background={Style::GROOVE_DARK} />
          <box position={Position::Absolute} left={0ui} right={0ui} bottom={0ui} height={Style::GROOVE}
               background={Style::GROOVE_LIGHT} />
        </>
        <slot />
      </box>
    }
  }
}
