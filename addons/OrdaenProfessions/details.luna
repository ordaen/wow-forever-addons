// The chosen recipe, beside the lists the window's full height, on the window's wood behind a divider at its left, in
// one scroll: its icon in a slot and its name, with what making it does for the skill in its difficulty's colour
// («Not learned» while it isn't), the made item's description. A learned recipe: what the work needs besides reagents
// (red while missing), the reagents with their prices and totals, what is left to buy beside «To the shopping list»,
// its switches; under the scroll its make row (`MakeRow`: the mode, the count, «Create») and what became of the last
// «Create». A recipe not learned: «Where to learn» (each place a row, `LearnPlaceRow`, then what learning it asks)
// and «Prices & costs»: nothing of making it here (its tools, the shopping list, the switches).
import Game from "$game"
import { Align, Art, Edges, Line, Overflow, Scrollbar, Side, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, Component, ItemButton, Money, PushButton, SECONDARY_TEXT, Section, TITLE_TEXT, WINDOW_ROOM } from "Ordaen"
import type { PriceSource } from "OrdaenAuction"
import { PartPrice, Totals, partsOf, totalsOf, yieldOf } from "@/cost"
import { Flag } from "@/flag"
import { LearnPlaceRow } from "@/learnPlaces"
import Locale from "@/locales"
import { MakeRow } from "@/make"
import { PriceTable, PricesAge } from "@/priceRows"
import { ReagentRow } from "@/rows"
import { LearnPlace, RecipeSource, asksOf, placesOf, sideOfPlayer } from "@/sources"
import { Source, SourceTotals, sourceTotalsOf } from "@/split"
import Style from "@/style"
import { Act, Kept, MakeMode, has } from "@/view"

const NOTE: Color = Color.hex("#c8b48a")
const SWITCHES: Line = { width: 1.171875dp, color: Style.LINE, sides: [Side.Top] }
// From the band down to the window's bottom line: the room inside, the window's at the right.
const DETAILS_ROOM: Edges = { top: 5sp, right: WINDOW_ROOM, bottom: 5sp, left: 5sp }
const SWITCHES_PAD: Edges = { top: 3sp }
const FLAGS: Array<Track> = [{ fr: 1 }, { fr: 1 }]
// The scroll, the make row, the note.
const PANEL: Array<Track> = [{ fr: 1 }, "max-content", "max-content"]
const SHOPPING: Array<Track> = [{ fr: 1 }, "max-content", "max-content"]
const NO_TOTALS: Totals = {
  cost: nil, toBuy: nil, sellable: false, sale: nil, listed: nil, cut: 0, profit: nil, oldest: nil, priced: false
}
const SLOT = 60.9375dp
const HEAD: Array<Track> = [SLOT, { fr: 1 }]
const NOTHING: Game.Recipe = {
  id: 0, name: "", icon: "Interface/Icons/INV_Misc_QuestionMark", categoryID: 0, learned: false, difficulty: Game.Difficulty.Never, craftable: 0
}

public class RecipeDetails implements Component {
  // A switch flipped: the recipe's number.
  public act: Event<(Act, Integer)> = new Event()
  // «To the shopping list»: what the count lacks, for the recipe's number and the count.
  public shop: Event<(Integer, Integer)> = new Event()
  // A place it is learned at clicked: its quest's page, its vendor on the map.
  public open: Event<LearnPlace> = new Event()
  // «Create» clicked, with how many.
  public create: Event<Integer> = new Event()

  derived has: Boolean = self.recipe != nil
  // The recipe shown: where none is chosen nothing is drawn, and this stands for it.
  derived shown: Game.Recipe = self.recipe ?? NOTHING
  derived icon: Art = self.shown.icon
  derived skill: String = self.skillOf()
  derived skillColor: Color = self.shown.learned ? Style.difficultyColor(self.shown.difficulty) : Style.RED
  derived description: String = Game.tradeSkill.description(self.shown.id)
  derived needs: String = self.needsOf()
  derived learned: Boolean = self.shown.learned
  derived source: RecipeSource | nil = self.learned ? nil : self.sources[self.shown.id]
  derived places: Array<LearnPlace> = self.placesOf()
  derived asks: String = self.asksOf()
  derived asked: Boolean = self.asks != ""
  // What the count lacks, at its prices: none where a lacking part has no price.
  derived toBuy: Integer | nil = self.totals.toBuy
  derived lacking: Boolean = self.parts.any(part => part.have < part.need) || self.reagents.any(r => r.have < r.need * self.pricedCount)
  derived shoppable: Boolean = self.learned && self.priced && self.lacking
  derived reagents: Array<Game.Reagent> = Game.tradeSkill.reagents(self.shown.id)
  // The item it makes, which the icon is the slot of; none for what makes no item (an enchant).
  derived made: Integer | nil = self.madeOf()
  derived hasItem: Boolean = self.made != nil
  derived favorite: Boolean = has(self.kept.favorites, self.shown.id)
  derived tracked: Boolean = has(self.kept.tracked, self.shown.id)
  derived cannotTrack: Boolean = !self.shown.learned
  derived noted: Boolean = self.note != ""
  // Ordaen Auction's prices, while they are shown: each reagent's for the count the make row says, and the totals.
  derived priced: Boolean = self.prices != nil
  derived pricedCount: Integer = self.pricedCountOf()
  derived parts: Array<PartPrice> = self.partsOf()
  derived totals: Totals = self.totalsOf()
  // The totals at each source, side by side: the house's and a merchant's.
  derived merchantSale: Integer | nil = self.merchantSaleOf()
  derived auctionSide: SourceTotals = sourceTotalsOf(self.parts, Source.Auction, self.totals.sale)
  derived merchantSide: SourceTotals = sourceTotalsOf(self.parts, Source.Merchant, self.merchantSale)
  // Ordaen Auction is on but has no price for any part: nothing was scanned, or (where the house prices what it
  // makes) none of the reagents.
  derived noPrices: Boolean = self.priced && self.reagents.length > 0 && !self.totals.priced
  derived noPricesText: String = self.totals.sale == nil ? Locale.NO_PRICES : Locale.NO_REAGENT_PRICES

  recipe: Signal<Game.Recipe | nil>
  kept: Signal<Kept>
  note: Signal<String>
  prices: Signal<any PriceSource | nil>
  count: mut Signal<Integer>
  mode: mut Signal<MakeMode>
  profession: Signal<Game.Profession | nil>
  yellow: Signal<Integer | nil>
  grey: Signal<Integer | nil>
  sources: Signal<Map<Integer, RecipeSource>>
  constructor(
    recipe: Signal<Game.Recipe | nil>,
    kept: Signal<Kept>,
    // What became of the last «Create» that waits in the queue; empty for none.
    note: Signal<String>,
    // Ordaen Auction's prices while they are shown (it is on, and «Prices» is); none for none.
    prices: Signal<any PriceSource | nil>,
    // The make row's: how many, by which mode, of the profession open; where the recipe turns yellow and grey.
    count: mut Signal<Integer>,
    mode: mut Signal<MakeMode>,
    profession: Signal<Game.Profession | nil>,
    yellow: Signal<Integer | nil>,
    grey: Signal<Integer | nil>,
    // Where the recipes of the profession open are learned.
    sources: Signal<Map<Integer, RecipeSource>>
  ) {
    self.recipe = recipe
    self.kept = kept
    self.note = note
    self.prices = prices
    self.count = count
    self.mode = mode
    self.profession = profession
    self.yellow = yellow
    self.grey = grey
    self.sources = sources
  }

  onCreate(self, count: Integer) { self.create.emit(count) }
  placesOf(self): Array<LearnPlace> {
    const source = self.source
    return source == nil ? [] : placesOf(source, sideOfPlayer())
  }

  asksOf(self): String {
    const source = self.source
    return source == nil ? "" : asksOf(source).join("\n")
  }

  onShop(self) { self.shop.emit(self.shown.id, self.pricedCount) }
  onOpen(self, place: LearnPlace) { self.open.emit(place) }

  // How many the prices are for: the count by «Quantity» and «Raise skill», what the bags make by «All»; one at least.
  pricedCountOf(self): Integer {
    if (self.mode == MakeMode.All) { return self.shown.craftable.max(1) }
    return self.count.max(1)
  }

  // Read again when a price may have moved (`revision`).
  partsOf(self): Array<PartPrice> {
    const prices = self.prices
    if (prices == nil) { return [] }
    _ = prices.revision
    return partsOf(prices, self.reagents, self.pricedCount)
  }

  totalsOf(self): Totals {
    const prices = self.prices
    if (prices == nil) { return NO_TOTALS }
    return totalsOf(prices, self.parts, self.made, yieldOf(self.shown.id), self.pricedCount)
  }

  // What a merchant pays for what the count makes; none where merchants don't buy it, or nothing is made.
  merchantSaleOf(self): Integer | nil {
    const made = self.made
    if (made == nil) { return nil }
    const one = Game.items.sellPrice(made) ?? 0
    if (one <= 0) { return nil }
    return (one * yieldOf(self.shown.id) * self.pricedCount).floor()
  }

  madeOf(self): Integer | nil {
    const schematic = Game.recipeReader.schematic(self.shown.id)
    if (schematic == nil) { return nil }
    return schematic.makes
  }

  onFavorite(self) { self.act.emit(Act.Favorite, self.shown.id) }
  onTrack(self) { self.act.emit(Act.Track, self.shown.id) }

  skillOf(self): String {
    if (!self.shown.learned) { return Locale.NOT_LEARNED }
    match (self.shown.difficulty) {
      Game.Difficulty.Always => return Locale.DIFFICULTY_0
      Game.Difficulty.Usually => return Locale.DIFFICULTY_1
      Game.Difficulty.Rarely => return Locale.DIFFICULTY_2
      Game.Difficulty.Never => return Locale.DIFFICULTY_3
    }
  }

  // What the work needs, a line each, red while missing: «Needs: Blacksmith Hammer». Nothing for a recipe not learned,
  // which isn't made here.
  needsOf(self): String {
    if (!self.shown.learned) { return "" }
    const lines: Array<String> = []
    for (need of Game.tradeSkill.requirements(self.shown.id)) {
      const line = Locale.TOOLS + ": " + need.name
      lines.push(need.met ? line : "|cffff4040" + line + "|r")
    }
    return lines.join("\n")
  }

  public render(self): Template {
    return $ltml {
      <box rows={PANEL} gap={3sp} padding={DETAILS_ROOM} border={Ordaen.art.frame.tabIconLine}>
        <$if={self.has}>
          <box overflow={Overflow.Scroll} scrollbar={Scrollbar.Hover} gap={4sp}>
            <box columns={HEAD} gap={5sp} yAlign={Align.Center}>
              <ItemButton $if={self.hasItem} item={self.made} size={SLOT} dimmed={!self.learned} />
              <box $else width={SLOT} height={SLOT} border={Style.BRONZE} icon={self.icon} />
              <box gap={0.5sp}>
                <text value={self.shown.name} textSize={TITLE_TEXT} leading={.Title} textColor={BRIGHT_TEXT}
                      textShadow={Style.SHADOW} />
                <text value={self.skill} textSize={SECONDARY_TEXT} textColor={self.skillColor} />
              </box>
            </box>
            <text value={self.description} textSize={SECONDARY_TEXT} textColor={Style.INK} />
            <text $if={self.learned} value={self.needs} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
            <Section $else title={Locale.SECTION_LEARN}>
              <LearnPlaceRow $for={place of self.places} place={place} @open={self.onOpen} />
              <text $if={self.asked} value={self.asks} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
            </Section>
            <Section $if={self.priced} title={Locale.SECTION_PRICES}>
              <PriceTable parts={self.parts} auction={self.auctionSide} merchant={self.merchantSide} totals={self.totals} />
              <text $if={self.noPrices} value={self.noPricesText} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
              <PricesAge totals={self.totals} />
            </Section>
            <box $else>
              <ReagentRow $for={index, reagent of self.reagents} reagent={reagent} index={index} />
            </box>
            <box $if={self.shoppable} columns={SHOPPING} gap={3sp} yAlign={Align.Center}>
              <text value={Locale.TOTAL_TO_BUY} textColor={Style.DIM} />
              <Money $if={self.toBuy != nil} amount={self.toBuy ?? 0} />
              <text $else value={"—"} textColor={Style.DIM} />
              <PushButton label={Locale.TO_SHOPPING} width={210.9375dp} @click={self.onShop} />
            </box>
            <box $if={self.learned} columns={FLAGS} gap={6sp} padding={SWITCHES_PAD} border={SWITCHES}>
              <Flag label={Locale.FAVORITE} on={self.favorite} @flipped={self.onFavorite} />
              <Flag label={Locale.TRACK} on={self.tracked} @flipped={self.onTrack} />
            </box>
          </box>
          <MakeRow $if={self.learned} recipe={self.recipe} count={mut self.count} mode={mut self.mode}
                   profession={self.profession} yellow={self.yellow} grey={self.grey} @create={self.onCreate} />
          <box $else />
          <text $if={self.noted} value={self.note} textSize={SECONDARY_TEXT} textColor={NOTE} />
        </>
      </box>
    }
  }
}
