// The chosen recipe, beside the lists, on the game's dark marble with its own rim: its icon in a slot and its name
// in white, with what making it does for the skill in its difficulty's colour («Not learned» while it isn't); the
// made item's description; what the work needs besides reagents (red while missing); the reagents, one ruled row
// each, scrolling in what room is left; and at the bottom, under a rule, its switches and what became of the last
// «Create». The make row stands in the window's footer (`MakeRow`).
import Game from "$game"
import { Align, Art, Edges, Line, Overflow, Side, Track } from "$ltml"
import { Component, ItemButton, PX, space } from "Ordaen"
import root Ordaen from "Ordaen"
import { Flag } from "@/flag"
import Locale from "@/locales"
import { ReagentRow } from "@/rows"
import Style from "@/style"
import { Act, has, Kept } from "@/view"

const RIM: Line = { width: 1 * PX, color: Style.LINE }
const SWITCHES: Line = { width: 1 * PX, color: Style.LINE, sides: [Side.Top] }
const SWITCHES_PAD: Edges = { top: space(.Item) }
const FLAGS: Array<Track> = [{ fr: 1 }, { fr: 1 }]
// The head, the description, the needs, the reagents in the rest, the switches, the note.
const PANEL: Array<Track> = ["auto", "auto", "auto", { fr: 1 }, "auto", "auto"]
const NOTE: Color = Color.hex("#c8b48a")
const SLOT = 52 * PX
const HEAD: Array<Track> = [SLOT, { fr: 1 }]
const NOTHING: Game.Recipe = {
  id: 0, name: "", icon: "Interface/Icons/INV_Misc_QuestionMark", categoryID: 0, learned: false, difficulty: Game.Difficulty.Never, craftable: 0,
}

public class RecipeDetails implements Component {
  // A switch flipped: the recipe's number.
  public act: Event<(Act, Integer)> = new Event()

  derived has: Boolean = self.recipe != nil
  // The recipe shown: where none is chosen nothing is drawn, and this stands for it.
  derived shown: Game.Recipe = self.recipe ?? NOTHING
  derived icon: Art = self.shown.icon
  derived skill: String = self.skillOf()
  derived skillColor: Color = self.shown.learned ? Style.difficultyColor(self.shown.difficulty) : Style.RED
  derived description: String = Game.tradeSkill.description(self.shown.id)
  derived needs: String = self.needsOf()
  derived reagents: Array<Game.Reagent> = Game.tradeSkill.reagents(self.shown.id)
  // The item it makes, which the icon is the slot of; none for what makes no item (an enchant).
  derived made: Integer | nil = self.madeOf()
  derived hasItem: Boolean = self.made != nil
  derived favorite: Boolean = has(self.kept.favorites, self.shown.id)
  derived tracked: Boolean = has(self.kept.tracked, self.shown.id)
  derived cannotTrack: Boolean = !self.shown.learned
  derived noted: Boolean = self.note != ""

  recipe: Signal<Game.Recipe | nil>
  kept: Signal<Kept>
  note: Signal<String>
  constructor(
    recipe: Signal<Game.Recipe | nil>,
    kept: Signal<Kept>,
    // What became of the last «Create» that waits in the queue; empty for none.
    note: Signal<String>,
  ) {
    self.recipe = recipe
    self.kept = kept
    self.note = note
  }

  madeOf(self): Integer | nil {
    const schematic = Game.recipeReader.schematic(self.shown.id)
    if (schematic == nil) { return nil }
    return schematic.makes
  }

  onFavorite(self) { self.act.emit(Act.Favorite, self.shown.id) }
  onTrack(self) { self.act.emit(Act.Track, self.shown.id) }

  skillOf(self): String {
    if (!self.shown.learned) { return Locale.NOT_LEARNED }
    match (self.shown.difficulty) {
      Game.Difficulty.Always => return Locale.DIFFICULTY_0,
      Game.Difficulty.Usually => return Locale.DIFFICULTY_1,
      Game.Difficulty.Rarely => return Locale.DIFFICULTY_2,
      Game.Difficulty.Never => return Locale.DIFFICULTY_3,
    }
  }

  // What the work needs, a line each, red while missing: «Needs: Blacksmith Hammer».
  needsOf(self): String {
    let text = ""
    for (need of Game.tradeSkill.requirements(self.shown.id)) {
      let line = Locale.TOOLS + ": " + need.name
      if (!need.met) { line = "|cffff4040" + line + "|r" }
      if (text != "") { text = text + "\n" }
      text = text + line
    }
    return text
  }

  public render(self): Template {
    return $ltml {
      <box rows={PANEL} gap={space(.Item)} padding={space(.Panel)} border={RIM} background={Ordaen.art.window.marble}>
        <$if={self.has}>
          <box columns={HEAD} gap={space(.Panel)} yAlign={Align.Center}>
            <ItemButton $if={self.hasItem} item={self.made} size={SLOT} dimmed={!self.shown.learned} />
            <box $else width={SLOT} height={SLOT} border={Style.BRONZE} icon={self.icon} />
            <box gap={2 * PX}>
              <text value={self.shown.name} textSize={.Title} textColor={Style.WHITE}
                    textShadow={Style.SHADOW} />
              <text value={self.skill} textSize={.Secondary} textColor={self.skillColor} />
            </box>
          </box>
          <text value={self.description} textSize={.Secondary} textColor={Style.INK} />
          <text value={self.needs} textSize={.Secondary} textColor={Style.DIM} />
          <box overflow={Overflow.Scroll}>
            <ReagentRow $for={index, reagent of self.reagents} reagent={reagent} index={index} />
          </box>
          <box columns={FLAGS} gap={space(.Group)} padding={SWITCHES_PAD} border={SWITCHES}>
            <Flag label={Locale.FAVORITE} on={self.favorite} @flipped={self.onFavorite} />
            <Flag $if={self.shown.learned} label={Locale.TRACK} on={self.tracked} @flipped={self.onTrack} />
          </box>
          <text $if={self.noted} value={self.note} textSize={.Secondary} textColor={NOTE} />
        </>
      </box>
    }
  }
}
