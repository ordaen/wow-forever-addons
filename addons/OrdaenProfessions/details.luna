// The chosen recipe, beside the lists, on the game's dark marble with its own rim: its icon in a slot and its name
// in white, with what making it does for the skill in its difficulty's colour («Not learned» while it isn't); the
// made item's description; what the work needs besides reagents (red while missing); the reagents, one ruled row
// each, scrolling in what room is left; and at the bottom the make row: the count with − and +, and «Create».
import Game from "$game"
import { Align, Art, Line, Overflow, Track } from "$ltml"
import { Component, PushButton, PX } from "Ordaen"
import root Ordaen from "Ordaen"
import Locale from "@/locales"
import { ReagentRow } from "@/rows"
import Style from "@/style"

const RIM: Line = { width: 1 * PX, color: Style.LINE }
// The head, the description, the needs, the reagents in the rest, the make row.
const PANEL: Array<Track> = ["auto", "auto", "auto", { fr: 1 }, "auto"]
const SLOT = 52 * PX
const HEAD: Array<Track> = [SLOT, { fr: 1 }]
const MAKE: Array<Track> = ["auto", "auto", "auto", { fr: 1 }, "auto"]
const STEP = 30 * PX
const NOTHING: Game.Recipe = {
  id: 0, name: "", icon: "Interface/Icons/INV_Misc_QuestionMark", categoryID: 0, learned: false, difficulty: Game.Difficulty.Never, craftable: 0,
}

public class RecipeDetails implements Component {
  // «Create» clicked, with how many: making must start in the click.
  public create: Event<Integer> = new Event()

  derived has: Boolean = self.recipe != nil
  // The recipe shown: where none is chosen nothing is drawn, and this stands for it.
  derived shown: Game.Recipe = self.recipe ?? NOTHING
  derived icon: Art = self.shown.icon
  derived skill: String = self.skillOf()
  derived skillColor: Color = self.shown.learned ? Style.difficultyColor(self.shown.difficulty) : Style.RED
  derived description: String = Game.tradeSkill.description(self.shown.id)
  derived needs: String = self.needsOf()
  derived reagents: Array<Game.Reagent> = Game.tradeSkill.reagents(self.shown.id)
  derived cannot: Boolean = self.shown.craftable < 1

  recipe: Signal<Game.Recipe | nil>
  count: mut Signal<Integer>
  constructor(
    recipe: Signal<Game.Recipe | nil>,
    // How many to make.
    count: mut Signal<Integer>,
  ) {
    self.recipe = recipe
    self.count = count
  }

  skillOf(self): String {
    if (!self.shown.learned) { return Locale.NOT_LEARNED }
    match (self.shown.difficulty) {
      Game.Difficulty.Always => return Locale.DIFFICULTY_0,
      Game.Difficulty.Usually => return Locale.DIFFICULTY_1,
      Game.Difficulty.Rarely => return Locale.DIFFICULTY_2,
      Game.Difficulty.Never => return Locale.DIFFICULTY_3,
    }
  }

  // What the work needs, a line each, red while missing: «Needs: Blacksmith Hammer».
  needsOf(self): String {
    let text = ""
    for (need of Game.tradeSkill.requirements(self.shown.id)) {
      let line = Locale.TOOLS + ": " + need.name
      if (!need.met) { line = "|cffff4040" + line + "|r" }
      if (text != "") { text = text + "\n" }
      text = text + line
    }
    return text
  }

  less(mut self) { self.count = (1).max(self.count - 1) }
  more(mut self) { self.count += 1 }

  onCreate(mut self) {
    if (self.shown.craftable > 0) { self.create.emit(self.count.min(self.shown.craftable)) }
  }

  public render(self): Template {
    return $ltml {
      <box rows={PANEL} gap={8 * PX} padding={12 * PX} border={RIM} background={Ordaen.art.window.marble}
           overflow={Overflow.Hidden}>
        <$if={self.has}>
          <box columns={HEAD} gap={10 * PX} yAlign={Align.Center}>
            <box width={SLOT} height={SLOT} border={Style.BRONZE} icon={self.icon} />
            <box gap={2 * PX}>
              <text value={self.shown.name} textSize={Style.NAME} textColor={Style.WHITE}
                    textShadow={Style.SHADOW} />
              <text value={self.skill} textSize={Style.SMALL} textColor={self.skillColor} />
            </box>
          </box>
          <text value={self.description} textSize={Style.RECIPE_TEXT} textColor={Style.INK} />
          <text value={self.needs} textSize={Style.RECIPE_TEXT} textColor={Style.DIM} />
          <box overflow={Overflow.Scroll}>
            <ReagentRow $for={index, reagent of self.reagents} reagent={reagent} index={index} />
          </box>
          <box columns={MAKE} gap={8 * PX} yAlign={Align.Center}>
            <PushButton label={"-"} width={STEP} @click={self.less} />
            <text value={"%d"} arguments={[self.count]} textSize={Style.TEXT} textColor={Style.WHITE}
                  textFamily={Ordaen.lookArt?.fontNumbers} wrap={false} />
            <PushButton label={"+"} width={STEP} @click={self.more} />
            <box height={1} />
            <PushButton label={Locale.CREATE} width={140 * PX} disabled={self.cannot} @click={self.onCreate} />
          </box>
        </>
      </box>
    }
  }
}
