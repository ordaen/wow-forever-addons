// Pick: a choice of a few in the lists' tool row (the sort, the view): the bronze plate with the picked choice in gold
// and an arrow, its menu under it. The library's `Dropdown` is a setting's row with a label; this is the plate alone,
// as wide as it is told. Left-click opens the menu, a click on a choice picks it, a click anywhere else closes it.
import { Align, Art, Edges, Line, Position, Shadow, Stated } from "$ltml"
import root Ordaen from "Ordaen"
import { Choice, Component, PX } from "Ordaen"

const HEIGHT = 34 * PX
const TEXT = 14 * PX
const GOLD: Color = Color.hex("#f0c860")
const WHITE: Color = Color.hex("#ffffff")
const FACE_PAD: Edges = { right: 8 * PX, left: 12 * PX }
const ARROW_SHADOW: Shadow = { color: Color.hex("#14141fcc"), x: 1 * PX, y: 1 * PX }
const MENU_BACK: Color = Color.hex("#0a0806f7")
const MENU_EDGE: Line = { width: 1 * PX, color: Color.hex("#6c5535") }
const MENU_PAD: Edges = { top: 6 * PX, bottom: 6 * PX }
const ITEM_PAD: Edges = { top: 5 * PX, right: 14 * PX, bottom: 5 * PX, left: 30 * PX }
const CLEAR: Color = Color.hex("#00000000")
const LIGHT: Stated<Color> = { default: CLEAR, hover: Color.hex("#d6a56b2e") }

// One choice in the open menu: the radio mark, gold while it is the picked one.
public class PickItem<T: Unknown> implements Component {
  public pick: Event<T> = new Event()

  derived mark: Art = self.value == self.choice.value ? Ordaen.art.ctl.radioOn : Ordaen.art.ctl.radio

  const choice: Choice<T>
  value: Signal<T>
  constructor(
    choice: Choice<T>,
    value: Signal<T>,
  ) {
    self.choice = choice
    self.value = value
  }

  onClick(mut self) { self.pick.emit(self.choice.value) }

  public render(self): Template {
    return $ltml {
      <box padding={ITEM_PAD} background={LIGHT} @click={self.onClick}>
        <box position={Position.Absolute} left={10 * PX} top={9 * PX} width={11 * PX} height={11 * PX}
             background={self.mark} />
        <text value={self.choice.label} textColor={WHITE} textSize={TEXT} wrap={false} />
      </box>
    }
  }
}

public class Pick<T: Unknown> implements Component {
  state open = false
  derived shown: String = self.labelOf()
  derived menuWidth: Number = self.width + 40 * PX

  value: mut Signal<T>
  const choices: Array<Choice<T>>
  width: Signal<Number>
  constructor(
    value: mut Signal<T>,
    choices: Array<Choice<T>>,
    width: Signal<Number>,
  ) {
    self.value = value
    self.choices = choices
    self.width = width
  }

  labelOf(self): String {
    for (choice of self.choices) {
      if (choice.value == self.value) { return choice.label }
    }
    return ""
  }

  toggle(mut self) { self.open = !self.open }
  close(mut self) { self.open = false }

  onPick(mut self, value: T) {
    self.value = value
    self.open = false
  }

  public render(self): Template {
    return $ltml {
      <box width={self.width} height={HEIGHT}>
        <box position={Position.Absolute} left={0} top={0} width={self.width} height={HEIGHT} padding={FACE_PAD}
             columns={[{ fr: 1 }, 16 * PX]} gap={6 * PX} yAlign={Align.Center}
             background={Ordaen.art.ctl.button} @click={self.toggle}>
          <text value={self.shown} textColor={GOLD} textSize={TEXT} wrap={false} />
          <box width={16 * PX} height={16 * PX} background={Ordaen.art.ctl.dropdownArrow} shadow={ARROW_SHADOW} />
        </box>
        <box $if={self.open} position={Position.Absolute} left={0} top={38 * PX} width={self.menuWidth}
             zLevel={50} background={MENU_BACK} border={MENU_EDGE} padding={MENU_PAD} columns={1}
             @clickOutside={self.close}>
          <PickItem $for={choice of self.choices} choice={choice} value={self.value} @pick={self.onPick} />
        </box>
      </box>
    }
  }
}
