// The profession trainer's window as the player meets it: it opens at a profession's trainer (never at a class's) in
// place of the game's, lists what the trainer teaches as a table, leaves out what the search and the filter don't
// keep, shows the picked service's card, and «Learn» buys what can be learned now and nothing else.
import Client from "$client"
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import { TrainerList, TrainerShow, TrainerView } from "OrdaenTrainer"
import Locale from "@/locales"

const SCREEN: Test::Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const ROBE: FileId = 132659
const BOLT: FileId = 132889
const SHIRT: FileId = 135022

// What a tailoring trainer teaches a player of skill 60: a robe to learn now, bolts at a skill not reached, a shirt
// known.
function taught(): array<Game::TrainerService> {
  return [
    {
      index: 2, name: "Red Linen Robe", rank: "", icon: ROBE, status: .Available, level: 5, cost: 200,
      description: "A robe of red linen.", skill: 40
    },
    {
      index: 3, name: "Bolt of Woolen Cloth", rank: "", icon: BOLT, status: .Unavailable, level: 10, cost: 500,
      description: "Woolen cloth woven.", skill: 75
    },
    {
      index: 4, name: "Linen Shirt", rank: "", icon: SHIRT, status: .Learned, level: 1, cost: 50,
      description: "", skill: 1
    }
  ]
}

test "a profession's trainer opens our window in place of the game's, its services as a table; a class's never" {
  Game::trainer.teachesClass = (): boolean => true
  Client::IsTradeskillTrainer = (): boolean => false
  Game::trainer.services = (): array<Game::TrainerService> => taught()
  Test::mount(nil, SCREEN)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  // Spells shows its own window at a class trainer; ours, with its recipes, isn't there.
  Test::expect(!Test::page().window(Locale::COLUMN_RECIPE).shown())
  Game::trainer.open = false
  Game::trainer.teachesClass = (): boolean => false
  Client::IsTradeskillTrainer = (): boolean => true
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(Locale::TRAINER)
  // What is known is left out at first.
  Test::expect(window.text("Red Linen Robe").shown() && !window.text("Linen Shirt").shown())
  // The footer counts each kind by its label and its number: one to learn now, one not yet, one known.
  Test::expect(window.text(Locale::COLUMN_SKILL).shown() &&
      window.texts().join(" | ").contains("Available | 1 | Unavailable | 1 | Learned | 1"))
  window.input().type("bolt")
  Test::expect(!window.text("Red Linen Robe").shown() && window.text("Bolt of Woolen Cloth").shown())
  Game::trainer.open = false
  Test::expect(!Test::page().window(Locale::TRAINER).shown())
}

test "a trainer whose list fills after it shows, in the same frame, shows the list" {
  Game::trainer.teachesClass = (): boolean => false
  Client::IsTradeskillTrainer = (): boolean => true
  let filled = false
  Game::trainer.services = (): array<Game::TrainerService> => filled ? taught() : []
  Test::mount(nil, SCREEN)
  // TRAINER_SHOW with the list empty, then TRAINER_UPDATE with it filled, before a frame passes.
  Game::trainer.open = true
  Game::trainer.changed.emit()
  filled = true
  Game::trainer.changed.emit()
  Test::expect(Test::page().window(Locale::TRAINER).text("Red Linen Robe").shown())
}

// The trainer's window open on `taught()`, with 1000 copper; what the client was asked to buy is kept in `bought`.
function opened(bought: mut array<string>): Test::Part {
  Game::trainer.teachesClass = (): boolean => false
  Client::IsTradeskillTrainer = (): boolean => true
  Game::trainer.services = (): array<Game::TrainerService> => taught()
  Client::BuyTrainerService = (index: integer): nil => bought.push(string::of(index))
  Game::money.amount = 1000
  Test::mount(nil, SCREEN)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  return Test::page().window(Locale::TRAINER)
}

test "a double press on a service learns it where it can be learned now, and nothing where it can't" {
  const bought: array<string> = []
  const window = opened(bought)
  window.text("Bolt of Woolen Cloth").nth(1).click()
  window.text("Bolt of Woolen Cloth").nth(1).click()
  Test::expect(bought.length == 0)
  Test::pass(1)
  window.text("Red Linen Robe").nth(1).click()
  window.text("Red Linen Robe").nth(1).click()
  Test::expect(bought.join(", ") == "2")
  // It stays picked: the card shows it.
  Test::expect(window.text("A robe of red linen.").shown())
}

test "the footer is a band of marble under the list, the money on it" {
  const bought: array<string> = []
  const window = opened(bought)
  const band = Test::painted(Ordaen.art.window.marble, nil)
  const money = Test::holding("Your money", nil)
  const list = window.text("Red Linen Robe").rect()
  // The money stands in the band, under its line: a little below the band's middle.
  Test::expect(money.y > band.y && money.y - band.y < 8 && band.y > list.bottom && band.x < money.x)
}

test "a view kept before «Learned» started off loads with it off, its sort kept" {
  const kept: map<string, boolean> = { known: true, available: true }
  const old: map<string, unknown> = { filter: kept, sorted: 2 }
  const view = TrainerList::decode(old, { view: TrainerView::Table })
  Test::expect(view.shows[TrainerShow::Known] == false && view.sorted == 2)
}

test "a known service's card says so in place of its price and «Learn», its name in the title's own line" {
  const bought: array<string> = []
  const window = opened(bought)
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test::page().window("Reset").button(Locale::SHOW_KNOWN).click()
  window.button(Ordaen.art.ctl.tool.filter).click()
  window.text("Linen Shirt").click()
  Test::expect(window.text("Linen Shirt").count() == 2 && !window.button(Locale::TRAIN).shown())
  Test::expect(window.text(Locale::SHOW_KNOWN).count() >= 2)
  window.text("Red Linen Robe").click()
  Test::expect(window.button(Locale::TRAIN).shown())
}

test "a right-click's «Ignore» covers every rank of a service with «Ignored» until «Stop ignoring», kept for the character" {
  const bought: array<string> = []
  const window = opened(bought)
  window.text("Red Linen Robe").nth(1).rightClick()
  Test::page().text("Ignore").click()
  // Ignored: a plate over its row says so, a double press learns nothing, «Learn» is greyed, the footer counts it grey.
  Test::expect(window.text("Ignored").shown())
  window.text("Red Linen Robe").nth(1).click()
  window.text("Red Linen Robe").nth(1).click()
  window.button(Locale::TRAIN).click()
  Test::expect(bought.length == 0)
  Test::expect(window.texts().join(" | ").contains("Available | 0 | Unavailable | 1 | Learned | 1 | Ignored | 1 | Your money"))
  Test::expect(Game::saved.stored(.Character, "OrdaenProfessions:ignored") != nil)
  Test::pass(1)
  window.text("Red Linen Robe").nth(1).rightClick()
  Test::page().text("Stop ignoring").click()
  Test::expect(!window.text("Ignored").shown())
  window.button(Locale::TRAIN).click()
  Test::expect(bought.join(", ") == "2")
}

test "a service's menu leaves out what can't be done to it: «Learn» where it can't be learned now" {
  const bought: array<string> = []
  const window = opened(bought)
  // The card's own «Learn» stands all along: the menu adds none.
  const learns = Test::page().text("Learn").count()
  window.text("Bolt of Woolen Cloth").nth(1).rightClick()
  Test::expect(Test::page().text("Learn").count() == learns && Test::page().text("Ignore").shown())
}

test "a service that can be learned now has «Learn» in its menu" {
  const bought: array<string> = []
  const window = opened(bought)
  const learns = Test::page().text("Learn").count()
  window.text("Red Linen Robe").nth(1).rightClick()
  Test::expect(Test::page().text("Learn").count() == learns + 1 && Test::page().text("Ignore").shown())
}

test "a right-click's «Link in chat» puts the recipe's link in the chat, and the game's tooltip shows anywhere on its row" {
  const bought: array<string> = []
  Client::GetTrainerServiceItemLink = (index: number): string | nil => index == 2 ? "|cff1eff00|Hitem:2569::::|h[Red Linen Robe]|h|r" : nil
  const linked: array<integer> = []
  Game::chat.link = (id: integer): nil => linked.push(id)
  const window = opened(bought)
  window.text("Red Linen Robe").rightClick()
  Test::page().text("Link in chat").click()
  Test::expect(linked.length == 1 && linked[1] == 2569)
  _ = Test::requests()
  window.text("Red Linen Robe").hover()
  Test::expect(Test::requests().any(asked => asked.contains("showService")))
}

test "«Learn» buys the picked service where it can be learned now, and nothing where it can't" {
  Game::trainer.teachesClass = (): boolean => false
  Client::IsTradeskillTrainer = (): boolean => true
  Game::trainer.services = (): array<Game::TrainerService> => taught()
  const bought: array<string> = []
  Client::BuyTrainerService = (index: integer): nil => bought.push(string::of(index))
  Game::money.amount = 1000
  Test::mount(nil, SCREEN)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(Locale::TRAINER)
  window.text("Bolt of Woolen Cloth").click()
  Test::expect(window.text(Locale::NEEDS_LEVEL.format(10) + " · " + Locale::NEEDS_SKILL.format(75)).shown())
  window.button(Locale::TRAIN).click()
  Test::expect(bought.length == 0)
  window.text("Red Linen Robe").click()
  window.button(Locale::TRAIN).click()
  Test::expect(bought.join(", ") == "2")
}

test "the filter's switches on the toolbar's right keep what is learned now, what can't be yet and what is known" {
  Game::trainer.teachesClass = (): boolean => false
  Client::IsTradeskillTrainer = (): boolean => true
  Game::trainer.services = (): array<Game::TrainerService> => taught()
  Test::mount(nil, SCREEN)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(Locale::TRAINER)
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test::page().window("Reset").button(Locale::SHOW_KNOWN).click()
  Test::expect(window.text("Linen Shirt").shown() && window.text("Red Linen Robe").shown())
  Test::page().window("Reset").button(Locale::SHOW_AVAILABLE).click()
  Test::expect(!window.text("Red Linen Robe").shown() && window.text("Bolt of Woolen Cloth").shown())
}

test "the trainer's skill bar shows its rank of the most; the list stands under the trainer's categories, folded by a click; a service's tooltip is the game's" {
  Game::trainer.teachesClass = (): boolean => false
  Client::IsTradeskillTrainer = (): boolean => true
  Game::trainer.services = (): array<Game::TrainerService> => taught().map(service => Game.TrainerService { category: service.index == 3 ? "Cloth" : "Robes", ..service })
  Game::trainer.skill = (): Game::TrainerSkill | nil => Game.TrainerSkill { rank: 60, most: 75, added: 0 }
  Test::mount(nil, SCREEN)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(Locale::TRAINER)
  Test::expect(window.text(Locale::RANK_75 + " · 60 / 75").shown())
  window.button(Ordaen.art.ctl.tool.table).click()
  // The trainer's own one list (Ordaen Trainer's view).
  Test::page().button("One list").click()
  // The shirt, known, is left out: the robe alone under «Robes».
  Test::expect(window.text("Robes (1)").shown() && window.text("Cloth (1)").shown())
  window.text("Robes (1)").click()
  Test::expect(!window.text("Red Linen Robe").shown() && window.text("Bolt of Woolen Cloth").shown())
  _ = Test::requests()
  window.box(BOLT).hover()
  Test::expect(Test::requests().join(", ").contains("Items.showService 3"))
}

test "a new profession is asked first, and greyed while two are known" {
  Game::trainer.teachesClass = (): boolean => false
  Client::IsTradeskillTrainer = (): boolean => true
  Game::trainer.services = (): array<Game::TrainerService> => [
    { index: 1, name: "Tailoring", rank: "Apprentice", icon: ROBE, status: .Available, level: 5, cost: 10, description: "", skill: nil, profession: true }
  ]
  const bought: array<string> = []
  Client::BuyTrainerService = (index: integer): nil => bought.push(string::of(index))
  Game::money.amount = 1000
  Test::mount(nil, SCREEN)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(Locale::TRAINER)
  window.text("Tailoring").click()
  window.button(Locale::TRAIN).click()
  Test::expect(bought.length == 0)
  const asked = Test::page().window(Locale::CONFIRM_PROFESSION.format("Tailoring"))
  asked.button(Locale::TRAIN).click()
  Test::expect(bought.join(", ") == "1")
  Client::GetProfessions = (): (integer | nil, integer | nil, integer | nil, integer | nil, integer | nil, integer | nil) => {
    return (1, 2, nil, nil, nil, nil)
  }
  Game::trainer.changed.emit()
  Test::expect(window.text(Locale::NO_PROFESSION_SLOT).shown())
  window.button(Locale::TRAIN).click()
  Test::expect(bought.length == 1 && !Test::page().window(Locale::CONFIRM_PROFESSION.format("Tailoring")).shown())
}
