// The chosen recipe's reagents with Ordaen Trading's prices, and the totals under them (`cost.luna`): a reagent's
// icon, name, have / need for the make row's count (red when short), its price at «Auction» and at «Merchant» for
// that quantity («—» where none is known), the cheaper on a green ground. The totals: «Cost», «Price» (what it sells
// for, the house's cut taken; its tip the full price and the cut; «doesn't sell» for what makes no item), «Profit»
// (red under nought), and how old the oldest price taken is, in its age's colour; «—» where a part has no price.
import Game from "$game"
import { Align, Art, Edges, Frame, Line, Side, Track } from "$ltml"
import { BRIGHT_TEXT, Component, Ground, ItemButton, Money, SECONDARY_TEXT, TableRow, Tip, ageText } from "Ordaen"
import { PartPrice, Totals, Way } from "@/cost"
import Locale from "@/locales"
import { SourceTotals, roughCost, roughProfit } from "@/split"
import Style from "@/style"

const SLOT = 37.5dp
// The headings, each reagent's row and the totals stand in the same columns: the icon, the name, have / need, the
// price at the house and at a merchant. Each reagent is a row of its own (its shade under the cursor, its item's
// tooltip beside the whole row), so the columns are of set widths, not each as wide as its widest cell.
const MONEY = 117.1875dp
// The names never narrower than the totals' labels («Cost», «Price», «Profit»), which stand under them.
const PRICED: Array<Track> = [SLOT, { fr: 1, min: 70.3125dp }, 58.59375dp, MONEY, MONEY]
// As the library's table rows lay their cells out: their gap, and their room at the sides.
const GAP = 3sp
const SIDES: Edges = { left: 3sp, right: 3sp }
const LINE_ROOM: Edges = { top: 1sp, right: 3sp, bottom: 1sp, left: 3sp }
const NONE = "—"
// The cheaper way, on a green ground.
const TOTALS_RULE: Line = { width: 1.171875dp, color: Style.LINE, sides: [Side.Top] }
const CHEAPER: Color = Color.hex("#40c0402e")
const CLEAR: Color = Color.hex("#00000000")
const HOUR = 3600
const DAY = 24

// The text of a way.
public function wayText(way: Way): String {
  return match (way) {
    Way.Buy => Locale.WAY_BUY
    Way.Vendor => Locale.WAY_VENDOR
    Way.None => NONE
  }
}

// A priced reagent: a row of the table's, its item's tooltip beside the whole row.
public class PricedReagentRow implements Component {
  derived item: Integer | nil = self.price.item
  derived icon: Art | nil = self.price.icon
  derived color: Color = self.price.have < self.price.need ? Style.RED : Style.INK
  derived hasAuction: Boolean = self.price.auction != nil
  derived hasVendor: Boolean = self.price.vendor != nil
  derived auction: Integer = self.price.auction ?? 0
  derived vendor: Integer = self.price.vendor ?? 0
  derived auctionBack: Color = self.price.way == Way.Buy ? CHEAPER : CLEAR
  derived vendorBack: Color = self.price.way == Way.Vendor ? CHEAPER : CLEAR

  price: Signal<PartPrice>
  constructor(price: Signal<PartPrice>) { self.price = price }

  // Anywhere on the row, its item's tooltip beside it.
  onEnter(self, frame: any Frame) {
    const item = self.item
    if (item != nil) { Game.items.show(frame, item) }
  }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={PRICED} ground={Ground.Wood} @enter={self.onEnter}>
        <ItemButton item={self.item} art={self.icon} size={SLOT} tipped={false} />
        <text value={self.price.name} textColor={Style.INK} wrap={.Cut} />
        <box xAlign={Align.End}>
          <text value={"%d / %d"} arguments={[self.price.have, self.price.need]} wrap={.None} textColor={self.color}
                textFont={.Numbers} />
        </box>
        <box background={self.auctionBack} xAlign={Align.End}>
          <Money $if={self.hasAuction} amount={self.auction} />
          <text $else value={NONE} textColor={Style.DIM} />
        </box>
        <box background={self.vendorBack} xAlign={Align.End}>
          <Money $if={self.hasVendor} amount={self.vendor} />
          <text $else value={NONE} textColor={Style.DIM} />
        </box>
      </TableRow>
    }
  }
}

// A total at one source: its money, «~» before it where it leaves something out, a red «-» for a loss, its tip
// under the cursor; `none` where there is no amount.
class TotalCell implements Component {
  state hovered = false
  derived has: Boolean = self.amount != nil
  derived losing: Boolean = (self.amount ?? 0) < 0
  derived shown: Integer = (self.amount ?? 0).abs()
  derived color: Color = self.losing ? Style.RED : BRIGHT_TEXT
  derived tipped: Boolean = self.hovered && self.tip != ""

  amount: Signal<Integer | nil>
  rough: Signal<Boolean>
  tip: Signal<String>
  constructor(amount: Signal<Integer | nil>, rough: Signal<Boolean>, tip: Signal<String>) {
    self.amount = amount
    self.rough = rough
    self.tip = tip
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box yAlign={Align.Center} xAlign={Align.End}>
        // The amount alone hears the mouse: its tip under the cursor.
        <box $if={self.has} columns={{ each: "max-content" }} gap={0.5sp} @pointerEnter={self.onEnter}
             @pointerLeave={self.onLeave}>
          <text $if={self.rough} value={"~"} textColor={Style.DIM} />
          <text $if={self.losing} value={"-"} textColor={Style.RED} />
          <Money amount={self.shown} color={self.color} />
          <Tip $if={self.tipped} title={""} text={self.tip} />
        </box>
        <text $else value={NONE} textColor={Style.DIM} />
      </box>
    }
  }
}

// A row of the totals: its label under the reagents' names, its amount at each source under that source's column.
class TotalRow implements Component {
  label: Signal<String>
  auction: Signal<Integer | nil>
  merchant: Signal<Integer | nil>
  auctionRough: Signal<Boolean>
  merchantRough: Signal<Boolean>
  auctionTip: Signal<String>
  merchantTip: Signal<String>
  rule: Signal<Line | nil>
  constructor(
    label: Signal<String>, auction: Signal<Integer | nil>, merchant: Signal<Integer | nil>, auctionRough: Signal<Boolean>,
    merchantRough: Signal<Boolean>, auctionTip: Signal<String>, merchantTip: Signal<String>, rule: Signal<Line | nil> = nil
  ) {
    self.label = label
    self.auction = auction
    self.merchant = merchant
    self.auctionRough = auctionRough
    self.merchantRough = merchantRough
    self.auctionTip = auctionTip
    self.merchantTip = merchantTip
    self.rule = rule
  }

  public render(self): Template {
    return $ltml {
      <box columns={PRICED} gap={GAP} padding={LINE_ROOM} border={self.rule} yAlign={Align.Center}>
        <box />
        <text value={self.label} textColor={Style.DIM} wrap={.None} />
        <box />
        <TotalCell amount={self.auction} rough={self.auctionRough} tip={self.auctionTip} />
        <TotalCell amount={self.merchant} rough={self.merchantRough} tip={self.merchantTip} />
      </box>
    }
  }
}

// What a cost's tip says: the parts it leaves out.
function costTip(side: SourceTotals): String {
  return side.cost != nil && side.missing.length > 0 ? Locale.TIP_COST_PARTIAL.format(side.missing.join(", ")) : ""
}

// What a profit's tip says: the item isn't bought here, the parts at the other source's price, the parts with none.
function profitTip(side: SourceTotals): String {
  const lines: Array<String> = []
  if (side.sale == nil) { lines.push(Locale.TIP_NOT_BOUGHT) }
  if (side.filled.length > 0) { lines.push(Locale.TIP_PROFIT_FILLED.format(side.filled.join(", "))) }
  if (side.unpriced.length > 0) { lines.push(Locale.TIP_PROFIT_UNPRICED.format(side.unpriced.join(", "))) }
  return lines.join("\n")
}

// The priced reagents under their headings, and under them the totals at each source, in the same columns.
public class PriceTable implements Component {
  derived auctionCostTip: String = costTip(self.auction)
  derived merchantCostTip: String = costTip(self.merchant)
  derived auctionRough: Boolean = roughCost(self.auction)
  derived merchantRough: Boolean = roughCost(self.merchant)
  derived saleTip: String = self.saleTipOf()
  derived auctionProfitRough: Boolean = roughProfit(self.auction)
  derived merchantProfitRough: Boolean = roughProfit(self.merchant)
  derived auctionProfitTip: String = profitTip(self.auction)
  derived merchantProfitTip: String = profitTip(self.merchant)

  parts: Signal<Array<PartPrice>>
  auction: Signal<SourceTotals>
  merchant: Signal<SourceTotals>
  totals: Signal<Totals>
  constructor(parts: Signal<Array<PartPrice>>, auction: Signal<SourceTotals>, merchant: Signal<SourceTotals>, totals: Signal<Totals>) {
    self.parts = parts
    self.auction = auction
    self.merchant = merchant
    self.totals = totals
  }

  // The house's price before its cut, and the cut.
  saleTipOf(self): String {
    const sale = self.auction.sale
    if (sale == nil) { return "" }
    return Locale.SALE_TIP.format(Game.money.format(self.totals.listed ?? 0), self.totals.cut, Game.money.format(sale))
  }

  public render(self): Template {
    return $ltml {
      <box columns={1}>
        <box columns={PRICED} gap={GAP} padding={SIDES}>
          <box />
          <box />
          <box />
          <box xAlign={Align.End}>
            <text value={Locale.PRICE_AUCTION} textSize={SECONDARY_TEXT} textColor={Style.DIM} wrap={.None} />
          </box>
          <box xAlign={Align.End}>
            <text value={Locale.PRICE_VENDOR} textSize={SECONDARY_TEXT} textColor={Style.DIM} wrap={.None} />
          </box>
        </box>
        <PricedReagentRow $for={part of self.parts} price={part} />
        <TotalRow label={Locale.TOTAL_COST} auction={self.auction.cost} merchant={self.merchant.cost}
                  auctionRough={self.auctionRough} merchantRough={self.merchantRough} auctionTip={self.auctionCostTip}
                  merchantTip={self.merchantCostTip} rule={TOTALS_RULE} />
        <TotalRow label={Locale.TOTAL_SALE} auction={self.auction.sale} merchant={self.merchant.sale} auctionRough={false}
                  merchantRough={false} auctionTip={self.saleTip} merchantTip={""} />
        <TotalRow label={Locale.TOTAL_PROFIT} auction={self.auction.profit} merchant={self.merchant.profit}
                  auctionRough={self.auctionProfitRough} merchantRough={self.merchantProfitRough}
                  auctionTip={self.auctionProfitTip} merchantTip={self.merchantProfitTip} />
      </box>
    }
  }
}

// The text of how old the oldest price is: in hours under two days, then in days.
function ageLine(hours: Integer | nil): String {
  if (hours == nil) { return "" }
  if (hours < 2 * DAY) { return Locale.PRICES_AGE_HOURS.format(hours) }
  return Locale.PRICES_AGE_DAYS.format((hours / DAY).floor())
}

// How old the oldest price the totals took is, in its age's colour.
public class PricesAge implements Component {
  derived age: String = ageLine(self.totals.oldest)
  derived aged: Boolean = self.age != ""
  derived color: Color = self.colorOf()

  totals: Signal<Totals>
  constructor(totals: Signal<Totals>) { self.totals = totals }

  colorOf(self): Color {
    const _, color = ageText((self.totals.oldest ?? 0) * HOUR)
    return color ?? Style.DIM
  }

  public render(self): Template {
    return $ltml {
      <text $if={self.aged} value={self.age} textSize={SECONDARY_TEXT} textColor={self.color} />
    }
  }
}
