// The chosen recipe's reagents with Ordaen Auction's prices, and the totals under them (`cost.luna`): a reagent's
// icon, name, have / need for the make row's count (red when short), its price at «Auction» and at «Merchant» for
// that quantity («—» where none is known) and «Best», the way taken (red «—» where none is). The totals: «Cost»,
// «Left to buy», «Sale» («doesn't sell» for what makes no item), «Profit» (red under nought), and how old the
// oldest price taken is, in its age's colour; «—» where a part has no price.
import { Align, Art, Edges, Line, Track } from "$ltml"
import { Component, ItemButton, Money, SECONDARY_TEXT, ageText } from "Ordaen"
import { PartPrice, Totals, Way } from "@/cost"
import Locale from "@/locales"
import Style from "@/style"

const SLOT = 37.5dp
// The headings and the rows are one grid: a price's column and «Best»'s are as wide as the widest of their heading
// and their cells, at the text's size. Each cell keeps its row's room round it, and its row's rule over it.
const PRICED: Array<Track> = [SLOT, { fr: 1 }, "max-content", "max-content", "max-content", "max-content"]
const GAP = 2.5sp
const ROOM = 1sp
const FIRST: Edges = { top: ROOM, bottom: ROOM }
const NEXT: Edges = { top: ROOM, bottom: ROOM, left: GAP }
const LAST: Edges = { top: ROOM, right: 2sp, bottom: ROOM, left: GAP }
const TOTALS: Array<Track> = [{ fr: 1 }, "max-content"]
const TOTALS_PAD: Edges = { top: 3sp }
const NONE = "—"
// The cheaper way, on a green ground.
const CHEAPER: Color = Color.hex("#40c0402e")
const CLEAR: Color = Color.hex("#00000000")
const HOUR = 3600
const DAY = 24

// The text of a way.
public function wayText(way: Way): String {
  return match (way) {
    Way.Buy => Locale.WAY_BUY
    Way.Vendor => Locale.WAY_VENDOR
    Way.None => NONE
  }
}

// A priced reagent's cells, laid out in the table's columns: it has no box of its own.
public class PricedReagentRow implements Component {
  derived rule: Line | nil = self.index > 1 ? Style.PAPER_RULE : nil
  derived item: Integer | nil = self.price.item
  derived icon: Art | nil = self.price.icon
  derived color: Color = self.price.have < self.price.need ? Style.PAPER_RED : Style.PAPER_INK
  derived hasAuction: Boolean = self.price.auction != nil
  derived hasVendor: Boolean = self.price.vendor != nil
  derived auction: Integer = self.price.auction ?? 0
  derived vendor: Integer = self.price.vendor ?? 0
  derived best: String = wayText(self.price.way)
  derived bestColor: Color = self.price.way == Way.None ? Style.PAPER_RED : Style.PAPER_INK
  derived auctionBack: Color = self.price.way == Way.Buy ? CHEAPER : CLEAR
  derived vendorBack: Color = self.price.way == Way.Vendor ? CHEAPER : CLEAR

  price: Signal<PartPrice>
  index: Signal<Integer>
  constructor(price: Signal<PartPrice>, index: Signal<Integer>) {
    self.price = price
    self.index = index
  }

  public render(self): Template {
    return $ltml {
      <>
        <box padding={FIRST} border={self.rule} yAlign={Align.Center}>
          <ItemButton item={self.item} art={self.icon} size={SLOT} />
        </box>
        <box padding={NEXT} border={self.rule} yAlign={Align.Center}>
          <text value={self.price.name} textColor={Style.PAPER_INK} />
        </box>
        <box padding={NEXT} border={self.rule} yAlign={Align.Center}>
          <text value={"%d / %d"} arguments={[self.price.have, self.price.need]} wrap={.None} textColor={self.color}
                textFont={.Numbers} />
        </box>
        <box padding={NEXT} border={self.rule} yAlign={Align.Center}>
          <box background={self.auctionBack} xAlign={Align.End}>
            <Money $if={self.hasAuction} amount={self.auction} color={Style.PAPER_INK} />
            <text $else value={NONE} textColor={Style.PAPER_DIM} />
          </box>
        </box>
        <box padding={NEXT} border={self.rule} yAlign={Align.Center}>
          <box background={self.vendorBack} xAlign={Align.End}>
            <Money $if={self.hasVendor} amount={self.vendor} color={Style.PAPER_INK} />
            <text $else value={NONE} textColor={Style.PAPER_DIM} />
          </box>
        </box>
        <box padding={LAST} border={self.rule} yAlign={Align.Center}>
          <text value={self.best} textColor={self.bestColor} wrap={.None} />
        </box>
      </>
    }
  }
}

// The priced reagents under their headings.
public class PriceTable implements Component {
  parts: Signal<Array<PartPrice>>
  constructor(parts: Signal<Array<PartPrice>>) {
    self.parts = parts
  }

  public render(self): Template {
    return $ltml {
      <box columns={PRICED} yAlign={Align.Stretch}>
        <box padding={FIRST} />
        <box padding={NEXT} />
        <box padding={NEXT} />
        <box padding={NEXT}>
          <text value={Locale.PRICE_AUCTION} textSize={SECONDARY_TEXT} textColor={Style.PAPER_DIM} wrap={.None} />
        </box>
        <box padding={NEXT}>
          <text value={Locale.PRICE_VENDOR} textSize={SECONDARY_TEXT} textColor={Style.PAPER_DIM} wrap={.None} />
        </box>
        <box padding={LAST}>
          <text value={Locale.PRICE_BEST} textSize={SECONDARY_TEXT} textColor={Style.PAPER_DIM} wrap={.None} />
        </box>
        <PricedReagentRow $for={index, part of self.parts} price={part} index={index} />
      </box>
    }
  }
}

// The text of how old the oldest price is: in hours under two days, then in days.
function ageLine(hours: Integer | nil): String {
  if (hours == nil) { return "" }
  if (hours < 2 * DAY) { return Locale.PRICES_AGE_HOURS.format(hours) }
  return Locale.PRICES_AGE_DAYS.format((hours / DAY).floor())
}

public class TotalsBlock implements Component {
  derived hasCost: Boolean = self.totals.cost != nil
  derived hasToBuy: Boolean = self.totals.toBuy != nil
  derived hasSale: Boolean = self.totals.sale != nil
  derived hasProfit: Boolean = self.totals.profit != nil
  derived cost: Integer = self.totals.cost ?? 0
  derived toBuy: Integer = self.totals.toBuy ?? 0
  derived sale: Integer = self.totals.sale ?? 0
  derived profit: Integer = (self.totals.profit ?? 0).abs()
  derived losing: Boolean = (self.totals.profit ?? 0) < 0
  derived profitColor: Color = self.losing ? Style.PAPER_RED : Style.PAPER_INK
  derived age: String = ageLine(self.totals.oldest)
  derived aged: Boolean = self.age != ""
  derived ageColor: Color = self.ageColorOf()
  derived saleText: String = self.totals.sellable ? NONE : Locale.NOT_SOLD

  totals: Signal<Totals>
  constructor(totals: Signal<Totals>) {
    self.totals = totals
  }

  ageColorOf(self): Color {
    const _, color = ageText((self.totals.oldest ?? 0) * HOUR)
    return color ?? Style.PAPER_DIM
  }

  public render(self): Template {
    return $ltml {
      <box columns={TOTALS} gap={3sp} padding={TOTALS_PAD} border={Style.PAPER_RULE}>
        <text value={Locale.TOTAL_COST} textColor={Style.PAPER_DIM} />
        <Money $if={self.hasCost} amount={self.cost} color={Style.PAPER_INK} />
        <text $else value={NONE} textColor={Style.PAPER_DIM} />
        <text value={Locale.TOTAL_TO_BUY} textColor={Style.PAPER_DIM} />
        <Money $if={self.hasToBuy} amount={self.toBuy} color={Style.PAPER_INK} />
        <text $else value={NONE} textColor={Style.PAPER_DIM} />
        <text value={Locale.TOTAL_SALE} textColor={Style.PAPER_DIM} />
        <Money $if={self.hasSale} amount={self.sale} color={Style.PAPER_INK} />
        <text $else value={self.saleText} textColor={Style.PAPER_DIM} />
        <text value={Locale.TOTAL_PROFIT} textColor={Style.PAPER_DIM} />
        <box $if={self.hasProfit} columns={["max-content", "max-content"]} gap={0.5sp} xAlign={Align.End}>
          <text $if={self.losing} value={"-"} textColor={Style.PAPER_RED} />
          <Money amount={self.profit} color={self.profitColor} />
        </box>
        <text $else value={NONE} textColor={Style.PAPER_DIM} />
        <text $if={self.aged} value={self.age} textSize={SECONDARY_TEXT} textColor={self.ageColor} />
      </box>
    }
  }
}
