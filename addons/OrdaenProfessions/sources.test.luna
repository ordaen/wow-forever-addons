// Where a recipe not learned is learned, as What's Training's table has it, and how its card says it.
import Game from "$game"
import Test from "$test"
import { RecipeSource, Sided, Way, howLearned, otherSideOnly, readinessOf, sourcesOf, wayOf } from "@/sources"
import { READY_LATER, READY_MISSING, READY_NOW, READY_SOON } from "@/view"

const ALCHEMY = 171
const BLACKSMITHING = 164
// Minor Healing Potion's recipe: Alchemy's trainer teaches it from skill 15.
const MINOR_HEALING = 2329
// A blacksmith's recipe a vendor sells to those Friendly with its faction.
const SOLD = 1301422
const VENDOR = 254151
const FACTION = 2758

test "a profession's recipes are read with where each is learned: its trainer's skill and price, its vendors, the standing it asks" {
  const potion = sourcesOf(ALCHEMY)[MINOR_HEALING]
  const sold = sourcesOf(BLACKSMITHING)[SOLD]
  Test.expect(potion != nil && sold != nil)
  if (potion != nil) { Test.expect(potion.skill == 15 && potion.cost == 50 && potion.sources.join("/") == "trainer") }
  if (sold != nil) {
    Test.expect(sold.skill == 50 && sold.sources.join("/") == "vendor" && sold.vendors[1]?.id == VENDOR)
    Test.expect(sold.reputation[1]?.faction == FACTION && sold.reputation[1]?.standing == 5)
  }
  Test.expect(sourcesOf(nil)[MINOR_HEALING] == nil && sourcesOf(1)[MINOR_HEALING] == nil)
}

test "a recipe is the other side's alone where its every way is a vendor or a quest and none of them is the player's side's" {
  const horde: Array<Sided> = [{ id: VENDOR, area: 1, side: 2 }]
  const both: Array<Sided> = [{ id: VENDOR, area: 1, side: 2 }, { id: VENDOR, area: 1, side: 0 }]
  const sold: RecipeSource = { skill: 1, sources: ["vendor"], cost: 0, favor: 0, reputation: [], quests: [], vendors: horde }
  Test.expect(otherSideOnly(sold, 1) && !otherSideOnly(sold, 2))
  Test.expect(!otherSideOnly({ skill: 1, sources: ["vendor"], cost: 0, favor: 0, reputation: [], quests: [], vendors: both }, 1))
  // A drop, a trainer or no way known: anyone's.
  Test.expect(!otherSideOnly({ skill: 1, sources: ["vendor", "drop"], cost: 0, favor: 0, reputation: [], quests: [], vendors: horde }, 1))
  Test.expect(!otherSideOnly({ skill: 1, sources: [], cost: 0, favor: 0, reputation: [], quests: [], vendors: [] }, 1))
  Test.expect(wayOf("trainer") == Way.Trainer && wayOf("world_object") == Way.Other)
}

test "a recipe's card says each way it is learned and what it asks, a line each" {
  Test.factions({ [FACTION]: "The Smiths" })
  const potion = sourcesOf(ALCHEMY)[MINOR_HEALING]
  if (potion != nil) { Test.expect(howLearned(potion, 1)[1]?.contains("Trainer: from skill 15") == true) }
  const sold = sourcesOf(BLACKSMITHING)[SOLD]
  if (sold != nil) {
    const lines = howLearned(sold, 1)
    Test.expect(lines.length == 2 && lines[1]?.contains("Sold by") == true)
    Test.expect(lines[2]?.contains("with The Smiths") == true)
  }
  Test.expect(potion != nil && sold != nil)
}

// A recipe learned at `skill`, a rank asking `level`.
function learnedAt(skill: Integer, level: Integer): RecipeSource {
  return { skill: skill, level: level, sources: ["trainer"], cost: 0, favor: 0, reputation: [], quests: [], vendors: [] }
}

test "a recipe not learned waits as What's Training files it: now, something else first, within 10 points, later" {
  Game.player.level = 20
  // At skill 50 of 75.
  Test.expect(readinessOf(learnedAt(50, 0), 50, 75) == READY_NOW && readinessOf(learnedAt(40, 0), 50, 75) == READY_NOW)
  // A rank asking a level not reached, or nothing known of it.
  Test.expect(readinessOf(learnedAt(50, 30), 50, 75) == READY_MISSING && readinessOf(nil, 50, 75) == READY_MISSING)
  Test.expect(readinessOf(learnedAt(0, 0), 50, 75) == READY_MISSING)
  Test.expect(readinessOf(learnedAt(60, 0), 50, 75) == READY_SOON && readinessOf(learnedAt(61, 0), 50, 75) == READY_LATER)
  // Over the skill's most now: later, however near.
  Test.expect(readinessOf(learnedAt(76, 0), 70, 75) == READY_LATER)
}
