// BandBar: the profession's skill in the page band: a bar in a small surface's frame (its corners rounded), the
// experience bar's fill, the rest of it the window's wood, a notch every 10%, and on it, in the body's size with room
// above and below, the rank and the skill: «Apprentice · 31 / 75». A prototype of the professions window's design:
// Ordaen's `SkillBar` hangs from a window's top line in the trainer's.
import { Align, Art, Line, Position, Shadow, Side, TextFont, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, Component, XpFill, xpFillArt } from "Ordaen"
import Locale from "@/locales"

const HEIGHT = 39.84375dp
const SHADOW: Shadow = { color: Color::hex("#000000"), x: 1.171875dp, y: -1.171875dp }
// Ten equal cells, each but the last with a 1 px dark right edge.
const CELLS: array<integer> = [1, 2, 3, 4, 5, 6, 7, 8, 9]
const NOTCH: Line = { width: 1.171875dp, color: Color::hex("#00000080"), sides: [Side::Right] }
const FILL: array<Track> = [{ fr: 1 }]

// The name of the rank a skill's most stands for: «Apprentice» at 75; none for another.
function rankOf(most: integer): string {
  match (most) {
    75 => return Locale::RANK_75
    150 => return Locale::RANK_150
    225 => return Locale::RANK_225
    300 => return Locale::RANK_300
    else => return ""
  }
}

public class BandBar implements Component {
  // The bar in two columns: the filled part, and the rest.
  derived parts: array<Track> = [{ fr: self.shareOf() }, { fr: 1 - self.shareOf() }]
  derived label: string = self.labelOf()
  const fill: Art = xpFillArt(XpFill::Brushed)

  // The player's skill and the most it goes to now.
  rank: Signal<integer>
  most: Signal<integer>
  constructor(rank: Signal<integer>, most: Signal<integer>) {
    self.rank = rank
    self.most = most
  }

  shareOf(): number {
    if (self.most <= 0) { return 0 }
    return (1).min(self.rank / self.most)
  }

  labelOf(): string {
    if (self.rank <= 0 && self.most <= 0) { return "" }
    const skill = "%d / %d".format(self.rank, self.most)
    const rank = rankOf(self.most)
    if (rank == "") { return skill }
    return rank + " · " + skill
  }

  public render(): Template {
    return $ltml {
      <box height={HEIGHT} border={Ordaen.art.frame.small} background={Ordaen.art.window.wood} rows={FILL}>
        <box position={Position::Absolute} left={0ui} right={0ui} top={0ui} bottom={0ui} columns={self.parts} rows={FILL}>
          <box background={self.fill} />
          <box />
        </box>
        <box position={Position::Absolute} left={0ui} right={0ui} top={0ui} bottom={0ui} columns={10} rows={FILL}>
          <box $for={cell of CELLS} border={NOTCH} />
          <box />
        </box>
        <box position={Position::Absolute} left={0ui} right={0ui} top={0ui} bottom={0ui} xAlign={Align::Center}
             yAlign={Align::Center}>
          <text value={self.label} textColor={BRIGHT_TEXT} textShadow={SHADOW}
                textFont={TextFont::Numbers} wrap={.None} />
        </box>
      </box>
    }
  }
}
