// Making a recipe: the make row's three ways of saying how many (a count, the skill points to gain, all the bags
// allow) and what «Create» asks of the game. The recipes are Tailoring's own, by their numbers, so the client's table
// of where each turns yellow and grey (`levels.luna`) answers for them.
import Client from "$client"
import Game from "$game"
import Test from "$test"
import { MakeMode } from "@/view"
import root Ordaen from "Ordaen"
import root Professions from "OrdaenProfessions"

const PAGE: Test.Page = { left: 20, top: 20, width: 200, height: 100, screen: true }
const TAILORING = 197
// Linen Cloak turns yellow at 35 and grey at 60; Bolt of Linen Cloth at 25 and 50.
const CLOAK = 2387
const BOLT = 2963

function recipe(id: Integer, name: String, difficulty: Game.Difficulty, craftable: Integer): Game.Recipe {
  return {
    id: id, name: name, icon: "Interface/Icons/INV_Misc_Note_01", categoryID: 11, learned: true,
    difficulty: difficulty, craftable: craftable,
  }
}

function click(at: Test.Point) {
  Test.click(at, nil)
  Test.flush()
}

function pickFrom(face: String, choice: String) {
  click(Test.holding(face, nil))
  click(Test.holding(choice, nil))
}

function times(count: Integer, text: String) {
  for (step of 1..=count) { click(Test.holding(text, nil)) }
}

// Tailoring at 31 of 75, with its two recipes in «Cloth armour».
function tailoring(): Array<Game.Profession> {
  return [{ skillLine: TAILORING, name: "Tailoring", icon: 136249, rank: 31, max: 75, kind: Game.ProfessionKind.Crafting }]
}

function categories(): Array<Game.Category> {
  // The camp's category stands first under the heading, as the game gives it.
  return [
    { id: 1, name: "Tailoring" }, { id: 10, name: "Resting at camp", parentID: 1 },
    { id: 11, name: "Cloth armour", parentID: 1 },
  ]
}

function recipes(): Array<Game.Recipe> {
  return [recipe(CLOAK, "Linen Cloak", Game.Difficulty.Always, 5), recipe(BOLT, "Bolt of Linen Cloth", Game.Difficulty.Rarely, 9)]
}

test "the make row: a count, the skill points to gain, or all the bags allow" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.C_UI.GetUIParent(), nil)
  Game.professions.list = tailoring()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, PAGE)
  Game.tradeSkill.open = TAILORING
  Test.flush()
  Test.shot("Linen Cloak chosen: «Quantity», one, «Create»")
  // The make row is the recipe's card's: the mode, the count and «Create» stand inside its marble.
  const card = Test.edges(Ordaen.art.window.marble, 0)
  for (part of ["Quantity", "Create"]) {
    const at = Test.holding(part, nil)
    Test.expect(at.x > card.left && at.x < card.right && at.y > card.top && at.y < card.bottom)
  }

  // Ten points from 31: four while the cloak is orange, then (60 - 35) / (60 - skill) makings a point.
  pickFrom("Quantity", "Raise skill")
  times(9, "+")
  Test.note(`the mode: ${Professions.makeMode}, the count: ${Professions.count}`)
  Test.expect(Test.holding("≈ 11 pcs.", nil).x > 0)
  click(Test.holding("Create", nil))
  Test.shot("«Raise skill» by 10: about 11 makings; «Create» makes the 5 the bags allow")

  // The bolt is green at 31: ten points take 18 makings, twenty would reach its grey at 50. Another recipe: the count
  // starts at one.
  click(Test.holding("Bolt of Linen Cloth", nil))
  times(9, "+")
  Test.expect(Test.holding("≈ 18 pcs.", nil).x > 0)
  times(10, "+")
  Test.shot("the bolt by 20 points: it turns grey first, «Create» is disabled")
  click(Test.holding("Create", nil))

  pickFrom("Raise skill", "All")
  click(Test.holding("Create", nil))
  Test.shot("«All»: no count, the 9 the bags allow, made")
  Test.expect(Professions.makeMode == MakeMode.All)
}

// The recipes with the bags making `craftable` cloaks.
function cloaks(craftable: Integer): Array<Game.Recipe> {
  return [recipe(CLOAK, "Linen Cloak", Game.Difficulty.Always, craftable), recipe(BOLT, "Bolt of Linen Cloth", Game.Difficulty.Rarely, 9)]
}

test "the count stays within its bounds: one at least, what the bags make by «Quantity», the points left by «Raise skill», as they move" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.C_UI.GetUIParent(), nil)
  Game.professions.list = tailoring()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, PAGE)
  Game.tradeSkill.open = TAILORING
  Test.flush()

  // «Quantity»: one to the five the bags make.
  times(3, "-")
  Test.expect(Professions.count == 1)
  times(6, "+")
  Test.expect(Professions.count == 5)
  Test.shot("«Quantity» at 5, what the bags make: + disabled")

  // The reagents run out while the window is open: the count falls to what the bags make; with none, the count and
  // «Create» are disabled.
  Game.tradeSkill.recipes = cloaks(2)
  Test.flush()
  Test.expect(Professions.count == 2)
  Game.tradeSkill.recipes = cloaks(0)
  Test.flush()
  Test.expect(Professions.count == 1)
  click(Test.holding("Create", nil))
  Test.shot("nothing to make: the count at one, −, + and «Create» disabled")
  Game.tradeSkill.recipes = cloaks(5)
  Test.flush()

  // «Raise skill» from 31 of 75: 44 points at most.
  pickFrom("Quantity", "Raise skill")
  times(50, "+")
  Test.expect(Professions.count == 44)
  Test.shot("«Raise skill» at 44, the points left before 75: + disabled")

  // The skill rises while the window is open: the count falls to the points left.
  Game.professions.list = [{ skillLine: TAILORING, name: "Tailoring", icon: 136249, rank: 70, max: 75, kind: Game.ProfessionKind.Crafting }]
  Test.flush()
  Test.note(`at 70 of 75: the count ${Professions.count}`)
  Test.expect(Professions.count == 5)

  // «All»: what the bags make, as the bags change; none left, «Create» is disabled.
  pickFrom("Raise skill", "All")
  Test.expect(Test.holding("5 pcs.", nil).x > 0)
  Game.tradeSkill.recipes = cloaks(2)
  Test.flush()
  Test.expect(Test.holding("2 pcs.", nil).x > 0)
  Game.tradeSkill.recipes = cloaks(0)
  Test.flush()
  click(Test.holding("Create", nil))
  Test.shot("«All» with the bags emptied: 0 pcs., «Create» disabled")
}

test "the count starts again at one for another recipe and for another profession" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.C_UI.GetUIParent(), nil)
  Game.professions.list = [
    { skillLine: TAILORING, name: "Tailoring", icon: 136249, rank: 31, max: 75, kind: Game.ProfessionKind.Crafting },
    { skillLine: 164, name: "Blacksmithing", icon: 136241, rank: 10, max: 75, kind: Game.ProfessionKind.Crafting },
  ]
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, PAGE)
  Game.tradeSkill.open = TAILORING
  Test.flush()

  times(2, "+")
  Test.expect(Professions.count == 3)
  click(Test.holding("Bolt of Linen Cloth", nil))
  Test.note(`another recipe: the count ${Professions.count}`)
  Test.expect(Professions.count == 1)

  times(3, "+")
  Test.expect(Professions.count == 4)
  Game.tradeSkill.open = 164
  Test.flush()
  Test.note(`another profession: the count ${Professions.count}`)
  Test.expect(Professions.count == 1)
}
