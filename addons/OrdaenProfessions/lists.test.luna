  Game.tradeSkill.description = (id: Integer): String => long
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(window().text(long).shown())
}

test "the card's icon is the item it makes, the item's tooltip under the cursor; a recipe making none shows its own" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.recipeReader.schematic = schematic
  Game.items.icon = (id: Integer): Art | nil => CLOTH_ICON
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  _ = Test.requests()
  window().button(CLOTH_ICON).hover()
  Test.expect(asked("Items.show 1110"))
  window().button("Bags").click()
  Test.expect(!window().button(CLOTH_ICON).shown() && window().box(NOTE).shown() && chosen() == "Woolen Bag")
}

test "the card's item of a recipe not learned is dimmed" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.recipeReader.schematic = schematic
  Game.items.icon = (id: Integer): Art | nil => CLOTH_ICON
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(window().button(CLOTH_ICON).opacity() == 1)
  window().text("Woolen Cape").click()
  Test.expect(window().button(CLOTH_ICON).opacity() < 1)
}

test "the reagents with prices off: each with have / need, red where the bags hold too few" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  // The woolen bag's wool has an icon of its own.
  Game.tradeSkill.reagents = (id: Integer): Array<Game.Reagent> => {
    if (id == 121) { return [{ itemID: 2997, name: "Bolt of Woolen Cloth", icon: WOOL_ICON, have: 0, need: 3 }] }
    return reagents(id)
  }
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  setting("Prices")
  Test.expect(reads(window().text("Coarse Thread").item(), "Coarse Thread | 0 / 1"))
  Test.expect(window().text("3 / 1").textColor().equal(Color.hex("#e8dcc4")) && window().text("0 / 1").textColor().equal(RED))
  Test.expect(!window().text("Auction").shown())
  // Another recipe chosen: its reagents in the rows.
  window().button("Bags").click()
  Test.expect(chosen() == "Woolen Bag" && reads(window().text("Bolt of Woolen Cloth").item(), "Bolt of Woolen Cloth | 0 / 3"))
  Test.expect(window().text("0 / 3").textColor().equal(RED) && window().box(WOOL_ICON).shown())
}

// Favorites and tracked

test "a recipe starred stands in «Favorites», first among the categories, with a pip; starred again it is taken off" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(!window().text("Favorites").shown())
  window().button("Favorite").click()
  Test.expect(reads(window().text("Favorites").item(), "Favorites | 1 | (1)") && window().text("Favorites").textColor().equal(WHITE))
  window().button("Favorites").click()
  Test.expect(lists("Linen Cloak") && window().button("Favorite").paintedWith(Ordaen.art.ctl.switchOn))
  window().button("Favorite").click()
  Test.expect(!window().text("Favorites").shown() && window().button("Favorite").paintedWith(Ordaen.art.ctl.switchOff))
}

test "a starred recipe's row has a gold pip" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  const before = window().text("Woolen Bag").item().box(YELLOW).shown()
  window().text("Woolen Bag").click()
  window().button("Favorite").click()
  Test.expect(!before && window().text("Woolen Bag").nth(1).item().box(YELLOW).shown())
}

test "starred and tracked recipes are there after a reload" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  window().button("Favorite").click()
  window().button("Track").click()
  Test.reload()
  Test.expect(window().text("Favorites").shown() && window().button("Track").paintedWith(Ordaen.art.ctl.switchOn))
  Test.expect(window().button("Favorite").paintedWith(Ordaen.art.ctl.switchOn))
}

test "a hundred starred is the most: one more takes off the one starred first" {
  // Kept from an earlier session: the cloak starred first, then ninety-eight recipes of other professions.
  let favorites: Array<Integer> = [110]
  for (id of 1..=98) { favorites.push(5000 + id) }
  Game.saved.store(.Character, "OrdaenProfessions:memory", Kept { last: 0, seen: {}, favorites: favorites, tracked: [], queue: [], paused: Pause.None })
  Test.reload()
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(window().button("Favorite").paintedWith(Ordaen.art.ctl.switchOn))
  // The hundredth: every one stays.
  window().button("Cloth armour").click()
  window().text("Brown Linen Vest").click()
  window().button("Favorite").click()
  Test.expect(reads(window().text("Favorites").item(), "Favorites | 2 | (1)"))
  // The hundred and first: the cloak goes.
  window().button("Bags").click()
  window().button("Favorite").click()
  Test.expect(reads(window().text("Favorites").item(), "Favorites | 2 | (0)"))
  window().button("Favorites").click()
  Test.expect(lists("Woolen Bag, Brown Linen Vest"))
}

// The right-click menu

test "a recipe's right-click menu: its link, «Create [N]» and its two switches; it doesn't choose the recipe" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.recipeReader.schematic = schematic
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  window().text("Brown Linen Vest").rightClick()
  const menu = Test.page().window("Link in chat")
  Test.expect(reads(menu, "Link in chat | Create [0] | Favorite | Track") && chosen() == "Linen Cloak")
  Test.expect(menu.text("Create [0]").textColor().equal(MENU_DIM) && !menu.text("Link in chat").textColor().equal(MENU_DIM))
}

test "a click elsewhere closes the menu and goes no further" {
