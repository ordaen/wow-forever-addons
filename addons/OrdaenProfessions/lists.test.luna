// What the window remembers

test "each profession opens at the category and recipe it was left at" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  window().button("Bags").click()
  window().text("Linen Bag").nth(1).click()
  Game.tradeSkill.categories = smithingCategories()
  Game.tradeSkill.recipes = smithingRecipes()
  Game.tradeSkill.open = BLACKSMITHING
  Test.expect(chosen() == "Copper Mace")
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.open = TAILORING
  Test.expect(chosen() == "Linen Bag" && lists("Woolen Bag, Linen Bag"))
}

test "the category and recipe left are there after a reload" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  window().button("Bags").click()
  window().text("Linen Bag").nth(1).click()
  // The profession closes with the session.
  Game.tradeSkill.open = nil
  Test.reload()
  Game.tradeSkill.open = TAILORING
  Test.expect(chosen() == "Linen Bag")
}

test "the category and recipe left are chosen when the module is turned on with the profession open" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  window().button("Bags").click()
  window().text("Linen Bag").nth(1).click()
  const page = settings()
  // The modules in the list: Auction, Tooltips, Professions.
  page.button(Ordaen.art.ctl.switchOn).nth(3).click()
  Test.expect(!window().shown())
  page.button(Ordaen.art.ctl.switchOff).click()
  Test.expect(chosen() == "Linen Bag")
}

