test "the view, the sort and the table's order are there after a reload" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  sort("By name")
  view("Table")
  window().button("Available").click()
  Test::expect(lists("Brown Linen Vest, Woolen Bag, Linen Cloak, Linen Bag"))
  window().button("Available").click()
  Test::reload()
  Test::expect(lists("Linen Bag, Linen Cloak, Woolen Bag, Brown Linen Vest"))
  view("By category")
  Test::expect(lists("Brown Linen Vest, Linen Cloak, Linen Bag, Woolen Bag"))
}

test "a new profile used: the lists in columns by difficulty, as at first" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  sort("By name")
  const page = settings()
  page.button("Profiles").click()
  page.input().nth(1).type("Raid")
  page.button(Ordaen.art.ctl.check).nth(1).click()
  page.button("New").click()
  page.button(Ordaen.art.ctl.check).nth(2).click()
  page.text("Profiles").hover()
  page.button(Ordaen.art.ctl.corner.close).click()
  Test::expect(window().button("Cloth armour").shown() && lists("Linen Cloak, Brown Linen Vest"))
}
