// The professions window's recipes as the player meets them: the three views, the sort, the filter, the search, the
// colours and marks of a recipe, the chosen recipe's card, the right-click menu, and what the window remembers. Each
// test opens Tailoring on the test's game (`Game.tradeSkill`): its camp's recipe, three in «Cloth armour» (one not
// learned), two in «Bags», and a category with none.
import Client from "$client"
import Game from "$game"
import { Art } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { Thresholds, learnable } from "@/skillUps"
import { Kept } from "@/view"

const SCREEN: Test::Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const TAILORING = 197
const BLACKSMITHING = 164
const NOTE: Art = "Interface/Icons/INV_Misc_Note_01"
const CLOTH_ICON: Art = "Interface/Icons/INV_Chest_Cloth_01"
const WOOL_ICON: Art = "Interface/Icons/INV_Fabric_Wool_01"
// A recipe's name: in its difficulty's colour, dim while not learned.
const ORANGE: color = #ff8040
const YELLOW: color = #ffd100
const GREEN: color = #40c040
const GREY: color = #9a9a9a
const UNLEARNED: color = #7a7060
const RED: color = #ff4040
const WHITE: color = #ffffff
const DIM: color = #a3977f
// The funnel's glyph while a filter is on; a menu's line that takes no click.
const LIT: color = #f0c860
const MENU_DIM: color = #6f6552
// The card's text.
const INK: color = #e8dcc4
// The groove's dark line between the categories and the recipes.
const GROOVE: color = #0000003d
// A text the settings window always shows.
const SETTINGS = "Move mode"
// The card's note that a recipe waits in the queue.
const QUEUED = "Queued: made after the ones ahead."
// Every recipe's name, by which the lists are read.
const NAMES: array<string> = [
  "Linen Bandage", "Linen Cloak", "Brown Linen Vest", "Woolen Cape", "Linen Bag", "Woolen Bag", "Copper Mace", "Trainer's Shirt", "Vendor's Robe"
]

function recipe(
  id: integer, name: string, category: integer, difficulty: Game::Difficulty, craftable: integer, learned: boolean
): Game::Recipe {
  return {
    id: id, name: name, icon: NOTE, categoryID: category, learned: learned, difficulty: difficulty, craftable: craftable
  }
}

function reagent(name: string, item: integer, have: integer, need: integer): Game::Reagent {
  return { itemID: item, name: name, icon: "Interface/Icons/INV_Fabric_Linen_01", have: have, need: need }
}

function reagents(id: integer): array<Game::Reagent> {
  if (id == 110) { return [reagent("Bolt of Linen Cloth", 2589, 3, 1), reagent("Coarse Thread", 2320, 0, 1)] }
  if (id == 111) { return [reagent("Coarse Thread", 2320, 0, 2)] }
  if (id == 120) { return [reagent("Bolt of Linen Cloth", 2589, 6, 3)] }
  if (id == 121) { return [reagent("Bolt of Woolen Cloth", 2997, 0, 3)] }
  return []
}

// Every recipe makes an item but Woolen Bag, which makes none (as an enchant makes none).
function schematic(id: integer): Game::Schematic | nil {
  if (id == 121) { return nil }
  return { recipe: id, makes: 1000 + id, least: 1, most: 1, parts: [] }
}

function professions(): array<Game::Profession> {
  return [
    { skillLine: TAILORING, name: "Tailoring", icon: 136249, rank: 31, max: 75, kind: Game::ProfessionKind::Crafting },
    { skillLine: BLACKSMITHING, name: "Blacksmithing", icon: 136241, rank: 12, max: 75, kind: Game::ProfessionKind::Crafting }
  ]
}

function categories(): array<Game::Category> {
  return [
    { id: 1, name: "Tailoring" },
    { id: 10, name: "Resting at camp", parentID: 1 },
    { id: 11, name: "Cloth armour", parentID: 1 },
    { id: 12, name: "Bags", parentID: 1 },
    { id: 13, name: "Nothing known here", parentID: 1 }
  ]
}

function recipes(): array<Game::Recipe> {
  return [
    recipe(100, "Linen Bandage", 10, Game::Difficulty::Rarely, 4, true),
    recipe(110, "Linen Cloak", 11, Game::Difficulty::Always, 1, true),
    recipe(111, "Brown Linen Vest", 11, Game::Difficulty::Usually, 0, true),
    recipe(112, "Woolen Cape", 11, Game::Difficulty::Never, 0, false),
    recipe(120, "Linen Bag", 12, Game::Difficulty::Usually, 2, true),
    recipe(121, "Woolen Bag", 12, Game::Difficulty::Always, 0, true)
  ]
}

function smithingCategories(): array<Game::Category> {
  return [{ id: 2, name: "Blacksmithing" }, { id: 20, name: "Resting at camp", parentID: 2 }, { id: 21, name: "Weapons", parentID: 2 }]
}

// Blacksmithing: one recipe.
function smithingRecipes(): array<Game::Recipe> {
  return [recipe(200, "Copper Mace", 21, Game::Difficulty::Always, 1, true)]
}

// The professions window: the surface that holds the profession's «Overview» tab.
function window(): Test::Part {
  return Test::page().window("Overview")
}

// A recipe's name where the window shows it.
struct Named {
  mut name: string
  mut top: number
  mut left: number
}

// Every recipe name the window shows, top to bottom, left to right.
function named(): array<Named> {
  let list: array<Named> = mut []
  for (name of NAMES) {
    const texts = window().text(name)
    for (n of 1..texts.count()) {
      const rect = texts.nth(n).rect()
      list.push({ name: name, top: rect.top, left: rect.left })
    }
  }
  list.sort((a, b) => a.top == b.top ? a.left < b.left : a.top < b.top)
  return list
}

// Where the chosen recipe's name on its card stands among them: the card stands right of the lists, so its name is the
// one furthest right; 0 for none.
function cardOf(list: array<Named>): integer {
  let card = 0
  let left: number = 0
  for (index, shown of list) {
    if (card == 0 || shown.left > left) {
      card = index
      left = shown.left
    }
  }
  return card
}

// The recipes the lists show, in the order drawn: every name the window shows but the chosen recipe's on its card.
function listed(): string {
  const list = named()
  const card = cardOf(list)
  let names: array<string> = mut []
  for (index, shown of list) {
    if (index != card) { names.push(shown.name) }
  }
  return names.join(", ")
}

// The chosen recipe: the name on its card.
function chosen(): string {
  const list = named()
  return list[cardOf(list)]?.name ?? ""
}

// Whether a part's texts read exactly this, joined by « | »: where they don't, the test fails with what they read.
function reads(part: Test::Part, expected: string): boolean {
  const read = part.texts().join(" | ")
  if (read != expected) { throw Error { message: `it reads «${read}», not «${expected}»` } }
  return true
}

// Whether two colours are the same as the client keeps them (to three places).
function near(a: color, b: color): boolean {
  return (a.r - b.r).abs() < 0.005 && (a.g - b.g).abs() < 0.005 && (a.b - b.b).abs() < 0.005
}

// Whether the lists read exactly this: where they don't, the test fails with what they read.
function lists(expected: string): boolean {
  const read = listed()
  if (read != expected) { throw Error { message: `the lists read «${read}», not «${expected}»` } }
  return true
}

// Whether the game was asked exactly this since it was last asked, joined by «, ».
function asked(expected: string): boolean {
  const said = Test::requests().join(", ")
  if (said != expected) { throw Error { message: `the game was asked «${said}», not «${expected}»` } }
  return true
}

// A choice of one of the toolbar's pickers: the picker by its glyph, then the choice in its list, which holds `first`.
function pick(glyph: Art, first: string, choice: string) {
  window().button(glyph).click()
  Test::page().window(first).button(choice).click()
}

function view(choice: string) {
  for (glyph of [Ordaen.art.ctl.tool.columns, Ordaen.art.ctl.tool.categories, Ordaen.art.ctl.tool.table]) {
    if (window().button(glyph).shown()) {
      pick(glyph, "In columns", choice)
      return
    }
  }
  throw Error { message: "the view's picker isn't shown" }
}

function sort(choice: string) {
  pick(Ordaen.art.ctl.tool.sort, "By difficulty", choice)
}

// The filter's menu, opened from the funnel.
function filter(): Test::Part {
  if (!Test::page().window("Raises the skill").shown()) { window().button(Ordaen.art.ctl.tool.filter).click() }
  return Test::page().window("Raises the skill")
}

// A line of the open right-click menu clicked: the menu is found by its «Link in chat», which it always shows.
function choose(label: string) {
  Test::page().window("Link in chat").button(label).click()
}

// Ordaen's settings window at the module's page, as `/ordaen professions` opens it.
function settings(): Test::Part {
  (Client::SlashCmdList["ORDAEN"] ?? throw Error { message: "/ordaen is Ordaen's command" })("professions")
  return Test::page().window(SETTINGS)
}

// A setting's checkbox clicked and saved, the settings window closed.
function setting(label: string) {
  const page = settings()
  page.button(label).click()
  page.text(label).hover()
  page.button(Ordaen.art.ctl.corner.close).click()
}

// The views

test "in columns: the categories with recipes, each counted, beside the first one's recipes by difficulty" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  // The camp's has a tab of its own; a category with nothing in it has no row.
  Test::expect(reads(window().text("Cloth armour").item(), "Cloth armour | 1 | /2"))
  Test::expect(reads(window().text("Bags").item(), "Bags | 1 | /2"))
  Test::expect(!window().text("Resting at camp").shown() && !window().text("Nothing known here").shown())
  Test::expect(lists("Linen Cloak, Brown Linen Vest") && chosen() == "Linen Cloak")
}

test "with no spell of its own and off the queue, the recipe runs down to the window's frame: no empty footer under it" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  // The body is the lowest of the wood (the tabs are wood too); the lists run to the page's bottom, the groove down the
  // categories with them; the frame's band alone stands between them: its 16 texels at the window's 0.45.
  Test::expect(lowest(window().box(Ordaen.art.window.wood)) - lowest(window().box(GROOVE)) <= 16 * 0.45 + 0.01)
}

test "the chosen recipe a light, the chosen category cut into the groove" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  // One light, the chosen recipe's; the groove's dark line down the categories and along the chosen one's top and
  // bottom.
  Test::expect(window().box(#e8c89629).count() == 1)
  Test::expect(window().box(#0000003d).count() == 3)
}

// The bottom of the lowest of the boxes found.
function lowest(boxes: Test::Part): number {
  let bottom: number = 0
  for (n of 1..boxes.count()) { bottom = bottom.max(boxes.nth(n).rect().bottom) }
  return bottom
}

test "in columns, a category clicked lists its recipes, the first of them chosen" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  window().button("Bags").click()
  Test::expect(lists("Woolen Bag, Linen Bag") && chosen() == "Woolen Bag")
  window().text("Linen Bag").nth(1).click()
  Test::expect(chosen() == "Linen Bag")
}

test "a category's count of what the bags make now is white while any, dim at none" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = [
    recipe(110, "Linen Cloak", 11, Game::Difficulty::Always, 0, true), recipe(120, "Linen Bag", 12, Game::Difficulty::Usually, 2, true)
  ]
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  Test::expect(reads(window().text("Cloth armour").item(), "Cloth armour | 0 | /1"))
  Test::expect(window().text("Cloth armour").item().text("0").textColor().equal(DIM))
  Test::expect(window().text("Bags").item().text("1").textColor().equal(WHITE))
}

test "by category: one list under the categories' headings, a heading clicked folds its recipes away" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  Test::expect(lists("Linen Cloak, Brown Linen Vest, Woolen Bag, Linen Bag"))
  Test::expect(reads(window().button("Bags"), "- | Bags | 1 | /2"))
  window().button("Cloth armour").click()
  Test::expect(reads(window().button("Cloth armour"), "+ | Cloth armour | 1 | /2") && lists("Woolen Bag, Linen Bag"))
  window().button("Cloth armour").click()
  Test::expect(lists("Linen Cloak, Brown Linen Vest, Woolen Bag, Linen Bag"))
  window().text("Woolen Bag").nth(1).click()
  Test::expect(chosen() == "Woolen Bag")
  // The last of a category too.
  window().text("Linen Bag").nth(1).click()
  Test::expect(chosen() == "Linen Bag")
}

test "by category, a heading's name is gold, «Favorites» white, and its counts follow the bags" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  window().button("Favorite").click()
  const bags = window().button("Bags")
  Test::expect(near(bags.text("Bags").textColor(), YELLOW) && near(window().button("Favorites").text("Favorites").textColor(), WHITE))
  Test::expect(near(bags.text("1").textColor(), WHITE))
  // Starred again: «Favorites» goes, and the first heading is gold; starred once more for what follows.
  window().button("Favorite").click()
  Test::expect(!window().text("Favorites").shown() && near(window().button("Cloth armour").text("Cloth armour").textColor(), YELLOW))
  window().button("Favorite").click()
  // The bags make no bag now, and one more recipe of them is learned.
  Game::tradeSkill.recipes = [
    recipe(100, "Linen Bandage", 10, Game::Difficulty::Rarely, 4, true), recipe(110, "Linen Cloak", 11, Game::Difficulty::Always, 1, true),
    recipe(120, "Linen Bag", 12, Game::Difficulty::Usually, 0, true), recipe(121, "Woolen Bag", 12, Game::Difficulty::Always, 0, true),
    recipe(122, "Red Linen Bag", 12, Game::Difficulty::Always, 0, true)
  ]
  Test::expect(reads(window().button("Bags"), "- | Bags | 0 | /3") && near(window().button("Bags").text("0").textColor(), DIM))
}

test "a table: by name, its headings sort it and the same one again turns it round; the sort's picker goes" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  Test::expect(window().button(Ordaen.art.ctl.tool.sort).shown())
  view("Table")
  Test::expect(!window().button(Ordaen.art.ctl.tool.sort).shown())
  Test::expect(lists("Brown Linen Vest, Linen Bag, Linen Cloak, Woolen Bag"))
  // The name, the skill (none known here), how many; with no reagents the costs are nothing, nothing is bought back.
  Test::expect(reads(window().text("Linen Bag").item(), "Linen Bag | — | 2 | 0g 0s 0c | 0g 0s 0c | — | — | —") && reads(window().text("Woolen Bag").item(), "Woolen Bag | — | - | 0g 0s 0c | 0g 0s 0c | — | — | —"))
  window().button("Available").click()
  Test::expect(lists("Brown Linen Vest, Woolen Bag, Linen Cloak, Linen Bag"))
  window().button("Available").click()
  Test::expect(lists("Linen Bag, Linen Cloak, Woolen Bag, Brown Linen Vest"))
  window().button("Recipe").click()
  Test::expect(lists("Brown Linen Vest, Linen Bag, Linen Cloak, Woolen Bag"))
  window().button("Recipe").click()
  Test::expect(lists("Woolen Bag, Linen Cloak, Linen Bag, Brown Linen Vest"))
  window().text("Linen Cloak").nth(1).click()
  Test::expect(chosen() == "Linen Cloak")
}

test "a table's row says its made item's class and where it is worn, else its kind; «Class» sorts by it, one with none last" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::recipeReader.schematic = schematic
  // The cloak (1110) and the vest (1111) are cloth, worn on the back and the chest; the bag (1120) a bag, not worn, a
  // container; the woolen bag makes nothing.
  Game::items.subtype = (id: integer): string | nil => id == 1110 || id == 1111 ? "Cloth" : id == 1120 ? "Bag" : nil
  Game::items.equipSlot = (id: integer): string | nil => id == 1110 ? "Back" : id == 1111 ? "Chest" : nil
  Game::items.category = (id: integer): string | nil => id == 1120 ? "Container" : id == 1110 || id == 1111 ? "Armor" : nil
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("Table")
  Test::expect(reads(window().text("Linen Cloak").nth(1).item(), "Linen Cloak | — | Cloth | Back | 1 | 0g 0s 0c | 0g 0s 0c | — | — | —"))
  Test::expect(reads(window().text("Linen Bag").item(), "Linen Bag | — | Bag | Container | 2 | 0g 0s 0c | 0g 0s 0c | — | — | —"))
  window().button("Class").click()
  Test::expect(lists("Linen Bag, Brown Linen Vest, Linen Cloak, Woolen Bag"))
  window().button("Class").click()
  // The other way round, two of one class by name the other way too; still last, the one with none.
  Test::expect(lists("Linen Cloak, Brown Linen Vest, Linen Bag, Woolen Bag"))
}

test "a table's class and type wrap onto lines of their own, their row as high as they come to" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::recipeReader.schematic = schematic
  Game::items.subtype = (id: integer): string | nil => id == 1111 ? "Cloth Woven Of Many Long Threads" : "Cloth"
  Game::items.category = (id: integer): string | nil => id == 1111 ? "Armor Of Every Kind There Is" : "Armor"
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("Table")
  const one = heightOf(window().text("Linen Cloak").nth(1))
  Test::expect(heightOf(window().text("Cloth Woven Of Many Long Threads")) > one * 1.5)
  Test::expect(heightOf(window().text("Armor Of Every Kind There Is")) > one * 1.5)
  Test::expect(heightOf(window().text("Brown Linen Vest").nth(1).item()) > heightOf(window().text("Linen Cloak").nth(1).item()))
}

function heightOf(part: Test::Part): number {
  const rect = part.rect()
  return rect.bottom - rect.top
}

test "the camp's tab lists its recipes in one list whatever the view, with no view to pick" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("Table")
  window().button("Camp").click()
  Test::expect(lists("Linen Bandage") && chosen() == "Linen Bandage")
  Test::expect(!window().button(Ordaen.art.ctl.tool.table).shown() && !window().button("Cloth armour").shown())
  window().button("Recipes").click()
  Test::expect(chosen() == "Brown Linen Vest")
}

// The sort

test "by difficulty the hardest to raise the skill last, a tie by name" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = [
    recipe(113, "Grey Cape", 11, Game::Difficulty::Never, 0, true),
    recipe(114, "Green Cape", 11, Game::Difficulty::Rarely, 0, true),
    recipe(115, "Yellow Cape", 11, Game::Difficulty::Usually, 0, true),
    recipe(116, "Brown Cape", 11, Game::Difficulty::Always, 0, true),
    recipe(117, "Amber Cape", 11, Game::Difficulty::Always, 0, true)
  ]
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  const order = window().texts().filter(shown => shown.contains("Cape")).join(", ")
  Test::expect(order == "Amber Cape, Brown Cape, Yellow Cape, Green Cape, Grey Cape, Amber Cape")
}

