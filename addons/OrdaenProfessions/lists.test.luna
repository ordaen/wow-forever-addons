  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  window().button("Bags").click()
  window().text("Woolen Bag").nth(1).rightClick()
  _ = Test::requests()
  const menu = Test::page().window("Link in chat")
  Test::expect(menu.text("Link in chat").textColor().equal(MENU_DIM))
  choose("Link in chat")
  Test::expect(asked("") && Test::page().window("Link in chat").shown())
}

test "the menu's «Create [N]» makes all the bags allow, in the click" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  // The cloak's number is the first: no menu is open, not the cloak's.
  Game::tradeSkill.recipes = [
    recipe(100, "Linen Bandage", 10, Game::Difficulty::Rarely, 4, true), recipe(1, "Linen Cloak", 12, Game::Difficulty::Always, 1, true),
    recipe(120, "Linen Bag", 12, Game::Difficulty::Usually, 2, true)
  ]
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  window().text("Linen Bag").rightClick()
  _ = Test::requests()
  choose("Create [2]")
  Test::expect(asked("TradeSkill.craft 120 2") && !Test::page().window("Link in chat").shown())
  window().button("Queue (1)").click()
  Test::expect(reads(window().text("Linen Bag").item(), "Linen Bag | - | 2 | + | x"))
}

test "the menu's «Create [N]» while a run goes queues the recipe, and the card says it waits" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  window().button("Create").click()
  window().button("Bags").click()
  window().text("Linen Bag").rightClick()
  _ = Test::requests()
  choose("Create [2]")
  Test::expect(asked("") && window().text(QUEUED).shown() && window().button("Queue (2)").shown())
}

test "the menu's «Favorite» stars the recipe and the menu stays; its «Track» is off for one not learned" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  window().button("Not learned").click()
  window().text("Woolen Cape").nth(1).rightClick()
  const menu = Test::page().window("Link in chat")
  Test::expect(menu.text("Track").textColor().equal(MENU_DIM) && !menu.text("Favorite").textColor().equal(MENU_DIM))
  choose("Favorite")
  Test::expect(menu.shown() && window().text("Favorites").shown())
  choose("Favorite")
  Test::expect(!window().text("Favorites").shown())
}

