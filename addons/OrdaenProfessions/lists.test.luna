  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  setting("Remember the last recipe")
  window().button("Bags").click()
  window().text("Linen Bag").nth(1).click()
  setting("Remember the last recipe")
  Game.tradeSkill.categories = smithingCategories()
  Game.tradeSkill.recipes = smithingRecipes()
  Game.tradeSkill.open = BLACKSMITHING
  Test.expect(chosen() == "Copper Mace")
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.open = TAILORING
  Test.expect(chosen() == "Linen Cloak")
}

test "the view, the sort and the table's order are there after a reload" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  sort("By name")
  view("Table")
  window().button("Can make").click()
  window().button("Can make").click()
  Test.reload()
  Test.expect(lists("Linen Bag, Linen Cloak, Woolen Cape, Woolen Bag, Brown Linen Vest"))
  view("One list")
  Test.expect(lists("Brown Linen Vest, Linen Bag, Linen Cloak, Woolen Bag, Woolen Cape"))
}

test "a new profile used: the lists in columns by difficulty, as at first" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  sort("By name")
  const page = settings()
  page.button("Profiles").click()
  page.input().nth(1).type("Raid")
  page.button(Ordaen.art.ctl.check).nth(1).click()
  page.button("New").click()
  page.button(Ordaen.art.ctl.check).nth(2).click()
  page.text("Profiles").hover()
  page.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(window().button("Cloth armour").shown() && lists("Linen Cloak, Brown Linen Vest, Woolen Cape"))
}

// The settings

test "with «Show recipes you haven't learned» off they are left out, and the filter's «Not learned» brings them" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  const unlit = window().button(Ordaen.art.ctl.tool.filter).paintedWith(LIT)
  setting("Show recipes you haven't learned")
  Test.expect(lists("Linen Cloak, Brown Linen Vest") && !unlit && !window().button(Ordaen.art.ctl.tool.filter).paintedWith(LIT))
  Test.expect(filter().button("Reset").paintedWith(Ordaen.art.ctl.buttonDisabled))
  filter().button("Not learned").click()
  Test.expect(lists("Linen Cloak, Brown Linen Vest, Woolen Cape") && window().button(Ordaen.art.ctl.tool.filter).paintedWith(LIT))
  filter().button("Reset").click()
  Test.expect(lists("Linen Cloak, Brown Linen Vest"))
}

test "the setting of recipes not learned says they are dimmed, which is all the rows show of them" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  settings().text("Show recipes you haven't learned").hover()
  Test.expect(Test.page().window("Dimmed.").shown())
}
