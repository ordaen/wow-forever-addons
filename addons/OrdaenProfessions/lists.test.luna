  Game::tradeSkill.open = TAILORING
  view("By category")
  const tabs = window().button("Overview").rect().left < window().button("Recipes").rect().left
  Test::expect(tabs && window().button("Recipes").rect().left < window().button("Not learned").rect().left)
  window().button("Not learned").click()
  Test::expect(lists("Woolen Cape") && chosen() == "Woolen Cape")
  window().button("Recipes").click()
  Test::expect(lists("Linen Cloak, Brown Linen Vest, Woolen Bag, Linen Bag"))
  // The filter has no switch for them any more.
  Test::expect(!filter().button("Not learned").shown() && !filter().button("Learned").shown())
}

test "an option of the filter has its switch on while it is on; «Reset» turns every one back, and only then can be clicked" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  Test::expect(!filter().button("Can make").paintedWith(Ordaen.art.ctl.switchOn))
  Test::expect(filter().button("Reset").paintedWith(Ordaen.art.ctl.buttonDisabled))
  filter().button("Can make").click()
  filter().button("Raises the skill").click()
  Test::expect(filter().button("Can make").paintedWith(Ordaen.art.ctl.switchOn))
  Test::expect(!filter().button("Reset").paintedWith(Ordaen.art.ctl.buttonDisabled))
  filter().button("Reset").click()
  Test::expect(lists("Linen Cloak, Brown Linen Vest, Woolen Bag, Linen Bag"))
  Test::expect(!filter().button("Can make").paintedWith(Ordaen.art.ctl.switchOn) && !filter().button("Raises the skill").paintedWith(Ordaen.art.ctl.switchOn))
}

test "the filter starts as What's Training's: a trainer's, a vendor's or a quest's, none asking a standing" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  // What's Training's: a recipe its trainer teaches, and one a vendor sells to those Friendly with its faction.
  const all: array<Game::Recipe> = mut []
  for (each of recipes()) { all.push(each) }
  all.push(recipe(2393, "Trainer's Shirt", 11, Game::Difficulty::Usually, 0, false))
  all.push(recipe(1301440, "Vendor's Robe", 11, Game::Difficulty::Usually, 0, false))
  Game::tradeSkill.recipes = all
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  window().button("Not learned").click()
  // The robe asks a standing: left out at first.
  Test::expect(listed().contains("Trainer's Shirt") && !listed().contains("Vendor's Robe"))
  filter().button("No reputation asked").click()
  Test::expect(listed().contains("Trainer's Shirt") && listed().contains("Vendor's Robe"))
  filter().button("From a trainer").click()
  Test::expect(!listed().contains("Trainer's Shirt") && listed().contains("Vendor's Robe"))
}

test "the recipes not learned group as What's Training files them, or by the game's categories, as the picker says" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  // The recipes' page has no grouping to pick.
  Test::expect(!window().button(Ordaen.art.ctl.tool.list).shown())
  window().button("Not learned").click()
  // The cape isn't in What's Training's table: nothing is known of the skill it asks.
  Test::expect(reads(window().text("Missing requirements").item(), "Missing requirements | 0 | /1"))
  Test::expect(!window().text("Cloth armour").shown() && lists("Woolen Cape"))
  pick(Ordaen.art.ctl.tool.list, "What you can learn", "Recipe type")
  Test::expect(window().text("Cloth armour").shown() && !window().text("Missing requirements").shown())
}

