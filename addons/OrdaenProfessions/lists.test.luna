  Test::expect(chosen() == "Brown Linen Vest")
}

test "a recipe's row shows the tooltip of the item it makes, and one that makes none its spell's" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = [recipe(1, "Linen Cloak", 11, Game::Difficulty::Always, 1, true), recipe(111, "Brown Linen Vest", 11, Game::Difficulty::Usually, 0, true)]
  Game::recipeReader.schematic = schematic
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  _ = Test::requests()
  window().text("Brown Linen Vest").hover()
  Test::expect(asked("Items.show 1111"))
}

test "«Link in chat» puts the item the recipe makes into the chat and closes the menu" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  // The cloak's number is the first: no menu is open, not the cloak's.
  Game::tradeSkill.recipes = [recipe(1, "Linen Cloak", 11, Game::Difficulty::Always, 1, true), recipe(111, "Brown Linen Vest", 11, Game::Difficulty::Usually, 0, true)]
  Game::recipeReader.schematic = schematic
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  window().text("Brown Linen Vest").rightClick()
  _ = Test::requests()
  choose("Link in chat")
  Test::expect(asked("Chat.link 1111") && !Test::page().window("Link in chat").shown())
}

test "a recipe that makes no item has its link dim, and a click on it does nothing" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
