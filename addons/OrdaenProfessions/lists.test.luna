// The professions window's recipes as the player meets them: the four views, the sort, the filter, the search, the
// colours and marks of a recipe, the chosen recipe's card, the right-click menu, and what the window remembers. Each
// test opens Tailoring on the test's game (`Game.tradeSkill`): its camp's recipe, three in «Cloth armour» (one not
// learned), two in «Bags», and a category with none.
import Client from "$client"
import Game from "$game"
import { Art } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { Kept, Pause } from "@/view"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const TAILORING = 197
const BLACKSMITHING = 164
const NOTE: Art = "Interface/Icons/INV_Misc_Note_01"
const CLOTH_ICON: Art = "Interface/Icons/INV_Chest_Cloth_01"
const WOOL_ICON: Art = "Interface/Icons/INV_Fabric_Wool_01"
// A recipe's name: in its difficulty's colour, dim while not learned.
const ORANGE: Color = Color.hex("#ff8040")
const YELLOW: Color = Color.hex("#ffd100")
const GREEN: Color = Color.hex("#40c040")
const GREY: Color = Color.hex("#9a9a9a")
const UNLEARNED: Color = Color.hex("#7a7060")
const RED: Color = Color.hex("#ff4040")
const WHITE: Color = Color.hex("#ffffff")
const DIM: Color = Color.hex("#a3977f")
// The funnel's glyph while a filter is on; a menu's line that takes no click.
const LIT: Color = Color.hex("#f0c860")
const MENU_DIM: Color = Color.hex("#6f6552")
// A text the settings window always shows.
const SETTINGS = "Move mode"
// The card's note that a recipe waits in the queue.
const QUEUED = "Queued: made after the ones ahead."
// Every recipe's name, by which the lists are read.
const NAMES: Array<String> = [
  "Linen Bandage", "Linen Cloak", "Brown Linen Vest", "Woolen Cape", "Linen Bag", "Woolen Bag", "Copper Mace"
]

function recipe(
  id: Integer, name: String, category: Integer, difficulty: Game.Difficulty, craftable: Integer, learned: Boolean
): Game.Recipe {
  return {
    id: id, name: name, icon: NOTE, categoryID: category, learned: learned, difficulty: difficulty, craftable: craftable
  }
}

function reagent(name: String, item: Integer, have: Integer, need: Integer): Game.Reagent {
  return { itemID: item, name: name, icon: "Interface/Icons/INV_Fabric_Linen_01", have: have, need: need }
}

function reagents(id: Integer): Array<Game.Reagent> {
  if (id == 110) { return [reagent("Bolt of Linen Cloth", 2589, 3, 1), reagent("Coarse Thread", 2320, 0, 1)] }
  if (id == 111) { return [reagent("Coarse Thread", 2320, 0, 2)] }
  if (id == 120) { return [reagent("Bolt of Linen Cloth", 2589, 6, 3)] }
  if (id == 121) { return [reagent("Bolt of Woolen Cloth", 2997, 0, 3)] }
  return []
}

// Every recipe makes an item but Woolen Bag, which makes none (as an enchant makes none).
function schematic(id: Integer): Game.Schematic | nil {
  if (id == 121) { return nil }
  return { recipe: id, makes: 1000 + id, least: 1, most: 1, parts: [] }
}

function professions(): Array<Game.Profession> {
  return [
    { skillLine: TAILORING, name: "Tailoring", icon: 136249, rank: 31, max: 75, kind: Game.ProfessionKind.Crafting },
    { skillLine: BLACKSMITHING, name: "Blacksmithing", icon: 136241, rank: 12, max: 75, kind: Game.ProfessionKind.Crafting }
  ]
}

function categories(): Array<Game.Category> {
  return [
    { id: 1, name: "Tailoring" },
    { id: 10, name: "Resting at camp", parentID: 1 },
    { id: 11, name: "Cloth armour", parentID: 1 },
    { id: 12, name: "Bags", parentID: 1 },
    { id: 13, name: "Nothing known here", parentID: 1 }
  ]
}

function recipes(): Array<Game.Recipe> {
  return [
    recipe(100, "Linen Bandage", 10, Game.Difficulty.Rarely, 4, true),
    recipe(110, "Linen Cloak", 11, Game.Difficulty.Always, 1, true),
    recipe(111, "Brown Linen Vest", 11, Game.Difficulty.Usually, 0, true),
    recipe(112, "Woolen Cape", 11, Game.Difficulty.Never, 0, false),
    recipe(120, "Linen Bag", 12, Game.Difficulty.Usually, 2, true),
    recipe(121, "Woolen Bag", 12, Game.Difficulty.Always, 0, true)
  ]
}

function smithingCategories(): Array<Game.Category> {
  return [{ id: 2, name: "Blacksmithing" }, { id: 20, name: "Resting at camp", parentID: 2 }, { id: 21, name: "Weapons", parentID: 2 }]
}

// Blacksmithing: one recipe.
function smithingRecipes(): Array<Game.Recipe> {
  return [recipe(200, "Copper Mace", 21, Game.Difficulty.Always, 1, true)]
}

// The professions window: the surface that holds the profession's «Overview» tab.
function window(): Test.Part {
  return Test.page().window("Overview")
}

// The recipes the lists show, in the order drawn: the window's texts that name a recipe, but the chosen recipe's on
// its card, the last.
function listed(): String {
  let names: Array<String> = []
  for (shown of window().texts()) {
    if (NAMES.any(name => name == shown)) { names.push(shown) }
  }
  _ = names.pop()
  return names.join(", ")
}

// The chosen recipe: the name on its card, under which its skill line stands.
function chosen(): String {
  let names: Array<String> = []
  for (shown of window().texts()) {
    if (NAMES.any(name => name == shown)) { names.push(shown) }
  }
  return names[names.length] ?? ""
}

// Whether a part's texts read exactly this, joined by « | »: where they don't, the test fails with what they read.
function reads(part: Test.Part, expected: String): Boolean {
  const read = part.texts().join(" | ")
  if (read != expected) { panic(`it reads «${read}», not «${expected}»`) }
  return true
}

// Whether two colours are the same as the client keeps them (to three places).
function near(a: Color, b: Color): Boolean {
  return (a.r - b.r).abs() < 0.005 && (a.g - b.g).abs() < 0.005 && (a.b - b.b).abs() < 0.005
}

// Whether the lists read exactly this: where they don't, the test fails with what they read.
function lists(expected: String): Boolean {
  const read = listed()
  if (read != expected) { panic(`the lists read «${read}», not «${expected}»`) }
  return true
}

// Whether the game was asked exactly this since it was last asked, joined by «, ».
function asked(expected: String): Boolean {
  const said = Test.requests().join(", ")
  if (said != expected) { panic(`the game was asked «${said}», not «${expected}»`) }
  return true
}

// A choice of one of the toolbar's pickers: the picker by its glyph, then the choice in its list, which holds `first`.
function pick(glyph: Art, first: String, choice: String) {
  window().button(glyph).click()
  Test.page().window(first).button(choice).click()
}

function view(choice: String) {
  for (glyph of [Ordaen.art.ctl.tool.columns, Ordaen.art.ctl.tool.categories, Ordaen.art.ctl.tool.list, Ordaen.art.ctl.tool.table]) {
    if (window().button(glyph).shown()) {
      pick(glyph, "In columns", choice)
      return
    }
  }
  panic("the view's picker isn't shown")
}

function sort(choice: String) {
  pick(Ordaen.art.ctl.tool.sort, "By difficulty", choice)
}

// The filter's menu, opened from the funnel.
function filter(): Test.Part {
  if (!Test.page().window("Raises the skill").shown()) { window().button(Ordaen.art.ctl.tool.filter).click() }
  return Test.page().window("Raises the skill")
}

// A line of the open right-click menu clicked: the menu is found by its «Link in chat», which it always shows.
function choose(label: String) {
  Test.page().window("Link in chat").button(label).click()
}

// Ordaen's settings window at the module's page, as `/ordaen professions` opens it.
function settings(): Test.Part {
  (Client.SlashCmdList["ORDAEN"] ?? panic("/ordaen is Ordaen's command"))("professions")
  return Test.page().window(SETTINGS)
}

// A setting's checkbox clicked and saved, the settings window closed.
function setting(label: String) {
  const page = settings()
  page.button(label).click()
  page.button("Save").click()
  page.text(label).hover()
  page.button(Ordaen.art.ctl.corner.close).click()
}

// The views

test "in columns: the categories with recipes, each counted, beside the first one's recipes by difficulty" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  // The camp's has a tab of its own; a category with nothing in it has no row.
  Test.expect(reads(window().text("Cloth armour").item(), "Cloth armour | 3 | (1)"))
  Test.expect(reads(window().text("Bags").item(), "Bags | 2 | (1)"))
  Test.expect(!window().text("Resting at camp").shown() && !window().text("Nothing known here").shown())
  Test.expect(lists("Linen Cloak, Brown Linen Vest, Woolen Cape") && chosen() == "Linen Cloak")
}

test "in columns, a category clicked lists its recipes, the first of them chosen" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  window().button("Bags").click()
  Test.expect(lists("Woolen Bag, Linen Bag") && chosen() == "Woolen Bag")
  window().text("Linen Bag").nth(1).click()
  Test.expect(chosen() == "Linen Bag")
}

test "a category's count of what the bags make now is white while any, dim at none" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = [
    recipe(110, "Linen Cloak", 11, Game.Difficulty.Always, 0, true), recipe(120, "Linen Bag", 12, Game.Difficulty.Usually, 2, true)
  ]
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(reads(window().text("Cloth armour").item(), "Cloth armour | 1 | (0)"))
  Test.expect(window().text("Cloth armour").item().text("(0)").textColor().equal(DIM))
  Test.expect(window().text("Bags").item().text("(1)").textColor().equal(WHITE))
}

test "by category: one list under the categories' headings, a heading clicked folds its recipes away" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("By category")
  Test.expect(lists("Linen Cloak, Brown Linen Vest, Woolen Cape, Woolen Bag, Linen Bag"))
  Test.expect(reads(window().button("Bags"), "- | Bags | 2 | (1)"))
  window().button("Cloth armour").click()
  Test.expect(reads(window().button("Cloth armour"), "+ | Cloth armour | 3 | (1)") && lists("Woolen Bag, Linen Bag"))
  window().button("Cloth armour").click()
  Test.expect(lists("Linen Cloak, Brown Linen Vest, Woolen Cape, Woolen Bag, Linen Bag"))
  window().text("Woolen Bag").nth(1).click()
  Test.expect(chosen() == "Woolen Bag")
  // The last of a category too.
  window().text("Linen Bag").nth(1).click()
  Test.expect(chosen() == "Linen Bag")
}

test "by category, a heading's name is gold, «Favorites» white, and its counts follow the bags" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("By category")
  window().button("Favorite").click()
  const bags = window().button("Bags")
  Test.expect(near(bags.text("Bags").textColor(), YELLOW) && near(window().button("Favorites").text("Favorites").textColor(), WHITE))
  Test.expect(near(bags.text("(1)").textColor(), WHITE))
  // Starred again: «Favorites» goes, and the first heading is gold; starred once more for what follows.
  window().button("Favorite").click()
  Test.expect(!window().text("Favorites").shown() && near(window().button("Cloth armour").text("Cloth armour").textColor(), YELLOW))
  window().button("Favorite").click()
  // The bags make no bag now, and one more recipe of them is learned.
  Game.tradeSkill.recipes = [
    recipe(100, "Linen Bandage", 10, Game.Difficulty.Rarely, 4, true), recipe(110, "Linen Cloak", 11, Game.Difficulty.Always, 1, true),
    recipe(120, "Linen Bag", 12, Game.Difficulty.Usually, 0, true), recipe(121, "Woolen Bag", 12, Game.Difficulty.Always, 0, true),
    recipe(122, "Red Linen Bag", 12, Game.Difficulty.Always, 0, true)
  ]
  Test.expect(reads(window().button("Bags"), "- | Bags | 3 | (0)") && near(window().button("Bags").text("(0)").textColor(), DIM))
}

test "one list: every recipe but the camp's, by difficulty" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  Test.expect(lists("Linen Cloak, Woolen Bag, Brown Linen Vest, Linen Bag, Woolen Cape"))
  window().text("Linen Bag").nth(1).click()
  Test.expect(chosen() == "Linen Bag")
}

test "a table: by name, its headings sort it and the same one again turns it round; the sort's picker goes" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(window().button(Ordaen.art.ctl.tool.sort).shown())
  view("Table")
  Test.expect(!window().button(Ordaen.art.ctl.tool.sort).shown())
  Test.expect(lists("Brown Linen Vest, Linen Bag, Linen Cloak, Woolen Bag, Woolen Cape"))
  Test.expect(reads(window().text("Linen Bag").item(), "Linen Bag | 2 | 0g 0s 0c | —") && reads(window().text("Woolen Bag").item(), "Woolen Bag | - | 0g 0s 0c | —"))
  window().button("Can make").click()
  Test.expect(lists("Brown Linen Vest, Woolen Bag, Woolen Cape, Linen Cloak, Linen Bag"))
  window().button("Can make").click()
  Test.expect(lists("Linen Bag, Linen Cloak, Woolen Cape, Woolen Bag, Brown Linen Vest"))
  window().button("Recipe").click()
  Test.expect(lists("Brown Linen Vest, Linen Bag, Linen Cloak, Woolen Bag, Woolen Cape"))
  window().button("Recipe").click()
  Test.expect(lists("Woolen Cape, Woolen Bag, Linen Cloak, Linen Bag, Brown Linen Vest"))
  window().text("Linen Cloak").nth(1).click()
  Test.expect(chosen() == "Linen Cloak")
}

test "the camp's tab lists its recipes in one list whatever the view, with no view to pick" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("Table")
  window().button("Camp").click()
  Test.expect(lists("Linen Bandage") && chosen() == "Linen Bandage")
  Test.expect(!window().button(Ordaen.art.ctl.tool.table).shown() && !window().button("Cloth armour").shown())
  window().button("Recipes").click()
  Test.expect(chosen() == "Brown Linen Vest")
}

// The sort

test "by difficulty the learned come first, the hardest to raise the skill last, a tie by name" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = [
    recipe(112, "Woolen Cape", 11, Game.Difficulty.Always, 0, false),
    recipe(113, "Grey Cape", 11, Game.Difficulty.Never, 0, true),
    recipe(114, "Green Cape", 11, Game.Difficulty.Rarely, 0, true),
    recipe(115, "Yellow Cape", 11, Game.Difficulty.Usually, 0, true),
    recipe(116, "Brown Cape", 11, Game.Difficulty.Always, 0, true),
    recipe(117, "Amber Cape", 11, Game.Difficulty.Always, 0, true)
  ]
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  const order = window().texts().filter(shown => shown.contains("Cape")).join(", ")
  Test.expect(order == "Amber Cape, Brown Cape, Yellow Cape, Green Cape, Grey Cape, Woolen Cape, Amber Cape")
}

test "by name the recipes stand in the alphabet's order, learned or not" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  sort("By name")
  Test.expect(lists("Brown Linen Vest, Linen Bag, Linen Cloak, Woolen Bag, Woolen Cape"))
}

test "by «Can make» the most the bags make stands first, a tie by name" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  sort("Can make")
  Test.expect(lists("Linen Bag, Linen Cloak, Brown Linen Vest, Woolen Bag, Woolen Cape"))
}

test "two recipes of one name stand by their numbers, whichever way they came" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = [recipe(121, "Linen Bag", 12, Game.Difficulty.Always, 3, true), recipe(120, "Linen Bag", 12, Game.Difficulty.Always, 2, true)]
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  // The first, by its number, is chosen: its count on its row.
  Test.expect(reads(window().text("Linen Bag").nth(1).item(), "Linen Bag | [2]"))
  view("Table")
  Test.expect(reads(window().text("Linen Bag").nth(1).item(), "Linen Bag | 2 | 0g 0s 0c | —"))
}

// The filter

test "the filter's «Can make» leaves what the bags make now, «Raises the skill» what still raises it" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = [
    recipe(110, "Linen Cloak", 11, Game.Difficulty.Always, 1, true),
    recipe(111, "Brown Linen Vest", 11, Game.Difficulty.Usually, 0, true),
    recipe(120, "Linen Bag", 12, Game.Difficulty.Never, 2, true)
  ]
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  filter().button("Can make").click()
  Test.expect(lists("Linen Cloak, Linen Bag"))
  filter().button("Raises the skill").click()
  Test.expect(lists("Linen Cloak"))
  filter().button("Can make").click()
  Test.expect(lists("Linen Cloak, Brown Linen Vest"))
}

test "the filter's «Learned» and «Not learned» each take theirs away" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  filter().button("Not learned").click()
  Test.expect(lists("Linen Cloak, Woolen Bag, Brown Linen Vest, Linen Bag"))
  filter().button("Not learned").click()
  filter().button("Learned").click()
  Test.expect(window().text("Woolen Cape").count() == 2 && chosen() == "Woolen Cape")
}

test "an option of the filter is ticked while it is on; «Reset» turns every one back, and only then can be clicked" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  Test.expect(filter().button("Learned").paintedWith(Ordaen.art.ctl.tick) && !filter().button("Can make").paintedWith(Ordaen.art.ctl.tick))
  Test.expect(filter().button("Reset").paintedWith(Ordaen.art.ctl.buttonDisabled))
  filter().button("Can make").click()
  filter().button("Raises the skill").click()
  filter().button("Learned").click()
  Test.expect(filter().button("Can make").paintedWith(Ordaen.art.ctl.tick) && !filter().button("Learned").paintedWith(Ordaen.art.ctl.tick))
  Test.expect(!filter().button("Reset").paintedWith(Ordaen.art.ctl.buttonDisabled))
  filter().button("Reset").click()
  Test.expect(lists("Linen Cloak, Woolen Bag, Brown Linen Vest, Linen Bag, Woolen Cape"))
  Test.expect(filter().button("Learned").paintedWith(Ordaen.art.ctl.tick) && filter().button("Not learned").paintedWith(Ordaen.art.ctl.tick))
  Test.expect(!filter().button("Can make").paintedWith(Ordaen.art.ctl.tick) && !filter().button("Raises the skill").paintedWith(Ordaen.art.ctl.tick))
}

test "a click anywhere but the filter's menu closes it" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(filter().shown())
  window().button("Recipes").click()
  Test.expect(!Test.page().window("Raises the skill").shown())
}

test "the funnel's tip names the options ticked, or that none is" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  window().button(Ordaen.art.ctl.tool.filter).hover()
  Test.expect(reads(Test.page().window("Filter"), "Filter | Learned, Not learned"))
  filter().button("Can make").click()
  filter().button("Raises the skill").click()
  window().button("Recipes").click()
  window().button(Ordaen.art.ctl.tool.filter).hover()
  Test.expect(reads(Test.page().window("Filter"), "Filter | Can make, Raises the skill, Learned, Not learned"))
  filter().button("Can make").click()
  filter().button("Raises the skill").click()
  filter().button("Learned").click()
  filter().button("Not learned").click()
  window().button("Recipes").click()
  window().button(Ordaen.art.ctl.tool.filter).hover()
  Test.expect(reads(Test.page().window("Filter"), "Filter | Nothing ticked"))
}

test "the funnel is lit while a filter is on" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  const unlit = window().button(Ordaen.art.ctl.tool.filter).paintedWith(LIT)
  filter().button("Raises the skill").click()
  window().button("Recipes").click()
  Test.expect(!unlit && window().button(Ordaen.art.ctl.tool.filter).paintedWith(LIT))
}

// The search

test "the search finds a recipe by its name or by a reagent's, in any case" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  window().input().type("BAG")
  Test.expect(lists("Woolen Bag, Linen Bag"))
  Test.erase(3)
  Test.type("woolen cloth")
  Test.expect(lists("Woolen Bag"))
  Test.erase(12)
  Test.type("coarse")
  Test.expect(lists("Linen Cloak, Brown Linen Vest"))
  Test.erase(6)
  Test.expect(lists("Linen Cloak, Woolen Bag, Brown Linen Vest, Linen Bag, Woolen Cape"))
}

test "the search reads a recipe's reagents once, not again at each letter typed" {
  let readings = 0
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = (id: Integer): Array<Game.Reagent> => {
    readings += 1
    return reagents(id)
  }
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  window().input().type("c")
  const once = readings
  Test.type("oarse")
  Test.expect(lists("Linen Cloak, Brown Linen Vest") && readings - once <= 1)
}

test "reagents the game told late are searched once the profession is opened again" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  window().input().type("coarse")
  Test.expect(lists("") && !window().text("Linen Cloak").shown())
  Game.tradeSkill.reagents = reagents
  Game.tradeSkill.categories = smithingCategories()
  Game.tradeSkill.recipes = smithingRecipes()
  Game.tradeSkill.open = BLACKSMITHING
  Test.expect(lists(""))
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.open = TAILORING
  Test.expect(lists("Linen Cloak, Brown Linen Vest"))
}

// A recipe's row

test "a recipe's name is in its difficulty's colour, one not learned dim; what the bags make stands at its right" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  view("One list")
  Test.expect(window().text("Woolen Bag").textColor().equal(ORANGE) && window().text("Brown Linen Vest").textColor().equal(YELLOW))
  Test.expect(window().text("Woolen Cape").textColor().equal(UNLEARNED))
  window().button("Camp").click()
  Test.expect(window().text("Linen Bandage").nth(1).textColor().equal(GREEN))
  window().button("Recipes").click()
  Test.expect(reads(window().text("Linen Bag").item(), "Linen Bag | [2]") && reads(window().text("Woolen Bag").item(), "Woolen Bag"))
}

test "a recipe that no longer raises the skill is grey" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = [recipe(110, "Linen Cloak", 11, Game.Difficulty.Always, 1, true), recipe(111, "Brown Linen Vest", 11, Game.Difficulty.Never, 0, true)]
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(window().text("Brown Linen Vest").textColor().equal(GREY))
}

// The chosen recipe's card

test "the card: the recipe's name, what making it does for the skill, its description and what the work needs" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.description = (id: Integer): String => id == 110 ? "A plain cloak of linen." : ""
  Game.tradeSkill.requirements = (id: Integer): Array<Game.Requirement> => id == 110 ? [{ name: "Sewing kit", met: true }, { name: "Loom", met: false }] : []
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(window().text("Always raises the skill").textColor().equal(ORANGE) && window().text("A plain cloak of linen.").shown())
  // A need missing is red.
  Test.expect(window().text("Needs: Sewing kit\n|cffff4040Needs: Loom|r").shown())
  window().text("Brown Linen Vest").click()
  Test.expect(window().text("Usually raises the skill").textColor().equal(YELLOW) && !window().text("A plain cloak of linen.").shown())
  window().button("Bags").click()
  window().text("Linen Bag").nth(1).click()
  Test.expect(window().text("Usually raises the skill").shown())
  window().button("Camp").click()
  Test.expect(window().text("Rarely raises the skill").textColor().equal(GREEN))
}

test "the card of a recipe not learned says so in red, and has no make row and no «Track»" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(window().button("Create").shown() && window().text("Track").shown())
  window().text("Woolen Cape").click()
  Test.expect(window().text("Not learned").textColor().equal(RED) && window().text("Doesn't raise the skill").count() == 0)
  Test.expect(!window().button("Create").shown() && !window().text("Track").shown() && window().text("Favorite").shown())
}

test "a recipe grey for the skill says it doesn't raise it" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
