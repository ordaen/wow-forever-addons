  window().button("Track").click()
  Test::reload()
  Test::expect(window().text("Favorites").shown() && window().button("Track").paintedWith(Ordaen.art.ctl.switchOn))
  Test::expect(window().button("Favorite").paintedWith(Ordaen.art.ctl.switchOn))
}

test "a hundred starred is the most: one more takes off the one starred first" {
  // Kept from an earlier session: the cloak starred first, then ninety-eight recipes of other professions.
  let favorites: array<integer> = mut [110]
  for (id of 1..98) { favorites.push(5000 + id) }
  Game::saved.store(.Character, "OrdaenProfessions:memory", Kept { last: 0, seen: {}, favorites: favorites, tracked: [], queue: [], paused: {} })
  Test::reload()
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  Test::expect(window().button("Favorite").paintedWith(Ordaen.art.ctl.switchOn))
  // The hundredth: every one stays.
  window().button("Cloth armour").click()
  window().text("Brown Linen Vest").click()
  window().button("Favorite").click()
  Test::expect(reads(window().text("Favorites").item(), "Favorites | 1 | /2"))
  // The hundred and first: the cloak goes.
  window().button("Bags").click()
  window().button("Favorite").click()
  Test::expect(reads(window().text("Favorites").item(), "Favorites | 0 | /2"))
  window().button("Favorites").click()
  Test::expect(lists("Woolen Bag, Brown Linen Vest"))
}

