// The search

test "the search finds a recipe by its name or by a reagent's, in any case" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.reagents = reagents
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  window().input().type("BAG")
  Test::expect(lists("Woolen Bag, Linen Bag"))
  Test::erase(3)
  Test::type("woolen cloth")
  Test::expect(lists("Woolen Bag"))
  Test::erase(12)
  Test::type("coarse")
  Test::expect(lists("Linen Cloak, Brown Linen Vest"))
  Test::erase(6)
  Test::expect(lists("Linen Cloak, Brown Linen Vest, Woolen Bag, Linen Bag"))
}

test "the search reads a recipe's reagents once, not again at each letter typed" {
  let readings = 0
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.reagents = (id: integer): array<Game::Reagent> => {
    readings += 1
    return reagents(id)
  }
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  window().input().type("c")
  const once = readings
  Test::type("oarse")
  Test::expect(lists("Linen Cloak, Brown Linen Vest") && readings - once <= 1)
}

test "reagents the game told late are searched once the profession is opened again" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  window().input().type("coarse")
  Test::expect(lists("") && !window().text("Linen Cloak").shown())
  Game::tradeSkill.reagents = reagents
  Game::tradeSkill.categories = smithingCategories()
  Game::tradeSkill.recipes = smithingRecipes()
  Game::tradeSkill.open = BLACKSMITHING
  Test::expect(lists(""))
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.open = TAILORING
  Test::expect(lists("Linen Cloak, Brown Linen Vest"))
}

// A recipe's row

test "a recipe's name is in its difficulty's colour, one not learned in what it would be now; what the bags make stands at its right" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  view("By category")
  Test::expect(window().text("Woolen Bag").textColor().equal(ORANGE) && window().text("Brown Linen Vest").textColor().equal(YELLOW))
  window().button("Camp").click()
  Test::expect(window().text("Linen Bandage").nth(1).textColor().equal(GREEN))
  window().button("Recipes").click()
  Test::expect(reads(window().text("Linen Bag").item(), "Linen Bag | [2]") && reads(window().text("Woolen Bag").item(), "Woolen Bag"))
  window().button("Not learned").click()
  // The cape, which the skill table doesn't know, in what it would be now (grey), not the old dim.
  Test::expect(!window().text("Woolen Cape").nth(1).textColor().equal(UNLEARNED))
}

test "a recipe not learned takes what it would do for the skill now; a learned one keeps the client's" {
  const table: Thresholds = { yellow: { [112]: 50, [113]: 20 }, grey: { [112]: 70, [113]: 30 } }
  const cape = learnable(recipe(112, "Woolen Cape", 11, Game::Difficulty::Never, 0, false), table, 31)
  const shirt = learnable(recipe(113, "Linen Shirt", 11, Game::Difficulty::Never, 0, false), table, 31)
  const vest = learnable(recipe(111, "Brown Linen Vest", 11, Game::Difficulty::Usually, 0, true), table, 31)
  Test::expect(cape.difficulty == Game::Difficulty::Always && shirt.difficulty == Game::Difficulty::Never)
  Test::expect(vest.difficulty == Game::Difficulty::Usually)
}

test "a recipe that no longer raises the skill is grey" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = [recipe(110, "Linen Cloak", 11, Game::Difficulty::Always, 1, true), recipe(111, "Brown Linen Vest", 11, Game::Difficulty::Never, 0, true)]
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  Test::expect(window().text("Brown Linen Vest").textColor().equal(GREY))
}

// The chosen recipe's card

test "the card: the recipe's name, what making it does for the skill, its description and what the work needs" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.description = (id: integer): string => id == 110 ? "A plain cloak of linen." : ""
  Game::tradeSkill.requirements = (id: integer): array<Game::Requirement> => id == 110 ? [{ name: "Sewing kit", met: true }, { name: "Loom", met: false }] : []
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  Test::expect(window().text("Always raises the skill").textColor().equal(ORANGE) && window().text("A plain cloak of linen.").shown())
  // A need missing is red.
  Test::expect(window().text("Needs: Sewing kit\n|cffff4040Needs: Loom|r").shown())
  window().text("Brown Linen Vest").click()
  Test::expect(window().text("Usually raises the skill").textColor().equal(YELLOW) && !window().text("A plain cloak of linen.").shown())
  window().button("Bags").click()
  window().text("Linen Bag").nth(1).click()
  Test::expect(window().text("Usually raises the skill").shown())
  window().button("Camp").click()
  Test::expect(window().text("Rarely raises the skill").textColor().equal(GREEN))
}

test "the card of a recipe not learned says so in red, and has nothing of making it: no tools, no switches, no make row" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  Game::tradeSkill.recipes = recipes()
  Game::tradeSkill.requirements = (id: integer): array<Game::Requirement> => [{ name: "Loom", met: false }]
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  Test::expect(window().button("Create").shown() && window().text("Track").shown() && window().text("|cffff4040Needs: Loom|r").shown())
  window().button("Not learned").click()
  Test::expect(window().text("Not learned").nth(2).textColor().equal(RED) && window().text("Doesn't raise the skill").count() == 0)
  Test::expect(!window().button("Create").shown() && !window().text("Track").shown() && !window().text("Favorite").shown())
  Test::expect(!window().text("|cffff4040Needs: Loom|r").shown())
}

test "the card of a recipe not learned has two tabs: where to learn it, a table row a place, and its prices, each with its footer" {
  Game::frames.Professions = Client::CreateFrame("Frame", "ProfessionsFrame", Client::UIParent, nil)
  Game::professions.list = professions()
  Game::tradeSkill.categories = categories()
  // What's Training's: a recipe the trainer teaches.
  Game::tradeSkill.recipes = [recipe(2393, "Trainer's Shirt", 11, Game::Difficulty::Usually, 0, false)]
  Test::mount(nil, SCREEN)
  Game::tradeSkill.open = TAILORING
  window().button("Not learned").click()
  // «Where to learn» first: its table, the trainer's row (the place, its way, no distance known, its price), and in
  // its footer the map's button, off with no vendor to show.
  Test::expect(window().button("Where to learn").shown() && window().button("Name").shown() && window().button("Distance").shown())
  const row = window().text("Trainer").item().texts()
  Test::expect(row[1]?.contains("Profession trainer, from skill") == true && row[2] == "Trainer" && row[3] == "—")
  Test::expect(window().button("Show the nearest on the map").shown())
  // «Prices & costs»: the prices' footer in its place.
  window().button("Prices & costs").click()
  Test::expect(!window().text("Trainer").shown() && !window().button("Show the nearest on the map").shown())
}

test "a recipe grey for the skill says it doesn't raise it" {
