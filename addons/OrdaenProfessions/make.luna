// The make row, at the foot of the chosen recipe's card while the recipe is learned: how many (a count, the skill points to gain,
// or all the bags allow), the count with − and + unless «All» (one at least; by «Quantity» what the bags make now;
// by «Raise skill» the points left before the rank's most), what that comes to in small dim text, and «Create», which
// never makes more than the bags make now: with nothing to make, the count and «Create» are disabled.
import Game from "$game"
import { Align, Track } from "$ltml"
import { Choice, CompactDropdown, Component, CountInput, PushButton, PX, space } from "Ordaen"
import Locale from "@/locales"
import { expectedMakings } from "@/skillUps"
import Style from "@/style"
import { MakeMode } from "@/view"

// The mode, the count with its − and +, what it comes to, «Create».
const MAKE: Array<Track> = ["auto", "auto", { fr: 1 }, "auto"]
const STEP = 28 * PX
const MODE_WIDTH = 140 * PX
const MODES: Array<Choice<MakeMode>> = [
  { value: MakeMode.Count, label: Locale.MAKE_COUNT },
  { value: MakeMode.Skill, label: Locale.MAKE_SKILL },
  { value: MakeMode.All, label: Locale.MAKE_ALL },
]

public class MakeRow implements Component {
  // «Create» clicked, with how many: making must start in the click.
  public create: Event<Integer> = new Event()

  derived counted: Boolean = self.mode != MakeMode.All
  // The most the count may be: by «Quantity», what the bags make now; by «Raise skill», the points left before the
  // rank's most.
  derived most: Integer = self.mostOf()
  // How many making the recipe raises the skill by the count takes; none once it would turn grey first.
  derived expected: Integer | nil = self.expectedOf()
  // How many «Create» makes.
  derived making: Integer = self.makingOf()
  derived hint: String = self.hintOf()
  derived cannot: Boolean = self.making < 1
  // What the bags make of the recipe now.
  derived craftable: Integer = self.recipe?.craftable ?? 0

  recipe: Signal<Game.Recipe | nil>
  count: mut Signal<Integer>
  mode: mut Signal<MakeMode>
  profession: Signal<Game.Profession | nil>
  yellow: Signal<Integer | nil>
  grey: Signal<Integer | nil>
  constructor(
    recipe: Signal<Game.Recipe | nil>,
    // How many to make, or skill points to gain.
    count: mut Signal<Integer>,
    mode: mut Signal<MakeMode>,
    // The profession open: its skill, and the most its rank allows.
    profession: Signal<Game.Profession | nil>,
    // The skill at which the recipe turns yellow and grey; none where the client's table hasn't it.
    yellow: Signal<Integer | nil>,
    grey: Signal<Integer | nil>,
  ) {
    self.recipe = recipe
    self.count = count
    self.mode = mode
    self.profession = profession
    self.yellow = yellow
    self.grey = grey
  }

  expectedOf(self): Integer | nil {
    const profession = self.profession
    const yellow = self.yellow
    const grey = self.grey
    if (profession == nil || yellow == nil || grey == nil) { return nil }
    return expectedMakings(profession.rank, profession.max, yellow, grey, self.count)
  }

  mostOf(self): Integer {
    if (self.mode != MakeMode.Skill) { return self.craftable }
    const profession = self.profession
    return profession == nil ? 0 : profession.max - profession.rank
  }

  // What «Create» makes: never more than the bags make now.
  makingOf(self): Integer {
    const craftable = self.craftable
    return match (self.mode) {
      MakeMode.Count => self.count.min(craftable),
      MakeMode.Skill => (self.expected ?? 0).min(craftable),
      MakeMode.All => craftable,
    }
  }

  hintOf(self): String {
    return match (self.mode) {
      MakeMode.Count => "",
      MakeMode.Skill => self.expected == nil ? Locale.MAKE_NO_SKILL : Locale.MAKE_ABOUT.format(self.expected ?? 0),
      MakeMode.All => Locale.MAKE_PIECES.format(self.making),
    }
  }

  onCreate(mut self) {
    if (!self.cannot) { self.create.emit(self.making) }
  }

  public render(self): Template {
    return $ltml {
      <box columns={MAKE} gap={space(.Item)} yAlign={Align.Center}>
        <CompactDropdown value={mut self.mode} choices={MODES} width={MODE_WIDTH} />
        <CountInput $if={self.counted} value={mut self.count} least={1} most={self.most} step={STEP} />
        <box $else />
        <text value={self.hint} textSize={.Secondary} textColor={Style.DIM} />
        <PushButton label={Locale.CREATE} width={110 * PX} disabled={self.cannot} @click={self.onCreate} />
      </box>
    }
  }
}
