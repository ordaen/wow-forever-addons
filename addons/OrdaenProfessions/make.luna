// The make row, under the chosen recipe's description while the recipe is learned: how many (a count, or the skill
// points to gain), the count with − and + (one at least; by «Quantity» what the bags make now; by «Raise skill» the
// points left before the rank's most) and «Create», which never makes more than the bags make now: with nothing to
// make, the count and «Create» are disabled. Under it, what that comes to in small dim text.
import Game from "$game"
import { Align, Track } from "$ltml"
import { Choice, CompactDropdown, Component, CountInput, PushButton, SECONDARY_TEXT } from "Ordaen"
import Locale from "@/locales"
import { expectedMakings } from "@/skillUps"
import Style from "@/style"
import { MakeMode } from "@/view"

// The mode, the count with its − and +, the room left, «Create»; what it comes to on a line of its own.
const MAKE: Array<Track> = ["max-content", "max-content", { fr: 1 }, "max-content"]
const STEP = 32.8125dp
const MODE_WIDTH = 164.0625dp
const MODES: Array<Choice<MakeMode>> = [
  { value: MakeMode.Count, label: Locale.MAKE_COUNT },
  { value: MakeMode.Skill, label: Locale.MAKE_SKILL }
]

// Where the shown recipe stands in the queue: not in it, waiting in it, or being made.
public enum Queueing { None, Waiting, Making }

public class MakeRow implements Component {
  // «Create» clicked, with how many: making must start in the click.
  public create: Event<Integer> = new Event()
  // «Stop» or «Remove from queue» clicked: the recipe leaves the queue, its run ending with the craft under way.
  public drop: Event<nil> = new Event()

  derived making: Boolean = self.queueing == Queueing.Making
  derived button: String = match (self.queueing) {
    Queueing.None => Locale.CREATE
    Queueing.Waiting => Locale.UNQUEUE
    Queueing.Making => Locale.STOP
  }
  derived blocked: Boolean = self.queueing == Queueing.None && self.cannot

  // The most the count may be: by «Quantity», what the bags make now; by «Raise skill», the points left before the
  // rank's most.
  derived most: Integer = self.mostOf()
  // How many making the recipe raises the skill by the count takes; none once it would turn grey first.
  derived expected: Integer | nil = self.expectedOf()
  // How many «Create» makes.
  derived makes: Integer = self.makingOf()
  derived hint: String = self.hintOf()
  derived cannot: Boolean = self.makes < 1
  // What the bags make of the recipe now.
  derived craftable: Integer = self.recipe?.craftable ?? 0

  recipe: Signal<Game.Recipe | nil>
  count: mut Signal<Integer>
  mode: mut Signal<MakeMode>
  profession: Signal<Game.Profession | nil>
  yellow: Signal<Integer | nil>
  grey: Signal<Integer | nil>
  queueing: Signal<Queueing>
  constructor(
    recipe: Signal<Game.Recipe | nil>,
    // How many to make, or skill points to gain.
    count: mut Signal<Integer>,
    mode: mut Signal<MakeMode>,
    // The profession open: its skill, and the most its rank allows.
    profession: Signal<Game.Profession | nil>,
    // The skill at which the recipe turns yellow and grey; none where the client's table hasn't it.
    yellow: Signal<Integer | nil>,
    grey: Signal<Integer | nil>,
    queueing: Signal<Queueing> = Queueing.None
  ) {
    self.recipe = recipe
    self.count = count
    self.mode = mode
    self.profession = profession
    self.yellow = yellow
    self.grey = grey
    self.queueing = queueing
  }

  expectedOf(self): Integer | nil {
    const profession = self.profession
    const yellow = self.yellow
    const grey = self.grey
    if (profession == nil || yellow == nil || grey == nil) { return nil }
    return expectedMakings(profession.rank, profession.max, yellow, grey, self.count)
  }

  mostOf(self): Integer {
    if (self.mode != MakeMode.Skill) { return self.craftable }
    const profession = self.profession
    return profession == nil ? 0 : profession.max - profession.rank
  }

  // What «Create» makes: never more than the bags make now.
  makingOf(self): Integer {
    const craftable = self.craftable
    return match (self.mode) {
      MakeMode.Count => self.count.min(craftable)
      MakeMode.Skill => (self.expected ?? 0).min(craftable)
    }
  }

  hintOf(self): String {
    return match (self.mode) {
      MakeMode.Count => ""
      MakeMode.Skill => self.expected == nil ? Locale.MAKE_NO_SKILL : Locale.MAKE_ABOUT.format(self.expected ?? 0)
    }
  }

  onClick(mut self) {
    if (self.queueing != Queueing.None) {
      self.drop.emit()
    } else if (!self.cannot) {
      self.create.emit(self.makes)
    }
  }

  public render(self): Template {
    return $ltml {
      <box columns={MAKE} gap={3sp} yAlign={Align.Center}>
        <CompactDropdown value={mut self.mode} choices={MODES} width={MODE_WIDTH} disabled={self.making} />
        <CountInput value={mut self.count} least={1} most={self.most} step={STEP} />
        <box />
        <PushButton label={self.button} width={128.90625dp} disabled={self.blocked} @click={self.onClick} />
        <text value={self.hint} textSize={SECONDARY_TEXT} textColor={Style.DIM} columnSpan={4} />
      </box>
    }
  }
}
