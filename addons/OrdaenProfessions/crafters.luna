// Ordaen Professions' lines in an item's tooltip, added to Ordaen Tooltips' `uses` section: the characters whose known
// recipes take the item, as the recipe book has them (every character's professions as each last opened them):
// «Used in crafting», then a line for each character and profession, «Ann — Tailoring», the player's own character
// first, its name in the colour of the best recipe for its skill among those it knows taking the item. In a locked tooltip the name opens the list of those recipes, each opening the item it makes,
// with how many of the item that character holds under them. Nothing for an item no known recipe takes.
import Game from "$game"
import { ItemId } from "Ordaen"
import root Alts from "OrdaenAlts"
import root Tooltips from "OrdaenTooltips"
import type { ItemLines, Line, Listed } from "OrdaenTooltips"
import { Book, playerName } from "@/book"
import Locale from "@/locales"
import { Thresholds, difficultyAt, thresholdsOf } from "@/skillUps"
import Style from "@/style"

const NONE: Array<Line> = []
const HEAD: Color = Color.hex("#ffd100")

// A character who knows recipes of a profession taking an item, and which.
public struct Crafter {
  profession: String
  skillLine: Integer
  guid: String
  name: String
  // The character's skill in the profession, when last opened.
  rank: Integer
  recipes: Array<Integer>
}

// A list of an item's crafters, empty, for its first.
function none(): mut Array<Crafter> { return [] }

// Every item a known recipe takes, with its crafters by profession, in the order first met: made once as the book
// changes, a map read for each tooltip.
public function craftersOf(book: Book): Map<Integer, Array<Crafter>> {
  const found: Map<Integer, mut Array<Crafter>> = {}
  // Where an item's crafter stands in its list, by «item, profession, character».
  const at: Map<String, Integer> = {}
  for (guid, shelf of book.characters) {
    for (skillLine, learned of shelf.professions) {
      for (recipe of learned.recipes) {
        for (part of book.recipes[recipe]?.parts ?? []) {
          const list = found[part.item] ?? none()
          found[part.item] = list
          const key = `${part.item}\n${skillLine}\n${guid}`
          const index = at[key]
          const crafter = index == nil ? nil : list[index]
          if (crafter == nil) {
            list.push({
              profession: learned.name, skillLine: skillLine, guid: guid, name: shelf.name, rank: learned.rank,
              recipes: [recipe]
            })
            at[key] = list.length
          } else if (index != nil && !crafter.recipes.any((known: Integer) => known == recipe)) {
            const recipes: Array<Integer> = []
            for (known of crafter.recipes) { recipes.push(known) }
            recipes.push(recipe)
            list[index] = { recipes: recipes, ..crafter }
          }
        }
      }
    }
  }
  return found
}

// A recipe that takes an item, as a character who knows it sees it: its name, what making it does for the
// character's skill and that difficulty's colour, the item it makes (none for an enchant).
public struct CraftRecipe {
  name: String
  difficulty: Game.Difficulty
  color: Color
  makes: Integer | nil
}

// A character's profession whose known recipes take an item: the recipes, and the best of them for skilling up with
// its colour.
public struct Crafting {
  skillLine: Integer
  profession: String
  guid: String
  name: String
  rank: Integer
  best: Game.Difficulty
  bestColor: Color
  recipes: Array<CraftRecipe>
}

// The order a difficulty is better in for skilling up: orange first.
public function skillUpRank(difficulty: Game.Difficulty): Integer {
  return match (difficulty) {
    Game.Difficulty.Always => 0
    Game.Difficulty.Usually => 1
    Game.Difficulty.Rarely => 2
    Game.Difficulty.Never => 3
  }
}

// A crafter's recipes as it sees them, at its rank, by the profession's thresholds; the best first met.
public function craftingOf(crafter: Crafter, book: Book, table: Thresholds): Crafting {
  let best = Game.Difficulty.Never
  const recipes: Array<CraftRecipe> = []
  for (recipe of crafter.recipes) {
    const difficulty = difficultyAt(table, recipe, crafter.rank)
    if (skillUpRank(difficulty) < skillUpRank(best)) { best = difficulty }
    const entry = book.recipes[recipe]
    recipes.push({ name: entry?.name ?? "", difficulty: difficulty, color: Style.difficultyColor(difficulty), makes: entry?.makes })
  }
  return {
    skillLine: crafter.skillLine, profession: crafter.profession, guid: crafter.guid, name: crafter.name,
    rank: crafter.rank, best: best, bestColor: Style.difficultyColor(best), recipes: recipes
  }
}

// Who crafts with each item, as `craftersOf` gives it: read as a tooltip asks, so the tooltip follows the book.
public type CraftersRead = () => Map<Integer, Array<Crafter>>
// The book itself, for the recipes' names and what they make.
public type BookRead = () => Book

// How many of an item a character holds, bags and bank, by Ordaen Alts' records; the bags alone for the character
// played while Alts is off, nothing for another.
function heldBy(guid: String, item: Integer): Integer {
  const alts = Alts
  if (alts == nil) { return guid == Game.player.guid ? (Game.bags.holdings() ?? {})[item] ?? 0 : 0 }
  let count = 0
  for (held of alts.holders(ItemId.of(item))) {
    if (held.who == guid) { count += held.count }
  }
  return count
}

public class CraftersLines implements ItemLines {
  const crafters: CraftersRead
  const book: BookRead
  constructor(crafters: CraftersRead, book: BookRead) {
    self.crafters = crafters
    self.book = book
  }

  public lines(self, item: Integer, link: String): Array<Line> {
    const found = self.crafters()[item]
    if (found == nil || found.length == 0) { return NONE }
    const me = Game.player.guid
    const book = self.book()
    const thresholds: Map<Integer, Thresholds> = {}
    const lines: Array<Line> = [{ left: Locale.USED_IN, color: HEAD }]
    // Each profession in the order first met, the character played first in it.
    const professions: Array<Integer> = []
    for (crafter of found) {
      if (!professions.any(line => line == crafter.skillLine)) { professions.push(crafter.skillLine) }
    }
    for (skillLine of professions) {
      const table = thresholds[skillLine] ?? thresholdsOf(skillLine)
      thresholds[skillLine] = table
      for (own of [true, false]) {
        for (crafter of found) {
          if (crafter.skillLine == skillLine && (crafter.guid == me) == own) {
            lines.push(self.lineOf(crafter, item, book, table))
          }
        }
      }
    }
    return lines
  }

  // A crafter's line: its name in its best recipe's colour, opening the recipes; its profession at the right.
  lineOf(self, crafter: Crafter, item: Integer, book: Book, table: Thresholds): Line {
    const crafting = craftingOf(crafter, book, table)
    const rows: Array<Listed> = []
    for (index, recipe of crafting.recipes) {
      const yellow = table.yellow[crafter.recipes[index] ?? 0]
      rows.push({
        left: recipe.name, right: yellow == nil ? nil : String.of(yellow), color: recipe.color,
        item: recipe.makes
      })
    }
    const own = crafter.guid == Game.player.guid
    return {
      left: own ? playerName() : crafter.name, right: crafter.profession, color: crafting.bestColor,
      rightColor: Style.DIM,
      opens: {
        name: `${crafter.profession}: ${crafter.name}`, rows: rows,
        foot: [{ left: Locale.CRAFTER_HOLDS, right: String.of(heldBy(crafter.guid, item)) }]
      }
    }
  }
}

// The lines, added to Tooltips' `uses` while Tooltips is on: the watch's run owns them, so they end when either
// module does. Without Tooltips the root import stays nil and nothing is added.
public class TooltipCrafters {
  const lines: CraftersLines
  constructor(crafters: CraftersRead, book: BookRead) {
    self.lines = new CraftersLines(crafters, book)
    watch (tooltips of Tooltips) {
      if (tooltips == nil) { return }
      tooltips.uses.add(self.lines)
    }
  }
}
