// PageTabs: the professions window's pages (recipes, overview, worth, queue) as tabs set in a band of the game's dark
// marble across the window's whole width, under what stands over them (the skill bar). The picked tab is the window's
// wood, ruled on its top and sides and open at its foot into the page below; the others stand flat on the marble over
// the band's bottom line, which runs on past them to the band's ends. A prototype of the professions window's design:
// Ordaen's `Tabs` draws every other window's.
import { Align, Art, ByInteractionState, Edges, Line, Side, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, Component, WINDOW_ROOM } from "Ordaen"
import Style from "@/style"

const LINE_WIDTH = 1.171875dp
// The picked tab: ruled on its top and sides, open at its foot. The others and the band's ends: the band's bottom line.
const OPEN: Line = { width: LINE_WIDTH, color: Style.LINE, sides: [Side.Top, Side.Left, Side.Right] }
const FOOT: Line = { width: LINE_WIDTH, color: Style.LINE, sides: [Side.Bottom] }
const CLEAR: Color = Color.hex("#00000000")
const SHADE: ByInteractionState<Color> = { default: CLEAR, hover: Color.hex("#00000033"), focus: Color.hex("#00000033") }
const NAME: ByInteractionState<Color> = { default: Color.hex("#a3977f"), hover: Color.hex("#e8dcc4"), focus: Color.hex("#e8dcc4") }
const TAB_PAD: Edges = { top: 2.5sp, right: 6sp, bottom: 2.5sp, left: 6sp }
// The band's room over what it holds, and at each side of it (the window's own room, as the page under it keeps).
const BAND_PAD: Edges = { top: 4sp }
const HEAD_PAD: Edges = { right: WINDOW_ROOM, bottom: 4sp, left: WINDOW_ROOM }
const BAND_ROWS: Array<Track> = ["max-content", "max-content"]

// One tab of the band.
class PageTab implements Component {
  derived picked: Boolean = self.selected == self.index
  derived border: Line = self.picked ? OPEN : FOOT
  derived background: Art | ByInteractionState<Color> = self.picked ? Ordaen.art.window.wood : SHADE
  derived color: Color | ByInteractionState<Color> = self.picked ? BRIGHT_TEXT : NAME

  label: Signal<String>
  const index: Integer
  selected: mut Signal<Integer>
  constructor(label: Signal<String>, index: Integer, selected: mut Signal<Integer>) {
    self.label = label
    self.index = index
    self.selected = selected
  }

  pick(mut self) { self.selected = self.index }

  public render(self): Template {
    return $ltml {
      <box padding={TAB_PAD} border={self.border} background={self.background} yAlign={Align.Center}
           @pointerPress={self.pick} @keyPress(.Enter)={self.pick} @keyPress(.Space)={self.pick}>
        <text value={self.label} textColor={self.color} wrap={.None} />
      </box>
    }
  }
}

public class PageTabs implements Component {
  // The band's left end, a column as wide as each tab, and the rest of the band.
  derived columns: Array<Track> = self.tracks()

  tabs: Signal<Array<String>>
  selected: mut Signal<Integer>
  constructor(tabs: Signal<Array<String>>, selected: mut Signal<Integer>) {
    self.tabs = tabs
    self.selected = selected
  }

  tracks(self): Array<Track> {
    let list: Array<Track> = [Ordaen.lengthOf(WINDOW_ROOM)]
    for (name of self.tabs) { list.push("max-content") }
    list.push({ fr: 1 })
    return list
  }

  public render(self): Template {
    return $ltml {
      <box rows={BAND_ROWS} padding={BAND_PAD} background={Ordaen.art.window.marble}>
        // What stands over the tabs (the skill bar), in the window's room.
        <box padding={HEAD_PAD}>
          <slot />
        </box>
        <box columns={self.columns} yAlign={Align.Stretch}>
          <box border={FOOT} />
          <PageTab $for={index, name of self.tabs} label={name} index={index} selected={mut self.selected} />
          <box border={FOOT} />
        </box>
      </box>
    }
  }
}
