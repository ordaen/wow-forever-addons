// The rows of the professions window's lists: a category, a recipe, a reagent. A category and a recipe are the
// library's `SelectItem`: a faint rule between them, a light under the cursor, the chosen one filled in its colour
// with a 2 px edge of it at its left (a recipe's, its difficulty's; a category's, the gold). A recipe's row says
// what was clicked (`Act`): the left button picks it, the right one opens its menu.
import Game from "$game"
import { Align, Art, Click, Edges, Line, MouseButton, Position, Track } from "$ltml"
import { Component, Money, PX, SelectItem, space, TableRow } from "Ordaen"
import { Totals } from "@/cost"
import { RecipeMenu } from "@/menu"
import Style from "@/style"
import { Act, FAVORITES, Group, has, Kept, members } from "@/view"

const NAME_COUNT: Array<Track> = [{ fr: 1 }, "auto"]
const MARKS: Array<Track> = ["auto", "auto"]
const CATEGORY_PAD: Edges = { top: 7 * PX, right: space(.Panel), bottom: 7 * PX, left: space(.Panel) }
const RECIPE_PAD: Edges = { top: 6 * PX, right: space(.Panel), bottom: 6 * PX, left: space(.Panel) }
// A recipe under a heading stands in past the heading's fold mark.
const INDENT_PAD: Edges = { top: 6 * PX, right: space(.Panel), bottom: 6 * PX, left: space(.Panel) + 18 * PX }
const FOLD: Array<Track> = [10 * PX, { fr: 1 }, "auto"]
const SLOT = 32 * PX
const REAGENT: Array<Track> = [SLOT, { fr: 1 }, "auto"]
const REAGENT_PAD: Edges = { top: 3 * PX, right: 6 * PX, bottom: 3 * PX }
// The pip of a recipe the player starred: between its name and its count.
const STAR = 8 * PX
const STAR_RIGHT = 46 * PX
const STAR_TOP = 8 * PX

// A group in the recipes' first column: its name in gold (white for the favorites), and `N (M)` at the right, N its
// recipes, M how many of them the bags can make now (white when any).
public class CategoryRow implements Component {
  // Its id.
  public pick: Event<Integer> = new Event()

  derived isChosen: Boolean = self.chosen == self.group.id
  derived first: Boolean = self.index == 1
  derived nameColor: Color = self.group.id == FAVORITES ? Style.WHITE : Style.GOLD
  derived makeableColor: Color = self.group.makeable > 0 ? Style.WHITE : Style.DIM

  group: Signal<Group>
  index: Signal<Integer>
  chosen: Signal<Integer>
  constructor(
    group: Signal<Group>,
    // Its place in the list: the first has no rule above it.
    index: Signal<Integer>,
    // The chosen group's id.
    chosen: Signal<Integer>,
  ) {
    self.group = group
    self.index = index
    self.chosen = chosen
  }

  onClick(mut self, click: Click) { self.pick.emit(self.group.id) }

  public render(self): Template {
    return $ltml {
      <SelectItem selected={self.isChosen} first={self.first} columns={NAME_COUNT} padding={CATEGORY_PAD}
                  @pick={self.onClick}>
        <text value={self.group.name} textColor={self.nameColor} textShadow={Style.SHADOW} />
        <box columns={MARKS} gap={3 * PX} yAlign={Align.Center}>
          <text value={"%d"} arguments={[self.group.total]} textColor={Style.DIM} wrap={false}
                textFont={.Numbers} />
          <text value={"(%d)"} arguments={[self.group.makeable]} textColor={self.makeableColor} wrap={false}
                textFont={.Numbers} />
        </box>
      </SelectItem>
    }
  }
}

// A recipe: its name in its difficulty's colour (an unlearned one dim), a gold pip when the player starred it, `[N]`
// at the right for how many the bags can make now. Its menu stands under it while the window says it is the one open.
public class RecipeRow implements Component {
  public act: Event<(Act, Integer)> = new Event()

  derived isChosen: Boolean = self.chosen == self.recipe.id
  derived first: Boolean = self.index == 1
  // Chosen, it is filled in its own colour.
  derived tint: Color | nil = self.color
  derived color: Color = self.recipe.learned ? Style.difficultyColor(self.recipe.difficulty) : Style.OFF
  derived count: String = self.recipe.craftable > 0 ? "[%d]".format(self.recipe.craftable) : ""
  derived starred: Boolean = has(self.kept.favorites, self.recipe.id)
  derived padding: Edges = self.indent ? INDENT_PAD : RECIPE_PAD
  derived menuOpen: Boolean = self.menuFor == self.recipe.id

  recipe: Signal<Game.Recipe>
  index: Signal<Integer>
  chosen: Signal<Integer>
  kept: Signal<Kept>
  menuFor: Signal<Integer>
  const indent: Boolean
  constructor(
    recipe: Signal<Game.Recipe>,
    index: Signal<Integer>,
    // The chosen recipe's id.
    chosen: Signal<Integer>,
    kept: Signal<Kept>,
    // The id of the recipe whose menu is open; 0 for none.
    menuFor: Signal<Integer>,
    // Under a heading of the one list.
    indent: Boolean = false,
  ) {
    self.recipe = recipe
    self.index = index
    self.chosen = chosen
    self.kept = kept
    self.menuFor = menuFor
    self.indent = indent
  }

  onClick(self, click: Click) {
    self.act.emit(click.button == MouseButton.Right ? Act.Menu : Act.Pick, self.recipe.id)
  }

  onAct(self, act: Act, id: Integer) { self.act.emit(act, id) }

  public render(self): Template {
    return $ltml {
      <SelectItem selected={self.isChosen} color={self.tint} first={self.first} columns={NAME_COUNT}
                  padding={self.padding} @pick={self.onClick}>
        <text value={self.recipe.name} textColor={self.color} textShadow={Style.SHADOW} wrap={false} />
        <text value={self.count} textColor={Style.WHITE} wrap={false} textFont={.Numbers} />
        <box $if={self.starred} position={Position.Absolute} right={STAR_RIGHT} top={STAR_TOP} width={STAR}
             height={STAR} background={Style.GOLD} />
        <RecipeMenu $if={self.menuOpen} recipe={self.recipe} kept={self.kept} @act={self.onAct} />
      </SelectItem>
    }
  }
}

// A group of the one list with headings: its heading (a fold mark, its name, `N (M)`) and, while it isn't folded, its
// recipes under it.
public class CategoryGroup implements Component {
  public act: Event<(Act, Integer)> = new Event()

  state folded = false
  derived list: Array<Game.Recipe> = members(self.shown, self.group.id, self.kept.favorites)
  derived mark: String = self.folded ? "+" : "-"
  derived nameColor: Color = self.group.id == FAVORITES ? Style.WHITE : Style.GOLD
  derived makeableColor: Color = self.group.makeable > 0 ? Style.WHITE : Style.DIM

  group: Signal<Group>
  shown: Signal<Array<Game.Recipe>>
  chosen: Signal<Integer>
  kept: Signal<Kept>
  menuFor: Signal<Integer>
  constructor(
    group: Signal<Group>,
    // Every recipe the search and the filter let through.
    shown: Signal<Array<Game.Recipe>>,
    chosen: Signal<Integer>,
    kept: Signal<Kept>,
    menuFor: Signal<Integer>,
  ) {
    self.group = group
    self.shown = shown
    self.chosen = chosen
    self.kept = kept
    self.menuFor = menuFor
  }

  fold(mut self) { self.folded = !self.folded }
  onAct(self, act: Act, id: Integer) { self.act.emit(act, id) }

  public render(self): Template {
    return $ltml {
      <box columns={1}>
        <box columns={FOLD} gap={8 * PX} padding={CATEGORY_PAD} yAlign={Align.Center} border={Style.ROW_RULE}
             background={Style.ROW_LIGHT} @click={self.fold}>
          <text value={self.mark} textColor={Style.DIM} wrap={false} />
          <text value={self.group.name} textColor={self.nameColor}
                textShadow={Style.SHADOW} />
          <box columns={MARKS} gap={3 * PX} yAlign={Align.Center}>
            <text value={"%d"} arguments={[self.group.total]} textColor={Style.DIM} wrap={false}
                  textFont={.Numbers} />
            <text value={"(%d)"} arguments={[self.group.makeable]} textColor={self.makeableColor} wrap={false}
                  textFont={.Numbers} />
          </box>
        </box>
        <$if={!self.folded}>
          <RecipeRow $for={index, recipe of self.list} $key={recipe.id} recipe={recipe} index={index}
                     chosen={self.chosen} kept={self.kept} menuFor={self.menuFor} indent={true}
                     @act={self.onAct} />
        </>
      </box>
    }
  }
}

// A recipe in the table: the library's row, its name in its difficulty's colour and how many can be made now.
public class RecipeTableRow implements Component {
  public act: Event<(Act, Integer)> = new Event()

  derived isChosen: Boolean = self.chosen == self.recipe.id
  derived color: Color = self.recipe.learned ? Style.difficultyColor(self.recipe.difficulty) : Style.OFF
  derived count: String = self.recipe.craftable > 0 ? "%d".format(self.recipe.craftable) : "-"
  derived menuOpen: Boolean = self.menuFor == self.recipe.id
  // One making's cost and profit, with prices; «—» where a part has no price.
  derived totals: Totals | nil = self.worth[self.recipe.id]
  derived hasCost: Boolean = self.totals?.cost != nil
  derived hasProfit: Boolean = self.totals?.profit != nil
  derived cost: Integer = self.totals?.cost ?? 0
  derived profit: Integer = (self.totals?.profit ?? 0).abs()
  derived losing: Boolean = (self.totals?.profit ?? 0) < 0
  derived profitColor: Color = self.losing ? Style.RED : Style.WHITE

  recipe: Signal<Game.Recipe>
  tracks: Signal<Array<Track>>
  chosen: Signal<Integer>
  kept: Signal<Kept>
  menuFor: Signal<Integer>
  worth: Signal<Map<Integer, Totals>>
  priced: Signal<Boolean>
  constructor(
    recipe: Signal<Game.Recipe>,
    tracks: Signal<Array<Track>>,
    chosen: Signal<Integer>,
    kept: Signal<Kept>,
    menuFor: Signal<Integer>,
    // Each recipe's totals, and whether the table has their columns.
    worth: Signal<Map<Integer, Totals>> = {},
    priced: Signal<Boolean> = false,
  ) {
    self.recipe = recipe
    self.tracks = tracks
    self.chosen = chosen
    self.kept = kept
    self.menuFor = menuFor
    self.worth = worth
    self.priced = priced
  }

  // The library's row says which button picked it: the left one chooses the recipe, the right one opens its menu.
  onPick(self, click: Click) {
    self.act.emit(click.button == MouseButton.Right ? Act.Menu : Act.Pick, self.recipe.id)
  }

  onAct(self, act: Act, id: Integer) { self.act.emit(act, id) }

  public render(self): Template {
    return $ltml {
      <box columns={1}>
        <TableRow tracks={self.tracks} selected={self.isChosen} @pick={self.onPick}>
          <text value={self.recipe.name} textColor={self.color} textShadow={Style.SHADOW} wrap={false} />
          <box xAlign={Align.End}>
            <text value={self.count} textColor={Style.WHITE} wrap={false} textFont={.Numbers} />
          </box>
          <$if={self.priced}>
            <box xAlign={Align.End}>
              <Money $if={self.hasCost} amount={self.cost} />
              <text $else value={"—"} textColor={Style.DIM} />
            </box>
            <box xAlign={Align.End} columns={["auto", "auto"]} gap={2 * PX}>
              <text $if={self.losing} value={"-"} textColor={Style.RED} />
              <Money $if={self.hasProfit} amount={self.profit} color={self.profitColor} />
              <text $else value={"—"} textColor={Style.DIM} />
            </box>
          </>
        </TableRow>
        <RecipeMenu $if={self.menuOpen} recipe={self.recipe} kept={self.kept} @act={self.onAct} />
      </box>
    }
  }
}

// A reagent of the chosen recipe: its icon in a slot, its name, have / need (red when short).
public class ReagentRow implements Component {
  derived rule: Line | nil = self.index > 1 ? Style.ROW_RULE : nil
  derived icon: Art = self.reagent.icon
  derived color: Color = self.reagent.have < self.reagent.need ? Style.RED : Style.INK

  reagent: Signal<Game.Reagent>
  index: Signal<Integer>
  constructor(
    reagent: Signal<Game.Reagent>,
    index: Signal<Integer>,
  ) {
    self.reagent = reagent
    self.index = index
  }

  public render(self): Template {
    return $ltml {
      <box columns={REAGENT} gap={8 * PX} yAlign={Align.Center} padding={REAGENT_PAD} border={self.rule}>
        <box width={SLOT} height={SLOT} border={Style.BRONZE} icon={self.icon} />
        <text value={self.reagent.name} textColor={Style.INK} />
        <text value={"%d / %d"} arguments={[self.reagent.have, self.reagent.need]} wrap={false} textColor={self.color}
              textFont={.Numbers} />
      </box>
    }
  }
}
