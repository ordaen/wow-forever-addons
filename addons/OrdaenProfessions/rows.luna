// The rows of the professions window's lists: a category, a recipe, a reagent. A category and a recipe are a
// `TabItem`: a faint rule between them, a light under the cursor, the chosen one open into the section beside it (a
// category on the recipes' stained wood, cut into the groove between them; a recipe a plain light). A recipe's row
// says what was clicked (`Act`): the left button picks it, the right one opens its menu.
import Game from "$game"
import { Align, Art, Edges, Frame, Line, MouseButton, Position, Track } from "$ltml"
import { BRIGHT_TEXT, Component, Ground, ItemButton, Money, TableCell, TableRow, WINDOW_ROOM } from "Ordaen"
import { RecipeMenu } from "@/menu"
import { BothSources, SourceTotals, betterOf, roughCost, roughProfit } from "@/split"
import Style from "@/style"
import { TabItem } from "@/tabItem"
import { Act, FAVORITES, Group, Kept, TableFacts, has, members } from "@/view"

const NO_SIDE: SourceTotals = { cost: nil, missing: [], sale: nil, profit: nil, filled: [], unpriced: [] }
const NO_SOURCES: BothSources = { auction: NO_SIDE, merchant: NO_SIDE }

// An amount of money in a table's cell at its right, «~» before it where it leaves parts out; «—» for none.
class SourceCell implements Component {
  derived has: boolean = self.amount != nil

  amount: Signal<integer | nil>
  rough: Signal<boolean>
  constructor(amount: Signal<integer | nil>, rough: Signal<boolean>) {
    self.amount = amount
    self.rough = rough
  }

  public render(): Template {
    return $ltml {
      <box xAlign={Align::End} columns={{ each: "max-content" }} gap={0.5sp}>
        <text $if={self.rough && self.has} value={"~"} textColor={Style::DIM} />
        <Money $if={self.has} amount={self.amount ?? 0} />
        <text $else value={"—"} textColor={Style::DIM} />
      </box>
    }
  }
}

const NAME_COUNT: array<Track> = [{ fr: 1 }, "max-content"]
const MARKS: array<Track> = ["max-content", "max-content"]
// The categories stand at the window's left line: their names keep the window's room, as the toolbar over them does.
const CATEGORY_PAD: Edges = { top: 2sp, right: 5sp, bottom: 2sp, left: WINDOW_ROOM }
const RECIPE_PAD: Edges = { top: 2sp, right: 5sp, bottom: 2sp, left: Style::RECIPE_PAD }
// A recipe under a heading stands in past the heading's fold mark.
const INDENT_PAD: Edges = { top: 2sp, right: 5sp, bottom: 2sp, left: Style::RECIPE_PAD + 5.5sp }
const FOLD: array<Track> = [11.71875dp, { fr: 1 }, "max-content"]
const SLOT = 37.5dp
const REAGENT: array<Track> = [SLOT, { fr: 1 }, "max-content"]
const REAGENT_PAD: Edges = { top: 1sp, right: 2sp, bottom: 1sp }
// The pip of a recipe the player starred: between its name and its count.
const STAR = 9.375dp
const STAR_RIGHT = 53.90625dp
const STAR_TOP = 9.375dp

// A group in the recipes' first column: its name in gold (the favorites' in the text's own white), and `N (M)` at
// the right, N its recipes, M how many of them the bags can make now (the text's own white when any, else dim).
public class CategoryRow implements Component {
  // Its id.
  public pick: Event<integer> = new Event()

  derived isChosen: boolean = self.chosen == self.group.id
  derived first: boolean = self.index == 1
  derived nameColor: Color | nil = self.group.id == FAVORITES ? nil : Style::GOLD
  derived makeableColor: Color | nil = self.group.makeable > 0 ? nil : Style::DIM

  group: Signal<Group>
  index: Signal<integer>
  chosen: Signal<integer>
  constructor(
    group: Signal<Group>,
    // Its place in the list: the first has no rule above it.
    index: Signal<integer>,
    // The chosen group's id.
    chosen: Signal<integer>
  ) {
    self.group = group
    self.index = index
    self.chosen = chosen
  }

  mut onClick(button: MouseButton) { self.pick.emit(self.group.id) }

  public render(): Template {
    return $ltml {
      <TabItem selected={self.isChosen} into={Style::RECIPES} groove={true} first={self.first} columns={NAME_COUNT} padding={CATEGORY_PAD}
               @pick={self.onClick}>
        <text value={self.group.name} textColor={self.nameColor} textShadow={Style::SHADOW} />
        <box columns={MARKS} yAlign={Align::Center}>
          <text value={"%d"} arguments={[self.group.makeable]} textColor={self.makeableColor} wrap={.None}
                textFont={.Numbers} />
          <text value={"/%d"} arguments={[self.group.total]} textColor={Style::DIM} wrap={.None}
                textFont={.Numbers} />
        </box>
      </TabItem>
    }
  }
}

// A recipe's tooltip beside its row: the item it makes, as the game's professions window shows it; the recipe's own
// spell for one that makes none (an enchant).
public function showRecipe(frame: any Frame, recipe: integer) {
  const made = Game::recipeReader.schematic(recipe)?.makes
  if (made != nil) {
    Game::items.show(frame, made)
  } else {
    Game::items.showSpell(frame, recipe)
  }
}

// A recipe: its name in its difficulty's colour (an unlearned one dim), a gold pip when the player starred it, `[N]`
// at the right for how many the bags can make now. Its menu stands under it while the window says it is the one open.
public class RecipeRow implements Component {
  public act: Event<(Act, integer)> = new Event()

  derived isChosen: boolean = self.chosen == self.recipe.id
  derived first: boolean = self.index == 1
  derived color: Color = Style::difficultyColor(self.recipe.difficulty)
  derived count: string = self.recipe.craftable > 0 ? "[%d]".format(self.recipe.craftable) : ""
  derived starred: boolean = has(self.kept.favorites, self.recipe.id)
  derived padding: Edges = self.indent ? INDENT_PAD : RECIPE_PAD
  derived menuOpen: boolean = self.menuFor == self.recipe.id

  recipe: Signal<Game::Recipe>
  index: Signal<integer>
  chosen: Signal<integer>
  kept: Signal<Kept>
  menuFor: Signal<integer>
  const indent: boolean
  constructor(
    recipe: Signal<Game::Recipe>,
    index: Signal<integer>,
    // The chosen recipe's id.
    chosen: Signal<integer>,
    kept: Signal<Kept>,
    // The id of the recipe whose menu is open; 0 for none.
    menuFor: Signal<integer>,
    // Under a heading of the one list.
    indent: boolean = false
  ) {
    self.recipe = recipe
    self.index = index
    self.chosen = chosen
    self.kept = kept
    self.menuFor = menuFor
    self.indent = indent
  }

  onClick(button: MouseButton) {
    self.act.emit(button == MouseButton::Right ? Act::Menu : Act::Pick, self.recipe.id)
  }

  onAct(act: Act, id: integer) { self.act.emit(act, id) }
  onEnter(frame: any Frame) { showRecipe(frame, self.recipe.id) }

  public render(): Template {
    return $ltml {
      <TabItem selected={self.isChosen} into={Style::RECIPE_LIT} first={self.first} columns={NAME_COUNT}
               padding={self.padding} @pick={self.onClick} @enter={self.onEnter}>
        <text value={self.recipe.name} textColor={self.color} textShadow={Style::SHADOW} />
        <text value={self.count} textColor={BRIGHT_TEXT} wrap={.None} textFont={.Numbers} />
        <box $if={self.starred} position={Position::Absolute} right={STAR_RIGHT} top={STAR_TOP} width={STAR}
             height={STAR} background={Style::GOLD} />
        <RecipeMenu $if={self.menuOpen} recipe={self.recipe} kept={self.kept} @act={self.onAct} />
      </TabItem>
    }
  }
}

// A group of the one list with headings: its heading (a fold mark, its name, `N (M)`) and, while it isn't folded, its
// recipes under it.
public class CategoryGroup implements Component {
  public act: Event<(Act, integer)> = new Event()

  state folded = false
  derived list: array<Game::Recipe> = members(self.shown, self.byCategory, self.group.id, self.kept.favorites)
  derived mark: string = self.folded ? "+" : "-"
  derived nameColor: Color | nil = self.group.id == FAVORITES ? nil : Style::GOLD
  derived makeableColor: Color | nil = self.group.makeable > 0 ? nil : Style::DIM

  group: Signal<Group>
  shown: Signal<array<Game::Recipe>>
  byCategory: Signal<map<integer, array<Game::Recipe>>>
  chosen: Signal<integer>
  kept: Signal<Kept>
  menuFor: Signal<integer>
  constructor(
    group: Signal<Group>,
    // Every recipe the search and the filter let through, and the same by their category.
    shown: Signal<array<Game::Recipe>>,
    byCategory: Signal<map<integer, array<Game::Recipe>>>,
    chosen: Signal<integer>,
    kept: Signal<Kept>,
    menuFor: Signal<integer>
  ) {
    self.group = group
    self.shown = shown
    self.byCategory = byCategory
    self.chosen = chosen
    self.kept = kept
    self.menuFor = menuFor
  }

  mut fold() { self.folded = !self.folded }
  onAct(act: Act, id: integer) { self.act.emit(act, id) }

  public render(): Template {
    return $ltml {
      <box columns={1}>
        <box columns={FOLD} gap={2.5sp} padding={CATEGORY_PAD} yAlign={Align::Center} border={Style::ROW_RULE}
             background={Style::ROW_LIGHT} @pointerPress={self.fold} @keyPress(.Enter)={self.fold} @keyPress(.Space)={self.fold}>
          <text value={self.mark} textColor={Style::DIM} wrap={.None} />
          <text value={self.group.name} textColor={self.nameColor}
                textShadow={Style::SHADOW} />
          <box columns={MARKS} yAlign={Align::Center}>
            <text value={"%d"} arguments={[self.group.makeable]} textColor={self.makeableColor} wrap={.None}
                  textFont={.Numbers} />
            <text value={"/%d"} arguments={[self.group.total]} textColor={Style::DIM} wrap={.None}
                  textFont={.Numbers} />
          </box>
        </box>
        <$if={!self.folded}>
          <RecipeRow $for={index, recipe of self.list} recipe={recipe} index={index}
                     chosen={self.chosen} kept={self.kept} menuFor={self.menuFor} indent={true}
                     @act={self.onAct} />
        </>
      </box>
    }
  }
}

// A recipe in the table: the library's row on the wood, its name in its difficulty's colour, the skill it is learned at,
// the made item's type, how many can be made now; with prices, one making's cost and what it brings at the house and
// at a merchant (`SourceCell`), and the profit at the better.
public class RecipeTableRow implements Component {
  public act: Event<(Act, integer)> = new Event()

  derived isChosen: boolean = self.chosen == self.recipe.id
  derived color: Color = Style::difficultyColor(self.recipe.difficulty)
  derived count: string = self.recipe.craftable > 0 ? "%d".format(self.recipe.craftable) : "-"
  derived skill: string = self.facts?.skill == nil ? "—" : "%d".format(self.facts?.skill ?? 0)
  derived subtype: string = self.facts?.subtype ?? ""
  derived kind: string = self.facts?.kind ?? ""
  derived menuOpen: boolean = self.menuFor == self.recipe.id
  derived both: BothSources | nil = self.facts?.both
  derived auction: SourceTotals = (self.both ?? NO_SOURCES).auction
  derived merchant: SourceTotals = (self.both ?? NO_SOURCES).merchant
  // The profit at the better source, «~» where it leaves something out, as the card's; «—» for none.
  derived better: SourceTotals | nil = self.both == nil ? nil : betterOf(self.both ?? NO_SOURCES)
  derived profitRough: boolean = roughProfit(self.better)
  derived hasProfit: boolean = self.better?.profit != nil
  derived profit: integer = (self.better?.profit ?? 0).abs()
  derived losing: boolean = (self.better?.profit ?? 0) < 0
  derived profitColor: Color = self.losing ? Style::RED : BRIGHT_TEXT

  recipe: Signal<Game::Recipe>
  facts: Signal<TableFacts | nil>
  chosen: Signal<integer>
  kept: Signal<Kept>
  menuFor: Signal<integer>
  priced: Signal<boolean>
  constructor(
    recipe: Signal<Game::Recipe>,
    // What the table shows of it besides the game's.
    facts: Signal<TableFacts | nil>,
    chosen: Signal<integer>,
    kept: Signal<Kept>,
    menuFor: Signal<integer>,
    // Whether the table has the prices' columns.
    priced: Signal<boolean> = false
  ) {
    self.recipe = recipe
    self.facts = facts
    self.chosen = chosen
    self.kept = kept
    self.menuFor = menuFor
    self.priced = priced
  }

  // The library's row says which button picked it: the left one chooses the recipe, the right one opens its menu.
  onPick(button: MouseButton) {
    self.act.emit(button == MouseButton::Right ? Act::Menu : Act::Pick, self.recipe.id)
  }

  onAct(act: Act, id: integer) { self.act.emit(act, id) }
  onEnter(frame: any Frame) { showRecipe(frame, self.recipe.id) }

  public render(): Template {
    return $ltml {
      <box columns={"subgrid"}>
        // The name, the class and the type wrap at their columns, their row as high as they come to: nothing is cut.
        <TableRow selected={self.isChosen} ground={Ground::Wood} @pick={self.onPick} @enter={self.onEnter}>
          <TableCell> <text value={self.recipe.name} textColor={self.color} textShadow={Style::SHADOW} /> </TableCell>
          <TableCell align={Align::End}>
            <text value={self.skill} textColor={Style::DIM} wrap={.None} textFont={.Numbers} />
          </TableCell>
          <TableCell> <text value={self.subtype} textColor={Style::DIM} /> </TableCell>
          <TableCell> <text value={self.kind} textColor={Style::DIM} /> </TableCell>
          <TableCell align={Align::End}>
            <text value={self.count} textColor={BRIGHT_TEXT} wrap={.None} textFont={.Numbers} />
          </TableCell>
          <$if={self.priced}>
            <TableCell> <SourceCell amount={self.auction.cost} rough={roughCost(self.auction)} /> </TableCell>
            <TableCell> <SourceCell amount={self.merchant.cost} rough={roughCost(self.merchant)} /> </TableCell>
            <TableCell> <SourceCell amount={self.auction.sale} rough={false} /> </TableCell>
            <TableCell> <SourceCell amount={self.merchant.sale} rough={false} /> </TableCell>
            <TableCell align={Align::End}>
              <box xAlign={Align::End} columns={{ each: "max-content" }} gap={0.5sp}>
                <text $if={self.profitRough && self.hasProfit} value={"~"} textColor={Style::DIM} />
                <text $if={self.losing} value={"-"} textColor={Style::RED} />
                <Money $if={self.hasProfit} amount={self.profit} color={self.profitColor} />
                <text $else value={"—"} textColor={Style::DIM} />
              </box>
            </TableCell>
          </>
        </TableRow>
        <RecipeMenu $if={self.menuOpen} recipe={self.recipe} kept={self.kept} @act={self.onAct} />
      </box>
    }
  }
}

// A reagent of the chosen recipe: its icon in a slot, its name, have / need (red when short).
public class ReagentRow implements Component {
  derived rule: Line | nil = self.index > 1 ? Style::ROW_RULE : nil
  derived item: integer | nil = self.reagent.itemID
  derived icon: Art | nil = self.reagent.icon
  derived color: Color = self.reagent.have < self.reagent.need ? Style::RED : Style::INK

  reagent: Signal<Game::Reagent>
  index: Signal<integer>
  constructor(
    reagent: Signal<Game::Reagent>,
    index: Signal<integer>
  ) {
    self.reagent = reagent
    self.index = index
  }

  // The reagent's tooltip beside its whole row.
  onEnter(frame: any Frame) {
    Game::tooltip.rowAt(frame)
    const item = self.item
    if (item != nil) { Game::items.show(frame, item) }
  }

  public render(): Template {
    return $ltml {
      <box columns={REAGENT} gap={2.5sp} yAlign={Align::Center} padding={REAGENT_PAD} border={self.rule}
           @pointerEnter={self.onEnter}>
        <ItemButton item={self.item} art={self.icon} size={SLOT} tipped={false} />
        <text value={self.reagent.name} textColor={Style::INK} />
        <text value={"%d / %d"} arguments={[self.reagent.have, self.reagent.need]} wrap={.None} textColor={self.color}
              textFont={.Numbers} />
      </box>
    }
  }
}
