  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  // A bolt at 1 s and a thread at 10 c; the bolt held: the thread to buy; a cloak sells at 5 s less 5%.
  Test.expect(totals("Cost | 0g 1s 10c | Left to buy | 0g 0s 10c | Sale | 0g 4s 75c | Profit | 0g 3s 65c | Prices: 0 h ago"))
  Test.expect(!window().text("No prices: open the auction house.").shown())
}

