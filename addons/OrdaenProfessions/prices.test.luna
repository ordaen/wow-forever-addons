test "the table sorts by cost and by profit, a recipe with none last either way" {
  Game.clock.server = NOW
  Game.merchant.prices = merchant
  Game.merchant.opened.emit()
  Game.auctionQuery.results.emit([
    { key: CLOTH, copper: 100, quantity: 5 }, { key: THREAD, copper: 15, quantity: 20 }, { key: CLOAK, copper: 500, quantity: 2 },
    { key: LINEN, copper: 100, quantity: 9 }, { key: APRON, copper: 1000, quantity: 1 }
  ])
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = [
    recipe(CLOAK_RECIPE, "Linen Cloak", 3, Game.Difficulty.Always), recipe(BOLT_RECIPE, "Bolt of Linen Cloth", 0, Game.Difficulty.Rarely),
    recipe(2385, "Brown Linen Vest", 0, Game.Difficulty.Usually), recipe(APRON_RECIPE, "Simple Apron", 0, Game.Difficulty.Usually),
    recipe(BELT_RECIPE, "Linen Belt", 0, Game.Difficulty.Usually)
  ]
  // The vest takes a dye no one sells; the apron a thread, and the belt one, which sells for nothing known.
  Game.tradeSkill.reagents = (id: Integer): Array<Game.Reagent> => {
    if (id == 2385) { return [reagent(2324, "Gray Dye", 1, 0)] }
    if (id == APRON_RECIPE || id == BELT_RECIPE) { return [reagent(THREAD, "Coarse Thread", 1, 0)] }
    return reagents(id)
  }
  Game.recipeReader.schematic = (id: Integer): Game.Schematic | nil => {
    if (id == APRON_RECIPE) { return { recipe: id, makes: APRON, least: 1, most: 1, parts: [] } }
    if (id == BELT_RECIPE) { return { recipe: id, makes: 4999, least: 1, most: 1, parts: [] } }
    return schematic(id)
  }
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  window().button(Ordaen.art.ctl.tool.columns).click()
  Test.page().window("By category").button("Table").click()
  // The apron: 10 c, 9 s 40 c; the belt 10 c, no profit known; the cloak 1 s 10 c, 3 s 65 c; the bolt: 2 s of linen,
  // sold at 95 c, 1 s 5 c lost. A tie goes by name, reversed with the order.
  const order = (): String => window().texts().filter(shown => NAMES.any(name => name == shown)).join(", ")
  window().button("Cost").click()
  Test.expect(order().contains("Linen Belt, Simple Apron, Linen Cloak, Bolt of Linen Cloth, Brown Linen Vest"))
  window().button("Cost").click()
  Test.expect(order().contains("Bolt of Linen Cloth, Linen Cloak, Simple Apron, Linen Belt, Brown Linen Vest"))
  window().button("Profit").click()
  Test.expect(order().contains("Bolt of Linen Cloth, Linen Cloak, Simple Apron, Brown Linen Vest, Linen Belt"))
  window().button("Profit").click()
  Test.expect(order().contains("Simple Apron, Linen Cloak, Bolt of Linen Cloth, Linen Belt, Brown Linen Vest"))
  Test.expect(near(window().text("Bolt of Linen Cloth").nth(1).item().text("0g 1s 5c").textColor(), RED))
}

// The queue

test "the queue's missing reagents priced by their cheaper way, «Left to buy» summing them" {
  Game.clock.server = NOW
  Game.merchant.prices = merchant
  Game.merchant.opened.emit()
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  window().button("+").click()
  window().button("Create").click()
  window().button("Queue (1)").click()
  Test.expect(window().text("Price").shown() && window().text("Best").shown())
  Test.expect(reads(window().text("Coarse Thread").item(), "Coarse Thread | 2 | 0 | 2 | 0g 0s 20c | Merchant"))
  Test.expect(reads(window().text("Bolt of Linen Cloth").item(), "Bolt of Linen Cloth | 2 | 1 | 1 | 0g 1s 0c | Buy"))
  Test.expect(follows("Left to buy", "0g 1s 20c") && follows("0g 1s 20c", "To the shopping list"))
}

test "a reagent the bags hold all of is left out of «Left to buy»; one lacking one is said red" {
  Game.clock.server = NOW
  Game.merchant.prices = merchant
  Game.merchant.opened.emit()
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
