// Prices off

test "with «Prices» off the window shows no price; on again, they are back" {
  Game.clock.server = NOW
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  const page = settings()
  page.button("Prices").click()
  page.button("Save").click()
  Test.expect(!window().text("Cost").shown() && reads(window().text("Coarse Thread").item(), "Coarse Thread | 0 / 1"))
  page.button("Prices").click()
  page.button("Save").click()
  Test.expect(window().text("Cost").shown())
  page.text("Prices").hover()
  Test.expect(Test.page().window(PRICES_TIP).shown())
}

test "with Ordaen Auction turned off the window shows no price, and «Prices» is greyed with why; on again, they are back" {
  Game.clock.server = NOW
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  const page = settings()
  // The modules in the list: Auction, Tooltips, Professions.
  page.button(Ordaen.art.ctl.switchOn).nth(1).click()
  Test.expect(!window().text("Cost").shown() && !window().text("Auction").shown())
  page.button("Professions").click()
  page.text("Prices").hover()
  Test.expect(Test.page().window(PRICES_OFF).shown() && !Test.page().window(PRICES_TIP).shown())
  page.button(Ordaen.art.ctl.switchOff).click()
  Test.expect(window().text("Cost").shown())
}
