// Ordaen Auction's prices in the professions window as the player meets them: the chosen recipe's reagents at the
// house and at a merchant, the cheaper way and the totals; the table's cost and profit; the queue's missing reagents
// priced and put on the shopping list; «No prices» while nothing was scanned; no price at all with «Prices» off or
// Ordaen Auction turned off. The house's prices come from a scan the game answers (`Game.auctionQuery`), a merchant's
// from the merchant's window (`Game.merchant`).
import Client from "$client"
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const TAILORING = 197
const CLOAK_RECIPE = 2387
const BOLT_RECIPE = 2963
const CLOTH = 2996
const THREAD = 2320
const LINEN = 2589
const CLOAK = 2570
const APRON_RECIPE = 7623
const BELT_RECIPE = 8776
const APRON = 7026
// The recipes the table lists, to read their order.
const NAMES = ["Linen Cloak", "Bolt of Linen Cloth", "Brown Linen Vest", "Simple Apron", "Linen Belt"]
const NOW = 1790002800
const HOUR = 3600
const RED: Color = Color.hex("#ff4040")
const DIM: Color = Color.hex("#a3977f")
const INK: Color = Color.hex("#e8dcc4")
const AMBER: Color = Color.hex("#ffb02e")
// The cheaper way's price, on a green ground.
const CHEAPER: Color = Color.hex("#40c0402e")
// A text the settings window always shows.
const SETTINGS = "Move mode"
const PRICES_OFF = "Needs Ordaen Auction: turn it on to see prices."
const PRICES_TIP = "Cost, sale and profit by Ordaen Auction's prices."

function recipe(id: Integer, name: String, craftable: Integer, difficulty: Game.Difficulty): Game.Recipe {
  return {
    id: id, name: name, icon: "Interface/Icons/INV_Misc_Note_01", categoryID: 11, learned: true, difficulty: difficulty,
    craftable: craftable
  }
}

function reagent(item: Integer, name: String, need: Integer, have: Integer): Game.Reagent {
  return { itemID: item, name: name, icon: "Interface/Icons/INV_Misc_Note_01", have: have, need: need }
}

// A cloak takes a bolt (one held) and a thread (none); a bolt takes two linen (none).
function reagents(id: Integer): Array<Game.Reagent> {
  if (id == CLOAK_RECIPE) { return [reagent(CLOTH, "Bolt of Linen Cloth", 1, 1), reagent(THREAD, "Coarse Thread", 1, 0)] }
  return [reagent(LINEN, "Linen Cloth", 2, 0)]
}

// Each recipe makes one of its item: the cloak a cloak, the bolt a bolt.
function schematic(id: Integer): Game.Schematic | nil {
  return { recipe: id, makes: id == CLOAK_RECIPE ? CLOAK : CLOTH, least: 1, most: 1, parts: [] }
}

function professions(): Array<Game.Profession> {
  return [{ skillLine: TAILORING, name: "Tailoring", icon: 136249, rank: 31, max: 75, kind: Game.ProfessionKind.Crafting }]
}

function categories(): Array<Game.Category> {
  return [{ id: 1, name: "Tailoring" }, { id: 10, name: "Resting at camp", parentID: 1 }, { id: 11, name: "Cloth armour", parentID: 1 }]
}

// The cloak (the bags make three) first, the bolt (none) after it.
function recipes(): Array<Game.Recipe> {
  return [recipe(CLOAK_RECIPE, "Linen Cloak", 3, Game.Difficulty.Always), recipe(BOLT_RECIPE, "Bolt of Linen Cloth", 0, Game.Difficulty.Rarely)]
}

// What a merchant sells: thread at 10 c.
function merchant(): Map<Integer, Integer> | nil {
  return { [THREAD]: 10 }
}

// The house seen now: a bolt at 1 s, a thread at 15 c, a cloak at 5 s.
function house(): Array<Game.Offer> {
  return [{ key: CLOTH, copper: 100, quantity: 5 }, { key: THREAD, copper: 15, quantity: 20 }, { key: CLOAK, copper: 500, quantity: 2 }]
}

function window(): Test.Part {
  return Test.page().window("Overview")
}

function reads(part: Test.Part, expected: String): Boolean {
  const read = part.texts().join(" | ")
  if (read != expected) { panic(`it reads «${read}», not «${expected}»`) }
  return true
}

// Whether the card's totals read exactly this, from «Cost» to the card's switches: where they don't, the test fails
// with what they read.
function totals(expected: String): Boolean {
  let read: Array<String> = []
  for (shown of window().texts()) {
    if (shown == "Favorite") { break }
    if (read.length > 0 || shown == "Cost") { read.push(shown) }
  }
  const said = read.join(" | ")
  if (said != expected) { panic(`the totals read «${said}», not «${expected}»`) }
  return true
}

// Ordaen's settings window at the module's page, as `/ordaen professions` opens it.
function settings(): Test.Part {
  (Client.SlashCmdList["ORDAEN"] ?? panic("/ordaen is Ordaen's command"))("professions")
  return Test.page().window(SETTINGS)
}

// Whether two colours are the same as the client keeps them (to three places).
function near(a: Color, b: Color): Boolean {
  return (a.r - b.r).abs() < 0.005 && (a.g - b.g).abs() < 0.005 && (a.b - b.b).abs() < 0.005
}

// Whether the window shows `next` straight after `first`, in the order drawn.
// Whether Ordaen Auction's shopping list reads exactly this, its rows from the first under the headings to «Search
// all»: the list's window opened from Ordaen Auction's «Shopping list» at the house (open), as the player does.
function shoppingList(expected: String): Boolean {
  Test.page().button("Shopping list").click()
  let read: Array<String> = []
  let inside = false
  for (shown of Test.page().window("Search all").texts()) {
    if (shown == "Search all") { break }
    if (inside) { read.push(shown) }
    if (shown == "Total") { inside = true }
  }
  const said = read.join(" | ")
  if (said != expected) { panic(`the shopping list reads «${said}», not «${expected}»`) }
  return true
}

function follows(first: String, next: String): Boolean {
  const shown = window().texts()
  for (index, text of shown) {
    if (text == first && shown[index + 1] == next) { return true }
  }
  panic(`«${next}» doesn't follow «${first}» in «${shown.join(" | ")}»`)
}

// The card

test "each reagent's price at the house and at a merchant for the count, the cheaper one taken on a green ground" {
  Game.clock.server = NOW
  Game.merchant.prices = merchant
  Game.merchant.opened.emit()
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  Test.expect(window().text("Auction").shown() && window().text("Merchant").shown() && window().text("Best").shown())
  Test.expect(reads(window().text("Bolt of Linen Cloth").nth(2).item(), "Bolt of Linen Cloth | 1 / 1 | 0g 1s 0c | — | Buy"))
  Test.expect(reads(window().text("Coarse Thread").item(), "Coarse Thread | 0 / 1 | 0g 0s 15c | 0g 0s 10c | Merchant"))
  Test.expect(reads(window().text("Coarse Thread").item().box(CHEAPER), "0g 0s 10c"))
  Test.expect(reads(window().text("Bolt of Linen Cloth").nth(2).item().box(CHEAPER), "0g 1s 0c"))
  Test.expect(window().text("0 / 1").textColor().equal(RED) && near(window().text("1 / 1").textColor(), INK))
  Test.expect(near(window().text("Buy").textColor(), INK))
}

