test "the prices' age: in hours under two days, then in days" {
  Game.clock.server = NOW
  Game.merchant.prices = merchant
  Game.merchant.opened.emit()
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.UIParent, nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Game.clock.server = NOW + 47 * HOUR
  Test.mount(nil, SCREEN)
  Game.tradeSkill.open = TAILORING
  // Over a day old: amber.
  Test.expect(near(window().text("Prices: 47 h ago").textColor(), AMBER))
  window().text("Bolt of Linen Cloth").nth(1).click()
  Game.clock.server = NOW + 48 * HOUR
  window().text("Linen Cloak").click()
  Test.expect(window().text("Prices: 2 d. ago").shown())
  window().text("Bolt of Linen Cloth").nth(1).click()
  Game.clock.server = NOW + 95 * HOUR
  window().text("Linen Cloak").click()
  // Three days and most of a fourth, said as three, amber still.
  Test.expect(near(window().text("Prices: 3 d. ago").textColor(), AMBER))
  window().text("Bolt of Linen Cloth").nth(1).click()
  Game.clock.server = NOW + 100 * HOUR
  window().text("Linen Cloak").click()
  // Four days old: dim.
  Test.expect(near(window().text("Prices: 4 d. ago").textColor(), DIM))
}

