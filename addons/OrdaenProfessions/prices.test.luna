// Ordaen Auction's prices in the professions window: the chosen recipe's reagents at the house and at a merchant
// with the way taken and the totals; the table's cost and profit; the queue's missing reagents priced and put on the
// shopping list; «No prices» while nothing was scanned; with Ordaen Auction off, no price at all.
import Client from "$client"
import Game from "$game"
import Runtime from "$runtime"
import Test from "$test"
import { ItemId } from "Ordaen"
import root Ordaen from "Ordaen"
import root Auction from "OrdaenAuction"
import root Professions from "OrdaenProfessions"
import { View } from "@/view"

const PAGE: Test.Page = { left: 20, top: 20, width: 200, height: 100, screen: true }
const TAILORING = 197
const CLOAK_RECIPE = 2387
const BOLT_RECIPE = 2963
const CLOTH = 2996
const THREAD = 2320
const LINEN = 2589
const CLOAK = 2570
const NOW = 1790002800

function recipe(id: Integer, name: String, craftable: Integer): Game.Recipe {
  return {
    id: id, name: name, icon: "Interface/Icons/INV_Misc_Note_01", categoryID: 11, learned: true,
    difficulty: Game.Difficulty.Always, craftable: craftable,
  }
}

function part(item: Integer, name: String, need: Integer, have: Integer): Game.Reagent {
  return { itemID: item, name: name, icon: "Interface/Icons/INV_Misc_Note_01", have: have, need: need }
}

// A cloak takes a bolt (one held) and a thread (none); a bolt takes two linen (none).
function reagents(id: Integer): Array<Game.Reagent> {
  if (id == CLOAK_RECIPE) { return [part(CLOTH, "Bolt of Linen Cloth", 1, 1), part(THREAD, "Coarse Thread", 1, 0)] }
  return [part(LINEN, "Linen Cloth", 2, 0)]
}

function schematic(id: Integer): Game.Schematic | nil {
  return { recipe: id, makes: id == CLOAK_RECIPE ? CLOAK : CLOTH, least: 1, most: 1, parts: [] }
}

function professions(): Array<Game.Profession> {
  return [{ skillLine: TAILORING, name: "Tailoring", icon: 136249, rank: 31, max: 75, kind: Game.ProfessionKind.Crafting }]
}

function categories(): Array<Game.Category> {
  return [{ id: 1, name: "Tailoring" }, { id: 10, name: "Resting at camp", parentID: 1 }, { id: 11, name: "Cloth armour", parentID: 1 }]
}

function recipes(): Array<Game.Recipe> {
  return [recipe(CLOAK_RECIPE, "Linen Cloak", 3), recipe(BOLT_RECIPE, "Bolt of Linen Cloth", 0)]
}

// What a merchant sells: thread at 10 c.
function merchant(): Map<Integer, Integer> | nil {
  return { [THREAD]: 10 }
}

// The house seen now: a bolt at 1 s, a thread at 15 c, a cloak at 5 s.
function house(): Array<Game.Offer> {
  return [{ key: CLOTH, copper: 100, quantity: 5 }, { key: THREAD, copper: 15, quantity: 20 }, { key: CLOAK, copper: 500, quantity: 2 }]
}

function click(at: Test.Point) {
  Test.click(at, nil)
  Test.flush()
}

test "the chosen recipe's reagents at the house and at a merchant, the cheaper way, and the totals" {
  Game.clock.server = NOW
  Game.merchant.prices = merchant
  Game.merchant.opened.emit()
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.C_UI.GetUIParent(), nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Test.mount(nil, PAGE)
  Game.tradeSkill.open = TAILORING
  Test.flush()
  click(Test.holding("Linen Cloak", nil))
  Test.shot("Linen Cloak: the bolt bought at the house, the thread from a merchant; cost, left to buy, sale, profit")
  Test.expect(Test.holding("Auction", nil).x > 0 && Test.holding("Merchant", nil).x > 0)
  Test.expect(Test.holding("Buy", nil).x > 0)
  Test.expect(Test.holding("Left to buy", nil).x > 0 && Test.holding("Profit", nil).x > 0)
  Test.expect(Professions.prices != nil)
}

test "the table lists each recipe's cost and profit, and sorts by them; one with a part unpriced has none, last" {
  Game.clock.server = NOW
  Game.merchant.prices = merchant
  Game.merchant.opened.emit()
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.C_UI.GetUIParent(), nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Test.mount(nil, PAGE)
  Game.tradeSkill.open = TAILORING
  Test.flush()
  Professions.list.values.view = View.Table
  Test.flush()
  Test.shot("the table: the cloak's cost and profit; the bolt's linen unpriced, «—»")
  click(Test.holding("Profit", nil))
  click(Test.holding("Profit", nil))
  Test.expect(Test.holding("Linen Cloak", nil).y < Test.holding("Bolt of Linen Cloth", nil).y)
}

test "the queue's missing reagents are priced, «Left to buy» sums them, and they go onto the shopping list" {
  Game.clock.server = NOW
  Game.merchant.prices = merchant
  Game.merchant.opened.emit()
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.C_UI.GetUIParent(), nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Test.mount(nil, PAGE)
  Game.tradeSkill.open = TAILORING
  Test.flush()
  click(Test.holding("Linen Cloak", nil))
  click(Test.holding("Create", nil))
  click(Test.holding("Queue (1)", nil))
  Test.shot("the queue: the thread missing, from a merchant; «To the shopping list»")
  click(Test.holding("To the shopping list", nil))
  const auction = Auction ?? panic("Ordaen Auction is on")
  Test.expect(auction.shopping.needed[ItemId.of(THREAD)] == 1)
  Test.expect(auction.shopping.needed[ItemId.of(CLOTH)] == nil)
}

test "with nothing scanned the card says there are no prices, and the totals are none" {
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.C_UI.GetUIParent(), nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Test.mount(nil, PAGE)
  Game.tradeSkill.open = TAILORING
  Test.flush()
  click(Test.holding("Linen Cloak", nil))
  Test.shot("nothing scanned: «No prices: open the auction house.», every total «—»")
  Test.expect(Test.holding("No prices: open the auction house.", nil).x > 0)
}

test "with Ordaen Auction turned off the window shows no price, and «Prices» is greyed with why; on again, they are back" {
  Game.clock.server = NOW
  Game.auctionQuery.results.emit(house())
  Game.frames.Professions = Client.CreateFrame("Frame", "ProfessionsFrame", Client.C_UI.GetUIParent(), nil)
  Game.professions.list = professions()
  Game.tradeSkill.categories = categories()
  Game.tradeSkill.recipes = recipes()
  Game.tradeSkill.reagents = reagents
  Game.recipeReader.schematic = schematic
  Test.mount(nil, PAGE)
  Game.tradeSkill.open = TAILORING
  Test.flush()
  click(Test.holding("Linen Cloak", nil))
  Test.expect(Professions.prices != nil)
  const auction = Runtime.Addon.of(Auction) ?? panic("Ordaen Auction is installed")
  auction.disable()
  Test.flush()
  Test.expect(Auction == nil && Professions.prices == nil)
  Test.shot("Ordaen Auction off: the reagents without prices, no totals")
  // The module's page in the settings: «Prices» greyed, and its hint says why.
  Ordaen.toggleSettings(Runtime.Addon.of(Professions))
  Test.flush()
  Test.moveTo(Test.holding("Prices", nil))
  Test.flush()
  Test.expect(Test.surfaceHolding("Needs Ordaen Auction: turn it on to see prices.").x > 0)
  Test.shot("the settings: «Prices» greyed, its hint saying why")
  click(Test.holding("Prices", nil))
  Test.expect(Professions.settings.draft.prices)
  Ordaen.toggleSettings(nil)
  Test.expect(auction.enable() == nil)
  Test.flush()
  Test.expect(Professions.prices != nil)
  Test.expect(Test.errors().length == 0)
}
