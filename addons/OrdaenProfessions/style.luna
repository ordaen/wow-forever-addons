// The professions window's look, shared by its parts: sizes at the user's scale and colours. A text's size is a step
// of the ladder (`$ltml`'s `TextSize`).
import Game from "$game"
import { Art, Bounds, ByInteractionState, Edges, Line, Shadow, Side } from "$ltml"
import { ARTWORK } from "Ordaen"

// The body. The recipes' side (the search and the lists) and the recipe's card share its width; the lists are never
// narrower than these, which hold all but the longest names of a category and a recipe on one line, and the
// recipes' side never narrower than both.
public const WIDTH: number<Length> = 1440dp
public const HEIGHT: number<Length> = 820.3125dp
public const CATEGORIES_LEAST: number<Length> = 328.125dp
public const RECIPES_LEAST: number<Length> = 429.6875dp
public const LISTS_LEAST: number<Length> = CATEGORIES_LEAST + RECIPES_LEAST
// What the lists' boxes are held to: at least their least widths.
public const CATEGORIES_BOUNDS: Bounds = { min: CATEGORIES_LEAST, max: nil }
public const RECIPES_BOUNDS: Bounds = { min: RECIPES_LEAST, max: nil }
public const LISTS_BOUNDS: Bounds = { min: LISTS_LEAST, max: nil }

public const INK: color = #e8dcc4
public const DIM: color = #a3977f
public const GOLD: color = #ffd100
public const RED: color = #ff4040
// An unlearned recipe.
public const OFF: color = #7a7060
// A card's frame (the overview's, the queue's).
public const LINE: color = #3e2f1d
public const CLEAR: color = #00000000
// What a chosen row stands on: art, multiplied by a colour where one is given; or a colour alone.
public struct Surface {
  art: Art | color
  tint: color | nil
}

// The recipes page's sections: the categories on the window's wood, the recipes on the wood stained a dark brown, the
// recipe on the window's wood behind a divider (`RecipeDetails`). A chosen category takes the recipes' surface, a tab into them;
// a chosen recipe a plain light, short of the paper's torn edge.
public const RECIPES: Surface = { art: ARTWORK.window.wood, tint: #86684e }
public const RECIPE_LIT: Surface = { art: #e8c89629, tint: nil }
// The recipes' room on their left, twice their rows' padding: the chosen category's surface shows there.
public const RECIPES_ROOM: Edges = { left: 2sp }
public const RECIPE_PAD: number<Spacing> = 3sp
// The groove between the categories and the recipes, at 40%: a dark line and a light one beside it, 1 unit each.
public const GROOVE_DARK: color = #0000003d
public const GROOVE_LIGHT: color = #d6a56b16
public const GROOVE: number<Length> = 1ui

// A heading under the cursor (a row that selects is a `TabItem`).
public const ROW_LIGHT: ByInteractionState<color> = { default: CLEAR, hover: #d6a56b1f, focus: #d6a56b1f }
public const SHADOW: Shadow = { color: #000000, x: 1.171875dp, y: -1.171875dp }
// Between rows, and round an item's slot.
public const ROW_RULE: Line = { width: 1.171875dp, color: #d6a56b14, sides: [Side::Top] }
public const BRONZE: Line = { width: 1.171875dp, color: #6c5535 }

// A recipe's name in its difficulty's colour.
public function difficultyColor(difficulty: Game::Difficulty): color {
  match (difficulty) {
    Game::Difficulty::Always => return #ff8040
    Game::Difficulty::Usually => return #ffd100
    Game::Difficulty::Rarely => return #40c040
    Game::Difficulty::Never => return #9a9a9a
  }
}
