// The professions window's look, shared by its parts: sizes at the user's scale and colours. A text's size is a step
// of the ladder (`$ltml`'s `TextSize`).
import Game from "$game"
import { Art, Bounds, ByInteractionState, Line, Piece, Shadow, Side } from "$ltml"
import { ARTWORK } from "Ordaen"

// The body. The recipes' side (the search and the lists) and the recipe's card share its width; the lists are never
// narrower than these, which hold all but the longest names of a category and a recipe on one line, and the
// recipes' side never narrower than both.
public const WIDTH: Number<Length> = 1440dp
public const HEIGHT: Number<Length> = 820.3125dp
public const CATEGORIES_LEAST: Number<Length> = 328.125dp
public const RECIPES_LEAST: Number<Length> = 429.6875dp
public const LISTS_LEAST: Number<Length> = CATEGORIES_LEAST + RECIPES_LEAST
// What the lists' boxes are held to: at least their least widths.
public const CATEGORIES_BOUNDS: Bounds = { min: CATEGORIES_LEAST, max: nil }
public const RECIPES_BOUNDS: Bounds = { min: RECIPES_LEAST, max: nil }
public const LISTS_BOUNDS: Bounds = { min: LISTS_LEAST, max: nil }

public const INK: Color = Color.hex("#e8dcc4")
public const DIM: Color = Color.hex("#a3977f")
public const GOLD: Color = Color.hex("#ffd100")
public const RED: Color = Color.hex("#ff4040")
// An unlearned recipe.
public const OFF: Color = Color.hex("#7a7060")
// A card's frame (the overview's, the queue's).
public const LINE: Color = Color.hex("#3e2f1d")
public const CLEAR: Color = Color.hex("#00000000")
// A section's surface: its texture, multiplied by a colour.
public struct Surface {
  art: Art
  tint: Color
}

// The achievements' grey parchment, repeated at its own size.
const PARCHMENT: Piece = {
  file: "Interface/AchievementFrame/UI-Achievement-Parchment-Horizontal-Desaturated", width: 512, height: 256, repeatSize: 512
}
// The recipes page's sections: the categories on the window's wood, the recipes on the wood stained a dark brown, the
// recipe on the parchment stained brown, a leather. A chosen category takes the recipes' surface, a chosen recipe the
// recipe's (`TabItem`).
public const RECIPES: Surface = { art: ARTWORK.window.wood, tint: Color.hex("#86684e") }
public const RECIPE: Surface = { art: PARCHMENT, tint: Color.hex("#7a604a") }
// A heading under the cursor (a row that selects is a `TabItem`).
public const ROW_LIGHT: ByInteractionState<Color> = { default: CLEAR, hover: Color.hex("#d6a56b1f"), focus: Color.hex("#d6a56b1f") }
public const SHADOW: Shadow = { color: Color.hex("#000000"), x: 1.171875dp, y: -1.171875dp }
// Between rows, and round an item's slot.
public const ROW_RULE: Line = { width: 1.171875dp, color: Color.hex("#d6a56b14"), sides: [Side.Top] }
public const BRONZE: Line = { width: 1.171875dp, color: Color.hex("#6c5535") }

// A recipe's name in its difficulty's colour.
public function difficultyColor(difficulty: Game.Difficulty): Color {
  match (difficulty) {
    Game.Difficulty.Always => return Color.hex("#ff8040")
    Game.Difficulty.Usually => return Color.hex("#ffd100")
    Game.Difficulty.Rarely => return Color.hex("#40c040")
    Game.Difficulty.Never => return Color.hex("#9a9a9a")
  }
}
