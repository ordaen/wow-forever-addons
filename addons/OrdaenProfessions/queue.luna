// The «Queue» tab: what «Create» asked for in the open profession, in the order it runs, a line each (its icon, its
// name in its difficulty's colour (one the profession's recipes don't list: dim, its profession's icon), which opens it,
// its count still to make with − and +, x to take it out); one table of the reagents they all need (need, have,
// missing, red while short), both lists the page's full width down to its footer. The footer band: what the queue is
// doing or why it waits, what the missing parts cost with «To the shopping list» while prices show, and «Create
// next», the player's click that starts the next run (the client starts a craft from nothing else).
import Game from "$game"
import { Align, Art, Edges, Frame, Line, Overflow, Track } from "$ltml"
import { ButtonPlate, Component, CountInput, FooterBand, ItemButton, Money, PushButton, SECONDARY_TEXT, WINDOW_ROOM } from "Ordaen"
import type { PriceSource } from "OrdaenTrading"
import { Way, unitOf } from "@/cost"
import Locale from "@/locales"
import { wayText } from "@/priceRows"
import Style from "@/style"
import { MOST_COUNT, QueueAct, Queued } from "@/view"

const NO_ICON: Art = "Interface/Icons/INV_Misc_QuestionMark"

// The lines and the table scrolling in the room there is, the footer band under them.
const PAGE: array<Track> = [{ fr: 1 }, "max-content"]
const EMPTY_PAD: Edges = { top: 4sp, right: WINDOW_ROOM, left: WINDOW_ROOM }
const LINE: array<Track> = [37.5dp, { fr: 1 }, "max-content", "max-content"]
const LINE_PAD: Edges = { top: 1sp, right: WINDOW_ROOM, bottom: 1sp, left: WINDOW_ROOM }
const STEP = 28.125dp
const SLOT = 37.5dp
const NEED: array<Track> = [32.8125dp, { fr: 1 }, 82.03125dp, 82.03125dp, 105.46875dp]
// With prices: what the missing part costs, and where it is cheaper.
const NEED_PRICED: array<Track> = [32.8125dp, { fr: 1 }, 82.03125dp, 82.03125dp, 105.46875dp, 117.1875dp, 93.75dp]
// The footer: the status, then what is left to buy and the shopping list while prices show, «Create next».
const FOOT: array<Track> = [{ fr: 1 }, "max-content"]
const FOOT_PRICED: array<Track> = [{ fr: 1 }, "max-content", "max-content", "max-content", "max-content"]
const NEED_PAD: Edges = { top: 1sp, right: WINDOW_ROOM, bottom: 1sp, left: WINDOW_ROOM }
const SHORT: Color = Color::hex("#ff6a5a")

// A queued recipe as its line draws it, with its count still to make.
public struct QueueLine {
  recipe: integer
  name: string
  icon: Art
  color: Color
  count: integer
}

// A reagent the queue needs: all of it, what the bags hold, and what is missing; the first line that needs it.
public struct Need {
  item: integer | nil
  recipe: integer
  crafts: integer
  name: string
  icon: Art
  need: integer
  have: integer
  missing: integer
}

// The queue's lines: a recipe of the open profession as the game has it, another by its kept name and its
// profession's icon.
public function linesOf(queued: array<Queued>, recipes: array<Game::Recipe>, professions: array<Game::Profession>): array<QueueLine> {
  let list: array<QueueLine> = []
  for (entry of queued) {
    const recipe = recipes.find(r => r.id == entry.recipe)
    if (recipe != nil) {
      list.push({
        recipe: entry.recipe, name: recipe.name, icon: recipe.icon, color: Style::difficultyColor(recipe.difficulty),
        count: entry.count
      })
    } else {
      const profession = professions.find(p => p.skillLine == entry.skillLine)
      list.push({ recipe: entry.recipe, name: entry.name, icon: profession?.icon ?? NO_ICON, color: Style::DIM, count: entry.count })
    }
  }
  return list
}

// The reagents of every line, one entry a reagent, in the order they are first met.
public function needsOf(lines: array<QueueLine>): array<Need> {
  let list: array<mut Need> = []
  for (line of lines) {
    for (reagent of Game::tradeSkill.reagents(line.recipe)) {
      let found = false
      for (need of list) {
        if (need.name == reagent.name) {
          need.need += reagent.need * line.count
          need.missing = (0).max(need.need - need.have)
          found = true
        }
      }
      if (!found) {
        const total = reagent.need * line.count
        list.push({
          item: reagent.itemID, recipe: line.recipe, crafts: line.count, name: reagent.name, icon: reagent.icon,
          need: total, have: reagent.have,
          missing: (0).max(total - reagent.have)
        })
      }
    }
  }
  return list
}

// A queued recipe's line.
public class QueueRow implements Component {
  public act: Event<(QueueAct, integer)> = new Event()
  // The stepper set the recipe's count; nought takes it out.
  public counted: Event<(integer, integer)> = new Event()

  derived rule: Line | nil = self.index > 1 ? Style::ROW_RULE : nil
  derived color: Color = self.line.color
  derived icon: Art = self.line.icon

  // The count as the stepper sets it: nought takes the line out.
  state count: integer

  line: Signal<QueueLine>
  index: Signal<integer>
  constructor(line: Signal<QueueLine>, index: Signal<integer>) {
    self.line = line
    self.index = index
    self.count = (peek self.line).count
    watch (queued of self.line) { self.follow(queued.count) }
    watch (count of self.count) { self.recount(count) }
  }

  // The queue's count changed: the stepper shows it.
  follow(mut self, queued: integer) {
    if (queued != peek self.count) { self.count = queued }
  }

  // The stepper moved: the queue's count is its.
  recount(self, count: integer) {
    const line = peek self.line
    if (count != line.count) { self.counted.emit(line.recipe, count) }
  }

  onOpen(self) { self.act.emit(QueueAct::Open, self.line.recipe) }
  onDrop(self) { self.act.emit(QueueAct::Drop, self.line.recipe) }

  public render(self): Template {
    return $ltml {
      <box columns={LINE} gap={3sp} yAlign={Align::Center} padding={LINE_PAD} border={self.rule}>
        <box width={SLOT} height={SLOT} border={Style::BRONZE} icon={self.icon} />
        <box @pointerPress={self.onOpen} @keyPress(.Enter)={self.onOpen} @keyPress(.Space)={self.onOpen}>
          <text value={self.line.name} textColor={self.color} textShadow={Style::SHADOW}
                wrap={.None} />
        </box>
        <CountInput value={mut self.count} least={0} most={MOST_COUNT} step={STEP} />
        <PushButton label={"x"} width={STEP} plate={ButtonPlate::Accent} @click={self.onDrop} />
      </box>
    }
  }
}

// What the missing part of a need costs by its cheaper way; none where nothing is missing.
public struct NeedPrice {
  need: Need
  // The missing part's price; none where nothing is missing or no price is known.
  copper: integer | nil
  way: Way
}

// Each need's missing part priced: the cheaper of the house and a merchant.
public function needPricesOf(prices: any PriceSource, needs: array<Need>): array<NeedPrice> {
  return needs.map((need: Need): NeedPrice => {
    if (need.missing == 0) { return { need: need, copper: nil, way: Way::None } }
    const one = unitOf(prices, need.item)
    const unit = one.unit
    return { need: need, copper: unit == nil ? nil : unit * need.missing, way: one.way }
  })
}

// What all the missing parts cost; none where one has no price.
public function toBuyOf(priced: array<NeedPrice>): integer | nil {
  let total = 0
  for (entry of priced) {
    const copper = entry.copper
    if (entry.need.missing > 0) {
      if (copper == nil) { return nil }
      total += copper
    }
  }
  return total
}

// A reagent of the queue's table; with prices, what its missing part costs and where.
public class NeedRow implements Component {
  derived need: Need = self.entry.need
  derived item: integer | nil = self.need.item
  derived icon: Art | nil = self.need.icon
  derived lacks: boolean = self.need.missing > 0
  derived missing: string = self.lacks ? "%d".format(self.need.missing) : "-"
  derived missingColor: Color = self.lacks ? SHORT : Style::INK
  derived columns: array<Track> = self.priced ? NEED_PRICED : NEED
  derived hasPrice: boolean = self.entry.copper != nil
  derived copper: integer = self.entry.copper ?? 0
  derived way: string = wayText(self.entry.way)
  derived wayColor: Color = self.entry.way == Way::None ? SHORT : Style::INK

  entry: Signal<NeedPrice>
  priced: Signal<boolean>
  constructor(entry: Signal<NeedPrice>, priced: Signal<boolean>) {
    self.entry = entry
    self.priced = priced
  }

  // The reagent's tooltip beside its whole row.
  onEnter(self, frame: any Frame) {
    Game::tooltip.rowAt(frame)
    const item = self.item
    if (item != nil) { Game::items.show(frame, item) }
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} gap={3sp} yAlign={Align::Center} padding={NEED_PAD} border={Style::ROW_RULE}
           @pointerEnter={self.onEnter}>
        <ItemButton item={self.item} art={self.icon} size={32.8125dp} tipped={false} />
        <text value={self.need.name} textColor={Style::INK} wrap={.None} />
        <box xAlign={Align::End}>
          <text value={"%d"} arguments={[self.need.need]} textColor={Style::INK}
                textFont={.Numbers} wrap={.None} />
        </box>
        <box xAlign={Align::End}>
          <text value={"%d"} arguments={[self.need.have]} textColor={Style::INK}
                textFont={.Numbers} wrap={.None} />
        </box>
        <box xAlign={Align::End}>
          <text value={self.missing} textColor={self.missingColor}
                textFont={.Numbers} wrap={.None} />
        </box>
        <$if={self.priced}>
          <box xAlign={Align::End}>
            <Money $if={self.hasPrice} amount={self.copper} />
          </box>
          <text $if={self.lacks} value={self.way} textColor={self.wayColor} wrap={.None} />
          <box $else />
        </>
      </box>
    }
  }
}

public class QueuePage implements Component {
  public act: Event<(QueueAct, integer)> = new Event()
  // A line's stepper set its recipe's count; nought takes it out.
  public counted: Event<(integer, integer)> = new Event()

  // «To the shopping list»: every need, with what it lacks (Ordaen Trading's list takes nothing of one that lacks none).
  public shop: Event<array<Need>> = new Event()
  // «Create next».
  public next: Event<nil> = new Event()

  derived lines: array<QueueLine> = linesOf(self.queued, Game::tradeSkill.recipes, Game::professions.list)
  derived needs: array<Need> = needsOf(self.lines)
  derived empty: boolean = self.lines.length == 0
  derived priced: boolean = self.prices != nil
  derived entries: array<NeedPrice> = self.entriesOf()
  derived toBuy: integer | nil = toBuyOf(self.entries)
  derived hasToBuy: boolean = self.toBuy != nil
  derived toBuyCopper: integer = self.toBuy ?? 0
  derived lacking: boolean = self.needs.count(need => need.missing > 0) > 0
  derived headColumns: array<Track> = self.priced ? NEED_PRICED : NEED
  derived footColumns: array<Track> = self.priced ? FOOT_PRICED : FOOT

  queued: Signal<array<Queued>>
  prices: Signal<any PriceSource | nil>
  status: Signal<string>
  ready: Signal<boolean>
  constructor(
    // The open profession's queue, in the order it runs.
    queued: Signal<array<Queued>>,
    // Ordaen Trading's prices while they are shown; none for none.
    prices: Signal<any PriceSource | nil> = nil,
    // What the queue is doing or why it waits; whether «Create next» can start a run.
    status: Signal<string> = "",
    ready: Signal<boolean> = false
  ) {
    self.queued = queued
    self.prices = prices
    self.status = status
    self.ready = ready
  }

  onNext(self) { self.next.emit() }

  // Read again when a price may have moved; without prices each need stands alone.
  entriesOf(self): array<NeedPrice> {
    const prices = self.prices
    if (prices == nil) { return self.needs.map(need => ({ need: need, copper: nil, way: Way::None })) }
    _ = prices.revision
    return needPricesOf(prices, self.needs)
  }

  onShop(self) { self.shop.emit(self.needs) }

  onAct(self, act: QueueAct, id: integer) { self.act.emit(act, id) }
  onCounted(self, recipe: integer, count: integer) { self.counted.emit(recipe, count) }

  public render(self): Template {
    return $ltml {
      <box rows={PAGE}>
        <box $if={self.empty} padding={EMPTY_PAD}>
          <text value={Locale::QUEUE_EMPTY} textSize={SECONDARY_TEXT} textColor={Style::DIM} />
        </box>
        <box $else overflow={Overflow::Scroll} scrollbar={.Hover} gap={6sp}>
          <box columns={1}>
            <QueueRow $for={index, line of self.lines} $key={line.recipe} line={line} index={index}
                      @act={self.onAct} @counted={self.onCounted} />
          </box>
          <box columns={1}>
            <box columns={self.headColumns} gap={3sp} padding={NEED_PAD}>
              <box />
              <box />
              <box xAlign={Align::End}>
                <text value={Locale::QUEUE_NEED} textColor={Style::DIM} wrap={.None} />
              </box>
              <box xAlign={Align::End}>
                <text value={Locale::QUEUE_HAVE} textColor={Style::DIM} wrap={.None} />
              </box>
              <box xAlign={Align::End}>
                <text value={Locale::QUEUE_MISSING} textColor={Style::DIM} wrap={.None} />
              </box>
              <$if={self.priced}>
                <box xAlign={Align::End}>
                  <text value={Locale::QUEUE_PRICE} textColor={Style::DIM} wrap={.None} />
                </box>
                <text value={Locale::QUEUE_WHERE} textColor={Style::DIM} wrap={.None} />
              </>
            </box>
            <NeedRow $for={entry of self.entries} $key={entry.need.name} entry={entry} priced={self.priced} />
          </box>
        </box>
        <FooterBand>
          <box columns={self.footColumns} gap={4sp} yAlign={Align::Center}>
            <text value={self.status} textSize={SECONDARY_TEXT} textColor={Style::DIM} />
            <$if={self.priced}>
              <text value={Locale::TOTAL_TO_BUY} textColor={Style::DIM} />
              <Money $if={self.hasToBuy} amount={self.toBuyCopper} />
              <text $else value={"—"} textColor={Style::DIM} />
              <PushButton label={Locale::TO_SHOPPING} width={210.9375dp} disabled={!self.lacking} @click={self.onShop} />
            </>
            <PushButton label={Locale::QUEUE_NEXT_BUTTON} width={210.9375dp} disabled={!self.ready} @click={self.onNext} />
          </box>
        </FooterBand>
      </box>
    }
  }
}
