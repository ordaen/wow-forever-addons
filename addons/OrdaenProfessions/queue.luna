// The «Queue» tab: what «Create» asked for, every profession's, in the order it runs, a line each (its icon, its name
// in its difficulty's colour (a recipe of a profession that isn't open: dim, its profession's icon), which opens it,
// its count still to make with − and +, ✕ to take it out); one table of the reagents they all need (need, have,
// missing, red while short). What the queue is doing or why it waits, and «Create next», the player's click that
// starts the next run (the client starts a craft from nothing else), stand in the window's footer.
import Game from "$game"
import { Align, Art, Edges, Line, Overflow, Track } from "$ltml"
import { Component, CountInput, PushButton, PX, space } from "Ordaen"
import Locale from "@/locales"
import Style from "@/style"
import { MOST_COUNT, Queued, QueueAct } from "@/view"

const NO_ICON: Art = "Interface/Icons/INV_Misc_QuestionMark"

const FRAME: Line = { width: 1 * PX, color: Style.LINE }
const BACK: Color = Color.hex("#0000004d")
// The lines and the table scrolling in the room there is.
const PAGE: Array<Track> = [{ fr: 1 }]
const LINE: Array<Track> = [32 * PX, { fr: 1 }, "auto", "auto"]
const LINE_PAD: Edges = { top: 4 * PX, bottom: 4 * PX }
const STEP = 24 * PX
const SLOT = 32 * PX
const NEED: Array<Track> = [28 * PX, { fr: 1 }, 70 * PX, 70 * PX, 90 * PX]
const NEED_PAD: Edges = { top: 3 * PX, right: 6 * PX, bottom: 3 * PX }
const SHORT: Color = Color.hex("#ff6a5a")

// A queued recipe as its line draws it, with its count still to make.
public struct QueueLine {
  recipe: Integer
  name: String
  icon: Art
  color: Color
  count: Integer
}

// A reagent the queue needs: all of it, what the bags hold, and what is missing.
public struct Need {
  name: String
  icon: Art
  need: Integer
  have: Integer
  missing: Integer
}

// The queue's lines: a recipe of the open profession as the game has it, another by its kept name and its
// profession's icon.
public function linesOf(queued: Array<Queued>, recipes: Array<Game.Recipe>, professions: Array<Game.Profession>): Array<QueueLine> {
  let list: Array<QueueLine> = []
  for (entry of queued) {
    const recipe = recipes.find(r => r.id == entry.recipe)
    if (recipe != nil) {
      list.push({
        recipe: entry.recipe, name: recipe.name, icon: recipe.icon, color: Style.difficultyColor(recipe.difficulty),
        count: entry.count,
      })
    } else {
      const profession = professions.find(p => p.skillLine == entry.skillLine)
      list.push({ recipe: entry.recipe, name: entry.name, icon: profession?.icon ?? NO_ICON, color: Style.DIM, count: entry.count })
    }
  }
  return list
}

// The reagents of every line, one entry a reagent, in the order they are first met.
public function needsOf(lines: Array<QueueLine>): Array<Need> {
  let list: Array<mut Need> = []
  for (line of lines) {
    for (reagent of Game.tradeSkill.reagents(line.recipe)) {
      let found = false
      for (need of list) {
        if (need.name == reagent.name) {
          need.need += reagent.need * line.count
          need.missing = (0).max(need.need - need.have)
          found = true
        }
      }
      if (!found) {
        const total = reagent.need * line.count
        list.push({
          name: reagent.name, icon: reagent.icon, need: total, have: reagent.have,
          missing: (0).max(total - reagent.have),
        })
      }
    }
  }
  return list
}

// A queued recipe's line.
public class QueueRow implements Component {
  public act: Event<(QueueAct, Integer)> = new Event()
  // The stepper set the recipe's count; nought takes it out.
  public counted: Event<(Integer, Integer)> = new Event()

  derived rule: Line | nil = self.index > 1 ? Style.ROW_RULE : nil
  derived color: Color = self.line.color
  derived icon: Art = self.line.icon

  // The count as the stepper sets it: nought takes the line out.
  state count: Integer

  line: Signal<QueueLine>
  index: Signal<Integer>
  constructor(line: Signal<QueueLine>, index: Signal<Integer>) {
    self.line = line
    self.index = index
    self.count = (peek self.line).count
    watch (queued of self.line) { self.follow(queued.count) }
    watch (count of self.count) { self.recount(count) }
  }

  // The queue's count changed: the stepper shows it.
  follow(mut self, queued: Integer) {
    if (queued != peek self.count) { self.count = queued }
  }

  // The stepper moved: the queue's count is its.
  recount(self, count: Integer) {
    const line = peek self.line
    if (count != line.count) { self.counted.emit(line.recipe, count) }
  }

  onOpen(self) { self.act.emit(QueueAct.Open, self.line.recipe) }
  onDrop(self) { self.act.emit(QueueAct.Drop, self.line.recipe) }

  public render(self): Template {
    return $ltml {
      <box columns={LINE} gap={space(.Item)} yAlign={Align.Center} padding={LINE_PAD} border={self.rule}>
        <box width={SLOT} height={SLOT} border={Style.BRONZE} icon={self.icon} />
        <box @click={self.onOpen}>
          <text value={self.line.name} textColor={self.color} textShadow={Style.SHADOW}
                wrap={false} />
        </box>
        <CountInput value={mut self.count} least={0} most={MOST_COUNT} step={STEP} />
        <PushButton label={"x"} width={STEP} accent={true} @click={self.onDrop} />
      </box>
    }
  }
}

// A reagent of the queue's table.
public class NeedRow implements Component {
  derived icon: Art = self.need.icon
  derived missing: String = self.need.missing > 0 ? "%d".format(self.need.missing) : "-"
  derived missingColor: Color = self.need.missing > 0 ? SHORT : Style.INK

  need: Signal<Need>
  constructor(need: Signal<Need>) {
    self.need = need
  }

  public render(self): Template {
    return $ltml {
      <box columns={NEED} gap={space(.Item)} yAlign={Align.Center} padding={NEED_PAD} border={Style.ROW_RULE}>
        <box width={28 * PX} height={28 * PX} border={Style.BRONZE} icon={self.icon} />
        <text value={self.need.name} textColor={Style.INK} wrap={false} />
        <box xAlign={Align.End}>
          <text value={"%d"} arguments={[self.need.need]} textColor={Style.INK}
                textFont={.Numbers} wrap={false} />
        </box>
        <box xAlign={Align.End}>
          <text value={"%d"} arguments={[self.need.have]} textColor={Style.INK}
                textFont={.Numbers} wrap={false} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.missing} textColor={self.missingColor}
                textFont={.Numbers} wrap={false} />
        </box>
      </box>
    }
  }
}

public class QueuePage implements Component {
  public act: Event<(QueueAct, Integer)> = new Event()
  // A line's stepper set its recipe's count; nought takes it out.
  public counted: Event<(Integer, Integer)> = new Event()

  derived lines: Array<QueueLine> = linesOf(self.queued, Game.tradeSkill.recipes, Game.professions.list)
  derived needs: Array<Need> = needsOf(self.lines)
  derived empty: Boolean = self.lines.length == 0

  queued: Signal<Array<Queued>>
  constructor(
    // The queue, every profession's, in the order it runs.
    queued: Signal<Array<Queued>>,
  ) {
    self.queued = queued
  }

  onAct(self, act: QueueAct, id: Integer) { self.act.emit(act, id) }
  onCounted(self, recipe: Integer, count: Integer) { self.counted.emit(recipe, count) }

  public render(self): Template {
    return $ltml {
      <box padding={space(.Panel)} border={FRAME} background={BACK} rows={PAGE}>
        <text $if={self.empty} value={Locale.QUEUE_EMPTY} textSize={.Secondary} textColor={Style.DIM} />
        <$else>
          <box overflow={Overflow.Scroll} gap={space(.Group)}>
            <box columns={1}>
              <QueueRow $for={index, line of self.lines} $key={line.recipe} line={line} index={index}
                        @act={self.onAct} @counted={self.onCounted} />
            </box>
            <box columns={1}>
              <box columns={NEED} gap={space(.Item)} padding={NEED_PAD}>
                <box />
                <box />
                <box xAlign={Align.End}>
                  <text value={Locale.QUEUE_NEED} textColor={Style.DIM} wrap={false} />
                </box>
                <box xAlign={Align.End}>
                  <text value={Locale.QUEUE_HAVE} textColor={Style.DIM} wrap={false} />
                </box>
                <box xAlign={Align.End}>
                  <text value={Locale.QUEUE_MISSING} textColor={Style.DIM} wrap={false} />
                </box>
              </box>
              <NeedRow $for={need of self.needs} $key={need.name} need={need} />
            </box>
          </box>
        </>
      </box>
    }
  }
}
