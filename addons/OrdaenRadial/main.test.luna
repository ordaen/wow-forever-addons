// The wheels as the player meets them: a key bound in the game's Key Bindings window holds the first ring, the art
// names the item the mouse goes towards, a left click opens that item's ring in place and a click there does its item,
// in a fight too; the key let go closes it; the marks' ring of its own key marks with one click; a window of ours is
// opened by its item out of a fight and is dimmed and does nothing in one; the settings' tab puts an item in a place,
// and «Back to the preset» takes it away.
import Client from "$client"
import { SpellChargeInfo, SpellCooldownInfo } from "$client"
import Events from "$events"
import Test from "$test"
import root Radial from "OrdaenRadial"
import { Item, Ring } from "@/choices"
import { RadialKind, RadialOffer } from "@/kinds"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const MIDDLE: Test.Point = { x: 800, y: 450 }
const FAR = 120

// The first ring on F, the marks' on G; the screen drawn.
function start() {
  _ = Client.SetBinding("H", "ORDAEN_RADIAL_3")
  _ = Client.SetBinding("F", "ORDAEN_RADIAL_1")
  _ = Client.SetBinding("G", "ORDAEN_RADIAL_2")
  Events.UPDATE_BINDINGS.emit()
  Test.mount(nil, SCREEN)
  Test.flush()
}

// A key held at the screen's middle and the cursor moved `x` right and `y` down.
function hold(key: String, x: Number, y: Number) {
  Test.moveTo(MIDDLE)
  _ = Test.holdBound(key)
  Test.flush()
  Test.moveTo({ x: MIDDLE.x + x, y: MIDDLE.y + y })
  Test.pass(0.05)
}

function clickAt(x: Number, y: Number) {
  Test.moveTo({ x: MIDDLE.x + x, y: MIDDLE.y + y })
  Test.pass(0.05)
  Test.press(nil)
  Test.release(nil)
  Test.pass(0.05)
}

test "the key held opens the ring and names what the mouse goes towards, from where its aim has trailed to" {
  start()
  hold("F", 0, -2 * FAR)
  Test.expect(Test.page().texts().join(", ") == "Professions, Click to open, Scroll to choose")
  // Gone far up, the aim's middle trailed it, a reach behind: a way back about that far comes into it, which cancels.
  Test.moveTo({ x: MIDDLE.x, y: MIDDLE.y - 2 * FAR + 90 })
  Test.pass(0.05)
  Test.expect(Test.page().texts().join(", ") == "Release to cancel")
  // A move right from there turns to the item on the right.
  Test.moveTo({ x: MIDDLE.x + 3 * FAR, y: MIDDLE.y - 2 * FAR + 90 })
  Test.pass(0.05)
  Test.expect(Test.page().texts().join(", ") == "Marks, Click to open, Scroll to choose")
  _ = Test.releaseBound("F")
}

test "a ring's item opens its ring in place on a click, and a click there does its item, in a fight too" {
  start()
  Test.combat(true)
  hold("F", FAR, 0)
  clickAt(FAR, 0)
  // On the wheel, its middle is the aim's: the item up from it is up from the middle.
  Test.moveTo({ x: MIDDLE.x, y: MIDDLE.y - FAR })
  Test.pass(0.05)
  Test.expect(Test.page().texts().join(", ") == "Mark 8, Click to use")
  clickAt(0, -FAR)
  Test.expect(Test.performed().join(", ") == "macro /tm 8")
  Test.expect(Test.page().texts().length == 0)
  _ = Test.releaseBound("F")
  Test.combat(false)
}

test "the key let go closes the wheel and does nothing" {
  start()
  hold("G", 0, -FAR)
  _ = Test.releaseBound("G")
  Test.pass(0.05)
  Test.expect(Test.performed().length == 0 && Test.page().texts().length == 0)
}

test "the marks' ring on its own key marks the target with one click" {
  start()
  Test.combat(true)
  hold("G", 0, -FAR)
  Test.expect(Test.page().texts().join(", ") == "Mark 8, Click to use")
  clickAt(0, -FAR)
  _ = Test.releaseBound("G")
  Test.expect(Test.performed().join(", ") == "macro /tm 8")
  Test.combat(false)
}

test "a window of ours is opened out of a fight, and is dimmed and does nothing in one" {
  start()
  Test.combat(true)
  hold("F", -FAR, -FAR)
  clickAt(-FAR, -FAR)
  Test.moveTo({ x: MIDDLE.x + 104, y: MIDDLE.y + 60 })
  Test.pass(0.05)
  Test.expect(Test.page().texts().join(", ") == "Ordaen settings, Can't be used now")
  clickAt(104, 60)
  _ = Test.releaseBound("F")
  Test.expect(Test.page().window("Move mode").count() == 0)
  Test.combat(false)
  hold("F", -FAR, -FAR)
  clickAt(-FAR, -FAR)
  clickAt(104, 60)
  _ = Test.releaseBound("F")
  Test.expect(Test.page().window("Move mode").shown())
}

// The settings window on the wheels' tab: the surface that holds the tab's own «All rings back» (the catalogue's list,
// open, says «Move mode» too).
function radialTab(): Test.Part {
  Test.open("/ordaen")
  Test.page().window("Move mode").button("Radial").click()
  return Test.page().window("All rings back")
}

// A part of the tab clicked as the player does: the tab scrolled from its top down until it is in view.
function clickDown(settings: Test.Part, part: Test.Part) {
  settings.hover()
  for (notch of 1..30) { Test.wheel(1) }
  for (notch of 1..60) {
    if (Test.refused(() => part.click()) == nil) { return }
    Test.wheel(-1)
  }
  panic("the part is never in view")
}

function firstRing(): Ring { return Radial.settings.values.rings[1] ?? panic("the first ring") }

test "the tab's tree opens a submenu, the place chosen shows its item and takes another, and the preset takes it back" {
  start()
  const settings = radialTab()
  clickDown(settings, settings.button("2. Pings"))
  clickDown(settings, settings.button("1. Attack"))
  // The catalogue's plate says what stands there: the second «Attack», after the line's own.
  clickDown(settings, settings.button("Attack").nth(2))
  Test.page().button("Spell or mount").click()
  clickDown(settings, settings.input().nth(1))
  settings.input().nth(1).type("Find Herbs")
  clickDown(settings, settings.button("Put it there"))
  Test.expect(firstRing().items["2_1"] is Item.Spell)
  clickDown(settings, settings.button("Back to the preset"))
  Test.expect(firstRing().items["2_1"] is Item.Pinged)
}

test "a place added inside a submenu is moved earlier, and one taken away takes what stands under it, those after it moving up" {
  start()
  const settings = radialTab()
  clickDown(settings, settings.button("1. Professions"))
  clickDown(settings, settings.button("Add inside"))
  Test.expect(firstRing().counts["1"] == 2 && firstRing().items["1_2"] == Item.Empty)
  clickDown(settings, settings.button("Move earlier"))
  Test.expect(firstRing().items["1_1"] == Item.Empty && firstRing().items["1_2"] == Item.Professions)
  clickDown(settings, settings.button("2. Pings"))
  clickDown(settings, settings.button("Remove"))
  // The marks moved up into the pings' place, their own marks with them.
  const ring = firstRing()
  Test.expect(ring.counts[""] == 6 && ring.counts["2"] == 8 && ring.items["2_8"] is Item.RaidMark)
  Test.expect(ring.items["1_2"] == Item.Professions && ring.items["6"] is Item.Menu && ring.items["7"] == nil)
}

// One ring of the player's changed as `edit` changes it.
function editRing(index: Integer, edit: (ring: mut Ring) => nil) {
  const rings = Radial.settings.values.rings.clone()
  const ring = (rings[index] ?? panic("a ring for each key")).clone()
  edit(mut ring)
  rings[index] = ring
  Radial.settings.values.rings = rings
  Test.flush()
}

// A kind of another module's: the next junk to sell, an item of the bags.
class Junk implements RadialKind {
  public const id: String = "junk"
  public const title: String = "The next junk"
  public offer(self): RadialOffer {
    return { name: "Broken Fang", icon: "Interface/Icons/INV_Misc_QuestionMark", action: .Item { item: 4875 }, dim: false }
  }
}

test "a spell dropped from the spellbook goes in the place chosen" {
  start()
  Client.C_Spell.GetSpellName = (id: String | Integer): String | nil => id == 2383 ? "Find Herbs" : nil
  const settings = radialTab()
  clickDown(settings, settings.button("5. Travel"))
  Client.C_Spell.PickupSpell(2383)
  clickDown(settings, settings.button("Drop a spell, an item or a macro here: it goes in the place"))
  Test.expect(firstRing().items["5"] is Item.Spell && firstRing().items["5_1"] == nil)
  Test.expect(!Client.CursorHasSpell())
}

test "a kind another module adds offers its item on the wheel, in a fight too" {
  start()
  const junk = new Junk()
  _ = Radial.kinds.add(junk)
  editRing(2, (ring: mut Ring): nil => { ring.items["1"] = .Kind { kind: "junk" } })
  Test.combat(true)
  hold("G", 0, -FAR)
  Test.expect(Test.page().texts().join(", ") == "Broken Fang, Click to use")
  clickAt(0, -FAR)
  _ = Test.releaseBound("G")
  Test.expect(Test.performed().join(", ") == "item item:4875")
  Test.combat(false)
}

test "an item of another class is dimmed and does nothing; one held to a modifier needs it" {
  start()
  Client.UnitClass = (unit: String): (String | nil, String | nil, Number | nil) => { return "Warrior", "WARRIOR", 1 }
  editRing(3, (ring: mut Ring): nil => {
    ring.conditions["1"] = { classTag: "MAGE", form: nil, modifier: nil }
    ring.conditions["2"] = { classTag: nil, form: nil, modifier: .Shift }
  })
  hold("H", 0, -FAR)
  Test.expect(Test.page().texts().join(", ") == "Attack, Can't be used now")
  clickAt(0, -FAR)
  _ = Test.releaseBound("H")
  Test.expect(Test.performed().length == 0)
  hold("H", FAR, 0)
  Test.hold([.Shift])
  clickAt(FAR, 0)
  Test.hold([])
  _ = Test.releaseBound("H")
  Test.expect(Test.performed().join(", ") == "macro /ping 4")
}

test "a spell shows its charges and its cooldown's sweep; a macro its own icon" {
  start()
  Client.C_Spell.GetSpellTexture = (spell: String | Integer): (FileId | nil, FileId | nil, FileId | nil) => { return 136065, nil, nil }
  Client.C_Spell.GetSpellCharges = (spell: String | Integer): SpellChargeInfo | nil => {
    currentCharges: 2, maxCharges: 3, cooldownStartTime: 0, cooldownDuration: 0, chargeModRate: 1, isActive: true
  }
  Client.C_Spell.GetSpellCooldown = (spell: String | Integer): SpellCooldownInfo | nil => {
    startTime: 5, duration: 30, isEnabled: true, isActive: true, modRate: 1, activeCategory: nil
  }
  Client.GetMacroInfo = (which: String | Integer): (String | nil, FileId | nil, String | nil) => { return "Heal me", 134400, "/cast Heal" }
  editRing(3, (ring: mut Ring): nil => {
    ring.items["1"] = .Spell { spell: "Charge" }
    ring.items["2"] = .Macro { macro: "Heal me" }
  })
  const told = Test.calls(() => hold("H", 0, -FAR))
  Test.expect(told.contains("SetCooldown=1"))
  Test.expect(Test.page().text("2").shown())
  Test.expect(Test.drawn().any(drawn => drawn.file == 134400))
  _ = Test.releaseBound("H")
}

test "a ring's size and its submenus' memory are chosen on the tab" {
  start()
  Test.open("/ordaen")
  const settings = Test.page().window("Move mode")
  settings.button("Radial").click()
  settings.button("+").click()
  settings.button("Submenus remember").click()
  const first = Radial.settings.values.rings[1] ?? panic("the first ring")
  Test.expect(first.scale > 1)
  Test.expect(first.remember)
}

test "an item from the bags and a macro dropped go in the place chosen" {
  start()
  Client.GetCursorInfo = (): (String | nil, Unknown, Unknown, Unknown) => { return "item", 6948, "item:6948", nil }
  Client.GetMacroInfo = (which: String | Integer): (String | nil, FileId | nil, String | nil) => { return "Heal me", 134400, "" }
  const settings = radialTab()
  clickDown(settings, settings.button("1. Professions"))
  const drop = settings.button("Drop a spell, an item or a macro here: it goes in the place")
  clickDown(settings, drop)
  Test.expect(firstRing().items["1"] is Item.Bag)
  Client.GetCursorInfo = (): (String | nil, Unknown, Unknown, Unknown) => { return "macro", 3, nil, nil }
  clickDown(settings, drop)
  Test.expect(firstRing().items["1"] is Item.Macro)
}

test "the mouse wheel over a submenu shows the item it steps to, and the middle says which of how many" {
  start()
  // The pings, up and to the right.
  hold("F", 94, -75)
  Test.wheel(-1)
  Test.pass(0.05)
  const texts = Test.page().texts()
  Test.expect(texts.length == 3 && texts[2] == "Click to use" && (texts[3] ?? "").match("^1 of %d+$") != nil)
  _ = Test.releaseBound("F")
}

test "a ping taken by a press says to point and let go; the wheel is see-through only while the cursor is over it" {
  start()
  hold("H", 0, -FAR)
  Test.press(nil)
  Test.pass(0.05)
  const hint = Test.page().text("Point and release LMB")
  // Still on the wheel: all but gone, so the spot under it shows.
  Test.expect(hint.shown() && hint.opacity() < 0.2)
  // Off the wheel: drawn as it was.
  Test.moveTo({ x: MIDDLE.x + 4 * FAR, y: MIDDLE.y })
  Test.pass(0.05)
  Test.expect(hint.opacity() == 1)
  Test.release(nil)
  _ = Test.releaseBound("H")
  Test.expect(Test.performed().join(", ") == "macro /ping 1")
}

test "emotes stand in families of groups, each named by its command with no icon and done by its token" {
  start()
  Test.combat(true)
  // The emotes, down and a little to the right.
  hold("F", 60, 104)
  clickAt(60, 104)
  clickAt(0, -FAR)
  clickAt(0, -FAR)
  // «hello» and «greet» share `/привет`: the client takes it for «greet», the lower, and «hello» is named by its next.
  Test.moveTo({ x: MIDDLE.x + FAR, y: MIDDLE.y - FAR })
  Test.pass(0.05)
  Test.expect(Test.page().text("/при").shown() && Test.page().text("/привет").shown())
  Test.expect(!Test.drawn().any(drawn => drawn.file == "Interface/Icons/INV_Misc_Toy_10"))
  clickAt(FAR, -FAR)
  _ = Test.releaseBound("F")
  Test.expect(Test.performed().join(", ") == "macro /run DoEmote(\"GREET\")")
  Test.combat(false)
}

test "each kind of ping shows the client's own mark of it and sends its own number" {
  start()
  hold("H", 0, -FAR)
  const drawn = Test.drawn()
  for (kind of ["Attack", "Assist", "Warning", "OnMyWay"]) {
    Test.expect(drawn.any(texture => texture.file == `Ping_Marker_Icon_${kind}`))
  }
  clickAt(0, -FAR)
  _ = Test.releaseBound("H")
  hold("H", FAR, 0)
  clickAt(FAR, 0)
  _ = Test.releaseBound("H")
  hold("H", 0, FAR)
  clickAt(0, FAR)
  _ = Test.releaseBound("H")
  hold("H", -FAR, 0)
  clickAt(-FAR, 0)
  _ = Test.releaseBound("H")
  Test.expect(Test.performed().join(", ") == "macro /ping 1, macro /ping 4, macro /ping 2, macro /ping 3")
}
