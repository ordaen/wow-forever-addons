// The wheels as the player meets them: a key bound in the game's Key Bindings window holds the first ring at the
// cursor, the art names the item the mouse went towards, the key let go opens that item's ring in place and a click
// there does its item, in a fight too; the marks' ring of its own key marks with one flick; a window of ours is opened
// by its item out of a fight and is dimmed and does nothing in one; the settings' tab puts an item in a place, and
// «Back to the preset» takes it away.
import Client from "$client"
import Events from "$events"
import Test from "$test"
import root Radial from "OrdaenRadial"
import { Item } from "@/choices"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const MIDDLE: Test.Point = { x: 800, y: 450 }
const FAR = 120

// The first ring on F, the marks' on G; the screen drawn.
function start() {
  _ = Client.SetBinding("F", "ORDAEN_RADIAL_1")
  _ = Client.SetBinding("G", "ORDAEN_RADIAL_2")
  Events.UPDATE_BINDINGS.emit()
  Test.mount(nil, SCREEN)
  Test.flush()
}

// A key held at the screen's middle and the cursor moved `x` right and `y` down.
function hold(key: String, x: Number, y: Number) {
  Test.moveTo(MIDDLE)
  _ = Test.holdBound(key)
  Test.flush()
  Test.moveTo({ x: MIDDLE.x + x, y: MIDDLE.y + y })
  Test.pass(0.05)
}

function clickAt(x: Number, y: Number) {
  Test.moveTo({ x: MIDDLE.x + x, y: MIDDLE.y + y })
  Test.pass(0.05)
  Test.press(nil)
  Test.release(nil)
  Test.pass(0.05)
}

test "the key held opens the ring at the cursor and names what the mouse goes towards" {
  start()
  hold("F", 0, -FAR)
  Test.expect(Test.page().texts().join(", ") == "Windows")
  Test.moveTo({ x: MIDDLE.x + FAR, y: MIDDLE.y })
  Test.pass(0.05)
  Test.expect(Test.page().texts().join(", ") == "Pings")
  Test.moveTo(MIDDLE)
  Test.pass(0.05)
  Test.expect(Test.page().texts().length == 0)
  _ = Test.releaseBound("F")
}

test "a ring's item opens its ring in place, and a click does its item, in a fight too" {
  start()
  Test.combat(true)
  hold("F", 0, -FAR)
  _ = Test.releaseBound("F")
  Test.pass(0.05)
  Test.moveTo({ x: MIDDLE.x + FAR, y: MIDDLE.y })
  Test.pass(0.05)
  Test.expect(Test.page().texts().join(", ") == "Talents")
  clickAt(FAR, 0)
  Test.expect(Test.performed().join(", ") == "macro /click TalentMicroButton")
  Test.expect(Test.page().texts().length == 0)
  Test.combat(false)
}

test "the marks' ring on its own key marks the target with one flick" {
  start()
  Test.combat(true)
  hold("G", 0, -FAR)
  Test.expect(Test.page().texts().join(", ") == "Mark 8")
  _ = Test.releaseBound("G")
  Test.expect(Test.performed().join(", ") == "macro /tm 8")
  Test.combat(false)
}

test "a window of ours is opened out of a fight, and is dimmed and does nothing in one" {
  start()
  Test.combat(true)
  hold("F", -FAR, -FAR)
  _ = Test.releaseBound("F")
  Test.pass(0.05)
  Test.moveTo({ x: MIDDLE.x + 104, y: MIDDLE.y + 60 })
  Test.pass(0.05)
  Test.expect(Test.page().text("Ordaen settings").opacity() < 0.5)
  clickAt(104, 60)
  Test.expect(Test.page().window("Move mode").count() == 0)
  Test.combat(false)
  hold("F", -FAR, -FAR)
  _ = Test.releaseBound("F")
  clickAt(104, 60)
  Test.expect(Test.page().window("Move mode").shown())
}

test "the settings' tab puts an item in a place, and the preset takes it back" {
  start()
  Test.open("/ordaen")
  const settings = Test.page().window("Move mode")
  settings.button("Radial").click()
  settings.input().nth(2).type("Find Herbs")
  settings.button("Put it there").click()
  const radial = Radial
  const first = radial.settings.values.rings[1] ?? panic("the first ring")
  Test.expect(first.items["1"] is Item.Spell)
  settings.button("Back to the preset").click()
  const again = radial.settings.values.rings[1] ?? panic("the first ring")
  Test.expect(again.items["1"] is Item.Menu)
}
