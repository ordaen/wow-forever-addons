// What each kind of item is on the wheel: what it shows (its name, its icon, whether it can be used now) and what it
// does (the client's action, or ours).
import Client from "$client"
import { FillDuration } from "$ltml"
import { WheelAction, WheelItem, plainItem } from "Ordaen"
import { Item, Ping, Window } from "@/choices"
import { RadialOffer } from "@/kinds"
import Locale from "@/locales"

const QUESTION: Asset = "Interface/Icons/INV_Misc_QuestionMark"

// A window: its name, its icon, and how it is opened (a line of a macro the client runs, in a fight too; none: ours).
struct Opening {
  title: String
  icon: Asset
  line: String | nil
}

function opening(window: Window): Opening {
  return match (window) {
    .Character => { title: Locale.WINDOW_CHARACTER, icon: "Interface/Icons/INV_Chest_Cloth_17", line: "/click CharacterMicroButton" }
    .Spellbook => { title: Locale.WINDOW_SPELLBOOK, icon: "Interface/Icons/INV_Misc_Book_09", line: "/click SpellbookMicroButton" }
    .Talents => { title: Locale.WINDOW_TALENTS, icon: "Interface/Icons/Ability_Marksmanship", line: "/click TalentMicroButton" }
    .Quests => { title: Locale.WINDOW_QUESTS, icon: "Interface/Icons/INV_Misc_Book_08", line: "/click QuestLogMicroButton" }
    .Map => { title: Locale.WINDOW_MAP, icon: "Interface/Icons/INV_Misc_Map_01", line: "/run ToggleWorldMap()" }
    .Social => { title: Locale.WINDOW_SOCIAL, icon: "Interface/Icons/INV_Letter_15", line: "/run ToggleFriendsFrame()" }
    .Guild => { title: Locale.WINDOW_GUILD, icon: "Interface/Icons/INV_Shirt_GuildTabard_01", line: "/click GuildMicroButton" }
    .GroupFinder => { title: Locale.WINDOW_GROUP_FINDER, icon: "Interface/Icons/INV_Misc_GroupLooking", line: "/click LFDMicroButton" }
    .Calendar => { title: Locale.WINDOW_CALENDAR, icon: "Interface/Icons/INV_Misc_Note_02", line: "/run ToggleCalendar()" }
    .Bags => { title: Locale.WINDOW_BAGS, icon: "Interface/Icons/INV_Misc_Bag_08", line: "/run ToggleAllBags()" }
    .Settings => { title: Locale.WINDOW_SETTINGS, icon: "Interface/Icons/Trade_Engineering", line: nil }
    .Placing => { title: Locale.WINDOW_PLACING, icon: "Interface/Icons/Ability_Hunter_Pathfinding", line: nil }
  }
}

function pingTitle(ping: Ping): String {
  return match (ping) {
    .Attack => Locale.PING_ATTACK
    .Assist => Locale.PING_ASSIST
    .Warning => Locale.PING_WARNING
    .OnMyWay => Locale.PING_ON_MY_WAY
  }
}

const MARK_ICONS: Array<Asset> = [
  "Interface/TargetingFrame/UI-RaidTargetingIcon_1", "Interface/TargetingFrame/UI-RaidTargetingIcon_2",
  "Interface/TargetingFrame/UI-RaidTargetingIcon_3", "Interface/TargetingFrame/UI-RaidTargetingIcon_4",
  "Interface/TargetingFrame/UI-RaidTargetingIcon_5", "Interface/TargetingFrame/UI-RaidTargetingIcon_6",
  "Interface/TargetingFrame/UI-RaidTargetingIcon_7", "Interface/TargetingFrame/UI-RaidTargetingIcon_8"
]
const CLEAR: Asset = "Interface/Buttons/UI-GroupLoot-Pass-Up"

function markIcon(mark: Integer): Asset {
  return MARK_ICONS[mark] ?? CLEAR
}

// The client's icon of a spell the player has, by its name; none where the spellbook hasn't it.
function spellIcon(spell: String): FileId | nil {
  const icon, _, _ = Client.C_Spell.GetSpellTexture(spell)
  return icon
}

function bagCount(item: Integer): Number {
  return Client.C_Item.GetItemCount(item, nil, nil, nil, nil)
}

const OUT_OF_RANGE: Color = Color.hex("#ff4040")
const NO_POWER: Color = Color.hex("#4060ff")
// A cooldown shorter than this is the global one: no sweep for it.
const GLOBAL_COOLDOWN = 1.5

// A cooldown's run as the box takes it; none where there is none, or it is the global one.
function running(start: Number | nil, length: Number | nil): FillDuration | nil {
  if (start == nil || length == nil || length <= GLOBAL_COOLDOWN || start <= 0) { return nil }
  return { start: start, length: length }
}

// A spell as the action bars show it: its charges, red out of range of the target, blue without the power, its
// cooldown; dimmed where the spellbook hasn't it.
function spellShown(spell: String): WheelItem {
  const icon = spellIcon(spell)
  const charges = Client.C_Spell.GetSpellCharges(spell)
  const usable, noPower = Client.C_Spell.IsSpellUsable(spell)
  const inRange = Client.C_Spell.IsSpellInRange(spell, "target")
  const cooldown = Client.C_Spell.GetSpellCooldown(spell)
  return {
    name: spell, icon: icon ?? QUESTION, dim: icon == nil || !usable && !noPower, menu: false,
    count: charges != nil && charges.maxCharges > 1 ? String.of(charges.currentCharges) : "",
    tone: inRange == false ? OUT_OF_RANGE : noPower ? NO_POWER : nil,
    cooldown: running(cooldown?.startTime, cooldown?.duration), dots: 0, dot: 0
  }
}

// An item of the bags: how many the player holds, red out of range of the target, its cooldown; dimmed while the
// player hasn't it.
function bagShown(item: Integer): WheelItem {
  const count = bagCount(item)
  const inRange = Client.C_Item.IsItemInRange(item, "target")
  const start, length, _ = Client.C_Item.GetItemCooldown(item)
  return {
    name: Client.C_Item.GetItemNameByID(item) ?? String.of(item), icon: Client.C_Item.GetItemIconByID(item) ?? QUESTION,
    dim: count < 1, menu: false, count: count > 1 ? String.of(count.floor()) : "",
    tone: inRange == false ? OUT_OF_RANGE : nil, cooldown: running(start, length), dots: 0, dot: 0
  }
}

// A macro of the player's: its own icon; dimmed where the player has none so named.
function macroShown(macro: String): WheelItem {
  const name, icon, _ = Client.GetMacroInfo(macro)
  return plainItem(macro, icon ?? QUESTION, name == nil, false)
}

// How an item is drawn; a kind of another module's as it offers now (none: not loaded).
public function shown(item: Item, offer: RadialOffer | nil): WheelItem {
  return match (item) {
    .Empty => plainItem("", QUESTION, true, false)
    .Spell => spellShown(item.spell)
    .Bag => bagShown(item.item)
    .Macro => macroShown(item.macro)
    .Open => plainItem(opening(item.window).title, opening(item.window).icon, false, false)
    .RaidMark => plainItem(Locale.MARK.format(item.mark), markIcon(item.mark), false, false)
    .WorldMark => plainItem(Locale.WORLD_MARK.format(item.mark), markIcon(item.mark), false, false)
    .Pinged => plainItem(pingTitle(item.ping), "Interface/Icons/Ability_Hunter_MarkedForDeath", false, false)
    .Line => plainItem(item.title, item.icon, false, false)
    .Menu => plainItem(item.title, item.icon, false, true)
    .Slot => plainItem(item.title, item.icon, false, false)
    .Professions => plainItem(Locale.RING_PROFESSIONS, QUESTION, true, false)
    .Kind => offer != nil ? plainItem(offer.name, offer.icon, offer.dim, false) : plainItem(item.kind, QUESTION, true, false)
  }
}

function openAction(window: Window): WheelAction {
  const line = opening(window).line
  return line != nil ? WheelAction.MacroText { text: line } : WheelAction.Ours
}

// The word `/ping` takes for a kind.
function pingWord(ping: Ping): String {
  return match (ping) {
    .Attack => "attack"
    .Assist => "assist"
    .Warning => "warning"
    .OnMyWay => "onmyway"
  }
}

// What an item does; a kind of another module's what it offers now (none: nothing).
public function actionOf(item: Item, offer: RadialOffer | nil): WheelAction {
  return match (item) {
    .Empty, .Professions => WheelAction.Ours
    .Spell => .Spell { spell: item.spell }
    .Bag => .Item { item: item.item }
    .Macro => .Macro { macro: item.macro }
    .Open => openAction(item.window)
    .RaidMark => .MacroText { text: `/tm ${item.mark}` }
    .WorldMark => .MacroText { text: item.mark == 0 ? "/cwm all" : `/wm ${item.mark}` }
    .Pinged => .MacroText { text: `/ping ${pingWord(item.ping)}` }
    .Line => .MacroText { text: item.line }
    .Menu => WheelAction.Menu
    .Slot => .Slot { mode: item.mode }
    .Kind => offer?.action ?? WheelAction.Ours
  }
}

// An action done only in a form (the stance bar's place): the client's macro conditional before what it does.
public function inForm(action: WheelAction, form: Integer): WheelAction {
  const when = `[form:${form}]`
  return match (action) {
    .Spell => .MacroText { text: `/cast ${when} ${action.spell}` }
    .Item => .MacroText { text: `/use ${when} item:${action.item}` }
    // A macro of the player's says its own conditions.
    .Macro => action
    .MacroText => .MacroText { text: action.text.replace("^(/%S+)", (verb: String): String => `${verb} ${when}`) }
    .Menu, .Slot, .Ours => action
  }
}

// What the client refuses in a fight: the windows of ours that change what a fight locks (placing the frames, the
// settings that bind keys).
public function refusesInFight(item: Item): Boolean {
  return item is Item.Open && (item.window == Window.Placing || item.window == Window.Settings)
}
