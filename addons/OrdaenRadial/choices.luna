// What the player chooses for the wheels: each ring's items by their place, where it opens and how it names them.
import { SlotMode, WheelModifier, WheelNames } from "Ordaen"

// A window an item opens: the game's or Ordaen's.
public enum Window implements Plain {
  Character = "character", Spellbook = "spellbook", Talents = "talents", Quests = "quests", Map = "map"
  Social = "social", Guild = "guild", GroupFinder = "groupFinder", Calendar = "calendar", Bags = "bags"
  Settings = "settings", Placing = "placing"
}

// The client's ping kinds.
public enum Ping implements Plain { Attack = "attack", Assist = "assist", Warning = "warning", OnMyWay = "onmyway" }

// What an item of a ring is.
public enum Item implements Plain {
  // A place kept empty: its direction stays its own.
  Empty
  // A spell by its name (its highest rank), a mount's too.
  Spell { spell: string }
  // An item of the bags by its number: dimmed while the player hasn't it.
  Bag { item: integer }
  // A macro of the player's, by its name.
  Macro { macro: string }
  Open { window: Window }
  // A raid mark on the target (1 star to 8 skull; 0 takes it away).
  RaidMark { mark: integer }
  // A world mark at the cursor (1 to 8; 0 takes them all away).
  WorldMark { mark: integer }
  Pinged { ping: Ping }
  // A line of a macro: an emote (`/wave`), a command (`/readycheck`, `/roll`, `/reload`).
  Line { title: string, line: string, icon: Asset }
  // An emote of the client's, by its token (`LAUGH`): named by its command in the player's language (`/смех`), no icon.
  Emote { token: string }
  // Its own ring, in place: its items stand under its place (`3_1`, `3_2`). With no icon, its title stands in its place.
  Menu { title: string, icon: Asset | nil }
  // The player's professions, a ring of them: each opens its window.
  Professions
  // A slot of several: its children stand under its place, as a submenu's do; it does the current one.
  Slot { title: string, icon: Asset, mode: SlotMode }
  // A kind another module adds (`Radial.kinds`), by its id: what it offers now.
  Kind { kind: string }
}

// Where a ring's wheel is drawn: at the screen's middle (the preset's), or at the cursor. It aims from where the cursor
// was as it opened either way.
public enum OpensAt implements Plain { Cursor = "cursor", Middle = "middle" }

public struct Ring implements Plain {
  public mut opensAt: OpensAt
  public mut names: WheelNames
  public mut scale: number
  // Letting go in the middle of a submenu does the item last used there.
  public mut remember: boolean
  // Anchored: the wheel's middle is the aim's while the cursor is on it, and follows the cursor once it goes off.
  public mut anchored: boolean = true
  // How many items each of its rings holds, by the ring's place (`""` the ring itself, `"3"` the third's submenu),
  // and each item by its place (`"1"` to `"8"`, `"3_2"`).
  public mut counts: mut map<string, integer>
  public mut items: mut map<string, Item>
  // When an item may be used, by its place: one with none always.
  public mut conditions: mut map<string, Condition>
  // The icon the player chose for a place, over the item's own; a place with none shows its item's.
  public mut icons: mut map<string, PlaceIcon> = {}
}

// An icon chosen for a place: the client's file by its number or path, or none (its name stands in its wedge).
public struct PlaceIcon implements Plain {
  public mut icon: FileId | Asset | nil
}

public struct Choices implements Plain {
  // The rings on the keys `ORDAEN_RADIAL_1` to `_3`, in order.
  public mut rings: array<Ring>
}

// When an item may be used: a class's alone (the client's tag, `WARRIOR`), in a form alone (the stance bar's place,
// 0 none), with a modifier held alone. An item whose condition doesn't hold is dimmed where it stands.
public struct Condition implements Plain {
  public mut classTag: string | nil
  public mut form: integer | nil
  public mut modifier: WheelModifier | nil
}
