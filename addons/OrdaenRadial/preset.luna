// The wheels as they come: one ring on the first key, eight directions each opening a ring of its own; the raid marks
// and the pings each a ring of their own on the next keys, where in a fight one flick beats two.
import { WheelNames } from "Ordaen"
import { Choices, Item, OpensAt, Ping, Ring, Window } from "@/choices"
import { EMOTES, SILENT } from "@/emotes"
import Locale from "@/locales"
import { emptyUnder, removePlace, within } from "@/places"

// A ring from its rings' sizes and its items, each by its place.
function ring(counts: mut map<string, integer>, placed: array<(string, Item)>): mut Ring {
  const items: map<string, Item> = mut {}
  for (pair of placed) { items[pair[1]] = pair[2] }
  return mut { opensAt: OpensAt::Middle, names: WheelNames::Chosen, scale: 1, remember: false, anchored: true, counts: counts, items: items, conditions: mut {} }
}

function line(title: string, text: string, icon: Asset): Item {
  return .Line { title: title, line: text, icon: icon }
}

// Every emote under a place: its families, each a submenu of its groups, each a submenu of its emotes, all named
// and none with an icon.
function addEmotes(target: mut Ring, at: string) {
  const counts = target.counts
  const items = target.items
  counts[at] = EMOTES.length
  for (familyIndex, family of EMOTES) {
    const familyAt = `${at}_${familyIndex}`
    items[familyAt] = .Menu { title: family.title, icon: nil }
    counts[familyAt] = family.groups.length
    for (groupIndex, group of family.groups) {
      const groupAt = `${familyAt}_${groupIndex}`
      items[groupAt] = .Menu { title: group.title, icon: nil }
      counts[groupAt] = group.tokens.length
      for (index, token of group.tokens) { items[`${groupAt}_${index}`] = .Emote { token: token } }
    }
  }
}

// The emote lines an older preset put in its Emotes submenu, in order: a submenu that still holds exactly these was
// never changed by the player.
const OLD_EMOTE_LINES: array<string> = ["/wave", "/thank", "/cheer", "/laugh", "/bow", "/dance", "/salute", "/cry"]

// Whether a submenu holds the older preset's emote lines and nothing else.
function holdsOldEmotes(saved: Ring, at: string): boolean {
  if ((saved.counts[at] ?? 0) != OLD_EMOTE_LINES.length) { return false }
  for (index, wanted of OLD_EMOTE_LINES) {
    const item = saved.items[within(at, index)]
    if (!(item is Item::Line) || item.line != wanted) { return false }
  }
  return true
}

// A place of a ring that holds an emote the server does nothing for (`SILENT`); none where no place does.
function silentPlace(shown: Ring): string | nil {
  for (place, item of shown.items) {
    if (item is Item::Emote && SILENT.any(token => token == item.token)) { return place }
  }
  return nil
}

// A ring saved by an older build, made as this one makes it: its untouched Emotes submenu the whole tree of emotes,
// and every emote the server does nothing for taken away (those after it in its submenu moving up); none where
// nothing changes.
public function upgraded(saved: Ring): Ring | nil {
  const fresh = saved.clone()
  for (place, item of saved.items) {
    if (item is Item::Menu && holdsOldEmotes(saved, place)) {
      emptyUnder(fresh, place)
      addEmotes(fresh, place)
      break
    }
  }
  for (pass of 1..) {
    const place = silentPlace(fresh)
    if (place == nil) { break }
    removePlace(fresh, place)
  }
  return fresh.equal(saved) ? nil : fresh
}

// The first key's ring: Windows up, then clockwise Professions, Pings, Marks, Emotes, Travel, Group, Placing.
function main(): Ring {
  const first = firstRing()
  addEmotes(first, "5")
  return first
}

function firstRing(): mut Ring {
  return ring(mut { [""]: 8, ["1"]: 8, ["2"]: 1, ["3"]: 4, ["4"]: 8, ["6"]: 2, ["7"]: 3, ["8"]: 3 }, [
    ("1", .Menu { title: Locale::RING_WINDOWS, icon: "Interface/Icons/INV_Misc_Book_09" }),
    ("1_1", .Open { window: Window::Character }),
    ("1_2", .Open { window: Window::Spellbook }),
    ("1_3", .Open { window: Window::Talents }),
    ("1_4", .Open { window: Window::Quests }),
    ("1_5", .Open { window: Window::Map }),
    ("1_6", .Open { window: Window::Social }),
    ("1_7", .Open { window: Window::Bags }),
    ("1_8", .Open { window: Window::Settings }),
    ("2", .Menu { title: Locale::RING_PROFESSIONS, icon: "Interface/Icons/Trade_BlackSmithing" }),
    ("2_1", Item::Professions),
    ("3", .Menu { title: Locale::RING_PINGS, icon: "Interface/Icons/Ability_Hunter_MarkedForDeath" }),
    ("3_1", .Pinged { ping: Ping::Attack }),
    ("3_2", .Pinged { ping: Ping::Assist }),
    ("3_3", .Pinged { ping: Ping::Warning }),
    ("3_4", .Pinged { ping: Ping::OnMyWay }),
    ("4", .Menu { title: Locale::RING_MARKS, icon: "Interface/TargetingFrame/UI-RaidTargetingIcon_8" }),
    ("4_1", .RaidMark { mark: 8 }),
    ("4_2", .RaidMark { mark: 7 }),
    ("4_3", .RaidMark { mark: 6 }),
    ("4_4", .RaidMark { mark: 5 }),
    ("4_5", .RaidMark { mark: 4 }),
    ("4_6", .RaidMark { mark: 3 }),
    ("4_7", .RaidMark { mark: 2 }),
    ("4_8", .RaidMark { mark: 1 }),
    ("5", .Menu { title: Locale::RING_EMOTES, icon: "Interface/Icons/Spell_Holy_Excorcism" }),
    ("6", .Menu { title: Locale::RING_TRAVEL, icon: "Interface/Icons/INV_Misc_Rune_01" }),
    ("6_1", .Bag { item: 6948 }),
    ("6_2", Item::Empty),
    ("7", .Menu { title: Locale::RING_GROUP, icon: "Interface/Icons/INV_Misc_GroupNeedMore" }),
    ("7_1", line(Locale::GROUP_READY, "/readycheck", "Interface/RaidFrame/ReadyCheck-Ready")),
    ("7_2", line(Locale::GROUP_ROLL, "/roll", "Interface/Buttons/UI-GroupLoot-Dice-Up")),
    ("7_3", line(Locale::GROUP_LEAVE, "/leave", "Interface/Icons/Ability_Rogue_Sprint")),
    ("8", .Menu { title: Locale::RING_PLACING, icon: "Interface/Icons/Trade_Engineering" }),
    ("8_1", .Open { window: Window::Placing }),
    ("8_2", .Open { window: Window::Settings }),
    ("8_3", line(Locale::PLACING_RELOAD, "/reload", "Interface/Icons/Spell_Holy_BorrowedTime"))
  ])
}

// The raid marks round a ring of their own: skull up, then clockwise.
function marks(): Ring {
  const placed: array<(string, Item)> = mut []
  for (index of 1..8) { placed.push((string::of(index), .RaidMark { mark: 9 - index })) }
  return ring(mut { [""]: 8 }, placed)
}

function pings(): Ring {
  return ring(mut { [""]: 4 }, [
    ("1", .Pinged { ping: Ping::Attack }),
    ("2", .Pinged { ping: Ping::Assist }),
    ("3", .Pinged { ping: Ping::Warning }),
    ("4", .Pinged { ping: Ping::OnMyWay })
  ])
}

public function preset(): Choices {
  return { rings: [main(), marks(), pings()] }
}

// One ring as it comes: «Back to the preset».
public function presetRing(index: integer): Ring {
  return preset().rings[index] ?? panic("the preset has a ring for each key")
}
