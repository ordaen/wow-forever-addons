// The wheels as they come: one ring on the first key, seven directions each opening a ring of its own; the raid marks
// and the pings each a ring of their own on the next keys, where in a fight one flick beats two.
import { WheelNames } from "Ordaen"
import { Choices, Item, OpensAt, Ping, Ring, Window } from "@/choices"
import { EMOTES } from "@/emotes"
import Locale from "@/locales"

// A ring from its rings' sizes and its items, each by its place.
function ring(counts: mut Map<String, Integer>, placed: Array<[String, Item]>): mut Ring {
  const items: Map<String, Item> = {}
  for (pair of placed) { items[pair[1]] = pair[2] }
  return { opensAt: OpensAt.Middle, names: WheelNames.Chosen, scale: 1, remember: false, anchored: true, counts: counts, items: items, conditions: {} }
}

function line(title: String, text: String, icon: Asset): Item {
  return .Line { title: title, line: text, icon: icon }
}

// Every emote under a place: its families, each a submenu of its groups, each a submenu of its emotes, all named
// and none with an icon.
function addEmotes(target: mut Ring, at: String) {
  const counts = target.counts
  const items = target.items
  counts[at] = EMOTES.length
  for (familyIndex, family of EMOTES) {
    const familyAt = `${at}_${familyIndex}`
    items[familyAt] = .Menu { title: family.title, icon: nil }
    counts[familyAt] = family.groups.length
    for (groupIndex, group of family.groups) {
      const groupAt = `${familyAt}_${groupIndex}`
      items[groupAt] = .Menu { title: group.title, icon: nil }
      counts[groupAt] = group.tokens.length
      for (index, token of group.tokens) { items[`${groupAt}_${index}`] = .Emote { token: token } }
    }
  }
}

// The first key's ring: Professions up, then clockwise Pings, Marks, Emotes, Travel, Group, Placing.
function main(): Ring {
  const first = firstRing()
  addEmotes(mut first, "4")
  return first
}

function firstRing(): mut Ring {
  return ring({ [""]: 7, ["1"]: 1, ["2"]: 4, ["3"]: 8, ["5"]: 2, ["6"]: 3, ["7"]: 3 }, [
    ["1", .Menu { title: Locale.RING_PROFESSIONS, icon: "Interface/Icons/Trade_BlackSmithing" }],
    ["1_1", Item.Professions],
    ["2", .Menu { title: Locale.RING_PINGS, icon: "Interface/Icons/Ability_Hunter_MarkedForDeath" }],
    ["2_1", .Pinged { ping: Ping.Attack }],
    ["2_2", .Pinged { ping: Ping.Assist }],
    ["2_3", .Pinged { ping: Ping.Warning }],
    ["2_4", .Pinged { ping: Ping.OnMyWay }],
    ["3", .Menu { title: Locale.RING_MARKS, icon: "Interface/TargetingFrame/UI-RaidTargetingIcon_8" }],
    ["3_1", .RaidMark { mark: 8 }],
    ["3_2", .RaidMark { mark: 7 }],
    ["3_3", .RaidMark { mark: 6 }],
    ["3_4", .RaidMark { mark: 5 }],
    ["3_5", .RaidMark { mark: 4 }],
    ["3_6", .RaidMark { mark: 3 }],
    ["3_7", .RaidMark { mark: 2 }],
    ["3_8", .RaidMark { mark: 1 }],
    ["4", .Menu { title: Locale.RING_EMOTES, icon: "Interface/Icons/Spell_Holy_Excorcism" }],
    ["5", .Menu { title: Locale.RING_TRAVEL, icon: "Interface/Icons/INV_Misc_Rune_01" }],
    ["5_1", .Bag { item: 6948 }],
    ["5_2", Item.Empty],
    ["6", .Menu { title: Locale.RING_GROUP, icon: "Interface/Icons/INV_Misc_GroupNeedMore" }],
    ["6_1", line(Locale.GROUP_READY, "/readycheck", "Interface/RaidFrame/ReadyCheck-Ready")],
    ["6_2", line(Locale.GROUP_ROLL, "/roll", "Interface/Buttons/UI-GroupLoot-Dice-Up")],
    ["6_3", line(Locale.GROUP_LEAVE, "/leave", "Interface/Icons/Ability_Rogue_Sprint")],
    ["7", .Menu { title: Locale.RING_PLACING, icon: "Interface/Icons/Trade_Engineering" }],
    ["7_1", .Open { window: Window.Placing }],
    ["7_2", .Open { window: Window.Settings }],
    ["7_3", line(Locale.PLACING_RELOAD, "/reload", "Interface/Icons/Spell_Holy_BorrowedTime")]
  ])
}

// The raid marks round a ring of their own: skull up, then clockwise.
function marks(): Ring {
  const placed: Array<[String, Item]> = []
  for (index of 1..8) { placed.push([String.of(index), .RaidMark { mark: 9 - index }]) }
  return ring({ [""]: 8 }, placed)
}

function pings(): Ring {
  return ring({ [""]: 4 }, [
    ["1", .Pinged { ping: Ping.Attack }],
    ["2", .Pinged { ping: Ping.Assist }],
    ["3", .Pinged { ping: Ping.Warning }],
    ["4", .Pinged { ping: Ping.OnMyWay }]
  ])
}

public function preset(): Choices {
  return { rings: [main(), marks(), pings()] }
}

// One ring as it comes: «Back to the preset».
public function presetRing(index: Integer): Ring {
  return preset().rings[index] ?? panic("the preset has a ring for each key")
}
