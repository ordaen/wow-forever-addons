// The wheels as they come: one ring on the first key, eight directions each opening a ring of its own; the raid marks
// and the pings each a ring of their own on the next keys, where in a fight one flick beats two.
import { WheelNames } from "Ordaen"
import { Choices, Item, OpensAt, Ping, Ring, Window } from "@/choices"
import Locale from "@/locales"

// A ring from its rings' sizes and its items, each by its place.
function ring(counts: Map<String, Integer>, placed: Array<[String, Item]>): Ring {
  const items: Map<String, Item> = {}
  for (pair of placed) { items[pair[1]] = pair[2] }
  return { opensAt: OpensAt.Middle, names: WheelNames.Chosen, scale: 1, remember: false, anchored: true, counts: counts, items: items, conditions: {} }
}

function line(title: String, text: String, icon: Asset): Item {
  return .Line { title: title, line: text, icon: icon }
}

// The first key's ring: Windows up, then clockwise Professions, Pings, Marks, Emotes, Travel, Group, Placing.
function main(): Ring {
  return ring({ [""]: 8, ["1"]: 8, ["2"]: 1, ["3"]: 4, ["4"]: 8, ["5"]: 8, ["6"]: 2, ["7"]: 3, ["8"]: 3 }, [
    ["1", .Menu { title: Locale.RING_WINDOWS, icon: "Interface/Icons/INV_Misc_Book_09" }],
    ["1_1", .Open { window: Window.Character }],
    ["1_2", .Open { window: Window.Spellbook }],
    ["1_3", .Open { window: Window.Talents }],
    ["1_4", .Open { window: Window.Quests }],
    ["1_5", .Open { window: Window.Map }],
    ["1_6", .Open { window: Window.Social }],
    ["1_7", .Open { window: Window.Bags }],
    ["1_8", .Open { window: Window.Settings }],
    ["2", .Menu { title: Locale.RING_PROFESSIONS, icon: "Interface/Icons/Trade_BlackSmithing" }],
    ["2_1", Item.Professions],
    ["3", .Menu { title: Locale.RING_PINGS, icon: "Interface/Icons/Ability_Hunter_MarkedForDeath" }],
    ["3_1", .Pinged { ping: Ping.Attack }],
    ["3_2", .Pinged { ping: Ping.Assist }],
    ["3_3", .Pinged { ping: Ping.Warning }],
    ["3_4", .Pinged { ping: Ping.OnMyWay }],
    ["4", .Menu { title: Locale.RING_MARKS, icon: "Interface/TargetingFrame/UI-RaidTargetingIcon_8" }],
    ["4_1", .RaidMark { mark: 8 }],
    ["4_2", .RaidMark { mark: 7 }],
    ["4_3", .RaidMark { mark: 6 }],
    ["4_4", .RaidMark { mark: 5 }],
    ["4_5", .RaidMark { mark: 4 }],
    ["4_6", .RaidMark { mark: 3 }],
    ["4_7", .RaidMark { mark: 2 }],
    ["4_8", .RaidMark { mark: 1 }],
    ["5", .Menu { title: Locale.RING_EMOTES, icon: "Interface/Icons/Spell_Holy_Excorcism" }],
    ["5_1", line(Locale.EMOTE_WAVE, "/wave", "Interface/Icons/INV_Misc_Toy_10")],
    ["5_2", line(Locale.EMOTE_THANK, "/thank", "Interface/Icons/INV_ValentinesCard02")],
    ["5_3", line(Locale.EMOTE_CHEER, "/cheer", "Interface/Icons/Achievement_Reputation_01")],
    ["5_4", line(Locale.EMOTE_LAUGH, "/laugh", "Interface/Icons/INV_Misc_Toy_07")],
    ["5_5", line(Locale.EMOTE_BOW, "/bow", "Interface/Icons/Achievement_Reputation_08")],
    ["5_6", line(Locale.EMOTE_DANCE, "/dance", "Interface/Icons/INV_Misc_Toy_06")],
    ["5_7", line(Locale.EMOTE_SALUTE, "/salute", "Interface/Icons/Achievement_PVP_A_A")],
    ["5_8", line(Locale.EMOTE_CRY, "/cry", "Interface/Icons/INV_Misc_Food_Lunchbox_White")],
    ["6", .Menu { title: Locale.RING_TRAVEL, icon: "Interface/Icons/INV_Misc_Rune_01" }],
    ["6_1", .Bag { item: 6948 }],
    ["6_2", Item.Empty],
    ["7", .Menu { title: Locale.RING_GROUP, icon: "Interface/Icons/INV_Misc_GroupNeedMore" }],
    ["7_1", line(Locale.GROUP_READY, "/readycheck", "Interface/RaidFrame/ReadyCheck-Ready")],
    ["7_2", line(Locale.GROUP_ROLL, "/roll", "Interface/Buttons/UI-GroupLoot-Dice-Up")],
    ["7_3", line(Locale.GROUP_LEAVE, "/leave", "Interface/Icons/Ability_Rogue_Sprint")],
    ["8", .Menu { title: Locale.RING_PLACING, icon: "Interface/Icons/Trade_Engineering" }],
    ["8_1", .Open { window: Window.Placing }],
    ["8_2", .Open { window: Window.Settings }],
    ["8_3", line(Locale.PLACING_RELOAD, "/reload", "Interface/Icons/Spell_Holy_BorrowedTime")]
  ])
}

// The raid marks round a ring of their own: skull up, then clockwise.
function marks(): Ring {
  const placed: Array<[String, Item]> = []
  for (index of 1..8) { placed.push([String.of(index), .RaidMark { mark: 9 - index }]) }
  return ring({ [""]: 8 }, placed)
}

function pings(): Ring {
  return ring({ [""]: 4 }, [
    ["1", .Pinged { ping: Ping.Attack }],
    ["2", .Pinged { ping: Ping.Assist }],
    ["3", .Pinged { ping: Ping.Warning }],
    ["4", .Pinged { ping: Ping.OnMyWay }]
  ])
}

public function preset(): Choices {
  return { rings: [main(), marks(), pings()] }
}

// One ring as it comes: «Back to the preset».
public function presetRing(index: Integer): Ring {
  return preset().rings[index] ?? panic("the preset has a ring for each key")
}
