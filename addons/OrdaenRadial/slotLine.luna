// One place of a ring in the settings' tree: stood in as deep as it is, a mark open or closed where it holds items
// (a submenu, a slot), its number and what stands there, and its kind at the right. A click chooses it (and opens or
// closes one that holds items): the page says which is chosen.
import { Art, Position, TextAlign } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, PickRow, SECONDARY_TEXT } from "Ordaen"

// What a line shows of its place.
public struct SlotRow {
  place: string
  depth: integer
  // Its number and what stands there (`3. Pings`).
  label: string
  // What kind of item it is, as the catalogue names it.
  kind: string
  // A submenu or a slot: its mark, open while its items are shown under it.
  holds: boolean
  open: boolean
}

const INDENT = 18.75dp
const MARK = 18.75dp
const MARK_TINT: Color = Color::hex("#d6a56b")
const KIND: Color = Color::hex("#a89a80")

public class SlotLine implements Component {
  public chosen: Event<string> = new Event()

  derived gutter: number<Length> = self.row.depth * INDENT + MARK
  derived mark: Art = self.row.open ? Ordaen.art.ctl.markOpen : Ordaen.art.ctl.markClosed

  row: Signal<SlotRow>
  picked: Signal<boolean>
  constructor(row: Signal<SlotRow>, picked: Signal<boolean>) {
    self.row = row
    self.picked = picked
  }

  onPick() { self.chosen.emit(self.row.place) }

  public render(): Template {
    return $ltml {
      <PickRow columns={[self.gutter, { fr: 1 }, "max-content"]} picked={self.picked} @pick={self.onPick}>
        <box width={self.gutter} height={MARK}>
          <box $if={self.row.holds} position={Position::Absolute} left={self.gutter - MARK} top={0dp} width={MARK}
               height={MARK} background={self.mark} tint={MARK_TINT} />
        </box>
        <text value={self.row.label} wrap={.Cut} />
        <text value={self.row.kind} textSize={SECONDARY_TEXT} textColor={KIND} textAlign={TextAlign::End} wrap={.None} />
      </PickRow>
    }
  }
}
