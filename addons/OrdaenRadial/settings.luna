// The wheels' tab in the settings window: a ring chosen, where it opens and how it names its items, its key (the
// client's Key Bindings window binds it), each of its places given an item from the catalogue, and «Back to the
// preset» for the ring or for all. A change applies at once; out of a fight the wheel takes it, in one at its end.
import Client from "$client"
import { Align, Line } from "$ltml"
import { Checkbox, Choice, Component, Dropdown, Fact, NumberInput, PushButton, Section, Settings, SlotMode, TextField, Unit, WheelModifier, WheelNames } from "Ordaen"
import { Choices, Condition, Item, OpensAt, Ping, Ring, Window } from "@/choices"
import { RadialKind } from "@/kinds"
import Locale from "@/locales"
import { preset, presetRing } from "@/preset"

const RINGS: Array<Choice<Integer>> = [
  { value: 1, label: Locale.RING_FIRST },
  { value: 2, label: Locale.RING_SECOND },
  { value: 3, label: Locale.RING_THIRD }
]
const OPENS: Array<Choice<OpensAt>> = [
  { value: OpensAt.Cursor, label: Locale.OPENS_CURSOR },
  { value: OpensAt.Middle, label: Locale.OPENS_MIDDLE }
]
const NAMES: Array<Choice<WheelNames>> = [
  { value: WheelNames.Off, label: Locale.NAMES_OFF },
  { value: WheelNames.Chosen, label: Locale.NAMES_CHOSEN },
  { value: WheelNames.Always, label: Locale.NAMES_ALWAYS }
]

// What can stand in a place: the catalogue, by a name of its own; a spell, an item, a macro and a submenu take the
// text written beside it.
public const CATALOGUE: Array<Choice<String>> = [
  { value: "empty", label: Locale.KIND_EMPTY },
  { value: "spell", label: Locale.KIND_SPELL },
  { value: "item", label: Locale.KIND_ITEM },
  { value: "macro", label: Locale.KIND_MACRO },
  { value: "menu", label: Locale.KIND_MENU },
  { value: "professions", label: Locale.RING_PROFESSIONS },
  { value: "character", label: Locale.WINDOW_CHARACTER },
  { value: "spellbook", label: Locale.WINDOW_SPELLBOOK },
  { value: "talents", label: Locale.WINDOW_TALENTS },
  { value: "quests", label: Locale.WINDOW_QUESTS },
  { value: "map", label: Locale.WINDOW_MAP },
  { value: "social", label: Locale.WINDOW_SOCIAL },
  { value: "guild", label: Locale.WINDOW_GUILD },
  { value: "groupFinder", label: Locale.WINDOW_GROUP_FINDER },
  { value: "calendar", label: Locale.WINDOW_CALENDAR },
  { value: "bags", label: Locale.WINDOW_BAGS },
  { value: "settings", label: Locale.WINDOW_SETTINGS },
  { value: "placing", label: Locale.WINDOW_PLACING },
  { value: "attack", label: Locale.PING_ATTACK },
  { value: "assist", label: Locale.PING_ASSIST },
  { value: "warning", label: Locale.PING_WARNING },
  { value: "onmyway", label: Locale.PING_ON_MY_WAY },
  { value: "mark", label: Locale.KIND_MARK },
  { value: "worldMark", label: Locale.KIND_WORLD_MARK },
  { value: "line", label: Locale.KIND_LINE },
  { value: "slotCycle", label: Locale.KIND_SLOT_CYCLE },
  { value: "slotRemember", label: Locale.KIND_SLOT_REMEMBER },
  { value: "slotFirst", label: Locale.KIND_SLOT_FIRST }
]

const DROP_EDGE: Line = { width: 1dp, color: Color.hex("#6c5535") }
const MENU_ICON: Asset = "Interface/Icons/INV_Misc_Bag_07"
const LINE_ICON: Asset = "Interface/Icons/INV_Misc_Note_01"

// The item a catalogue's entry makes, with the text written beside it.
public function itemOf(kind: String, text: String): Item {
  const number = text.toNumber()
  const whole = number != nil ? number.floor() : 0
  return match (kind) {
    "spell" => .Spell { spell: text }
    "item" => .Bag { item: whole }
    "macro" => .Macro { macro: text }
    "menu" => .Menu { title: text, icon: MENU_ICON }
    "professions" => Item.Professions
    "mark" => .RaidMark { mark: whole }
    "worldMark" => .WorldMark { mark: whole }
    "line" => .Line { title: text, line: text, icon: LINE_ICON }
    "attack" => .Pinged { ping: Ping.Attack }
    "assist" => .Pinged { ping: Ping.Assist }
    "warning" => .Pinged { ping: Ping.Warning }
    "onmyway" => .Pinged { ping: Ping.OnMyWay }
    "character" => .Open { window: Window.Character }
    "spellbook" => .Open { window: Window.Spellbook }
    "talents" => .Open { window: Window.Talents }
    "quests" => .Open { window: Window.Quests }
    "map" => .Open { window: Window.Map }
    "social" => .Open { window: Window.Social }
    "guild" => .Open { window: Window.Guild }
    "groupFinder" => .Open { window: Window.GroupFinder }
    "calendar" => .Open { window: Window.Calendar }
    "bags" => .Open { window: Window.Bags }
    "settings" => .Open { window: Window.Settings }
    "placing" => .Open { window: Window.Placing }
    "slotCycle" => .Slot { title: text, icon: MENU_ICON, mode: SlotMode.Cycle }
    "slotRemember" => .Slot { title: text, icon: MENU_ICON, mode: SlotMode.Remember }
    "slotFirst" => .Slot { title: text, icon: MENU_ICON, mode: SlotMode.First }
    else => kind.sub(1, 5) == "kind:" ? Item.Kind { kind: kind.sub(6) } : Item.Empty
  }
}

const MODIFIERS: Array<Choice<String>> = [
  { value: "", label: Locale.MODIFIER_NONE },
  { value: "shift", label: Locale.MODIFIER_SHIFT },
  { value: "ctrl", label: Locale.MODIFIER_CTRL },
  { value: "alt", label: Locale.MODIFIER_ALT }
]

// A condition from what the tab's fields say; none where they say nothing.
public function conditionOf(classTag: String, form: String, modifier: String): Condition | nil {
  const tag = classTag.upper()
  const number = form.toNumber()
  const held: WheelModifier | nil = match (modifier) {
    "shift" => WheelModifier.Shift
    "ctrl" => WheelModifier.Ctrl
    "alt" => WheelModifier.Alt
    else => nil
  }
  if (tag == "" && number == nil && held == nil) { return nil }
  return { classTag: tag == "" ? nil : tag, form: number?.floor(), modifier: held }
}

// What the cursor holds, as an item of a ring: a spell (by its name), an item of the bags, a macro of the player's;
// none for anything else.
public function heldItem(): Item | nil {
  const kind, first, _, spellId = Client.GetCursorInfo()
  if (kind == "spell" && spellId is Integer) {
    const name = Client.C_Spell.GetSpellName(spellId)
    return name != nil ? Item.Spell { spell: name } : nil
  }
  if (kind == "item" && first is Integer) { return .Bag { item: first } }
  if (kind == "macro" && first is Integer) {
    const name, _, _ = Client.GetMacroInfo(first)
    return name != nil ? Item.Macro { macro: name } : nil
  }
  return nil
}

public class RingsPage implements Component {
  // The ring and the place being given an item, the item and its condition.
  state ring = 1
  state place = "1"
  state kind = "spell"
  state text = ""
  state classTag = ""
  state form = ""
  state modifier = ""
  state opensAt: OpensAt = OpensAt.Middle
  state names: WheelNames = WheelNames.Chosen
  state scale: Number = 1
  state remember = false
  state anchored = true
  derived keys: String = self.keysOf()
  // The catalogue, with the kinds other modules add as the page is made.
  const catalogue: Array<Choice<String>>

  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>, kinds: Signal<Array<any RadialKind>>) {
    self.settings = settings
    const all: Array<Choice<String>> = []
    for (choice of CATALOGUE) { all.push(choice) }
    for (kind of peek kinds) { all.push({ value: `kind:${kind.id}`, label: kind.title }) }
    self.catalogue = all
    watch (ring of self.ring) { self.load(ring) }
    watch (opensAt of self.opensAt) { self.change((r: mut Ring): nil => { r.opensAt = opensAt }) }
    watch (names of self.names) { self.change((r: mut Ring): nil => { r.names = names }) }
    watch (scale of self.scale) { self.change((r: mut Ring): nil => { r.scale = scale }) }
    watch (remember of self.remember) { self.change((r: mut Ring): nil => { r.remember = remember }) }
    watch (anchored of self.anchored) { self.change((r: mut Ring): nil => { r.anchored = anchored }) }
  }

  load(mut self, index: Integer) {
    const ring = (peek self.settings.values).rings[index]
    if (ring == nil) { return }
    self.opensAt = ring.opensAt
    self.names = ring.names
    self.scale = ring.scale
    self.remember = ring.remember
    self.anchored = ring.anchored
  }

  // The chosen ring changed as `edit` changes it, unless it is already so.
  change(mut self, edit: (ring: mut Ring) => nil) {
    const rings = (peek self.settings.values).rings.clone()
    const index = peek self.ring
    const held = rings[index]
    if (held == nil) { return }
    const ring = held.clone()
    edit(mut ring)
    if (ring.equal(held)) { return }
    rings[index] = ring
    self.settings.values.rings = rings
  }

  keysOf(self): String {
    const first, second = Client.GetBindingKey(`ORDAEN_RADIAL_${self.ring}`)
    if (first == nil) { return Locale.KEY_NONE }
    return second == nil ? first : `${first}, ${second}`
  }

  // An item put in the place chosen, on the condition the fields say.
  putItem(mut self, item: Item) {
    const place = self.place
    const condition = conditionOf(self.classTag, self.form, self.modifier)
    self.change((r: mut Ring): nil => {
      r.items[place] = item
      r.conditions[place] = condition
      // A place past the ring's count grows it; a submenu or a slot starts with no items.
      const ring = place.match("^(.+)_%d+$") ?? ""
      const index = (place.match("(%d+)$") ?? "0").toNumber() ?? 0
      if ((r.counts[ring] ?? 0) < index) { r.counts[ring] = index.floor() }
      if ((item is Item.Menu || item is Item.Slot) && r.counts[place] == nil) { r.counts[place] = 0 }
    })
  }

  // The catalogue's item chosen put in the place chosen.
  put(mut self) { self.putItem(itemOf(self.kind, self.text)) }

  // What the cursor holds (a spell from the spellbook, an item from the bags, a macro), let go here: put in the place
  // chosen, and the cursor emptied.
  dropped(mut self) {
    const item = heldItem()
    if (item == nil) { return }
    self.putItem(item)
    Client.ClearCursor()
  }

  resetRing(mut self) {
    const fresh = presetRing(peek self.ring)
    self.change((r: mut Ring): nil => {
      r.opensAt = fresh.opensAt
      r.names = fresh.names
      r.scale = fresh.scale
      r.remember = fresh.remember
      r.anchored = fresh.anchored
      r.counts = fresh.counts.clone()
      r.items = fresh.items.clone()
      r.conditions = fresh.conditions.clone()
    })
    self.load(peek self.ring)
  }

  resetAll(mut self) {
    self.settings.values.rings = preset().rings
    self.load(peek self.ring)
  }

  public render(self): Template {
    return $ltml {
      <Section title={Locale.SECTION_RING}>
        <Dropdown label={Locale.RING} value={mut self.ring} choices={RINGS} />
        <Fact label={Locale.RING_KEY} value={self.keys} />
        <Dropdown label={Locale.OPENS_AT} value={mut self.opensAt} choices={OPENS} />
        <Dropdown label={Locale.NAMES} value={mut self.names} choices={NAMES} />
        <NumberInput label={Locale.SCALE} value={mut self.scale} least={0.6} most={2} step={0.05} unit={Unit.Percent} />
        <Checkbox label={Locale.REMEMBER} hint={Locale.REMEMBER_TIP} value={mut self.remember} />
        <Checkbox label={Locale.ANCHORED} hint={Locale.ANCHORED_TIP} value={mut self.anchored} />
      </Section>
      <Section title={Locale.SECTION_ITEM}>
        <TextField label={Locale.PLACE} hint={Locale.PLACE_TIP} value={mut self.place} />
        <Dropdown label={Locale.KIND} value={mut self.kind} choices={self.catalogue} />
        <TextField label={Locale.ITEM_TEXT} hint={Locale.ITEM_TEXT_TIP} value={mut self.text} />
        <TextField label={Locale.CONDITION_CLASS} hint={Locale.CONDITION_CLASS_TIP} value={mut self.classTag} />
        <TextField label={Locale.CONDITION_FORM} hint={Locale.CONDITION_FORM_TIP} value={mut self.form} />
        <Dropdown label={Locale.CONDITION_MODIFIER} value={mut self.modifier} choices={MODIFIERS} />
        <PushButton label={Locale.PUT} width={160dp} @click={self.put} />
        <box padding={{ top: 3sp, bottom: 3sp }} border={DROP_EDGE} xAlign={Align.Center} @drop={self.dropped}
             @pointerPress={self.dropped}>
          <text value={Locale.DROP} />
        </box>
      </Section>
      <Section title={Locale.SECTION_PRESET}>
        <PushButton label={Locale.RESET_RING} width={160dp} @click={self.resetRing} />
        <PushButton label={Locale.RESET_ALL} width={160dp} @click={self.resetAll} />
      </Section>
    }
  }
}
