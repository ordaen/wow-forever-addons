// Every emote of the client's the server does (not those `SILENT`), by its token (`LAUGH`), sorted for the wheel: families, each of groups, each of eight
// emotes at most, so a family is a submenu of submenus. An emote shows the client's own command for it in the
// player's language (`/смех`), and does it by its token.
import Client from "$client"
import Locale from "@/locales"

public struct EmoteGroup {
  title: string
  tokens: array<string>
}

public struct EmoteFamily {
  title: string
  groups: array<EmoteGroup>
}

