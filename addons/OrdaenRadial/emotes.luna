// Every emote of the client's, by its token (`LAUGH`), sorted for the wheel: families, each of groups, each of eight
// emotes at most, so a family is a submenu of submenus. An emote shows the client's own command for it in the
// player's language (`/смех`), and does it by its token.
import Client from "$client"
import Locale from "@/locales"

public struct EmoteGroup {
  title: String
  tokens: Array<String>
}

public struct EmoteFamily {
  title: String
  groups: Array<EmoteGroup>
}

