// The emotes the client lists and the server does nothing for (each tried in game, apart from the others, past the
// server's limit on emotes: none answered, none moved the character): on no wheel. Most have no entry in the client's
// EmotesText table.
public const SILENT: array<string> = [
  "PROMISE", "MOUNTSPECIAL", "READ", "FORTHEALLIANCE", "FORTHEHORDE", "WINCE", "HUZZAH", "IMPRESSED", "MAGNIFICENT", "QUACK",
  "LEAN"
]

// The client numbers its emotes up to this (`MAXEMOTEINDEX`; a few numbers stand empty).
const EMOTES_MOST = 700
// The most commands the client gives one emote (`EMOTE61_CMD1` to `_CMD9`).
const COMMANDS_MOST = 9

function text(name: string): string | nil {
  const value = Client::getglobal(name)
  return value is string ? value : nil
}

// The emotes a client in another language than English gives no command in its own: named by our words, with no
// slash (no command says them).
const UNNAMED: map<string, string> = {
  CLAP: Locale::EMOTE_CLAP, INCOMING: Locale::EMOTE_INCOMING, MASSAGE: Locale::EMOTE_MASSAGE, SEXY: Locale::EMOTE_SEXY,
  SMACK: Locale::EMOTE_SMACK, SNAP: Locale::EMOTE_SNAP, SNEAK: Locale::EMOTE_SNEAK, SNEEZE: Locale::EMOTE_SNEEZE,
  SNORT: Locale::EMOTE_SNORT, SQUEAL: Locale::EMOTE_SQUEAL, SUSPICIOUS: Locale::EMOTE_SUSPICIOUS, SWEAT: Locale::EMOTE_SWEAT,
  VETO: Locale::EMOTE_VETO
}

// Whether a command is in the client's own letters, not English ones (`/смех`, not `/laugh`).
function native(command: string): boolean {
  const (at, _) = command.find("[\128-\255]")
  return at != nil
}

// What the wheel names an emote by, of its commands: none another emote of a lower number has first (the client takes
// that for the lower: `/привет` is «greet», not «hello»); of those, in a client in English the first, in any other the
// first in its own letters, or our name where it has none.
function nameOf(token: string, own: array<string>, owners: map<string, string>, english: boolean): string {
  const free = own.filter(command => owners[command] == nil || owners[command] == token)
  const first = free[1] ?? own[1] ?? token
  if (english) { return first }
  return free.find(command => native(command)) ?? UNNAMED[token] ?? first
}

// What the wheel names each emote by, by its token (`nameOf`).
public function emoteNames(): map<string, string> {
  const commands: map<string, array<string>> = mut {}
  // Each first command's emote: the lowest number's.
  const owners: map<string, string> = mut {}
  for (index of 1..EMOTES_MOST) {
    const token = text(`EMOTE${index}_TOKEN`)
    if (token != nil && commands[token] == nil) {
      const own: array<string> = mut []
      for (step of 1..COMMANDS_MOST) {
        const command = text(`EMOTE${index}_CMD${step}`)
        if (command == nil) { break }
        own.push(command)
      }
      const first = own[1]
      if (first != nil) {
        commands[token] = own
        if (owners[first] == nil) { owners[first] = token }
      }
    }
  }
  const english = Client::GetLocale() == "enUS" || Client::GetLocale() == "enGB"
  const names: map<string, string> = mut {}
  for (token, own of commands) { names[token] = nameOf(token, own, owners, english) }
  return names
}
