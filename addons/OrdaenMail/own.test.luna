// «To my characters»: what the bags hold for each of the player's other characters' professions, and what the queue
// lacks with who holds it.
import Client from "$client"
import Game from "$game"
import Test from "$test"
import { classColor } from "Ordaen"
import { Place } from "OrdaenAlts"
import { Use } from "OrdaenProfessions"
import { Holding, Kin, lacksOf, ownRows, stacksOf } from "@/own"

const BAR = 2841
const STONE = 2836
const LINEN = 2589

function kin(): Array<Kin> {
  return [{ who: "Player-1-3", name: "Regron", classTag: "WARRIOR" }, { who: "Player-1-2", name: "Aria", classTag: "MAGE" }]
}

// Bronze bars go into Regron's axe (Blacksmithing) and Aria's tube (Engineering); stone into the axe alone.
function uses(item: Integer): Array<Use> {
  if (item == BAR) {
    return [
      { recipe: 2738, skillLine: 164, profession: "Blacksmithing", count: 2 },
      { recipe: 3926, skillLine: 202, profession: "Engineering", count: 3 }
    ]
  }
  if (item == STONE) { return [{ recipe: 2738, skillLine: 164, profession: "Blacksmithing", count: 1 }] }
  return []
}

function knows(who: String, recipe: Integer): Boolean {
  return (who == "Player-1-3" && recipe == 2738) || (who == "Player-1-2" && recipe == 3926)
}

test "each other character has a row of what the bags hold that its professions use, in its class's colour" {
  Client.C_Item.GetItemNameByID = (id: String | Integer): String | nil => id == BAR ? "Bronze Bar" : id == STONE ? "Rough Stone" : "Linen Cloth"
  const rows = ownRows(kin(), { [BAR]: 20, [STONE]: 5, [LINEN]: 10 }, uses, knows)
  Test.expect(rows.map(row => row.name).join(", ") == "Aria, Regron")
  const regron = rows[2] ?? panic("Regron's row")
  Test.expect(regron.offers.map(offer => `${offer.name} ${offer.count} (${offer.why})`).join(", ") ==
      "Bronze Bar 20 (Blacksmithing), Rough Stone 5 (Blacksmithing)")
  const color = regron.color
  Test.expect(color != nil && color.equal(classColor("WARRIOR") ?? panic("the client colours a warrior")))
  const aria = rows[1] ?? panic("Aria's row")
  Test.expect(aria.offers.map(offer => offer.name).join(", ") == "Bronze Bar")
}

test "a count sent takes whole stacks that fit and the rest as a part, which the queue splits off" {
  Game.bags.size = (bag: Integer): Integer => bag == 0 ? 4 : 0
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => {
    if (bag != 0 || (slot != 2 && slot != 3)) { return false }
    into.id = LINEN
    into.count = slot == 2 ? 20 : 5
    into.locked = false
    return true
  }
  const stacks = stacksOf([{ bag: 0, slot: 0, item: LINEN, count: 12 }])
  Test.expect(stacks.map(s => `${s.bag}/${s.slot} ${s.count}`).join(", ") == "0/3 5, 0/0 7")
  const whole = stacksOf([{ bag: 0, slot: 0, item: LINEN, count: 25 }])
  Test.expect(whole.map(s => `${s.bag}/${s.slot} ${s.count}`).join(", ") == "0/2 20, 0/3 5")
}

test "what the queue lacks past the bags names the character who holds the most of it, and where" {
  Client.C_Item.GetItemNameByID = (id: String | Integer): String | nil => "Bronze Bar"
  const holders = (item: Integer): Array<Holding> => [
    { who: "Player-1-2", place: Place.Bags, count: 4 },
    { who: "Player-1-3", place: Place.Bank, count: 12 },
    { who: "Player-9-9", place: Place.Bags, count: 50 }
  ]
  const lacks = lacksOf(kin(), [{ item: BAR, count: 10 }, { item: STONE, count: 2 }], { [BAR]: 3, [STONE]: 2 }, holders)
  Test.expect(lacks.length == 1)
  const lack = lacks[1] ?? panic("the bars")
  Test.expect(lack.count == 7 && lack.holderName == "Regron" && lack.held == 12 && lack.place == Place.Bank)
}
