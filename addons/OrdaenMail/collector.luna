// Taking from several letters at once («Take all», the ticked letters, Shift+click on one): one thing at a time, as
// fast as the server answers. It takes a letter's money or one attachment, and asks the next the moment the client is
// ready for it: the server answered (`taken`, a refusal or a failure), the client holds no mail command still pending
// (looked at again each frame while it does), and the inbox no longer shows what was taken (a read that still shows it
// waits for the next, `changed`). The inbox read the take itself brings comes before the answer, still holding what
// was taken: asked again then, the same thing goes twice and the server says its mail database failed; asked in the
// answer's own moment, with the inbox not yet read anew, the server leaves it unanswered (the user's probe,
// 2026-11-24). Where no answer comes, the thing is asked again after a ceiling of time. The letters are named by their
// sender and subject, as the inbox shifts under them. «Inventory is full» stops it; «can't carry any more» skips that
// attachment; one that won't come after a few tries is skipped, never looped on. Cash on delivery and a game master's
// letters are never taken by it; the free bag slots the setting keeps are left free (money still comes).
import Game from "$game"
import { collectable, keyOf } from "@/letters"

// How long the server is given to answer before the thing is asked again.
const CEILING = 2
// Tries of one attachment before it is skipped.
const TRIES = 3
// The place of a letter's money among what is asked of it; its attachments are 1 and up.
const MONEY = 0

// Why taking stopped.
public enum Stop { Done = "done", Full = "full", Closed = "closed" }

public class Collector {
  // A letter about to be taken from: its money or an attachment.
  public taking: Event<Game.MailLetter> = new Event()
  // While it runs, the list takes no clicks.
  public state running = false
  // What it took this visit to the mailbox: the money, and the stacks.
  public state money = 0
  public state stacks = 0
  public state stopped: Stop | nil = nil
  // The letters it takes from; none: every letter «Take all» opens.
  targets: Array<String> = []
  // Attachments skipped (`key/place`) and the tries of the one asked last: its letter's key and its place (`MONEY` for
  // the money).
  skipped: mut Map<String, Boolean> = {}
  asked = ""
  askedLetter = ""
  askedPlace = MONEY
  tries = 0
  // The server answered what was asked last: the next goes once the client is ready.
  answered = false
  // The ceiling of the thing asked; the next frame's look while a mail command is pending.
  waiting: Task<nil> | nil = nil
  looking: Task<nil> | nil = nil
  // The free bag slots it leaves.
  keepFree = 0

  constructor() {
    Game.mailObserver.taken.listen(self.onAnswer)
    Game.mailObserver.refused.listen(self.onRefused)
    Game.mailObserver.failed.listen(self.onFailed)
    Game.mailObserver.changed.listen(self.onChanged)
  }

  // Takes from these letters, as they now stand, leaving that many bag slots free.
  public start(mut self, letters: Array<Game.MailLetter>, keepFree: Integer) {
    self.keepFree = keepFree
    self.targets = letters.map(keyOf)
    self.skipped = {}
    self.asked = ""
    self.tries = 0
    self.stopped = nil
    self.running = true
    self.step()
  }

  public stop(mut self, why: Stop) {
    if (!(peek self.running)) { return }
    self.running = false
    self.stopped = why
    self.quiet()
  }

  // No ceiling and no look pending.
  quiet(mut self) {
    if (self.waiting != nil) { destroy self.waiting }
    if (self.looking != nil) { destroy self.looking }
  }

  // A new visit to the mailbox: nothing taken yet.
  public reset(mut self) {
    self.money = 0
    self.stacks = 0
    self.stopped = nil
  }

  wanted(self, letter: Game.MailLetter): Boolean {
    return collectable(letter) && self.targets.any(k => k == keyOf(letter))
  }

  // The next thing to take, asked of the game; stopped where nothing is left.
  step(mut self) {
    if (!(peek self.running)) { return }
    for (letter of Game.mailbox.letters()) {
      if (!self.wanted(letter)) { continue }
      if (letter.copper > 0) {
        self.ask(letter, MONEY)
        self.taking.emit(letter)
        Game.mailbox.takeMoney(letter.index)
        self.money += letter.copper
        return
      }
      if (peek Game.bags.free <= self.keepFree) {
        self.stop(.Full)
        return
      }
      for (item of letter.items) {
        const name = `${keyOf(letter)}/${item.place}`
        if (self.skipped[name] == true) { continue }
        self.ask(letter, item.place)
        self.taking.emit(letter)
        Game.mailbox.takeItem(letter.index, item.place)
        self.stacks += 1
        return
      }
    }
    self.stop(.Done)
  }

  // A letter's money (`MONEY`) or an attachment is about to be asked for: counted as a try, and given a ceiling.
  ask(mut self, letter: Game.MailLetter, place: Integer) {
    const key = keyOf(letter)
    const name = place == MONEY ? `${key}/money` : `${key}/${place}`
    if (name == self.asked) {
      self.tries += 1
      if (self.tries >= TRIES) { self.skipped[name] = true }
    } else {
      self.asked = name
      self.tries = 1
    }
    self.askedLetter = key
    self.askedPlace = place
    self.answered = false
    self.quiet()
    self.waiting = self.ceiling()
  }

  async ceiling(mut self) {
    await Game.delay(CEILING)
    self.waiting = nil
    self.step()
  }

  // Whether the inbox still shows what was asked last: the letter's money, or that attachment.
  stillShown(self): Boolean {
    const letter = Game.mailbox.letters().find(l => keyOf(l) == self.askedLetter)
    if (letter == nil) { return false }
    if (self.askedPlace == MONEY) { return letter.copper > 0 }
    return letter.items.any(item => item.place == self.askedPlace)
  }

  // The next thing is asked once the client is ready: the answer came, no mail command is pending, and the inbox no
  // longer shows what was taken (or it was skipped). While a command is pending it looks again the next frame; while
  // the inbox still shows it, at its next read.
  advance(mut self) {
    if (!(peek self.running) || !self.answered) { return }
    if (Game.mailbox.pending()) {
      if (self.looking == nil) { self.looking = self.lookNextFrame() }
      return
    }
    if (self.skipped[self.asked] != true && self.stillShown()) { return }
    self.quiet()
    self.step()
  }

  async lookNextFrame(mut self) {
    await Game.delay(0)
    self.looking = nil
    self.advance()
  }

  // The server answered what was asked.
  onAnswer(mut self) {
    if (!(peek self.running)) { return }
    self.answered = true
    self.advance()
  }

  // The inbox was read anew: after the answer, it may show the take done.
  onChanged(mut self) { self.advance() }

  onRefused(mut self, message: String) {
    if (!(peek self.running)) { return }
    if (message == Game.strings.inventoryFull) {
      self.stop(.Full)
      return
    }
    if (message == Game.strings.itemMaxCount) { self.skipped[self.asked] = true }
    self.onAnswer()
  }

  onFailed(mut self) {
    if (!(peek self.running)) { return }
    self.skipped[self.asked] = true
    self.onAnswer()
  }
}
