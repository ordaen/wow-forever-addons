// «To my characters»: what the bags hold for the player's other characters, from Ordaen Alts (who they are, their
// classes and professions) and Ordaen Professions (whose recipes take an item, at what difficulty): what their
// professions' recipes take, as the sending rules let through (`SendRules`: per character and profession, on or off,
// and the least a recipe must do for the skill); gear to disenchant, for a character with Enchanting; items only
// their class uses (`@/purposes`, as the settings say). At the left a list of the characters something goes to, each
// with how many items; nothing for anyone, a note and a way to the rules. At the right the chosen character's items, a
// section per profession, then «Disenchanting», then its class's: each item ticked with its count and a line under its
// name (its recipes' count in the colour of the best for the skill, why it goes to disenchant, its class), its tooltip
// the recipes in their colours; each section sends its own, and the footer sends all, with how many letters that
// takes. The tab follows the bags: a letter sent takes its items out, and what is left is what it shows.
import Client from "$client"
import Game from "$game"
import { Align, Bounds, Edges, Track } from "$ltml"
import { Component, CountInput, FooterCount, Ground, ListFooter, PushButton, SECONDARY_TEXT, ScrolledList, TITLE_TEXT, Tabs, Tick, Tip, TipRow, classColor } from "Ordaen"
import type { Alts } from "OrdaenAlts"
import { skillUpRank } from "OrdaenProfessions"
import type { CraftRecipe, Crafting } from "OrdaenProfessions"
import { lettersFor } from "@/letters"
import Locale from "@/locales"
import { ENCHANTING, Loose, Purposed, UpgradeRead, classNameOf, looseOf, purposedOf, whyText } from "@/purposes"
import { Sender } from "@/sender"
import { Choices } from "@/settings"
import Style from "@/style"

const OFFER: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
// The characters' column as wide as its longest name, never narrower than `Style.OWN_LIST`; the sections the rest.
const SPLIT: Array<Track> = ["max-content", { fr: 1 }]
const TABS_BOUNDS: Bounds = { min: Style.OWN_LIST }
// Each column's room: the window keeps none on this tab.
const PAGE_ROOM: Edges = { top: 8sp, right: 8sp, bottom: 8sp, left: 8sp }
const FILL: Array<Track> = [{ fr: 1 }]

// The least a recipe must do for a character's skill for what it takes to go: any, green or better, yellow or
// better, orange alone.
public enum Least implements Plain { Any = "any", Green = "green", Yellow = "yellow", Orange = "orange" }

// What goes to one character for one of its professions.
public struct SendRule implements Plain {
  on: Boolean = true
  least: Least = Least.Any
}

// The rules, the account's, by «who:skillLine»: one never set is on, for any recipe.
public struct SendRules implements Plain {
  rules: Map<String, SendRule> = {}
}

public const DEFAULT_RULE: SendRule = {}

public function ruleKey(who: String, skillLine: Integer): String { return `${who}:${skillLine}` }

public function ruleOf(rules: SendRules, who: String, skillLine: Integer): SendRule {
  return rules.rules[ruleKey(who, skillLine)] ?? DEFAULT_RULE
}

// The worst difficulty a rule lets through, as `skillUpRank` orders them (orange 0, grey 3).
function worstOf(least: Least): Integer {
  return match (least) {
    Least.Any => 3
    Least.Green => 2
    Least.Yellow => 1
    Least.Orange => 0
  }
}

// Whether a rule lets a profession's recipes take an item: it is on, and the best of them is good enough.
public function allows(rule: SendRule, crafting: Crafting): Boolean {
  return rule.on && skillUpRank(crafting.best) <= worstOf(rule.least)
}

// One of the bags' items that goes to a character: how many the bags hold, the line under its name and its colour (its
// recipes' count in the best one's colour, why it goes to disenchant), and its tooltip's rows (the recipes, each in its
// colour).
public struct Offer {
  item: Integer
  name: String
  count: Integer
  detail: String
  color: Color
  tips: Array<TipRow>
}

// A part of what goes to a character, under its title: a profession's (by its skill line), «Disenchanting», its
// class's.
public struct Section {
  key: String
  title: String
  offers: Array<Offer>
}

// Sections' keys besides the professions'.
const DISENCHANT_KEY = "disenchant"
const CLASS_KEY = "class"

// A character something goes to: its sections, and how many items they hold (an item in two sections once).
public struct OwnRow {
  who: String
  name: String
  color: Color | nil
  sections: Array<Section>
  items: Integer
}

// Whose recipes take an item, as Ordaen Professions answers it.
public type CraftingRead = (item: Integer) => Array<Crafting>

// One of the player's other characters a letter reaches: its class, and whether it has Enchanting.
public struct Kin {
  who: String
  name: String
  classTag: String
  enchants: Boolean
}

function itemName(item: Integer): String { return Client.C_Item.GetItemNameByID(item) ?? String.of(item) }

// The characters the one being played can send to.
public function kinOf(alts: Alts): Array<Kin> {
  const kin: Array<Kin> = []
  for (who, character of alts.characters) {
    if (who != alts.current && alts.reaches(who)) {
      const enchants = character.professions.any(known => known.skillLine == ENCHANTING)
      kin.push({ who: who, name: character.name, classTag: character.classTag, enchants: enchants })
    }
  }
  kin.sort((a, b) => a.name < b.name)
  return kin
}

function byName(offers: mut Array<Offer>): Array<Offer> {
  offers.sort((a, b) => a.name < b.name)
  return offers
}

// A character's sections of what its professions' recipes take, as the rules let through, by the professions' names.
function craftSections(
  one: Kin, held: Map<Integer, Integer>, crafting: (item: Integer) => Array<Crafting>,
  rule: (who: String, skillLine: Integer) => SendRule
): Array<Section> {
  const offers: Map<Integer, mut Array<Offer>> = {}
  const professions: Map<Integer, String> = {}
  for (item, bagged of held) {
    for (use of crafting(item)) {
      if (use.guid == one.who && allows(rule(one.who, use.skillLine), use)) {
        const offer: Offer = {
          item: item, name: itemName(item), count: bagged, detail: Locale.OWN_RECIPES.format(use.recipes.length),
          color: use.bestColor, tips: use.recipes.map((recipe: CraftRecipe): TipRow => TipRow { label: recipe.name, value: "", tone: recipe.color })
        }
        const list = offers[use.skillLine]
        if (list == nil) { offers[use.skillLine] = [offer] } else { list.push(offer) }
        professions[use.skillLine] = use.profession
      }
    }
  }
  const sections: Array<Section> = []
  for (skillLine, list of offers) {
    sections.push({ key: String.of(skillLine), title: professions[skillLine] ?? "", offers: byName(mut list) })
  }
  sections.sort((a, b) => a.title < b.title)
  return sections
}

// What goes to a character besides what its professions take: gear to disenchant, where it has Enchanting; what its
// class alone uses.
function purposeSections(one: Kin, purposed: Array<Purposed>): Array<Section> {
  const sections: Array<Section> = []
  const disenchant: Array<Offer> = []
  const classed: Array<Offer> = []
  for (each of purposed) {
    const why = each.why
    if (one.enchants && why != nil) { disenchant.push(offerOf(each.loose, whyText(why))) }
    if (each.classes.any(tag => tag == one.classTag)) { classed.push(offerOf(each.loose, classNameOf(one.classTag))) }
  }
  if (disenchant.length > 0) { sections.push({ key: DISENCHANT_KEY, title: Locale.SECTION_DISENCHANT, offers: byName(mut disenchant) }) }
  if (classed.length > 0) {
    sections.push({ key: CLASS_KEY, title: Locale.SECTION_CLASS.format(classNameOf(one.classTag)), offers: byName(mut classed) })
  }
  return sections
}

function offerOf(loose: Loose, detail: String): Offer {
  return { item: loose.item, name: loose.name, count: loose.count, detail: detail, color: Style.DIM, tips: [] }
}

// Per kin, what the bags hold for it: what its professions' recipes take, as the rules let through (`crafting` whose
// recipes take an item), then what `purposed` gives it. A character nothing goes to has no row.
public function ownRows(
  kin: Array<Kin>, held: Map<Integer, Integer>, crafting: (item: Integer) => Array<Crafting>,
  rule: (who: String, skillLine: Integer) => SendRule, purposed: Array<Purposed>
): Array<OwnRow> {
  const rows: Array<OwnRow> = []
  for (one of kin) {
    const sections: Array<Section> = []
    for (section of craftSections(one, held, crafting, rule)) { sections.push(section) }
    for (section of purposeSections(one, purposed)) { sections.push(section) }
    const items: Map<Integer, Boolean> = {}
    let count = 0
    for (section of sections) {
      for (offer of section.offers) {
        if (items[offer.item] == nil) {
          items[offer.item] = true
          count += 1
        }
      }
    }
    if (count > 0) { rows.push({ who: one.who, name: one.name, color: classColor(one.classTag), sections: sections, items: count }) }
  }
  return rows
}

// The stacks a letter takes for each item and count wanted: the bags' whole stacks while they fit in what is left,
// and the rest as one part, which the queue splits off a bigger stack as the letter goes. The queue cuts them into
// letters of twelve.
public function stacksOf(wanted: Array<Game.MailStack>): Array<Game.MailStack> {
  const stacks: Array<Game.MailStack> = []
  let slot = Game.SlotItem {
    id: 0, count: 0, quality: 0, icon: nil, name: "", link: "", level: 0, kind: 0, subkind: 0, subkindName: "", worn: "",
    bound: false, locked: false, isNew: false, price: 0
  }
  for (want of wanted) {
    let left = want.count
    for (bag of 0..Game.bags.last) {
      for (place of 1..Game.bags.size(bag)) {
        if (left > 0 && Game.bags.readSlot(bag, place, mut slot) && !slot.locked && !slot.bound && slot.id == want.item &&
            slot.count <= left) {
          stacks.push({ bag: bag, slot: place, item: slot.id, count: slot.count })
          left -= slot.count
        }
      }
    }
    if (left > 0) { stacks.push({ bag: 0, slot: 0, item: want.item, count: left }) }
  }
  return stacks
}

// What goes of the offers, by the counts chosen (`chosen` by «who:item»: 0 for one unticked, all where unset); an item
// in two of them once, at the most chosen.
function wantedOf(who: String, offers: Array<Offer>, chosen: Map<String, Integer>): Array<Game.MailStack> {
  const wanted: Array<mut Game.MailStack> = []
  for (offer of offers) {
    const count = chosen[`${who}:${offer.item}`] ?? offer.count
    if (count > 0 && !wanted.any(w => w.item == offer.item)) { wanted.push({ bag: 0, slot: 0, item: offer.item, count: count }) }
  }
  return wanted
}

function offersOf(row: OwnRow): Array<Offer> {
  const offers: Array<Offer> = []
  for (section of row.sections) {
    for (offer of section.offers) { offers.push(offer) }
  }
  return offers
}

// An item that goes: ticked, its name, the line under it in its colour, how many; its tooltip the offer's rows, where
// it has any.
class OfferRow implements Component {
  // The item, and how many of it go now: 0 while it is unticked.
  public toggled: Event<(Integer, Integer)> = new Event()
  state checked = true
  state count = 0
  state hovered = false
  derived tipped: Boolean = self.hovered && self.offer.tips.length > 0

  offer: Signal<Offer>
  constructor(offer: Signal<Offer>) {
    self.offer = offer
    self.count = peek self.offer.count
    watch { self.toggled.emit(self.offer.item, self.checked ? self.count : 0) }
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <box columns={OFFER} gap={2sp} yAlign={Align.Center}>
          <Tick value={mut self.checked} />
          <box columns={1}>
            <text value={self.offer.name} textColor={Style.INK} wrap={.Cut} />
            <text value={self.offer.detail} textColor={self.offer.color} textSize={SECONDARY_TEXT} wrap={.None} />
          </box>
          <CountInput value={mut self.count} least={1} most={self.offer.count} disabled={!self.checked} />
        </box>
        <Tip $if={self.tipped} title={self.offer.name} text={""} rows={self.offer.tips} />
      </box>
    }
  }
}

// A section's items, under its title, with «Send» for them.
class SectionBlock implements Component {
  public send: Event<Section> = new Event()
  public toggled: Event<(Integer, Integer)> = new Event()

  section: Signal<Section>
  constructor(section: Signal<Section>) { self.section = section }

  onSend(mut self) { self.send.emit(self.section) }
  onToggle(mut self, item: Integer, count: Integer) { self.toggled.emit(item, count) }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={2sp}>
        <text value={self.section.title} textSize={TITLE_TEXT} leading={.Title} textColor={Style.GOLD} />
        <OfferRow $for={offer of self.section.offers} $key={offer.item} offer={offer} @toggled={self.onToggle} />
        <box xAlign={Align.End}>
          <PushButton label={Locale.SEND} width={Style.BUTTON} @click={self.onSend} />
        </box>
      </box>
    }
  }
}

// The tab's parts, which Mail's window lays out: `body` the characters in vertical tabs at the left and the chosen one's
// sections on the wood at the right, each column with its own room (the window keeps none on this tab); `footer` the
// letters «Send all» takes and the button.
public class OwnTab {
  // «Set up the rules», where nothing goes to anyone.
  public configure: Event<nil> = new Event()

  // How many of each item go, by «who:item»: 0 for one unticked; the whole of what the bags hold where unset.
  state chosen: Map<String, Integer> = {}
  // What the bags hold, by item, and the items a letter can take (none bound): read again each time they change (a
  // letter sent takes its items out).
  state held: Map<Integer, Integer> = {}
  state loose: Array<Loose> = []
  // The character's tab chosen, by its place; the first where the list is shorter now.
  state picked = 1
  derived noAlts: Boolean = self.reached == nil
  derived kin: Array<Kin> = self.reached ?? []
  derived alone: Boolean = !self.noAlts && self.kin.length == 0
  derived rows: Array<OwnRow> = self.rowsOf()
  derived nothing: Boolean = !self.noAlts && !self.alone && self.rows.length == 0
  derived names: Array<String> = self.rows.map(row => row.name)
  derived items: Array<Integer> = self.rows.map(row => row.items)
  derived current: OwnRow | nil = self.rows[self.picked] ?? self.rows[1]
  derived currentWho: String = self.current?.who ?? ""
  derived sections: Array<Section> = self.current?.sections ?? []
  derived letters: Integer = self.lettersNow()
  derived counts: Array<FooterCount> = [{ label: Locale.LETTERS, value: String.of(self.letters) }]

  reached: Signal<Array<Kin> | nil>
  const crafting: CraftingRead
  rules: Signal<SendRules>
  choices: Signal<Choices>
  const upgrade: UpgradeRead
  sender: mut Sender
  constructor(
    // The characters a letter reaches (`kinOf`); none while Ordaen Alts is off.
    reached: Signal<Array<Kin> | nil>,
    // Whose recipes take an item (Ordaen Professions' `craftingWith`).
    crafting: CraftingRead,
    rules: Signal<SendRules>,
    // What goes besides what the recipes take: gear to disenchant, items for another class.
    choices: Signal<Choices>,
    // How much better an item is than what the player wears (Ordaen's worth).
    upgrade: UpgradeRead,
    sender: mut Sender
  ) {
    self.reached = reached
    self.crafting = crafting
    self.rules = rules
    self.choices = choices
    self.upgrade = upgrade
    self.sender = sender
    self.onBags()
    Game.bags.changed.listen(self.onBags)
  }

  // The bags changed: what they hold is read again; where the game gave no count, what was read stays.
  onBags(mut self) {
    const held = Game.bags.holdings()
    if (held != nil) { self.held = held }
    self.loose = looseOf()
  }

  rowsOf(self): Array<OwnRow> {
    const rules = self.rules
    const purposed = purposedOf(self.loose, self.choices, self.upgrade)
    return ownRows(self.kin, self.held, self.crafting, (who: String, skillLine: Integer): SendRule => ruleOf(rules, who, skillLine), purposed)
  }

  // How many letters «Send all» takes: none where nothing is ticked.
  lettersNow(self): Integer {
    const row = self.current
    if (row == nil) { return 0 }
    const stacks = stacksOf(wantedOf(row.who, offersOf(row), self.chosen)).length
    return stacks == 0 ? 0 : lettersFor(stacks)
  }

  onToggle(mut self, item: Integer, count: Integer) {
    const key = `${peek self.currentWho}:${item}`
    const before = peek self.chosen
    if (before[key] == count) { return }
    const next = before.clone()
    next[key] = count
    self.chosen = next
  }

  // What the offers come to goes to the chosen character, as letters of twelve stacks.
  sendOffers(mut self, offers: Array<Offer>) {
    const row = peek self.current
    if (row == nil) { return }
    const stacks = stacksOf(wantedOf(row.who, offers, peek self.chosen))
    if (stacks.length == 0) { return }
    self.sender.put(row.name, Locale.OWN_SUBJECT, "", stacks, 0, 0)
  }

  onSendSection(mut self, section: Section) { self.sendOffers(section.offers) }

  onSendAll(mut self) {
    const row = peek self.current
    if (row != nil) { self.sendOffers(offersOf(row)) }
  }

  onConfigure(mut self) { self.configure.emit() }

  public const body: Template = $ltml {
    <box $if={self.noAlts} xAlign={Align.Center} yAlign={Align.Center} padding={PAGE_ROOM}>
      <text value={Locale.ALTS_OFF} textColor={Style.DIM} />
    </box>
    <box $elseif={self.alone} xAlign={Align.Center} yAlign={Align.Center} padding={PAGE_ROOM}>
      <text value={Locale.ALTS_ALONE} textColor={Style.DIM} />
    </box>
    <box $elseif={self.nothing} columns={1} gap={4sp} xAlign={Align.Center} yAlign={Align.Center} padding={PAGE_ROOM}>
      <text value={Locale.OWN_NOTHING} textColor={Style.DIM} />
      <PushButton label={Locale.OWN_RULES} width={Style.WIDE_BUTTON} @click={self.onConfigure} />
    </box>
    <box $else columns={SPLIT} rows={FILL}>
      <box columns={1} rows={FILL} width={TABS_BOUNDS}>
        <Tabs tabs={self.names} selected={mut self.picked} counts={self.items} vertical={true} />
      </box>
      <box rows={FILL} padding={PAGE_ROOM}>
        <ScrolledList columns={1} gap={6sp} ground={Ground.Wood}>
          <SectionBlock $for={section of self.sections} $key={section.key} section={section}
                        @send={self.onSendSection} @toggled={self.onToggle} />
        </ScrolledList>
      </box>
    </box>
  }

  public const footer: Template = $ltml {
    <ListFooter counts={self.counts}>
      <PushButton label={Locale.OWN_SEND_ALL} width={Style.WIDE_BUTTON} disabled={self.letters == 0} @click={self.onSendAll} />
    </ListFooter>
  }
}
