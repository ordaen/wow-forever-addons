// Who a letter can go to: the player's characters (Ordaen Alts'), friends, the guild, the character communities and
// the recent recipients, all in one list, each name once (where it stands first). Each is read from the game, a name
// matched from its start; names are never split on spaces (Forever's surnames).
import Client from "$client"
import { classColor } from "Ordaen"
import type { Alts } from "OrdaenAlts"

// Who a recipient is to the player.
public enum Source { Own, Friend, Guild, Community, Recent }

// One who can be written to: a name as the game takes it, the level, whether online, the class's colour where known,
// who it is to the player, and the community it stands in (a community's member alone).
public struct Recipient {
  public mut name: string
  public mut level: integer
  public mut online: boolean
  public mut color: color | nil
  public mut source: Source
  public mut group: string
}

// Every recipient the player knows, own characters first, then friends, the guild, the communities and the recent
// recipients; a name known twice stands where it comes first.
public function everyone(alts: Alts | nil, recent: array<string>): array<Recipient> {
  const list: array<Recipient> = mut []
  const seen: map<string, boolean> = mut {}
  const add = (from: array<Recipient>) => {
    for (who of from) {
      if (seen[who.name] == nil) {
        seen[who.name] = true
        list.push(who)
      }
    }
  }
  add(own(alts))
  add(friends())
  add(guild())
  add(communities())
  add(recent.map(name => {
    const one: Recipient = { name: name, level: 0, online: false, color: nil, source: .Recent, group: "" }
    return one
  }))
  return list
}

// The first `most` recipients whose names begin with what was typed.
public function matching(list: array<Recipient>, typed: string, most: integer): array<Recipient> {
  const found: array<Recipient> = mut []
  for (who of list) {
    if (found.length >= most) { break }
    if (starts(who.name, typed)) { found.push(who) }
  }
  return found
}

// Whether a name begins with what was typed, of any case.
public function starts(name: string, typed: string): boolean {
  return typed == "" || name.lower().sub(1, typed.length) == typed.lower()
}

function byOnline(a: Recipient, b: Recipient): boolean {
  if (a.group != b.group) { return a.group < b.group }
  if (a.online != b.online) { return a.online }
  return a.name < b.name
}

// The player's other characters a letter reaches; none while Ordaen Alts is off.
public function own(alts: Alts | nil): array<Recipient> {
  const list: array<Recipient> = mut []
  if (alts == nil) { return list }
  for (who, character of alts.characters) {
    if (who != alts.current && alts.reaches(who)) {
      list.push({ name: character.name, level: character.level, online: false, color: classColor(character.classTag), source: .Own, group: "" })
    }
  }
  list.sort(byOnline)
  return list
}

public function friends(): array<Recipient> {
  const list: array<Recipient> = mut []
  for (index of 1..Client::C_FriendList::GetNumFriends()) {
    const info = Client::C_FriendList::GetFriendInfoByIndex(index)
    if (info != nil) {
      const (_, tag, _, _, _, _, _, _) = Client::GetPlayerInfoByGUID(info.guid)
      list.push({ name: info.name, level: info.level.floor(), online: info.connected, color: classColor(tag), source: .Friend, group: "" })
    }
  }
  list.sort(byOnline)
  return list
}

public function guild(): array<Recipient> {
  const list: array<Recipient> = mut []
  const (count, _) = Client::GetNumGuildMembers()
  for (index of 1..count) {
    const (name, _, _, level, _, _, _, _, online, _, tag) = Client::GetGuildRosterInfo(index)
    if (name != nil) {
      list.push({ name: name, level: (level ?? 0).floor(), online: online == true, color: classColor(tag), source: .Guild, group: "" })
    }
  }
  list.sort(byOnline)
  return list
}

// The members of every character community the player is in (not Battle.net ones), each under its community's name.
public function communities(): array<Recipient> {
  const list: array<Recipient> = mut []
  for (club of Client::C_Club::GetSubscribedClubs()) {
    if (club.clubType == Client::ClubType::Character) {
      for (member of Client::C_Club::GetClubMembers(club.clubId, nil)) {
        const info = Client::C_Club::GetMemberInfo(club.clubId, member)
        const name = info?.name
        if (info != nil && name != nil && !info.isSelf) {
          const online = info.presence != Client::ClubMemberPresence::Offline && info.presence != Client::ClubMemberPresence::Unknown
          const classID = info.classID
          const known = classID != nil ? Client::C_CreatureInfo::GetClassInfo(classID) : nil
          list.push({ name: name, level: (info.level ?? 0).floor(), online: online, color: classColor(known?.classFile), source: .Community, group: club.name })
        }
      }
    }
  }
  list.sort(byOnline)
  return list
}
