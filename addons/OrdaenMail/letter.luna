// The opened letter, beside the inbox: its subject, the sender and the days left, its text (to select and copy), each
// attachment as a reward is shown (its name in its quality's colour, its kind and slot under it, the stack's sell
// price; Left-click takes it, Shift+Left-click links it, Ctrl+Left-click tries it on), the money (Left-click takes it),
// cash on delivery in orange. The buttons as everywhere: «Return» at the left for what can go back, «Reply», and at the
// right «Take all» in the accent («Pay and take» with cash on delivery); a letter that holds nothing more offers
// «Delete».
import Client from "$client"
import Game from "$game"
import { Align, Frame, Modifier, Overflow, Track } from "$ltml"
import Runtime from "$runtime"
import { ButtonPlate, Component, CopyText, ItemButton, Money, PickRow, PushButton, SECONDARY_TEXT, TITLE_TEXT, UNUSABLE, upgradeText, usableItem } from "Ordaen"
import { daysText, senderOf } from "@/inbox"
import Locale from "@/locales"
import Style from "@/style"

const SLOT = 42.1875dp
// The green the game's tooltips give a gain.
const RAISE: Color = Color::hex("#1eff00")
const REWARD: array<Track> = [SLOT, { fr: 1 }, "max-content"]
const MONEY: array<Track> = [{ fr: 1 }, "max-content"]
const FOOT: array<Track> = ["max-content", "max-content", { fr: 1 }, "max-content"]
const PARTS: array<Track> = ["max-content", { fr: 1 }, "max-content"]

// What a letter's action asks.
public enum LetterAct {
  TakeItem { place: integer }
  TryOn { link: string }
  TakeMoney
  TakeAll
  GiveBack
  Reply
  Delete
}

// One attachment as a reward: its slot, its name in its quality's colour with its kind and slot under it, the stack's
// sell price.
public class Attachment implements Component {
  public act: Event<LetterAct> = new Event()

  derived info: AttachmentInfo = infoOf(self.item.item)
  derived usable: boolean = usableItem(self.item.item)
  // How much more it is worth to the player's spec than what is worn, as «+n%»; empty where it is none.
  derived raise: string = upgradeText(self.upgrade(self.item.link))

  item: Signal<Game::MailItem>
  index: Signal<integer>
  upgrade: (link: string) => number | nil
  constructor(item: Signal<Game::MailItem>, index: Signal<integer>, upgrade: (link: string) => number | nil) {
    self.item = item
    self.index = index
    self.upgrade = upgrade
  }

  // Left-click takes it.
  mut onPick() { self.act.emit(.TakeItem { place: self.item.place }) }

  // With Ctrl it is tried on; Shift's link is the slot's own.
  mut onModified(key: Modifier) {
    if (key == .Ctrl) { self.act.emit(.TryOn { link: self.item.link }) }
  }

  // The attachment's tooltip beside its whole row, as the game's open letter shows it.
  onEntered(frame: any Frame) { Game::items.showMail(frame, peek self.index, peek self.item.place) }

  public render(): Template {
    return $ltml {
      <PickRow columns={REWARD} @pick={self.onPick} @modified={self.onModified} @entered={self.onEntered}>
        <ItemButton item={self.item.item} count={self.item.count} size={SLOT} mail={(self.index, self.item.place)} tipped={false} />
        <box columns={1}>
          <text value={self.item.name} textColor={self.info.color} wrap={.None} />
          <text value={self.info.kind} textColor={Style::DIM} textSize={SECONDARY_TEXT} wrap={.None} />
          <text $if={!self.usable} value={Locale::CANT_USE} textColor={UNUSABLE} textSize={SECONDARY_TEXT} wrap={.None} />
          <text $if={self.raise != ""} value={self.raise} textColor={RAISE} textSize={SECONDARY_TEXT} wrap={.None} />
        </box>
        <Money $if={self.info.price > 0} amount={self.info.price * self.item.count} />
      </PickRow>
    }
  }
}

// What the client says of an item: its quality's colour, its kind and slot, what a merchant gives for one.
public struct AttachmentInfo {
  color: Color
  kind: string
  price: integer
}

function infoOf(item: integer): AttachmentInfo {
  const (_, _, quality, _, _, kind, subkind, _, slot, _, price, _, _, _, _, _, _, _) = Client::C_Item::GetItemInfo(item)
  let color = Style::INK
  if (quality != nil) {
    const (r, g, b, _) = Client::C_Item::GetItemQualityColor(quality)
    color = { r: r, g: g, b: b, a: 1 }
  }
  const worn = slot != nil && slot != "" ? Runtime::text(slot) : nil
  const parts: array<string> = []
  if (worn != nil) { parts.push(worn) }
  if (subkind != nil && subkind != "") { parts.push(subkind) } else if (kind != nil) { parts.push(kind) }
  return { color: color, kind: parts.join(", "), price: (price ?? 0).floor() }
}

public class LetterView implements Component {
  public act: Event<LetterAct> = new Event()

  derived hasMoney: boolean = self.letter.copper > 0
  derived hasCod: boolean = self.letter.cod > 0
  derived holds: boolean = self.hasMoney || self.letter.items.length > 0
  derived takeLabel: string = self.hasCod ? Locale::PAY_AND_TAKE : Locale::TAKE
  derived returnable: boolean = self.letter.kind == Game::MailKind::Player && !self.letter.deletable && !self.letter.returned
  derived replies: boolean = self.letter.kind == Game::MailKind::Player
  derived from: string = Locale::FROM_DAYS.format(senderOf(self.letter), daysText(self.letter))
  derived hasText: boolean = self.text != ""

  letter: Signal<Game::MailLetter>
  text: Signal<string>
  busy: Signal<boolean>
  upgrade: (link: string) => number | nil
  constructor(
    letter: Signal<Game::MailLetter>,
    text: Signal<string>,
    busy: Signal<boolean>,
    upgrade: (link: string) => number | nil
  ) {
    self.letter = letter
    self.text = text
    self.busy = busy
    self.upgrade = upgrade
  }

  mut onAct(act: LetterAct) { self.act.emit(act) }
  mut onTakeMoney() { self.act.emit(.TakeMoney) }
  mut onTakeAll() { self.act.emit(.TakeAll) }
  mut onGiveBack() { self.act.emit(.GiveBack) }
  mut onReply() { self.act.emit(.Reply) }
  mut onDelete() { self.act.emit(.Delete) }

  public render(): Template {
    return $ltml {
      <box rows={PARTS} gap={2sp}>
        <box columns={1} gap={1sp}>
          <text value={self.letter.subject} textSize={TITLE_TEXT} textColor={Style::GOLD} />
          <text value={self.from} textSize={SECONDARY_TEXT} textColor={Style::DIM} />
        </box>
        <box columns={1} gap={2sp} overflow={Overflow::Scroll}>
          <CopyText $if={self.hasText} value={self.text} />
          <Attachment $for={item of self.letter.items} $key={item.place} item={item} index={self.letter.index}
                      upgrade={self.upgrade} @act={self.onAct} />
          <PickRow $if={self.hasMoney} columns={MONEY} @pick={self.onTakeMoney}>
            <text value={Locale::MONEY} textColor={Style::DIM} wrap={.None} />
            <Money amount={self.letter.copper} />
          </PickRow>
          <box $if={self.hasCod} columns={MONEY} padding={{ left: 1sp, right: 1sp }}>
            <text value={Locale::COD_AMOUNT} textColor={Style::ORANGE} wrap={.None} />
            <Money amount={self.letter.cod} color={Style::ORANGE} />
          </box>
        </box>
        <box columns={FOOT} gap={2sp} yAlign={Align::Center} border={Style::RULE} padding={{ top: 2sp }}>
          <PushButton $if={self.returnable} label={Locale::RETURN} width={Style::BUTTON} disabled={self.busy} @click={self.onGiveBack} />
          <box $else />
          <PushButton $if={self.replies} label={Locale::REPLY} width={Style::BUTTON} @click={self.onReply} />
          <box $else />
          <box />
          <PushButton $if={self.holds} label={self.takeLabel} width={Style::WIDE_BUTTON} plate={ButtonPlate::Accent} disabled={self.busy}
                      @click={self.onTakeAll} />
          <PushButton $else label={Locale::DELETE} width={Style::BUTTON} disabled={self.busy} @click={self.onDelete} />
        </box>
      </box>
    }
  }
}
