// «Write»: the form beside «Outbox». «To» takes any name, and completes it against every recipient the player knows
// (own characters, friends, the guild, the communities, the recent recipients), matched from its start: the names that
// match stand in a popover under the field, each in its class's colour with who it is beside it, and a click puts one
// in the field. Then the subject (empty: the first item's name or «Money»), the text; the attachments, six a row and
// twelve a letter (more go out as several letters, «Letter 2» over the next), an empty slot always after the last,
// filled by letting an item go on a slot or by the game's own ways into the letter being written (Right-click in the
// bags: the form takes the item from the game's letter); a slot clicked gives its item back. Then «Send money» or
// «C.O.D.», the window's inner tabs over the amount; under them the attachments and the letters, a dim line each,
// the title at the left and the count at the right. The column's marble footer: the postage, and «Send», greyed until
// a recipient is typed.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Align, Beside, Bounds, Layer, Overflow, Track } from "$ltml"
import { ButtonPlate, Component, Field, FooterCount, ItemButton, ListFooter, MoneyField, PickRow, PushButton, SECONDARY_TEXT, Tabs, trimmed } from "Ordaen"
import type { Alts } from "OrdaenAlts"
import { PLACES, SUBJECT_MOST, lettersFor } from "@/letters"
import Locale from "@/locales"
import { Recipient, Source, everyone, matching } from "@/recipients"
import { Sender, stackOf } from "@/sender"
import Style from "@/style"

// The most cash on delivery the game takes (`MAX_COD_AMOUNT`, in gold).
const COD_MOST = 10000 * 10000
// How many names the popover under «To» shows.
const SHOWN_NAMES = 8
const SLOT = 46.875dp
const SLOTS: array<Track> = [SLOT, SLOT, SLOT, SLOT, SLOT, SLOT]
const NAME_ROW: array<Track> = [9.375dp, { fr: 1 }, "max-content", "max-content"]
const FOOT: array<Track> = [{ fr: 1 }, "max-content"]
const DOT = 7.03125dp
const POPOVER: Bounds = { min: 351.5625dp, max: nil }
// «Send money» and «C.O.D.», the tabs' places.
const PAID_TABS: array<string> = [Locale::SEND_MONEY, Locale::COD_TAB]
const COD_TAB = 2

// One letter's slots of the form: its heading where there are several, its stacks, and whether the empty slot to fill
// stands after them (the last letter's, while it has room).
public struct LetterSlots {
  public mut number: integer
  public mut title: string
  public mut stacks: array<Game::MailStack>
  public mut open: boolean
}

// Who a recipient is to the player, as the popover names it: a community's member by the community's name.
function whoOf(who: Recipient): string {
  return match (who.source) {
    Source::Own => Locale::WHO_OWN
    Source::Friend => Locale::WHO_FRIEND
    Source::Guild => Locale::WHO_GUILD
    Source::Community => who.group
    Source::Recent => Locale::WHO_RECENT
  }
}

// A name in the popover under «To»: a dot, green while online, the name in its class's colour, the level, and who it
// is to the player.
public class NameRow implements Component {
  public pick: Event<string> = new Event()

  derived dot: color = self.who.online ? Style::GREEN : Style::FAINT
  derived ink: color = self.who.color ?? Style::INK
  derived level: string = self.who.level > 0 ? string::of(self.who.level) : ""
  derived kind: string = whoOf(self.who)

  who: Signal<Recipient>
  constructor(who: Signal<Recipient>) {
    self.who = who
  }

  mut onPick() { self.pick.emit(self.who.name) }

  public render(): Template {
    return $ltml {
      <PickRow columns={NAME_ROW} @pick={self.onPick}>
        <box width={DOT} height={DOT} background={self.dot} />
        <text value={self.who.name} textColor={self.ink} wrap={.None} />
        <text value={self.level} textColor={Style::DIM} textSize={SECONDARY_TEXT} wrap={.None} />
        <text value={self.kind} textColor={Style::DIM} textSize={SECONDARY_TEXT} wrap={.None} />
      </PickRow>
    }
  }
}

// One stack's slot of the form (the empty slot after the last is a bare `ItemButton`).
public class FormSlot implements Component {
  public remove: Event<Game::MailStack> = new Event()
  public dropped: Event<nil> = new Event()

  // As the slot takes it: an item or none.
  derived item: integer | nil = self.stack.item
  derived count: integer = self.stack.count

  stack: Signal<Game::MailStack>
  constructor(stack: Signal<Game::MailStack>) {
    self.stack = stack
  }

  mut onPick() { self.remove.emit(self.stack) }

  mut onDrop() { self.dropped.emit() }

  public render(): Template {
    return $ltml {
      <ItemButton item={self.item} count={self.count} size={SLOT} @pick={self.onPick} @dropped={self.onDrop}
                  @pressed={self.onDrop} />
    }
  }
}

public class Compose implements Component {
  // The form closed (its ✕, or its letters put into the queue).
  public closed: Event<nil> = new Event()

  state to = ""
  // The name last put into «To» from the popover: the popover stays shut while the field holds it.
  state picked = ""
  state subject = ""
  state body = ""
  state paidTab = 1
  state copper = 0
  state stacks: mut array<Game::MailStack> = mut []
  state names: array<Recipient> = []
  derived typed: string = trimmed(self.to)
  derived shown: array<Recipient> = matching(self.names, self.typed, SHOWN_NAMES)
  derived listing: boolean = self.typed != "" && self.picked != self.to && self.shown.length > 0
  derived cod: boolean = self.paidTab == COD_TAB
  derived letters: integer = lettersFor(self.stacks.length)
  derived slots: array<LetterSlots> = self.slotsOf()
  derived postage: integer = self.postageOf()
  // The footer's: what the letters cost to send.
  derived counts: array<FooterCount> = [{ label: Locale::POSTAGE, value: Game::money.format(self.postage) }]
  derived codTooHigh: boolean = self.cod && self.copper > COD_MOST
  derived codSplit: boolean = self.cod && self.copper > 0 && self.letters > 1
  derived ready: boolean = self.typed != "" && !self.codTooHigh && !self.codSplit

  const sender: mut Sender
  alts: Signal<Alts | nil>
  constructor(sender: mut Sender, alts: Signal<Alts | nil>, to: string = "") {
    self.sender = sender
    self.alts = alts
    self.to = to
    self.picked = to
    watch (known of self.alts) { self.names = everyone(known, (peek self.sender.recent.values).names) }
    // What the game's letter takes (an item Right-clicked in the bags, one dropped on a slot) comes into the form.
    Events::MAIL_SEND_INFO_UPDATE.listen(self.absorb)
    Game::mailbox.writing(true)
  }

  destructor() {
    Game::mailbox.writing(false)
  }

  // The letters' slots: twelve stacks a letter, and the empty slot after the last stack.
  slotsOf(): array<LetterSlots> {
    const list: array<LetterSlots> = mut []
    const total = self.stacks.length
    const count = lettersFor(total + 1)
    for (number of 1..count) {
      const stacks: array<Game::MailStack> = mut []
      for (index of ((number - 1) * PLACES + 1)..(number * PLACES).min(total)) {
        stacks.push(self.stacks[index] ?? panic("a place within the stacks"))
      }
      list.push({
        number: number, title: count > 1 ? Locale::LETTER_NUMBER.format(number) : "", stacks: stacks,
        open: number == count
      })
    }
    return list
  }

  postageOf(): integer {
    let total = 0
    for (number of 1..self.letters) {
      total += Game::mailbox.postage((self.stacks.length - (number - 1) * PLACES).min(PLACES).max(0))
    }
    return total
  }

  mut onPickName(name: string) {
    self.to = name
    self.picked = name
  }

  // The game's letter took items: each comes into the form as the stack it lies in (locked while in the letter), and
  // goes back from the game's letter to the bags.
  mut absorb() {
    if (self.sender.busy()) { return }
    for (place of 1..PLACES) {
      const (_, item, _, count, _) = Client::GetSendMailItem(place)
      if (item != nil) {
        const stack = stackOf(item.floor(), (count ?? 1).floor(), true, peek self.stacks)
        if (stack != nil) { self.stacks.push(stack) }
        Client::ClickSendMailItemButton(place, true)
      }
    }
  }

  // An item let go on a slot: into the game's letter, and from there into the form.
  mut onDrop() {
    if (!Client::CursorHasItem()) { return }
    Client::ClickSendMailItemButton(nil, nil)
    self.absorb()
  }

  mut onRemove(stack: Game::MailStack) {
    self.stacks = (peek self.stacks).filter(s => s.bag != stack.bag || s.slot != stack.slot)
  }

  mut onClose() { self.closed.emit() }

  // «Send»: the letters into the queue, which sends them one after another; the form closes.
  mut onSend() {
    if (!(peek self.ready)) { return }
    const stacks = peek self.stacks
    const subject = trimmed(peek self.subject)
    const first = stacks[1]
    const named = subject != "" ? subject : first != nil ? Client::C_Item::GetItemNameByID(first.item) ?? Locale::MONEY : Locale::MONEY
    const amount = peek self.copper
    const cod = peek self.cod ? amount : 0
    const copper = peek self.cod ? 0 : amount
    self.sender.put(peek self.typed, named.sub(1, SUBJECT_MOST), peek self.body, stacks, copper, cod)
    self.closed.emit()
  }

  public render(): Template {
    return $ltml {
      <box rows={["max-content", { fr: 1 }, "max-content"]} gap={2sp}>
        <box columns={[{ fr: 1 }, "max-content"]} yAlign={Align::Center}>
          <text value={Locale::WRITE} textColor={Style::GOLD} />
          <PushButton label={Locale::CLOSE} width={Style::BUTTON} @click={self.onClose} />
        </box>
        <box columns={1} gap={2sp} overflow={Overflow::Scroll}>
          <box columns={1}>
            <Field value={mut self.to} maxLength={64} placeholder={Locale::TO} />
            <surface $if={self.listing} layer={Layer::Tooltip} place={Beside { beside: "parent" }} width={POPOVER}
                     background={Style::FIELD_BACK} border={Style::FIELD_EDGE} columns={1}>
              <NameRow $for={who of self.shown} $key={who.name} who={who} @pick={self.onPickName} />
            </surface>
          </box>
          <Field value={mut self.subject} maxLength={SUBJECT_MOST} placeholder={Locale::SUBJECT} />
          <box height={93.75dp} rows={[{ fr: 1 }]}>
            <input value={mut self.body} multiline={true} maxLength={500} padding={Style::FIELD_PAD}
                   background={Style::FIELD_BACK} border={Style::FIELD_EDGE} textColor={Style::INK} />
          </box>
          <box $for={letter of self.slots} $key={letter.number} columns={1} gap={1sp}>
            <text $if={letter.title != ""} value={letter.title} textColor={Style::DIM} textSize={SECONDARY_TEXT} />
            <box columns={SLOTS} gap={1sp}>
              <FormSlot $for={index, stack of letter.stacks} $key={index} stack={stack} @remove={self.onRemove}
                        @dropped={self.onDrop} />
              <ItemButton $if={letter.open} item={nil} size={SLOT} @dropped={self.onDrop} @pressed={self.onDrop} />
            </box>
          </box>
          <box columns={1} gap={2sp}>
            <Tabs tabs={PAID_TABS} selected={mut self.paidTab} />
            <box columns={["max-content"]}>
              <MoneyField value={mut self.copper} />
            </box>
          </box>
          <text $if={self.codTooHigh} value={Locale::COD_TOO_HIGH} textColor={Style::RED} textSize={SECONDARY_TEXT} />
          <text $if={self.codSplit} value={Locale::COD_ONE_LETTER} textColor={Style::RED} textSize={SECONDARY_TEXT} />
          <box columns={FOOT} gap={2sp}>
            <text value={Locale::ATTACHMENTS} textColor={Style::DIM} />
            <text value={"%d"} arguments={[self.stacks.length]} textColor={Style::DIM} textFont={.Numbers} />
            <text value={Locale::LETTERS} textColor={Style::DIM} />
            <text value={"%d"} arguments={[self.letters]} textColor={Style::DIM} textFont={.Numbers} />
          </box>
        </box>
        <ListFooter counts={self.counts}>
          <PushButton label={Locale::SEND} width={Style::BUTTON} plate={ButtonPlate::Accent} disabled={!self.ready}
                      @click={self.onSend} />
        </ListFooter>
      </box>
    }
  }
}
