// The letters going out: one at a time, each attached again from the bags as it goes (an item no longer there is
// skipped and the letter says so), and the next only after the game said the last one went (`sent`) or failed. The
// queue and the last hundred letters gone are kept per character, so a closed mailbox or a reload only pauses it; the
// recent recipients account-wide. Nothing sends while the mailbox is shut.
import Game from "$game"
import { ModuleMemory } from "Ordaen"
import { HISTORY_MOST, Kept, PLACES, QUEUE_MOST, Recent, Sent, SentItem, SentState, lettersFor, numbered, remembered, waits } from "@/letters"
import Locale from "@/locales"

// How long the game is given to answer a letter before it counts as not sent.
const ANSWER = 10
// How long a letter waits for the bags to change after a split, or while a stack of its items is locked (the server
// hasn't answered a split or a move yet), before it looks again; and how many times it looks before it goes without
// what is still locked.
const SETTLE = 1
const SETTLE_TRIES = 5

function emptySlot(): mut Game.SlotItem {
  return {
    id: 0, count: 0, quality: 0, icon: nil, name: "", link: "", level: 0, kind: 0, subkind: 0, subkindName: "", worn: "",
    bound: false, locked: false, isNew: false, price: 0
  }
}

public class Sender {
  public memory: mut ModuleMemory<Kept> = new ModuleMemory<Kept>({}, .Character, "outbox")
  public recent: mut ModuleMemory<Recent> = new ModuleMemory<Recent>({}, .Account, "recipients")
  // What the game said last while a letter went: why it didn't.
  said = ""
  answer: Task<nil> | nil = nil
  // The next letter waits for the bags: a stack was split for it, or one of its items lies locked. It looks again as
  // the bags change, or after `SETTLE` seconds where they don't.
  settling = false
  settleLater: Task<nil> | nil = nil
  // How many times the next letter has waited for its locked items.
  settleTries = 0

  constructor() {
    Game.bags.changed.listen(self.onBags)
    Game.mailObserver.sent.listen(self.onSent)
    Game.mailObserver.failed.listen(self.onFailed)
    Game.mailObserver.refused.listen(self.onRefused)
  }

  // A letter written put into the queue: as many letters as its stacks need, twelve each, «(n/N)» on their subjects;
  // the money with the first, cash on delivery only where it is one letter. The queue goes on at once.
  public put(mut self, to: String, subject: String, body: String, stacks: Array<Game.MailStack>, copper: Integer, cod: Integer) {
    const count = lettersFor(stacks.length)
    const values = peek self.memory.values
    let next = values.next
    const queue: Array<Sent> = []
    for (letter of values.queue) { queue.push(letter.clone()) }
    for (place of 1..count) {
      const items: Array<SentItem> = []
      for (index of ((place - 1) * PLACES + 1)..(place * PLACES).min(stacks.length)) {
        const stack = stacks[index] ?? panic("within the stacks")
        items.push({ item: stack.item, count: stack.count })
      }
      if (queue.length < QUEUE_MOST) {
        queue.push({
          number: next, to: to, subject: numbered(subject, place, count), body: body, items: items,
          copper: place == 1 ? copper : 0, cod: count == 1 ? cod : 0, at: peek Game.clock.server
        })
      }
      next += 1
    }
    self.memory.write({ queue: queue, history: values.history, next: next })
    self.recent.write({ names: remembered((peek self.recent.values).names, to) })
    self.go()
  }

  // Whether a letter is on its way: the game's letter is the queue's until it went.
  public busy(self): Boolean { return (peek self.memory.values).queue.any(l => l.state == SentState.Sending) }

  // The first waiting letter sent, where the mailbox is open and none is on its way.
  public go(mut self) {
    if (!(peek Game.mailObserver.open)) { return }
    const queue = (peek self.memory.values).queue
    if (queue.any(l => l.state == SentState.Sending)) { return }
    const at = queue.find(l => l.state == SentState.Waiting)
    if (at == nil) { return }
    // An item whose stack the server hasn't given back yet (a split, a move) is waited for; then part of a stack is
    // split off; the letter goes once the bags hold it.
    if (self.settling) { return }
    if (self.settleTries < SETTLE_TRIES && unsettled(at.items)) {
      self.settleTries += 1
      self.settle()
      return
    }
    if (splitFor(at.items)) {
      self.settle()
      return
    }
    self.settleTries = 0
    const stacks = stacksFor(at.items)
    // On its way before the game's letter is written: what the letter takes in is the queue's, not the form's.
    const sending = at.clone()
    sending.state = SentState.Sending
    if (stacks.length < at.items.length) {
      sending.why = Locale.ITEMS_MISSING.format(at.items.length - stacks.length)
    }
    self.replace(sending)
    self.said = ""
    Game.mailbox.writing(true)
    const sent = Game.mailbox.send({
      to: at.to, subject: at.subject, body: at.body, copper: at.copper, cod: at.cod, stacks: stacks
    })
    if (!sent) {
      const stopped = at.clone()
      stopped.state = SentState.Stopped
      stopped.why = Locale.ITEMS_MOVED
      self.replace(stopped)
      return
    }
    if (self.answer != nil) { destroy self.answer }
    self.answer = self.waitAnswer()
  }

  // The next letter waits for the bags to change, or for `SETTLE` seconds.
  settle(mut self) {
    self.settling = true
    if (self.settleLater != nil) { destroy self.settleLater }
    self.settleLater = self.settleAfter()
  }

  async settleAfter(mut self) {
    await Game.delay(SETTLE)
    self.settleLater = nil
    self.onBags()
  }

  async waitAnswer(mut self) {
    await Game.delay(ANSWER)
    self.answer = nil
    self.failSending(Locale.NO_ANSWER)
  }

  replace(mut self, letter: Sent) {
    const values = peek self.memory.values
    const queue = values.queue.map(l => l.number == letter.number ? letter : l)
    self.memory.write({ queue: queue, history: values.history, next: values.next })
  }

  // The letter on its way went: into the history, the newest first, and the next one goes.
  onSent(mut self) {
    if (self.answer != nil) { destroy self.answer }
    const values = peek self.memory.values
    const gone = values.queue.find(l => l.state == SentState.Sending)
    if (gone == nil) { return }
    const done = gone.clone()
    done.state = SentState.Sent
    done.at = peek Game.clock.server
    const history: Array<Sent> = [done]
    for (old of values.history) {
      if (history.length < HISTORY_MOST) { history.push(old) }
    }
    self.memory.write({ queue: values.queue.filter(l => l.number != done.number), history: history, next: values.next })
    self.go()
  }

  onRefused(mut self, message: String) { self.said = message }

  onBags(mut self) {
    if (!self.settling) { return }
    self.settling = false
    if (self.settleLater != nil) { destroy self.settleLater }
    self.go()
  }

  onFailed(mut self) { self.failSending(self.said == "" ? Locale.NOT_SENT : self.said) }

  // The letter on its way didn't go: it stops, and so does the queue.
  failSending(mut self, why: String) {
    if (self.answer != nil) { destroy self.answer }
    const queue = (peek self.memory.values).queue
    const at = queue.find(l => l.state == SentState.Sending)
    if (at == nil) { return }
    const letter = at.clone()
    letter.state = SentState.Stopped
    letter.why = why
    self.replace(letter)
  }

  // The mailbox closed: the letter on its way and those waiting stop there, and wait for the next mailbox.
  public closed(mut self) {
    if (self.answer != nil) { destroy self.answer }
    self.stopAll(Locale.MAIL_CLOSED)
  }

  // «Stop»: what waits stops.
  public pause(mut self) { self.stopAll(Locale.STOPPED_BY_YOU) }

  stopAll(mut self, why: String) {
    self.settling = false
    self.settleTries = 0
    if (self.settleLater != nil) { destroy self.settleLater }
    const values = peek self.memory.values
    const queue = values.queue.map(l => waits(l) ? { state: SentState.Stopped, why: why, ..l } : l)
    self.memory.write({ queue: queue, history: values.history, next: values.next })
  }

  // «Continue»: what stopped waits again, and the queue goes on.
  public resume(mut self) {
    const values = peek self.memory.values
    const queue = values.queue.map(l => l.state == SentState.Stopped ? { state: SentState.Waiting, why: "", ..l } : l)
    self.memory.write({ queue: queue, history: values.history, next: values.next })
    self.go()
  }

  // A letter still waiting taken out of the queue.
  public remove(mut self, number: Integer) {
    const values = peek self.memory.values
    const queue = values.queue.filter(l => l.number != number || l.state == SentState.Sending)
    self.memory.write({ queue: queue, history: values.history, next: values.next })
  }
}

// The stacks of the bags that hold a letter's items: each exactly that many of that item, not on its way anywhere, none
// taken twice. An item no stack holds is left out.
function stacksFor(items: Array<SentItem>): Array<Game.MailStack> {
  const found: Array<Game.MailStack> = []
  for (wanted of items) {
    const stack = stackOf(wanted.item, wanted.count, false, found)
    if (stack != nil) { found.push(stack) }
  }
  return found
}

// Whether one of a letter's items has no stack of its count to go, while a stack of that item lies locked: the server
// hasn't answered a split or a move yet, and the bags change again once it has.
function unsettled(items: Array<SentItem>): Boolean {
  const found: Array<Game.MailStack> = []
  for (wanted of items) {
    const stack = stackOf(wanted.item, wanted.count, false, found)
    if (stack != nil) {
      found.push(stack)
    } else if (lockedStack(wanted.item)) {
      return true
    }
  }
  return false
}

function lockedStack(item: Integer): Boolean {
  let slot = emptySlot()
  for (bag of 0..Game.bags.last) {
    for (place of 1..Game.bags.size(bag)) {
      if (Game.bags.readSlot(bag, place, mut slot) && slot.id == item && slot.locked) { return true }
    }
  }
  return false
}

// The first of a letter's items no whole stack holds split off a bigger one into an empty slot, as the game's split
// does; false where every item has its stack, or none can be split (no bigger stack, no empty slot).
function splitFor(items: Array<SentItem>): Boolean {
  const found: Array<Game.MailStack> = []
  for (wanted of items) {
    const stack = stackOf(wanted.item, wanted.count, false, found)
    if (stack != nil) {
      found.push(stack)
    } else {
      const from = biggerStack(wanted.item, wanted.count, found)
      const to = emptyPlace()
      if (from != nil && to != nil) { return Game.bags.split(from.bag, from.slot, wanted.count, to.bag, to.slot) }
    }
  }
  return false
}

struct Place {
  bag: Integer
  slot: Integer
}

function biggerStack(item: Integer, count: Integer, except: Array<Game.MailStack>): Place | nil {
  let slot = emptySlot()
  for (bag of 0..Game.bags.last) {
    for (place of 1..Game.bags.size(bag)) {
      if (Game.bags.readSlot(bag, place, mut slot) && slot.id == item && slot.count > count && !slot.locked && !slot.bound &&
          !except.any(s => s.bag == bag && s.slot == place)) {
        return { bag: bag, slot: place }
      }
    }
  }
  return nil
}

function emptyPlace(): Place | nil {
  let slot = emptySlot()
  for (bag of 0..Game.bags.last) {
    for (place of 1..Game.bags.size(bag)) {
      if (!Game.bags.readSlot(bag, place, mut slot)) { return { bag: bag, slot: place } }
    }
  }
  return nil
}

// A stack of the bags of exactly that many of that item, locked (on its way: in the game's letter) or not, and none of
// `except`; none where no stack is.
public function stackOf(item: Integer, count: Integer, locked: Boolean, except: Array<Game.MailStack>): Game.MailStack | nil {
  let slot = emptySlot()
  for (bag of 0..Game.bags.last) {
    for (place of 1..Game.bags.size(bag)) {
      if (Game.bags.readSlot(bag, place, mut slot) && slot.id == item && slot.count == count && slot.locked == locked &&
          !slot.bound && !except.any(s => s.bag == bag && s.slot == place)) {
        return { bag: bag, slot: place, item: item, count: count }
      }
    }
  }
  return nil
}
