// What the mailbox holds, as the window shows it: a letter, the ways the inbox is narrowed, the letters going out and
// gone, and how a letter of more than twelve stacks is cut into several.
import Game from "$game"

// A letter whose row says this many days left or fewer is shown red.
public const URGENT_DAYS = 3
// The places of a letter being written (`ATTACHMENTS_MAX_SEND`).
public const PLACES = 12
// The game's longest subject; a letter's «(2/3)» stands within it.
public const SUBJECT_MOST = 64
// What is kept of the letters gone and of the recent recipients, the oldest dropped.
public const HISTORY_MOST = 100
public const QUEUE_MOST = 50
public const RECIPIENTS_MOST = 20

public enum Filter implements Plain { All = "all", Players = "players", Auction = "auction", System = "system", Money = "money", Items = "items" }

public enum View implements Plain { List = "list", Categories = "categories", Table = "table" }

// Whether a letter passes the filter and the search (a part of its subject, its sender or an item's name).
public function matches(letter: Game::MailLetter, filter: Filter, search: string): boolean {
  const kept = match (filter) {
    Filter::All => true
    Filter::Players => letter.kind == Game::MailKind::Player
    Filter::Auction => letter.kind == Game::MailKind::Auction
    Filter::System => letter.kind == Game::MailKind::System
    Filter::Money => letter.copper > 0
    Filter::Items => letter.items.length > 0
  }
  if (!kept) { return false }
  if (search == "") { return true }
  const sought = search.lower()
  return letter.subject.lower().contains(sought) || letter.sender.lower().contains(sought) ||
    letter.items.any(i => i.name.lower().contains(sought))
}

// Whether «Take all» opens the letter: it holds money or items, asks nothing to be paid, and isn't a game master's
// (those are opened by hand, as the game's own «Open all» leaves them).
public function collectable(letter: Game::MailLetter): boolean {
  return letter.cod == 0 && !letter.gm && (letter.copper > 0 || letter.items.length > 0)
}

// A letter's name among the others while the inbox shifts under it (taken letters go, new ones come): its sender and
// subject.
public function keyOf(letter: Game::MailLetter): string { return `${letter.sender}\n${letter.subject}` }

public enum SentState implements Plain { Waiting = "waiting", Sending = "sending", Sent = "sent", Stopped = "stopped" }

// An item a letter going out carries, by its number and how many.
public struct SentItem implements Plain {
  item: integer = 0
  count: integer = 0
}

// A letter of «Outbox»: waiting to go, or gone.
public struct Sent implements Plain {
  number: integer = 0
  to: string = ""
  subject: string = ""
  body: string = ""
  items: array<SentItem> = []
  copper: integer = 0
  cod: integer = 0
  state: SentState = SentState::Waiting
  // Why it stopped; empty otherwise.
  why: string = ""
  // When it was put into the queue, and when it went: the realm's seconds.
  at: integer = 0
}

// A letter not yet gone and not stopped: waiting, or on its way.
public function waits(letter: Sent): boolean { return letter.state == SentState::Waiting || letter.state == SentState::Sending }

// What is kept of the outbox, per character: the letters waiting (to survive a closed mailbox and a reload) and the
// last letters gone, each capped; the next letter's number.
public struct Kept implements Plain {
  queue: array<Sent> = []
  history: array<Sent> = []
  next: integer = 1
}

// The recent recipients, account-wide: the newest first.
public struct Recent implements Plain {
  names: array<string> = []
}

// The subject with its letter's place among several, «(2/3)», kept within the game's length.
public function numbered(subject: string, place: integer, of: integer): string {
  if (of == 1) { return subject }
  const mark = ` (${place}/${of})`
  return subject.sub(1, SUBJECT_MOST - mark.length) + mark
}

// How many letters stacks go out as: twelve a letter, one for none.
public function lettersFor(stacks: integer): integer { return (1).max(((stacks + PLACES - 1) / PLACES).floor()) }

// A name put first among the recent recipients, once, the list kept to its cap.
public function remembered(names: array<string>, name: string): array<string> {
  const list: array<string> = mut [name]
  for (one of names) {
    if (one != name && list.length < RECIPIENTS_MOST) { list.push(one) }
  }
  return list
}
