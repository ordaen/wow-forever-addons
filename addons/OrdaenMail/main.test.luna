  Test.expect(subjects(window).join(" | ") == "Bolts for you")
}

test "a search nothing holds says nothing was found" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  window.input().type("zzz")
  Test.expect(window.text("Nothing found.").shown())
  Test.expect(subjects(window).length == 0)
}

// The views

test "by kind shows each kind under its caption with its count" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  pick(window, ARTWORK.ctl.tool.list, "By kind", "By kind")
  Test.expect(before(window, "Auction house (1)", "Auction successful: Linen Cloth"))
  Test.expect(before(window, "Auction successful: Linen Cloth", "From players (2)"))
  Test.expect(before(window, "From players (2)", "Bolts for you"))
  Test.expect(before(window, "Pay for the sword", "System (1)"))
  Test.expect(before(window, "System (1)", "Welcome"))
}

test "by kind leaves out a kind the filter keeps none of" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  filter(window, "From players")
  pick(window, ARTWORK.ctl.tool.list, "By kind", "By kind")
  Test.expect(window.text("From players (2)").shown())
  Test.expect(!window.text("System (0)").shown())
  Test.expect(!window.text("Auction house (0)").shown())
}

test "the table says in words what each letter carries" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  pick(window, ARTWORK.ctl.tool.list, "By kind", "Table")
  Test.expect(window.text("Items: 2").shown())
  Test.expect(window.text("Items: 1, Cash on delivery").shown())
  Test.expect(window.text("Auction successful: Linen Cloth").item().text("1g 25s 0c").shown())
  Test.expect(window.text("Welcome").item().text("System").shown())
}

test "the table's days left are red under three days" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  pick(window, ARTWORK.ctl.tool.list, "By kind", "Table")
  Test.expect(drawnIn(window.text("Bolts for you").item().text("2 d"), RED))
  Test.expect(drawnIn(window.text("Welcome").item().text("30 d"), DIM))
}

test "the table is sorted by subject, and a heading clicked again reverses it" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  pick(window, ARTWORK.ctl.tool.list, "By kind", "Table")
  Test.expect(before(window, "Auction successful: Linen Cloth", "Bolts for you"))
  Test.expect(before(window, "Bolts for you", "Pay for the sword"))
  Test.expect(before(window, "Pay for the sword", "Welcome"))
  window.button("Subject").click()
  Test.expect(before(window, "Welcome", "Pay for the sword"))
  Test.expect(before(window, "Bolts for you", "Auction successful: Linen Cloth"))
}

test "the table sorts by sender, and by the days left" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  pick(window, ARTWORK.ctl.tool.list, "By kind", "Table")
  window.button("From").click()
  // The System's letter, whose sender is empty, first; then «Auction House», «Dorn», «Regy».
  Test.expect(before(window, "Welcome", "Auction successful: Linen Cloth"))
  Test.expect(before(window, "Auction successful: Linen Cloth", "Pay for the sword"))
  Test.expect(before(window, "Pay for the sword", "Bolts for you"))
  window.button("Left").click()
  Test.expect(before(window, "Bolts for you", "Pay for the sword"))
  Test.expect(before(window, "Pay for the sword", "Auction successful: Linen Cloth"))
  Test.expect(before(window, "Auction successful: Linen Cloth", "Welcome"))
}

test "the view and the filter the player picked are kept when the inbox is shown again" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  filter(window, "From players")
  pick(window, ARTWORK.ctl.tool.list, "By kind", "By kind")
  window.button("Sent").click()
  window.button("Inbox (4)").click()
  Test.expect(window.text("From players (2)").shown())
  Test.expect(!window.text("Welcome").shown())
}

// Sent

function sent(): Array<Sent> {
  return [
    { number: 1, subject: "Reagents (1/2)", to: "Regy", items: 12, copper: 0, state: SentState.Sent, why: "" },
    { number: 2, subject: "Reagents (2/2)", to: "Regy", items: 3, copper: 100, state: SentState.Stopped, why: "Mailbox closed" },
    { number: 3, subject: "Herbs", to: "Kel", items: 0, copper: 0, state: SentState.Waiting, why: "" }
  ]
}

test "a letter sent says so, in green" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  Mail.sent = sent()
  const window = Test.page().window(MAIL)
  window.button("Sent").click()
  const row = window.text("Reagents (1/2)").item()
  Test.expect(row.texts().join(" | ") == "1 | Reagents (1/2) | Regy | Items: 12 | Sent")
  Test.expect(drawnIn(row.text("Sent"), GREEN))
}

test "a letter stopped says why, in red" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  Mail.sent = sent()
  const window = Test.page().window(MAIL)
  window.button("Sent").click()
  const row = window.text("Reagents (2/2)").item()
  Test.expect(row.texts().join(" | ") == "2 | Reagents (2/2) | Regy | Items: 3 | 0g 1s 0c | Stopped: Mailbox closed")
  Test.expect(drawnIn(row.text("Stopped: Mailbox closed"), RED))
}

test "a letter waiting to go says so, and the footer counts the letters waiting" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  Mail.sent = sent()
  const window = Test.page().window(MAIL)
  window.button("Sent").click()
  Test.expect(window.text("Herbs").item().texts().join(" | ") == "3 | Herbs | Kel |  | Waiting")
  Test.expect(window.text("Letters waiting: 1").shown())
}

test "with no letter sent the tab says so" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  window.button("Sent").click()
  Test.expect(window.text("No letters sent yet.").shown())
  Test.expect(!window.text("Letters waiting: 0").shown())
}

test "the sent letters' filter keeps the stopped ones" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  Mail.sent = sent()
  const window = Test.page().window(MAIL)
  window.button("Sent").click()
  pick(window, Ordaen.art.ctl.tool.filter, "Stopped", "Stopped")
  Test.expect(window.text("Reagents (2/2)").shown())
  Test.expect(!window.text("Reagents (1/2)").shown())
  Test.expect(!window.text("Herbs").shown())
}

test "the sent letters' search keeps those whose recipient holds it" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  Mail.sent = sent()
  const window = Test.page().window(MAIL)
  window.button("Sent").click()
  window.input().type("KEL")
  Test.expect(window.text("Herbs").shown())
  Test.expect(!window.text("Reagents (1/2)").shown())
}

