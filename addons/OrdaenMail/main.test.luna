  window.text("Bolts for you").click()
  Game.input.shiftDown = (): Boolean => false
  Game.input.controlDown = (): Boolean => false
  Test.expect(asked() == "Mailbox.takeItem 2 1")
  Game.mailbox.letters = (): Array<Game.MailLetter> => [letter(2, .Player, "Bolts for you", "Regy", 0, 0, 2, [item(3, 2592, "Wool Cloth", 5)])]
  Game.mailObserver.changed.emit()
  Test.expect(asked() == "Mailbox.takeItem 2 3")
