  window.text("Bolts for you").click()
  _ = Test::requests()
  window.text("Wool Cloth").click()
  Test::expect(asked().contains("Mailbox.takeItem 2 3"))
}

test "Ctrl+click on an attachment tries it on and takes nothing" {
  let tried = ""
  Client::DressUpItemLink = (link: string): boolean => {
    tried = link
    return true
  }
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  const window = Test::page().window(MAIL)
  window.text("Pay for the sword").click()
  _ = Test::requests()
  Test::hold([.Ctrl])
  window.text("Sword").click()
  Test::hold([])
  Test::expect(tried == "|Hitem:12|h[Sword]|h")
  Test::expect(!asked().contains("Mailbox.takeItem"))
}

test "an attachment the player can't use says so in red; one Pawn rates says by how much it raises the best scale" {
  Game::items.tooltip = (id: integer): Game::TooltipData | nil => id == 2592 ? { lines: [{ left: "Requires Level 57", kind: 0, usable: false }] } : nil
  Mail.upgrade = (link: string): number | nil => link.contains("Linen") ? 0.153 : nil
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  const window = Test::page().window(MAIL)
  window.text("Bolts for you").click()
  Test::expect(window.text("Wool Cloth").item().text("You can't use this").shown())
  Test::expect(!window.text("Linen Cloth").item().text("You can't use this").shown())
  Test::expect(window.text("Linen Cloth").item().text("+15%").shown())
  Test::expect(!window.text("Wool Cloth").item().text("+15%").shown())
}

test "Shift+click on a row takes everything from it, one thing at a time as the game reads the inbox again" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  _ = Test::requests()
  const window = Test::page().window(MAIL)
  // Shift held as the client holds it: the row hears the click with it.
  Test::hold([.Shift])
  window.text("Bolts for you").click()
  Test::hold([])
  Test::expect(asked() == "Mailbox.takeItem 2 1")
  // The inbox read the take brings at once still holds what was taken: nothing is asked again.
  Game::mailObserver.changed.emit()
  Test::pass(1)
  Test::expect(asked() == "")
  Game::mailbox.letters = (): array<Game::MailLetter> => [letter(2, .Player, "Bolts for you", "Regy", 0, 0, 2, [item(3, 2592, "Wool Cloth", 5)])]
  answered()
  Test::expect(asked() == "Mailbox.takeItem 2 3")
}

// The server answers what was asked, with the inbox read anew, and a moment passes.
function answered() {
  Game::mailObserver.changed.emit()
  Game::mailObserver.taken.emit()
  Test::pass(0.3)
}

test "«Take all» takes the money first and leaves cash on delivery and game masters' letters" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  _ = Test::requests()
  const window = Test::page().window(MAIL)
  window.button("Take all (2)").click()
  Test::expect(asked() == "Mailbox.takeMoney 1")
  Game::mailbox.letters = (): array<Game::MailLetter> => letters().filter(l => l.index != 1)
  answered()
  Test::expect(asked() == "Mailbox.takeItem 2 1")
}

test "«Take all» writes the house's sale into Ordaen Trading's ledger once, from its invoice" {
  Client::GetInboxInvoiceInfo = (index: number): (string | nil, string | nil, string | nil, number | nil, number | nil, number | nil, number | nil, number | nil, number | nil, number | nil, number | nil) => {
    if (index == 1) { return ("seller", "Linen Cloth", nil, 12500, nil, nil, nil, nil, nil, nil, 20) }
    return (nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)
  }
  Test::mount(nil, PAGE)
  const auction = Trading ?? panic("Ordaen Trading is on")
  const (before, copperBefore) = auction.ledger.total(.Sold)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  const window = Test::page().window(MAIL)
  window.button("Take all (2)").click()
  window.button("Take all (2)").click()
  const (after, copperAfter) = auction.ledger.total(.Sold)
  Test::expect(after == before + 1 && copperAfter == copperBefore + 12500)
}

test "«Inventory is full» stops taking; «can't carry any more» skips that attachment" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  _ = Test::requests()
  const window = Test::page().window(MAIL)
  window.button("Take all (2)").click()
  _ = Test::requests()
  Game::mailbox.letters = (): array<Game::MailLetter> => letters().filter(l => l.index != 1)
  answered()
  Test::expect(asked() == "Mailbox.takeItem 2 1")
  Game::mailObserver.refused.emit(Game::strings.itemMaxCount)
  Test::pass(0.3)
  Test::expect(asked() == "Mailbox.takeItem 2 3")
  Game::mailObserver.refused.emit(Game::strings.inventoryFull)
  Test::pass(3)
  Test::expect(asked() == "")
  Test::expect(window.text("Bags are full").shown())
}

