// The mail window as the player meets it: the game opens the mailbox, the window lists its letters, and the player
// opens, takes, returns, deletes, writes and sends. What the window asks of the game is heard as `Test.requests()`;
// the game's answers are emitted on the mail observer.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import { classColor } from "Ordaen"
import root Mail from "OrdaenMail"
import root Trading from "OrdaenTrading"

const PAGE: Test::Page = { left: 20, top: 20, width: 1500, height: 820, screen: true }
// A text the mail window always shows: its third tab.
const MAIL = "To my characters"
const RED: Color = Color::hex("#ff4040")
const GREEN: Color = Color::hex("#40d060")
// An item slot's well, empty or not.
const SLOT_WELL: Color = Color::hex("#0d0a08")

function item(place: integer, id: integer, name: string, count: integer): Game::MailItem {
  return { place: place, item: id, name: name, count: count, link: `|Hitem:${id}|h[${name}]|h` }
}

function letter(index: integer, kind: Game::MailKind, subject: string, sender: string, copper: integer, cod: integer, days: number, items: array<Game::MailItem>): Game::MailLetter {
  return {
    index: index, kind: kind, subject: subject, sender: sender, copper: copper, cod: cod, days: days, items: items,
    read: false, returned: false, gm: false, deletable: kind != Game::MailKind::Player
  }
}

function letters(): array<Game::MailLetter> {
  return [
    letter(1, .Auction, "Auction successful: Linen Cloth", "Auction House", 12500, 0, 29, []),
    letter(2, .Player, "Bolts for you", "Regy", 0, 0, 2, [item(1, 2589, "Linen Cloth", 20), item(3, 2592, "Wool Cloth", 5)]),
    letter(3, .Player, "Pay for the sword", "Dorn", 0, 40000, 10, [item(1, 12, "Sword", 1)]),
    letter(4, .System, "Welcome", "", 0, 0, 30, [])
  ]
}

// Whether a text is drawn in this colour.
function drawnIn(part: Test::Part, color: Color): boolean {
  const ink = part.textColor()
  return (ink.r * 255).round() == (color.r * 255).round() && (ink.g * 255).round() == (color.g * 255).round() &&
    (ink.b * 255).round() == (color.b * 255).round()
}

// What was asked of the game since last asked, as one line.
function asked(): string { return Test::requests().join(", ") }

// The window

test "the mail window shows once the game opens the mailbox, and goes when it closes" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Test::expect(!Test::page().window(MAIL).shown())
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  const window = Test::page().window(MAIL)
  Test::expect(window.text("Bolts for you").shown())
  Game::mailObserver.open = false
  Test::expect(!window.shown())
}

test "the game's mailbox window stays open underneath, unseen and without the mouse, while ours shows" {
  const game = Client::CreateFrame("Frame", "MailFrame", Client::UIParent, nil)
  game.SetSize(300, 400)
  game.Show()
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  Test::flush()
  Test::expect(game.IsShown() && game.GetAlpha() == 0 && !game.IsMouseEnabled())
}

test "«To my characters» has one footer, its own: the letters «Send all» takes and the button; no game window's button anywhere" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  const window = Test::page().window(MAIL)
  Test::expect(!window.button("Blizzard window").shown())
  window.button("To my characters").click()
  Test::expect(window.button("Send all").shown() && window.button("Send all").count() == 1)
  Test::expect(window.text("Letters").count() == 1 && !window.text("4 / 4").shown())
  Test::expect(!window.button("Blizzard window").shown())
}

test "the inbox tab counts the letters, the footer the letters shown of those waiting" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  _ = Test::requests()
  const window = Test::page().window(MAIL)
  Test::expect(window.text("4 letters").shown())
  Test::expect(window.text("4 / 4").shown())
}

test "while more letters wait than the server shows, it is asked again a little later" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 60
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  _ = Test::requests()
  Test::pass(16)
  Test::expect(asked().contains("Mailbox.check"))
}

// A letter's row

test "each row says its subject, its sender, what it carries and the days left" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  _ = Test::requests()
  const window = Test::page().window(MAIL)
  Test::expect(window.text("Bolts for you").item().text("Regy").shown())
  Test::expect(window.text("Pay for the sword").item().text("Cash on delivery").shown())
  Test::expect(window.text("Welcome").item().text("System").shown())
  Test::expect(drawnIn(window.text("Bolts for you").item().text("2 d"), RED))
}

test "the search finds a letter by an item it carries" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
