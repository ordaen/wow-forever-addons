// Collecting

test "Collect all counts the letters with money or items and nothing to pay" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  Test.expect(window.button("Collect all (2)").shown())
}

test "Collect all counts only the letters the filter keeps" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  filter(window, "From players")
  Test.expect(window.button("Collect all (1)").shown())
}

test "Collect all asks for the letters with money or items and nothing to pay" {
  const fixture = new Fixture()
  const inbox = new Inbox(fixture.letters, fixture.total, fixture.yes)
  Test.mount(inbox, AREA)
  const heard = new Heard(inbox)
  Test.page().button("Collect all (2)").click()
  Test.expect(heard.collected == "1,2")
}

test "Collect all asks only for the letters the filter keeps" {
  const fixture = new Fixture()
  const inbox = new Inbox(fixture.letters, fixture.total, fixture.yes)
  Test.mount(inbox, AREA)
  const heard = new Heard(inbox)
  filter(Test.page(), "With money")
  Test.page().button("Collect all (1)").click()
  Test.expect(heard.collected == "1")
}

test "a picked letter's Collect all asks for that letter alone" {
  const fixture = new Fixture()
  const inbox = new Inbox(fixture.letters, fixture.total, fixture.yes)
  Test.mount(inbox, AREA)
  const heard = new Heard(inbox)
  Test.page().button("Bolts for you").click()
  Test.page().button("Collect all").click()
  Test.expect(heard.collected == "2")
}

test "a picked letter's Return asks for that letter to go back" {
  const fixture = new Fixture()
  const inbox = new Inbox(fixture.letters, fixture.total, fixture.yes)
  Test.mount(inbox, AREA)
  const heard = new Heard(inbox)
  Test.page().button("Pay for the sword").click()
  Test.page().button("Return").click()
  Test.expect(heard.returned == 3)
}

test "where the game takes no mail, Collect all asks for nothing" {
  const fixture = new Fixture()
  fixture.yes = false
  const inbox = new Inbox(fixture.letters, fixture.total, fixture.yes)
  Test.mount(inbox, AREA)
  const heard = new Heard(inbox)
  Test.page().button("Collect all (2)").click()
  Test.page().button("Bolts for you").click()
  Test.page().button("Collect all").click()
  Test.expect(heard.times == 0)
}

// Ticking

test "no letter is ticked as the mailbox opens" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  for (n of 0..=4) { Test.expect(!window.button(`Collect (${n})`).shown()) }
}

test "a ticked box offers its letter to collect" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  window.text("Bolts for you").item().button(Ordaen.art.ctl.check).click()
  Test.expect(window.button("Collect (1)").shown())
}

test "a box ticked again lets its letter go" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  const tick = window.text("Bolts for you").item().button(Ordaen.art.ctl.check)
  tick.click()
  tick.click()
  Test.expect(!window.button("Collect (1)").shown())
}

test "a box unticked leaves the others ticked" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  window.text("Auction successful: Linen Cloth").item().button(Ordaen.art.ctl.check).click()
  window.text("Bolts for you").item().button(Ordaen.art.ctl.check).click()
  window.text("Auction successful: Linen Cloth").item().button(Ordaen.art.ctl.check).click()
  Test.expect(window.button("Collect (1)").shown())
}

test "Shift on a box ticks every letter from the last ticked" {
