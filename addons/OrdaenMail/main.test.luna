// The mail window on the stand-in game: the inbox with a letter picked, the letters
// sent and the player's own characters. The root is drawn on the screen as Ordaen draws it.
import Game from "$game"
import Test from "$test"
import root Mail from "OrdaenMail"
import { Filter } from "@/letters"
import { Inbox, View } from "@/inbox"
import { OwnTab } from "@/own"
import type { Alts } from "OrdaenAlts"
import { SentState } from "@/letters"

const PAGE: Test.Page = { left: 20, top: 20, width: 1300, height: 720, screen: true }
const AREA: Test.Page = { left: 20, top: 20, width: 1000, height: 600 }

function letters(): Array<Game.MailLetter> {
  return [
    {
      index: 1, kind: Game.MailKind.Auction, subject: "Auction successful: Linen Cloth", sender: "Auction House", copper: 12500,
      cod: 0, days: 29, items: [],
    },
    {
      index: 2, kind: Game.MailKind.Player, subject: "Bolts for you", sender: "Regy", copper: 0, cod: 0, days: 2,
      items: [{ item: 2589, name: "Linen Cloth", count: 20 }, { item: 2592, name: "Wool Cloth", count: 5 }],
    },
    {
      index: 3, kind: Game.MailKind.Player, subject: "Pay for the sword", sender: "Dorn", copper: 0, cod: 40000, days: 10,
      items: [{ item: 12, name: "Sword", count: 1 }],
    },
    { index: 4, kind: Game.MailKind.System, subject: "Welcome", sender: "", copper: 0, cod: 0, days: 30, items: [] },
  ]
}

test "the inbox lists the letters and shows the picked one" {
  Test.mount(nil, PAGE)
  Game.mailObserver.open = true
  Mail.letters = letters()
  Mail.total = 4
  Test.flush()
  Test.shot("the list: days left red under three, cash on delivery in orange")
  Test.click(Test.holding("Bolts for you", nil), nil)
  Test.shot("a letter picked: its attachments and its buttons")
}

test "the list shows only the letters it is given" {
  Test.mount(nil, PAGE)
  Game.mailObserver.open = true
  Mail.letters = letters()
  Mail.total = 4
  Test.flush()
  Mail.letters = letters().filter(l => l.kind == Game.MailKind.Player)
  Test.flush()
  Test.shot("only the letters from players")
}

test "the sent tab and the own characters' tab say what they hold" {
  Test.mount(nil, PAGE)
  Game.mailObserver.open = true
  Mail.letters = letters()
  Mail.total = 4
  Test.flush()
  Mail.sent = [
    { number: 1, subject: "Reagents (1/2)", to: "Regy", items: 12, copper: 0, state: SentState.Sent, why: "" },
    { number: 2, subject: "Reagents (2/2)", to: "Regy", items: 3, copper: 100, state: SentState.Stopped, why: "Mailbox closed" },
  ]
  Mail.tab = 2
  Test.flush()
  Test.shot("two letters: one sent, one stopped with its reason")
  Mail.tab = 3
  Test.flush()
  Test.shot("the own characters' tab with Ordaen Alts loaded and no other character")
}

test "each filter keeps its letters and each view draws them" {
  const fixture = new Fixture()
  const inbox = new Inbox(fixture.letters, fixture.total, fixture.yes)
  Test.mount(inbox, AREA)
  Test.flush()
  Test.expect(inbox.shown.length == 4)
  inbox.filter = Filter.Players
  Test.expect(inbox.shown.length == 2)
  inbox.filter = Filter.Auction
  Test.expect(inbox.shown.length == 1)
  inbox.filter = Filter.System
  Test.expect(inbox.shown.length == 1)
  inbox.filter = Filter.Money
  Test.expect(inbox.shown.length == 1)
  inbox.filter = Filter.Items
  Test.expect(inbox.shown.length == 2)
  inbox.filter = Filter.All
  inbox.search = "sword"
  Test.expect(inbox.shown.length == 1)
  inbox.search = ""
  inbox.view = View.Categories
  Test.flush()
  Test.shot("by kind: the captions with their counts")
  inbox.view = View.Table
  Test.flush()
  Test.shot("the table")
}

test "a ticked box ticks its letter, and Shift ticks the range from the last ticked" {
  const fixture = new Fixture()
  const inbox = new Inbox(fixture.letters, fixture.total, fixture.yes)
  Test.mount(inbox, AREA)
  Test.flush()
  inbox.onTick(1)
  Test.expect(inbox.ticked.length == 1)
  inbox.onTick(1)
  Test.expect(inbox.ticked.length == 0)
  inbox.onTick(1)
  Game.input.shiftDown = (): Boolean => true
  inbox.onTick(3)
  Test.expect(inbox.ticked.length == 3)
  Test.flush()
  Test.shot("three letters ticked: the footer offers them")
}

test "the own characters' tab says so when Ordaen Alts is off" {
  const fixture = new Fixture()
  Test.mount(new OwnTab(fixture.alts), AREA)
  Test.flush()
  Test.shot("Ordaen Alts off: nothing to offer")
}

// The cells a component under test is given.
class Fixture {
  state letters: Array<Game.MailLetter> = letters()
  state total = 4
  state yes = true
  state alts: Alts | nil = nil
}
