  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  const row = window.text("Bolts for you").item()
  Test.expect(row.text("Regy").shown())
  Test.expect(row.text("2 d").shown())
}

test "each row says its subject, its sender, what it carries and the days left, and nothing else" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  Test.expect(window.text("Auction successful: Linen Cloth").item().texts().join(" | ") == "Auction successful: Linen Cloth | Auction House | 1g 25s 0c | 29 d")
  Test.expect(window.text("Bolts for you").item().texts().join(" | ") == "Bolts for you | Regy | +1 | 2 d")
  Test.expect(window.text("Pay for the sword").item().texts().join(" | ") == "Pay for the sword | Dorn | Cash on delivery | 10 d")
  Test.expect(window.text("Welcome").item().texts().join(" | ") == "Welcome | System | 30 d")
}

test "the rows stand in the order the mailbox holds the letters" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  Test.expect(before(window, "Auction successful: Linen Cloth", "Bolts for you"))
  Test.expect(before(window, "Bolts for you", "Pay for the sword"))
  Test.expect(before(window, "Pay for the sword", "Welcome"))
}

