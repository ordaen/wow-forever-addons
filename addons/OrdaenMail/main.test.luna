test "Shift on a box with none ticked ticks that letter alone" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  Game.input.shiftDown = (): Boolean => true
  window.text("Pay for the sword").item().button(Ordaen.art.ctl.check).click()
  Test.expect(window.button("Collect (1)").shown())
}

test "the ticked letters' Collect asks for them" {
  const fixture = new Fixture()
  const inbox = new Inbox(fixture.letters, fixture.total, fixture.yes)
  Test.mount(inbox, AREA)
  const heard = new Heard(inbox)
  Test.page().text("Welcome").item().button(Ordaen.art.ctl.check).click()
  Test.page().text("Bolts for you").item().button(Ordaen.art.ctl.check).click()
  Test.page().button("Collect (2)").click()
  Test.expect(heard.collected == "4,2")
}

// Filters and the search

test "the filter From players keeps the letters from players" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  filter(window, "From players")
  Test.expect(subjects(window).join(" | ") == "Bolts for you | Pay for the sword")
}

test "the filter Auction house keeps the auction house's letters" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  filter(window, "Auction house")
  Test.expect(subjects(window).join(" | ") == "Auction successful: Linen Cloth")
}

