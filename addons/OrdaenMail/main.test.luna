// The mail window as the player meets it: the game opens the mailbox, the window lists its letters, and the player
// opens, takes, returns, deletes, writes and sends. What the window asks of the game is heard as `Test.requests()`;
// the game's answers are emitted on the mail observer.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Mail from "OrdaenMail"

const PAGE: Test.Page = { left: 20, top: 20, width: 1500, height: 820, screen: true }
// A text the mail window always shows: its third tab.
const MAIL = "To my characters"
const RED: Color = Color.hex("#ff4040")
const GREEN: Color = Color.hex("#40d060")

function item(place: Integer, id: Integer, name: String, count: Integer): Game.MailItem {
  return { place: place, item: id, name: name, count: count, link: `|Hitem:${id}|h[${name}]|h` }
}

function letter(index: Integer, kind: Game.MailKind, subject: String, sender: String, copper: Integer, cod: Integer, days: Number, items: Array<Game.MailItem>): Game.MailLetter {
  return {
    index: index, kind: kind, subject: subject, sender: sender, copper: copper, cod: cod, days: days, items: items,
    read: false, returned: false, gm: false, deletable: kind != Game.MailKind.Player
  }
}

function letters(): Array<Game.MailLetter> {
  return [
    letter(1, .Auction, "Auction successful: Linen Cloth", "Auction House", 12500, 0, 29, []),
    letter(2, .Player, "Bolts for you", "Regy", 0, 0, 2, [item(1, 2589, "Linen Cloth", 20), item(3, 2592, "Wool Cloth", 5)]),
    letter(3, .Player, "Pay for the sword", "Dorn", 0, 40000, 10, [item(1, 12, "Sword", 1)]),
    letter(4, .System, "Welcome", "", 0, 0, 30, [])
  ]
}

// Whether a text is drawn in this colour.
function drawnIn(part: Test.Part, color: Color): Boolean {
  const ink = part.textColor()
  return (ink.r * 255).round() == (color.r * 255).round() && (ink.g * 255).round() == (color.g * 255).round() &&
    (ink.b * 255).round() == (color.b * 255).round()
}

// What was asked of the game since last asked, as one line.
function asked(): String { return Test.requests().join(", ") }

// The window

test "the mail window shows once the game opens the mailbox, and goes when it closes" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Test.expect(!Test.page().window(MAIL).shown())
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  Test.expect(window.text("Bolts for you").shown())
  Game.mailObserver.open = false
  Test.expect(!window.shown())
}

test "the game's mailbox window stays open underneath, unseen and without the mouse, while ours shows" {
  const game = Client.CreateFrame("Frame", "MailFrame", Client.UIParent, nil)
  game.SetSize(300, 400)
  game.Show()
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  Test.flush()
  Test.expect(game.IsShown() && game.GetAlpha() == 0 && !game.IsMouseEnabled())
}

test "the inbox tab counts the letters, the footer the letters shown of those waiting" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  Test.expect(window.text("4 letters").shown())
  Test.expect(window.text("4 / 4").shown())
}

test "while more letters wait than the server shows, it is asked again a little later" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 60
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  Test.pass(16)
  Test.expect(asked().contains("Mailbox.check"))
}

// A letter's row

test "each row says its subject, its sender, what it carries and the days left" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  Test.expect(window.text("Bolts for you").item().text("Regy").shown())
  Test.expect(window.text("Pay for the sword").item().text("Cash on delivery").shown())
  Test.expect(window.text("Welcome").item().text("System").shown())
  Test.expect(drawnIn(window.text("Bolts for you").item().text("2 d"), RED))
}

test "the search finds a letter by an item it carries" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  window.input().type("wool")
  Test.expect(window.text("Bolts for you").shown())
  Test.expect(!window.text("Welcome").shown())
}

test "the view by kind puts the letters under their kinds' captions with the counts, which fold" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  window.button(Ordaen.art.ctl.tool.list).click()
  Test.page().window("By kind").button("By kind").click()
  Test.expect(window.text("From players (2)").shown())
  window.text("From players (2)").click()
  Test.expect(!window.text("Bolts for you").shown())
}

// Opening, taking, returning

test "a click opens the letter beside the list: its text read, its items as rewards, the game's sound" {
  let played = 0
  Client.PlaySound = (kit: Integer, channel: String | nil, once: Boolean | nil): (Boolean | nil, Unknown) => {
    played += 1
    return true, nil
  }
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  window.text("Bolts for you").click()
  Test.expect(asked().contains("Mailbox.text 2"))
  Test.expect(window.text("Wool Cloth").shown())
  Test.expect(window.button("Take all").shown())
  Test.expect(window.button("Return").shown())
  Test.expect(played == 1)
}

test "an attachment clicked is taken from its place" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  window.text("Bolts for you").click()
  _ = Test.requests()
  window.text("Wool Cloth").click()
  Test.expect(asked().contains("Mailbox.takeItem 2 3"))
}

test "Shift+click on a row takes everything from it, one thing at a time as the game reads the inbox again" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  Game.input.shiftDown = (): Boolean => true
  window.text("Bolts for you").click()
  Game.input.shiftDown = (): Boolean => false
  Game.input.controlDown = (): Boolean => false
  Test.expect(asked() == "Mailbox.takeItem 2 1")
  Game.mailbox.letters = (): Array<Game.MailLetter> => [letter(2, .Player, "Bolts for you", "Regy", 0, 0, 2, [item(3, 2592, "Wool Cloth", 5)])]
  Game.mailObserver.changed.emit()
  Test.expect(asked() == "Mailbox.takeItem 2 3")
}

test "«Take all» takes the money first and leaves cash on delivery and game masters' letters" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  window.button("Take all (2)").click()
  Test.expect(asked() == "Mailbox.takeMoney 1")
  Game.mailbox.letters = (): Array<Game.MailLetter> => letters().filter(l => l.index != 1)
  Game.mailObserver.changed.emit()
  Test.expect(asked() == "Mailbox.takeItem 2 1")
}

test "«Inventory is full» stops taking; «can't carry any more» skips that attachment" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  window.button("Take all (2)").click()
  _ = Test.requests()
  Game.mailbox.letters = (): Array<Game.MailLetter> => letters().filter(l => l.index != 1)
  Game.mailObserver.changed.emit()
  Test.expect(asked() == "Mailbox.takeItem 2 1")
  Game.mailObserver.refused.emit(Game.strings.itemMaxCount)
  Game.mailObserver.changed.emit()
  Test.expect(asked() == "Mailbox.takeItem 2 3")
  Game.mailObserver.refused.emit(Game.strings.inventoryFull)
  Game.mailObserver.changed.emit()
  Test.expect(asked() == "")
  Test.expect(window.text("Bags are full").shown())
}

test "taking leaves the bag slots the setting keeps free" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  Game.bags.free = 0
  Game.input.shiftDown = (): Boolean => true
  window.text("Bolts for you").click()
  Game.input.shiftDown = (): Boolean => false
  Game.input.controlDown = (): Boolean => false
  Test.expect(asked() == "")
}

test "an attachment that won't come is skipped after a few tries, never asked forever" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  Game.input.shiftDown = (): Boolean => true
  window.text("Bolts for you").click()
  Game.input.shiftDown = (): Boolean => false
  Game.input.controlDown = (): Boolean => false
  Game.mailObserver.changed.emit()
  Game.mailObserver.changed.emit()
  Game.mailObserver.changed.emit()
  Test.expect(asked().contains("Mailbox.takeItem 2 3"))
}

test "Ctrl+click returns a player's letter, and never the world's" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  Game.input.controlDown = (): Boolean => true
  window.text("Bolts for you").click()
  window.text("Welcome").click()
  Game.input.shiftDown = (): Boolean => false
  Game.input.controlDown = (): Boolean => false
  Test.expect(asked() == "Mailbox.giveBack 2")
}

test "cash on delivery asks before paying, and takes once paid" {
  Client.GetMoney = (): Number => 100000
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  window.text("Pay for the sword").click()
  window.button("Pay and take").click()
  const ask = Test.page().window("Pay 4g 0s 0c to take this letter's items?")
  _ = Test.requests()
  ask.button("Pay").click()
  Test.expect(asked() == "Mailbox.takeItem 3 1")
}

test "cash on delivery the player can't pay says so and takes nothing" {
  Client.GetMoney = (): Number => 10
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.bags.free = 20
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  _ = Test.requests()
  const window = Test.page().window(MAIL)
  window.text("Pay for the sword").click()
  _ = Test.requests()
  window.button("Pay and take").click()
  Test.expect(Test.page().window("You don't have the 4g 0s 0c this letter asks.").shown())
  Test.expect(asked() == "")
}

