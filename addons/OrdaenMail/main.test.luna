// Sending

test "«Write» opens the form; a recipient typed and «Send» puts the letter into the queue, which sends it" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailbox.waiting = (): integer => 4
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  _ = Test::requests()
  const window = Test::page().window(MAIL)
  window.text("Outbox").click()
  window.button("Write").click()
  window.input().nth(2).type("Regron")
  _ = Test::requests()
  window.button("Send").click()
  Test::expect(asked().contains("Mailbox.send Regron Money"))
  Test::expect(window.text("Sending").shown())
  Game::mailObserver.sent.emit()
  Test::expect(drawnIn(window.text("Regron").item().text("Sent"), GREEN))
}

test "an item the game's letter takes (Right-click in the bags) comes into the form as its stack, and goes with the letter" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  const window = Test::page().window(MAIL)
  window.text("Outbox").click()
  window.button("Write").click()
  window.input().nth(2).type("Regron")
  // The stack lies locked while it is in the game's letter, and free again once the form gave it back.
  let inLetter = true
  Game::bags.size = (bag: integer): integer => bag == 0 ? 4 : 0
  Game::bags.readSlot = (bag: integer, slot: integer, into: mut Game::SlotItem): boolean => {
    if (bag != 0 || slot != 2) { return false }
    into.id = 2589
    into.count = 20
    into.locked = inLetter
    return true
  }
  Client::GetSendMailItem = (place: integer): (string | nil, number | nil, number | nil, number | nil, number | nil) => {
    if (place == 1) { return ("Linen Cloth", 2589, 1, 20, 1) }
    return (nil, nil, nil, nil, nil)
  }
  Client::C_Item::GetItemNameByID = (id: string | integer): string | nil => id == 2589 ? "Linen Cloth" : nil
  Events::MAIL_SEND_INFO_UPDATE.emit()
  Client::GetSendMailItem = (place: integer): (string | nil, number | nil, number | nil, number | nil, number | nil) => {
    return (nil, nil, nil, nil, nil)
  }
  Test::expect(window.texts().join(" | ").contains("Attachments | 1 | Letters | 1"))
  inLetter = false
  _ = Test::requests()
  window.button("Send").click()
  Test::expect(asked().contains("Mailbox.send Regron Linen Cloth 2589x20"))
}

test "the form draws an empty slot, and an item from the bags let go on it goes into the letter" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  const window = Test::page().window(MAIL)
  window.text("Outbox").click()
  window.button("Write").click()
  // The four fields (to, subject, text, money) and the slot, the fourth drawn.
  Test::expect(window.box(SLOT_WELL).count() == 5)
  Client::C_Container::GetContainerItemInfo = (bag: integer, slot: integer): Client::ContainerItemInfo | nil => bag == 0 && slot >= 2 && slot <= 3 ?
    Client::ContainerItemInfo {
      iconFileID: 132889, stackCount: 20, isLocked: false, quality: .Common, isReadable: false, hasLoot: false,
      hyperlink: "item:2589", isFiltered: false, hasNoValue: false, itemID: 2589, isBound: false, itemName: "Linen Cloth"
    } :
    nil
  Game::bags.size = (bag: integer): integer => bag == 0 ? 4 : 0
  Game::bags.readSlot = (bag: integer, slot: integer, into: mut Game::SlotItem): boolean => {
    if (bag != 0 || slot < 2 || slot > 3) { return false }
    into.id = 2589
    into.count = 20
    into.locked = true
    return true
  }
  Client::C_Container::PickupContainerItem(0, 2)
  window.box(SLOT_WELL).nth(4).click()
  Test::expect(window.texts().join(" | ").contains("Attachments | 1 | Letters | 1"))
  Test::expect(window.box(SLOT_WELL).count() == 6)
  // Right-click in the bags (the item used) while the form writes: the game's letter takes it, the form after it.
  Test::inKey(() => Client::C_Container::UseContainerItem(0, 3, nil, nil, nil))
  Events::MAIL_SEND_INFO_UPDATE.emit()
  Test::expect(!Client::HasSendMailItem(1))
  Test::expect(window.texts().join(" | ").contains("Attachments | 2 | Letters | 1"))
}

test "«To» completes against every recipient in a popover: each name in its class's colour, who it is beside it" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  Client::C_FriendList::GetNumFriends = (): integer => 1
  Client::C_FriendList::GetFriendInfoByIndex = (index: integer): Client::FriendInfo | nil => {
    return {
      connected: true, name: "Regy", className: nil, area: nil, notes: nil, guid: "Player-1-2", level: 60, dnd: false,
      afk: false, rafLinkType: Client::RafLinkType::None
    }
  }
  Client::GetPlayerInfoByGUID = (guid: string): (string | nil, string | nil, string | nil, string | nil, number | nil, string | nil, string | nil, number | nil) => {
    return (nil, "WARRIOR", nil, nil, nil, nil, nil, nil)
  }
  Mail.sender.recent.write({ names: ["Regron", "Dorn"] })
  const window = Test::page().window(MAIL)
  window.text("Outbox").click()
  window.button("Write").click()
  Test::expect(!window.text("Anyone").shown() && !window.text("Friends").shown())
  window.input().nth(2).type("re")
  const popover = Test::page().window("Regron")
  Test::expect(popover.text("Friend").shown() && popover.text("Recent").shown() && !popover.text("Dorn").shown())
  Test::expect(drawnIn(popover.text("Regy"), classColor("WARRIOR") ?? panic("a class's colour")))
  popover.text("Regy").click()
  Test::expect(window.input().nth(2).value() == "Regy")
  Test::expect(!Test::page().text("Recent").shown())
}

test "«Send money» and «C.O.D.» are the form's tabs; the amount goes as cash on delivery on the second" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  const window = Test::page().window(MAIL)
  window.text("Outbox").click()
  window.button("Write").click()
  Test::expect(window.text("Send money").shown())
  window.text("C.O.D.").click()
  window.input().nth(2).type("Regron")
  window.input().nth(5).click()
  Test::erase(5)
  Test::type("5s")
  _ = Test::requests()
  window.button("Send").click()
  Test::expect(asked().contains("Mailbox.send Regron Money  0 500"))
}

test "the attachments and the letters a dim line each; the postage and «Send» in the column's marble footer; there is no «Clear»" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  const window = Test::page().window(MAIL)
  window.text("Outbox").click()
  window.button("Write").click()
  Test::expect(!window.button("Clear").shown())
  Test::expect(window.texts().join(" | ").contains("Attachments | 0 | Letters | 1 | Postage"))
  Test::shot("the form")
}

test "part of a stack is split off into an empty slot first, and the letter goes once the bags hold it" {
  Test::mount(nil, PAGE)
  Game::mailbox.letters = letters
  Game::bags.free = 20
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  // Twenty Linen Cloth in 0/2, the rest empty; once split, five lie in 0/1.
  let split = false
  Game::bags.size = (bag: integer): integer => bag == 0 ? 4 : 0
  Game::bags.readSlot = (bag: integer, slot: integer, into: mut Game::SlotItem): boolean => {
    if (bag != 0) { return false }
    into.id = 2589
    into.locked = false
    if (slot == 2) {
      into.count = split ? 15 : 20
      return true
    }
    if (slot == 1 && split) {
      into.count = 5
      return true
    }
    return false
  }
  let asks = ""
  Game::bags.split = (fromBag: integer, fromSlot: integer, count: integer, toBag: integer, toSlot: integer): boolean => {
    asks = `${fromBag}/${fromSlot} ${count} into ${toBag}/${toSlot}`
    return true
  }
  _ = Test::requests()
  Mail.sender.put("Regron", "Cloth", "", [{ bag: 0, slot: 2, item: 2589, count: 5 }], 0, 0)
  Test::expect(asks == "0/2 5 into 0/1")
  Test::expect(!asked().contains("Mailbox.send"))
  split = true
  Game::bags.changed.emit()
  Test::expect(asked().contains("Mailbox.send Regron Cloth 2589x5"))
}

test "«Don't accept trades at the mailbox» sets the game's own setting while it is open, and puts it back" {
  let said = ""
  Client::C_CVar::GetCVar = (name: string): string | nil => "0"
  Client::C_CVar::SetCVar = (name: string, value: string | nil): boolean => {
    said += `${name}=${value ?? ""};`
    return true
  }
  Test::mount(nil, PAGE)
  Mail.settings.values.blockTrades = true
  Game::mailbox.letters = letters
  Game::mailObserver.open = true
  Game::mailObserver.opened.emit()
  Game::mailObserver.open = false
  Test::flush()
  Test::expect(said == "blockTrades=1;blockTrades=0;")
}

