// The mail window as the player meets it: the game opens the mailbox, the window lists its letters, and the player
// picks, ticks, filters, searches and changes the view. The root is drawn on the screen as Ordaen draws it; the inbox
// is also mounted alone, where what its buttons ask for is heard.
import Game from "$game"
import { Art } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { ARTWORK } from "Ordaen"
import type { Alts } from "OrdaenAlts"
import root Mail from "OrdaenMail"
import { Inbox } from "@/inbox"
import { Sent, SentState } from "@/letters"
import { OwnTab } from "@/own"

const PAGE: Test.Page = { left: 20, top: 20, width: 1300, height: 720, screen: true }
const AREA: Test.Page = { left: 20, top: 20, width: 1000, height: 600 }
// A text the mail window always shows: its third tab.
const MAIL = "To my characters"
// The colours a text is to be drawn in.
const RED: Color = Color.hex("#ff4040")
const DIM: Color = Color.hex("#a3977f")
const ORANGE: Color = Color.hex("#ff9a30")
const GREEN: Color = Color.hex("#40d060")
const INK: Color = Color.hex("#e8dcc4")
const GOLD: Color = Color.hex("#ffd100")

function letters(): Array<Game.MailLetter> {
  return [
    {
      index: 1, kind: Game.MailKind.Auction, subject: "Auction successful: Linen Cloth", sender: "Auction House", copper: 12500,
      cod: 0, days: 29, items: []
    },
    {
      index: 2, kind: Game.MailKind.Player, subject: "Bolts for you", sender: "Regy", copper: 0, cod: 0, days: 2,
      items: [{ item: 2589, name: "Linen Cloth", count: 20 }, { item: 2592, name: "Wool Cloth", count: 5 }]
    },
    {
      index: 3, kind: Game.MailKind.Player, subject: "Pay for the sword", sender: "Dorn", copper: 0, cod: 40000, days: 10,
      items: [{ item: 12, name: "Sword", count: 1 }]
    },
    { index: 4, kind: Game.MailKind.System, subject: "Welcome", sender: "", copper: 0, cod: 0, days: 30, items: [] }
  ]
}

// Whether a text is drawn in this colour.
function drawnIn(part: Test.Part, color: Color): Boolean {
  const ink = part.textColor()
  return (ink.r * 255).round() == (color.r * 255).round() &&
    (ink.g * 255).round() == (color.g * 255).round() &&
    (ink.b * 255).round() == (color.b * 255).round()
}

// A choice picked from a toolbar button's list: the button by the glyph it shows, then the choice in the list that
// holds `among`.
function pick(window: Test.Part, button: Art, among: String, choice: String) {
  window.button(button).click()
  Test.page().window(among).button(choice).click()
}

function filter(window: Test.Part, choice: String) {
  pick(window, Ordaen.art.ctl.tool.filter, "With items", choice)
}

// The subjects of the rows the list shows, in order.
function subjects(window: Test.Part): Array<String> {
  return letters().map(l => l.subject).filter(s => window.text(s).shown())
}

// Whether both texts are shown in the part, the first drawn before the second.
function before(part: Test.Part, first: String, second: String): Boolean {
  const texts = part.texts()
  let a = 0
  let b = 0
  for (i, text of texts) {
    if (text == first && a == 0) { a = i }
    if (text == second && b == 0) { b = i }
  }
  return a > 0 && b > 0 && a < b
}

// What the inbox's buttons asked for.
class Heard {
  collected: String = ""
  times: Integer = 0
  returned: Integer = 0
  constructor(inbox: Inbox) {
    inbox.collect.listen(self.onCollect)
    inbox.giveBack.listen(self.onGiveBack)
  }

  onCollect(mut self, list: Array<Integer>) {
    self.collected = list.map(i => String.of(i)).join(",")
    self.times += 1
  }

  onGiveBack(mut self, index: Integer) { self.returned = index }
}

// The cells a component under test is given.
class Fixture {
  state letters: Array<Game.MailLetter> = letters()
  state total = 4
  state yes = true
  state alts: Alts | nil = nil
}

// The window

test "the mail window shows once the game opens the mailbox" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Test.expect(!Test.page().window(MAIL).shown())
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  Test.expect(Test.page().window(MAIL).text("Bolts for you").shown())
}

test "the mail window goes when the mailbox closes" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  Game.mailObserver.open = false
  Test.expect(!window.shown())
}

test "the window shut by the player stays shut, and shows again when the mailbox is opened again" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!window.shown())
  Game.mailObserver.opened.emit()
  Test.expect(window.shown())
}

test "the inbox tab counts the letters" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  Test.expect(window.text("Inbox (4)").shown())
}

test "the list follows the letters the game reports while the mailbox is open" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  Game.mailbox.letters = (): Array<Game.MailLetter> => [
    { index: 5, kind: Game.MailKind.Player, subject: "Ore", sender: "Kel", copper: 0, cod: 0, days: 5, items: [] },
    { index: 6, kind: Game.MailKind.Player, subject: "Wool", sender: "Kel", copper: 0, cod: 0, days: 5, items: [] }
  ]
  Game.mailObserver.changed.emit()
  Test.expect(!window.text("Bolts for you").shown())
  Test.expect(window.text("Ore").shown())
  Test.expect(window.text("Inbox (2)").shown())
}

test "the inbox says how many letters the mailbox holds when more wait than are shown" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 6
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  Test.expect(Test.page().window(MAIL).text("Letters in the mailbox: 6").shown())
}

test "the inbox says nothing of letters waiting when it shows them all" {
  Test.mount(nil, PAGE)
  Game.mailbox.letters = letters
  Game.mailbox.waiting = (): Integer => 4
  Game.mailObserver.open = true
  Game.mailObserver.opened.emit()
  const window = Test.page().window(MAIL)
  Test.expect(!window.text("Letters in the mailbox: 4").shown())
}

