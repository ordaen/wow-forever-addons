// «Inbox»: the letters in the mailbox, narrowed by a filter and a search and sorted, in one of three views (one list,
// by kind under captions that fold with their counts, a table whose headings sort), with «Take all (N)» over them.
// A row: its checkbox, the sender's kind as the icon, the subject with the sender under it, what is attached (the first
// items' icons, the money, «COD» and the price), the days left (red under 3). Hovering a row lists the sender and every
// attachment. Left-click opens a letter; Shift+Left-click takes everything from it; Ctrl+Left-click returns a player's
// letter; Shift+click on a checkbox ticks the range from the last ticked. While letters are being taken the list takes
// no clicks.
import Game from "$game"
import { Align, Art, Modifier, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { ARTWORK, ButtonPlate, Choice, Column, Component, FoldCaption, ItemButton, ModuleMemory, Money, PickRow, PushButton, SECONDARY_TEXT, ScrolledList, Table, TableCell, TableRow, Tick, Tip, TipRow, ToolPick, ToolSort, Toolbar } from "Ordaen"
import { Filter, URGENT_DAYS, View, collectable, matches } from "@/letters"
import Locale from "@/locales"
import Style from "@/style"

// How the player left the inbox's list: its filter, its view and its sort.
public struct InboxView implements Plain {
  filter: Filter = Filter::All
  view: View = View::List
  sorted: Integer = 0
  descending: Boolean = false
}
const INBOX_VIEW: InboxView = {}

// The sender's kind as a row's icon: a player's letter, the auction house's, the world's.
const PLAYER_ICON: Art = "Interface/Icons/INV_Letter_15"
const AUCTION_ICON: Art = "Interface/Icons/INV_Misc_Coin_02"
const SYSTEM_ICON: Art = "Interface/Icons/INV_Letter_18"
// How many of a letter's items its row shows.
const FIRST_ITEMS = 3
const ICON = 32.8125dp
const SMALL = 28.125dp

const FILTERS: Array<Choice<Filter>> = [
  { value: Filter::All, label: Locale::FILTER_ALL },
  { value: Filter::Players, label: Locale::FILTER_PLAYERS },
  { value: Filter::Auction, label: Locale::FILTER_AUCTION },
  { value: Filter::System, label: Locale::FILTER_SYSTEM },
  { value: Filter::Money, label: Locale::FILTER_MONEY },
  { value: Filter::Items, label: Locale::FILTER_ITEMS }
]
const VIEWS: Array<Choice<View>> = [
  { value: View::List, label: Locale::VIEW_LIST, icon: ARTWORK.ctl.tool.list },
  { value: View::Categories, label: Locale::VIEW_CATEGORIES, icon: ARTWORK.ctl.tool.categories },
  { value: View::Table, label: Locale::VIEW_TABLE, icon: ARTWORK.ctl.tool.table }
]
const COLUMNS: Array<Column> = [
  { title: Locale::COL_SUBJECT, width: { fr: 3 }, sortable: true },
  { title: Locale::COL_FROM, width: { fr: 2 }, sortable: true },
  { title: Locale::COL_ATTACHED, width: 152.34375dp },
  { title: Locale::COL_DAYS, width: 82.03125dp, align: Align::End, sortable: true }
]
const ROW: Array<Track> = ["max-content", ICON, { fr: 1 }, "max-content", 63.28125dp]
const TOP: Array<Track> = [{ fr: 1 }, "max-content"]
const PAGE: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
const TICKED: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
const KINDS: Array<Game::MailKind> = [Game::MailKind::Auction, Game::MailKind::Player, Game::MailKind::System]

// The letters of one kind, under their caption.
public struct Group {
  kind: Game::MailKind
  title: String
  letters: Array<Game::MailLetter>
}

// What the row's click asks: open it, take everything from it, return it.
public enum RowClick { Open = "open", Take = "take", Return = "return" }

// By the days the row says: «3 d» is red whatever part of the fourth day is left.
public function daysColor(letter: Game::MailLetter): Color { return letter.days.floor() <= URGENT_DAYS ? Style::RED : Style::DIM }

public function daysText(letter: Game::MailLetter): String {
  return letter.days < 1 ? Locale::LESS_THAN_A_DAY : Locale::DAYS_LEFT.format(letter.days.floor())
}

public function senderOf(letter: Game::MailLetter): String { return letter.sender == "" ? Locale::SYSTEM_SENDER : letter.sender }

function kindIcon(kind: Game::MailKind): Art {
  return match (kind) {
    Game::MailKind::Player => PLAYER_ICON
    Game::MailKind::Auction => AUCTION_ICON
    Game::MailKind::System => SYSTEM_ICON
  }
}

function attachedText(letter: Game::MailLetter): String {
  const parts: Array<String> = []
  if (letter.items.length > 0) { parts.push(Locale::ITEMS_COUNT.format(letter.items.length)) }
  if (letter.copper > 0) { parts.push(Game::money.format(letter.copper)) }
  if (letter.cod > 0) { parts.push(`${Locale::COD} ${Game::money.format(letter.cod)}`) }
  return parts.join(", ")
}

// A row's tooltip: the sender, then every attachment and the money.
function tipRows(letter: Game::MailLetter): Array<TipRow> {
  const rows: Array<TipRow> = []
  for (item of letter.items) { rows.push({ label: item.name, value: String::of(item.count) }) }
  if (letter.copper > 0) { rows.push({ label: Locale::MONEY, value: Game::money.format(letter.copper) }) }
  if (letter.cod > 0) { rows.push({ label: Locale::COD_AMOUNT, value: Game::money.format(letter.cod) }) }
  return rows
}

// What a click on a table's row asks, by the keys held (the table's row hears every press).
function clickOf(): RowClick {
  if (Game::input.shiftDown()) { return .Take }
  if (Game::input.controlDown()) { return .Return }
  return .Open
}

const ROW_KEYS: Array<String> = [Locale::KEY_OPEN, Locale::KEY_TAKE, Locale::KEY_RETURN]

public class LetterRow implements Component {
  public clicked: Event<(Integer, RowClick)> = new Event()
  public tick: Event<Integer> = new Event()

  state hovered = false
  state checked = false
  derived on: Boolean = self.picked == self.letter.index
  derived shownItems: Array<Game::MailItem> = self.firstOf()
  derived more: Integer = self.letter.items.length - self.shownItems.length
  derived hasMore: Boolean = self.more > 0
  derived hasMoney: Boolean = self.letter.copper > 0
  derived hasCod: Boolean = self.letter.cod > 0
  derived rows: Array<TipRow> = tipRows(self.letter)
  derived subjectInk: Color = self.letter.read ? Style::DIM : Style::INK

  letter: Signal<Game::MailLetter>
  picked: Signal<Integer>
  ticked: Signal<Array<Integer>>
  busy: Signal<Boolean>
  constructor(letter: Signal<Game::MailLetter>, picked: Signal<Integer>, ticked: Signal<Array<Integer>>, busy: Signal<Boolean>) {
    self.letter = letter
    self.picked = picked
    self.ticked = ticked
    self.busy = busy
    watch (value of self.ticked) { self.syncChecked() }
    watch (value of self.checked) { self.tickChanged() }
  }

  firstOf(self): Array<Game::MailItem> {
    const list: Array<Game::MailItem> = []
    for (item of self.letter.items) {
      if (list.length < FIRST_ITEMS) { list.push(item) }
    }
    return list
  }

  onPick(mut self) {
    if (self.busy) { return }
    self.clicked.emit(self.letter.index, .Open)
  }

  // Shift takes everything from the letter; Ctrl returns it.
  onModified(mut self, key: Modifier) {
    if (self.busy) { return }
    self.clicked.emit(self.letter.index, key == .Shift ? .Take : .Return)
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  // The list ticked a letter (or a range): the box follows.
  syncChecked(mut self) {
    const on = (peek self.ticked).any(i => i == self.letter.index)
    if (on != peek self.checked) { self.checked = on }
  }

  // The player ticked the box: the list is told if it doesn't hold it so yet.
  tickChanged(self) {
    if (self.checked != (peek self.ticked).any(i => i == self.letter.index)) { self.tick.emit(self.letter.index) }
  }

  public render(self): Template {
    return $ltml {
      <box @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <PickRow columns={ROW} picked={self.on} @pick={self.onPick} @modified={self.onModified}>
          <Tick value={mut self.checked} />
          <box width={ICON} height={ICON} icon={kindIcon(self.letter.kind)} />
          <box columns={1}>
            <text value={self.letter.subject} textColor={self.subjectInk} wrap={.None} />
            <text value={senderOf(self.letter)} textSize={SECONDARY_TEXT} textColor={Style::DIM} wrap={.None} />
          </box>
          <box columns={{ each: "max-content" }} gap={1sp} yAlign={Align::Center}>
            <ItemButton $for={item of self.shownItems} $key={item.place} item={item.item} count={item.count} size={SMALL}
                        mail={[self.letter.index, item.place]} />
            <text $if={self.hasMore} value={"+%d"} arguments={[self.more]} textColor={Style::DIM} wrap={.None} />
            <Money $if={self.hasMoney} amount={self.letter.copper} />
            <text $if={self.hasCod} value={Locale::COD} textColor={Style::ORANGE} wrap={.None} />
            <Money $if={self.hasCod} amount={self.letter.cod} color={Style::ORANGE} />
          </box>
          <box xAlign={Align::End}>
            <text value={daysText(self.letter)} textColor={daysColor(self.letter)} wrap={.None} />
          </box>
        </PickRow>
        <Tip $if={self.hovered} title={senderOf(self.letter)} text={self.letter.subject} rows={self.rows} keys={ROW_KEYS} />
      </box>
    }
  }
}

public class LetterTableRow implements Component {
  public clicked: Event<(Integer, RowClick)> = new Event()

  derived on: Boolean = self.picked == self.letter.index

  letter: Signal<Game::MailLetter>
  picked: Signal<Integer>
  busy: Signal<Boolean>
  constructor(letter: Signal<Game::MailLetter>, picked: Signal<Integer>, busy: Signal<Boolean>) {
    self.letter = letter
    self.picked = picked
    self.busy = busy
  }

  onPick(mut self) {
    if (self.busy) { return }
    self.clicked.emit(self.letter.index, clickOf())
  }

  public render(self): Template {
    return $ltml {
      <TableRow selected={self.on} @pick={self.onPick}>
        <TableCell> <text value={self.letter.subject} textColor={Style::INK} wrap={.Cut} /> </TableCell>
        <TableCell> <text value={senderOf(self.letter)} textColor={Style::DIM} wrap={.Cut} /> </TableCell>
        <TableCell> <text value={attachedText(self.letter)} textColor={Style::DIM} wrap={.Cut} /> </TableCell>
        <TableCell align={Align::End}> <text value={daysText(self.letter)} textColor={daysColor(self.letter)} wrap={.None} /> </TableCell>
      </TableRow>
    }
  }
}

// A kind's caption in the view by kind: it folds its letters away.
public class KindCaption implements Component {
  public fold: Event<Game::MailKind> = new Event()

  derived shut: Boolean = self.folded[self.group.kind] == true

  group: Signal<Group>
  folded: Signal<Map<Game::MailKind, Boolean>>
  constructor(group: Signal<Group>, folded: Signal<Map<Game::MailKind, Boolean>>) {
    self.group = group
    self.folded = folded
  }

  onToggle(mut self) { self.fold.emit(self.group.kind) }

  public render(self): Template {
    return $ltml { <FoldCaption title={self.group.title} folded={self.shut} @toggled={self.onToggle} /> }
  }
}

public class Inbox implements Component {
  // A row clicked: the letter and what the click asks.
  public clicked: Event<(Integer, RowClick)> = new Event()
  // «Take all»: the letters the filter and the search show.
  public takeAll: Event<Array<Game::MailLetter>> = new Event()
  // The ticked letters' «Take» and «Return».
  public takeTicked: Event<nil> = new Event()
  public returnTicked: Event<nil> = new Event()

  state search = ""
  // How the player left the list, the profile's (`ModuleMemory`); the search isn't kept.
  public list: mut ModuleMemory<InboxView> = new ModuleMemory<InboxView>(INBOX_VIEW, .Profile, "inbox")
  state folded: mut Map<Game::MailKind, Boolean> = {}
  derived shown: Array<Game::MailLetter> = self.shownOf()
  derived groups: Array<Group> = self.groupsOf()
  derived count: Integer = self.shown.count(collectable)
  derived takeLabel: String = Locale::TAKE_ALL.format(self.count)
  derived empty: Boolean = self.shown.length == 0
  derived inList: Boolean = self.list.values.view == View::List
  derived inGroups: Boolean = self.list.values.view == View::Categories
  derived narrowed: Boolean = self.list.values.filter != Filter::All
  derived nothingToTake: Boolean = self.busy || self.count == 0
  derived hasTicked: Boolean = self.ticked.length > 0

  letters: Signal<Array<Game::MailLetter>>
  picked: Signal<Integer>
  ticked: mut Signal<Array<Integer>>
  busy: Signal<Boolean>
  constructor(letters: Signal<Array<Game::MailLetter>>, picked: Signal<Integer>, ticked: mut Signal<Array<Integer>>, busy: Signal<Boolean>) {
    self.letters = letters
    self.picked = picked
    self.ticked = ticked
    self.busy = busy
  }

  // The letters the filter and the search keep, in the order sorted (the inbox's own where none is).
  shownOf(self): Array<Game::MailLetter> {
    const filter = self.list.values.filter
    const search = self.search
    const list = self.letters.filter(l => matches(l, filter, search))
    const column = self.list.values.sorted
    const down = self.list.values.descending
    if (column == 0) { return list }
    list.sort((a, b) => {
      if (column == 1) { return down ? a.subject > b.subject : a.subject < b.subject }
      if (column == 2) { return down ? senderOf(a) > senderOf(b) : senderOf(a) < senderOf(b) }
      return down ? a.days > b.days : a.days < b.days
    })
    return list
  }

  groupsOf(self): Array<Group> {
    const list: Array<Group> = []
    for (kind of KINDS) {
      const part = self.shown.filter(l => l.kind == kind)
      if (part.length > 0) {
        const title = match (kind) {
          Game::MailKind::Auction => Locale::GROUP_AUCTION
          Game::MailKind::Player => Locale::GROUP_PLAYERS
          Game::MailKind::System => Locale::GROUP_SYSTEM
        }
        list.push({ kind: kind, title: "%s (%d)".format(title, part.length), letters: self.folded[kind] == true ? [] : part })
      }
    }
    return list
  }

  isTicked(self, index: Integer): Boolean { return self.ticked.any(i => i == index) }

  onClicked(mut self, index: Integer, click: RowClick) { self.clicked.emit(index, click) }

  onFold(mut self, kind: Game::MailKind) { self.folded[kind] = !(self.folded[kind] == true) }

  // A tick turns one letter on or off; with Shift it ticks every letter shown from the last ticked to this one.
  onTick(mut self, index: Integer) {
    if (self.isTicked(index)) {
      self.ticked = (peek self.ticked).filter(i => i != index)
      return
    }
    const held = peek self.ticked
    const last = held[held.length]
    const next: Array<Integer> = held.map(i => i)
    if (Game::input.shiftDown() && last != nil) {
      let inside = false
      for (letter of peek self.shown) {
        const edge = letter.index == last || letter.index == index
        if (edge) { inside = !inside }
        if ((inside || edge) && !next.any(i => i == letter.index)) { next.push(letter.index) }
      }
      self.ticked = next
      return
    }
    next.push(index)
    self.ticked = next
  }

  onTakeAll(mut self) { self.takeAll.emit(self.shown.filter(collectable)) }
  onTakeTicked(mut self) { self.takeTicked.emit() }
  onReturnTicked(mut self) { self.returnTicked.emit() }

  public render(self): Template {
    return $ltml {
      <box rows={PAGE} gap={3sp}>
        <box columns={TOP} gap={2sp} yAlign={Align::Center}>
          <Toolbar search={mut self.search} placeholder={Locale::SEARCH}>
            <ToolPick value={mut self.list.values.filter} choices={FILTERS} icon={Ordaen.art.ctl.tool.filter}
                      title={Locale::FILTER} lit={self.narrowed} />
            <ToolSort sorted={mut self.list.values.sorted} columns={COLUMNS} title={Locale::SORT} />
            <ToolPick value={mut self.list.values.view} choices={VIEWS} icon={Ordaen.art.ctl.tool.columns} title={Locale::VIEW} />
          </Toolbar>
          <PushButton label={self.takeLabel} width={Style::WIDE_BUTTON} plate={ButtonPlate::Accent} disabled={self.nothingToTake}
                      @click={self.onTakeAll} />
        </box>
        <box $if={self.empty} xAlign={Align::Center} yAlign={Align::Center}>
          <text value={Locale::NOTHING_FOUND} textColor={Style::DIM} />
        </box>
        <ScrolledList $elseif={self.inList} columns={1}>
          <LetterRow $for={letter of self.shown} $key={letter.index} letter={letter} picked={self.picked}
                     ticked={self.ticked} busy={self.busy} @clicked={self.onClicked} @tick={self.onTick} />
        </ScrolledList>
        <ScrolledList $elseif={self.inGroups} columns={1} gap={2sp}>
          <box $for={group of self.groups} $key={group.kind} columns={1} gap={1sp}>
            <KindCaption group={group} folded={self.folded} @fold={self.onFold} />
            <LetterRow $for={letter of group.letters} $key={letter.index} letter={letter} picked={self.picked}
                       ticked={self.ticked} busy={self.busy} @clicked={self.onClicked} @tick={self.onTick} />
          </box>
        </ScrolledList>
        <Table $else columns={COLUMNS} sorted={mut self.list.values.sorted} descending={mut self.list.values.descending} rowsVary={true}>
          <LetterTableRow $for={letter of self.shown} $key={letter.index} letter={letter} picked={self.picked}
                          busy={self.busy} @clicked={self.onClicked} />
        </Table>
        <box $if={self.hasTicked} columns={TICKED} gap={2sp} yAlign={Align::Center}>
          <PushButton label={Locale::RETURN_TICKED.format(self.ticked.length)} width={Style::BUTTON} disabled={self.busy}
                      @click={self.onReturnTicked} />
          <box />
          <PushButton label={Locale::TAKE_TICKED.format(self.ticked.length)} width={Style::BUTTON} plate={ButtonPlate::Accent}
                      disabled={self.busy} @click={self.onTakeTicked} />
        </box>
        <box $else />
      </box>
    }
  }
}
