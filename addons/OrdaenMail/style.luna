// The mail window's look: its size at the player's scale and the colours of what a letter says. A text's size is a
// step of the ladder (`$ltml`'s `TextSize`).

public const WIDTH: Number<Length> = 1406.25dp
public const HEIGHT: Number<Length> = 703.125dp
public const LIST: Number<Length> = 726.5625dp
public const GAP: Number<Spacing> = 3sp

public const INK: Color = Color.hex("#e8dcc4")
public const DIM: Color = Color.hex("#a3977f")
public const GOLD: Color = Color.hex("#ffd100")
public const RED: Color = Color.hex("#ff4040")
public const GREEN: Color = Color.hex("#40d060")
public const ORANGE: Color = Color.hex("#ff9a30")
public const BACK: Color = Color.hex("#00000066")
public const PICKED: Color = Color.hex("#ffd10026")
