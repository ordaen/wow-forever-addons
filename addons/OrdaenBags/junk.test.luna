test "the merchant's window sells the bags' junk from its right column, saying what it brings" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Client.CanGuildBankRepair = (): Boolean => false
  Client.UnitName = (unit: String): (String, String) => {
    return "Tharynn", ""
  }
  Test.mount(nil, SCREEN)
  // The merchant opens the bags with its window, as the game's does: the two stand side by side.
  Game.bags.open = true
  Game.bags.place = Game.BagPlace.Merchant
  Events.MERCHANT_SHOW.emit()
  Test.flush()
  Test.expect(bags().rect().left > Test.page().window("Tharynn").rect().right)
  _ = Test.requests()
  Test.page().window("Tharynn").button(`${Locale.SELL_JUNK} ${Game.money.format(30)}`).click()
  Test.expect(Test.requests().join(", ").contains("Bags.send 0 1"))
}

// The clicks

test "the client's secure use stands on the scheme's chord for Use: the left in ours, the right as in the game" {
  Test.expect(actionAt(OURS, .Left) == SlotAction.Use)
  Test.expect(actionAt(OURS, .Right) == SlotAction.Menu)
  const ours = useClickOf(OURS)
  Test.expect(ours.chord == MouseButton.Left)
  const game = useClickOf(AS_THE_GAME)
  Test.expect(game.chord == MouseButton.Right)
  const moved = useClickOf({ left: .Menu, shiftRight: .Use, ..OURS }).chord
  Test.expect(moved is [Modifier, MouseButton] && moved[1] == Modifier.Shift && moved[2] == MouseButton.Right)
  Test.expect(chordFor(OURS, .Protect) == nil && chordFor(AS_THE_GAME, .Protect) == Chord.AltLeft)
}

test "Shift+left set to Pick up picks the item up, and the right opens the menu, which offers no pick up: neither is the client's use" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Bags.settings.change((values: mut Choices): nil => { values.slotPresses = { shiftLeft: .Pickup, ..values.slotPresses } })
  _ = Test.requests()
  Test.hold([.Shift])
  Game.input.shiftDown = (): Boolean => true
  Test.hold([.Shift])
  bags().button(CLOTH).click()
  Test.expect(Test.performed().length == 0 && Test.requests().join(", ").contains("Bags.pickup 0 3"))
  Test.hold([])
  Game.input.shiftDown = (): Boolean => false
  Test.hold([])
  bags().button(CLOTH).rightClick()
  Test.expect(Test.performed().length == 0 && Test.page().text("Mark as junk").shown())
  Test.expect(Test.page().text("Link in chat").shown() && !Test.page().text("Pick up").shown())
}

test "a chord's row holding the last Use or the last Menu offers nothing else" {
  Test.expect(choicesFor(OURS, .Left).length == 1 && choicesFor(OURS, .Right).length == 1)
  Test.expect(choicesFor(OURS, .ShiftLeft).length == 7)
}

test "Alt+click and Ctrl+click do nothing in Ordaen's scheme: protecting is the slot menu's" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  _ = Test.requests()
  Test.hold([.Ctrl])
  Game.input.controlDown = (): Boolean => true
  bags().button(CLOTH).click()
  Test.hold([.Alt])
  Game.input.controlDown = (): Boolean => false
  Game.input.altDown = (): Boolean => true
  bags().button(CLOTH).click()
  Test.hold([])
  Game.input.altDown = (): Boolean => false
  Test.expect(!Test.requests().join(", ").contains("Bags.pickup") && Test.performed().length == 0)
  bags().button(CLOTH).rightClick()
  Test.expect(Test.page().text(Locale.MENU_PROTECT).shown())
}

// The bank

test "the bank opens in a window of its own beside the bags', its slots read and picked up as the bags' are" {
  const world = new World(carried())
  world.items.push({ bag: BANK, slot: 2, id: 1206, name: "Moss Agate", icon: GEM, kind: 7 })
  Client.C_Bank.FetchPurchasedBankTabData = (kind: Client.BankType): Array<Client.BankTabData> => [{
    ID: BANK, bankType: .Character, name: "", icon: BANK_TAB, depositFlags: .DisableAutoSort, tabCleanupConfirmation: "",
    tabNameEditBoxHeader: ""
  }]
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Game.bankObserver.open = true
  // Two windows: the bags' with the bags alone, and the bank's.
  Test.expect(bags().button(SWORD).shown() && !bags().button(GEM).shown() && !bags().text(Locale.BANK).shown())
  Test.expect(bank().button(GEM).shown() && !bank().button(SWORD).shown())
  Bags.settings.change((values: mut Choices): nil => { values.slotPresses = { shiftLeft: .Pickup, ..values.slotPresses } })
  _ = Test.requests()
  Game.input.shiftDown = (): Boolean => true
  Test.hold([.Shift])
  bank().button(GEM).click()
  Test.expect(Test.requests().join(", ").contains("Bags.pickup 6 2"))
}

test "away from the banker the bank is a tab of the bags' window: what it held, said to be a copy, not used" {
  const world = new World(carried())
  world.items.push({ bag: BANK, slot: 2, id: 1206, name: "Moss Agate", icon: GEM, kind: 7 })
  Client.C_Bank.FetchPurchasedBankTabData = (kind: Client.BankType): Array<Client.BankTabData> => [{
    ID: BANK, bankType: .Character, name: "", icon: BANK_TAB, depositFlags: .DisableAutoSort, tabCleanupConfirmation: "",
    tabNameEditBoxHeader: ""
  }]
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  // Not seen yet: the tab says how it will be.
  bags().text(Locale.BANK).click()
  Test.expect(bags().text(Locale.BANK_UNSEEN).shown())
  bags().text(Locale.TITLE).click()
  Game.bankObserver.open = true
  Test.flush()
  Game.bankObserver.open = false
  bags().text(Locale.BANK).click()
  Test.expect(bags().button(GEM).shown() && bags().text(Locale.BANK_COPY).shown())
  _ = Test.requests()
  Game.input.shiftDown = (): Boolean => true
  Test.hold([.Shift])
  bags().button(GEM).click()
  Test.expect(!Test.requests().join(", ").contains("Bags.pickup"))
}

test "what changes in the bank is read once the client's batch of updates ends" {
  const world = new World(carried())
  Client.C_Bank.FetchPurchasedBankTabData = (kind: Client.BankType): Array<Client.BankTabData> => [{
    ID: BANK, bankType: .Character, name: "", icon: BANK_TAB, depositFlags: .DisableAutoSort, tabCleanupConfirmation: "",
    tabNameEditBoxHeader: ""
  }]
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Game.bankObserver.open = true
  Test.expect(!bank().button(GEM).shown())
  world.items.push({ bag: BANK, slot: 1, id: 1206, name: "Moss Agate", icon: GEM, kind: 7 })
  Game.bankObserver.changed.emit()
  Test.expect(!bank().button(GEM).shown())
  Events.BAG_UPDATE_DELAYED.emit()
  Test.expect(bank().button(GEM).shown())
}

test "the bank shut, its window goes and the bags' window has the bank's tab again" {
  Client.C_Bank.FetchPurchasedBankTabData = (kind: Client.BankType): Array<Client.BankTabData> => []
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Game.bankObserver.open = true
  Test.expect(!bags().text(Locale.BANK).shown() && Test.page().window(Locale.BANK).shown())
  Game.bankObserver.open = false
  Test.expect(bags().text(Locale.BANK).shown() && bags().button(SWORD).shown())
}

test "a scheme saved before the left click used is let go: Ordaen's own, with its left click's use, stands in its place" {
  const old: Map<String, Unknown> = {}
  old["left"] = "nothing"
  old["doubleLeft"] = "use"
  old["shiftLeft"] = "pickup"
  old["ctrlLeft"] = "send"
  old["right"] = "menu"
  const kept: Map<String, Unknown> = {}
  kept["slotClicks"] = old
  kept["slotSize"] = 50
  const settings: Map<String, Unknown> = {}
  settings["OrdaenBags"] = kept
  const account: Map<String, Unknown> = {}
  account["settings"] = settings
  Test.saved("LunaTypeDB", account)
  Test.reload()
  const clicks = Bags.settings.values.slotPresses
  Test.expect(clicks.left == SlotAction.Use && clicks.shiftLeft == SlotAction.Nothing)
  Test.expect(useClickOf(clicks).chord == MouseButton.Left)
}

test "a mark is the character's: there after a reload, not for another character" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(CLOTH).rightClick()
  Test.page().button("Mark as junk").click()
  Test.reload()
  Test.expect(bags().button(CLOTH).paintedWith(COIN))
  Test.login({ guid: "Player-1-0000002", name: "Alt", surname: nil })
  Test.expect(!bags().button(CLOTH).paintedWith(COIN))
}

test "an item crafting takes is a trade good whatever its class; junk stays junk" {
  // A feather: the client's miscellany (15), marked used for crafting.
  Test.expect(tabOf(15, true, nil) == Tab.Trade && tabOf(15, false, nil) == Tab.Other)
  Test.expect(tabOf(15, true, .Grey) == Tab.Junk)
}
