// Junk as the player meets it: the verdict's order (a mark, then what was learned, then the rules), the rules on their
// own, what a sale by hand teaches and how far, the caps of the lists; the coin on a junk slot, the slot's menu and its
// marks, «Sell junk» at a merchant; the slot's clicks in the player's scheme; the bank in the bags' window.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Art, Modifier, MouseButton } from "$ltml"
import Test from "$test"
import root Bags from "OrdaenBags"
import { AS_THE_GAME, Chord, OURS, SlotAction, actionAt, choicesFor, chordFor, useClickOf } from "@/clicks"
import {
  JUNK_RULES, JunkLists, LEARNED, MOST_LEARNED, MOST_MARKS, Mark, NO_LISTS, Why, afterBuyback, afterSale, junkWhy, shareOf,
  withMark, withScore
} from "@/junk"
import Locale from "@/locales"
import { Tab, tabOf } from "@/model"
import { Choices } from "@/pane"

// The player's screen: 2470 by 1054.
const SCREEN: Test.Page = { left: 0, top: 0, width: 2470, height: 1054, screen: true }
const FOOT: FileId = 133854
const SWORD: FileId = 135274
const CLOTH: FileId = 132889
const GEM: FileId = 134134
const COIN: Asset = "Interface/MoneyFrame/UI-GoldIcon"
const UPGRADE_ARROW: Atlas = "bags-greenarrow"
const BANK_TAB: FileId = 133639
// The bank's first tab, as the client numbers its container (`Enum.BagIndex.CharacterBankTab_1`).
const BANK = 6

// One stack, as the game reads it.
struct Lies {
  bag: Integer
  slot: Integer
  const id: Integer
  const name: String
  const icon: FileId
  count: Integer = 1
  const quality: Integer = 1
  const kind: Integer = 15
  const subkind: Integer = 0
  const level: Integer = 1
  const price: Integer = 10
  const worn: String = ""
  // Whether the client has the item's own info yet: its level and price are 0 till then.
  loaded: Boolean = true
  const questItem: Boolean = false
  const startsQuest: Boolean = false
}

// What lies in the bags and the bank, as the test's fakes read it.
class World {
  items: mut Array<mut Lies>
  // The backpack's slots, then the bank's first tab's.
  constructor(items: mut Array<mut Lies>) { self.items = items }

  public size(self, bag: Integer): Integer { return bag == 0 ? 16 : bag == BANK ? 4 : 0 }

  public bag(self, bag: Integer): Game.BagInfo {
    return { bag: bag, item: nil, name: bag == 0 ? "Backpack" : "", icon: nil, slots: self.size(bag), general: true }
  }

  public read(self, bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean {
    const item = self.items.find(lying => lying.bag == bag && lying.slot == slot)
    if (item == nil) {
      into.id = 0
      return false
    }
    into.id = item.id
    into.count = item.count
    into.quality = item.quality
    into.name = item.name
    into.link = `[${item.name}]`
    into.level = item.loaded ? item.level : 0
    into.kind = item.kind
    into.subkind = item.subkind
    into.subkindName = "Kind"
    into.worn = item.worn
    into.bound = false
    into.locked = false
    into.isNew = false
    into.price = item.loaded ? item.price : 0
    into.loaded = item.loaded
    into.questItem = item.questItem
    into.startsQuest = item.startsQuest
    return true
  }

  public icon(self, id: Integer): Art | nil { return self.items.find(lying => lying.id == id)?.icon }

  // The stack taken out (sold).
  public take(mut self, bag: Integer, slot: Integer) {
    let at = 0
    for (index, item of self.items) {
      if (item.bag == bag && item.slot == slot) { at = index }
    }
    _ = self.items.remove(at)
  }
}

// A rabbit's foot (grey, with a price), a sword and some cloth in the backpack.
function carried(): mut Array<mut Lies> {
  return [
    { bag: 0, slot: 1, id: 3300, name: "Rabbit's Foot", icon: FOOT, count: 3, quality: 0 },
    { bag: 0, slot: 2, id: 25, name: "Worn Shortsword", icon: SWORD, kind: 2, subkind: 7 },
    { bag: 0, slot: 3, id: 2589, name: "Linen Cloth", icon: CLOTH, count: 20, kind: 7 }
  ]
}

function bags(): Test.Part {
  return Test.page().window(Locale.TITLE)
}

// The bank's window, at a banker.
function bank(): Test.Part {
  return Test.page().window(Locale.BANK)
}

// An item as a rule reads it.
function goods(quality: Integer, kind: Integer, level: Integer, price: Integer, worn: String, subkind: Integer): Game.SlotItem {
  return {
    id: 7, count: 1, quality: quality, icon: nil, name: "", link: "", level: level, kind: kind, subkind: subkind,
    subkindName: "", worn: worn, bound: false, locked: false, isNew: false, price: price
  }
}

// The verdict

test "a grey item a merchant buys is junk; one he gives nothing for, or the rule off, isn't" {
  Test.expect(junkWhy(goods(0, 15, 1, 10, "", 0), NO_LISTS, JUNK_RULES) == Why.Grey)
  Test.expect(junkWhy(goods(0, 15, 1, 0, "", 0), NO_LISTS, JUNK_RULES) == nil)
  Test.expect(junkWhy(goods(1, 15, 1, 10, "", 0), NO_LISTS, JUNK_RULES) == nil)
  Test.expect(junkWhy(goods(0, 15, 1, 10, "", 0), NO_LISTS, { grey: false, ..JUNK_RULES }) == nil)
}

test "grey gear is junk only above the level the setting says; a tabard, a shirt and a fishing pole never by a rule" {
  Test.expect(junkWhy(goods(0, 2, 10, 10, "", 7), NO_LISTS, JUNK_RULES) == nil)
  Test.expect(junkWhy(goods(0, 2, 11, 10, "", 7), NO_LISTS, JUNK_RULES) == Why.Grey)
  Test.expect(junkWhy(goods(0, 4, 11, 10, "", 1), NO_LISTS, JUNK_RULES) == Why.Grey)
  Test.expect(junkWhy(goods(0, 4, 30, 10, "INVTYPE_TABARD", 0), NO_LISTS, JUNK_RULES) == nil)
  Test.expect(junkWhy(goods(0, 4, 30, 10, "INVTYPE_BODY", 0), NO_LISTS, JUNK_RULES) == nil)
  Test.expect(junkWhy(goods(0, 2, 30, 10, "", 20), NO_LISTS, JUNK_RULES) == nil)
}

test "the player's mark decides first: «not junk» beats the rules, «junk» makes anything junk; then what was learned" {
  const grey = goods(0, 15, 1, 10, "", 0)
  const white = goods(1, 15, 1, 10, "", 0)
  Test.expect(junkWhy(grey, withMark(NO_LISTS, 7, .Keep), JUNK_RULES) == nil)
  Test.expect(junkWhy(white, withMark(NO_LISTS, 7, .Junk), JUNK_RULES) == Why.Marked)
  Test.expect(junkWhy(white, withScore(NO_LISTS, 7, 0.6), JUNK_RULES) == Why.Learned)
  Test.expect(junkWhy(white, withScore(NO_LISTS, 7, LEARNED), JUNK_RULES) == nil)
  Test.expect(junkWhy(white, withScore(withMark(NO_LISTS, 7, .Keep), 7, 0.9), JUNK_RULES) == nil)
  // A mark taken away leaves the rules to decide.
  Test.expect(junkWhy(grey, withMark(withMark(NO_LISTS, 7, .Keep), 7, nil), JUNK_RULES) == Why.Grey)
}

// Learning

test "a sale moves the score toward 1 by the share of a stack, a buyback twice as far back" {
  Test.expect((afterSale(0, 1) - 0.382).abs() < 0.0001)
  Test.expect((afterSale(0.382, 1) - 0.618076).abs() < 0.0001)
  Test.expect((afterSale(0, shareOf(5, 20)) - 0.0955).abs() < 0.0001)
  Test.expect((afterBuyback(0.6, 1) - 0.1416).abs() < 0.0001)
  Test.expect(shareOf(40, 20) == 1 && shareOf(1, 0) == 1)
}

test "a score below the tenth is forgotten, and past the cap the lowest leaves" {
  Test.expect(withScore(NO_LISTS, 7, 0.09).learned[7] == nil)
  let lists: JunkLists = NO_LISTS
  for (id of 1..MOST_LEARNED) { lists = withScore(lists, id, 0.2 + id / 1000) }
  lists = withScore(lists, 5000, 0.9)
  Test.expect(lists.learned[1] == nil && lists.learned[2] != nil && lists.learned[5000] != nil)
}

test "past the cap of marks the one given longest ago leaves" {
  let lists: JunkLists = NO_LISTS
  for (id of 1..MOST_MARKS) { lists = withMark(lists, id, .Junk) }
  // The first marked is marked again: the second is the oldest now.
  lists = withMark(lists, 1, .Keep)
  lists = withMark(lists, 5000, .Junk)
  Test.expect(lists.marks[1]?.mark == Mark.Keep && lists.marks[2] == nil && lists.marks[5000] != nil)
}

// The window

test "a junk slot carries a coin, and the «Junk» tab counts it" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().button(FOOT).paintedWith(COIN) && !bags().button(SWORD).paintedWith(COIN))
  Test.expect(bags().button("Junk").texts().join(" | ") == "Junk | 1")
}

test "a grey item read before the client loaded it is judged again once it is: the coin comes" {
  const lying = carried()
  const foot = lying[1] ?? panic("the foot")
  foot.loaded = false
  const world = new World(mut lying)
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(!bags().button(FOOT).paintedWith(COIN))
  foot.loaded = true
  Game.bags.loaded.emit(3300)
  Test.expect(bags().button(FOOT).paintedWith(COIN))
}

test "a quest's item carries the game's quest border, one that starts a quest not yet taken its «!»" {
  const world = new World([
    { bag: 0, slot: 1, id: 3300, name: "Rabbit's Foot", icon: FOOT, questItem: true },
    { bag: 0, slot: 2, id: 25, name: "Worn Shortsword", icon: SWORD, questItem: true, startsQuest: true },
    { bag: 0, slot: 3, id: 2589, name: "Linen Cloth", icon: CLOTH, kind: 7 }
  ])
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  const border: Asset = "Interface/ContainerFrame/UI-Icon-QuestBorder"
  const bang: Asset = "Interface/ContainerFrame/UI-Icon-QuestBang"
  Test.expect(bags().button(FOOT).paintedWith(border) && !bags().button(FOOT).paintedWith(bang))
  Test.expect(bags().button(SWORD).paintedWith(bang) && !bags().button(SWORD).paintedWith(border))
  Test.expect(!bags().button(CLOTH).paintedWith(border) && !bags().button(CLOTH).paintedWith(bang))
}

test "gear worth more to the player's spec than what it wears carries the game's green arrow; the rest none" {
  const world = new World([
    { bag: 0, slot: 1, id: 3300, name: "Rabbit's Foot", icon: FOOT, count: 3, quality: 0 },
    { bag: 0, slot: 2, id: 25, name: "Worn Shortsword", icon: SWORD, kind: 4, subkind: 1 }
  ])
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  // The priest wears nothing on its hands; the gloves give intellect.
  Client.C_Item.GetItemInfoInstant = (item: String | Integer): (Number | nil, String | nil, String | nil, String | nil, FileId | nil, Number | nil, Number | nil) => {
    return 25, "Armor", "Cloth", "INVTYPE_HAND", nil, 4, 1
  }
  let given: Map<String, Number> = {}
  given["ITEM_MOD_INTELLECT_SHORT"] = 10
  Client.C_Item.GetItemStats = (link: String): Unknown => given
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().button(SWORD).paintedWith(UPGRADE_ARROW) && !bags().button(FOOT).paintedWith(UPGRADE_ARROW))
}

test "the right click opens the slot's menu, and «Not junk» takes the item out of junk at once, with a line in the chat" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  _ = Test.printed()
  bags().button(FOOT).rightClick()
  Test.expect(Test.page().text("Junk: a grey item a merchant buys").shown())
  Test.page().button("Not junk").click()
  Test.expect(!bags().button(FOOT).paintedWith(COIN) && bags().text("Junk").item().texts().join(" | ") == "Junk | 0")
  Test.expect(Test.printed().join("/") == "|cffe8c35aInventory:|r [Rabbit's Foot]: not junk.")
}

test "«Mark as junk» makes any item junk, and «As the rules decide» takes the mark away" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(CLOTH).rightClick()
  Test.page().button("Mark as junk").click()
  Test.expect(bags().button(CLOTH).paintedWith(COIN))
  bags().button(CLOTH).rightClick()
  Test.page().button("As the rules decide").click()
  Test.expect(!bags().button(CLOTH).paintedWith(COIN))
}

test "a sale by hand at a merchant is said in the chat, and two of a full stack make the item junk" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Game.bags.place = Game.BagPlace.Merchant
  Game.bags.send = (bag: Integer, slot: Integer): Boolean => {
    Test.asked("Bags.send", bag, slot)
    return true
  }
  _ = Test.printed()
  _ = Test.requests()
  // The client's coin bag over a slot at a merchant, as the game's own bags show it.
  bags().button(CLOTH).hover()
  Test.expect(Test.cursor() == "BUY_CURSOR")
  bags().button(CLOTH).click()
  // Sold by the bags themselves: the client's secure use would equip what can be worn.
  Test.expect(Test.performed().length == 0 && Test.requests().join(", ").contains("Bags.send 0 3"))
  world.take(0, 3)
  Game.bags.updated.emit(0)
  Test.expect(!bags().button(CLOTH).shown())
  world.items.push({ bag: 0, slot: 3, id: 2589, name: "Linen Cloth", icon: CLOTH, count: 20, kind: 7 })
  Game.bags.updated.emit(0)
  Test.expect(!bags().button(CLOTH).paintedWith(COIN))
  bags().button(CLOTH).click()
  world.take(0, 3)
  Game.bags.updated.emit(0)
  world.items.push({ bag: 0, slot: 3, id: 2589, name: "Linen Cloth", icon: CLOTH, count: 20, kind: 7 })
  Game.bags.updated.emit(0)
  Test.expect(bags().button(CLOTH).paintedWith(COIN))
}

test "a click that sold nothing teaches nothing" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Game.bags.place = Game.BagPlace.Merchant
  _ = Test.printed()
  bags().button(CLOTH).click()
  Game.bags.updated.emit(0)
  Test.expect(Test.printed().length == 0)
}

test "«Sell junk» shows at a merchant while there is junk, and sells it in the click" {
  const world = new World(carried())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(!bags().button("Sell junk").shown())
  Game.bags.place = Game.BagPlace.Merchant
  _ = Test.requests()
  bags().button("Sell junk").click()
  Test.expect(Test.requests().join(", ") == "Bags.send 0 1")
