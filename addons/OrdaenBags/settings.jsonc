// Ordaen Bags' settings (docs/reference/settings.md). Behaviour only: its look follows the theme.
{
  "db": "OrdaenBagsDB",
  "title": "SETTINGS_TITLE",
  "sections": [
    {
      "header": "HEADER_WINDOW",
      "settings": {
        // categories (tabs and sections) or each bag's slots in order; the window's grid button switches it too
        "view": {
          "type": "choice",
          "choices": [
            { "id": "categories", "label": "VIEW_CATEGORIES" },
            { "id": "bags", "label": "VIEW_BAGS" }
          ],
          "default": "categories",
          "label": "VIEW"
        },
        "columns": {
          "type": "number", "min": 4, "max": 24, "step": 1, "default": 10,
          "label": "COLUMNS", "tooltip": "COLUMNS_TOOLTIP"
        },
        // the order inside each section, picked in the window's dropdown
        "sort": {
          "type": "choice",
          "choices": [
            { "id": "bags", "label": "SORT_BAGS" },
            { "id": "quality", "label": "SORT_QUALITY" },
            { "id": "name", "label": "SORT_NAME" },
            { "id": "ilvl", "label": "SORT_ILVL" },
            { "id": "count", "label": "SORT_COUNT" },
            { "id": "type", "label": "SORT_TYPE" }
          ],
          "default": "bags",
          "label": "SORT"
        }
      }
    },
    {
      // The tabs on the window's left ("All" always shows): one off leaves the sidebar, its items stay in "All".
      "header": "HEADER_TABS",
      "settings": {
        "hideEmpty": { "type": "boolean", "default": false, "label": "HIDE_EMPTY", "tooltip": "HIDE_EMPTY_TOOLTIP" },
        "tabs.equipment": { "type": "boolean", "default": true, "label": "TAB_EQUIPMENT" },
        "tabs.consumables": { "type": "boolean", "default": true, "label": "TAB_CONSUMABLES" },
        "tabs.tradegoods": { "type": "boolean", "default": true, "label": "TAB_TRADEGOODS" },
        "tabs.recipes": { "type": "boolean", "default": true, "label": "TAB_RECIPES" },
        "tabs.quest": { "type": "boolean", "default": true, "label": "TAB_QUEST" },
        "tabs.junk": { "type": "boolean", "default": true, "label": "TAB_JUNK" },
        "tabs.other": { "type": "boolean", "default": true, "label": "TAB_OTHER" }
      }
    }
  ]
}
