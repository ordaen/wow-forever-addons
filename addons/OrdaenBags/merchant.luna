// The merchant's window, in place of the game's while a merchant is open: two tabs, the merchant's goods and what the
// player sold it this visit (its buyback), and the right column beside them, always there: the player's money, «Sell
// junk» with what the bags' junk brings, the repairs where the merchant repairs. The goods: every item at once in two
// columns that scroll (no pages), by the merchant's list, by category, or as a table; the search, the sort and the
// filter dim nothing but leave out what doesn't fit; the footer counts what shows. An item's right click buys one
// purchase, Shift+Left-click asks how many, Shift+Right-click puts its link into the chat; a price at or past the game's
// asking price (15 gold) or one paid in items or currencies is asked first, as the game asks. The buyback's click buys
// the item back.
import Game from "$game"
import { Align, Art, Columns, Event, MouseButton, Overflow, Track } from "$ltml"
import root Ordaen from "Ordaen"
import {
  ARTWORK, Choice, Column, Component, CountInput, Dialog, ItemButton, KeptWindow, ModuleMemory, Money, PushButton, SECONDARY_TEXT,
  Table, TableRow, ToolPick, Toolbar, Window, WindowSide, WindowTabSpec, space, tracksOf
} from "Ordaen"
import { SLOT } from "@/layout"
import Locale from "@/locales"
import { KINDS, Tab } from "@/model"
import { tabName } from "@/sections"
import { Sold, Vendor, Ware } from "@/vendor"

// How the goods show: two columns in the merchant's order, by category, or as a table.
public enum WareView implements Plain { List = "list", Categories = "categories", Table = "table" }
public enum WareSort implements Plain { Merchant = "merchant", Name = "name", Price = "price", Usable = "usable" }
public enum WareFilter implements Plain { All = "all", Usable = "usable", Affordable = "affordable" }

// How the player left the merchant's window, the profile's: the view, the sort, the filter, the table's column (0: the
// merchant's order) and its way. The search isn't kept.
public struct MerchantView implements Plain {
  view: WareView = WareView.List
  sort: WareSort = WareSort.Merchant
  filter: WareFilter = WareFilter.All
  sorted: Integer = 0
  descending: Boolean = false
}
public const MERCHANT_VIEW: MerchantView = {}

// A purchase waiting for the player's word: the item, and how many (nil: one purchase of the merchant's stack).
struct Purchase {
  const ware: Ware
  const count: Integer | nil
}

// The game's own price past which a purchase is asked first (`MERCHANT_HIGH_PRICE_COST`).
const HIGH_PRICE = 1500000
const INK: Color = Color.hex("#e8dcc4")
const DIM: Color = Color.hex("#a3977f")
const RED: Color = Color.hex("#ff4040")
const CAPTION: Color = Color.hex("#e8c35a")
// The tabs' icons, the client's own: a merchant's coins, and the game's buyback icon.
const VENDOR_ICON: Asset = "Interface/Icons/INV_Misc_Coin_02"
const BUYBACK_ICON: Asset = "Interface/MerchantFrame/UI-BuyBack-Icon"
const COST_ICON = 16.40625dp
const MARK = 14.0625dp
// A table row: an item's slot and the row's padding round it.
const TABLE_SLOT = 28.125dp
const TABLE_ROW: Number<Length> = TABLE_SLOT + 2 * space(.Line)
const TABLE_CELL: Array<Track> = [TABLE_SLOT, { fr: 1 }]
const SIDE_WIDTH = 234.375dp
const DIALOG = 375dp
const BUTTON = 140.625dp
const CELL: Array<Track> = [SLOT, { fr: 1 }]
const PAIR: Array<Track> = [{ fr: 1 }, "max-content"]
const BODY: Array<Track> = ["max-content", { fr: 1 }]
const FILL: Array<Track> = [{ fr: 1 }]
const SIDE: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
const COST: Array<Track> = ["max-content", "max-content"]
// The money, then each part of what it costs besides.
const PRICE: Columns = { each: "max-content" }
const VIEWS: Array<Choice<WareView>> = [
  { value: WareView.List, label: Locale.VIEW_LIST, icon: ARTWORK.ctl.tool.list },
  { value: WareView.Categories, label: Locale.VIEW_CATEGORIES, icon: ARTWORK.ctl.tool.categories },
  { value: WareView.Table, label: Locale.VIEW_TABLE, icon: ARTWORK.ctl.tool.table }
]
const SORTS: Array<Choice<WareSort>> = [
  { value: WareSort.Merchant, label: Locale.SORT_MERCHANT },
  { value: WareSort.Name, label: Locale.SORT_NAME },
  { value: WareSort.Price, label: Locale.SORT_PRICE },
  { value: WareSort.Usable, label: Locale.SORT_USABLE }
]
const FILTERS: Array<Choice<WareFilter>> = [
  { value: WareFilter.All, label: Locale.FILTER_ALL },
  { value: WareFilter.Usable, label: Locale.FILTER_USABLE },
  { value: WareFilter.Affordable, label: Locale.FILTER_AFFORDABLE }
]
const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_ITEM, width: { fr: 1 }, sortable: true },
  { title: Locale.COLUMN_TYPE, width: 93.75dp, sortable: true },
  { title: Locale.COLUMN_LEVEL, width: 56.25dp, align: Align.End, sortable: true },
  { title: Locale.COLUMN_IN_BAGS, width: 93.75dp, align: Align.End, sortable: true },
  { title: Locale.COLUMN_PRICE, width: 117.1875dp, align: Align.End, sortable: true }
]
const TRACKS: Array<Track> = tracksOf(COLUMNS)

// Whether the item stays in the list: its name holds the search, and the filter keeps it.
function kept(ware: Ware, filter: WareFilter, query: String, money: Integer): Boolean {
  if (query != "" && !ware.name.lower().contains(query)) { return false }
  return match (filter) {
    .All => true
    .Usable => ware.usable
    .Affordable => ware.price <= money
  }
}

// Whether `a` stands before `b` by the sort; the merchant's order where they are alike.
function before(a: Ware, b: Ware, sort: WareSort): Boolean {
  match (sort) {
    .Name => {
      if (a.name != b.name) { return a.name < b.name }
    }
    .Price => {
      if (a.price != b.price) { return a.price < b.price }
    }
    .Usable => {
      if (a.usable != b.usable) { return a.usable }
    }
    .Merchant => {}
  }
  return a.index < b.index
}

// The table's order: by its column (1 the name, 2 the type, 3 the level, 4 how many the bags hold, 5 the price), the
// merchant's where they are alike or none is picked.
function tableBefore(a: Ware, b: Ware, column: Integer, descending: Boolean): Boolean {
  const ka = columnKey(a, column)
  const kb = columnKey(b, column)
  if (ka != kb) { return descending ? kb < ka : ka < kb }
  return a.index < b.index
}

function columnKey(ware: Ware, column: Integer): String {
  return match (column) {
    1 => ware.name
    2 => ware.kind
    3 => "%08d".format(ware.level)
    4 => "%08d".format(Game.items.inBags(ware.id))
    5 => "%012d".format(ware.price)
    else => ""
  }
}

// What a purchase of `count` items costs in money (nil: one purchase of the merchant's stack).
function moneyFor(ware: Ware, count: Integer | nil): Integer {
  if (count == nil) { return ware.price }
  return (ware.price * count / ware.stack).ceil()
}

// How many of the item one purchase of the player's choosing takes at most: the merchant's most at once, and what the
// player's money pays for.
function mostFor(ware: Ware, money: Integer): Integer {
  if (ware.price <= 0) { return ware.most }
  return ware.most.min((money * ware.stack / ware.price).floor())
}

// The line under an item's name: how many the merchant has left, and how many the bags hold.
function stockLine(ware: Ware, carried: Integer): String {
  const held = carried > 0 ? Locale.IN_BAGS.format(carried) : ""
  if (ware.available < 0) { return held }
  const left = Locale.LEFT.format(ware.available)
  return held == "" ? left : `${left} · ${held}`
}

// What a purchase costs besides money: each part, with its icon.
class CostTag implements Component {
  icon: Signal<Art | nil>
  amount: Signal<Integer>
  constructor(icon: Signal<Art | nil>, amount: Signal<Integer>) {
    self.icon = icon
    self.amount = amount
  }

  public render(self): Template {
    return $ltml {
      <box columns={COST} gap={2.34375dp} yAlign={Align.Center}>
        <text value={"%d"} arguments={[self.amount]} textColor={INK} textFont={.Numbers} wrap={false} />
        <box width={COST_ICON} height={COST_ICON} icon={self.icon} />
      </box>
    }
  }
}

// One of the merchant's items: its slot, its name, its price and what it costs besides, and what is left of it.
class WareCell implements Component {
  public pressed: Event<(Ware, Event.Press)> = new Event()

  derived dear: Boolean = self.ware.price > Game.money.amount
  derived priceColor: Color = self.dear ? RED : INK
  derived nameColor: Color = self.ware.usable && self.ware.purchasable ? INK : RED
  derived priced: Boolean = self.ware.price > 0
  derived stock: String = stockLine(self.ware, Game.items.inBags(self.ware.id))

  ware: Signal<Ware>
  constructor(ware: Signal<Ware>) { self.ware = ware }

  onPressed(self, click: Event.Press) { self.pressed.emit(self.ware, click) }

  public render(self): Template {
    return $ltml {
      <box columns={CELL} gap={space(.Item)} yAlign={Align.Center}>
        <ItemButton item={self.ware.id} art={self.ware.icon} count={self.ware.stack} quality={self.ware.quality}
                    size={SLOT} linkOnShift={false} @pressed={self.onPressed} />
        <box columns={1} overflow={Overflow.Hidden}>
          <text value={self.ware.name} textColor={self.nameColor} wrap={false} />
          <box columns={PRICE} gap={space(.Line)} yAlign={Align.Center}>
            <Money $if={self.priced} amount={self.ware.price} color={self.priceColor} />
            <box $else />
            <CostTag $for={cost of self.ware.costs} icon={cost.icon} amount={cost.amount} />
          </box>
          <text value={self.stock} textColor={DIM} textSize={SECONDARY_TEXT} wrap={false} />
        </box>
      </box>
    }
  }
}

// One item of the buyback: its slot, its name, what buying it back costs.
class SoldCell implements Component {
  public pressed: Event<Sold> = new Event()

  derived nameColor: Color = self.sold.usable ? INK : RED

  sold: Signal<Sold>
  constructor(sold: Signal<Sold>) { self.sold = sold }

  onPressed(self) { self.pressed.emit(self.sold) }

  public render(self): Template {
    return $ltml {
      <box columns={CELL} gap={space(.Item)} yAlign={Align.Center}>
        <ItemButton item={nil} art={self.sold.icon} count={self.sold.count} size={SLOT} linkOnShift={false}
                    @pressed={self.onPressed} />
        <box columns={1} overflow={Overflow.Hidden}>
          <text value={self.sold.name} textColor={self.nameColor} wrap={false} />
          <Money amount={self.sold.price} />
        </box>
      </box>
    }
  }
}

// A category's caption in the categories view: across both columns, its name and how many of its items show; a
// click folds it.
class WareCaption implements Component {
  public toggled: Event<Tab> = new Event()
  derived title: String = "%s (%d)".format(tabName(self.tab), self.count)
  derived mark: Art = self.folded ? Ordaen.art.ctl.markClosed : Ordaen.art.ctl.markOpen

  const tab: Tab
  count: Signal<Integer>
  folded: Signal<Boolean>
  constructor(tab: Tab, count: Signal<Integer>, folded: Signal<Boolean>) {
    self.tab = tab
    self.count = count
    self.folded = folded
  }

  onToggle(self) { self.toggled.emit(self.tab) }

  public render(self): Template {
    return $ltml {
      <box columns={COST} gap={space(.Line)} columnSpan={2} yAlign={Align.Center} @pointerPress={self.onToggle}
           @keyPress(.Enter)={self.onToggle} @keyPress(.Space)={self.onToggle}>
        <box width={MARK} height={MARK} background={self.mark} />
        <text value={self.title} textColor={CAPTION} wrap={false} />
      </box>
    }
  }
}

// One item as a row of the table.
class WareTableRow implements Component {
  public pressed: Event<(Ware, MouseButton)> = new Event()

  derived carried: Integer = Game.items.inBags(self.ware.id)
  derived dear: Boolean = self.ware.price > Game.money.amount
  derived priceColor: Color = self.dear ? RED : INK
  derived nameColor: Color = self.ware.usable && self.ware.purchasable ? INK : RED

  ware: Signal<Ware>
  constructor(ware: Signal<Ware>) { self.ware = ware }

  onPick(self, button: MouseButton) { self.pressed.emit(self.ware, button) }
  onSlot(self, click: Event.Press) { self.pressed.emit(self.ware, click.button) }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={TRACKS} height={TABLE_ROW} @pick={self.onPick}>
        <box columns={TABLE_CELL} gap={space(.Item)} yAlign={Align.Center}>
          <ItemButton item={self.ware.id} art={self.ware.icon} count={self.ware.stack} quality={self.ware.quality}
                      size={TABLE_SLOT} linkOnShift={false} @pressed={self.onSlot} />
          <box overflow={Overflow.Hidden}>
            <text value={self.ware.name} textColor={self.nameColor} wrap={false} />
          </box>
        </box>
        <box overflow={Overflow.Hidden}>
          <text value={self.ware.kind} textColor={DIM} wrap={false} />
        </box>
        <box xAlign={Align.End}>
          <text value={"%d"} arguments={[self.ware.level]} textColor={INK} textFont={.Numbers} wrap={false} />
        </box>
        <box xAlign={Align.End}>
          <text value={"%d"} arguments={[self.carried]} textColor={INK} textFont={.Numbers} wrap={false} />
        </box>
        <box xAlign={Align.End}>
          <Money amount={self.ware.price} color={self.priceColor} />
        </box>
      </TableRow>
    }
  }
}

public class MerchantWindow implements Component {
  // «Sell junk» in the right column: the bags sell their junk.
  public sellJunk: Event<nil> = new Event()

  state tab = 1
  state search = ""
  state folded: Map<Tab, Boolean> = {}
  // The purchase asked about, and the item whose count is being chosen with the count chosen.
  state asking: Purchase | nil = nil
  state counting: Ware | nil = nil
  state count = 1

  derived tabs: Array<WindowTabSpec> = [
    { title: self.vendor.name == "" ? Locale.MERCHANT : self.vendor.name, desc: nil, icon: VENDOR_ICON },
    { title: Locale.BUYBACK, desc: nil, icon: BUYBACK_ICON }
  ]
  derived buying: Boolean = self.tab == 1
  derived query: String = self.search.lower()
  derived shown: Array<Ware> = self.shownOf()
  derived tabled: Boolean = self.list.values.view == WareView.Table
  derived grouped: Boolean = self.list.values.view == WareView.Categories
  derived narrowed: Boolean = self.list.values.filter != WareFilter.All
  derived groups: Array<Tab> = KINDS.filter(tab => self.shown.any(ware => ware.tab == tab))
  // The buyback, the newest first.
  derived sold: Array<Sold> = self.soldOf()
  derived countText: String = self.countTextOf()
  derived side: WindowSide | nil = { width: SIDE_WIDTH, content: self.column }
  derived junkLabel: String = self.junkWorth > 0 ? `${Locale.SELL_JUNK} ${Game.money.format(self.junkWorth)}` : Locale.SELL_JUNK
  derived repairLabel: String = self.vendor.worn ? `${Locale.REPAIR_ALL} ${Game.money.format(self.vendor.repairCost)}` : Locale.REPAIR_ALL
  derived canRepair: Boolean = self.vendor.worn && self.vendor.repairCost <= Game.money.amount
  derived guildRepair: Boolean = self.vendor.repairs && self.vendor.guildRepairs && self.vendor.worn
  derived askTitle: String = self.askTitleOf()
  derived askCosts: String = self.askCostsOf()
  derived countMost: Integer = self.counting == nil ? 1 : mostFor(self.counting ?? panic("counting"), Game.money.amount)
  derived countPrice: Integer = self.counting == nil ? 0 : moneyFor(self.counting ?? panic("counting"), self.count)

  vendor: Vendor
  declared: mut KeptWindow
  list: mut ModuleMemory<MerchantView>
  junkCount: Signal<Integer>
  junkWorth: Signal<Integer>
  constructor(
    vendor: Vendor,
    declared: mut KeptWindow,
    list: mut ModuleMemory<MerchantView>,
    junkCount: Signal<Integer>,
    junkWorth: Signal<Integer>
  ) {
    self.vendor = vendor
    self.declared = declared
    self.list = list
    self.junkCount = junkCount
    self.junkWorth = junkWorth
  }

  shownOf(self): Array<Ware> {
    const view = self.list.values
    const money = Game.money.amount
    let wares = self.vendor.wares.filter(ware => kept(ware, view.filter, self.query, money))
    if (view.view == WareView.Table) {
      wares.sort((a, b) => tableBefore(a, b, view.sorted, view.descending))
    } else {
      wares.sort((a, b) => before(a, b, view.sort))
    }
    return wares
  }

  soldOf(self): Array<Sold> {
    let sold: Array<Sold> = []
    for (index of self.vendor.sold.length..1 step -1) { sold.push(self.vendor.sold[index] ?? panic("within the buyback")) }
    return sold
  }

  countTextOf(self): String {
    if (!self.buying) { return Locale.SOLD_COUNT.format(self.vendor.sold.length) }
    const all = self.vendor.wares.length
    const shown = self.shown.length
    return shown == all ? Locale.WARES.format(all) : Locale.WARES_OF.format(shown, all)
  }

  // The items of a category, as the categories view shows them: none while it is folded.
  inGroup(self, tab: Tab): Array<Ware> {
    if (self.folded[tab] == true) { return [] }
    return self.shown.filter(ware => ware.tab == tab)
  }

  countIn(self, tab: Tab): Integer { return self.shown.count(ware => ware.tab == tab) }

  askTitleOf(self): String {
    const asking = self.asking
    if (asking == nil) { return "" }
    const count = asking.count ?? asking.ware.stack
    const price = moneyFor(asking.ware, asking.count)
    const named = count > 1 ? `${asking.ware.name} ×${count}` : asking.ware.name
    return price > 0 ? Locale.ASK_BUY.format(named, Game.money.format(price)) : Locale.ASK_BUY_COSTS.format(named)
  }

  askCostsOf(self): String {
    const asking = self.asking
    if (asking == nil) { return "" }
    return asking.ware.costs.map(cost => `${cost.amount} ${cost.name}`).join(", ")
  }

  // A click on an item, in the player's own call: Right buys one purchase (asked first where the game asks),
  // Shift+Right links it, Shift+Left asks how many.
  onWare(mut self, ware: Ware, click: Event.Press) {
    const shift = Game.input.shiftDown()
    if (click.button == MouseButton.Right) {
      if (shift) {
        Game.chat.link(ware.id)
      } else {
        self.purchase(ware, nil)
      }
    } else if (click.button == MouseButton.Left && shift && ware.most > 1) {
      self.count = 1
      self.counting = ware
    }
  }

  onWareRow(mut self, ware: Ware, button: MouseButton) {
    if (button == MouseButton.Right) { self.purchase(ware, nil) }
  }

  // A purchase: bought at once, or asked about first where its price reaches the game's asking price or it is paid
  // in items or currencies.
  purchase(mut self, ware: Ware, count: Integer | nil) {
    if (ware.costs.length > 0 || moneyFor(ware, count) >= HIGH_PRICE) {
      self.asking = { ware: ware, count: count }
      return
    }
    self.vendor.buy(ware, count)
  }

  onAsked(mut self) {
    const asking = peek self.asking
    self.asking = nil
    if (asking != nil) { self.vendor.buy(asking.ware, asking.count) }
  }

  onAskCancel(mut self) { self.asking = nil }

  onCounted(mut self) {
    const ware = peek self.counting
    self.counting = nil
    if (ware != nil) { self.purchase(ware, peek self.count) }
  }

  onCountCancel(mut self) { self.counting = nil }

  onSold(self, sold: Sold) { self.vendor.buyBack(sold) }

  onToggle(mut self, tab: Tab) {
    let folded: Map<Tab, Boolean> = {}
    for (each, shut of peek self.folded) { folded[each] = shut }
    folded[tab] = folded[tab] == true ? nil : true
    self.folded = folded
  }

  onSellJunk(self) { self.sellJunk.emit() }
  onRepair(self) { self.vendor.repairAll(false) }
  onGuildRepair(self) { self.vendor.repairAll(true) }
  onRepairOne(self) { self.vendor.repairOne() }
  onClose(self) { self.vendor.close() }

  // The right column: the money at the top, the buttons at the bottom, the repairs last.
  const column: Template = $ltml {
    <box rows={SIDE} gap={space(.Item)}>
      <box columns={PAIR} gap={space(.Item)}>
        <text value={Locale.YOUR_MONEY} textColor={DIM} wrap={false} />
        <Money amount={Game.money.amount} />
      </box>
      <box />
      <box columns={1} gap={space(.Item)}>
        <PushButton label={self.junkLabel} width={SIDE_WIDTH} disabled={self.junkCount == 0} @click={self.onSellJunk} />
        <PushButton $if={self.guildRepair} label={Locale.REPAIR_GUILD} width={SIDE_WIDTH} @click={self.onGuildRepair} />
        <PushButton $if={self.vendor.repairs} label={Locale.REPAIR_ONE} width={SIDE_WIDTH} @click={self.onRepairOne} />
        <PushButton $if={self.vendor.repairs} label={self.repairLabel} width={SIDE_WIDTH} accent={true} disabled={!self.canRepair}
                    @click={self.onRepair} />
      </box>
    </box>
  }

  const footer: Template = $ltml {
    <text value={self.countText} textColor={DIM} textSize={SECONDARY_TEXT} />
  }

  public render(self): Template {
    return $ltml {
      <Window tabs={self.tabs} selected={mut self.tab} declared={mut self.declared} side={self.side} footer={self.footer}
              @close={self.onClose}>
        <box $if={self.buying} rows={BODY} gap={space(.Group)}>
          <Toolbar search={mut self.search} placeholder={Locale.SEARCH}>
            <ToolPick $if={!self.tabled} value={mut self.list.values.sort} choices={SORTS} icon={Ordaen.art.ctl.tool.sort}
                      title={Locale.SORT} />
            <ToolPick value={mut self.list.values.filter} choices={FILTERS} icon={Ordaen.art.ctl.tool.filter}
                      title={Locale.FILTER} lit={self.narrowed} />
            <ToolPick value={mut self.list.values.view} choices={VIEWS} icon={Ordaen.art.ctl.tool.list} title={Locale.VIEW} />
          </Toolbar>
          <box $if={self.tabled} rows={FILL}>
            <Table columns={COLUMNS} sorted={mut self.list.values.sorted} descending={mut self.list.values.descending}>
              <WareTableRow $for={ware of self.shown} $key={ware.index} ware={ware} @pressed={self.onWareRow} />
            </Table>
          </box>
          <box $elseif={self.grouped} columns={2} gap={space(.Item)} overflow={Overflow.Scroll}>
            <$for={tab of self.groups}>
              <WareCaption tab={peek tab} count={self.countIn(tab)} folded={self.folded[tab] == true} @toggled={self.onToggle} />
              <WareCell $for={ware of self.inGroup(tab)} $key={ware.index} ware={ware} @pressed={self.onWare} />
            </>
          </box>
          <box $else columns={2} gap={space(.Item)} overflow={Overflow.Scroll}>
            <WareCell $for={ware of self.shown} $key={ware.index} ware={ware} @pressed={self.onWare} />
          </box>
        </box>
        <box $else columns={2} gap={space(.Item)} overflow={Overflow.Scroll}>
          <SoldCell $for={sold of self.sold} $key={sold.place} sold={sold} @pressed={self.onSold} />
        </box>
      </Window>
      <Dialog $if={self.asking != nil} width={DIALOG} title={Locale.MERCHANT}>
        <text value={self.askTitle} textColor={INK} />
        <text value={self.askCosts} textColor={DIM} />
        <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.onAskCancel} />
        <PushButton #buttons label={Locale.BUY} width={BUTTON} accent={true} @click={self.onAsked} />
      </Dialog>
      <Dialog $if={self.counting != nil} width={DIALOG} title={Locale.HOW_MANY}>
        <box columns={PAIR} gap={space(.Item)} yAlign={Align.Center}>
          <CountInput value={mut self.count} least={1} most={self.countMost} />
          <Money amount={self.countPrice} />
        </box>
        <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.onCountCancel} />
        <PushButton #buttons label={Locale.BUY} width={BUTTON} accent={true} @click={self.onCounted} />
      </Dialog>
    }
  }
}
