// The slot's clicks: eight chords of the mouse's buttons and the modifiers, each one action, the same in the bags,
// the bank and the guild bank. The player sets them on the «Slot» page; a scheme always keeps a click for Use and one
// for the Menu (a row holding the last of either offers nothing else), so it can't lock the player out of an item.
import { MouseButton } from "$ltml"
import { Choice } from "Ordaen"
import Locale from "@/locales"

// What a click does to the slot's item.
public enum SlotAction implements Plain {
  Use = "use"
  Pickup = "pickup"
  Menu = "menu"
  Link = "link"
  Send = "send"
  Protect = "protect"
  Socket = "socket"
  Nothing = "nothing"
}

// A button with at most one modifier.
public enum Chord implements Plain {
  Left = "left"
  ShiftLeft = "shiftLeft"
  CtrlLeft = "ctrlLeft"
  AltLeft = "altLeft"
  Right = "right"
  ShiftRight = "shiftRight"
  CtrlRight = "ctrlRight"
  AltRight = "altRight"
}

public const CHORDS: Array<Chord> = [.Left, .ShiftLeft, .CtrlLeft, .AltLeft, .Right, .ShiftRight, .CtrlRight, .AltRight]

// The scheme: one action for each chord.
public struct Clicks implements Plain {
  left: SlotAction
  shiftLeft: SlotAction
  ctrlLeft: SlotAction
  altLeft: SlotAction
  right: SlotAction
  shiftRight: SlotAction
  ctrlRight: SlotAction
  altRight: SlotAction
}

// Left uses, Shift+Left picks up (as the game's own left click), Ctrl+Left sends, Alt+Left protects, Right opens the
// menu, Shift+Right links.
public const OURS: Clicks = {
  left: .Use, shiftLeft: .Pickup, ctrlLeft: .Send, altLeft: .Protect, right: .Menu, shiftRight: .Link,
  ctrlRight: .Nothing, altRight: .Nothing
}

// As the game's own slot: Left picks up, Right uses, Shift+Left links, Shift+Right sockets, Ctrl+Right the menu.
public const AS_THE_GAME: Clicks = {
  left: .Pickup, shiftLeft: .Link, ctrlLeft: .Send, altLeft: .Protect, right: .Use, shiftRight: .Socket,
  ctrlRight: .Menu, altRight: .Nothing
}

// The chord of a press, by its button and the modifier held (Shift before Ctrl before Alt where several are).
public function chordOf(button: MouseButton, shift: Boolean, ctrl: Boolean, alt: Boolean): Chord | nil {
  if (button == MouseButton.Left) {
    if (shift) { return .ShiftLeft }
    if (ctrl) { return .CtrlLeft }
    return alt ? Chord.AltLeft : Chord.Left
  }
  if (button == MouseButton.Right) {
    if (shift) { return .ShiftRight }
    if (ctrl) { return .CtrlRight }
    return alt ? Chord.AltRight : Chord.Right
  }
  return nil
}

public function actionAt(clicks: Clicks, chord: Chord): SlotAction {
  return match (chord) {
    .Left => clicks.left
    .ShiftLeft => clicks.shiftLeft
    .CtrlLeft => clicks.ctrlLeft
    .AltLeft => clicks.altLeft
    .Right => clicks.right
    .ShiftRight => clicks.shiftRight
    .CtrlRight => clicks.ctrlRight
    .AltRight => clicks.altRight
  }
}

public function withAction(clicks: Clicks, chord: Chord, action: SlotAction): Clicks {
  return match (chord) {
    .Left => { left: action, ..clicks }
    .ShiftLeft => { shiftLeft: action, ..clicks }
    .CtrlLeft => { ctrlLeft: action, ..clicks }
    .AltLeft => { altLeft: action, ..clicks }
    .Right => { right: action, ..clicks }
    .ShiftRight => { shiftRight: action, ..clicks }
    .CtrlRight => { ctrlRight: action, ..clicks }
    .AltRight => { altRight: action, ..clicks }
  }
}

// The chord the scheme gives an action, the first in `CHORDS`' order.
public function chordFor(clicks: Clicks, action: SlotAction): Chord | nil {
  return CHORDS.find(chord => actionAt(clicks, chord) == action)
}

// The scheme a slot of the bags or the bank acts by. The client's use of a bag's item is a secure click, which the
// renderer writes for the right button alone (`Action.UseBagItem`): where the scheme puts Use elsewhere, Use and what
// the plain right button holds change places. A guild bank slot's use is no secure click: it takes the scheme as it is.
public function secureScheme(clicks: Clicks): Clicks {
  const use = chordFor(clicks, .Use)
  if (use == nil || use == .Right) { return clicks }
  return withAction(withAction(clicks, use, clicks.right), .Right, .Use)
}

// How many chords hold the action.
function countOf(clicks: Clicks, action: SlotAction): Integer {
  return CHORDS.count(chord => actionAt(clicks, chord) == action)
}

// What a chord's row offers: every action, but only its own where it holds the last Use or the last Menu.
public function choicesFor(clicks: Clicks, chord: Chord): Array<Choice<SlotAction>> {
  const now = actionAt(clicks, chord)
  if ((now == .Use || now == .Menu) && countOf(clicks, now) == 1) { return [choiceOf(now)] }
  return ACTIONS.map(action => choiceOf(action))
}

function choiceOf(action: SlotAction): Choice<SlotAction> {
  return { value: action, label: actionName(action) }
}

const ACTIONS: Array<SlotAction> = [.Use, .Pickup, .Menu, .Link, .Send, .Protect, .Socket, .Nothing]

public function actionName(action: SlotAction): String {
  return match (action) {
    .Use => Locale.ACT_USE
    .Pickup => Locale.ACT_PICKUP
    .Menu => Locale.ACT_MENU
    .Link => Locale.ACT_LINK
    .Send => Locale.ACT_SEND
    .Protect => Locale.ACT_PROTECT
    .Socket => Locale.ACT_SOCKET
    .Nothing => Locale.ACT_NOTHING
  }
}

public function chordName(chord: Chord): String {
  return match (chord) {
    .Left => Locale.CHORD_LEFT
    .ShiftLeft => Locale.CHORD_SHIFT_LEFT
    .CtrlLeft => Locale.CHORD_CTRL_LEFT
    .AltLeft => Locale.CHORD_ALT_LEFT
    .Right => Locale.CHORD_RIGHT
    .ShiftRight => Locale.CHORD_SHIFT_RIGHT
    .CtrlRight => Locale.CHORD_CTRL_RIGHT
    .AltRight => Locale.CHORD_ALT_RIGHT
  }
}
