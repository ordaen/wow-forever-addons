// Ordaen Bags' model: a slot of the bags as the window keeps it, the views, the sorts and the tabs, and where an item
// belongs among them.
import Client from "$client"
import Game from "$game"
import { Quality } from "Ordaen"
import { JunkLists, JunkRules, Why, junkWhy } from "@/junk"
import { Vault, readIn } from "@/vault"

// How the window shows the bags: by type in tabs, a section per bag, or every slot in one grid in bag order.
public enum View implements Plain { Categories = "categories", Bags = "bags", One = "one" }

// The order of the items in a section, and the order «Sort the bags» moves them into.
public enum SortBy implements Plain {
  Bags = "bags"
  Quality = "quality"
  Name = "name"
  Level = "level"
  Count = "count"
  Type = "type"
}

// A tab of the categories view: every item, the new ones, or one kind. An item is of one kind alone (`tabOf`).
public enum Tab implements Plain {
  All = "all"
  New = "new"
  Quest = "quest"
  Consumables = "consumables"
  Equipment = "equipment"
  Trade = "trade"
  Recipes = "recipes"
  Keys = "keys"
  Other = "other"
  Junk = "junk"
}

// How a tab's items are grouped into sections: by their type, all in one, or by where they are worn.
public enum Grouping implements Plain { Type = "type", None = "none", Worn = "worn" }

// The client's classes of items (`Enum.ItemClass`) the tabs are made of.
const CONSUMABLE = 0
// A bag: its use puts it on (`BagChanger`).
public const CONTAINER = 1
const WEAPON = 2
const GEM = 3
const ARMOR = 4
const REAGENT = 5
const TRADE = 7
const RECIPE = 9
const QUEST = 12
const KEY = 13

// The kinds' tabs, in their fixed order: quest items and consumables first, then equipment, trade goods, recipes, the
// rest, junk last.
public const KINDS: Array<Tab> = [.Quest, .Consumables, .Equipment, .Trade, .Recipes, .Keys, .Other, .Junk]

// One item, one tab: junk where the verdict says so whatever its class (a grey hammer is junk, not equipment); a trade
// good where crafting takes it, as the client marks it, whatever its class (a feather is the client's miscellany);
// else by the client's class of it.
public function tabOf(kind: Integer, reagent: Boolean, why: Why | nil): Tab {
  if (why != nil) { return .Junk }
  if (reagent) { return .Trade }
  return match (kind) {
    QUEST => .Quest
    CONSUMABLE => .Consumables
    WEAPON, ARMOR => .Equipment
    TRADE, REAGENT, GEM => .Trade
    RECIPE => .Recipes
    KEY => .Keys
    else => .Other
  }
}

// A tab's place among the kinds; the two that aren't kinds stand before them.
public function rankOf(tab: Tab): Integer {
  for (index, kind of KINDS) {
    if (kind == tab) { return index }
  }
  return 0
}

// The item's quality as the library's slot draws it.
public function qualityOf(quality: Integer): Quality {
  return match (quality) {
    0 => .Poor
    2 => .Uncommon
    3 => .Rare
    4 => .Epic
    5 => .Legendary
    6 => .Artifact
    7 => .Heirloom
    else => .Common
  }
}

// What a slot's refresh found changed, each a bit of its answer.
public const MOVED = 1
public const COUNTED = 2
public const MARKED = 4
// The verdict on its item changed: it is junk, or junk no more.
public const JUDGED = 8

// A slot of the bags, the bank or the guild bank: where it is (a container and its slot; a guild bank's tab and its
// slot), what lies there as the client said it last (`read`, the one table the game fills again), and what of that the
// window draws, each a cell, so an update that changes a count redraws that count alone. Made once for each slot, and
// kept.
public class Slot {
  public const vault: Vault
  public const bag: Integer
  public const index: Integer
  public const read: mut Game.SlotItem
  public state id = 0
  public state count = 0
  public state quality: Quality = .Common
  public state isNew = false
  public state locked = false
  public state guarded = false
  // Whether its item is junk: the coin in its corner.
  public state junk = false
  // The client's quest marks: a quest's item (its border), one that starts a quest not yet taken (its «!»).
  public state questItem = false
  public state startsQuest = false
  // What the item is named in lower case, for the search: made again only when another item comes into the slot.
  public lower = ""
  // Its tab, by the verdict and its class; why it is junk, where it is.
  public tab: Tab = .Other
  public why: Why | nil = nil

  constructor(vault: Vault, bag: Integer, index: Integer) {
    self.vault = vault
    self.bag = bag
    self.index = index
    self.read = {
      id: 0, count: 0, quality: 1, icon: nil, name: "", link: "", level: 0, kind: -1, subkind: -1, subkindName: "",
      worn: "", bound: false, locked: false, isNew: false, price: 0
    }
  }

  // Read again from the game: what changed (`MOVED`: another item lies there, `COUNTED`: its count, `MARKED`: whether it
  // is new, `JUDGED`: its verdict), nought for nothing or a lock alone. The verdict is worked out for a new item, and
  // again once the client loaded an item read before it was (its price and level unknown till then).
  public refresh(mut self, lists: JunkLists, rules: JunkRules): Integer {
    const was = peek self.id
    const wasCount = peek self.count
    const wasNew = peek self.isNew
    const wasLoaded = self.read.loaded
    let changed = 0
    if (!readIn(self.vault, self.bag, self.index, mut self.read)) {
      self.id = 0
      self.count = 0
      self.isNew = false
      self.locked = false
      self.junk = false
      self.why = nil
    } else {
      const item = self.read
      if (item.id != was) { self.lower = item.name.lower() }
      if (item.id != was || (item.loaded && !wasLoaded)) { changed = self.judge(lists, rules) }
      self.id = item.id
      self.count = item.count
      self.quality = qualityOf(item.quality)
      self.isNew = item.isNew
      self.locked = item.locked
    }
    self.questItem = self.read.id != 0 && self.read.questItem
    self.startsQuest = self.read.id != 0 && self.read.startsQuest
    if (peek self.id != was) { changed = Client.bit.bor(changed, MOVED) }
    if (peek self.count != wasCount) { changed += COUNTED }
    if (peek self.isNew != wasNew) { changed += MARKED }
    return changed
  }

  // The verdict on the item worked out again (a mark, a score or a rule changed): `JUDGED` where it changed.
  public judge(mut self, lists: JunkLists, rules: JunkRules): Integer {
    if (self.read.id == 0) { return 0 }
    const why = junkWhy(self.read, lists, rules)
    const tab = tabOf(self.read.kind, self.read.reagent, why)
    const changed = why != self.why || tab != self.tab
    self.why = why
    self.tab = tab
    self.junk = why != nil
    return changed ? JUDGED : 0
  }

  // A new item looked at: new no more, the client told.
  public see(mut self) {
    self.isNew = false
    Game.bags.seen(self.bag, self.index)
  }

  // What tells two stacks apart for sorting: the item and how many.
  public key(self): Integer {
    return (peek self.id) * 1000 + (peek self.count)
  }
}

// Whether Use hands the item over where the player stands, as the client's own bags do: sells it, or puts it in the
// trade or the letter.
public function handsOver(place: Game.BagPlace): Boolean {
  return place == .Merchant || place == .Trade || place == .Mail
}
