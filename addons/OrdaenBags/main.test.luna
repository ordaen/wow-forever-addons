test "slots stand apart by the setting's room, three steps where none is chosen; none at 0" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "One bag")
  const first = nth(1).rect()
  const second = nth(2).rect()
  Test.expect(second.left - first.right >= Ordaen.lengthOf(3sp) / 1ui - 0.01)
  Bags.settings.change((values: mut Choices): nil => { values.slotGap = 0 })
  Test.flush()
  Test.expect((nth(2).rect().left - nth(1).rect().right).abs() < 0.01)
}

test "a slot is as big as the setting says, 50 where none is chosen, its icon with it, and the cards stay in the list" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "One bag")
  const before = nth(1).rect()
  Bags.settings.change((values: mut Choices): nil => { values.slotSize = 40 })
  Test.flush()
  const after = nth(1).rect()
  Test.expect(((after.right - after.left) / (before.right - before.left) - 0.8).abs() < 0.01)
  Test.expect(bags().button(WELL).count() == 22)
}

test "the footer stands on the game's marble, a rim round it" {
  const world = new World(everyday())
