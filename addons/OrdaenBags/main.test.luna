// «Sort the bags»

test "«Sort the bags» moves the items into the window's order, a swap at a time, and stops once they are" {
  const world = new World([
    { bag: 0, slot: 1, id: 1, name: "Ash", icon: ASH, kind: 7, subkindName: "Kind" },
    { bag: 0, slot: 3, id: 2, name: "Elixir", icon: POTION, kind: 0, subkindName: "Kind" },
    { bag: 0, slot: 4, id: 3, name: "Letter", icon: DEED, kind: 12, subkindName: "Kind" }
  ])
  world.sizes = [4, 0, 0, 0, 0]
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.bags.swap = (fromBag: Integer, fromSlot: Integer, toBag: Integer, toSlot: Integer): Boolean => world.swap(fromBag, fromSlot, toBag, toSlot)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "One bag")
  Test.expect(inOrder([ASH]) && nth(3).paintedWith(POTION) && !bags().button(Ordaen.art.ctl.tool.arrange).paintedWith(OFF))
  bags().button(Ordaen.art.ctl.tool.arrange).click()
  // The quest's letter first, the elixir, the ash: the first go swaps what it can, the client's word starts the next.
  Test.expect(bags().button(Ordaen.art.ctl.tool.arrange).paintedWith(OFF))
  Game.bags.updated.emit(0)
  Game.bags.updated.emit(0)
  Test.expect(inOrder([DEED, POTION, ASH]))
  Test.expect(!bags().button(Ordaen.art.ctl.tool.arrange).paintedWith(OFF))
}

test "«Sort the bags» leaves a protected slot as it is" {
  const world = new World([
    { bag: 0, slot: 1, id: 1, name: "Ash", icon: ASH, kind: 7, subkindName: "Kind" },
    { bag: 0, slot: 2, id: 2, name: "Elixir", icon: POTION, kind: 0, subkindName: "Kind" },
    { bag: 0, slot: 3, id: 3, name: "Letter", icon: DEED, kind: 12, subkindName: "Kind" }
