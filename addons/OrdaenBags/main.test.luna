  nth(6).rightClick()
  Test.expect(!Test.page().text(Locale.MENU_PROTECT).shown() && Test.page().box(PADLOCK).count() == 0)
}

// A click's hint on a slot's tooltip, as the player's scheme names it.
function hint(chord: String, action: String): String { return Locale.KEY_CLICK.format(chord, action) }

// The slot menu's protecting picked: on, or off where the slot is protected.
function protect(slot: Test.Part) {
  slot.rightClick()
  const off = Test.page().text(Locale.MENU_UNPROTECT)
  if (off.shown()) { off.click() } else { Test.page().text(Locale.MENU_PROTECT).click() }
}

test "a slot's tooltip names what its clicks do there: the use as the item and the place have it, the link while the chat's input is open" {
  let corner = Client.CreateFrame("Frame", "GameTooltip", Client.C_UI.GetUIParent(), nil)
  corner.SetSize(200, 80)
  corner.SetPoint("TOPLEFT", Client.C_UI.GetUIParent(), "TOPLEFT", 1300, -720)
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  // The potion casts its spell.
  let spell: String | nil = "Minor Healing Potion"
  Client.C_Item.GetItemSpell = (item: String | Integer): (String | nil, Number | nil) => { return spell, nil }
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  // Protected: its tooltip says so first.
  protect(held(POTION))
  held(POTION).hover()
  Game.tooltip.main = tooltipOf(corner, 118, "Minor Healing Potion")
  Test.pass(SHOWS)
  const tip = Test.page().window("Minor Healing Potion")
  const menu = hint(Locale.CHORD_RIGHT, Locale.ACT_MENU)
  // Ordaen's scheme: the double click's use, the menu; no link while the chat's input is shut, no drag.
  const use = hint(Locale.CHORD_LEFT, Locale.ACT_USE)
  Test.expect(reads(tip, `Minor Healing Potion | ${Locale.PROTECTED} | ${use} | ${menu}`))
  Game.chat.typing = true
  Test.flush()
  Test.expect(reads(tip, `Minor Healing Potion | ${Locale.PROTECTED} | ${use} | ${menu} | ${hint(Locale.CHORD_SHIFT_RIGHT, Locale.ACT_LINK)}`))
  Game.chat.typing = false
  // At a merchant the use sells it.
  Game.bags.place = Game.BagPlace.Merchant
  Test.flush()
  Test.expect(reads(tip, `Minor Healing Potion | ${Locale.PROTECTED} | ${hint(Locale.CHORD_LEFT, Locale.USE_SELL)} | ${menu}`))
  Game.bags.place = Game.BagPlace.None
  // An item the client does nothing with: no use to name.
  spell = nil
  Test.flush()
  Test.expect(reads(tip, `Minor Healing Potion | ${Locale.PROTECTED} | ${menu}`))
  // Another item's tooltip, where the cursor isn't on its slot: nothing of the bags'.
  Game.tooltip.main = tooltipOf(corner, 25, "Worn Shortsword")
  Test.pass(SHOWS)
  Test.expect(reads(Test.page().window("Worn Shortsword"), "Worn Shortsword"))
}

test "a protection is kept for the character: there after a reload, not for another character" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  protect(held(POTION))
  Test.reload()
  Test.expect(held(POTION).paintedWith(PADLOCK))
  Test.login({ guid: "Player-1-0000002", name: "Alt", surname: nil })
  Test.expect(Test.page().box(PADLOCK).count() == 0)
}

