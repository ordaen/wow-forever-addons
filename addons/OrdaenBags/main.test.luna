// The protection from «Sort the bags»

test "the slot menu protects a slot with a padlock, and takes it off again" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  protect(held(POTION))
  Test.expect(held(POTION).paintedWith(PADLOCK) && Test.page().box(PADLOCK).count() == 1)
  protect(held(POTION))
  Test.expect(Test.page().box(PADLOCK).count() == 0)
  // Neither pick picked the item up nor used it.
  Test.expect(!Test.requests().join(", ").contains("Bags.pickup") && Test.performed().length == 0)
}

