test "a slot's item dragged onto an action bar's button: the client's cursor takes it, and the button the item" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  // The client's cursor and the potion's slot as the client has it.
  Client.C_Container.GetContainerItemInfo = (bag: Integer, slot: Integer): Client.ContainerItemInfo | nil => bag == 0 && slot == 3 ?
    Client.ContainerItemInfo {
      iconFileID: POTION, stackCount: 5, isLocked: false, quality: .Common, isReadable: false, hasLoot: false,
      hyperlink: "item:118", isFiltered: false, hasNoValue: false, itemID: 118, isBound: false,
      itemName: "Minor Healing Potion"
    } :
    nil
  Game.bags.pickup = (bag: Integer, slot: Integer): nil => Client.C_Container.PickupContainerItem(bag, slot)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  // A button of the client's action bar template, as Ordaen Panel's bars are made of, on slot 61.
  const bar = Client.CreateFrame("CheckButton", "OrdaenBagsTestAction", Client.UIParent, "ActionBarButtonTemplate")
  bar.SetAttribute("action", 61)
  bar.SetSize(40, 40)
  bar.SetPoint("BOTTOMLEFT", Client.UIParent, "BOTTOMLEFT", 20, 20)
  held(POTION).hover()
  Test.press(nil)
  Test.moveTo(Test.centre(bar))
  Test.release(nil)
  const kind, id, _ = Client.GetActionInfo(61)
  Test.expect(kind == "item" && id == 118 && !Client.CursorHasItem())
}

test "a left click on a slot is the client's own use of the item, each click one use" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  held(POTION).click()
  Test.expect(Test.performed().join(", ") == "item 0 3" && asked("Bags.follow true, Items.showBag 0 3"))
  held(POTION).click()
  Test.expect(Test.performed().join(", ") == "item 0 3")
  // The slot placed again (the window resized): its hover's highlight still lets the press through to the use.
  Bags.settings.change((values: mut Choices): nil => { values.slotGap = values.slotGap + 1 })
  held(POTION).click()
  Test.expect(Test.performed().join(", ") == "item 0 3")
  // Shut and opened again, the slot hovered before the press.
  Game.bags.open = false
  Game.bags.open = true
  held(POTION).hover()
  Test.pass(1)
  held(POTION).click()
  Test.expect(Test.performed().join(", ") == "item 0 3")
  held(POTION).rightClick()
  Test.expect(Test.performed().length == 0)
}

