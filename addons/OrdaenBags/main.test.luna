// The bag slots

test "the bag button opens the bag slots: each bag with its name and fill, an empty place as one" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  const window = bagSlots()
  Test.expect(reads(window, "Backpack | 7/16 | Linen Bag | 2/6 | Empty bag slot | Empty bag slot | Empty bag slot | Bag slots"))
  Test.expect(window.box(BACKPACK).shown() && window.box(LINEN_BAG).shown())
}

test "the cursor on a bag lights its items, every other dimmed, and shows the bag's tooltip; off it, nothing is dimmed" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  _ = Test.requests()
  Test.page().text("Linen Bag").hover()
  Test.expect(held(RECIPE).opacity() == 1 && held(POTION).opacity() == DIMMED && asked("Items.show 4238"))
  Test.page().text("Backpack").hover()
  // The backpack is no item: no tooltip.
  Test.expect(held(RECIPE).opacity() == DIMMED && held(POTION).opacity() == 1 && Test.requests().length == 0)
  bags().text("13 of 22").hover()
  Test.expect(held(RECIPE).opacity() == 1 && held(POTION).opacity() == 1)
}

test "the bag slots close with their close and with the bag button, and open again with it" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
