// The footer

test "the footer says the free slots of the total, and the currency the player follows" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.money.amount = 123456
  Game.money.tracked = "12 Marks"
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().text("13 of 22").shown() && bags().text("12 Marks").shown())
  Test.expect(bags().text(Game.money.format(123456)).shown())
  Game.money.tracked = "13 Marks"
  Test.expect(bags().text("13 Marks").shown() && !bags().text("12 Marks").shown())
}

test "the cursor on the gold: this character's, then this realm's others by how much (alike, by name), the total; off it, gone" {
  // Each character logged in once with its gold: «Player» first, then four more, one on another realm.
  Game.money.amount = 500
  Test.mount(nil, SCREEN)
  Test.flush()
  Test.login({ guid: "Player-1-0000002", name: "Abe", surname: nil })
  Game.money.amount = 300
  Test.flush()
  Test.login({ guid: "Player-1-0000003", name: "Zed", surname: nil })
  Game.money.amount = 900
  Test.flush()
  Test.login({ guid: "Player-1-0000004", name: "Kit", surname: nil })
  Game.money.amount = 500
  Test.flush()
  Test.login({ guid: "Player-2-0000005", name: "Far", surname: nil, realm: "Elsewhere" })
  Game.money.amount = 5000
  Test.flush()
  Test.login({ guid: "Player-1-0000006", name: "Dancer", surname: nil })
  Game.money.amount = 100
  Game.bags.open = true
  bags().text(Game.money.format(100)).hover()
  const rows = [
    "Dancer", Game.money.format(100), "Zed", Game.money.format(900), "Kit", Game.money.format(500), "Player",
    Game.money.format(500), "Abe", Game.money.format(300), Locale.GOLD_TOTAL, Game.money.format(2300)
  ]
  Test.expect(reads(Test.page().window(Locale.GOLD), `${Locale.GOLD} | ${rows.join(" | ")}`))
  bags().input().hover()
  Test.expect(!Test.page().window(Locale.GOLD).shown())
}

test "fifty characters' gold is kept, this one's among them" {
  // Forty-nine other characters' gold, as the sessions before left it: written after this load has kept its own
  // (a reload runs what waits first), so the next load reads them.
  Test.mount(nil, SCREEN)
  Test.flush()
  let characters: Map<String, Purse> = {}
  for (index of 1..49) {
    characters[`Player-1-${index}`] = { name: `Alt${index}`, realm: "Stand-in", copper: 100, seen: 1000 + index }
  }
  Game.saved.store(.Account, "OrdaenBags:memory", Purses { characters: characters })
  Test.reload()
  Game.bags.open = true
  bags().text(Game.money.format(0)).hover()
  const tip = Test.page().window(Locale.GOLD)
  Test.expect(tip.text("Alt1").shown() && tip.text("Alt49").shown() && tip.text(Game.money.format(4900)).shown())
}

test "past fifty characters the one seen longest ago is forgotten" {
  // Fifty other characters' gold, as the sessions before left it: the first seen longest ago. Written after this load
  // has kept its own, as above.
  Test.mount(nil, SCREEN)
  Test.flush()
  let characters: Map<String, Purse> = {}
  for (index of 1..50) {
    characters[`Player-1-${index}`] = { name: `Alt${index}`, realm: "Stand-in", copper: 100, seen: 1000 + index }
  }
  Game.saved.store(.Account, "OrdaenBags:memory", Purses { characters: characters })
  Test.reload()
  Game.bags.open = true
  bags().text(Game.money.format(0)).hover()
  const tip = Test.page().window(Locale.GOLD)
  Test.expect(!tip.text("Alt1").shown() && tip.text("Alt2").shown() && tip.text("Alt50").shown())
  Test.expect(tip.text(Game.money.format(4900)).shown())
}

