  Test.expect(bags().text("Linen Bag").shown() && !bags().text("All").shown())
}

test "the sort picked is the profile's: there after a reload" {
  const world = new World(cloths())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.sort, "Name")
  Test.reload()
  Test.expect(inOrder([CLOTH, MAGEWEAVE, SILK, WOOL]))
}

test "a new profile used: the window by category in the bags' order, as at first" {
  const world = new World(cloths())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.sort, "Name")
  pick(Ordaen.art.ctl.tool.categories, "One bag")
  const page = settings()
  page.button("Profiles").click()
  // «Raid» made from the defaults, then used for this character: the page's first box and its second.
  page.input().nth(1).type("Raid")
  page.button(Ordaen.art.ctl.check).nth(1).click()
  page.button("New").click()
  page.button(Ordaen.art.ctl.check).nth(2).click()
  Test.expect(page.text("In use: Raid, for this character").shown())
  page.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(bags().text("All").shown() && inOrder([WOOL, CLOTH, SILK, MAGEWEAVE]))
}

// How the tabs, the sections and the slots look

test "the tab picked is white, the others in ink, and one with no item shows dimmed" {
  const world = new World(cloths())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().text("All").textColor().equal(PICKED) && bags().text("Trade goods").textColor().equal(INK))
  Test.expect(reads(bags().text("Junk").item(), "Junk | 0") && bags().text("Junk").textColor().equal(EMPTY))
  bags().button("Trade goods").click()
  Test.expect(bags().text("Trade goods").textColor().equal(PICKED) && bags().text("All").textColor().equal(INK))
}

test "a section's caption is gold, a bag's with its mark; «Free»'s is plain" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().text("Cloth").textColor().equal(CAPTION) && bags().text("Free").textColor().equal(LABEL))
  pick(Ordaen.art.ctl.tool.categories, "By bag")
  Test.expect(bags().text("Backpack").textColor().equal(CAPTION) && bags().button("Backpack").paintedWith(Ordaen.art.ctl.markOpen))
}

test "each item's rim is in its quality's colour" {
  const world = new World([
    { bag: 0, slot: 1, id: 1, name: "A", icon: HEARTH, quality: 0, kind: 7 },
    { bag: 0, slot: 2, id: 2, name: "B", icon: CLOTH, quality: 1, kind: 7 },
    { bag: 0, slot: 3, id: 3, name: "C", icon: POTION, quality: 2, kind: 7 },
    { bag: 0, slot: 4, id: 4, name: "D", icon: SWORD, quality: 3, kind: 7 },
    { bag: 0, slot: 5, id: 5, name: "E", icon: FOOT, quality: 4, kind: 7 },
    { bag: 0, slot: 6, id: 6, name: "F", icon: DEED, quality: 5, kind: 7 },
    { bag: 0, slot: 7, id: 7, name: "G", icon: SHIRT, quality: 6, kind: 7 },
    { bag: 0, slot: 8, id: 8, name: "H", icon: RECIPE, quality: 7, kind: 7 }
  ])
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "One bag")
  for (at, rim of QUALITIES) { Test.expect(nth(at).paintedWith(rim)) }
}

test "the sections of a kind stand in the order of the game's subclasses" {
  const world = new World([
    { bag: 0, slot: 1, id: 1, name: "Staff", icon: MOSS, kind: 2, subkind: 10, subkindName: "Staves" },
    { bag: 0, slot: 2, id: 2, name: "Sword", icon: SWORD, kind: 2, subkind: 7, subkindName: "One-Handed Swords" }
  ])
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(inOrder([SWORD, MOSS]))
}

test "a stack taken out leaves its slot empty: no count, no glow" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "One bag")
  world.take(0, 2)
  world.take(0, 9)
  Game.bags.updated.emit(0)
  Test.expect(nth(2).texts().length == 0 && !nth(9).paintedWith(NEW_GLOW) && !held(SHIRT).shown())
}

test "every bag with slots has its section in the view «By bag» and its slots in «One bag», the last bag's too" {
  const world = new World(everyday())
  world.sizes = [16, 6, 0, 0, 4]
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "By bag")
  Test.expect(reads(bags().text("Bag 4").item(), "Bag 4 | 0/4") && bags().button(WELL).count() == 26)
  pick(Ordaen.art.ctl.tool.table, "One bag")
  Test.expect(bags().button(WELL).count() == 26 && bags().text("17 of 26").shown())
}

test "in the view «By bag» a bag's caption shuts its section and opens it again" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "By bag")
  bags().button("Backpack").click()
  Test.expect(bags().button(WELL).count() == 6)
  bags().button("Backpack").click()
  Test.expect(bags().button(WELL).count() == 22)
}

// More of the protection

test "a protected stack used up: its protection passes to no other stack of its item" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Game.input.altDown = (): Boolean => true
  held(POTION).click()
  // Another stack of the potions comes in, then the protected one is drunk to the last.
  world.items.push({ bag: 0, slot: 10, id: 118, name: "Minor Healing Potion", icon: POTION, count: 2, kind: 0, subkind: 1 })
  Game.bags.updated.emit(0)
  Test.expect(Test.page().box(PADLOCK).count() == 1)
  world.take(0, 3)
  Game.bags.updated.emit(0)
  Test.expect(held(POTION).shown() && Test.page().box(PADLOCK).count() == 0)
}

test "two protected stacks of one item moved: each keeps its protection" {
  const world = new World([
    { bag: 0, slot: 1, id: 118, name: "Minor Healing Potion", icon: POTION, count: 5, kind: 0 },
    { bag: 0, slot: 2, id: 118, name: "Minor Healing Potion", icon: POTION, count: 5, kind: 0 }
  ])
  world.sizes = [4, 0, 0, 0, 0]
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "One bag")
  Game.input.altDown = (): Boolean => true
  nth(1).click()
  nth(2).click()
  world.at(0, 1).slot = 3
  world.at(0, 2).slot = 4
  Game.bags.updated.emit(0)
  Test.expect(nth(3).paintedWith(PADLOCK) && nth(4).paintedWith(PADLOCK) && Test.page().box(PADLOCK).count() == 2)
}

test "the cursor off a slot, or the bags shut, a tooltip of its item elsewhere says nothing of the bags'" {
  let corner = Client.CreateFrame("Frame", "GameTooltip", Client.C_UI.GetUIParent(), nil)
  corner.SetSize(200, 80)
  corner.SetPoint("TOPLEFT", Client.C_UI.GetUIParent(), "TOPLEFT", 1300, -720)
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  held(POTION).hover()
  bags().text("13 of 22").hover()
  Game.tooltip.main = tooltipOf(corner, 118, "Minor Healing Potion")
  Test.expect(reads(Test.page().window("Minor Healing Potion"), "Minor Healing Potion"))
  held(POTION).hover()
  Game.bags.open = false
  Game.tooltip.main = tooltipOf(corner, 118, "Minor Healing Potion")
  Test.expect(reads(Test.page().window("Minor Healing Potion"), "Minor Healing Potion"))
}

// More of «Sort the bags»

test "a stack picked up and let go elsewhere leaves its slot free for «Sort the bags»" {
  const world = new World([
    { bag: 0, slot: 1, id: 3, name: "Letter", icon: DEED, kind: 12 },
    { bag: 0, slot: 2, id: 1, name: "Ash", icon: ASH, kind: 7, locked: true }
  ])
  world.sizes = [3, 0, 0, 0, 0]
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.bags.swap = (fromBag: Integer, fromSlot: Integer, toBag: Integer, toSlot: Integer): Boolean => world.swap(fromBag, fromSlot, toBag, toSlot)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().shown())
  // The ash, on the cursor, let go in the last slot.
  const ash = world.at(0, 2)
  ash.slot = 3
  ash.locked = false
  Game.bags.updated.emit(0)
  _ = Test.requests()
  bags().button(Ordaen.art.ctl.tool.arrange).click()
  Test.expect(asked("Bags.swap 0 3 0 2"))
}

// What an update redraws

test "an update that changes nothing redraws nothing, sorted by count too" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.sort, "Count")
  const told = Test.calls(() => {
    Game.bags.updated.emit(0)
    Test.flush()
  })
  Test.expect(told == "")
}

test "a count changing redraws that count alone, where the sort isn't by count" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().shown())
  const told = Test.calls(() => {
    world.at(0, 2).count = 15
    Game.bags.updated.emit(0)
    Test.flush()
  })
  Test.expect(told == "GetStringHeight=1 GetUnboundedStringWidth=1 SetText=1" && bags().text("15").shown())
}

test "an empty bag put on shows its section in the view «By bag»" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "By bag")
  world.sizes[5] = 4
  Game.bags.updated.emit(4)
  Test.expect(reads(bags().text("Bag 4").item(), "Bag 4 | 0/4") && bags().button(WELL).count() == 26)
}

