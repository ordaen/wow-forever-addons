  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "By bag")
  world.sizes[5] = 4
  Game.bags.updated.emit(4)
  Test.expect(reads(bags().text("Bag 4").item(), "Bag 4 | 0/4") && bags().button(WELL).count() == 26)
}

test "in the view «One bag», the cursor off a slot, a tooltip of its item elsewhere says nothing of the bags'" {
  let corner = Client.CreateFrame("Frame", "GameTooltip", Client.C_UI.GetUIParent(), nil)
  corner.SetSize(200, 80)
  corner.SetPoint("TOPLEFT", Client.C_UI.GetUIParent(), "TOPLEFT", 1300, -720)
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "One bag")
  held(POTION).hover()
  bags().text("13 of 22").hover()
  Game.tooltip.main = tooltipOf(corner, 118, "Minor Healing Potion")
  Test.pass(SHOWS)
  Test.expect(reads(Test.page().window("Minor Healing Potion"), "Minor Healing Potion"))
}

// The bags' window's grip dragged far to the left: as narrow as it lets itself be.
function narrowest() {
  const grip = Test.painted(Ordaen.art.ctl.grip, nil)
  Test.moveTo(grip)
  Test.press(nil)
  Test.moveTo({ x: grip.x - 1, y: grip.y })
  Test.pass(0.05)
  Test.moveTo({ x: grip.x - 2000, y: grip.y })
  Test.pass(0.05)
  Test.release(nil)
  Test.flush()
}

// How many slots the first card's row holds.
function firstSpan(): Integer {
  return ((Bags.main.lines[1]?.cards ?? [])[1])?.span ?? 0
}

test "the one-bag view keeps no room for the tabs it doesn't show: it may be the tab list narrower than the categories" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.flush()
  const withTabs = Bags.main.leastWidth
  Bags.list.write({ view: .One, ..Bags.list.values })
  Test.flush()
  Test.expect(Bags.main.leastWidth < withTabs - 100ui)
}

test "a group is at least the fewest slots in a row wide, as the player sets it, and the window narrows to one" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Bags.settings.change((values: mut Choices): nil => { values.rowLeast = 6 })
  Game.bags.open = true
  Test.flush()
  Test.expect(Bags.main.lines.all(line => line.cards.all(card => card.section.title == "" || card.span >= 6)))
  narrowest()
  Test.expect(Bags.main.lines.all(line => line.cards.length == 1) && firstSpan() == 6)
}

test "the grip narrows a wide window past the row it opened with, down to its least: the cards ask nothing of it" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Bags.list.write({ view: .One, ..Bags.list.values })
  Bags.window.memory.write({ width: 1400ui, ..Bags.window.memory.values })
  Game.bags.open = true
  Test.flush()
  Test.expect(firstSpan() == 22)
  narrowest()
  Test.expect(firstSpan() <= 6)
}

test "the cursor on the client's bag button, where the bottom panel shows it, lights that bag's slots" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  // The first bag's button: the backpack's potion is another bag's, dimmed while the cursor stays.
  const frame = Client.CreateFrame("Button", "TestBagButton", Client.UIParent)
  frame.SetPoint("CENTER", Client.UIParent, "CENTER", 0, 0)
  frame.SetSize(30, 30)
  Game.bags.buttons = [{ kind: .Bag, bag: 1, frame: frame, icon: nil }]
  Test.flush()
  Test.moveTo(Test.centre(frame))
  Test.flush()
  Test.expect(held(POTION).opacity() < 1)
  Test.moveTo({ x: 5, y: 5 })
  Test.flush()
  Test.expect(held(POTION).opacity() == 1)
}

test "in the category view the tabs stand down a marble column the page's height; the toolbar is beside it, over the list" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "Categories")
  const column = bags().box(Ordaen.art.window.marble).nth(1)
  const footer = bags().box(Ordaen.art.window.marble).nth(2)
  Test.expect(column.text("All").shown())
  // The column reaches the footer; the search stands right of it, not in it.
  Test.expect((column.rect().bottom - footer.rect().top).abs() < 0.05)
  Test.expect(bags().text(Locale.SEARCH).rect().left >= column.rect().right)
  // The items keep the page's side room from the column, as the toolbar does.
  Test.expect(nth(1).rect().left - column.rect().right >= Ordaen.lengthOf(8sp) / 1ui)
}

// Putting a bag on

// What the game was asked, but the tooltips of the slots the cursor crossed: where it isn't this, the test fails with it.
function askedOnly(expected: String): Boolean {
  const said = Test.requests().filter(request => !request.contains("Items.show")).join(", ")
  if (said != expected) { panic(`the game was asked «${said}», not «${expected}»`) }
  return true
}

// The everyday bags with a new bag in the backpack's sixth slot, and the client's four bag places.
function withNewBag(world: mut World) {
  world.items.push({ bag: 0, slot: 6, id: 4245, name: "Small Silk Pack", icon: LINEN_BAG, kind: 1 })
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  const frame = Client.CreateFrame("Button", nil, Client.UIParent)
  Game.bags.buttons = [
    { kind: .Backpack, bag: 0, frame: frame, icon: nil }, { kind: .Bag, bag: 1, frame: frame, icon: nil },
    { kind: .Bag, bag: 2, frame: frame, icon: nil }, { kind: .Bag, bag: 3, frame: frame, icon: nil },
    { kind: .Bag, bag: 4, frame: frame, icon: nil }
  ]
}

test "a bag used goes on in an empty bag place, by the bags themselves" {
  const world = new World(everyday())
  withNewBag(mut world)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.flush()
  _ = Test.requests()
  bags().button(LINEN_BAG).click()
  Test.expect(Test.performed().length == 0 && askedOnly("Bags.wear 0 6 2"))
}

test "with every place taken, the smallest bag is emptied into the others, then the new one goes on in its place" {
  const world = new World(everyday())
  world.sizes = [16, 6, 8, 8, 8]
  withNewBag(mut world)
  Game.bags.swap = (fromBag: Integer, fromSlot: Integer, toBag: Integer, toSlot: Integer): Boolean =>
  world.swap(fromBag, fromSlot, toBag, toSlot)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.flush()
  _ = Test.requests()
  bags().button(LINEN_BAG).click()
  Test.expect(askedOnly("Bags.swap 1 2 0 8, Bags.swap 1 4 0 10"))
  Game.bags.updated.emit(1)
  Game.bags.updated.emit(0)
  Test.expect(askedOnly("Bags.wear 0 6 1"))
}

test "a bag whose smallest replacement holds more than the other bags have free stays, and the chat says why" {
  const world = new World(everyday())
  world.sizes = [9, 6, 0, 0, 0]
  withNewBag(mut world)
  Game.bags.buttons = [{ kind: .Bag, bag: 1, frame: Client.CreateFrame("Button", nil, Client.UIParent), icon: nil }]
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.flush()
  _ = Test.requests()
  _ = Test.printed()
  bags().button(LINEN_BAG).click()
  Test.expect(askedOnly(""))
  Test.expect(Test.printed().join("\n").contains("holds more than the other bags have free"))
}

test "while a spell waits for an item, a left click gives it the slot's item, the client's secure doing; nothing is picked up" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Game.player.targeting = true
  Test.flush()
  _ = Test.requests()
  held(SWORD).click()
  Test.expect(Test.performed().join(", ") == "item 0 4")
  Test.expect(askedOnly(""))
  Game.player.targeting = false
}

test "gold on the cursor let go on a slot goes back into the purse; the guild bank's is taken out" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  let gold: String = "money"
  let dropped = 0
  let withdrawn = 0
  Client.GetCursorInfo = (): (String | nil, Unknown, Unknown, Unknown) => {
    return gold, 500, nil, nil
  }
  Client.DropCursorMoney = (): nil => {
    dropped += 1
  }
  Client.WithdrawGuildBankMoney = (copper: Number): nil => {
    withdrawn += copper
  }
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.flush()
  _ = Test.requests()
  bags().button(SWORD).click()
  Test.expect(dropped == 1 && withdrawn == 0 && askedOnly(""))
  gold = "guildbankmoney"
  bags().button(SWORD).click()
  Test.expect(dropped == 1 && withdrawn == 500 && askedOnly(""))
}

test "a bag's line clicked keeps its items lit, the rest faded, until clicked again" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  bagSlots().text("Linen Bag").click()
  Test.moveTo({ x: 5, y: 5 })
  Test.flush()
  Test.expect(held(POTION).opacity() < 1 && held(RECIPE).opacity() == 1)
  bagSlots().text("Linen Bag").click()
  Test.moveTo({ x: 5, y: 5 })
  Test.flush()
  Test.expect(held(POTION).opacity() == 1)
}

test "a worn bag's line dragged takes the bag off its place; a bag held from a place let go on another is put on there" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  Test.flush()
  _ = Test.requests()
  const from = Test.holding("Linen Bag", nil)
  Test.moveTo(from)
  Test.press(nil)
  Test.moveTo({ x: from.x + 30, y: from.y })
  // Let go away from the window (on its own line it would go back on).
  Test.moveTo({ x: 5, y: 5 })
  Test.release(nil)
  Test.expect(askedOnly("Bags.pickupBag 1"))
  // Held from its place (the cursor holds it; no slot of the bags is locked): let go on an empty place.
  Client.CursorHasItem = (): Boolean => true
  bagSlots().text("Empty bag slot").nth(1).click()
  Test.expect(askedOnly("Bags.wearHeld 2"))
}

test "an ordinary bag never takes a bag for one kind of thing off: the smallest ordinary one is replaced" {
  const world = new World(everyday())
  world.sizes = [16, 6, 8, 8, 8]
  // The linen bag, the smallest, takes one kind of thing alone.
  world.general = false
  withNewBag(mut world)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.flush()
  _ = Test.requests()
  bags().button(LINEN_BAG).click()
  Test.expect(askedOnly("Bags.wear 0 6 2"))
}

test "a run the client won't finish gives up after its goes, and the chat says the bag wasn't put on" {
  const world = new World(everyday())
  world.sizes = [16, 6, 8, 8, 8]
  // The client takes the swaps and moves nothing.
  world.moves = false
  withNewBag(mut world)
  Game.bags.swap = (fromBag: Integer, fromSlot: Integer, toBag: Integer, toSlot: Integer): Boolean =>
  world.swap(fromBag, fromSlot, toBag, toSlot)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.flush()
  _ = Test.printed()
  bags().button(LINEN_BAG).click()
  for (go of 1..10) { Game.bags.updated.emit(1) }
  Test.expect(Test.printed().join("\n").contains("wouldn't move"))
}

test "a bag isn't put on while the cursor holds something" {
  const world = new World(everyday())
  withNewBag(mut world)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.flush()
  const bag = Bags.carried.all.find(slot => slot.bag == 0 && slot.index == 6) ?? panic("the new bag lies there")
  Client.CursorHasItem = (): Boolean => true
  Test.expect(new BagChanger().start(bag, [], (place: Integer): Boolean => true) == Change.Busy)
}

test "the keyring's keys are read with the bags: under «Keys», and the keyring a line of the bag slots" {
  const world = new World(everyday())
  world.items.push({ bag: -1, slot: 1, id: 5396, name: "Key to Searing Gorge", icon: DEED, kind: 13 })
  Game.bags.containers = [0, 1, 2, 3, 4, -1]
  Game.bags.bag = (bag: Integer): Game.BagInfo => bag == -1 ?
    { bag: -1, item: nil, name: "Keyring", icon: nil, slots: 32, general: false } : world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => bag == -1 ? 32 : world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button("Keys").click()
  Test.expect(held(DEED).shown() && !held(SWORD).shown())
  bags().button(BAG_BUTTON).click()
  Test.expect(bagSlots().text("Keyring").shown() && bagSlots().text("1/32").shown())
}
