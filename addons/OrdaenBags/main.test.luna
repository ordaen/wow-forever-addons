// Ordaen Bags as the player meets it: the window that shows while the game has its bags open, in place of the game's
// own; its tabs, views and sorts picked from the header; the search; a slot's clicks; the protection from «Sort the
// bags»; the bag slots; the footer's free slots and gold; and what is kept between sessions. The game is a world of
// items the test keeps (`World`): what each slot holds, each item with an icon of its own, by which the player tells
// it on the screen.
import Client from "$client"
import Game from "$game"
import { Art } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, ItemKind, kindName } from "Ordaen"
import root Bags from "OrdaenBags"
import { BagChanger, Change } from "@/change"
import { Purse, Purses } from "@/gold"
import Locale from "@/locales"
import { Choices } from "@/pane"

// The player's screen: 2470 by 1054.
// The general delay before a tooltip shows, and the frame its watch takes to see the show.
const SHOWS = 0.32

const SCREEN: Test.Page = { left: 0, top: 0, width: 2470, height: 1054, screen: true }

// The items' icons.
const HEARTH: FileId = 134414
const CLOTH: FileId = 132889
const POTION: FileId = 134829
const SWORD: FileId = 135274
const FOOT: FileId = 133854
const DEED: FileId = 134327
const SHIRT: FileId = 135011
const RECIPE: FileId = 134939
const WOOL: FileId = 132911
const SILK: FileId = 132905
const MAGEWEAVE: FileId = 132892
const ZIRCON: FileId = 134134
const ASH: FileId = 132857
const MOSS: FileId = 134187
// The bags' icons, and the header's bag button's.
const BACKPACK: FileId = 133633
const LINEN_BAG: FileId = 133647
const BAG_BUTTON: FileId = 130716
const BIG_BAG: FileId = 133644

// A slot's crest (the client's slot art), every slot drawn on it, empty or not; a new item's glow; a protected slot's
// padlock; a switched off tool's glyph.
const WELL: Asset = "Interface/Buttons/UI-Slot-Background"
const NEW_GLOW: Color = Color.hex("#ffd65a")
const PADLOCK: Atlas = "QuestSharing-Padlock"
const OFF: Color = Color.hex("#a3977f")
// The text of a name and of a label, and a row under the cursor.
const LABEL: Color = Color.hex("#a3977f")
const INK: Color = Color.hex("#e8dcc4")
const SHADE: Color = Color.hex("#00000059")
// A tab: the one picked, and one with no item. A section's caption.
const PICKED: Color = BRIGHT_TEXT
const EMPTY: Color = Color.hex("#6b6150")
const CAPTION: Color = Color.hex("#e8c35a")
// The rims of the items' qualities, from poor to heirloom.
const QUALITIES: Array<Color> = [
  Color.hex("#9d9d9d"), Color.hex("#6c5535"), Color.hex("#1eff00"), Color.hex("#0070dd"), Color.hex("#a335ee"),
  Color.hex("#ff8000"), Color.hex("#e6cc80"), Color.hex("#00ccff")
]
// How much of a dimmed slot shows.
const DIMMED: Number = 0.35
// A text the settings window always shows.
const SETTINGS = "Move mode"

// One stack in the bags, as the game reads it.
struct Lies {
  bag: Integer
  slot: Integer
  const id: Integer
  const name: String
  const icon: FileId
  count: Integer = 1
  const quality: Integer = 1
  const kind: Integer
  const subkind: Integer = 0
  const subkindName: String = ""
  const level: Integer = 1
  isNew: Boolean = false
  const bound: Boolean = false
  locked: Boolean = false
}

// What lies in the bags, the size of each, and what the game does with them: the test's fakes read it.
class World {
  items: mut Array<mut Lies>
  // Each bag's slots, from the backpack.
  sizes: mut Array<Integer> = [16, 6, 0, 0, 0]
  // Whether the linen bag takes any item.
  general = true
  // Whether a swap asked moves the items.
  moves = true
  // The linen bag's icon, as the game shows it.
  linenIcon: FileId = LINEN_BAG

  constructor(items: mut Array<mut Lies>) { self.items = items }

  public bag(self, bag: Integer): Game.BagInfo {
    const slots = self.sizes[bag + 1] ?? 0
    if (bag == 0) { return { bag: 0, item: nil, name: "Backpack", icon: BACKPACK, slots: slots, general: true } }
    if (bag == 1) { return { bag: 1, item: 4238, name: "Linen Bag", icon: self.linenIcon, slots: slots, general: self.general } }
    // A bag the test gives slots is named by its place; an empty bag slot has no name.
    return { bag: bag, item: nil, name: slots > 0 ? `Bag ${bag}` : "", icon: nil, slots: slots, general: true }
  }

  public size(self, bag: Integer): Integer { return self.sizes[bag + 1] ?? 0 }

  public read(self, bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean {
    const item = self.items.find(lying => lying.bag == bag && lying.slot == slot)
    if (item == nil) {
      into.id = 0
      return false
    }
    into.id = item.id
    into.count = item.count
    into.quality = item.quality
    into.name = item.name
    into.link = `[${item.name}]`
    into.level = item.level
    into.kind = item.kind
    into.subkind = item.subkind
    into.subkindName = item.subkindName
    into.worn = ""
    into.bound = item.bound
    into.locked = item.locked
    into.isNew = item.isNew
    into.price = 10
    return true
  }

  public icon(self, id: Integer): Art | nil { return self.items.find(lying => lying.id == id)?.icon }

  // The stack in a slot.
  public at(mut self, bag: Integer, slot: Integer): mut Lies {
    for (item of self.items) {
      if (item.bag == bag && item.slot == slot) { return item }
    }
    panic(`nothing lies in ${bag}/${slot}`)
  }

  // The two slots' stacks change places, as the client does.
  public swap(mut self, fromBag: Integer, fromSlot: Integer, toBag: Integer, toSlot: Integer): Boolean {
    if (!self.moves) { return true }
    for (item of self.items) {
      if (item.bag == fromBag && item.slot == fromSlot) {
        item.bag = toBag
        item.slot = toSlot
      } else if (item.bag == toBag && item.slot == toSlot) {
        item.bag = fromBag
        item.slot = fromSlot
      }
    }
    return true
  }

  // The stack taken out of the bags.
  public take(mut self, bag: Integer, slot: Integer) {
    let at = 0
    for (index, item of self.items) {
      if (item.bag == bag && item.slot == slot) { at = index }
    }
    _ = self.items.remove(at)
  }
}

// The backpack's sixteen slots and the linen bag's six: a hearthstone, cloth, potions, a sword, a grey rabbit's foot, a
// quest's deed, a new shirt; a recipe and more cloth in the linen bag. Nine items, thirteen slots free.
function everyday(): mut Array<mut Lies> {
  return [
    { bag: 0, slot: 1, id: 6948, name: "Hearthstone", icon: HEARTH, kind: 15 },
    { bag: 0, slot: 2, id: 2589, name: "Linen Cloth", icon: CLOTH, count: 20, kind: 7, subkind: 5, subkindName: "Cloth" },
    { bag: 0, slot: 3, id: 118, name: "Minor Healing Potion", icon: POTION, count: 5, kind: 0, subkind: 1, subkindName: "Potion" },
    { bag: 0, slot: 4, id: 25, name: "Worn Shortsword", icon: SWORD, kind: 2, subkind: 7, subkindName: "One-Handed Swords" },
    { bag: 0, slot: 5, id: 3300, name: "Rabbit's Foot", icon: FOOT, count: 3, quality: 0, kind: 15, subkindName: "Oddments" },
    { bag: 0, slot: 7, id: 1972, name: "Westfall Deed", icon: DEED, kind: 12, subkindName: "Quest" },
    {
      bag: 0, slot: 9, id: 2575, name: "Red Linen Shirt", icon: SHIRT, quality: 2, kind: 4, subkindName: "Miscellaneous", isNew: true,
      level: 12
    },
    { bag: 1, slot: 2, id: 2408, name: "Recipe: Fine Leather Gloves", icon: RECIPE, quality: 2, kind: 9, subkind: 1, subkindName: "Leatherworking" },
    { bag: 1, slot: 4, id: 2589, name: "Linen Cloth", icon: CLOTH, count: 7, kind: 7, subkind: 5, subkindName: "Cloth" }
  ]
}

// Four cloths in the backpack's first slots, one section of the trade goods: wool, linen, silk and mageweave, each
// told apart by a sort.
function cloths(): mut Array<mut Lies> {
  return [
    { bag: 0, slot: 1, id: 2592, name: "Wool Cloth", icon: WOOL, count: 5, kind: 7, subkind: 5, subkindName: "Cloth", level: 10 },
    { bag: 0, slot: 2, id: 2589, name: "Linen Cloth", icon: CLOTH, count: 20, kind: 7, subkind: 5, subkindName: "Cloth", level: 5 },
    { bag: 0, slot: 3, id: 4306, name: "Silk Cloth", icon: SILK, quality: 2, kind: 7, subkind: 5, subkindName: "Cloth", level: 20 },
    {
      bag: 0, slot: 4, id: 4338, name: "Mageweave Cloth", icon: MAGEWEAVE, count: 10, quality: 3, kind: 7, subkind: 5,
      subkindName: "Cloth", level: 15
    }
  ]
}

// The bags' window: the surface that holds its title.
function bags(): Test.Part {
  return Test.page().window(Locale.TITLE)
}

// The bag slots' window: the surface that lists the linen bag (with the bags' window by category, where no caption
// names it).
function bagSlots(): Test.Part {
  return Test.page().window("Linen Bag")
}

// A slot, by its item's icon.
function held(icon: FileId): Test.Part {
  return bags().button(icon)
}

// The `nth` slot drawn, an empty one too.
function nth(n: Integer): Test.Part {
  return bags().button(WELL).nth(n)
}

// Whether the slots drawn hold these items, in this order, from the first.
function inOrder(icons: Array<FileId>): Boolean {
  for (index, icon of icons) {
    if (!nth(index).paintedWith(icon)) { return false }
  }
  return true
}

// A choice of one of the header's pickers: the picker by its glyph, then the choice in its list.
function pick(glyph: Art, choice: String) {
  bags().button(glyph).click()
  Test.page().button(choice).click()
}

// The tab's name and count, as its row reads.
function tab(name: String): String {
  return bags().button(name).texts().join(" | ")
}

// Whether a part's texts read exactly this, joined by « | »: where they don't, the test fails with what they read.
function reads(part: Test.Part, expected: String): Boolean {
  const read = part.texts().join(" | ")
  if (read != expected) { panic(`it reads «${read}», not «${expected}»`) }
  return true
}

// Whether the game was asked exactly this since it was last asked, joined by «, »: where it wasn't, the test fails with
// what it was asked.
function asked(expected: String): Boolean {
  const said = Test.requests().join(", ")
  if (said != expected) { panic(`the game was asked «${said}», not «${expected}»`) }
  return true
}

// The game's own tooltip, as the game shows it for an item the cursor is on: where Ordaen Tooltips draws its own.
function tooltipOf(corner: any Client.Frame, id: Integer, name: String): Game.ShownTip {
  return {
    shown: true, data: { kind: 0, id: id, about: `item:${id}`, lines: [{ left: name, kind: 22 }] }, placeable: false,
    ownerHigh: false, ownerRight: false, corner: corner, below: false, right: true, home: corner, homeBelow: false,
    homeRight: true
  }
}

// A client's bag window, as the game's `ContainerFrame1`.
function gameWindow(): any Client.Frame {
  let own = Client.CreateFrame("Frame", "ContainerFrame1", Client.UIParent, nil)
  own.SetSize(200, 300)
  own.SetPoint("CENTER", Client.UIParent, "CENTER", 0, 0)
  return own
}

// Ordaen's settings window at the module's page, as `/ordaen bags` opens it.
function settings(): Test.Part {
  (Client.SlashCmdList["ORDAEN"] ?? panic("/ordaen is Ordaen's command"))("bags")
  return Test.page().window(SETTINGS)
}

// The window shown and shut

test "the window shows while the game has its bags open, and the game's own bag windows stay unseen" {
  const own = gameWindow()
  Game.bags.windows = [own]
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Test.expect(!bags().shown() && own.GetAlpha() == 0)
  Game.bags.open = true
  Test.expect(bags().shown() && own.GetAlpha() == 0)
  Game.bags.open = false
  Test.expect(!bags().shown() && own.GetAlpha() == 0)
}

test "the bags are followed while they are open, and not while they are shut" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Test.expect(Test.requests().length == 0)
  Game.bags.open = true
  Test.expect(bags().shown() && asked("Bags.follow true"))
  Game.bags.open = false
  Test.expect(!bags().shown() && asked("Bags.follow false"))
}

test "the window's close shuts the game's bags" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  // The corner's controls show while the cursor is over the window.
  bags().text("13 of 22").hover()
  bags().button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!Game.bags.open && !bags().shown())
}

test "the corner's gear opens the module's page of the settings, with its two windows, standing over the bags" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  // Small slots against each other, the bags low enough for the settings to cover their gear; the player left the bags
  // in the screen's middle, where the settings open.
  Bags.settings.change((values: mut Choices): nil => {
    values.slotGap = 0
    values.slotSize = 37
  })
  Bags.window.memory.write({ x: 0ui, ..Bags.window.memory.values })
  Game.bags.open = true
  bags().text("13 of 22").hover()
  bags().button(Ordaen.art.ctl.corner.gear).click()
  const page = Test.page().window(SETTINGS)
  Test.expect(page.text("Ordaen Bags").shown() && page.text(Locale.BAG_SLOTS).shown())
  // The settings cover the bags, the gear too, and a window stops the clicks on what it draws: a click where the gear
  // stands is the settings' and leaves them open.
  const gearAt = Test.page().window("13 of 22").button(Ordaen.art.ctl.corner.gear).rect()
  const over = Test.page().window(SETTINGS).rect()
  Test.expect(gearAt.left >= over.left && gearAt.right <= over.right)
  Test.expect(gearAt.top >= over.top && gearAt.bottom <= over.bottom)
  Test.page().window("13 of 22").button(Ordaen.art.ctl.corner.gear).click()
  Test.expect(Test.page().window(SETTINGS).shown())
}

test "turned off in the settings the window goes and the game's own bag windows show; turned on, it shows again" {
  const own = gameWindow()
  Game.bags.windows = [own]
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  const page = settings()
  // The modules in the list: Bags, then Tooltips.
  page.button(Ordaen.art.ctl.switchOn).nth(1).click()
  Test.expect(own.GetAlpha() == 1 && !Test.page().text("13 of 22").shown())
  Test.expect(asked("Bags.follow true, Bags.follow false"))
  page.button(Ordaen.art.ctl.switchOff).click()
  Test.expect(own.GetAlpha() == 0 && Test.page().text("13 of 22").shown())
}

// The tabs

test "each tab says how many items it has, «New» among them while something is new" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(tab("All") == "All | 9" && tab("New") == "New | 1" && tab("Quest items") == "Quest items | 1")
  Test.expect(tab("Consumables") == "Consumables | 1" && tab("Equipment") == "Equipment | 2")
  Test.expect(tab("Trade goods") == "Trade goods | 2" && tab("Recipes") == "Recipes | 1")
  Test.expect(tab("Junk") == "Junk | 1" && bags().text("Other").count() == 2)
}

test "every item shows under «All», a section for each category in the kinds' order, «Free» last" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().button(WELL).count() == 10)
  // A section a category, captioned by its tab's name (there twice: its tab and its caption); no subclass's caption.
  const kinds = [
    kindName(ItemKind.Quest), kindName(ItemKind.Consumables), kindName(ItemKind.Equipment), kindName(ItemKind.Trade), kindName(ItemKind.Recipes), kindName(ItemKind.Other),
    Locale.TAB_JUNK
  ]
  for (kind of kinds) { Test.expect(bags().text(kind).count() == 2) }
  Test.expect(!bags().text("Potion").shown() && !bags().text("Cloth").shown() && !bags().text("One-Handed Swords").shown())
  Test.expect(inOrder([DEED, POTION, SWORD, SHIRT, CLOTH, CLOTH, RECIPE, HEARTH, FOOT]))
  Test.expect(bags().text("Free").shown() && bags().text("13").shown())
}

test "a tab clicked shows its items alone" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button("Equipment").click()
  Test.expect(inOrder([SHIRT, SWORD]) && bags().button(WELL).count() == 3)
  Test.expect(bags().text("Miscellaneous").shown() && !bags().text("Cloth").shown())
  bags().button("Trade goods").click()
  Test.expect(held(CLOTH).count() == 2 && bags().button(WELL).count() == 3)
  bags().button("Junk").click()
  Test.expect(held(FOOT).shown() && bags().button(WELL).count() == 2)
}

test "an item stands in the tab of its class, and a grey one in «Junk» whatever its class" {
  const world = new World([
    { bag: 0, slot: 1, id: 1, name: "Agate", icon: ZIRCON, kind: 3, subkindName: "Kind" },
    { bag: 0, slot: 2, id: 2, name: "Moss", icon: MOSS, kind: 5, subkindName: "Kind" },
    { bag: 0, slot: 3, id: 3, name: "Ash", icon: ASH, kind: 7, subkindName: "Kind" },
    { bag: 0, slot: 4, id: 4, name: "Vest", icon: SHIRT, kind: 4, subkindName: "Kind" },
    { bag: 0, slot: 5, id: 5, name: "Blade", icon: SWORD, kind: 2, subkindName: "Kind" },
    { bag: 0, slot: 6, id: 6, name: "Broken Blade", icon: FOOT, quality: 0, kind: 2, subkindName: "Kind", level: 20 },
    { bag: 0, slot: 7, id: 7, name: "Pattern", icon: RECIPE, kind: 9, subkindName: "Kind" },
    { bag: 0, slot: 8, id: 8, name: "Elixir", icon: POTION, kind: 0, subkindName: "Kind" },
    { bag: 0, slot: 9, id: 9, name: "Letter", icon: DEED, kind: 12, subkindName: "Kind" },
    { bag: 0, slot: 10, id: 10, name: "Stone", icon: HEARTH, kind: 15, subkindName: "Kind" }
  ])
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button("Trade goods").click()
  Test.expect(held(ZIRCON).shown() && held(MOSS).shown() && held(ASH).shown() && bags().button(WELL).count() == 4)
  bags().button("Equipment").click()
  Test.expect(held(SHIRT).shown() && held(SWORD).shown() && bags().button(WELL).count() == 3)
  bags().button("Junk").click()
  Test.expect(held(FOOT).shown() && bags().button(WELL).count() == 2)
  bags().button("Recipes").click()
  Test.expect(held(RECIPE).shown() && bags().button(WELL).count() == 2)
  bags().button("Consumables").click()
  Test.expect(held(POTION).shown() && bags().button(WELL).count() == 2)
  bags().button("Quest items").click()
  Test.expect(held(DEED).shown() && bags().button(WELL).count() == 2)
  bags().button("Other").click()
  Test.expect(held(HEARTH).shown() && bags().button(WELL).count() == 2)
}

test "the cursor on a new item: new no more, its glow gone, the game told, and «New» goes" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(held(SHIRT).paintedWith(NEW_GLOW) && !held(SWORD).paintedWith(NEW_GLOW))
  _ = Test.requests()
  held(SHIRT).hover()
  Test.expect(asked("Items.showBag 0 9, Bags.seen 0 9"))
  Test.expect(!held(SHIRT).paintedWith(NEW_GLOW) && !bags().text("New").shown())
  // Looked at again: nothing more to tell.
  held(SWORD).hover()
  held(SHIRT).hover()
  Test.expect(asked("Items.showBag 0 4, Items.showBag 0 9"))
}

test "«New» picked shows the new items in one section; once none is new the window shows every item" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button("New").click()
  Test.expect(held(SHIRT).shown() && bags().button(WELL).count() == 2 && !bags().text("Miscellaneous").shown())
  held(SHIRT).hover()
  Test.expect(bags().button(WELL).count() == 10)
}

test "an item come into the bags new is told under «New»" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().shown())
  world.at(0, 3).isNew = true
  Game.bags.updated.emit(0)
  Test.expect(tab("New") == "New | 2")
}

// The views

test "the view «By bag»: a section per bag, captioned by its name and fill, its empty slots too" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  pick(Ordaen.art.ctl.tool.categories, "By bag")
  Test.expect(bags().text("Backpack").shown() && bags().text("7/16").shown())
  Test.expect(bags().text("Linen Bag").shown() && bags().text("2/6").shown())
  Test.expect(bags().button(WELL).count() == 22 && !bags().text("All").shown() && !bags().text("Free").shown())
  Test.expect(nth(1).paintedWith(HEARTH) && nth(9).paintedWith(SHIRT) && nth(18).paintedWith(RECIPE))
}

