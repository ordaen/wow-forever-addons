// The bag slots

test "the bag button opens the bag slots: each bag with its name and fill, one with no slots left out" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  const window = bagSlots()
  Test.expect(reads(window, "Backpack | 7/16 | Linen Bag | 2/6 | Bag slots"))
  Test.expect(window.box(BACKPACK).shown() && window.box(LINEN_BAG).shown())
}

test "the cursor on a bag lights its items, every other dimmed, and shows the bag's tooltip; off it, nothing is dimmed" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  _ = Test.requests()
  Test.page().text("Linen Bag").hover()
  Test.expect(held(RECIPE).opacity() == 1 && held(POTION).opacity() == DIMMED && asked("Items.show 4238"))
  Test.page().text("Backpack").hover()
  // The backpack is no item: no tooltip.
  Test.expect(held(RECIPE).opacity() == DIMMED && held(POTION).opacity() == 1 && Test.requests().length == 0)
  bags().text("13 of 22").hover()
  Test.expect(held(RECIPE).opacity() == 1 && held(POTION).opacity() == 1)
}

test "the bag slots close with their close and with the bag button, and open again with it" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  const window = bagSlots()
  window.text("Backpack").hover()
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!window.shown())
  bags().button(BAG_BUTTON).click()
  Test.expect(window.shown())
  bags().button(BAG_BUTTON).click()
  Test.expect(!window.shown())
}

test "the bag under the cursor is shaded, its name in ink and its fill in the labels' colour" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  const row = bagSlots().text("Linen Bag").item()
  Test.expect(!row.paintedWith(SHADE) && row.text("Linen Bag").textColor().equal(INK) && row.text("2/6").textColor().equal(LABEL))
  row.hover()
  Test.expect(row.paintedWith(SHADE))
  bagSlots().text("Backpack").hover()
  Test.expect(!row.paintedWith(SHADE))
}

test "the bag slots follow the bags: a bag swapped shows its icon, its slots and what came in" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.size = (bag: Integer): Integer => world.size(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  world.sizes[2] = 10
  world.linenIcon = BIG_BAG
  world.items.push({ bag: 1, slot: 10, id: 118, name: "Minor Healing Potion", icon: POTION, kind: 0 })
  Game.bags.updated.emit(1)
  Test.expect(reads(bagSlots().text("Linen Bag").item(), "Linen Bag | 3/10") && bagSlots().box(BIG_BAG).shown())
  Test.expect(!bagSlots().box(LINEN_BAG).shown())
}

test "the bag slots shut with the bags and open with them; a bag lit when they shut is lit no more" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.items.icon = (id: Integer): Art | nil => world.icon(id)
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  bags().button(BAG_BUTTON).click()
  Test.page().text("Linen Bag").hover()
  Game.bags.open = false
  Test.expect(!bagSlots().shown())
  Game.bags.open = true
  Test.expect(bagSlots().shown() && held(POTION).opacity() == 1)
}

// The footer

test "the footer says the free slots of the total, and the currency the player follows" {
  const world = new World(everyday())
  Game.bags.bag = (bag: Integer): Game.BagInfo => world.bag(bag)
  Game.bags.readSlot = (bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean => world.read(bag, slot, mut into)
  Game.money.amount = 123456
  Game.money.tracked = "12 Marks"
  Test.mount(nil, SCREEN)
  Game.bags.open = true
  Test.expect(bags().text("13 of 22").shown() && bags().text("12 Marks").shown())
  Test.expect(bags().text(Game.money.format(123456)).shown())
  Game.money.tracked = "13 Marks"
  Test.expect(bags().text("13 Marks").shown() && !bags().text("12 Marks").shown())
}

test "the cursor on the gold: this character's, then this realm's others by how much (alike, by name), the total; off it, gone" {
  // Each character logged in once with its gold: «Player» first, then four more, one on another realm.
  Game.money.amount = 500
  Test.mount(nil, SCREEN)
  Test.flush()
  Test.login({ guid: "Player-1-0000002", name: "Abe", surname: nil })
  Game.money.amount = 300
  Test.flush()
  Test.login({ guid: "Player-1-0000003", name: "Zed", surname: nil })
  Game.money.amount = 900
  Test.flush()
  Test.login({ guid: "Player-1-0000004", name: "Kit", surname: nil })
  Game.money.amount = 500
  Test.flush()
  Test.login({ guid: "Player-2-0000005", name: "Far", surname: nil, realm: "Elsewhere" })
  Game.money.amount = 5000
  Test.flush()
  Test.login({ guid: "Player-1-0000006", name: "Dancer", surname: nil })
  Game.money.amount = 100
  Game.bags.open = true
  bags().text(Game.money.format(100)).hover()
  const rows = [
    "Dancer", Game.money.format(100), "Zed", Game.money.format(900), "Kit", Game.money.format(500), "Player",
    Game.money.format(500), "Abe", Game.money.format(300), Locale.GOLD_TOTAL, Game.money.format(2300)
  ]
  Test.expect(reads(Test.page().window(Locale.GOLD), `${Locale.GOLD} | ${rows.join(" | ")}`))
  bags().input().hover()
  Test.expect(!Test.page().window(Locale.GOLD).shown())
}

test "fifty characters' gold is kept, this one's among them" {
  // Forty-nine other characters' gold, as the sessions before left it.
  let characters: Map<String, Purse> = {}
  for (index of 1..49) {
    characters[`Player-1-${index}`] = { name: `Alt${index}`, realm: "Stand-in", copper: 100, seen: 1000 + index }
  }
  Game.saved.store(.Account, "OrdaenBags:memory", Purses { characters: characters })
  Test.mount(nil, SCREEN)
  Test.reload()
  Game.bags.open = true
  bags().text(Game.money.format(0)).hover()
  const tip = Test.page().window(Locale.GOLD)
  Test.expect(tip.text("Alt1").shown() && tip.text("Alt49").shown() && tip.text(Game.money.format(4900)).shown())
}

test "past fifty characters the one seen longest ago is forgotten" {
  // Fifty other characters' gold, as the sessions before left it: the first seen longest ago.
  let characters: Map<String, Purse> = {}
  for (index of 1..50) {
    characters[`Player-1-${index}`] = { name: `Alt${index}`, realm: "Stand-in", copper: 100, seen: 1000 + index }
  }
  Game.saved.store(.Account, "OrdaenBags:memory", Purses { characters: characters })
  Test.mount(nil, SCREEN)
  Test.reload()
  Game.bags.open = true
  bags().text(Game.money.format(0)).hover()
  const tip = Test.page().window(Locale.GOLD)
  Test.expect(!tip.text("Alt1").shown() && tip.text("Alt2").shown() && tip.text("Alt50").shown())
  Test.expect(tip.text(Game.money.format(4900)).shown())
}

