}

test "«Sort the bags» swaps as many pairs in a go as touch no slot twice, and the rest at the next go" {
  // Into the letter, the elixir, the vest, the ash.
  const world = new World([
    { bag: 0, slot: 1, id: 1, name: "Ash", icon: ASH, kind: 7 },
    { bag: 0, slot: 2, id: 2, name: "Letter", icon: DEED, kind: 12 },
    { bag: 0, slot: 3, id: 3, name: "Elixir", icon: POTION, kind: 0 },
    { bag: 0, slot: 4, id: 4, name: "Vest", icon: SHIRT, kind: 4 }
