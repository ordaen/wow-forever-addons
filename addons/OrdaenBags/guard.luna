// A slot protected from «Sort the bags», and what Ordaen Tooltips' item tooltip says of the slot under the cursor: that
// it is protected («This slot is protected from sorting», among what other modules add), and its clicks as the
// player's scheme has them («Left-click: Pick up»), each that does something to this slot. Without Ordaen Tooltips there
// is no such line: Bags adds nothing to the game's own tooltip.
import root Tooltips from "OrdaenTooltips"
import type { ItemKeys, ItemLines, Line } from "OrdaenTooltips"
import { CHORDS, SlotAction, actionAt, actionName, chordName } from "@/clicks"
import Locale from "@/locales"
import { Slot } from "@/model"
import { Choices } from "@/pane"
import { socketable, whyText } from "@/slotMenu"
import { Vault } from "@/vault"

// A protected slot, kept for the character: where it is and the item it protects. The protection follows its item:
// moved by hand, it goes with it; the item gone from the bags, it is dropped.
public struct Guard implements Plain {
  bag: Integer
  slot: Integer
  id: Integer
}

const NONE: Array<Line> = []
const NO_KEYS: Array<String> = []

// The slot the cursor is on, as the window says it.
public class Hovered {
  public state slot: Slot | nil = nil
}

// The notes of the slot under the cursor: why its item is junk, and that it is protected.
public class GuardLine implements ItemLines {
  const hovered: Hovered
  constructor(hovered: Hovered) { self.hovered = hovered }

  public lines(self, item: Integer, link: String): Array<Line> {
    const slot = self.hovered.slot
    if (slot == nil || slot.id != item) { return NONE }
    const why = slot.why
    if (why != nil && slot.guarded) { return [{ left: Locale.JUNK_NOTE.format(whyText(why)) }, { left: Locale.PROTECTED }] }
    if (why != nil) { return [{ left: Locale.JUNK_NOTE.format(whyText(why)) }] }
    if (slot.guarded) { return [{ left: Locale.PROTECTED }] }
    return NONE
  }
}

// The clicks of a slot of the bags, the bank or the guild bank, as the player's scheme has them.
public class GuardKey implements ItemKeys {
  const hovered: Hovered
  choices: Signal<Choices>
  constructor(hovered: Hovered, choices: Signal<Choices>) {
    self.hovered = hovered
    self.choices = choices
  }

  public keys(self, item: Integer, link: String): Array<String> {
    const slot = self.hovered.slot
    if (slot == nil || slot.id != item) { return NO_KEYS }
    let keys: Array<String> = []
    for (chord of CHORDS) {
      const action = actionAt(self.choices.clicks, chord)
      if (takes(slot, action)) { keys.push(Locale.KEY_CLICK.format(chordName(chord), clickName(slot, action))) }
    }
    return keys
  }
}

// Whether a click's action does something to the slot: protecting and sending are the bags' alone, sockets gear's.
function takes(slot: Slot, action: SlotAction): Boolean {
  return match (action) {
    .Nothing => false
    .Protect => slot.vault == Vault.Bags
    .Send => slot.vault == Vault.Bags
    .Socket => socketable(slot)
    else => true
  }
}

// What a click does, as its hint says it: protecting, what it does to the slot now.
function clickName(slot: Slot, action: SlotAction): String {
  if (action == SlotAction.Protect) { return slot.guarded ? Locale.MENU_UNPROTECT : Locale.MENU_PROTECT }
  return actionName(action)
}

// Both added to Tooltips while it is on: the watch's run owns them, so they end when either module does.
public class GuardTips {
  const line: GuardLine
  const key: GuardKey

  constructor(hovered: Hovered, choices: Signal<Choices>) {
    self.line = new GuardLine(hovered)
    self.key = new GuardKey(hovered, choices)
    watch (tooltips of Tooltips) {
      if (tooltips == nil) { return }
      tooltips.held.add(self.line)
      tooltips.keys.add(self.key)
    }
  }
}
