// «Shopping list», a window docked at the screen's right, opened from «Buy» (design `auction/shopping`): each item with
// what asked for it, what is left to buy (dim at 0) over what this character holds of what is needed, its price with
// the price's age, the sum, and
// at the house «Buy N»: a commodity bought as one purchase of N in two clicks (the second confirms the price the
// client gave, which the row's sum shows), an item one auction a click, the cheapest first. A row's listings are asked
// as it is picked or its «Buy N» first clicked. «Search all» browses every item in one query; a row picked can be
// removed, and «Remove bought» clears every row at 0.
import Game from "$game"
import { Align, Frame, Track } from "$ltml"
import { Age, ButtonPlate, Column, Component, FooterCount, ItemButton, ItemId, ListFooter, ModuleMemory, Money, PushButton, SECONDARY_TEXT, Table, TableCell, TableRow } from "Ordaen"
import { ageOf } from "@/buy"
import { nameOf } from "@/house"
import Locale from "@/locales"
import { Purchase } from "@/purchase"
import { PriceKey, PriceSource, Quote } from "@/quote"
import { Market, Row, ShoppingList, marketOf } from "@/shopping"
import Style from "@/style"
import { Source } from "@/wanted"

// A window docked at the screen's right is narrow: what is held and needed stands under what is left to buy, the
// price's age under the price.
const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_ITEM, width: { fr: 1 } },
  { title: Locale.COLUMN_TO_BUY, width: 131.25dp, align: Align.End },
  { title: Locale.COLUMN_PRICE, width: 117.1875dp, align: Align.End },
  { title: Locale.COLUMN_TOTAL, width: 105.46875dp, align: Align.End },
  { title: "", width: 126.5625dp, align: Align.End }
]
const ITEM: Array<Track> = ["max-content", { fr: 1 }]
const LINES: Array<Track> = ["max-content", "max-content"]
const PRICE: Array<Track> = ["max-content", "max-content"]
// The total over the list, the list (the rest of the window's height), the buttons under it.
const PAGE: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
const FILL: Array<Track> = [{ fr: 1 }]
const HEAD: Array<Track> = [{ fr: 1 }, "max-content", "max-content"]
// The footer has its buttons alone.
const NO_COUNTS: Array<FooterCount> = []

// What asked for a line, as the row says it: «Bronze Axe ×5 — Regron's queue», «by hand».
function sourceText(source: Source): String {
  return match (source) {
    .Queue => Locale.QUEUE_LINE.format(Game.spells.name(source.recipe) ?? Locale.UNKNOWN_RECIPE.format(source.recipe),
      source.crafts, source.character)
    .ByHand => Locale.BY_HAND
  }
}

// Under the item's name, its sources on one line: every row is as high as the others.
function linesText(row: Row): String {
  let text = ""
  for (index, line of row.lines) {
    text = text + (index == 1 ? "" : ", ") + sourceText(line.source)
  }
  return text
}

// What one costs, and how old the price is; none where no price is known.
function quoteOf(prices: any PriceSource, item: ItemId): Quote | nil {
  _ = prices.revision
  return prices.buy(PriceKey.of(item))
}

class ShoppingRow implements Component {
  public pick: Event<ItemId> = new Event()
  public buy: Event<ItemId> = new Event()

  derived quoted: Integer = self.quotedItem == self.row.item ? self.quotedTotal : 0
  derived quote: Quote | nil = quoteOf(self.prices, self.row.item)
  derived priced: Boolean = self.quote != nil
  derived unit: Integer = self.quote?.copper() ?? 0
  derived sum: Integer = self.quoted > 0 ? self.quoted : self.unit * self.row.toBuy
  derived age: Number | nil = ageOf(self.quote)
  derived ink: Color = self.row.toBuy == 0 ? Style.DIM : Style.INK
  derived name: String = self.nameText()
  derived color: Color = self.row.toBuy == 0 ? Style.DIM : self.nameColor()
  derived from: String = linesText(self.row)
  derived bought: Boolean = self.row.toBuy == 0
  derived buyLabel: String = self.bought ? Locale.BOUGHT : self.quoted > 0 ? Locale.CONFIRM :
    Locale.BUY_COUNT.format(self.row.toBuy)
  derived canBuy: Boolean = self.priced && !self.bought && !Game.auctionActions.busy

  // The row's line of the list: the table hands the row to another line as it scrolls.
  row: Signal<Row>
  const prices: any PriceSource
  selected: Signal<Boolean>
  quotedItem: Signal<ItemId | nil>
  quotedTotal: Signal<Integer>
  constructor(
    row: Signal<Row>,
    prices: any PriceSource,
    selected: Signal<Boolean>,
    // The item whose purchase the client priced (none for none), and what it asked, in copper.
    quotedItem: Signal<ItemId | nil>,
    quotedTotal: Signal<Integer>
  ) {
    self.row = row
    self.prices = prices
    self.selected = selected
    self.quotedItem = quotedItem
    self.quotedTotal = quotedTotal
  }

  nameText(self): String {
    const name, _ = nameOf(self.row.item)
    return name
  }

  nameColor(self): Color {
    const _, color = nameOf(self.row.item)
    return color
  }

  onPick(self) { self.pick.emit(self.row.item) }

  // From the player's click alone: the page buys with it.
  onBuy(self) { self.buy.emit(self.row.item) }

  // The item's tooltip beside its whole row.
  onRowEnter(self, frame: any Frame) {
    Game.items.show(frame, self.row.item)
  }

  public render(self): Template {
    return $ltml {
      <TableRow selected={self.selected} @pick={self.onPick} @enter={self.onRowEnter}>
        <TableCell>
          <box columns={ITEM} gap={2.5sp} yAlign={Align.Center}>
            <ItemButton item={self.row.item} size={Style.SLOT} dimmed={self.bought} tipped={false} />
            // Its name and what asked for it, cut at the column: a long list of what asked would push the row.
            <box rows={["max-content", "max-content"]}>
              <text value={self.name} textColor={self.color} wrap={.Cut} />
              <text value={self.from} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.Cut} />
            </box>
          </box>
        </TableCell>
        <TableCell align={Align.End}>
          <box rows={LINES} xAlign={Align.End}>
            <text value={"%d"} arguments={[self.row.toBuy]} textColor={self.ink} />
            <text value={Locale.HELD_OF} arguments={[self.row.held, self.row.needed]} textColor={Style.DIM}
                  textSize={SECONDARY_TEXT} wrap={.None} />
          </box>
        </TableCell>
        <TableCell align={Align.End}>
          <box $if={self.priced} rows={LINES} xAlign={Align.End}>
            <Money amount={self.unit} />
            <Age seconds={self.age} />
          </box>
          <text $else value={"—"} textColor={Style.DIM} />
        </TableCell>
        <TableCell align={Align.End}>
          <Money $if={self.priced} amount={self.sum} />
          <text $else value={"—"} textColor={Style.DIM} />
        </TableCell>
        <TableCell align={Align.End}>
          <PushButton label={self.buyLabel} width={112.5dp} disabled={!self.canBuy} @click={self.onBuy} />
        </TableCell>
      </TableRow>
    }
  }
}

// How the player left the shopping list: the column it is sorted by (0: as it comes) and which way.
public struct ShoppingView implements Plain {
  sorted: Integer = 0
  descending: Boolean = false
}
const SHOPPING_VIEW: ShoppingView = {}

public class ShoppingPage implements Component {
  // How the player left the list, the profile's (`ModuleMemory`).
  public kept: mut ModuleMemory<ShoppingView> = new ModuleMemory<ShoppingView>(SHOPPING_VIEW, .Profile, "shopping")
  state picked: ItemId | nil = nil
  // The purchase of the row picked: its listings, then what the player's clicks buy.
  state purchase: mut Purchase | nil = nil
  // The list's rows bought at the page's market, every row for none.
  derived rows: Array<Row> = self.list.rows.filter(row => self.market == nil || marketOf(self.prices, row.item) == self.market)
  derived empty: Boolean = self.rows.length == 0
  derived chosen: Boolean = self.chosenOf()
  // The row whose purchase the client priced, none for none, and the price.
  derived quotedItem: ItemId | nil = self.quotedItemOf()
  derived quotedTotal: Integer = self.purchase?.quotedTotal ?? 0
  // Every row's sum, and whether a row without a price left it short.
  derived total: Integer = self.totalOf()
  derived short: Boolean = self.rows.any(row => row.toBuy > 0 && quoteOf(self.prices, row.item) == nil)
  // Searched and bought from at the house alone.
  derived away: Boolean = self.empty || !Game.auctionHouse.open

  const prices: any PriceSource
  list: mut ShoppingList
  const market: Market | nil
  constructor(prices: any PriceSource, list: mut ShoppingList, market: Market | nil = nil) {
    self.prices = prices
    self.list = list
    self.market = market
  }

  // The row picked, while it is on the list.
  chosenOf(self): Boolean {
    const picked = self.picked
    return picked != nil && self.list.needed[picked] != nil
  }

  quotedItemOf(self): ItemId | nil {
    const purchase = self.purchase
    if (purchase == nil || purchase.quotedCount == 0) { return nil }
    return purchase.key.item()
  }

  totalOf(self): Integer {
    let copper = 0
    for (row of self.rows) { copper += (quoteOf(self.prices, row.item)?.copper() ?? 0) * row.toBuy }
    return copper
  }

  // The row's listings asked, unless they are its purchase's already.
  pickPurchase(mut self, item: ItemId) {
    const held = self.purchase
    if (held != nil && held.key == PriceKey.of(item)) { return }
    destroy self.purchase
    self.purchase = new Purchase(PriceKey.of(item))
  }

  onPick(mut self, item: ItemId) {
    self.picked = item
    self.pickPurchase(item)
  }

  // From the player's click alone: the row's purchase bought from, or its listings asked first.
  onBuy(mut self, item: ItemId) {
    self.picked = item
    const toBuy = (peek self.rows).find(row => row.item == item)?.toBuy ?? 0
    const held = self.purchase
    if (held != nil && held.key == PriceKey.of(item) && peek held.listed) {
      _ = held.buy(toBuy)
      return
    }
    self.pickPurchase(item)
  }

  onSearch(self) { _ = self.list.searchAll() }

  onRemove(mut self) {
    const picked = self.picked
    if (picked == nil) { return }
    self.list.remove(picked)
    self.picked = nil
    destroy self.purchase
  }

  onClear(mut self) { self.list.clearBought() }

  public render(self): Template {
    return $ltml {
      <box rows={PAGE} gap={3sp}>
        <box columns={HEAD} gap={3sp} yAlign={Align.Center}>
          <text value={Locale.HELD_HERE} textColor={Style.DIM} textSize={SECONDARY_TEXT} />
          <text value={Locale.TOTAL_TO_BUY} textColor={Style.DIM} wrap={.None} />
          <box columns={PRICE} yAlign={Align.Center}>
            <text $if={self.short} value={"~"} textColor={Style.INK} wrap={.None} />
            <Money amount={self.total} />
          </box>
        </box>
        <box rows={FILL}>
          <Table columns={COLUMNS} sorted={mut self.kept.values.sorted} descending={mut self.kept.values.descending}>
            <ShoppingRow $for={row of self.rows} $key={row} row={row} prices={self.prices}
                         selected={self.picked == row.item}
                         quotedItem={self.quotedItem} quotedTotal={self.quotedTotal} @pick={self.onPick}
                         @buy={self.onBuy} />
            <box $if={self.empty} padding={Style.NOTE_PAD} yAlign={Align.Center}>
              <text value={Locale.SHOPPING_EMPTY} textColor={Style.DIM} />
            </box>
          </Table>
        </box>
        <ListFooter counts={NO_COUNTS}>
          <PushButton label={Locale.SEARCH_ALL} width={175.78125dp} plate={ButtonPlate.Accent} disabled={self.away}
                      @click={self.onSearch} />
          <PushButton label={Locale.REMOVE_BOUGHT} width={199.21875dp} disabled={self.empty} @click={self.onClear} />
          <PushButton label={Locale.REMOVE} width={152.34375dp} disabled={!self.chosen} @click={self.onRemove} />
        </ListFooter>
      </box>
    }
  }
}
