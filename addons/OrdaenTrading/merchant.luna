// The merchant's window, in place of the game's while a merchant is open: two tabs, the merchant's goods and what the
// player sold it this visit (its buyback), and the right column beside them, always there: the player's money and the
// merchant's currencies, the item sold last while the goods show, «Sell junk» with what the bags' junk brings, the
// repairs where the merchant repairs («Repair an item» lit while the cursor mends). The goods: every item at once in two
// columns that scroll (no pages), by the merchant's list, by category, or as a table, a quest's item marked with the
// game's «!»; the search, the sort and the filter dim nothing but leave out what doesn't fit; the footer counts what
// shows. An item's left click or drag puts it onto the cursor, its right click buys one purchase, Shift+Left-click asks
// how many, Shift+Right-click puts its link into the chat, Ctrl tries it on, Alt is the client's modified click; a price
// at or past the game's asking price (15 gold) or one paid in items or currencies is asked first, as the game asks (one
// that can't be refunded says so). The buyback's click buys the item back.
import Game from "$game"
import { Align, Art, Columns, Cursor, Edges, Event, Frame, MouseButton, Position, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { ARTWORK, ButtonPlate, Choice, Column, Component, CountInput, Dialog, FoldCaption, FooterCount, ITEM_KINDS, ItemButton, ItemKind, KeptWindow, ListFooter, Menu, MenuEntry, ModuleMemory, Money, PushButton, SECONDARY_TEXT, ScrolledList, Table, TableCell, TableRow, ToolPick, Toolbar, Window, WindowSide, WindowTabSpec, kindName } from "Ordaen"
import Locale from "@/locales"
import { Sold, Vendor, Ware } from "@/vendor"

// How the goods show: two columns in the merchant's order, by category, or as a table.
public enum WareView implements Plain { List = "list", Categories = "categories", Table = "table" }
public enum WareSort implements Plain { Merchant = "merchant", Name = "name", Price = "price", Usable = "usable" }
public enum WareFilter implements Plain { All = "all", Usable = "usable", Affordable = "affordable" }

// How the player left the merchant's window, the profile's: the view, the sort, the filter, the table's column (0: the
// merchant's order) and its way. The search isn't kept.
public struct MerchantView implements Plain {
  view: WareView = WareView::List
  sort: WareSort = WareSort::Merchant
  filter: WareFilter = WareFilter::All
  sorted: integer = 0
  descending: boolean = false
}
public const MERCHANT_VIEW: MerchantView = {}

// A purchase waiting for the player's word: the item, and how many (nil: one purchase of the merchant's stack).
struct Purchase {
  const ware: Ware
  const count: integer | nil
}

// The game's own price past which a purchase is asked first (`MERCHANT_HIGH_PRICE_COST`).
// The window keeps no room of its own: its toolbar has the page's side room, its list runs to the frame.
const NO_ROOM: Edges = {}
const TOOL_ROOM: Edges = { top: 8sp, right: 8sp, left: 8sp }

const HIGH_PRICE = 1500000
const INK: Color = Color::hex("#e8dcc4")
const DIM: Color = Color::hex("#a3977f")
const RED: Color = Color::hex("#ff4040")
// The tabs' icons, the client's own: a merchant's coins, and the game's buyback icon.
const VENDOR_ICON: Asset = "Interface/Icons/INV_Misc_Coin_02"
const BUYBACK_ICON: Asset = "Interface/MerchantFrame/UI-BuyBack-Icon"
// The buyback's tab, the second.
const BUYBACK_TAB = 2
// «Repair an item»'s hammer: the game's blacksmith's icon.
const REPAIR_ICON: Asset = "Interface/Icons/Trade_BlackSmithing"
// The game's «!» over the icon of an item that starts a quest (`TEXTURE_ITEM_QUEST_BANG`).
const QUEST_BANG: Asset = "Interface/ContainerFrame/UI-Icon-QuestBang"
const COST_ICON = 16.40625dp
// A grid slot: the bags' own size before the player could choose one.
const SLOT = 43.359375dp
// A table row: an item's slot and the row's padding round it.
const TABLE_SLOT = 28.125dp
const TABLE_CELL: array<Track> = [TABLE_SLOT, { fr: 1 }]
public const SIDE_WIDTH = 234.375dp
const DIALOG = 375dp
const BUTTON = 140.625dp
const CELL: array<Track> = [SLOT, { fr: 1 }]
const PAIR: array<Track> = [{ fr: 1 }, "max-content"]
const BODY: array<Track> = ["max-content", { fr: 1 }]
const FILL: array<Track> = [{ fr: 1 }]
const SIDE: array<Track> = ["max-content", { fr: 1 }, "max-content"]
const COST: array<Track> = ["max-content", "max-content"]
// The money, then each part of what it costs besides.
const PRICE: Columns = { each: "max-content" }
const VIEWS: array<Choice<WareView>> = [
  { value: WareView::List, label: Locale::VIEW_LIST, icon: ARTWORK.ctl.tool.list },
  { value: WareView::Categories, label: Locale::VIEW_CATEGORIES, icon: ARTWORK.ctl.tool.categories },
  { value: WareView::Table, label: Locale::VIEW_TABLE, icon: ARTWORK.ctl.tool.table }
]
const SORTS: array<Choice<WareSort>> = [
  { value: WareSort::Merchant, label: Locale::SORT_MERCHANT },
  { value: WareSort::Name, label: Locale::SORT_NAME },
  { value: WareSort::Price, label: Locale::SORT_PRICE },
  { value: WareSort::Usable, label: Locale::SORT_USABLE }
]
const FILTERS: array<Choice<WareFilter>> = [
  { value: WareFilter::All, label: Locale::FILTER_ALL },
  { value: WareFilter::Usable, label: Locale::FILTER_USABLE },
  { value: WareFilter::Affordable, label: Locale::FILTER_AFFORDABLE }
]
const COLUMNS: array<Column> = [
  { title: Locale::COLUMN_ITEM, width: { fr: 1 }, sortable: true },
  { title: Locale::COLUMN_TYPE, width: 93.75dp, sortable: true },
  { title: Locale::COLUMN_LEVEL, width: 56.25dp, align: Align::End, sortable: true },
  { title: Locale::COLUMN_IN_BAGS, width: 93.75dp, align: Align::End, sortable: true },
  { title: Locale::COLUMN_PRICE, width: 117.1875dp, align: Align::End, sortable: true }
]

// Whether the item stays in the list: its name holds the search, and the filter keeps it.
function kept(ware: Ware, filter: WareFilter, query: string, money: integer): boolean {
  if (query != "" && !ware.name.lower().contains(query)) { return false }
  return match (filter) {
    .All => true
    .Usable => ware.usable
    .Affordable => ware.price <= money
  }
}

// Whether `a` stands before `b` by the sort; the merchant's order where they are alike.
function before(a: Ware, b: Ware, sort: WareSort): boolean {
  match (sort) {
    .Name => {
      if (a.name != b.name) { return a.name < b.name }
    }
    .Price => {
      if (a.price != b.price) { return a.price < b.price }
    }
    .Usable => {
      if (a.usable != b.usable) { return a.usable }
    }
    .Merchant => {}
  }
  return a.index < b.index
}

// The table's order: by its column (1 the name, 2 the type, 3 the level, 4 how many the bags hold, 5 the price), the
// merchant's where they are alike or none is picked.
function tableBefore(a: Ware, b: Ware, column: integer, descending: boolean): boolean {
  const ka = columnKey(a, column)
  const kb = columnKey(b, column)
  if (ka != kb) { return descending ? kb < ka : ka < kb }
  return a.index < b.index
}

function columnKey(ware: Ware, column: integer): string {
  return match (column) {
    1 => ware.name
    2 => ware.kind
    3 => "%08d".format(ware.level)
    4 => "%08d".format(Game::items.inBags(ware.id))
    5 => "%012d".format(ware.price)
    else => ""
  }
}

// What a purchase of `count` items costs in money (nil: one purchase of the merchant's stack).
function moneyFor(ware: Ware, count: integer | nil): integer {
  if (count == nil) { return ware.price }
  return (ware.price * count / ware.stack).ceil()
}

// How many of the item one purchase of the player's choosing takes at most: the merchant's most at once, and what the
// player's money pays for.
function mostFor(ware: Ware, money: integer): integer {
  if (ware.price <= 0) { return ware.most }
  return ware.most.min((money * ware.stack / ware.price).floor())
}

// The line under an item's name: how many the merchant has left, and how many the bags hold.
function stockLine(ware: Ware, carried: integer): string {
  const held = carried > 0 ? Locale::MERCHANT_IN_BAGS.format(carried) : ""
  if (ware.available < 0) { return held }
  const left = Locale::LEFT.format(ware.available)
  return held == "" ? left : `${left} · ${held}`
}

// What a purchase costs besides money: each part, with its icon.
class CostTag implements Component {
  icon: Signal<Art | nil>
  amount: Signal<integer>
  constructor(icon: Signal<Art | nil>, amount: Signal<integer>) {
    self.icon = icon
    self.amount = amount
  }

  public render(): Template {
    return $ltml {
      <box columns={COST} gap={0.5sp} yAlign={Align::Center}>
        <text value={"%d"} arguments={[self.amount]} textColor={INK} textFont={.Numbers} wrap={.None} />
        <box width={COST_ICON} height={COST_ICON} icon={self.icon} />
      </box>
    }
  }
}

// One of the merchant's items: its slot, its name, its price and what it costs besides, and what is left of it.
class WareCell implements Component {
  public pressed: Event<(Ware, Event::Press)> = new Event()
  public dragged: Event<Ware> = new Event()
  // An entry of its menu picked, by its place; the menu closed by a click outside it.
  public chose: Event<integer> = new Event()
  public closed: Event<nil> = new Event()

  derived dear: boolean = self.ware.price > Game::money.amount
  derived priceColor: Color = self.dear ? RED : INK
  derived nameColor: Color = self.ware.usable && self.ware.purchasable ? INK : RED
  derived priced: boolean = self.ware.price > 0
  // The client's coin bag over a ware, red where the player can't afford it.
  derived cursor: Cursor = self.dear ? Cursor::BuyError : Cursor::Buy
  derived stock: string = stockLine(self.ware, Game::items.inBags(self.ware.id))

  ware: Signal<Ware>
  menuShown: Signal<boolean>
  entries: Signal<array<MenuEntry>>
  constructor(ware: Signal<Ware>, menuShown: Signal<boolean>, entries: Signal<array<MenuEntry>>) {
    self.ware = ware
    self.menuShown = menuShown
    self.entries = entries
  }

  onPressed(click: Event::Press) { self.pressed.emit(self.ware, click) }
  onDragged() { self.dragged.emit(self.ware) }
  onChose(place: integer) { self.chose.emit(place) }
  onClosed() { self.closed.emit() }

  public render(): Template {
    return $ltml {
      <box columns={CELL} gap={3sp} yAlign={Align::Center}>
        <Menu $if={self.menuShown} entries={self.entries} title={self.ware.name} @pick={self.onChose} @close={self.onClosed} />
        <ItemButton item={self.ware.id} art={self.ware.icon} count={self.ware.stack} quality={self.ware.quality}
                    size={SLOT} linkOnShift={false} cursor={self.cursor} @pressed={self.onPressed}
                    @dragged={self.onDragged}>
          <box $if={self.ware.quest} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               background={QUEST_BANG} />
        </ItemButton>
        <box columns={1}>
          <text value={self.ware.name} textColor={self.nameColor} wrap={.Cut} />
          <box columns={PRICE} gap={2sp} yAlign={Align::Center}>
            <Money $if={self.priced} amount={self.ware.price} color={self.priceColor} />
            <box $else />
            <CostTag $for={cost of self.ware.costs} icon={cost.icon} amount={cost.amount} />
          </box>
          <text value={self.stock} textColor={DIM} textSize={SECONDARY_TEXT} wrap={.Cut} />
        </box>
      </box>
    }
  }
}

// One item of the buyback: its slot, its name, what buying it back costs. A left click buys it back, a right click
// opens its menu.
class SoldCell implements Component {
  public pressed: Event<(Sold, MouseButton)> = new Event()
  public chose: Event<integer> = new Event()
  public closed: Event<nil> = new Event()

  derived nameColor: Color = self.sold.usable ? INK : RED

  sold: Signal<Sold>
  menuShown: Signal<boolean>
  constructor(sold: Signal<Sold>, menuShown: Signal<boolean>) {
    self.sold = sold
    self.menuShown = menuShown
  }

  onPressed(click: Event::Press) { self.pressed.emit(self.sold, click.button) }
  onChose(place: integer) { self.chose.emit(place) }
  onClosed() { self.closed.emit() }

  public render(): Template {
    return $ltml {
      <box columns={CELL} gap={3sp} yAlign={Align::Center}>
        <Menu $if={self.menuShown} entries={SOLD_ENTRIES} title={self.sold.name} @pick={self.onChose} @close={self.onClosed} />
        <ItemButton item={nil} art={self.sold.icon} count={self.sold.count} size={SLOT} linkOnShift={false}
                    cursor={Cursor::Buy} @pressed={self.onPressed} />
        <box columns={1}>
          <text value={self.sold.name} textColor={self.nameColor} wrap={.Cut} />
          <Money amount={self.sold.price} />
        </box>
      </box>
    }
  }
}

// A category's caption in the categories view: across both columns, its name and how many of its items show; a
// click folds it.
class WareCaption implements Component {
  public toggled: Event<ItemKind> = new Event()
  derived title: string = "%s (%d)".format(kindName(self.tab), self.count)

  const tab: ItemKind
  count: Signal<integer>
  folded: Signal<boolean>
  constructor(tab: ItemKind, count: Signal<integer>, folded: Signal<boolean>) {
    self.tab = tab
    self.count = count
    self.folded = folded
  }

  onToggle() { self.toggled.emit(self.tab) }

  public render(): Template {
    return $ltml {
      <box columnSpan={2}>
        <FoldCaption title={self.title} folded={self.folded} @toggled={self.onToggle} />
      </box>
    }
  }
}

// One item as a row of the table.
class WareTableRow implements Component {
  public pressed: Event<(Ware, MouseButton)> = new Event()
  public chose: Event<integer> = new Event()
  public closed: Event<nil> = new Event()

  derived carried: integer = Game::items.inBags(self.ware.id)
  derived dear: boolean = self.ware.price > Game::money.amount
  derived priceColor: Color = self.dear ? RED : INK
  derived nameColor: Color = self.ware.usable && self.ware.purchasable ? INK : RED

  ware: Signal<Ware>
  menuShown: Signal<boolean>
  entries: Signal<array<MenuEntry>>
  constructor(ware: Signal<Ware>, menuShown: Signal<boolean>, entries: Signal<array<MenuEntry>>) {
    self.ware = ware
    self.menuShown = menuShown
    self.entries = entries
  }

  onPick(button: MouseButton) { self.pressed.emit(self.ware, button) }
  onSlot(click: Event::Press) { self.pressed.emit(self.ware, click.button) }
  onChose(place: integer) { self.chose.emit(place) }
  onClosed() { self.closed.emit() }

  // The item's tooltip beside its whole row.
  onRowEnter(frame: any Frame) {
    Game::items.show(frame, self.ware.id)
  }

  public render(): Template {
    return $ltml {
      <TableRow @pick={self.onPick} @enter={self.onRowEnter}>
        <TableCell>
          <box columns={TABLE_CELL} gap={3sp} yAlign={Align::Center}>
            <ItemButton item={self.ware.id} tipped={false} art={self.ware.icon} count={self.ware.stack} quality={self.ware.quality}
                        size={TABLE_SLOT} linkOnShift={false} @pressed={self.onSlot} />
            <text value={self.ware.name} textColor={self.nameColor} wrap={.Cut} />
          </box>
        </TableCell>
        <TableCell> <text value={self.ware.kind} textColor={DIM} wrap={.Cut} /> </TableCell>
        <TableCell align={Align::End}>
          <text value={"%d"} arguments={[self.ware.level]} textColor={INK} textFont={.Numbers} wrap={.None} />
        </TableCell>
        <TableCell align={Align::End}>
          <text value={"%d"} arguments={[self.carried]} textColor={INK} textFont={.Numbers} wrap={.None} />
        </TableCell>
        <TableCell align={Align::End}>
          <Money amount={self.ware.price} color={self.priceColor} />
        </TableCell>
        <Menu $if={self.menuShown} entries={self.entries} title={self.ware.name} @pick={self.onChose} @close={self.onClosed} />
      </TableRow>
    }
  }
}

public class MerchantWindow implements Component {
  // «Sell junk» in the right column: the bags sell their junk.
  public sellJunk: Event<nil> = new Event()

  state tab = 1
  state search = ""
  state folded: map<ItemKind, boolean> = {}
  // The purchase asked about, and the item whose count is being chosen with the count chosen.
  state asking: Purchase | nil = nil
  state counting: Ware | nil = nil
  state count = 1
  // The item whose menu is open, by its place in the merchant's list, and the buyback's by its place there; 0: none.
  state menuAt = 0
  state soldMenuAt = 0
  derived menuWare: Ware | nil = self.vendor.wares.find(ware => ware.index == self.menuAt)
  derived menuActs: array<WareAct> = actsOf(self.menuWare)
  derived menuEntries: array<MenuEntry> = self.menuActs.map(act => MenuEntry { label: actLabel(act) })

  derived tabs: array<WindowTabSpec> = [
    { title: self.vendor.name == "" ? Locale::MERCHANT : self.vendor.name, desc: nil, icon: VENDOR_ICON },
    { title: Locale::BUYBACK, desc: nil, icon: BUYBACK_ICON }
  ]
  derived buying: boolean = self.tab == 1
  derived query: string = self.search.lower()
  derived shown: array<Ware> = self.shownOf()
  derived tabled: boolean = self.list.values.view == WareView::Table
  derived grouped: boolean = self.list.values.view == WareView::Categories
  derived narrowed: boolean = self.list.values.filter != WareFilter::All
  derived groups: array<ItemKind> = ITEM_KINDS.filter(tab => self.shown.any(ware => ware.tab == tab))
  // The buyback, the newest first.
  derived sold: array<Sold> = self.soldOf()
  derived counts: array<FooterCount> = self.countsOf()
  derived side: WindowSide | nil = { width: SIDE_WIDTH, content: self.column }
  derived junkLabel: string = self.junkWorth > 0 ? `${Locale::SELL_JUNK} ${Game::money.format(self.junkWorth)}` : Locale::SELL_JUNK
  derived repairLabel: string = self.vendor.worn ? `${Locale::REPAIR_ALL} ${Game::money.format(self.vendor.repairCost)}` : Locale::REPAIR_ALL
  derived canRepair: boolean = self.vendor.worn && self.vendor.repairCost <= Game::money.amount
  derived guildRepair: boolean = self.vendor.repairs && self.vendor.guildRepairs && self.vendor.worn
  derived askTitle: string = self.askTitleOf()
  derived askCosts: string = self.askCostsOf()
  // A purchase paid in items or currencies that the merchant won't take back: said as it is asked, as the game does.
  derived askFinal: boolean = self.askFinalOf()
  // «Repair an item» lit while the cursor mends.
  derived repairPlate: ButtonPlate = self.vendor.repairing ? ButtonPlate::Accent : ButtonPlate::Bronze
  // The item sold last, under the goods (the game's buyback slot): a click buys it back.
  derived lastSold: array<Sold> = self.buying && self.vendor.sold.length > 0 ? [self.vendor.sold[self.vendor.sold.length] ?? panic("within the buyback")] : []
  derived hasLastSold: boolean = self.lastSold.length > 0
  derived hasCurrencies: boolean = self.vendor.currencies.length > 0
  derived countMost: integer = self.counting == nil ? 1 : mostFor(self.counting ?? panic("counting"), Game::money.amount)
  derived countPrice: integer = self.counting == nil ? 0 : moneyFor(self.counting ?? panic("counting"), self.count)

  vendor: mut Vendor
  declared: mut KeptWindow
  list: mut ModuleMemory<MerchantView>
  junkCount: Signal<integer>
  junkWorth: Signal<integer>
  constructor(
    vendor: mut Vendor,
    declared: mut KeptWindow,
    list: mut ModuleMemory<MerchantView>,
    junkCount: Signal<integer>,
    junkWorth: Signal<integer>
  ) {
    self.vendor = vendor
    self.declared = declared
    self.list = list
    self.junkCount = junkCount
    self.junkWorth = junkWorth
    watch { self.vendor.buyingBack = self.tab == BUYBACK_TAB }
  }

  shownOf(): array<Ware> {
    const view = self.list.values
    const money = Game::money.amount
    let wares = self.vendor.wares.filter(ware => kept(ware, view.filter, self.query, money))
    if (view.view == WareView::Table) {
      wares.sort((a, b) => tableBefore(a, b, view.sorted, view.descending))
    } else {
      wares.sort((a, b) => before(a, b, view.sort))
    }
    return wares
  }

  soldOf(): array<Sold> {
    let sold: array<Sold> = mut []
    for (index of self.vendor.sold.length..1 step -1) { sold.push(self.vendor.sold[index] ?? panic("within the buyback")) }
    return sold
  }

  countsOf(): array<FooterCount> {
    if (!self.buying) { return [{ label: Locale::FOOT_SOLD, value: string::of(self.vendor.sold.length) }] }
    const all = self.vendor.wares.length
    const shown = self.shown.length
    return [{ label: Locale::FOOT_WARES, value: shown == all ? string::of(all) : Locale::WARES_OF.format(shown, all) }]
  }

  // The items of a category, as the categories view shows them: none while it is folded.
  inGroup(tab: ItemKind): array<Ware> {
    if (self.folded[tab] == true) { return [] }
    return self.shown.filter(ware => ware.tab == tab)
  }

  countIn(tab: ItemKind): integer { return self.shown.count(ware => ware.tab == tab) }

  askTitleOf(): string {
    const asking = self.asking
    if (asking == nil) { return "" }
    const count = asking.count ?? asking.ware.stack
    const price = moneyFor(asking.ware, asking.count)
    const named = count > 1 ? `${asking.ware.name} ×${count}` : asking.ware.name
    return price > 0 ? Locale::ASK_BUY.format(named, Game::money.format(price)) : Locale::ASK_BUY_COSTS.format(named)
  }

  askFinalOf(): boolean {
    const asking = self.asking
    return asking != nil && !asking.ware.refundable && asking.ware.costs.length > 0
  }

  askCostsOf(): string {
    const asking = self.asking
    if (asking == nil) { return "" }
    return asking.ware.costs.map(cost => `${cost.amount} ${cost.name}`).join(", ")
  }

  // A click on an item, in the player's own call: Left buys one purchase (asked first where the game asks), Right opens
  // its menu (buy, how many, try on, link), Shift+Left asks how many, Ctrl tries it on, Alt is the client's modified
  // click; a drag puts it onto the cursor, bought as it is put into a bag.
  mut onWare(ware: Ware, click: Event::Press) {
    if (Game::input.controlDown()) {
      self.vendor.dressUp(ware)
    } else if (Game::input.altDown()) {
      self.vendor.modifiedClick(ware)
    } else if (click.button == MouseButton::Right) {
      self.menuAt = ware.index
    } else if (click.button == MouseButton::Left && Game::input.shiftDown()) {
      self.askCount(ware)
    } else if (click.button == MouseButton::Left) {
      self.purchase(ware, nil)
    }
  }

  // How many of an item to buy, asked where one purchase may take more than one.
  mut askCount(ware: Ware) {
    if (ware.most <= 1) { return }
    self.count = 1
    self.counting = ware
  }

  // An entry of an item's menu picked: the menu closes, and the entry acts on its item.
  mut onChose(place: integer) {
    const ware = peek self.menuWare
    const act = (peek self.menuActs)[place]
    self.menuAt = 0
    if (ware == nil || act == nil) { return }
    match (act) {
      .Buy => { self.purchase(ware, nil) }
      .Several => { self.askCount(ware) }
      .TryOn => { self.vendor.dressUp(ware) }
      .Link => { Game::chat.link(ware.id) }
    }
  }

  mut onMenuClosed() { self.menuAt = 0 }

  // A buyback's item: a left click buys it back, a right click opens its menu.
  mut onSold(sold: Sold, button: MouseButton) {
    if (button == MouseButton::Right) {
      self.soldMenuAt = sold.place
    } else {
      self.vendor.buyBack(sold)
    }
  }

  mut onSoldChose(place: integer) {
    const sold = self.vendor.sold.find(each => each.place == peek self.soldMenuAt)
    self.soldMenuAt = 0
    if (sold != nil && place == 1) { self.vendor.buyBack(sold) }
  }

  mut onSoldMenuClosed() { self.soldMenuAt = 0 }

  mut onDragged(ware: Ware) { self.pickUp(ware) }

  // The item onto the cursor, bought as it lands in a bag; one the game asks about (a high price, a cost in items or
  // currencies) is asked about first, as a purchase.
  mut pickUp(ware: Ware) {
    if (asks(ware, nil)) {
      self.purchase(ware, nil)
    } else {
      self.vendor.pickUp(ware)
    }
  }

  // A row of the table: a left click buys one purchase, a right click opens its menu.
  mut onWareRow(ware: Ware, button: MouseButton) {
    if (button == MouseButton::Right) {
      self.menuAt = ware.index
    } else if (button == MouseButton::Left) {
      self.purchase(ware, nil)
    }
  }

  // A purchase: bought at once, or asked about first where its price reaches the game's asking price or it is paid
  // in items or currencies.
  mut purchase(ware: Ware, count: integer | nil) {
    if (asks(ware, count)) {
      self.asking = { ware: ware, count: count }
      return
    }
    self.vendor.buy(ware, count)
  }

  mut onAsked() {
    const asking = peek self.asking
    self.asking = nil
    if (asking != nil) { self.vendor.buy(asking.ware, asking.count) }
  }

  mut onAskCancel() { self.asking = nil }

  mut onCounted() {
    const ware = peek self.counting
    self.counting = nil
    if (ware != nil) { self.purchase(ware, peek self.count) }
  }

  mut onCountCancel() { self.counting = nil }

  mut onToggle(tab: ItemKind) {
    let folded: map<ItemKind, boolean> = mut {}
    for (each, shut of peek self.folded) { folded[each] = shut }
    folded[tab] = folded[tab] == true ? nil : true
    self.folded = folded
  }

  onSellJunk() { self.sellJunk.emit() }
  onRepair() { self.vendor.repairAll(false) }
  onGuildRepair() { self.vendor.repairAll(true) }
  mut onRepairOne() { self.vendor.repairOne() }
  onClose() { self.vendor.close() }

  // The right column: the money at the top, the buttons at the bottom, the repairs last.
  const column: Template = $ltml {
    <box rows={SIDE} gap={3sp}>
      <box columns={PAIR} gap={3sp}>
        <text value={Locale::YOUR_MONEY} textColor={DIM} wrap={.None} />
        <Money amount={Game::money.amount} />
      </box>
      <box columns={1} gap={3sp}>
        <box $if={self.hasCurrencies} columns={PRICE} gap={3sp} yAlign={Align::Center}>
          <CostTag $for={held of self.vendor.currencies} icon={held.icon} amount={held.amount} />
        </box>
        <box $if={self.hasLastSold} columns={1} gap={2sp}>
          <text value={Locale::LAST_SOLD} textColor={DIM} textSize={SECONDARY_TEXT} wrap={.None} />
          <SoldCell $for={sold of self.lastSold} $key={sold.place} sold={sold} menuShown={self.soldMenuAt == sold.place} @pressed={self.onSold}
                    @chose={self.onSoldChose} @closed={self.onSoldMenuClosed} />
        </box>
      </box>
      <box columns={1} gap={3sp}>
        <PushButton label={self.junkLabel} width={SIDE_WIDTH} disabled={self.junkCount == 0} @click={self.onSellJunk} />
        <PushButton $if={self.guildRepair} label={Locale::REPAIR_GUILD} width={SIDE_WIDTH} @click={self.onGuildRepair} />
        <PushButton $if={self.vendor.repairs} label={Locale::REPAIR_ONE} icon={REPAIR_ICON} width={SIDE_WIDTH} plate={self.repairPlate} @click={self.onRepairOne} />
        <PushButton $if={self.vendor.repairs} label={self.repairLabel} width={SIDE_WIDTH} plate={ButtonPlate::Accent} disabled={!self.canRepair}
                    @click={self.onRepair} />
      </box>
    </box>
  }

  const footer: Template = $ltml {
    <ListFooter counts={self.counts} />
  }

  public render(): Template {
    return $ltml {
      <Window tabs={self.tabs} selected={mut self.tab} declared={mut self.declared} side={self.side} padding={NO_ROOM} footer={self.footer}
              @close={self.onClose}>
        <box $if={self.buying} rows={BODY} gap={6sp}>
          <box padding={TOOL_ROOM}>
            <Toolbar search={mut self.search} placeholder={Locale::MERCHANT_SEARCH}>
              <ToolPick $if={!self.tabled} value={mut self.list.values.sort} choices={SORTS} icon={Ordaen.art.ctl.tool.sort}
                        title={Locale::SORT} />
              <ToolPick value={mut self.list.values.filter} choices={FILTERS} icon={Ordaen.art.ctl.tool.filter}
                        title={Locale::FILTER} lit={self.narrowed} />
              <ToolPick value={mut self.list.values.view} choices={VIEWS} icon={Ordaen.art.ctl.tool.list} title={Locale::VIEW} />
            </Toolbar>
          </box>
          <box $if={self.tabled} rows={FILL}>
            <Table columns={COLUMNS} sorted={mut self.list.values.sorted} descending={mut self.list.values.descending}>
              <WareTableRow $for={ware of self.shown} $key={ware.index} ware={ware} menuShown={self.menuAt == ware.index}
                            entries={self.menuEntries} @pressed={self.onWareRow} @chose={self.onChose} @closed={self.onMenuClosed} />
            </Table>
          </box>
          <ScrolledList $elseif={self.grouped} columns={2} gap={3sp}>
            <$for={tab of self.groups}>
              <WareCaption tab={peek tab} count={self.countIn(tab)} folded={self.folded[tab] == true} @toggled={self.onToggle} />
              <WareCell $for={ware of self.inGroup(tab)} $key={ware.index} ware={ware} menuShown={self.menuAt == ware.index} entries={self.menuEntries}
                        @pressed={self.onWare} @dragged={self.onDragged} @chose={self.onChose} @closed={self.onMenuClosed} />
            </>
          </ScrolledList>
          <ScrolledList $else columns={2} gap={3sp}>
            <WareCell $for={ware of self.shown} $key={ware.index} ware={ware} menuShown={self.menuAt == ware.index} entries={self.menuEntries}
                      @pressed={self.onWare} @dragged={self.onDragged} @chose={self.onChose} @closed={self.onMenuClosed} />
          </ScrolledList>
        </box>
        <ScrolledList $else columns={2} gap={3sp}>
          <SoldCell $for={sold of self.sold} $key={sold.place} sold={sold} menuShown={self.soldMenuAt == sold.place} @pressed={self.onSold}
                    @chose={self.onSoldChose} @closed={self.onSoldMenuClosed} />
        </ScrolledList>
      </Window>
      <Dialog $if={self.asking != nil} width={DIALOG} title={Locale::MERCHANT}>
        <text value={self.askTitle} textColor={INK} />
        <text value={self.askCosts} textColor={DIM} />
        <text $if={self.askFinal} value={Locale::NO_REFUND} textColor={RED} />
        <PushButton #buttons label={Locale::CANCEL} width={BUTTON} @click={self.onAskCancel} />
        <PushButton #buttons label={Locale::BUY} width={BUTTON} plate={ButtonPlate::Accent} @click={self.onAsked} />
      </Dialog>
      <Dialog $if={self.counting != nil} width={DIALOG} title={Locale::HOW_MANY}>
        <box columns={PAIR} gap={3sp} yAlign={Align::Center}>
          <CountInput value={mut self.count} least={1} most={self.countMost} />
          <Money amount={self.countPrice} />
        </box>
        <PushButton #buttons label={Locale::CANCEL} width={BUTTON} @click={self.onCountCancel} />
        <PushButton #buttons label={Locale::BUY} width={BUTTON} plate={ButtonPlate::Accent} @click={self.onCounted} />
      </Dialog>
    }
  }
}

// What an item's menu does: buy one purchase, ask how many (where one purchase may take more than one), try it on,
// link it in the chat.
enum WareAct { Buy, Several, TryOn, Link }

function actsOf(ware: Ware | nil): array<WareAct> {
  if (ware == nil) { return [] }
  return ware.most > 1 ? [.Buy, .Several, .TryOn, .Link] : [.Buy, .TryOn, .Link]
}

function actLabel(act: WareAct): string {
  return match (act) {
    .Buy => Locale::BUY
    .Several => Locale::BUY_SEVERAL
    .TryOn => Locale::TRY_ON
    .Link => Locale::LINK
  }
}

// A buyback's item's menu: buy it back.
const SOLD_ENTRIES: array<MenuEntry> = [{ label: Locale::BUY_BACK }]

// Whether the game asks about a purchase first: its price reaches the game's asking price, or it is paid in items or
// currencies.
function asks(ware: Ware, count: integer | nil): boolean {
  return ware.costs.length > 0 || moneyFor(ware, count) >= HIGH_PRICE
}
