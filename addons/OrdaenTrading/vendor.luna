// The merchant the player stands at, as the merchant window reads it: what it sells (each item with its price, what it
// costs besides money, how many are left, whether the player can use it), what the player sold it this visit (its
// buyback), and its repairs. Read from the client as the merchant opens and as the client says they changed
// (`MERCHANT_UPDATE`, the money, the durability), heard only while it is open.
import Client from "$client"
import Events from "$events"
import { Art } from "$ltml"
import { ItemKind, Quality, kindOf, qualityFrom } from "Ordaen"

// A part of what an item costs besides money: an item or a currency, its icon, how many and its name.
public struct Cost {
  const icon: Art | nil
  const amount: integer
  const name: string
}

// One item the merchant sells, at its place in the merchant's list.
public struct Ware {
  const index: integer
  const id: integer
  const name: string
  const icon: Art | nil
  const quality: Quality
  // The money one purchase costs (`stack` items at once), in copper: 0 for an item bought with its costs alone.
  const price: integer
  const stack: integer
  // How many the merchant has left: -1 for no end.
  const available: integer
  // The player can use it (the client's word: its class, its level), and can buy it at all.
  const usable: boolean
  const purchasable: boolean
  const costs: array<Cost>
  // The most bought in one purchase (`GetMerchantItemMaxStack`).
  const most: integer
  // The level it needs, and the bags' tab its kind falls in: the categories view's caption.
  const level: integer
  const tab: ItemKind
  const kind: string
  // It starts a quest (the game's «!» over its icon); the purchase can be refunded (one paid in items or currencies
  // that can't is said so as it is asked); its link (the dressing room's, the chat's).
  const quest: boolean
  const refundable: boolean
  const link: string | nil
}

// An item sold to the merchant this visit, at its place in the buyback list (the last the newest).
public struct Sold {
  const place: integer
  const name: string
  const icon: Art | nil
  const price: integer
  const count: integer
  const usable: boolean
}

// The client's class of items for a recipe (`Enum.ItemClass.Recipe`), for what has none.
const NO_CLASS = 15

function iconOf(texture: number | string | nil): Art | nil {
  if (texture is FileId) { return texture }
  if (texture is Asset) { return texture }
  return nil
}

// What an item costs besides money, as the merchant's list says it.
function costsOf(index: integer): array<Cost> {
  let costs: array<Cost> = []
  for (part of 1..Client::GetMerchantItemCostInfo(index).floor()) {
    const texture, value, link, name = Client::GetMerchantItemCostItem(index, part)
    if (texture != nil) { costs.push({ icon: iconOf(texture), amount: value.floor(), name: name ?? link ?? "" }) }
  }
  return costs
}

// One item of the merchant's list; none where the client hasn't it (yet).
function wareAt(index: integer): Ware | nil {
  const info = Client::C_MerchantFrame::GetItemInfo(index)
  const id = Client::GetMerchantItemID(index)
  if (info == nil || id == nil) { return nil }
  const _, _, quality, _, level, kind, _, _, _, _, _, classId, _, _, _, _, crafting, _ = Client::C_Item::GetItemInfo(id.floor())
  return {
    index: index, id: id.floor(), name: info.name ?? "", icon: info.texture, quality: qualityFrom(quality),
    price: info.price.floor(), stack: info.stackCount.floor().max(1), available: info.numAvailable.floor(),
    usable: info.isUsable, purchasable: info.isPurchasable, costs: info.hasExtendedCost ? costsOf(index) : [],
    most: Client::GetMerchantItemMaxStack(index).floor().max(1), level: (level ?? 0).floor(),
    tab: kindOf((classId ?? NO_CLASS).floor(), crafting == true), kind: kind ?? "", quest: info.isQuestStartItem,
    refundable: Client::C_MerchantFrame::IsMerchantItemRefundable(index), link: Client::GetMerchantItemLink(index)
  }
}

// What the merchant takes besides money that the player holds (`GetMerchantCurrencies`): each with its icon and how
// many the player has.
function currenciesOf(): array<Cost> {
  let held: array<Cost> = []
  for (id of Client::C_MerchantFrame::GetMerchantCurrencies() ?? []) {
    const info = Client::C_CurrencyInfo::GetCurrencyInfo(id)
    if (info != nil) { held.push({ icon: info.iconFileID, amount: info.quantity.floor(), name: info.name }) }
  }
  return held
}

public class Vendor {
  public state open = false
  // The merchant's window shows the buyback: a slot's use there sells nothing, as the game's window has it.
  public state buyingBack = false
  public state name = ""
  public state wares: array<Ware> = []
  public state sold: array<Sold> = []
  // Whether the merchant repairs; what mending everything worn and carried costs, and whether anything needs it.
  public state repairs = false
  public state repairCost = 0
  public state worn = false
  // The guild pays for the repairs where the player's rank allows it.
  public state guildRepairs = false
  // The client's cursor mends the next item clicked (`InRepairMode`).
  public state repairing = false
  // The currencies the merchant takes, as the player holds them.
  public state currencies: array<Cost> = []

  constructor() {
    Events::MERCHANT_SHOW.listen(self.onShow)
    Events::MERCHANT_CLOSED.listen(self.onClosed)
    watch (open of self.open) {
      if (!open) { return }
      Events::MERCHANT_UPDATE.listen(self.read)
      Events::UPDATE_INVENTORY_DURABILITY.listen(self.readRepairs)
      Events::PLAYER_MONEY.listen(self.readRepairs)
      Events::CURSOR_CHANGED.listen(self.readRepairs)
      Events::CURRENCY_DISPLAY_UPDATE.listen(self.readCurrencies)
    }
  }

  readCurrencies(mut self) { self.currencies = currenciesOf() }

  onShow(mut self) {
    const name, _ = Client::UnitName("npc")
    self.name = name
    self.open = true
    self.read()
  }

  onClosed(mut self) {
    self.open = false
    self.wares = []
    self.sold = []
    self.currencies = []
    self.repairing = false
  }

  // Everything the merchant's window shows, read again.
  public read(mut self) {
    let wares: array<Ware> = []
    for (index of 1..Client::GetMerchantNumItems()) {
      const ware = wareAt(index)
      // A sold-out item leaves the list.
      if (ware != nil && ware.available != 0) { wares.push(ware) }
    }
    self.wares = wares
    let sold: array<Sold> = []
    for (place of 1..Client::GetNumBuybackItems()) {
      const name, texture, price, count, _, usable = Client::GetBuybackItemInfo(place)
      if (name != nil) {
        sold.push({ place: place, name: name, icon: iconOf(texture), price: price.floor(), count: count.floor(), usable: usable })
      }
    }
    self.sold = sold
    self.readCurrencies()
    self.readRepairs()
  }

  readRepairs(mut self) {
    self.repairing = Client::InRepairMode()
    self.repairs = Client::CanMerchantRepair()
    if (!(peek self.repairs)) { return }
    const cost, worn = Client::GetRepairAllCost()
    self.repairCost = cost.floor()
    self.worn = worn
    self.guildRepairs = Client::CanGuildBankRepair()
  }

  // The player's own click: one purchase of the item (`count` items of a stack the merchant sells by one; nil: the
  // merchant's own stack), bought back, mended.
  public buy(self, ware: Ware, count: integer | nil) { Client::BuyMerchantItem(ware.index, count) }
  public buyBack(self, sold: Sold) { Client::BuybackItem(sold.place) }
  public repairAll(self, guild: boolean) { Client::RepairAllItems(guild) }
  // The client's repair cursor: the next item clicked, worn or carried, is mended; again, the cursor is back.
  public repairOne(mut self) {
    if (Client::InRepairMode()) {
      Client::HideRepairCursor()
    } else {
      Client::ShowRepairCursor()
    }
    self.repairing = Client::InRepairMode()
  }
  // The item onto the client's cursor, bought as it is put into a bag.
  public pickUp(self, ware: Ware) { Client::PickupMerchantItem(ware.index) }
  // The item tried on in the dressing room (Ctrl+click), and any other modified click as the client's own buttons take
  // it (the player's bindings).
  public dressUp(self, ware: Ware) {
    if (ware.link != nil) { _ = Client::DressUpItemLink(ware.link) }
  }
  public modifiedClick(self, ware: Ware) {
    if (ware.link != nil) { _ = Client::HandleModifiedItemClick(ware.link) }
  }

  // The window's close leaves the merchant.
  public close(self) {
    if (peek self.open) { Client::CloseMerchant() }
  }
}
