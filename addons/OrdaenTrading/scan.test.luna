}

test "the ledger keeps a row 90 days to the hour, and 1,000 rows at most" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Trading.ledger.record({ kind: "seller", item: "Linen Cloth", other: "Regron", copper: 500, count: 9 })
  Game.clock.server = START + 2160 * HOUR
  Trading.ledger.record({ kind: "buyer", item: "Copper Ore", other: nil, copper: 300, count: 20 })
  const page = data()
  Test.expect(says(page, "Sold: 1", "0g 5s 0c"))
  for (index of 1..998) { Trading.ledger.record({ kind: "buyer", item: "Copper Ore", other: nil, copper: 1, count: 1 }) }
  Test.expect(page.text("Sold: 1").shown() && page.text("Bought: 999").shown())
  Trading.ledger.record({ kind: "buyer", item: "Copper Ore", other: nil, copper: 1, count: 1 })
  Test.expect(page.text("Sold: 0").shown() && page.text("Bought: 1000").shown())
}
