// «Data»

test "«Data» before any scan: never scanned, no counts, nothing at rest, an empty ledger" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const page = data()
  Test.expect(says(page, "Last full scan", "never") && says(page, "Auctions and items in it", "—"))
  Test.expect(says(page, "Items with a price", "0") && says(page, "Saved size", "0 KB"))
  Test.expect(says(page, "Sold: 0", "0g 0s 0c") && says(page, "Bought: 0", "0g 0s 0c"))
}

test "«Data» after a full scan: how long ago, the auctions and items in it, the items priced, the size at rest" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [{ key: ORE, unit: 100, many: 2 }, { key: LINEN, unit: 40, many: 20 }, { key: LINEN, unit: 45, many: 2 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Game.clock.server = START + 300
  const page = data()
  Test.expect(says(page, "Last full scan", "5 min ago") && says(page, "Auctions and items in it", "3 auctions, 2 items"))
  Test.expect(says(page, "Items with a price", "2") && says(page, "Saved size", "1 KB"))
}

test "«Data»'s ledger counts the house's mail the mailbox hands it, and keeps 90 days" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Trading.ledger.record({ kind: "seller", item: "Linen Cloth", other: "Regron", copper: 500, count: 9 })
  Trading.ledger.expired("Linen Cloth", 3)
  Trading.ledger.record({ kind: "buyer", item: "Copper Ore", other: nil, copper: 300, count: 20 })
  const page = data()
  Test.expect(says(page, "Sold: 1", "0g 5s 0c") && says(page, "Bought: 1", "0g 3s 0c"))
  Game.clock.server = START + 2161 * HOUR
  Trading.ledger.record({ kind: "buyer", item: "Copper Bar", other: nil, copper: 100, count: 1 })
  Test.expect(says(page, "Sold: 0", "0g 0s 0c") && says(page, "Bought: 1", "0g 1s 0c"))
}

test "the lowest listed is what one costs to its 48th hour" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [{ key: ORE, unit: 100, many: 2 }, { key: ORE, unit: 300, many: 10 }, { key: ORE, unit: 120, many: 1 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Game.auctionActions.sellable = (): Array<Game.Sellable> | nil => [{ item: ORE, count: 1, bag: 0, slot: 1, commodity: true }]
  Game.clock.server = START + 48 * HOUR
  window().button("Sell").click()
  Test.expect(window().text("Copper Ore").item().text("0g 1s 0c").shown())
}

test "a full scan keeps what was seen 30 days ago to the hour" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 40, quantity: 1 }])
  Game.clock.server = START + 720 * HOUR
  const sold: Array<Sale> = [{ key: ORE, unit: 100, many: 1 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Test.expect(window().text("Prices: just now · 2 items").shown())
}

test "what one brings counts the lowest to its 48th hour, and nothing past 30 days" {
  Game.clock.server = START
  Game.merchant.prices = (): Map<Integer, Integer> | nil => { return { [ORE]: 96 } }
  Game.merchant.opened.emit()
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  // The market 107, the lowest 100: 95 after the cut while the lowest counts, 101 after.
  const sold: Array<Sale> = [{ key: ORE, unit: 100, many: 2 }, { key: ORE, unit: 300, many: 10 }, { key: ORE, unit: 120, many: 1 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Game.clock.server = START + 48 * HOUR
  window().button("Sell").click()
  Test.expect(window().text("Copper Ore").item().text("Vendor").shown())
  Game.clock.server = START + 720 * HOUR
  Game.bags.changed.emit()
  Test.expect(window().text("Copper Ore").item().text("Auction").shown())
  // Past 30 days the house has no price: the merchant's alone.
  Game.clock.server = START + 721 * HOUR
  Game.bags.changed.emit()
  Test.expect(window().text("Copper Ore").item().texts().join(" | ") == "Copper Ore | 1 | — | — | 0g 0s 96c | Vendor")
}

test "the prices' age: just now under a minute, minutes from one, hours from one" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [{ key: LINEN, unit: 40, many: 20 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  // Each second passed moves the server's time a second.
  Game.clock.server = START + 58
  Test.pass(1.1)
  Test.expect(window().text("Prices: just now · 1 item").shown())
  Game.clock.server = START + 59
  Test.pass(1.1)
  Test.expect(window().text("Prices: 1 min ago · 1 item").shown())
  Game.clock.server = START + 358
  Test.pass(1.1)
  Test.expect(window().text("Prices: 5 min ago · 1 item").shown())
  Game.clock.server = START + 3598
  Test.pass(1.1)
  Test.expect(window().text("Prices: 59 min ago · 1 item").shown())
  Game.clock.server = START + 3599
  Test.pass(1.1)
  Test.expect(window().text("Prices: 1 h ago · 1 item").shown())
}

test "«Data» after a scan of one auction counts it" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
