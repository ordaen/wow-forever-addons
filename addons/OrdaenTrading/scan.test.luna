// The house's prices as the player meets them: a full scan asked from the status line under the window (or as the house
// opens), its progress, its fault, the wait for the next; the market each item is given (the cheapest fifth of what is
// listed, moving toward each look with a half-life of three days), the lowest beside it, what one costs and brings by
// age, 30 days at most; kept between sessions; «Data» in the module's settings. Each is read where the player reads it:
// the status line, «Sell»'s rows, the item panel, «Data». The house is the test's: what it answers a scan with
// (`Game.auctionScan`), what it shows a browse (`Game.auctionQuery.results`), the server's time (`Game.clock.server`).
import Client from "$client"
import Debug from "$debug"
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Trading from "OrdaenTrading"
import { PriceKey } from "@/quote"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
// 2026-09-21, in the server's seconds: a whole hour.
const START = 1790002800
const HOUR = 3600
const ORE: Integer = 2770
const LINEN: Integer = 2589
const BLADE: Integer = 15211
const SUFFIXED: Integer = 1048576
const RED: Color = Color.hex("#ff4040")
const AMBER: Color = Color.hex("#ffb02e")
// A text the settings window always shows.
const SETTINGS = "Move mode"

// An auction as the scan reads it: its key, its buyout for one, how many.
struct Sale {
  key: Integer
  unit: Integer
  many: Integer
}

function names(id: Integer): Game.TooltipData | nil {
  const name = id == LINEN ? "Linen Cloth" : id == ORE ? "Copper Ore" : id == BLADE ? "Glimmering Blade" : nil
  if (name == nil) { return nil }
  return { lines: [{ left: name, kind: 0 }] }
}

// The bags: copper ore and linen.
function bags(): Array<Game.Sellable> | nil {
  return [{ item: ORE, count: 1, bag: 0, slot: 1, commodity: true }, { item: LINEN, count: 1, bag: 0, slot: 2, commodity: true }]
}

// What the house answers a full scan with: these auctions, by their place.
function reader(auctions: Array<Sale>): (index: Integer) => (Integer, Integer, Integer) {
  return (index: Integer): (Integer, Integer, Integer) => {
    const auction = auctions[index]
    if (auction == nil) { return 0, 0, 0 }
    return auction.key, auction.unit, auction.many
  }
}

function window(): Test.Part {
  return Test.page().window("Sell")
}

function asked(expected: String): Boolean {
  Test.flush()
  const said = Test.requests().join(", ")
  if (said != expected) { panic(`the game was asked «${said}», not «${expected}»`) }
  return true
}

// Whether the window shows this text (a progress bar's label among them).
function showing(text: String): Boolean {
  return window().texts().any(shown => shown == text)
}

// Whether the texts after `label` in `part` read exactly `expected` (as many as it has, joined by « | »).
function says(part: Test.Part, label: String, expected: String): Boolean {
  const shown = part.texts()
  const count = expected.split(" | ").length
  for (index, text of shown) {
    if (text == label) {
      let read: Array<String> = []
      for (at of index + 1..index + count) { read.push(shown[at] ?? "") }
      const said = read.join(" | ")
      if (said != expected) { panic(`after «${label}» it reads «${said}», not «${expected}»`) }
      return true
    }
  }
  panic(`«${label}» isn't in «${shown.join(" | ")}»`)
}

// A full scan asked from «Scan» and answered with these auctions, read through.
function scanned(auctions: Array<Sale>) {
  window().button("Scan").click()
  Game.auctionScan.finished.emit(auctions.length)
  Test.pass(0.2)
}

// The item panel of an item the bags hold, picked on «Sell».
function panel(name: String): Test.Part {
  window().button("Sell").click()
  Game.bags.changed.emit()
  window().text(name).click()
  return window().button("Post").item()
}

// Ordaen's settings window at the module's «Data», as the window's gear opens it.
function data(): Test.Part {
  window().text("All items").hover()
  window().button(Ordaen.art.ctl.corner.gear).click()
  const settings = Test.page().window(SETTINGS)
  settings.button("Data").click()
  return settings
}

// The status line

test "before any scan the status says the first is under way, and «Scan» asks the client for one" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Test.expect(window().text("No prices for this realm: the first scan is under way").shown())
  _ = Test.requests()
  window().button("Scan").click()
  Test.expect(asked("AuctionScan.start"))
}

test "the house opening asks for a full scan" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  _ = Test.requests()
  Game.auctionHouse.opened.emit()
  Test.expect(asked("AuctionScan.start"))
}

test "a full scan read through: the prices' age and how many items they cover, the next scan's wait at the right" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [{ key: ORE, unit: 100, many: 2 }, { key: LINEN, unit: 40, many: 20 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Test.expect(window().text("Prices: just now · 2 items").shown() && window().text("Next full scan in 15 min").shown())
  Test.expect(!window().button("Scan").shown())
}

test "the account's 15 minutes counted down, «Scan» is back; asked again before them, the client isn't" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [{ key: LINEN, unit: 40, many: 20 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  _ = Test.requests()
  Game.auctionHouse.opened.emit()
  Test.expect(asked(""))
  Game.clock.server = START + 300
  Test.pass(1.1)
  Test.expect(window().text("Prices: 5 min ago · 1 item").shown() && window().text("Next full scan in 10 min").shown())
  Game.clock.server = START + 900
  Test.pass(1.1)
  Test.expect(window().button("Scan").shown())
}

test "the account's wait is kept: after a reload the next scan is still counted down" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [{ key: LINEN, unit: 40, many: 20 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Test.reload()
  Game.clock.server = START + 600
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Game.auctionHouse.open = true
  Test.expect(window().text("Next full scan in 5 min").shown())
}

test "a scan shows its progress as it reads, and the house shut on it drops it: no price is kept" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  let auctions: Array<Sale> = []
  for (index of 1..1200) { auctions.push({ key: 1000 + index, unit: 10, many: 1 }) }
  // The clock moves 0.02 ms an auction read: asked every 50 auctions, the frame's 4 ms are past at the 250th.
  let reads = 0
  Game.auctionScan.read = (index: Integer): (Integer, Integer, Integer) => {
    reads += 1
    const auction = auctions[index] ?? panic("an auction of the answer")
    return auction.key, auction.unit, auction.many
  }
  Client.debugprofilestop = (): Number => reads * 0.02
  window().button("Scan").click()
  Game.auctionScan.finished.emit(auctions.length)
  // 250 of 1200 read a frame, 0.9 of the bar for the reading: 37% as the second frame is drawn.
  Test.expect(showing("Scanning 37%"))
  Game.auctionHouse.open = false
  Game.auctionHouse.closed.emit()
  Test.pass(0.2)
  Game.auctionHouse.open = true
  Test.expect(window().text("No prices for this realm: the first scan is under way").shown())
}

test "while the client runs a scan and nothing is read yet, the status waits for the server" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionScan.running = true
  Test.expect(window().text("Waiting for the server").textColor().equal(AMBER))
  _ = Test.requests()
  window().button("Scan").click()
  Test.expect(asked(""))
}

test "a scan that failed says why in red, in place of the prices" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Debug.fault("AuctionScan", "the client gave no answer")
  _ = Test.errors()
  Test.expect(window().text("Scan failed: the client gave no answer").textColor().equal(RED))
}

// The prices a scan gives

test "a full scan's market is the cheapest fifth of what is listed, the lowest beside it" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  // 13 listed: the cheapest 3, two at 100 and one at 120, are 107 each.
  const sold: Array<Sale> = [{ key: ORE, unit: 100, many: 2 }, { key: ORE, unit: 300, many: 10 }, { key: ORE, unit: 120, many: 1 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  const shown = panel("Copper Ore")
  Test.expect(says(shown, "Market", "0g 1s 7c") && says(shown, "Lowest", "0g 1s 0c"))
}

test "one auction far below the rest moves the fifth little; a single auction is its own price" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [
    { key: ORE, unit: 1, many: 1 }, { key: ORE, unit: 200, many: 30 }, { key: ORE, unit: 250, many: 20 },
    { key: LINEN, unit: 500, many: 1 }
  ]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Test.expect(says(panel("Copper Ore"), "Market", "0g 1s 82c"))
  Test.expect(says(panel("Linen Cloth"), "Market", "0g 5s 0c"))
}

test "an auction with no buyout, or one the client couldn't say, counts for nothing" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [{ key: LINEN, unit: 40, many: 20 }, { key: LINEN, unit: 0, many: 5 }, { key: 0, unit: 10, many: 1 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Test.expect(says(panel("Linen Cloth"), "Market", "0g 0s 40c") && window().text("Prices: just now · 1 item").shown())
}

test "a weapon's random suffix is a price of its own, which its tooltip reads" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [{ key: BLADE + 3 * SUFFIXED, unit: 25000, many: 1 }, { key: BLADE, unit: 9000, many: 1 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Test.expect(window().text("Prices: just now · 2 items").shown())
}

test "auctions whose item's data came late are read as it comes, and counted" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const auctions: Array<Sale> = [
    { key: ORE, unit: 100, many: 2 }, { key: LINEN, unit: 40, many: 20 }, { key: BLADE, unit: 9000, many: 1 }
  ]
  // The blade's data hasn't loaded: the client says nothing of it until it comes.
  let loaded = false
  Game.auctionScan.read = (index: Integer): (Integer, Integer, Integer) => {
    const auction = auctions[index] ?? panic("an auction of the answer")
    if (!loaded && index == 3) { return 0, 0, 0 }
    return auction.key, auction.unit, auction.many
  }
  Game.auctionScan.waiting = 1
  window().button("Scan").click()
  Game.auctionScan.finished.emit(auctions.length)
  Test.pass(0.02)
  Test.expect(showing("Scanning 0%"))
  loaded = true
  const ready: Array<Integer> = [3]
  Game.auctionScan.again = (turn: Integer): Integer => ready[turn] ?? 0
  Game.auctionScan.waiting = 0
  Test.pass(0.1)
  Test.expect(window().text("Prices: just now · 3 items").shown())
}

test "while items' data keeps coming the reading waits past ten seconds, until ten pass with none" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const auctions: Array<Sale> = [
    { key: ORE, unit: 100, many: 2 }, { key: LINEN, unit: 40, many: 20 }, { key: BLADE, unit: 9000, many: 1 }
  ]
  // The linen's and the blade's data haven't loaded: each comes eight seconds after the last.
  let came = 1
  Game.auctionScan.read = (index: Integer): (Integer, Integer, Integer) => {
    const auction = auctions[index] ?? panic("an auction of the answer")
    if (index > came) { return 0, 0, 0 }
    return auction.key, auction.unit, auction.many
  }
  const ready: Array<Integer> = []
  Game.auctionScan.again = (turn: Integer): Integer => ready[turn] ?? 0
  Game.auctionScan.waiting = 2
  window().button("Scan").click()
  Game.auctionScan.finished.emit(auctions.length)
  Test.pass(8)
  came = 2
  ready.push(2)
  Game.auctionScan.waiting = 1
  Test.pass(8)
  Test.expect(showing("Scanning 0%"))
  came = 3
  ready.push(3)
  Game.auctionScan.waiting = 0
  Test.pass(0.1)
  Test.expect(window().text("Prices: just now · 3 items").shown())
}

test "auctions whose data never comes are given up after ten seconds" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionScan.waiting = 1
  const sold: Array<Sale> = [{ key: LINEN, unit: 40, many: 20 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Test.expect(showing("Scanning 0%"))
  Test.pass(9.5)
  Test.expect(showing("Scanning 0%"))
  Test.pass(0.5)
  Test.expect(window().text("Prices: just now · 1 item").shown())
}

test "the market moves toward each look with a half-life of six hours; looks in one hour move it once" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 1000, quantity: 5 }])
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 2000, quantity: 5 }])
  Test.expect(says(panel("Linen Cloth"), "Market", "0g 10s 0c"))
  // An hour weighs 1 − 2^(−1/6): 11%.
  Game.clock.server = START + HOUR
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 2000, quantity: 5 }])
  Test.expect(says(window().button("Post").item(), "Market", "0g 11s 9c"))
  // A day weighs 1 − 2^(−24/6): 94%.
  Game.clock.server = START + 25 * HOUR
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 1000, quantity: 7 }])
  Test.expect(says(window().button("Post").item(), "Market", "0g 10s 7c"))
}

test "what one costs is the lowest listed for two days, then the market; past 30 days nothing" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  const sold: Array<Sale> = [{ key: ORE, unit: 100, many: 2 }, { key: ORE, unit: 300, many: 10 }, { key: ORE, unit: 120, many: 1 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Game.auctionActions.sellable = (): Array<Game.Sellable> | nil => [{ item: ORE, count: 1, bag: 0, slot: 1, commodity: true }]
  window().button("Sell").click()
  Test.expect(window().text("Copper Ore").item().text("0g 1s 0c").shown())
  Game.clock.server = START + 49 * HOUR
  Game.bags.changed.emit()
  Test.expect(window().text("Copper Ore").item().text("0g 1s 7c").shown())
  Game.clock.server = START + 720 * HOUR
  Game.bags.changed.emit()
  Test.expect(window().text("Copper Ore").item().text("0g 1s 7c").shown())
  Game.clock.server = START + 721 * HOUR
  Game.bags.changed.emit()
  Test.expect(!window().text("Copper Ore").item().text("0g 1s 7c").shown())
}

test "what one brings is the lesser of the market and a fresh lowest, less the cut: «Pays more» weighs it" {
  Game.clock.server = START
  Game.merchant.prices = (): Map<Integer, Integer> | nil => { return { [ORE]: 96 } }
  Game.merchant.opened.emit()
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  // The market 107, the lowest 100: 95 after the cut, under the merchant's 96.
  const sold: Array<Sale> = [{ key: ORE, unit: 100, many: 2 }, { key: ORE, unit: 300, many: 10 }, { key: ORE, unit: 120, many: 1 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Game.auctionActions.sellable = (): Array<Game.Sellable> | nil => [{ item: ORE, count: 1, bag: 0, slot: 1, commodity: true }]
  window().button("Sell").click()
  Test.expect(window().text("Copper Ore").item().text("Vendor").shown())
  // Two days on the lowest is old: 107 less the cut is 101.
  Game.clock.server = START + 49 * HOUR
  Game.bags.changed.emit()
  Test.expect(window().text("Copper Ore").item().text("Auction").shown())
}

test "what one is listed for is the lesser of the market and a fresh lowest, the cut apart: what it brings is that less it" {
  Game.clock.server = START
  Test.mount(nil, SCREEN)
  Game.auctionQuery.results.emit([{ key: ORE, copper: 100, quantity: 2 }, { key: ORE, copper: 300, quantity: 10 }])
  const key = PriceKey.of(ORE)
  const listed = Trading.prices.listed(key) ?? panic("the ore is priced")
  const sold = Trading.prices.sell(key) ?? panic("the ore brings something")
  Test.expect(Trading.prices.cut() == 5)
  Test.expect(listed.copper() == 100 && sold.copper() == 95)
  Test.expect(Trading.prices.listed(PriceKey.of(LINEN)) == nil)
}

test "a full scan drops what was unseen past 30 days: its market and its lowest" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = bags
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 40, quantity: 1 }])
  Game.clock.server = START + 20 * HOUR
  Game.auctionQuery.results.emit([{ key: BLADE, copper: 9000, quantity: 1 }])
  Game.clock.server = START + 721 * HOUR
  const sold: Array<Sale> = [{ key: ORE, unit: 100, many: 1 }]
  Game.auctionScan.read = reader(sold)
  scanned(sold)
  Test.expect(window().text("Prices: just now · 2 items").shown())
  const shown = panel("Linen Cloth")
  Test.expect(says(shown, "Market", "—") && says(shown, "Lowest", "—"))
}

