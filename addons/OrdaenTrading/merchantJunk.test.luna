// The merchant's window with Ordaen Inventory beside it: it opens to the bags' left, «Sell junk» sells the bags' junk and
// says what it brings, and while it shows the buyback a slot's use in the bags sells nothing.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Art } from "$ltml"
import Test from "$test"
import Locale from "@/locales"

const SCREEN: Test.Page = { left: 0, top: 0, width: 2470, height: 1054, screen: true }
const FOOT: FileId = 133854
const CLOTH: FileId = 132889

// Three grey rabbit's feet (10 copper each) and some linen in the backpack.
function read(bag: Integer, slot: Integer, into: mut Game.SlotItem): Boolean {
  if (bag != 0 || slot > 2) {
    into.id = 0
    return false
  }
  const foot = slot == 1
  into.id = foot ? 3300 : 2589
  into.count = foot ? 3 : 20
  into.quality = foot ? 0 : 1
  into.name = foot ? "Rabbit's Foot" : "Linen Cloth"
  into.link = `[${into.name}]`
  into.level = 1
  into.kind = foot ? 15 : 7
  into.subkind = 0
  into.subkindName = "Kind"
  into.worn = ""
  into.bound = false
  into.locked = false
  into.isNew = false
  into.price = 10
  into.loaded = true
  into.questItem = false
  into.startsQuest = false
  return true
}

function atMerchant() {
  Game.bags.bag = (bag: Integer): Game.BagInfo => {
    return { bag: bag, item: nil, name: bag == 0 ? "Backpack" : "", icon: nil, slots: bag == 0 ? 16 : 0, general: true }
  }
  Game.bags.size = (bag: Integer): Integer => bag == 0 ? 16 : 0
  Game.bags.readSlot = read
  Game.items.icon = (id: Integer): Art | nil => id == 3300 ? FOOT : CLOTH
  Game.items.maxStack = (id: Integer): Integer | nil => 20
  Client.CanGuildBankRepair = (): Boolean => false
  // The merchant takes what the bags send it (the fake writes the ask).
  Game.bags.send = (bag: Integer, slot: Integer): Boolean => true
  Client.UnitName = (unit: String): (String, String) => {
    return "Tharynn", ""
  }
  Test.mount(nil, SCREEN)
  // The merchant opens the bags with its window, as the game's does: the two stand side by side.
  Game.bags.open = true
  Game.bags.place = Game.BagPlace.Merchant
  Events.MERCHANT_SHOW.emit()
  Test.flush()
}

test "the merchant's window sells the bags' junk from its right column, saying what it brings" {
  atMerchant()
  Test.expect(Test.page().window("Inventory").rect().left > Test.page().window("Tharynn").rect().right)
  _ = Test.requests()
  Test.page().window("Tharynn").button(`${Locale.SELL_JUNK} ${Game.money.format(30)}`).click()
  Test.expect(Test.requests().join(", ").contains("Bags.send 0 1"))
  Events.MERCHANT_CLOSED.emit()
}

test "while the merchant's window shows the buyback, a slot's use in the bags sells nothing" {
  atMerchant()
  Test.page().button(Locale.BUYBACK).click()
  _ = Test.performed()
  Test.page().window("Inventory").button(CLOTH).click()
  Test.expect(Test.performed().length == 0)
  // The goods again: the cloth sells, by the client's secure use of its slot.
  Test.page().button("Tharynn").click()
  Test.page().window("Inventory").button(CLOTH).click()
  Test.expect(Test.performed().join(", ") == "macro /use 0 2")
  Events.MERCHANT_CLOSED.emit()
}
