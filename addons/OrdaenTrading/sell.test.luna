test "an item's stack is posted as one auction, its buyout the price for each times the count" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionActions.sellable = (): Array<Game.Sellable> | nil => [{ item: AXE, count: 3, bag: 0, slot: 2, commodity: false }]
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([{ key: AXE, copper: 1001, quantity: 2 }])
  window().button("Sell").click()
  window().text("Bronze Axe").click()
  panel().button("-").click()
  _ = Test.requests()
  panel().button("Post").click()
  Test.expect(asked("AuctionActions.postItem 2847 0 2 2 3 -1 2000"))
