  Test.expect(Test.page().window("Search for this item").shown())
  Test.page().window("Search for this item").text("Add to shopping list").click()
  Test.expect(window().text("Sergeant's Warhammer").nth(1).item().paintedWith(LISTED))
}

test "a quantity the listings hold exactly can be bought" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  window().text("Linen Cloth").click()
  Game.auctionQuery.listed.emit(LINEN, [
    { auction: 0, unit: 36, quantity: 10, left: 7200, own: false, commodity: true },
    { auction: 0, unit: 40, quantity: 20, left: 86400, own: false, commodity: true },
    { auction: 0, unit: 45, quantity: 5, left: 86400, own: false, commodity: true }
  ])
  Test.hold([.Shift])
  panel().button("+").click()
  Test.hold([])
  panel().button("-").click()
  Test.expect(says(panel(), "Quantity", "- | 10 | +"))
  Test.hold([.Shift])
  panel().button("+").click()
  panel().button("+").click()
  Test.hold([])
  for (i of 1..5) { panel().button("+").click() }
  Test.expect(says(panel(), "Quantity", "- | 35 | +"))
  _ = Test.requests()
  panel().button("Buy").click()
  Test.expect(asked("AuctionActions.startPurchase 2589 35"))
}

test "the picked row's panel charts its history" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  window().text("Linen Cloth").click()
  Test.expect(!panel().text("No price history yet.").shown())
}

test "a shopping list's item is marked in a row an item too" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  window().text("Linen Cloth").rightClick()
  Test.page().window("Search for this item").text("Add to shopping list").click()
  window().button(Ordaen.art.ctl.tool.list).click()
  Test.page().text("One row an item").click()
  Test.expect(window().text("Linen Cloth").nth(1).item().paintedWith(LISTED) && !window().text("Copper Ore").item().paintedWith(LISTED))
}
