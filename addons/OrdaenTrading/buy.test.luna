// The names

test "the house's names are asked of the game once: the same items shown again ask none" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  Test.flush()
  let tooltips = new Tooltips()
  Game.items.tooltip = (id: Integer): Game.TooltipData | nil => tooltips.of(id)
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 35, quantity: 30 }, { key: ORE, copper: 80, quantity: 40 }])
  Test.expect(window().text("Linen Cloth").shown() && tooltips.count == 0)
}

test "a name is drawn in its quality's colour, or the colour of its tooltip's first line" {
  Game.clock.server = START
  Game.items.tooltip = (id: Integer): Game.TooltipData | nil => {
    if (id == LINEN) { return { lines: [{ left: "Linen Cloth", kind: 0, quality: GREEN }] } }
    if (id == ORE) { return { lines: [{ left: "Copper Ore", kind: 0, leftColor: AMBER }] } }
    return { lines: [{ left: "Bronze Axe", kind: 0 }] }
  }
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([
    { key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }, { key: AXE, copper: 2100, quantity: 1 }
  ])
  Test.expect(window().text("Linen Cloth").textColor().equal(GREEN) && window().text("Copper Ore").textColor().equal(AMBER))
  Test.expect(window().text("Bronze Axe").textColor().equal(INK))
}

