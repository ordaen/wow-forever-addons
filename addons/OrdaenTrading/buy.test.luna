// «Buy» as the player meets it: what the house showed last, a row a variant or a row an item, each with how many are
// listed, its lowest, its market, the lowest's share of it and the price's age; sorted by a column; searched on the
// house by name (once the typing settles, or on Enter), by a category at the left and by the filter's level and
// quality; a row picked: its listings asked, a quantity, the total, «Buy» (the client's from the player's click alone,
// a commodity in two clicks) and «Add to shopping list»; a row right-clicked: its menu. The house is the test's: what
// it shows (`Game.auctionQuery.results`, `listed`), what it was asked (`Test.requests()`).
import Game from "$game"
import { Key } from "$ltml"
import Test from "$test"
import Wow from "LunaTypeRenderer"
import root Ordaen from "Ordaen"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
// 2026-09-21, in the server's seconds: a whole hour.
const START = 1790002800
const HOUR = 3600
const ORE: Integer = 2770
const LINEN: Integer = 2589
const AXE: Integer = 2847
const RED: Color = Color.hex("#ff4040")
const GREEN: Color = Color.hex("#40c040")
const INK: Color = Color.hex("#e8dcc4")
const AMBER: Color = Color.hex("#ffb02e")
// The pip of an item on the shopping list.
const LISTED: Color = Color.hex("#40c0ff")
// A listing the next click buys from: a row picked.
const PICKED: Color = Color.hex("#00000040")
// A list's ground; a line of a menu that takes no click.
const LISTS: Color = Color.hex("#0000004d")
const MENU_DIM: Color = Color.hex("#6f6552")
// A category picked.
const CATEGORY: Color = Color.hex("#d6a56b3d")
// The player's case: a warhammer whose random suffixes are variants of their own. A key is the item's id and its
// suffix × 2^20.
const WARHAMMER: Integer = 15216
const SUFFIXED: Integer = 1048576
const BEAR: Integer = 1017
const EAGLE: Integer = 1018
const MONKEY: Integer = 1019

function names(id: Integer): Game.TooltipData | nil {
  const name = id == LINEN ? "Linen Cloth" : id == ORE ? "Copper Ore" : id == AXE ? "Bronze Axe" :
    id == WARHAMMER ? "Sergeant's Warhammer" : nil
  if (name == nil) { return nil }
  return { lines: [{ left: name, kind: 0 }] }
}

function variants(id: Integer, suffix: Integer): Game.TooltipData | nil {
  if (id != WARHAMMER) { return nil }
  const of = suffix == BEAR ? "the Bear" : suffix == EAGLE ? "the Eagle" : suffix == MONKEY ? "the Monkey" : nil
  if (of == nil) { return nil }
  return { lines: [{ left: "Sergeant's Warhammer of %s".format(of), kind: 0 }] }
}

// The game's tooltips asked for: how many.
class Tooltips {
  public count = 0

  public of(mut self, id: Integer): Game.TooltipData | nil {
    self.count += 1
    return names(id)
  }
}

function window(): Test.Part {
  return Test.page().window("Sell")
}

// The picked row's panel at the window's right: the part that holds «Add to shopping list».
function panel(): Test.Part {
  return window().button("Add to shopping list").item()
}

function reads(part: Test.Part, expected: String): Boolean {
  const read = part.texts().join(" | ")
  if (read != expected) { panic(`it reads «${read}», not «${expected}»`) }
  return true
}

// What the game was asked, but the tooltips of the rows the cursor crossed.
function asked(expected: String): Boolean {
  Test.flush()
  const said = Test.requests().filter(request => !request.contains("Items.show")).join(", ")
  if (said != expected) { panic(`the game was asked «${said}», not «${expected}»`) }
  return true
}

// Whether the texts after `label` in `part` read exactly `expected` (as many as it has, joined by « | »).
function says(part: Test.Part, label: String, expected: String): Boolean {
  const shown = part.texts()
  const count = expected.split(" | ").length
  for (index, text of shown) {
    if (text == label) {
      let read: Array<String> = []
      for (at of index + 1..index + count) { read.push(shown[at] ?? "") }
      const said = read.join(" | ")
      if (said != expected) { panic(`after «${label}» it reads «${said}», not «${expected}»`) }
      return true
    }
  }
  panic(`«${label}» isn't in «${shown.join(" | ")}»`)
}

// Whether `first` is drawn before `second` in the window.
function before(first: String, second: String): Boolean {
  let at = 0
  for (index, text of window().texts()) {
    if (text == first && at == 0) { at = index }
    if (text == second) { return at > 0 }
  }
  panic(`«${second}» isn't shown`)
}

// The rows

test "before any price the list says the first scan is under way" {
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Test.expect(window().text("No prices for this realm: the first scan is under way. Find an item by name.").shown())
}

test "each item the house showed is a row: how many listed, its lowest, its market, the share, the age" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  Test.expect(reads(window().text("Linen Cloth").item(), "Linen Cloth | 30 | 0g 0s 36c | 0g 0s 36c | 100% | < 1 h"))
  Test.expect(reads(window().text("Copper Ore").item(), "Copper Ore | 40 | 0g 0s 90c | 0g 0s 90c | 100% | < 1 h"))
}

test "an item the game doesn't name yet is named by its number" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  Game.auctionQuery.results.emit([{ key: 99999, copper: 10, quantity: 1 }])
  Test.expect(window().text("Item 99999").shown())
}

test "the lowest's share of its market: green for a bargain under 90%, red over 100%, the ink between" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  // An hour on, the market moved a tenth of the way: linen 36 toward 30 by 11%, ore 90 toward 120.
  Game.clock.server = START + HOUR
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 30, quantity: 30 }, { key: ORE, copper: 120, quantity: 40 }])
  Test.expect(reads(window().text("Linen Cloth").item(), "Linen Cloth | 30 | 0g 0s 30c | 0g 0s 35c | 86% | < 1 h"))
  Test.expect(window().text("86%").textColor().equal(GREEN))
  Test.expect(reads(window().text("Copper Ore").item(), "Copper Ore | 40 | 0g 1s 20c | 0g 0s 93c | 129% | < 1 h"))
  Test.expect(window().text("129%").textColor().equal(RED))
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 35, quantity: 30 }])
  Test.expect(window().text("Linen Cloth").item().text("100%").textColor().equal(INK))
}

test "the age column: «< 1 h» this hour, the hours under a day, the market's days from one, amber to the third" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  Game.auctionHouse.open = false
  Test.flush()
  Game.clock.server = START + 5 * HOUR
  Game.auctionHouse.open = true
  Test.expect(window().text("Linen Cloth").item().text("5 h").textColor().equal(INK))
  Game.auctionHouse.open = false
  Test.flush()
  Game.clock.server = START + 50 * HOUR
  Game.auctionHouse.open = true
  Test.expect(window().text("Linen Cloth").item().text("(2 d.)").textColor().equal(AMBER))
}

test "five thousand items: the list builds the rows in view, and the wheel builds none" {
  Game.clock.server = START
  Game.items.tooltip = (id: Integer): Game.TooltipData | nil => { return { lines: [{ left: "Ware %d".format(id), kind: 0 }] } }
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  let offers: Array<Game.Offer> = []
  for (id of 1..5000) { offers.push({ key: id, copper: id, quantity: 1 }) }
  const made = Wow.made()
  Game.auctionQuery.results.emit(offers)
  Test.expect(window().text("Ware 2").shown())
  const built = Wow.made() - made
  Test.expect(built < 1000)
  // The results' list: the second box on a list's ground, after the categories.
  for (i of 1..3) { window().box(LISTS).nth(2).wheel(-1) }
  Test.expect(Test.refused((): nil => window().text("Ware 1").hover()) != nil && Wow.made() - made == built)
}

// Sorting and the views

test "a column's title sorts the rows by it, and again the other way; the sort is kept between sessions" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: ORE, copper: 90, quantity: 40 }, { key: LINEN, copper: 36, quantity: 30 }])
  _ = Test.requests()
  Test.expect(before("Copper Ore", "Linen Cloth"))
  window().button("Item").click()
  Test.expect(before("Copper Ore", "Linen Cloth"))
  window().button("Item").click()
  Test.expect(before("Linen Cloth", "Copper Ore"))
  // Each sort taken away before the next, each column sorts alone.
  window().button("Item").rightClick()
  window().button("Lowest").click()
  Test.expect(before("Linen Cloth", "Copper Ore"))
  window().button("Lowest").rightClick()
  window().button("Listed").click()
  Test.expect(before("Linen Cloth", "Copper Ore"))
  window().button("Listed").click()
  Test.expect(before("Copper Ore", "Linen Cloth"))
  Test.reload()
  // The browse isn't kept; the column and the way are, marked on its title.
  Test.expect(window().button("Listed").box(Ordaen.art.ctl.markDown).opacity() == 1)
}

test "sorted by the market, the share or the age" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  Game.clock.server = START + 2 * HOUR
  // Ore shown again with none listed: its price stays as it was seen two hours ago, half its market now.
  Game.auctionQuery.results.emit([{ key: ORE, copper: 45, quantity: 0 }, { key: LINEN, copper: 36, quantity: 30 }])
  window().button("Average").click()
  Test.expect(before("Linen Cloth", "Copper Ore"))
  window().button("Average").rightClick()
  window().button("%").click()
  Test.expect(before("Copper Ore", "Linen Cloth"))
  window().button("%").rightClick()
  window().button("Age").click()
  Test.expect(before("Linen Cloth", "Copper Ore"))
}

test "variants: each a row named with its suffix, its own lowest and its own market's share" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.items.variant = variants
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([
    { key: WARHAMMER + BEAR * SUFFIXED, copper: 1100, quantity: 2 },
    { key: WARHAMMER + EAGLE * SUFFIXED, copper: 800, quantity: 1 },
    { key: WARHAMMER + MONKEY * SUFFIXED, copper: 1500, quantity: 1 }
  ])
  Game.clock.server = START + HOUR
  Game.auctionQuery.results.emit([
    { key: WARHAMMER + BEAR * SUFFIXED, copper: 933, quantity: 3 },
    { key: WARHAMMER + EAGLE * SUFFIXED, copper: 933, quantity: 1 },
    { key: WARHAMMER + MONKEY * SUFFIXED, copper: 1250, quantity: 2 }
  ])
  Test.expect(reads(window().text("Sergeant's Warhammer of the Bear").item(),
    "Sergeant's Warhammer of the Bear | 3 | 0g 9s 33c | 0g 10s 82c | 86% | < 1 h"))
  Test.expect(reads(window().text("Sergeant's Warhammer of the Eagle").item(),
    "Sergeant's Warhammer of the Eagle | 1 | 0g 9s 33c | 0g 8s 15c | 114% | < 1 h"))
  Test.expect(window().text("Sergeant's Warhammer of the Monkey").shown())
}

test "one row an item: the variants folded, their listings summed, their lowest prices a range" {
  Game.clock.server = START
  Game.items.tooltip = names
  Game.items.variant = variants
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([
    { key: WARHAMMER + BEAR * SUFFIXED, copper: 1100, quantity: 2 },
    { key: WARHAMMER + EAGLE * SUFFIXED, copper: 933, quantity: 1 },
    { key: WARHAMMER + MONKEY * SUFFIXED, copper: 1250, quantity: 3 },
    { key: AXE, copper: 2100, quantity: 1 }
  ])
  window().button(Ordaen.art.ctl.tool.list).click()
  Test.page().text("One row an item").click()
  Test.expect(reads(window().text("Sergeant's Warhammer").item(),
    "Sergeant's Warhammer | 6 | 0g 9s 33c | – | 0g 12s 50c | 0g 9s 33c | 100% | < 1 h"))
  Test.expect(reads(window().text("Bronze Axe").item(), "Bronze Axe | 1 | 0g 21s 0c | 0g 21s 0c | 100% | < 1 h"))
  Test.expect(!window().text("Sergeant's Warhammer of the Bear").shown())
}

// Searching

test "typing: keys a tenth of a second apart are one search once the typing settles; names asked of the game once" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  Test.flush()
  let tooltips = new Tooltips()
  Game.items.tooltip = (id: Integer): Game.TooltipData | nil => tooltips.of(id)
  const field = window().input()
  field.type("")
  for (letter of ["c", "o", "p", "p", "e", "r"]) {
    Test.type(letter)
    Test.pass(0.1)
  }
  Test.expect(asked(""))
  Test.pass(0.3)
  Test.expect(asked("AuctionQuery.search copper -1 -1 -1 -1 0") && tooltips.count == 0)
}

test "the rows shown are those whose name holds what is typed" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  window().input().type("lin")
  Test.pass(0.3)
  Test.expect(window().text("Linen Cloth").shown() && !window().text("Copper Ore").shown())
}

test "Enter searches at once, and the typing settling after it sends nothing more" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  window().input().type("ore")
  Test.key(Key.Enter)
  Test.expect(asked("AuctionQuery.search ore -1 -1 -1 -1 0"))
  Test.pass(0.3)
  Test.expect(asked(""))
}

test "a search waits for the house to take a query, and is sent whole once it does" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  Game.auctionQuery.ready = false
  window().input().type("lin")
  Test.pass(0.3)
  Test.expect(asked(""))
  Game.auctionQuery.ready = true
  Test.expect(asked("AuctionQuery.search lin -1 -1 -1 -1 0"))
}

test "a category: a class picked shows its subclasses and searches it, a subclass searches itself, «All items» every one" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  Test.expect(!window().text("Daggers").shown())
  window().text("Weapon").click()
  Test.expect(asked("AuctionQuery.search  2 -1 -1 -1 0") && window().text("Daggers").shown())
  window().text("Daggers").click()
  Test.expect(asked("AuctionQuery.search  2 15 -1 -1 0"))
  window().text("Trade Goods").click()
  Test.expect(asked("AuctionQuery.search  7 -1 -1 -1 0") && !window().text("Daggers").shown())
  window().text("All items").click()
  Test.expect(asked("AuctionQuery.search  -1 -1 -1 -1 0"))
}

test "the filter's menu under the funnel: a level band and a quality, searched with; the funnel's tip says them" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  window().button(Ordaen.art.ctl.tool.filter).click()
  const menu = Test.page().window("Any quality")
  Test.expect(reads(menu, "Any level | 1–10 | 11–20 | 21–30 | 31–40 | 41–50 | 51–60 | Any quality | Common | Uncommon | Rare | Epic"))
  menu.text("11–20").click()
  Test.expect(asked("AuctionQuery.search  -1 -1 11 20 0"))
  Test.page().window("Any quality").text("Uncommon").click()
  Test.expect(asked("AuctionQuery.search  -1 -1 11 20 1"))
  window().text("All items").click()
  Test.expect(!Test.page().window("Any quality").shown())
  window().button(Ordaen.art.ctl.tool.filter).hover()
  Test.expect(Test.page().window("Filter").texts().join(" | ") == "Filter | 11–20, Uncommon")
}

test "the filter is kept between sessions" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  window().button(Ordaen.art.ctl.tool.filter).click()
  Test.page().window("Any quality").text("Rare").click()
  Test.reload()
  Game.clock.server = START
  Game.items.tooltip = names
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  window().button(Ordaen.art.ctl.tool.filter).hover()
  Test.expect(Test.page().window("Filter").texts().join(" | ") == "Filter | Any level, Rare")
}

// A row picked

test "a commodity picked: its lots asked and shown over the list, a quantity, the total of the cheapest that hold it" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  window().text("Linen Cloth").click()
  Test.expect(asked("AuctionQuery.listings 2589"))
  Game.auctionQuery.listed.emit(LINEN, [
    { auction: 0, unit: 36, quantity: 10, left: 7200, own: false, commodity: true },
    { auction: 0, unit: 40, quantity: 20, left: 86400, own: false, commodity: true }
  ])
  Test.expect(reads(window().text("10").item(), "0g 0s 36c | 10 | 0g 3s 60c | 2 h"))
  Test.expect(window().button("Back").shown() && window().text("Copper Ore").opacity() == 0)
  Test.expect(panel().text("Listed: 30").shown() && says(panel(), "Total", "0g 0s 36c"))
  // Shift steps 10, then one a click.
  Test.hold([.Shift])
  panel().button("+").click()
  Test.hold([])
  for (i of 1..4) { panel().button("+").click() }
  Test.expect(says(panel(), "Quantity", "- | 15 | +") && says(panel(), "Total", "0g 5s 60c"))
}

test "a commodity bought in two clicks: «Buy» asks the client's price, «Confirm» buys at it; then its listings again" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  window().text("Linen Cloth").click()
  Game.auctionQuery.listed.emit(LINEN, [{ auction: 0, unit: 36, quantity: 10, left: 7200, own: false, commodity: true }])
  panel().button("+").click()
  _ = Test.requests()
  panel().button("Buy").click()
  Test.expect(asked("AuctionActions.startPurchase 2589 2"))
  Game.auctionActions.answered.emit(.Quoted { item: LINEN, quantity: 2, total: 80 })
  Test.expect(says(panel(), "Total", "0g 0s 80c"))
  panel().button("Confirm").click()
  Test.expect(asked("AuctionActions.confirmPurchase 2589 2"))
  Game.auctionActions.answered.emit(.Bought)
  Test.expect(asked("AuctionQuery.listings 2589") && panel().button("Buy").shown())
}

test "a quantity the price was asked for, changed, is asked again" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  window().text("Linen Cloth").click()
  Game.auctionQuery.listed.emit(LINEN, [{ auction: 0, unit: 36, quantity: 10, left: 7200, own: false, commodity: true }])
  panel().button("Buy").click()
  Game.auctionActions.answered.emit(.Quoted { item: LINEN, quantity: 1, total: 36 })
  panel().button("+").click()
  _ = Test.requests()
  panel().button("Buy").click()
  Test.expect(asked("AuctionActions.startPurchase 2589 2"))
}

test "more than the listings hold can't be bought" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  window().text("Linen Cloth").click()
  Game.auctionQuery.listed.emit(LINEN, [{ auction: 0, unit: 36, quantity: 1, left: 7200, own: false, commodity: true }])
  panel().button("+").click()
  _ = Test.requests()
  panel().button("Buy").click()
  Test.expect(asked("") && says(panel(), "Total", "0g 0s 0c") && panel().button("Buy").paintedWith(Ordaen.art.ctl.buttonDisabled))
}

test "an item picked: its cheapest auction with a buyout, not the player's own, bought out from the click" {
  Game.clock.server = START
  Game.items.tooltip = names
  Test.mount(nil, SCREEN)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: ORE, copper: 90, quantity: 40 }])
  _ = Test.requests()
  Game.auctionQuery.results.emit([{ key: AXE, copper: 2100, quantity: 3 }])
  window().text("Bronze Axe").click()
  Game.auctionQuery.listed.emit(AXE, [
    { auction: 71, unit: 0, quantity: 1, bid: 1500, left: 3600, own: false, commodity: false },
    { auction: 72, unit: 2100, quantity: 1, buyout: 2100, left: 7200, own: true, commodity: false },
    { auction: 73, unit: 2200, quantity: 1, buyout: 2200, left: 7200, own: false, commodity: false }
  ])
  Test.expect(says(panel(), "Quantity", "1") && says(panel(), "Total", "0g 22s 0c"))
  _ = Test.requests()
  panel().button("Buy").click()
  Test.expect(asked("AuctionActions.bid 73 2200"))
}

