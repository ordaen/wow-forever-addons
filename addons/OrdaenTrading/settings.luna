// What the player chooses for Ordaen Trading, and its tab in the settings window. Each control writes one entry of the
// settings, at once.
import { Component, NumberInput, Settings, Switch, Unit } from "Ordaen"
import Locale from "@/locales"

public struct Choices implements Plain {
  // A full scan as the house opens, where the account's 15 minutes are past.
  scanOnOpen: Boolean
  // The house's cut of a sale, in percent: what `sell` takes off.
  cut: Integer
  // Ordaen's window over the house; off, the game's own, with the prices still in tooltips.
  window: Boolean
  // The «Auction» line in an item's tooltip.
  priceLine: Boolean
  // How often «My auctions» asks the client for the list while it is open, in seconds; 0: only by «Check».
  ownedRefresh: Integer = 5
}

public const DEFAULTS: Choices = { scanOnOpen: true, cut: 5, window: true, priceLine: true, ownedRefresh: 5 }

public class GeneralPage implements Component {
  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Switch label={Locale.SCAN_ON_OPEN} hint={Locale.SCAN_ON_OPEN_TIP} value={mut self.settings.values.scanOnOpen} />
      <NumberInput label={Locale.CUT} hint={Locale.CUT_TIP} value={mut self.settings.values.cut} least={0} most={20}
                   unit={Unit.None} />
      <Switch label={Locale.WINDOW} hint={Locale.WINDOW_TIP} value={mut self.settings.values.window} />
      <Switch label={Locale.PRICE_LINE} hint={Locale.PRICE_LINE_TIP} value={mut self.settings.values.priceLine} />
      <NumberInput label={Locale.OWNED_REFRESH} hint={Locale.OWNED_REFRESH_TIP} value={mut self.settings.values.ownedRefresh}
                   least={0} most={60} unit={Unit.Sec} />
    }
  }
}
