  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(list().text("Held: this character's bags and bank.").shown() && list().text("20").textColor().equal(INK))
}

test "«Search all» with one item browses it" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  _ = Test::requests()
  list().button("Search all").click()
  Test::expect(asked("AuctionQuery.browse 1"))
}

test "«Remove bought» takes the last row too" {
  Game::items.owned = (id: integer): integer => id == COPPER_BAR ? 5 : 0
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  list().button("Remove bought").click()
  Test::expect(list().text("Linen Cloth").shown() && !list().text("Copper Bar").shown())
}

test "«Remove» is off until a row is picked, and again once the row is gone" {
  Game::items.owned = (id: integer): integer => id == LINEN ? 25 : 0
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(list().button("Remove").paintedWith(Ordaen.art.ctl.buttonDisabled))
  list().text("Linen Cloth").click()
  Test::expect(!list().button("Remove").paintedWith(Ordaen.art.ctl.buttonDisabled) && list().text("Linen Cloth").item().paintedWith(PICKED))
  list().button("Remove bought").click()
  Test::expect(list().button("Remove").paintedWith(Ordaen.art.ctl.buttonDisabled))
  list().text("Copper Bar").click()
  list().button("Remove").click()
  Test::expect(list().button("Remove").paintedWith(Ordaen.art.ctl.buttonDisabled))
}

test "«Buy N» picks its row" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.results.emit([{ key: COPPER_BAR, copper: 52, quantity: 9 }])
  list().button("Buy 3").click()
  Test::expect(list().text("Copper Bar").item().paintedWith(PICKED) && !list().text("Linen Cloth").item().paintedWith(PICKED))
}

test "a row bought in full with no price leaves the total whole" {
  Game::items.owned = (id: integer): integer => id == COPPER_BAR ? 5 : 0
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  Test::expect(says(list(), "To buy, in all", "0g 7s 20c"))
}

test "a price two days old says its age under it" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Game::auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  Game::clock.server = START + 50 * 3600
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(list().text("Linen Cloth").item().text("(2 d.)").shown())
}

test "the client's price for one of a commodity is the row's sum" {
  Trading.shopping.add(ItemId::of(COPPER_BAR), 1, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Game::auctionQuery.ready = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.results.emit([{ key: COPPER_BAR, copper: 52, quantity: 400 }])
  list().button("Buy 1").click()
  Game::auctionQuery.listed.emit(COPPER_BAR, [{ auction: 0, unit: 52, quantity: 400, own: false, commodity: true }])
  list().button("Buy 1").click()
  Game::auctionActions.answered.emit(.Quoted { item: COPPER_BAR, quantity: 1, total: 55 })
  Test::expect(list().text("Copper Bar").item().text("0g 0s 55c").shown())
}

test "an item removed and put on the list again comes back unpicked" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  list().text("Linen Cloth").click()
  list().button("Remove").click()
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Test::expect(!list().text("Linen Cloth").item().paintedWith(PICKED) && list().button("Remove").paintedWith(Ordaen.art.ctl.buttonDisabled))
}
