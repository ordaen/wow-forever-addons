// The shopping list as the player meets it: a window opened from «Buy», the account's list, a row an item with what
// asked for it (Professions' queue, as Ordaen Professions adds its lines through the root's `shopping`, or the player
// by hand), what is left to buy over what this character holds of what is needed, its price and age, the row's sum
// and the list's; «Buy N» (the client's from the player's click alone), «Search all», «Remove» and «Remove bought»;
// kept between sessions and characters.
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import { ItemId } from "Ordaen"
import root Trading from "OrdaenTrading"

const SCREEN: Test::Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const START = 1790002800
const COPPER_BAR: integer = 2840
const LINEN: integer = 2589
const AXE: integer = 2847
// The recipe, a spell's id, that makes a Bronze Axe.
const BRONZE_AXE: integer = 2741
const DIM: color = #a3977f
const INK: color = #e8dcc4
// A row picked; a button that takes no click.
const PICKED: color = #00000040

function names(id: integer): Game::TooltipData | nil {
  const name = id == LINEN ? "Linen Cloth" : id == COPPER_BAR ? "Copper Bar" : id == AXE ? "Bronze Axe" : nil
  if (name == nil) { return nil }
  return { lines: [{ left: name, kind: 0 }] }
}

function list(): Test::Part {
  return Test::page().window("Search all")
}

function reads(part: Test::Part, expected: string): boolean {
  const read = part.texts().join(" | ")
  if (read != expected) { throw Error { message: `it reads «${read}», not «${expected}»` } }
  return true
}

// Whether the texts after `label` in `part` read exactly `expected` (as many as it has, joined by « | »).
function says(part: Test::Part, label: string, expected: string): boolean {
  const shown = part.texts()
  const count = expected.split(" | ").length
  for (index, text of shown) {
    if (text == label) {
      let read: array<string> = mut []
      for (at of index + 1..index + count) { read.push(shown[at] ?? "") }
      const said = read.join(" | ")
      if (said != expected) { throw Error { message: `after «${label}» it reads «${said}», not «${expected}»` } }
      return true
    }
  }
  throw Error { message: `«${label}» isn't in «${shown.join(" | ")}»` }
}

// What the game was asked, but the tooltips of the rows the cursor crossed.
function asked(expected: string): boolean {
  Test::flush()
  const said = Test::requests().filter(request => !request.contains("Items.show")).join(", ")
  if (said != expected) { throw Error { message: `the game was asked «${said}», not «${expected}»` } }
  return true
}

test "an empty list says how it fills, and its buttons do nothing" {
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(list().text("Add a recipe from Professions, or an item on the Buy page.").shown())
  _ = Test::requests()
  list().button("Search all").click()
  Test::expect(asked(""))
}

test "lines of one item are one row: their counts summed, what this character holds taken off" {
  Game::items.owned = (id: integer): integer => id == COPPER_BAR ? 4 : 0
  Game::spells.name = (id: integer): string | nil => id == BRONZE_AXE ? "Bronze Axe" : nil
  Trading.shopping.add(ItemId::of(COPPER_BAR), 12, .Queue { recipe: BRONZE_AXE, crafts: 6, character: "Regron" })
  Trading.shopping.add(ItemId::of(COPPER_BAR), 2, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(reads(list().text("Copper Bar").item(),
    "Copper Bar | Bronze Axe ×6 — Regron's queue, by hand | 10 | 4 of 14 held | — | — | Buy 10"))
}

test "a recipe the game doesn't name is named by its number" {
  Trading.shopping.add(ItemId::of(LINEN), 4, .Queue { recipe: 9999, crafts: 2, character: "Regy" })
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(list().text("Recipe 9999 ×2 — Regy's queue").shown())
}

test "a line of none adds nothing" {
  Trading.shopping.add(ItemId::of(LINEN), 0, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(!list().text("Linen Cloth").shown())
}

test "an item held in full is dimmed at 0, «Bought»" {
  Game::items.owned = (id: integer): integer => id == LINEN ? 25 : 0
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(reads(list().text("Linen Cloth").item(), "Linen Cloth | by hand | 0 | 25 of 20 held | — | — | Bought"))
  Test::expect(list().text("Linen Cloth").textColor().equal(DIM) && list().text("0").textColor().equal(DIM))
}

test "what the bags hold is read again as they change" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(list().text("Linen Cloth").textColor().equal(INK))
  Game::items.owned = (id: integer): integer => id == LINEN ? 25 : 0
  Game::bags.changed.emit()
  Test::expect(list().text("Linen Cloth").item().text("Bought").shown())
}

test "a priced row shows its price with its age and its sum; the list's total sums every row" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: COPPER_BAR, copper: 52, quantity: 9 }])
  Test::expect(reads(list().text("Linen Cloth").item(), "Linen Cloth | by hand | 20 | 0 of 20 held | 0g 0s 36c | 0g 7s 20c | Buy 20"))
  Test::expect(says(list(), "To buy, in all", "0g 8s 76c"))
}

test "a row with nothing to say its price marks the total as short of it" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  Test::expect(says(list(), "To buy, in all", "~ | 0g 7s 20c"))
}

test "«Search all» browses every item on the list in one query" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  _ = Test::requests()
  list().button("Search all").click()
  Test::expect(asked("AuctionQuery.browse 2"))
}

test "a row picked can be removed; «Remove» with none picked does nothing" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  list().button("Remove").click()
  Test::expect(list().text("Linen Cloth").shown())
  list().text("Copper Bar").click()
  list().button("Remove").click()
  Test::expect(!list().text("Copper Bar").shown() && list().text("Linen Cloth").shown())
}

test "«Remove bought» takes every row at 0, and keeps the rest" {
  Game::items.owned = (id: integer): integer => id == LINEN ? 25 : 0
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  list().button("Remove bought").click()
  Test::expect(!list().text("Linen Cloth").shown() && list().text("Copper Bar").shown())
}

test "the list is kept between sessions, for every character of the account" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Test::reload()
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(list().text("Linen Cloth").shown())
  Test::login({ guid: "Player-1-0002", name: "Regy", surname: "", realm: "Realm 4", faction: "Alliance", classTag: "MAGE" })
  Game::clock.server = START
  Game::items.tooltip = names
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(list().text("Linen Cloth").shown())
}

test "a list of 500 lines lets its oldest go for a new one" {
  Trading.shopping.add(ItemId::of(LINEN), 1, .ByHand)
  for (index of 1..499) { Trading.shopping.add(ItemId::of(COPPER_BAR), 1, .ByHand) }
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Test::expect(list().text("Linen Cloth").shown())
  Trading.shopping.add(ItemId::of(AXE), 1, .ByHand)
  Test::expect(!list().text("Linen Cloth").shown() && list().text("Bronze Axe").shown())
}

// «Buy N»

test "«Buy N» on a row asks its listings first; the next click prices a commodity's N, and «Confirm» buys them" {
  Game::items.owned = (id: integer): integer => id == COPPER_BAR ? 4 : 0
  Trading.shopping.add(ItemId::of(COPPER_BAR), 22, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.ready = true
  Game::auctionQuery.results.emit([{ key: COPPER_BAR, copper: 52, quantity: 400 }])
  _ = Test::requests()
  list().button("Buy 18").click()
  Test::expect(asked("AuctionQuery.listings 2840"))
  Game::auctionQuery.listed.emit(COPPER_BAR, [{ auction: 0, unit: 52, quantity: 400, own: false, commodity: true }])
  list().button("Buy 18").click()
  Test::expect(asked("AuctionActions.startPurchase 2840 18"))
  Game::auctionActions.answered.emit(.Quoted { item: COPPER_BAR, quantity: 18, total: 954 })
  Test::expect(reads(list().text("Copper Bar").item(), "Copper Bar | by hand | 18 | 4 of 22 held | 0g 0s 52c | 0g 9s 54c | Confirm"))
  list().button("Confirm").click()
  Test::expect(asked("AuctionActions.confirmPurchase 2840 18"))
  Game::auctionActions.answered.emit(.Bought)
  Game::items.owned = (id: integer): integer => id == COPPER_BAR ? 22 : 0
  Game::bags.changed.emit()
  Test::expect(list().text("Copper Bar").item().text("Bought").shown())
}

test "a row picked asks its listings; picked again it asks nothing more" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.ready = true
  _ = Test::requests()
  list().text("Linen Cloth").click()
  Test::expect(asked("AuctionQuery.listings 2589"))
  list().text("Linen Cloth").click()
  Test::expect(asked(""))
}

test "«Buy N» of an item buys out its cheapest auction with a buyout, one a click" {
  Trading.shopping.add(ItemId::of(AXE), 2, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.ready = true
  Game::auctionQuery.results.emit([{ key: AXE, copper: 2100, quantity: 3 }])
  list().button("Buy 2").click()
  Game::auctionQuery.listed.emit(AXE, [
    { auction: 72, unit: 2100, quantity: 1, buyout: 2100, left: 7200, own: true, commodity: false },
    { auction: 73, unit: 2200, quantity: 1, buyout: 2200, left: 7200, own: false, commodity: false }
  ])
  _ = Test::requests()
  list().button("Buy 2").click()
  Test::expect(asked("AuctionActions.bid 73 2200"))
}

test "«Buy N» waits for a price, and while the client answers another action" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.ready = true
  _ = Test::requests()
  list().button("Buy 20").click()
  Test::expect(asked(""))
  Game::auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  Game::auctionActions.busy = true
  list().button("Buy 20").click()
  Test::expect(asked(""))
}

test "removing the row picked lets its purchase go: another row picked asks its own listings" {
  Trading.shopping.add(ItemId::of(LINEN), 20, .ByHand)
  Trading.shopping.add(ItemId::of(COPPER_BAR), 3, .ByHand)
  Game::clock.server = START
  Game::items.tooltip = names
  Test::mount(nil, SCREEN)
  Game::auctionHouse.open = true
  Test::page().window("Sell").button("Shopping list").click()
  Game::auctionQuery.ready = true
  list().text("Linen Cloth").click()
  list().button("Remove").click()
  _ = Test::requests()
  list().text("Copper Bar").click()
  Test::expect(asked("AuctionQuery.listings 2840"))
}

