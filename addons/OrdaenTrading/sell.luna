// «Sell» (design `auction`): the bags' items the house takes (`Game.auctionActions.sellable()`, read again as the bags
// change), each with how many, the cheapest listed at the last look for one and for all of them, its market, what a
// merchant pays for one and for all of them, and which pays more (what it is listed for after the house's cut, against
// the merchant). The one picked, following the bags: a quantity (the counter Professions has, all the bags hold to
// start), a price for one (the lowest listed less a copper, the lowest itself where it is the player's own, or the
// market), the duration, the merchant's price and the deposit as money, and «Post», one auction a click (the client's
// from a click alone), saying why where nothing was sent. «My auctions» opens their window.
import Game from "$game"
import { Align, Frame, Track } from "$ltml"
import { ButtonPlate, Choice, Column, Component, Copper, CountInput, ItemButton, ItemId, ModuleMemory, MoneyField, PushButton, SECONDARY_TEXT, Segmented, Table, TableCell, TableRow, sortedBefore } from "Ordaen"
import { PriceHistory } from "@/history"
import { House, nameOf } from "@/house"
import { ItemPanel, PriceOrDash, merchantPays } from "@/itemPanel"
import Locale from "@/locales"
import { PostLog } from "@/posts"
import { PriceKey, PriceSource } from "@/quote"
import Style from "@/style"

// One item of the bags, as its row draws it: every stack of it counted, the first one what a post names.
public struct Offered {
  from: Game.Sellable
  item: ItemId
  name: String
  color: Color
  count: Integer
  // The cheapest listed at the last look (48 hours at most), for one and for all of them; the market.
  lowest: Copper | nil
  lowestAll: Integer | nil
  market: Copper | nil
  // What a merchant pays for one and for all of them; none where merchants don't buy it.
  merchant: Copper | nil
  merchantAll: Integer | nil
  // The house pays more than the merchant, after its cut; none where neither price is known.
  house: Boolean | nil
}

const NAME_COLUMN = 1
const LOWEST_COLUMN = 3
const LOWEST_ALL_COLUMN = 4
const MARKET_COLUMN = 5
const MERCHANT_COLUMN = 6
const MERCHANT_ALL_COLUMN = 7

const PRICE_WIDTH = 112.5dp
const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_ITEM, width: { fr: 1 }, sortable: true },
  { title: Locale.COLUMN_COUNT, width: 75dp, align: Align.End },
  { title: Locale.COLUMN_LOW, width: PRICE_WIDTH, align: Align.End, sortable: true, tip: Locale.LOW_TIP },
  { title: Locale.COLUMN_LOW_ALL, width: PRICE_WIDTH, align: Align.End, sortable: true, tip: Locale.LOW_ALL_TIP },
  { title: Locale.COLUMN_MARKET, width: PRICE_WIDTH, align: Align.End, sortable: true, tip: Locale.MARKET_TIP },
  { title: Locale.COLUMN_VENDOR, width: PRICE_WIDTH, align: Align.End, sortable: true, tip: Locale.VENDOR_PAYS_TIP },
  { title: Locale.COLUMN_VENDOR_ALL, width: PRICE_WIDTH, align: Align.End, sortable: true, tip: Locale.VENDOR_ALL_TIP },
  { title: Locale.COLUMN_BETTER, width: 105.46875dp }
]
const FILL: Array<Track> = [{ fr: 1 }]
const SIDE: Array<Track> = ["max-content", { fr: 1 }]
const TOOLS: Array<Track> = [{ fr: 1 }, "max-content"]
const ITEM: Array<Track> = ["max-content", { fr: 1 }]
// A label at the left, its value or control at the right.
const PAIR: Array<Track> = [{ fr: 1 }, "max-content"]
const STEP = 32.8125dp
// An auction's durations on Forever: the client's 1, 2 and 3 are 2, 8 and 24 hours.
const DURATIONS: Array<Choice<Game.Duration>> = [
  { value: Game.Duration.Short, label: Locale.HOURS.format(2) },
  { value: Game.Duration.Medium, label: Locale.HOURS.format(8) },
  { value: Game.Duration.Long, label: Locale.HOURS.format(24) }
]

// A price for one times how many; none where the price is.
function timesCount(copper: Copper | nil, count: Integer): Integer | nil {
  return copper != nil ? copper * count : nil
}

class OfferedRow implements Component {
  public pick: Event<ItemId> = new Event()

  derived better: String = self.offered.house == nil ? "—" : self.offered.house == true ? Locale.BETTER_HOUSE :
    Locale.BETTER_VENDOR
  derived betterInk: Color = self.offered.house == nil ? Style.DIM : self.offered.house == true ? Style.GREEN :
    Style.GOLD

  // The row's item: the table hands the row to another item as it scrolls.
  offered: Signal<Offered>
  selected: Signal<Boolean>
  constructor(offered: Signal<Offered>, selected: Signal<Boolean>) {
    self.offered = offered
    self.selected = selected
  }

  onPick(self) { self.pick.emit(self.offered.item) }

  // The item's tooltip beside its whole row.
  onRowEnter(self, frame: any Frame) {
    Game.items.show(frame, self.offered.item)
  }

  public render(self): Template {
    return $ltml {
      <TableRow selected={self.selected} @pick={self.onPick} @enter={self.onRowEnter}>
        <TableCell>
          <box columns={ITEM} gap={2.5sp} yAlign={Align.Center}>
            <ItemButton item={self.offered.item} size={Style.SLOT} tipped={false} />
            <box overflow={.Hidden}>
              <text value={self.offered.name} textColor={self.offered.color} wrap={.None} />
            </box>
          </box>
        </TableCell>
        <TableCell align={Align.End}>
          <text value={"%d"} arguments={[self.offered.count]} textColor={Style.INK} />
        </TableCell>
        <TableCell align={Align.End}> <PriceOrDash amount={self.offered.lowest} /> </TableCell>
        <TableCell align={Align.End}> <PriceOrDash amount={self.offered.lowestAll} /> </TableCell>
        <TableCell align={Align.End}> <PriceOrDash amount={self.offered.market} /> </TableCell>
        <TableCell align={Align.End}> <PriceOrDash amount={self.offered.merchant} /> </TableCell>
        <TableCell align={Align.End}> <PriceOrDash amount={self.offered.merchantAll} /> </TableCell>
        <TableCell> <text value={self.better} textColor={self.betterInk} wrap={.None} /> </TableCell>
      </TableRow>
    }
  }
}

// How the player left «Sell»'s list: its sorts (`Table`'s; none: as it comes).
public struct SellView implements Plain {
  sorts: Array<Integer> = []
}
const SELL_VIEW: SellView = {}

public class SellPage implements Component {
  // «My auctions» was clicked: its window opens, or closes.
  public openOwned: Event<nil> = new Event()

  // How the player left the list, the profile's (`ModuleMemory`).
  public list: mut ModuleMemory<SellView> = new ModuleMemory<SellView>(SELL_VIEW, .Profile, "sell")
  state picked: ItemId | nil = nil
  // Moves as the bags change, or an item the client hadn't loaded comes: what the house takes is read again.
  state bags = 0
  derived rows: Array<Offered> = self.rowsOf()
  // The row picked, while it is shown: one or none, handed to the window's side section.
  derived picks: Array<Offered> = self.chosenOf()

  const prices: any PriceSource
  chosen: mut Signal<Array<Offered>>
  constructor(
    prices: any PriceSource,
    // The row picked, while it is shown: the window's side section draws it.
    chosen: mut Signal<Array<Offered>>
  ) {
    self.prices = prices
    self.chosen = chosen
    watch (picks of self.picks) { self.chosen = picks.map(offered => offered) }
    Game.bags.changed.listen(self.onBags)
    Game.auctionActions.sellableChanged.listen(self.onBags)
  }

  onBags(mut self) { self.bags += 1 }

  rowsOf(self): Array<Offered> {
    _ = self.bags
    _ = self.prices.revision
    const given = Game.auctionActions.sellable() ?? []
    let list: Array<Offered> = []
    const at: Map<ItemId, Integer> = {}
    for (stack of given) {
      const item = ItemId.of(stack.item)
      const index = at[item]
      if (index != nil) {
        const kept = list[index]
        if (kept != nil) { list[index] = counted(kept, kept.count + stack.count) }
      } else {
        const key = PriceKey.of(item)
        const name, color = nameOf(item)
        const net = self.prices.sell(key)?.copper()
        const merchant = merchantPays(item)
        const house = net == nil ? (merchant == nil ? nil : false) : merchant == nil || net > merchant
        list.push(counted({
          from: stack, item: item, name: name, color: color, count: 0, lowest: self.prices.lowest(key)?.copper(),
          lowestAll: nil, market: self.prices.market(key)?.copper(), merchant: merchant, merchantAll: nil, house: house
        }, stack.count))
        at[item] = list.length
      }
    }
    const sorts = self.list.values.sorts
    if (sorts.length > 0) { list.sort((a, b) => sortedBefore(a, b, sorts, before, missing)) }
    return list
  }

  chosenOf(self): Array<Offered> {
    const picked = self.picked
    const row = picked != nil ? self.rows.find(row => row.item == picked) : nil
    return row != nil ? [row] : []
  }

  onPick(mut self, item: ItemId) { self.picked = item }

  onOpenOwned(mut self) { self.openOwned.emit() }

  public render(self): Template {
    return $ltml {
      <box rows={FILL}>
        <box rows={SIDE} gap={3sp}>
          // The row over the bags' items: «My auctions» at its right end.
          <box columns={TOOLS} gap={3sp} yAlign={Align.Center}>
            <text value={Locale.SELLABLE} textColor={Style.DIM} wrap={.None} />
            <PushButton label={Locale.PAGE_OWNED} width={Style.OPENER} @click={self.onOpenOwned} />
          </box>
          <box rows={FILL}>
            <Table columns={COLUMNS} sorts={mut self.list.values.sorts}>
              <OfferedRow $for={row of self.rows} $key={row.item} offered={row}
                          selected={self.picked == row.item} @pick={self.onPick} />
              <box $if={self.rows.length == 0} padding={Style.NOTE_PAD} yAlign={Align.Center}>
                <text value={Locale.NOTHING_TO_SELL} textColor={Style.DIM} />
              </box>
            </Table>
          </box>
        </box>
      </box>
    }
  }
}

// An item's row with `count` of it: its prices for all of them follow.
function counted(offered: Offered, count: Integer): Offered {
  return {
    count: count, lowestAll: timesCount(offered.lowest, count), merchantAll: timesCount(offered.merchant, count),
    ..offered
  }
}

// The most of an item one post takes: a commodity from every stack at once, an item's auction from its first stack.
function mostOf(offered: Offered): Integer {
  return offered.from.commodity ? offered.count : offered.from.count
}

// The price for one an item is put up at: a copper under the lowest listed (a copper at least), or the lowest itself
// where one of the player's own auctions asks that or less (the player isn't undercut by their own post); the market
// where nothing is listed.
function postingUnit(house: House, key: PriceKey, market: Copper | nil): Integer {
  const listed = house.listed(key)
  if (listed == nil) { return market ?? 0 }
  const low = listed.low()
  for (owned of peek Game.ownedAuctions.list) {
    const buyout = owned.buyout
    if (PriceKey.given(owned.key) == key && !owned.sold && buyout != nil && owned.quantity > 0 && (buyout / owned.quantity).floor() <= low) {
      return low
    }
  }
  return (low - 1).max(1)
}

// The item picked, in the item panel: how many, the price for one, how long, the deposit, and «Post». It follows its
// row as the bags change: what a post names is where the item lies now.
public class Posting implements Component {
  state count: Integer
  state unit: Integer
  state duration: Game.Duration = Game.Duration.Long
  // The client's refusal of the last post, in its words, or why nothing was sent.
  state refused: String | nil = nil
  // A post sent from here waits for its answer: how many it put up; 0 for none.
  state sending = 0
  derived hasRefused: Boolean = self.refused != nil
  derived refusedText: String = self.refused ?? ""
  derived most: Integer = mostOf(self.offered)
  derived canPost: Boolean = !Game.auctionActions.busy && self.count <= self.most && self.unit > 0
  // What the house holds back for this many for this long, as the client says it; «—» where it doesn't.
  derived deposit: Integer | nil = Game.auctionActions.deposit(self.offered.from, self.count, self.duration)
  // Under the item's name in its panel: how many the bags hold.
  derived detail: String = Locale.IN_BAGS.format(self.offered.count)

  offered: Signal<Offered>
  // The item: a row the panel follows is its item's alone.
  const key: PriceKey
  const name: String
  const color: Color
  const house: House
  const prices: any PriceSource
  const history: any PriceHistory | nil
  posts: mut PostLog
  constructor(
    offered: Signal<Offered>,
    house: House,
    prices: any PriceSource,
    history: any PriceHistory | nil,
    // Where a post the client took is logged.
    posts: mut PostLog
  ) {
    self.offered = offered
    self.posts = posts
    const first = peek offered
    self.key = PriceKey.of(first.item)
    self.name = first.name
    self.color = first.color
    self.house = house
    self.prices = prices
    self.history = history
    // All the bags hold, as one post takes them.
    self.count = mostOf(first)
    self.unit = postingUnit(house, self.key, first.market)
    Game.auctionActions.answered.listen(self.onAnswer)
  }

  // From the player's click alone: one auction; where nothing went, why.
  onPost(mut self) {
    const from = (peek self.offered).from
    const count = peek self.count
    const unit = peek self.unit
    const duration = peek self.duration
    const sent = from.commodity ? Game.auctionActions.postCommodity(from, count, duration, unit) :
      Game.auctionActions.postItem(from, count, duration, nil, unit * count)
    self.sending = sent ? count : 0
    self.refused = sent ? nil : Locale.POST_NOT_SENT
  }

  // The post's answer: taken, it is logged with its auctions (how long it takes to sell is matched to it); refused,
  // its words.
  onAnswer(mut self, answer: Game.ActionAnswer) {
    const count = peek self.sending
    if (count == 0) { return }
    self.sending = 0
    if (answer is Game.ActionAnswer.Refused) {
      self.refused = answer.reason
    } else if (answer is Game.ActionAnswer.Posted) {
      self.posts.record(self.name, count, answer.auctions)
    }
  }

  public render(self): Template {
    return $ltml {
      <ItemPanel key={self.key} name={self.name} color={self.color} detail={self.detail}
                 house={self.house} prices={self.prices} history={self.history} merchantSells={false}>
        <box gap={3sp}>
          <box columns={PAIR} gap={3sp} yAlign={Align.Center}>
            <text value={Locale.QUANTITY} textColor={Style.INK} />
            <CountInput value={mut self.count} least={1} most={self.most} step={STEP} />
          </box>
          <text value={Locale.UNIT_PRICE} textColor={Style.INK} />
          <MoneyField value={mut self.unit} />
          <text value={Locale.DURATION} textColor={Style.INK} />
          <Segmented value={mut self.duration} choices={DURATIONS} />
          <box columns={PAIR} gap={3sp} yAlign={Align.Center}>
            <text value={Locale.DEPOSIT} textColor={Style.INK} />
            <PriceOrDash amount={self.deposit} />
          </box>
          <text value={Locale.POSTING_RULE} textColor={Style.DIM} textSize={SECONDARY_TEXT} />
          <box>
            <text $if={self.hasRefused} value={self.refusedText} textColor={Style.RED} textSize={SECONDARY_TEXT} />
          </box>
          <PushButton label={Locale.POST} width={Style.PANEL_BUTTON} plate={ButtonPlate.Accent} disabled={!self.canPost}
                      @click={self.onPost} />
        </box>
      </ItemPanel>
    }
  }
}

// Whether `a` comes before `b` by the column (`sortedBefore`): by name, cheapest first.
function before(a: Offered, b: Offered, column: Integer): Boolean {
  if (column == NAME_COLUMN) { return a.name < b.name }
  if (column == LOWEST_COLUMN) { return (a.lowest ?? 0) < (b.lowest ?? 0) }
  if (column == LOWEST_ALL_COLUMN) { return (a.lowestAll ?? 0) < (b.lowestAll ?? 0) }
  if (column == MARKET_COLUMN) { return (a.market ?? 0) < (b.market ?? 0) }
  if (column == MERCHANT_COLUMN) { return (a.merchant ?? 0) < (b.merchant ?? 0) }
  if (column == MERCHANT_ALL_COLUMN) { return (a.merchantAll ?? 0) < (b.merchantAll ?? 0) }
  return false
}

// Whether a row has no price in the column (none listed, none known): it stands last, either way.
function missing(row: Offered, column: Integer): Boolean {
  if (column == LOWEST_COLUMN) { return row.lowest == nil }
  if (column == LOWEST_ALL_COLUMN) { return row.lowestAll == nil }
  if (column == MARKET_COLUMN) { return row.market == nil }
  if (column == MERCHANT_COLUMN) { return row.merchant == nil }
  return column == MERCHANT_ALL_COLUMN && row.merchantAll == nil
}
