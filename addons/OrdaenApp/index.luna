// Ordaen as the player has it: every module, told to Ordaen Core. A module's addon is
// loaded when the module is first turned on; one the player doesn't have stays off.
import Ordaen from "Ordaen"
import type { Minimap } from "OrdaenMinimap"
import type { Panel } from "OrdaenPanel"
import type { Professions } from "OrdaenProfessions"
import type { Settings } from "OrdaenSettings"
import type { Tooltips } from "OrdaenTooltips"

public class OrdaenApp implements App {
  constructor() {
    Ordaen.settingsBy(Ordaen.register("OrdaenSettings", "Ordaen Settings", "Interface/Icons/Trade_Engineering", (): any Ordaen.Module | nil => new Settings()))
    _ = Ordaen.register("OrdaenMinimap", "Ordaen Minimap", "Interface/Icons/INV_Misc_Map_01", (): any Ordaen.Module | nil => new Minimap())
    _ = Ordaen.register("OrdaenPanel", "Ordaen Panel", "Interface/Icons/INV_Misc_Note_01", (): any Ordaen.Module | nil => new Panel())
    _ = Ordaen.register("OrdaenProfessions", "Ordaen Professions", "Interface/Icons/Trade_BlackSmithing", (): any Ordaen.Module | nil => new Professions())
    _ = Ordaen.register("OrdaenTooltips", "Ordaen Tooltips", "Interface/Icons/INV_Misc_Book_09", (): any Ordaen.Module | nil => new Tooltips())
    Ordaen.start()
  }
}
