// Ordaen Spells' page in the settings window: the class trainer's window. Each control writes one entry of the
// settings as the player changes it.
import { Checkbox, Choice, Component, Dropdown, Settings } from "Ordaen"
import { TRAINER_VIEWS, TrainerView, trainerSorts } from "OrdaenTrainer"
import Locale from "@/locales"

// What the player chooses.
public struct Choices implements Plain {
  // The class trainer is drawn by this module; off, it is the game's.
  public mut trainer: boolean
  // The view and the sort (its place among the trainer's sorts, 0 its own order) the class trainer's window opens with.
  public mut trainerView: TrainerView
  public mut trainerSort: integer
}

// The «Trainer» page: whether the class trainer's window is ours, and the view and sort it opens with. What the
// window's own buttons change lasts until it closes.
public class TrainerSettingsPage implements Component {
  // The class trainer's sorts, as its sort button lists them.
  const sorts: array<Choice<integer>> = trainerSorts(Locale::COL_SKILL, false)

  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(): Template {
    return $ltml {
      <Checkbox label={Locale::SETTING_TRAINER} hint={Locale::SETTING_TRAINER_TIP} value={mut self.settings.values.trainer} />
      <Dropdown label={Locale::SETTING_TRAINER_VIEW} hint={Locale::SETTING_TRAINER_VIEW_TIP}
                value={mut self.settings.values.trainerView} choices={TRAINER_VIEWS} />
      <Dropdown label={Locale::SETTING_TRAINER_SORT} hint={Locale::SETTING_TRAINER_SORT_TIP}
                value={mut self.settings.values.trainerSort} choices={self.sorts} />
    }
  }
}
