// «Talents»: the trees side by side, each node drawn where the client puts it (its grid, from the tree's top left),
// Left-click spending a point in it and Right-click taking back one not applied yet; the search that dims what doesn't
// match, with «Activate» beside it for the spec that isn't active; the points left in the footer, and «Cancel
// changes» / «Apply changes» either side of them while points wait to be applied. What a node may do is the
// client's to say (`canSpend`, `canRefund`); the page only asks.
import Game from "$game"
import { Align, Track } from "$ltml"
import { ButtonPlate, Component, PushButton, TalentTreeView } from "Ordaen"
import Locale from "@/locales"
import Style from "@/style"

const TREES: Array<Track> = [{ fr: 1 }, { fr: 1 }, { fr: 1 }]
const PAGE: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
const FOOT: Array<Track> = [{ fr: 1 }, "max-content", { fr: 1 }]
const TOP: Array<Track> = [{ fr: 1 }, "max-content"]

public class TalentsPage implements Component {
  public spend: Event<Integer> = new Event()
  public refund: Event<Integer> = new Event()
  public apply: Event<nil> = new Event()
  public cancel: Event<nil> = new Event()
  public activate: Event<nil> = new Event()

  state search = ""
  derived points: String = Locale.TALENT_POINTS.format(self.unspent)
  derived empty: Boolean = self.trees.length == 0
  // Points wait to be applied: the spec's own, while it is the active one.
  derived waiting: Boolean = self.staged && self.active
  derived inactive: Boolean = !self.active

  trees: Signal<Array<Game.TalentTree>>
  unspent: Signal<Integer>
  staged: Signal<Boolean>
  active: Signal<Boolean>
  constructor(
    trees: Signal<Array<Game.TalentTree>>,
    unspent: Signal<Integer>,
    staged: Signal<Boolean>,
    // The spec group shown is the one the player has active.
    active: Signal<Boolean>
  ) {
    self.trees = trees
    self.unspent = unspent
    self.staged = staged
    self.active = active
  }

  onSpend(mut self, id: Integer) { self.spend.emit(id) }
  onRefund(mut self, id: Integer) { self.refund.emit(id) }
  onApply(mut self) { self.apply.emit() }
  onCancel(mut self) { self.cancel.emit() }
  onActivate(mut self) { self.activate.emit() }

  public render(self): Template {
    return $ltml {
      <box rows={PAGE} gap={2.5sp}>
        <box columns={TOP} gap={2.5sp} yAlign={Align.Center}>
          <box height={39.84375dp} rows={[{ fr: 1 }]}>
            <input value={mut self.search} padding={{ left: 3sp, right: 3sp }} textColor={Style.INK}
                   background={Color.hex("#00000080")} />
          </box>
          <PushButton $if={self.inactive} label={Locale.ACTIVATE} width={175.78125dp} @click={self.onActivate} />
        </box>
        <box $if={self.empty} xAlign={Align.Center} yAlign={Align.Center}>
          <text value={Locale.NO_TALENTS} textColor={Style.DIM} />
        </box>
        <box $else columns={TREES} gap={1sp}>
          <TalentTreeView $for={tree of self.trees} $key={tree.id} tree={tree} search={self.search} @spend={self.onSpend}
                          @refund={self.onRefund} />
        </box>
        <box columns={FOOT} gap={2.5sp} yAlign={Align.Center}>
          <box>
            <PushButton $if={self.waiting} label={Locale.CANCEL_CHANGES} width={222.65625dp} @click={self.onCancel} />
          </box>
          <text value={self.points} textColor={Style.INK} wrap={.None} />
          <box xAlign={Align.End}>
            <PushButton $if={self.waiting} label={Locale.APPLY_CHANGES} width={222.65625dp} plate={ButtonPlate.Accent} @click={self.onApply} />
          </box>
        </box>
      </box>
    }
  }
}
