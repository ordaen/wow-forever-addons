// The spellbook and the trainer as the player meets them: `/spellbook` or the game's own spellbook window opens ours,
// which lists the spells (the talents are Ordaen Character's), and the class trainer's window shows while the game's
// trainer is open. The root is drawn on the screen as Ordaen draws it; what the player asks of the game is heard as the fake
// game's requests.
import Client from "$client"
import Game from "$game"
import { Art } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import { glyphArt } from "Ordaen"

const PAGE: Test::Page = { left: 20, top: 20, width: 1300, height: 720, screen: true }
const ICON: Asset = "Interface/Icons/INV_Misc_Note_01"
// A text the spellbook window always shows: its tab.
const BOOK = "Spells"
// A text the trainer's window always shows.
const TRAINER = "Your money"
const SWORD: Asset = "Interface/Icons/INV_Sword_04"
// The colours a text or a box is to be drawn in.
const INK: Color = Color::hex("#e8dcc4")
const DIM: Color = Color::hex("#a3977f")
const RED: Color = Color::hex("#ff4040")
// A picked service's line.
const LIT: Color = Color::hex("#00000040")

function lines(): Array<Game::SpellLine> {
  return [{ index: 1, name: "General" }, { index: 2, name: "Warrior" }, { index: 3, name: "Arms" }]
}

function spells(): Array<Game::SpellEntry> {
  return [
    { id: 78, name: "Heroic Strike", rank: "Rank 2", icon: ICON, level: 8, passive: false, line: 2 },
    { id: 772, name: "Rend", rank: "Rank 1", icon: ICON, level: 4, passive: false, line: 2 },
    { id: 3127, name: "Parry", rank: "", icon: ICON, level: 6, passive: true, line: 2 },
    { id: 12294, name: "Mortal Strike", rank: "", icon: ICON, level: 40, passive: false, line: 3 },
    { id: 2481, name: "Find Treasure", rank: "", icon: ICON, level: 1, passive: false, line: 1 }
  ]
}

function services(): Array<Game::TrainerService> {
  return [
    {
      index: 1, name: "Heroic Strike", rank: "Rank 3", icon: SWORD, status: Game::ServiceStatus::Available, level: 8, cost: 400,
      description: "A strong attack."
    },
    {
      index: 2, name: "Charge", rank: "Rank 2", icon: nil, status: Game::ServiceStatus::Unavailable, level: 50, cost: 90000,
      description: "Charge an enemy."
    },
    {
      index: 3, name: "Rend", rank: "Rank 1", icon: nil, status: Game::ServiceStatus::Learned, level: 4, cost: 0,
      description: "Wounds the target."
    }
  ]
}

// Whether a text is drawn in this colour.
function drawnIn(part: Test::Part, color: Color): Boolean {
  const ink = part.textColor()
  return (ink.r * 255).round() == (color.r * 255).round() &&
    (ink.g * 255).round() == (color.g * 255).round() &&
    (ink.b * 255).round() == (color.b * 255).round() &&
    (ink.a * 255).round() == (color.a * 255).round()
}

// Whether every text is shown in the part, each drawn after the one before it.
function inOrder(part: Test::Part, wanted: Array<String>): Boolean {
  const texts = part.texts()
  let at = 0
  for (text of wanted) {
    let found = 0
    for (i, shown of texts) {
      if (shown == text && i > at && found == 0) { found = i }
    }
    if (found == 0) { return false }
    at = found
  }
  return true
}

// A choice picked from a toolbar button's list: the button by the glyph it shows, then the choice in its list.
function pick(window: Test::Part, button: Art, among: String, choice: String) {
  window.button(button).click()
  Test::page().window(among).button(choice).click()
}

// What another addon hears of the spellbook through the interface's registry of events.
class Heard {
  said: mut Array<String> = []
  onShow(mut self) { self.said.push("shown") }
  onHide(mut self) { self.said.push("hidden") }
}

// The spellbook opened by its command.
function book(): Test::Part {
  Test::open("/spellbook")
  return Test::page().window(BOOK)
}

// The spellbook window

test "the spellbook window opens with its command" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  Test::expect(!Test::page().window(BOOK).shown())
  Test::expect(book().text("Heroic Strike").shown())
}

test "the command again closes the spellbook window" {
  Test::mount(nil, PAGE)
  const window = book()
  Test::open("/spellbook")
  Test::expect(!window.shown())
}

test "the spellbook window's close button closes it" {
  Test::mount(nil, PAGE)
  const window = book()
  window.button(Ordaen.art.ctl.corner.close).click()
  Test::expect(!window.shown())
}

test "the spellbook reads the game's spells each time it opens" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  Test::open("/spellbook")
  Game::spellbook.entries = (): Array<Game::SpellEntry> => [
    { id: 6673, name: "Battle Shout", rank: "", icon: ICON, level: 1, passive: false, line: 2 }
  ]
  Test::open("/spellbook")
  Test::expect(window.text("Battle Shout").shown())
  Test::expect(!window.text("Rend").shown())
}

test "the game is asked for its words on spells while the spellbook shows, and no longer once it closes; none on talents" {
  Test::mount(nil, PAGE)
  _ = Test::requests()
  Test::expect(book().shown())
  const opened = Test::requests()
  Test::expect(opened.any(r => r == "Spellbook.watch true") && !opened.any(r => r.contains("TalentTrees")))
  Test::open("/spellbook")
  const closed = Test::requests()
  Test::expect(closed.any(r => r == "Spellbook.watch false"))
}

// The client's spells window, named to the module as the game loads it: shut, on no page yet.
function gameWindow(): any Client::Frame {
  Test::clientFrames()
  const found = Runtime::frame("PlayerSpellsFrame") ?? panic("the client has its spells window")
  const game: any Client::Frame = found
  Game::frames.PlayerSpells = game
  return game
}

test "the game's spells window on its spellbook page opens ours, and closes it as it hides" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const game = gameWindow()
  const window = Test::page().window(BOOK)
  Test::expect(!window.shown())
  Client::PlayerSpellsUtil::OpenToSpellBookTab()
  Test::expect(window.text("Rend").shown())
  game.Hide()
  Test::expect(!window.shown())
}

test "the game's spells window is kept out of sight while ours stands in its place" {
  Test::mount(nil, PAGE)
  const game = gameWindow()
  Client::PlayerSpellsUtil::OpenToSpellBookTab()
  Test::expect(Test::page().window(BOOK).shown())
  Test::expect(game.GetAlpha() == 0)
}

// A game window held away from its start: the game's window manager reads it as having no place among its three, so
// showing it later fills none.
function unmanaged(window: any Client::Frame): Boolean {
  Test::flush()
  return window.GetAttribute("UIPanelLayout-defined") == true && window.GetAttribute("UIPanelLayout-area") == nil
}

test "the game's spells window is held before the game shows it: the game's window manager never counts it" {
  Test::mount(nil, PAGE)
  const game = gameWindow()
  Test::expect(unmanaged(game))
}

test "the game's spells window on another page alone is let be: that page's addon holds it where it draws it" {
  Test::mount(nil, PAGE)
  const game = gameWindow()
  const window: any Client::Frame = game
  window.Show()
  Test::flush()
  Test::expect(game.GetAlpha() == 1)
}

test "the game's trainer window is held from its load while no trainer is open, and let be while a profession's is" {
  const own = Client::CreateFrame("Frame", "ClassTrainerFrame", Client::UIParent, nil)
  own.SetSize(300, 400)
  own.SetPoint("TOPLEFT", Client::UIParent, "TOPLEFT", 16, -100)
  Test::mount(nil, PAGE)
  // The game's trainer window loaded (as the first trainer opens): held from then, before any shows.
  Game::frames.Trainer = own
  Test::expect(unmanaged(own))
  Game::trainer.teachesClass = (): Boolean => false
  Game::trainer.open = true
  Test::flush()
  Test::expect(own.GetAlpha() == 1 && (own.GetLeft() ?? 0).floor() == 16)
}

test "the game's talents button opens nothing of ours: its talents page is Ordaen Character's" {
  Test::mount(nil, PAGE)
  _ = gameWindow()
  Runtime::press(Client::TalentMicroButton, .Left)
  Test::flush()
  Test::expect(!Test::page().window(BOOK).shown())
}

test "the game's spells window already on its spellbook page when it is named opens ours" {
  Test::mount(nil, PAGE)
  Test::clientFrames()
  Client::PlayerSpellsUtil::OpenToSpellBookTab()
  Game::frames.PlayerSpells = Runtime::frame("PlayerSpellsFrame")
  Test::expect(Test::page().window(BOOK).shown())
}

// The spells

test "each spell's row shows its name, and under it its skill line and its rank, bulleted; never the level it is learned at" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  Test::expect(window.text("Heroic Strike").item().texts().join(" | ") == "Heroic Strike | Warrior • Rank 2")
  Test::expect(window.text("Parry").item().texts().join(" | ") == "Parry | Warrior")
  Test::expect(window.text("Find Treasure").item().texts().join(" | ") == "Find Treasure | General")
  Test::expect(window.text("Mortal Strike").item().texts().join(" | ") == "Mortal Strike | Arms")
}

test "each spell's row shows its icon" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = (): Array<Game::SpellEntry> => [
    { id: 78, name: "Heroic Strike", rank: "", icon: SWORD, level: 8, passive: false, line: 2 },
    { id: 772, name: "Rend", rank: "", icon: ICON, level: 4, passive: false, line: 2 }
  ]
  const window = book()
  Test::expect(window.text("Heroic Strike").item().paintedWith(SWORD))
  Test::expect(!window.text("Rend").item().paintedWith(SWORD))
}

test "a spell learned at a new rank shows it in the open spellbook when the game's spellbook is opened" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  _ = gameWindow()
  const window = book()
  Test::expect(window.text("Heroic Strike").shown())
  Game::spellbook.entries = (): Array<Game::SpellEntry> => [
    { id: 78, name: "Heroic Strike", rank: "Rank 3", icon: SWORD, level: 16, passive: false, line: 2 }
  ]
  Client::PlayerSpellsUtil::OpenToSpellBookTab()
  const row = window.text("Heroic Strike").item()
  Test::expect(row.texts().join(" | ") == "Heroic Strike | Warrior • Rank 3")
  Test::expect(row.paintedWith(SWORD))
}

test "a spell learned while the spellbook shows is in it at once" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  Game::spellbook.entries = (): Array<Game::SpellEntry> => [
    { id: 6673, name: "Battle Shout", rank: "", icon: ICON, level: 1, passive: false, line: 2 }
  ]
  Game::spellbook.changed.emit()
  Test::expect(window.text("Battle Shout").shown())
  Test::expect(!window.text("Rend").shown())
}

test "a spell learned while the spellbook is shut asks the game for nothing" {
  Test::mount(nil, PAGE)
  let asked = 0
  Game::spellbook.entries = (): Array<Game::SpellEntry> => {
    asked += 1
    return []
  }
  Game::spellbook.changed.emit()
  Test::expect(asked == 0)
  Test::expect(!Test::page().window(BOOK).shown())
  Test::open("/spellbook")
  Test::expect(asked == 1)
}

test "a spell's name is drawn in ink and its detail dim" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const row = book().text("Parry").item()
  Test::expect(drawnIn(row.text("Parry"), INK))
  Test::expect(drawnIn(row.text("Warrior"), DIM))
}

test "the spells stand by name at first" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  Test::expect(inOrder(book(), ["Find Treasure", "Heroic Strike", "Mortal Strike", "Rend", "Parry"]))
}

// The columns grouped by spec: the grouping's button, then its choice.
function bySpec(window: Test::Part) {
  pick(window, Ordaen.art.ctl.tool.categories, "By type", "By spec")
}

test "by spec, the spells stand under a heading for each skill line, in the book's order; a line with none has none" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = (): Array<Game::SpellLine> => [
    { index: 1, name: "General" }, { index: 2, name: "Warrior" }, { index: 3, name: "Arms" }, { index: 4, name: "Fury" }
  ]
  Game::spellbook.entries = spells
  const window = book()
  bySpec(window)
  Test::expect(inOrder(window, ["General", "Find Treasure", "Warrior", "Heroic Strike", "Parry", "Rend", "Arms", "Mortal Strike"]))
  Test::expect(!window.text("Fury").shown() && !window.text("Active").shown())
}

test "the grouping is by type at first, and kept when the spellbook opens again" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  Test::expect(window.text("Active").shown() && window.text("Mortal Strike").item().texts().join(" | ") == "Mortal Strike | Arms")
  bySpec(window)
  Test::open("/spellbook")
  Test::open("/spellbook")
  Test::expect(!window.text("Active").shown() && window.text("Mortal Strike").item().texts().join(" | ") == "Mortal Strike")
}

test "the spellbook has no tabs: every skill line's spells stand on its one page" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  bySpec(window)
  Test::expect(!window.button("All").shown() && !window.button("Warrior").shown())
  Test::expect(window.text("Mortal Strike").shown() && window.text("Find Treasure").shown() && window.text("Parry").shown())
}

test "the search keeps the spells whose names hold it, in any case" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  window.input().type("STRIKE")
  Test::expect(window.text("Heroic Strike").shown() && window.text("Mortal Strike").shown())
  Test::expect(!window.text("Parry").shown() && !window.text("Find Treasure").shown())
}

test "a search nothing matches says nothing was found" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  Test::expect(!window.text("Nothing found.").shown())
  window.input().type("fireball")
  Test::expect(window.text("Nothing found.").shown())
}

test "sorted by level, the spells learned first stand first" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.sort, "By name", "By level")
  Test::expect(inOrder(window, ["Find Treasure", "Rend", "Heroic Strike", "Mortal Strike", "Parry"]))
}

test "the spells stand under two headings, the active ones and then the passive; a kind with none has none" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  Test::expect(inOrder(window, ["Active", "Find Treasure", "Rend", "Passive", "Parry"]))
  window.input().type("strike")
  Test::expect(window.text("Heroic Strike").shown() && !window.text("Passive").shown())
}

test "the sort offers no «Active first»: the headings stand the kinds apart" {
  Test::mount(nil, PAGE)
  const window = book()
  window.button(Ordaen.art.ctl.tool.sort).click()
  Test::expect(Test::page().window("By name").text("By level").shown())
  Test::expect(!Test::page().window("By name").text("Active first").shown())
}

test "two ranks of one spell stand by the level each is learned at" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = (): Array<Game::SpellEntry> => [
    { id: 6547, name: "Rend", rank: "Rank 2", icon: ICON, level: 10, passive: false, line: 2 },
    { id: 772, name: "Rend", rank: "Rank 1", icon: ICON, level: 4, passive: false, line: 2 }
  ]
  Test::expect(inOrder(book(), ["Warrior • Rank 1", "Warrior • Rank 2"]))
}

test "the spellbook's sort is kept when it opens again" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.sort, "By name", "By level")
  Test::open("/spellbook")
  Test::open("/spellbook")
  Test::expect(inOrder(window, ["Find Treasure", "Rend", "Heroic Strike", "Mortal Strike", "Parry"]))
}

test "by type, sorted by specialization, the spells stand by skill line, then by name" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.sort, "By name", "By specialization")
  Test::expect(inOrder(window, ["Find Treasure", "Heroic Strike", "Rend", "Mortal Strike", "Parry"]))
}

test "by spec, the sort offers no sort by specialization" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  bySpec(window)
  window.button(Ordaen.art.ctl.tool.sort).click()
  Test::expect(!Test::page().window("By name").text("By specialization").shown())
}

test "by spec, a spell's line names no skill line: a passive one says it is passive, then its rank" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  bySpec(window)
  Test::expect(window.text("Parry").item().texts().join(" | ") == "Parry | Passive")
  Test::expect(window.text("Rend").item().texts().join(" | ") == "Rend | Rank 1")
}

test "the spells stand in three columns" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  _ = book()
  Test::shot("five spells: three in the first row, two in the second")
}

test "the window narrows no further than three columns of spells" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  _ = book()
  const grip = Test::painted(Ordaen.art.ctl.grip, nil)
  Test::moveTo(grip)
  Test::press(nil)
  Test::moveTo({ x: grip.x + 1, y: grip.y })
  Test::pass(0.05)
  Test::moveTo({ x: grip.x - 2000, y: grip.y })
  Test::pass(0.05)
  Test::release(nil)
  Test::flush()
  // By type the active spells by name: three in the first row, Rend under them.
  const first = Test::holding("Find Treasure", nil).y
  Test::expect(Test::holding("Heroic Strike", nil).y == first && Test::holding("Mortal Strike", nil).y == first)
  Test::expect(Test::holding("Rend", nil).y > first)
}

test "the filter keeps the passive spells alone, or the active ones" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  // The filter's list says «Active» and «Passive» as the headings do: it is the surface drawn after the window.
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test::page().window("Active").nth(2).button("Passive").click()
  Test::expect(window.text("Parry").shown() && !window.text("Rend").shown())
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test::page().window("Passive").nth(2).button("Active").click()
  Test::expect(!window.text("Parry").shown() && window.text("Rend").shown())
}

test "the table view shows a spell's skill line, kind and level in columns, sorted by a heading" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.columns, "In columns", "Table")
  Test::expect(window.text("Rend (Rank 1)").item().texts().join(" | ") == "Rend (Rank 1) | Warrior | Active | 4")
  window.button("Level").click()
  Test::expect(inOrder(window, ["Find Treasure", "Rend (Rank 1)", "Parry", "Heroic Strike (Rank 2)", "Mortal Strike"]))
  window.button("Level").click()
  Test::expect(inOrder(window, ["Mortal Strike", "Heroic Strike (Rank 2)", "Parry", "Rend (Rank 1)", "Find Treasure"]))
  Test::shot("the table, by level from the highest")
}

// Dragged from a spell's row a little way: pressed, moved, a frame, let go.
function drag(name: String) {
  const from = Test::holding(name, nil)
  Test::moveTo(from)
  Test::press(nil)
  Test::moveTo({ x: from.x + 20, y: from.y + 10 })
  Test::flush()
  Test::release(nil)
}

test "a spell dragged out of the spellbook is on the cursor, for the action bars to take" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  _ = book()
  Test::expect(!Client::CursorHasSpell())
  drag("Rend")
  Test::expect(Client::CursorHasSpell())
}

test "a passive spell dragged puts nothing on the cursor" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  _ = book()
  drag("Parry")
  Test::expect(!Client::CursorHasSpell())
}

test "a click on a spell's slot casts the rank clicked, the client's own doing; a passive one's casts nothing" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  _ = Test::performed()
  window.text("Rend").item().button(ICON).click()
  Test::expect(Test::performed().join(", ") == "spell Rend(Rank 1)")
  window.text("Parry").item().button(ICON).click()
  Test::expect(Test::performed().length == 0)
}

test "Shift+Left-click on a spell's slot puts it in as the game's book does, and casts nothing" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  _ = Test::requests()
  _ = Test::performed()
  Test::hold([.Shift])
  Test::hold([.Shift])
  window.text("Rend").item().button(ICON).click()
  Test::hold([])
  Test::expect(Test::requests().any(r => r == "Spellbook.link 772"))
  Test::expect(Test::performed().length == 0)
}

test "the pick-up's click, rebound to Ctrl, puts the spell on the cursor and casts nothing; Alt casts it on the player" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  _ = Test::performed()
  Game::input.modifiedClick = (click: Game::ModifiedClick): Boolean => click == .PickupAction
  Test::hold([.Ctrl])
  window.text("Rend").item().button(ICON).click()
  Test::hold([])
  Test::expect(Client::CursorHasSpell() && Test::performed().length == 0)
  Client::ClearCursor()
  Game::input.modifiedClick = (click: Game::ModifiedClick): Boolean => click == .SelfCast
  Test::hold([.Alt])
  window.text("Rend").item().button(ICON).click()
  Test::hold([])
  Test::expect(Test::performed().join(", ") == "spell Rend(Rank 1) player")
}

test "the cursor on a spell's slot shows the game's tooltip of the spell" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  _ = Test::requests()
  window.text("Mortal Strike").item().button(ICON).hover()
  Test::expect(Test::requests().any(r => r == "Items.showSpell 12294"))
}

test "a spell not learned yet is dimmed, cast by nothing and put on no bar" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = (): Array<Game::SpellEntry> => [
    { id: 100, name: "Charge", rank: "", icon: ICON, level: 4, passive: false, line: 2, learned: false }
  ]
  const window = book()
  Test::expect(drawnIn(window.text("Charge"), DIM))
  _ = Test::performed()
  window.text("Charge").item().button(ICON).click()
  Test::expect(Test::performed().length == 0)
  drag("Charge")
  Test::expect(!Client::CursorHasSpell())
}

test "a spell cooling down is shaded by the client's clock until the client says it is ready" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  let running = true
  Game::spellbook.cooldown = (spell: Game::SpellEntry): Game::SpellRun | nil => running && spell.id == 772 ? { start: 10, length: 6 } : nil
  const window = book()
  const shaded = Color::hex("#0000004d")
  Test::expect(window.text("Rend").item().paintedWith(shaded) && !window.text("Parry").item().paintedWith(shaded))
  running = false
  Game::spellbook.cooldownsChanged.emit()
  Test::expect(!window.text("Rend").item().paintedWith(shaded))
}

test "a racial passive's rank says «Racial» alone: its group says it is passive" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = (): Array<Game::SpellEntry> => [
    { id: 20573, name: "Hardiness", rank: "Racial Passive", icon: ICON, level: 1, passive: true, line: 1 }
  ]
  const window = book()
  Test::expect(window.text("Hardiness").item().texts().join(" | ") == "Hardiness | General • Racial")
}

test "a rank by its number reads «Rank 2», a word as the client gives it" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = (): Array<Game::SpellEntry> => [
    { id: 116, name: "Frostbolt", rank: "Уровень 2", icon: ICON, level: 4, passive: false, line: 2 },
    { id: 20577, name: "Cannibalize", rank: "Racial", icon: ICON, level: 1, passive: false, line: 1 }
  ]
  const window = book()
  Test::expect(window.text("Frostbolt").item().texts().join(" | ") == "Frostbolt | Warrior • Rank 2")
  Test::expect(window.text("Cannibalize").item().texts().join(" | ") == "Cannibalize | General • Racial")
}

test "the pet's spells stand last under its book; the right button on a pet's spell turns its autocast, marked while on" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  Game::spellbook.petBook = (): String | nil => "Demon"
  Game::spellbook.petEntries = (): Array<Game::SpellEntry> => [
    { id: 3716, name: "Torment", rank: "", icon: SWORD, level: 10, passive: false, line: 0, pet: true, slot: 1 }
  ]
  let auto = false
  Game::spellbook.autoCast = (spell: Game::SpellEntry): Boolean | nil => spell.pet ? auto : nil
  const window = book()
  Test::expect(inOrder(window, ["Active", "Rend", "Passive", "Parry", "Demon", "Torment"]))
  // Its book says whose it is and its line: under it, nothing.
  Test::expect(window.text("Torment").item().texts().join(" | ") == "Torment")
  bySpec(window)
  Test::expect(inOrder(window, ["Arms", "Mortal Strike", "Demon", "Torment"]))
  const gold = Color::hex("#ffd100")
  Test::expect(!window.text("Torment").item().paintedWith(gold))
  _ = Test::requests()
  auto = true
  window.text("Torment").item().button(SWORD).rightClick()
  Test::expect(Test::requests().any(r => r == "Spellbook.toggleAutoCast 3716"))
  Test::expect(window.text("Torment").item().paintedWith(gold))
}

test "opened and closed by its command, the spellbook plays the game's sounds and tells other addons" {
  Test::mount(nil, PAGE)
  const played: Array<Integer> = []
  Client::PlaySound = (kit: Integer, channel: String | nil, once: Boolean | nil): (Boolean | nil, Unknown) => {
    played.push(kit)
    return true, nil
  }
  const heard = new Heard()
  Client::EventRegistry.RegisterCallback("PlayerSpellsFrame.SpellBookFrame.Show", (owner: Unknown): nil => heard.onShow(), heard)
  Client::EventRegistry.RegisterCallback("PlayerSpellsFrame.SpellBookFrame.Hide", (owner: Unknown): nil => heard.onHide(), heard)
  _ = book()
  Test::expect(heard.said.join(", ") == "shown")
  Test::expect(played.length == 1 && played[1] == Client::SOUNDKIT["UI_CLASS_TALENT_OPEN_WINDOW"])
  Test::open("/spellbook")
  Test::expect(heard.said.join(", ") == "shown, hidden")
  Test::expect(played.length == 2 && played[2] == Client::SOUNDKIT["UI_CLASS_TALENT_CLOSE_WINDOW"])
}

test "the spellbook's footer counts the spells shown, the active and the passive ones" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  Test::expect(window.texts().join(" | ").contains("Shown | 5 | Active spells | 4 | Passive spells | 1"))
  window.input().type("strike")
  Test::expect(window.texts().join(" | ").contains("Shown | 2 | Active spells | 2 | Passive spells | 0"))
}

test "the spellbook's footer is a band of marble across the window, its counts on it" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  const band = Test::painted(Ordaen.art.window.marble, nil)
  const count = Test::holding("Shown", nil)
  const spell = window.text("Parry").rect()
  // The counts stand in the band, under its line: a little below its middle; the band runs from the window's left.
  Test::expect(count.y > band.y && count.y - band.y < 8 && band.y > spell.bottom && band.x > count.x)
}

test "the spellbook's tab shows the game's own book" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  Game::spellbook.entries = spells
  const window = book()
  // The icon stands left of the tab's title, on its line.
  const tab = window.box("Interface/Icons/INV_Misc_Book_09").rect()
  const title = window.text(BOOK).rect()
  Test::expect(tab.right <= title.left && tab.top < title.bottom && tab.bottom > title.top)
}

test "a long name wraps in its column, on its font's own lines, and is never cut" {
  Test::mount(nil, PAGE)
  Game::spellbook.lines = lines
  const long = "Improved Heroic Strike of the Long Winter Nights"
  Game::spellbook.entries = (): Array<Game::SpellEntry> => {
    const list: Array<Game::SpellEntry> = []
    for (spell of spells()) { list.push(spell) }
    list.push({ id: 99, name: long, rank: "Rank 3", icon: ICON, level: 20, passive: false, line: 2 })
    return list
  }
  const window = book()
  const wrapped = window.text(`${long}`).rect()
  const one = window.text("Parry").rect()
  const height = (wrapped.bottom - wrapped.top) / (one.bottom - one.top)
  // Two lines at least, each as high as one line of the font: no line height round them.
  Test::expect(height >= 1.9 && (height - height.round()).abs() < 0.15)
}

// The trainer

test "the trainer's window shows while the game's class trainer is open" {
  Test::mount(nil, PAGE)
  Test::expect(!Test::page().window(TRAINER).shown())
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  Test::expect(window.text("Heroic Strike").shown())
  Game::trainer.open = false
  Test::expect(!window.shown())
}

test "a trainer whose list fills after it shows, in the same frame, shows the list" {
  Test::mount(nil, PAGE)
  let filled = false
  Game::trainer.services = (): Array<Game::TrainerService> => filled ? services() : []
  // TRAINER_SHOW with the list empty, then TRAINER_UPDATE with it filled, before a frame passes.
  Game::trainer.open = true
  Game::trainer.changed.emit()
  filled = true
  Game::trainer.changed.emit()
  Test::expect(Test::page().window(TRAINER).text("Heroic Strike").shown())
}

