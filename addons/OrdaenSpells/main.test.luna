test "the trainer shows the player's money" {
  Test::mount(nil, PAGE)
  Game::money.amount = 5000
  Game::trainer.open = true
  Test::expect(Test::page().window(TRAINER).text("0g 50s 0c").shown())
}

test "a price the player can't pay is red, one they can in ink" {
  Test::mount(nil, PAGE)
  Game::money.amount = 5000
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  Test::expect(drawnIn(window.text("9g 0s 0c"), RED))
  Test::expect(drawnIn(window.text("Heroic Strike").item().text("0g 4s 0c"), INK))
}

test "Learn buys the picked service where it can be learned and paid for, and is greyed otherwise" {
  Test::mount(nil, PAGE)
  Game::trainer.services = services
  const bought: Array<Integer> = []
  Client::BuyTrainerService = (index: Integer): nil => bought.push(index)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.button("Heroic Strike").click()
  Test::expect(window.button("Learn").paintedWith(Ordaen.art.ctl.buttonDisabled))
  Game::money.amount = 1000
  window.button("Learn").click()
  Test::expect(bought.length == 1 && bought[1] == 1)
  window.button("Charge").click()
  window.button("Learn").click()
  Test::expect(bought.length == 1)
}

// Three services that can be learned now around one that can't yet, each said by its description.
function described(): Array<Game::TrainerService> {
  return [
    { index: 1, name: "A", rank: "", icon: nil, status: Game::ServiceStatus::Available, level: 1, cost: 100, description: "About A" },
    { index: 2, name: "B", rank: "", icon: nil, status: Game::ServiceStatus::Unavailable, level: 30, cost: 100, description: "About B" },
    { index: 3, name: "C", rank: "", icon: nil, status: Game::ServiceStatus::Available, level: 1, cost: 100, description: "About C" },
    { index: 4, name: "D", rank: "", icon: nil, status: Game::ServiceStatus::Available, level: 1, cost: 100, description: "About D" }
  ]
}

test "Learn goes on to the next service that can be learned now, past one that can't, and from the top past the end" {
  Test::mount(nil, PAGE)
  Game::trainer.services = described
  Game::money.amount = 1000
  const bought: Array<Integer> = []
  Client::BuyTrainerService = (index: Integer): nil => bought.push(index)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.button("A").click()
  window.button("Learn").click()
  Test::expect(bought[1] == 1 && window.text("About C").shown() && !window.text("About A").shown())
  window.button("D").click()
  window.button("Learn").click()
  Test::expect(bought[2] == 4 && window.text("About A").shown())
}

// Four services that can be learned now (one starting a profession), and one that can't yet.
function batch(): Array<Game::TrainerService> {
  return [
    { index: 1, name: "A", rank: "", icon: nil, status: Game::ServiceStatus::Available, level: 1, cost: 100, description: "" },
    { index: 2, name: "B", rank: "", icon: nil, status: Game::ServiceStatus::Unavailable, level: 30, cost: 100, description: "" },
    { index: 3, name: "C", rank: "", icon: nil, status: Game::ServiceStatus::Available, level: 1, cost: 200, description: "" },
    {
      index: 4, name: "Mining", rank: "", icon: nil, status: Game::ServiceStatus::Available, level: 1, cost: 10, description: "",
      profession: true
    },
    { index: 5, name: "E", rank: "", icon: nil, status: Game::ServiceStatus::Available, level: 1, cost: 300, description: "" }
  ]
}

test "«Learn available» stands in the one footer under the list and the card, there while a skill is picked too" {
  Test::mount(nil, PAGE)
  Game::trainer.services = batch
  Game::money.amount = 1000
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.button("A").click()
  const all = window.button("Learn available · 0g 6s 0c").rect()
  const learn = window.button("Learn").rect()
  // Under the card's «Learn», at the band's right: under the card's column, past the list.
  Test::expect(all.top > learn.bottom && all.right > learn.left)
}

test "with nothing picked, «Learn available» asks first, then learns what can be learned now from the bottom up, no profession" {
  Test::mount(nil, PAGE)
  Game::trainer.services = batch
  Game::money.amount = 1000
  const bought: Array<Integer> = []
  Client::BuyTrainerService = (index: Integer): nil => bought.push(index)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.button("Learn available · 0g 6s 0c").click()
  Test::expect(bought.length == 0 && Test::page().text("Learn 3 skills for").shown())
  Test::page().window("Learn 3 skills for").button("Learn").click()
  Test::expect(bought.length == 3 && bought[1] == 5 && bought[2] == 3 && bought[3] == 1)
}

test "«Learn available» is greyed while the money doesn't pay for all; a list changed since it asked learns nothing" {
  Test::mount(nil, PAGE)
  Game::trainer.services = batch
  Game::money.amount = 500
  const bought: Array<Integer> = []
  Client::BuyTrainerService = (index: Integer): nil => bought.push(index)
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.button("Learn available · 0g 6s 0c").click()
  Test::expect(!Test::page().text("Learn 3 skills for").shown())
  window.button("Learn available · 0g 6s 0c").hover()
  Test::expect(Test::page().text("Not enough money for all of them together.").shown())
  Game::money.amount = 1000
  window.button("Learn available · 0g 6s 0c").click()
  Game::trainer.services = (): Array<Game::TrainerService> => batch().filter(service => service.index != 5)
  Game::trainer.changed.emit()
  Test::page().window("Learn 3 skills for").button("Learn").click()
  Test::expect(bought.length == 0)
}

// Settings

test "the window's settings button opens Spells' page of the settings, the trainer's" {
  Test::mount(nil, PAGE)
  const window = book()
  window.button(Ordaen.art.ctl.corner.gear).click()
  const settings = Test::page().window("Class trainer window")
  Test::expect(settings.text("Sorted by").shown() && !settings.text("Name of the first spec tab").shown())
}

test "the settings' windows page lists the spellbook's window and the trainer's" {
  Test::mount(nil, PAGE)
  const window = book()
  window.button(Ordaen.art.ctl.corner.gear).click()
  const settings = Test::page().window("Class trainer window")
  settings.button("Windows").click()
  Test::expect(Test::page().window("Windows").text("Trainer").shown())
}

test "the trainer's window switched off in the settings leaves the game's trainer to the game" {
  Test::mount(nil, PAGE)
  Game::trainer.open = true
  const window = Test::page().window(TRAINER)
  window.button(Ordaen.art.ctl.corner.gear).click()
  // The checkbox beside «Class trainer window»: its well, the page's only one, names it; its label doesn't.
  Test::page().window("Class trainer window").button(Ordaen.art.ctl.check).click()
  Test::expect(!window.shown())
}

// A service with a rank.
function ranked(service: Game::TrainerService): Game::TrainerService {
  return {
    index: service.index, name: service.name, rank: "Rank 1", icon: service.icon, status: service.status, level: service.level,
    cost: service.cost, description: service.description, profession: service.profession
  }
}

test "«Learn available»'s tip names each skill it learns, with its rank and price; the card what all not learned costs" {
  Test::mount(nil, PAGE)
  Game::trainer.services = (): Array<Game::TrainerService> => batch().map(service => ranked(service))
  Game::money.amount = 1000
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.button("Learn available · 0g 6s 0c").hover()
  const tip = Test::page().window("Learn available")
  Test::expect(tip.texts().join(" | ") == "Learn available | A (Rank 1) | 0g 1s 0c | C (Rank 1) | 0g 2s 0c | E (Rank 1) | 0g 3s 0c")
  // A, B (not yet), C, E: what Mining, a profession, adds too.
  Test::expect(window.texts().join(" | ").contains("Due to learn all: | 0g 7s 10c"))
}

test "a class trainer's own window stands away, unseen, while ours shows" {
  const own = Client::CreateFrame("Frame", "ClassTrainerFrame", Client::UIParent, nil)
  own.SetSize(300, 400)
  own.SetPoint("TOPLEFT", Client::UIParent, "TOPLEFT", 16, -100)
  own.Show()
  Test::mount(nil, PAGE)
  Game::frames.Trainer = own
  Game::trainer.services = batch
  Game::trainer.open = true
  Game::trainer.changed.emit()
  Test::flush()
  Test::expect(own.GetAlpha() == 0 && (own.GetLeft() ?? 0) < -1000)
}

test "a service's line names its spec before its rank, and its card lights what its description says" {
  Test::mount(nil, PAGE)
  Game::trainer.services = (): Array<Game::TrainerService> => [
    {
      index: 1, name: "Rend", rank: "Rank 2", icon: nil, status: Game::ServiceStatus::Available, level: 10, cost: 100,
      description: "Wounds the target for 28 damage over 12 sec.", skillLine: "Arms"
    }
  ]
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  Test::expect(window.text("Arms · Rank 2 · Requires level 10").shown())
  window.button("Rend").click()
  Test::expect(window.text("Wounds the target for |cffffd10028|r damage over |cffffd10012 sec.|r").shown())
}
