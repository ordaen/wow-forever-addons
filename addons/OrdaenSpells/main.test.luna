    { index: 2, name: "B", rank: "", icon: nil, status: Game::ServiceStatus::Unavailable, level: 1, cost: 0, description: "" },
    { index: 3, name: "C", rank: "", icon: nil, status: Game::ServiceStatus::Unavailable, level: 1, cost: 0, description: "" },
    { index: 4, name: "D", rank: "", icon: nil, status: Game::ServiceStatus::Learned, level: 1, cost: 0, description: "" },
    { index: 5, name: "E", rank: "", icon: nil, status: Game::ServiceStatus::Learned, level: 1, cost: 0, description: "" },
    { index: 6, name: "F", rank: "", icon: nil, status: Game::ServiceStatus::Learned, level: 1, cost: 0, description: "" }
  ]
