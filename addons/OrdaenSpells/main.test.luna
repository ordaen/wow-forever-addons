// The windows on the stand-in game: the spellbook with its tabs and a search, the talents with the trees given to it,
// and the class trainer with a service picked. The root is drawn on the screen as Ordaen draws it.
import Client from "$client"
import Game from "$game"
import { Art, MouseButton } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Spells from "OrdaenSpells"
import { SortBy, SpellbookPage } from "@/spellbook"
import { Order, Show, TrainerPage } from "@/trainer"

const PAGE: Test.Page = { left: 20, top: 20, width: 1300, height: 720, screen: true }
const AREA: Test.Page = { left: 20, top: 20, width: 800, height: 560 }
const ICON: Asset = "Interface/Icons/INV_Misc_Note_01"

function lines(): Array<Game.SpellLine> {
  return [{ index: 1, name: "General" }, { index: 2, name: "Warrior" }, { index: 3, name: "Arms" }]
}

function spells(): Array<Game.SpellEntry> {
  return [
    { id: 78, name: "Heroic Strike", rank: "Rank 2", icon: ICON, level: 8, passive: false, line: 2 },
    { id: 772, name: "Rend", rank: "Rank 1", icon: ICON, level: 4, passive: false, line: 2 },
    { id: 3127, name: "Parry", rank: "", icon: ICON, level: 6, passive: true, line: 2 },
    { id: 12294, name: "Mortal Strike", rank: "", icon: ICON, level: 40, passive: false, line: 3 },
    { id: 2481, name: "Find Treasure", rank: "", icon: ICON, level: 1, passive: false, line: 1 },
  ]
}

test "the spellbook lists every spell with its skill line, kind and level" {
  Test.mount(nil, PAGE)
  Spells.spells = spells()
  Spells.lines = lines()
  Spells.open = true
  Test.flush()
  Test.shot("all spells, by name")
  Spells.tab = 1
  Test.flush()
  Test.expect(Spells.spells.length == 5)
}

test "the talents tab draws the trees of the game, and a click spends, refunds, applies or cancels" {
  Test.mount(nil, PAGE)
  Spells.open = true
  Spells.tab = 2
  Test.flush()
  Test.shot("no trees: it says so")
  Game.talentTrees.trees = (group: Integer): Array<Game.TalentTree> => {
    return [
      {
        id: 1, name: "Arms",
        nodes: [
          {
            id: 10, x: 0, y: 0, name: "Deflection", icon: ICON, rank: 2, ranks: 5, canSpend: true, canRefund: true,
            edges: [11],
          },
          { id: 11, x: 600, y: 600, name: "Tactical Mastery", icon: ICON, rank: 0, ranks: 3, canSpend: false, canRefund: false, edges: [] },
        ],
      },
      {
        id: 2, name: "Fury",
        nodes: [{ id: 20, x: 0, y: 0, name: "Booming Voice", icon: ICON, rank: 5, ranks: 5, canSpend: false, canRefund: true, edges: [] }],
      },
    ]
  }
  Game.talentTrees.unspent = (group: Integer): Integer => 3
  Game.talentTrees.staged = (): Boolean => true
  Spells.refreshTalents()
  Test.flush()
  Test.shot("two trees with their nodes where the client puts them, three points left")
  Test.click(Test.holding("2/5", nil), nil)
  Test.click(Test.holding("2/5", nil), MouseButton.Right)
  Test.click(Test.holding("Apply changes", nil), nil)
  Test.click(Test.holding("Cancel changes", nil), nil)
  Test.shot("what was asked of the game")
  Spells.tab = 3
  Test.flush()
  Test.click(Test.holding("Activate", nil), nil)
  Test.shot("the second spec: Activate asks the game to switch")
}

test "the class trainer lists its services and a click shows one's card" {
  Test.mount(nil, PAGE)
  Game.money.amount = 5000
  Spells.services = [
    {
      index: 1, name: "Heroic Strike", rank: "Rank 3", icon: nil, status: Game.ServiceStatus.Available, level: 8, cost: 400,
      description: "A strong attack.",
    },
    {
      index: 2, name: "Charge", rank: "Rank 2", icon: nil, status: Game.ServiceStatus.Unavailable, level: 50, cost: 90000,
      description: "Charge an enemy.",
    },
    { index: 3, name: "Rend", rank: "Rank 1", icon: nil, status: Game.ServiceStatus.Learned, level: 4, cost: 0, description: "" },
  ]
  Game.trainer.open = true
  Test.flush()
  Test.shot("three services: nothing picked")
  Test.click(Test.holding("Heroic Strike (Rank 3)", nil), nil)
  Test.shot("one picked: its card, the price and the disabled button")
}

test "a skill line's tab, the search and each sort order the spellbook's list" {
  const fixture = new Fixture()
  const page = new SpellbookPage(fixture.spells, fixture.lines)
  Test.mount(page, AREA)
  Test.flush()
  Test.expect(page.shown.length == 5)
  Test.expect(page.shown[1]?.name == "Find Treasure")
  page.sort = SortBy.Level
  Test.expect(page.shown[1]?.name == "Find Treasure" && page.shown[5]?.name == "Mortal Strike")
  page.sort = SortBy.Active
  Test.expect(page.shown[5]?.name == "Parry")
  page.tab = 3
  Test.expect(page.shown.length == 3)
  page.search = "rend"
  Test.expect(page.shown.length == 1 && page.shown[1]?.name == "Rend")
  Test.flush()
  Test.shot("the Warrior tab narrowed by a search")
}

test "the trainer's filter, sort and search narrow its services" {
  const fixture = new Fixture()
  const page = new TrainerPage(fixture.services, fixture.level)
  Test.mount(page, AREA)
  Test.flush()
  Test.expect(page.shown.length == 3)
  page.show = Show.Available
  Test.expect(page.shown.length == 1)
  page.show = Show.Unavailable
  Test.expect(page.shown.length == 1 && page.shown[1]?.name == "Charge")
  page.show = Show.Learned
  Test.expect(page.shown.length == 1 && page.shown[1]?.name == "Rend")
  page.show = Show.All
  page.order = Order.Price
  Test.expect(page.shown[1]?.name == "Rend" && page.shown[3]?.name == "Charge")
  page.search = "heroic"
  Test.expect(page.shown.length == 1)
}

// The cells a page under test is given.
class Fixture {
  state spells: Array<Game.SpellEntry> = spells()
  state lines: Array<Game.SpellLine> = lines()
  state level = 20
  state services: Array<Game.TrainerService> = [
    {
      index: 1, name: "Heroic Strike", rank: "Rank 3", icon: nil, status: Game.ServiceStatus.Available, level: 8, cost: 400,
      description: "",
    },
    {
      index: 2, name: "Charge", rank: "Rank 2", icon: nil, status: Game.ServiceStatus.Unavailable, level: 50, cost: 90000,
      description: "",
    },
    { index: 3, name: "Rend", rank: "Rank 1", icon: nil, status: Game.ServiceStatus.Learned, level: 4, cost: 0, description: "" },
  ]
}

// The choice picked from a toolbar button's list: the button by the glyph it shows, then the choice.
function pickFrom(button: Art, choice: String) {
  Test.click(Test.painted(button, nil), nil)
  Test.click(Test.holding(choice, nil), nil)
}

test "the sort and the filter buttons are clicked and the lists follow" {
  Test.mount(nil, PAGE)
  Spells.spells = spells()
  Spells.lines = lines()
  Spells.open = true
  Game.trainer.services = (): Array<Game.TrainerService> => {
    return [
      {
        index: 1, name: "Heroic Strike", rank: "Rank 3", icon: nil, status: Game.ServiceStatus.Available, level: 8,
        cost: 400, description: "A strong attack.",
      },
      {
        index: 2, name: "Charge", rank: "Rank 2", icon: nil, status: Game.ServiceStatus.Unavailable, level: 50,
        cost: 90000, description: "",
      },
    ]
  }
  Test.flush()
  pickFrom(Ordaen.art.ctl.tool.sort, "By level")
  Test.shot("the spells by level")
  Spells.open = false
  Game.trainer.open = true
  Game.trainer.changed.emit()
  Test.flush()
  pickFrom(Ordaen.art.ctl.tool.sort, "By price")
  Test.shot("the services by price")
  pickFrom(Ordaen.art.ctl.tool.filter, "Unavailable")
  Test.shot("the services narrowed to the unavailable")
}

test "the game's spellbook window opens ours, and one the game makes again does too" {
  Test.mount(nil, PAGE)
  Test.clientFrames()
  const found = Runtime.frame("PlayerSpellsFrame") ?? panic("the client has its spellbook window")
  const first: any Client.Frame = found
  Game.frames.PlayerSpells = first
  Test.flush()
  Test.expect(!Spells.open)
  first.Show()
  Test.flush()
  Test.expect(Spells.open && Spells.gameShown)
  Test.shot("the game's window shown: ours stands in its place")
  first.Hide()
  Test.flush()
  Test.expect(!Spells.open && !Spells.gameShown)
  const second = Client.CreateFrame("Frame", "PlayerSpellsFrameAgain", Client.UIParent, nil)
  second.Hide()
  Game.frames.PlayerSpells = second
  Test.flush()
  second.Show()
  Test.flush()
  Test.expect(Spells.open)
}
