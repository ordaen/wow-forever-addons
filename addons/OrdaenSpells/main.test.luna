}

test "a price of all the player's money is in ink" {
  Test.mount(nil, PAGE)
  Game.money.amount = 400
  Game.trainer.services = services
  Game.trainer.open = true
  Game.trainer.changed.emit()
  Test.expect(drawnIn(Test.page().window(TRAINER).text("Heroic Strike (Rank 3)").item().text("0g 4s 0c"), INK))
}

test "the trainer shows the player's money" {
  Test.mount(nil, PAGE)
  Game.money.amount = 5000
  Game.trainer.open = true
  Test.expect(Test.page().window(TRAINER).text("0g 50s 0c").shown())
}

test "a price the player can't pay is red, one they can in ink" {
  Test.mount(nil, PAGE)
  Game.money.amount = 5000
  Game.trainer.services = services
  Game.trainer.open = true
  Game.trainer.changed.emit()
  const window = Test.page().window(TRAINER)
  Test.expect(drawnIn(window.text("9g 0s 0c"), RED))
  Test.expect(drawnIn(window.text("0g 4s 0c"), INK))
}

test "Learn buys the picked service where it can be learned and paid for, and is greyed otherwise" {
  Test.mount(nil, PAGE)
  Game.trainer.services = services
  const bought: Array<Integer> = []
  Client.BuyTrainerService = (index: Integer): nil => bought.push(index)
  Game.trainer.open = true
  Game.trainer.changed.emit()
  const window = Test.page().window(TRAINER)
  window.button("Heroic Strike (Rank 3)").click()
  Test.expect(window.button("Learn").paintedWith(Ordaen.art.ctl.buttonDisabled))
  Game.money.amount = 1000
  window.button("Learn").click()
  Test.expect(bought.length == 1 && bought[1] == 1)
  window.button("Charge (Rank 2)").click()
  window.button("Learn").click()
  Test.expect(bought.length == 1)
}

// Settings

test "the window's settings button opens Spells' page of the settings" {
  Test.mount(nil, PAGE)
  const window = book()
  window.button(Ordaen.art.ctl.corner.gear).click()
  const settings = Test.page().window("Name of the first spec tab")
  Test.expect(settings.text("Name of the second spec tab").shown() && settings.text("Class trainer window").shown())
}

test "the settings' windows page lists the spellbook's window and the trainer's" {
  Test.mount(nil, PAGE)
  const window = book()
  window.button(Ordaen.art.ctl.corner.gear).click()
  const settings = Test.page().window("Name of the first spec tab")
  settings.button("Windows").click()
  Test.expect(Test.page().window("Windows").text("Trainer").shown())
}

test "a name given to the first spec in the settings stands on its tab" {
  Test.mount(nil, PAGE)
  const window = book()
  window.button(Ordaen.art.ctl.corner.gear).click()
  const settings = Test.page().window("Name of the first spec tab")
  for (i of 1..30) {
    if (Test.keyboard()) { break }
    Test.key(Test.Move.Next)
  }
  Test.type("Arms")
  // The typing is written as it rests.
  Test.expect(!window.button("Arms").shown())
  Test.pass(0.3)
  Test.expect(window.button("Arms").shown() && !window.button("Primary").shown() && settings.shown())
}

test "a name given to the second spec in the settings stands on its tab" {
  Test.mount(nil, PAGE)
  _ = book()
  const window = Test.page().window("Primary")
  window.button(Ordaen.art.ctl.corner.gear).click()
  const settings = Test.page().window("Name of the first spec tab")
  for (i of 1..30) {
    if (Test.keyboard()) { break }
    Test.key(Test.Move.Next)
  }
  // The second field is the next the keyboard reaches.
  Test.key(Test.Move.Next)
  Test.type("Fury")
  // Enter writes it at once.
  Test.key(Key.Enter)
  Test.expect(window.button("Fury").shown() && !window.button(BOOK).shown() && settings.shown())
}

test "the trainer's window switched off in the settings leaves the game's trainer to the game" {
  Test.mount(nil, PAGE)
  Game.trainer.open = true
  const window = Test.page().window(TRAINER)
  window.button(Ordaen.art.ctl.corner.gear).click()
  const settings = Test.page().window("Name of the first spec tab")
  // The checkbox beside «Class trainer window»: its well, the page's only one, names it; its label doesn't.
  settings.button(Ordaen.art.ctl.check).click()
  Test.expect(!window.shown())
}
