// The trainer's window open on `services`, what is known shown too: the filter's «Learned» switched on (it starts off),
// and the filter shut again.
function trainerWithKnown(): Test::Part {
  Test::mount(nil, PAGE)
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test::page().window("Reset").button("Learned").click()
  window.button(Ordaen.art.ctl.tool.filter).click()
  return window
}

test "what is known is left out at first" {
  Test::mount(nil, PAGE)
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  Test::expect(window.text("Heroic Strike").shown() && !window.text("Rend").shown())
}

test "a service learned for free shows no price" {
  const window = trainerWithKnown()
  Test::expect(window.text("Rend").item().texts().join(" | ") == "Rend | Rank 1 · Learned")
}

test "a name is never red: what a service needs is, while unmet; a learned one is dim" {
  const window = trainerWithKnown()
  Test::expect(drawnIn(window.text("Charge"), INK) && drawnIn(window.text("Rank 2 · Requires level 50"), RED))
  Test::expect(drawnIn(window.text("Heroic Strike"), INK) && drawnIn(window.text("Rank 3 · Requires level 8"), DIM))
  Test::expect(drawnIn(window.text("Rend"), DIM))
}

test "in the table a class trainer's columns are the skill, its rank, the level and the price; an unmet level red" {
  Test::mount(nil, PAGE)
  Game::player.level = 20
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  pick(window, Ordaen.art.ctl.tool.list, "One list", "Table")
  Test::expect(window.text("Skill").shown() && window.text("Rank").shown() && window.text("Price").shown())
  Test::expect(window.text("Charge").item().texts().join(" | ") == "Charge | 2 | 50 | 9g 0s 0c")
  Test::expect(drawnIn(window.text("50"), RED) && drawnIn(window.text("8"), INK))
}

test "what a service needs turns dim once the trainer says it can be learned" {
  Test::mount(nil, PAGE)
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  Game::trainer.services = (): Array<Game::TrainerService> => services().map(service => Game.TrainerService { status: .Available, ..service })
  Game::trainer.changed.emit()
  Test::expect(drawnIn(window.text("Rank 2 · Requires level 50"), DIM))
}

test "the services stand in the trainer's order at first" {
  Test::expect(inOrder(trainerWithKnown(), ["Heroic Strike", "Charge", "Rend"]))
}

test "sorted by the skill's name, the services stand by name" {
  const window = trainerWithKnown()
  pick(window, Ordaen.art.ctl.tool.sort, "Available first", "Skill")
  Test::expect(inOrder(window, ["Charge", "Heroic Strike", "Rend"]))
}

test "sorted by level, by price or available first, the services stand so" {
  const window = trainerWithKnown()
  pick(window, Ordaen.art.ctl.tool.sort, "Available first", "Level")
  Test::expect(inOrder(window, ["Rend", "Heroic Strike", "Charge"]))
  pick(window, Ordaen.art.ctl.tool.sort, "Available first", "Price")
  Test::expect(inOrder(window, ["Rend", "Heroic Strike", "Charge"]))
  pick(window, Ordaen.art.ctl.tool.sort, "Available first", "Available first")
  Test::expect(inOrder(window, ["Heroic Strike", "Charge", "Rend"]))
}

test "services alike in the sort stand in the trainer's order" {
  Test::mount(nil, PAGE)
  Game::trainer.services = (): Array<Game::TrainerService> => [
    { index: 1, name: "Rend", rank: "", icon: nil, status: Game::ServiceStatus::Available, level: 4, cost: 100, description: "" },
    { index: 2, name: "Charge", rank: "", icon: nil, status: Game::ServiceStatus::Available, level: 4, cost: 100, description: "" }
  ]
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  pick(window, Ordaen.art.ctl.tool.sort, "Available first", "Price")
  Test::expect(inOrder(window, ["Rend", "Charge"]))
}

test "the filter's switches keep the services available, unavailable or learned" {
  Test::mount(nil, PAGE)
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.button(Ordaen.art.ctl.tool.filter).click()
  // Learned starts off: switched on, it shows.
  Test::page().window("Reset").button("Learned").click()
  Test::expect(window.text("Rend").shown() && window.text("Charge").shown())
  Test::page().window("Reset").button("Unavailable").click()
  Test::expect(!window.text("Charge").shown() && window.text("Heroic Strike").shown())
}

test "the trainer's search keeps the services whose names hold it, in any case" {
  Test::mount(nil, PAGE)
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.input().type("HEROIC")
  Test::expect(window.text("Heroic Strike").shown() && !window.text("Charge").shown())
}

test "a trainer's search nothing matches says nothing was found" {
  Test::mount(nil, PAGE)
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  Test::expect(!window.text("Nothing found.").shown())
  window.input().type("fireball")
  Test::expect(window.text("Nothing found.").shown())
}

test "the trainer's filter is kept when it opens again, and its sort is the settings' again" {
  Test::mount(nil, PAGE)
  Game::trainer.services = services
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  pick(window, Ordaen.art.ctl.tool.sort, "Available first", "Skill")
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test::page().window("Reset").button("Learned").click()
  Game::trainer.open = false
  Test::expect(!window.shown())
  Game::trainer.open = true
  Test::expect(window.text("Rend").shown())
  Test::expect(inOrder(window, ["Heroic Strike", "Charge", "Rend"]))
}

test "the trainer's page of the settings chooses the sort the trainer's window opens with" {
