test "a picked spell says what changes against the rank the player has, and the game's facts of it in the tooltip's band" {
  Test::mount(nil, PAGE)
  Game::trainer.services = (): Array<Game::TrainerService> => [
    {
      index: 1, name: "Heroic Strike", rank: "Rank 3", icon: SWORD, status: Game::ServiceStatus::Available, level: 8, cost: 400,
      description: "A strong attack that deals 32 more damage.", spell: 285
    }
  ]
  Game::spellbook.entries = (): Array<Game::SpellEntry> => [
    { id: 284, name: "Heroic Strike", rank: "Rank 2", icon: SWORD, level: 4, passive: false, line: 2 }
  ]
  Game::spells.description = (id: Integer): String | nil => id == 284 ? "Deals 21 more damage." : "Deals 32 more damage."
  Game::spells.tooltip = (id: Integer): Game::TooltipData | nil => {
    return { lines: [{ left: "Heroic Strike", kind: 13 }, { left: "15 Rage", right: "Melee Range", kind: 0 }, { left: "Next melee", kind: 0 }] }
  }
  Game::spells.cost = (id: Integer): Game::SpellCost | nil => ({ amount: 15, resource: .Rage })
  Game::trainer.open = true
  Game::trainer.changed.emit()
  const window = Test::page().window(TRAINER)
  window.button("Heroic Strike").click()
  Test::expect(window.text("What changes").shown() && window.text("21").shown() && window.text("→").shown() &&
      window.text("32").shown())
  // The game's facts as the tooltip's band: the cost a dot in rage's colour, the range, the cast.
  Test::expect(window.text("15").item().box(glyphArt(.Cost)).shown())
  Test::expect(window.text("5 yd").shown() && window.text("Next").item().box(glyphArt(.CastNext)).shown())
}

