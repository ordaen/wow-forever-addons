// The spellbook and the trainer as the player meets them: `/spellbook` or the game's own spellbook window opens ours,
// its tabs list the spells and the talents of each spec, and the class trainer's window shows while the game's trainer
// is open. The root is drawn on the screen as Ordaen draws it; what the player asks of the game is heard as the fake
// game's requests.
import Client from "$client"
import Game from "$game"
import { Art, Key } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import { Component } from "Ordaen"
import { SpellbookPage } from "@/spellbook"

const PAGE: Test.Page = { left: 20, top: 20, width: 1300, height: 720, screen: true }
const ICON: Asset = "Interface/Icons/INV_Misc_Note_01"
// A text the spellbook window always shows: its third tab.
const BOOK = "Secondary"
// A text the trainer's window always shows.
const TRAINER = "Your money"
const SWORD: Asset = "Interface/Icons/INV_Sword_04"
// The colours a text or a box is to be drawn in.
const INK: Color = Color.hex("#e8dcc4")
const DIM: Color = Color.hex("#a3977f")
const GOLD: Color = Color.hex("#ffd100")
const RED: Color = Color.hex("#ff4040")
const GREEN: Color = Color.hex("#40d060")
// An arrow of a tree that leads to a talent with no rank.
const LINE: Color = Color.hex("#4a3a24")
// A picked service's line.
const LIT: Color = Color.hex("#00000040")

function lines(): Array<Game.SpellLine> {
  return [{ index: 1, name: "General" }, { index: 2, name: "Warrior" }, { index: 3, name: "Arms" }]
}

function spells(): Array<Game.SpellEntry> {
  return [
    { id: 78, name: "Heroic Strike", rank: "Rank 2", icon: ICON, level: 8, passive: false, line: 2 },
    { id: 772, name: "Rend", rank: "Rank 1", icon: ICON, level: 4, passive: false, line: 2 },
    { id: 3127, name: "Parry", rank: "", icon: ICON, level: 6, passive: true, line: 2 },
    { id: 12294, name: "Mortal Strike", rank: "", icon: ICON, level: 40, passive: false, line: 3 },
    { id: 2481, name: "Find Treasure", rank: "", icon: ICON, level: 1, passive: false, line: 1 }
  ]
}

// The trees of a spec: the first spec's two, the second's one.
function trees(group: Integer): Array<Game.TalentTree> {
  if (group == 2) {
    return [
      {
        id: 3, name: "Protection",
        nodes: [{ id: 30, x: 0, y: 0, name: "Shield Wall", icon: ICON, rank: 1, ranks: 2, canSpend: true, canRefund: true, edges: [] }]
      }
    ]
  }
  return [
    {
      id: 1, name: "Arms",
      nodes: [
        { id: 10, x: 0, y: 0, name: "Deflection", icon: ICON, rank: 2, ranks: 5, canSpend: true, canRefund: true, edges: [11] },
        { id: 11, x: 600, y: 600, name: "Tactical Mastery", icon: ICON, rank: 0, ranks: 3, canSpend: false, canRefund: false, edges: [] }
      ]
    },
    {
      id: 2, name: "Fury",
      nodes: [{ id: 20, x: 0, y: 0, name: "Booming Voice", icon: ICON, rank: 5, ranks: 5, canSpend: false, canRefund: true, edges: [] }]
    }
  ]
}

function services(): Array<Game.TrainerService> {
  return [
    {
      index: 1, name: "Heroic Strike", rank: "Rank 3", icon: SWORD, status: Game.ServiceStatus.Available, level: 8, cost: 400,
      description: "A strong attack."
    },
    {
      index: 2, name: "Charge", rank: "Rank 2", icon: nil, status: Game.ServiceStatus.Unavailable, level: 50, cost: 90000,
      description: "Charge an enemy."
    },
    {
      index: 3, name: "Rend", rank: "Rank 1", icon: nil, status: Game.ServiceStatus.Learned, level: 4, cost: 0,
      description: "Wounds the target."
    }
  ]
}

// Whether a text is drawn in this colour.
function drawnIn(part: Test.Part, color: Color): Boolean {
  const ink = part.textColor()
  return (ink.r * 255).round() == (color.r * 255).round() &&
    (ink.g * 255).round() == (color.g * 255).round() &&
    (ink.b * 255).round() == (color.b * 255).round() &&
    (ink.a * 255).round() == (color.a * 255).round()
}

// Whether every text is shown in the part, each drawn after the one before it.
function inOrder(part: Test.Part, wanted: Array<String>): Boolean {
  const texts = part.texts()
  let at = 0
  for (text of wanted) {
    let found = 0
    for (i, shown of texts) {
      if (shown == text && i > at && found == 0) { found = i }
    }
    if (found == 0) { return false }
    at = found
  }
  return true
}

// A choice picked from a toolbar button's list: the button by the glyph it shows, then the choice in its list.
function pick(window: Test.Part, button: Art, among: String, choice: String) {
  window.button(button).click()
  Test.page().window(among).button(choice).click()
}

// What another addon hears of the spellbook through the interface's registry of events.
class Heard {
  said: mut Array<String> = []
  onShow(mut self) { self.said.push("shown") }
  onHide(mut self) { self.said.push("hidden") }
}

// The spellbook opened by its command.
function book(): Test.Part {
  Test.open("/spellbook")
  return Test.page().window(BOOK)
}

// The spellbook window

test "the spellbook window opens with its command" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  Test.expect(!Test.page().window(BOOK).shown())
  Test.expect(book().text("Heroic Strike (Rank 2)").shown())
}

test "the command again closes the spellbook window" {
  Test.mount(nil, PAGE)
  const window = book()
  Test.open("/spellbook")
  Test.expect(!window.shown())
}

test "the spellbook window's close button closes it" {
  Test.mount(nil, PAGE)
  const window = book()
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!window.shown())
}

test "the spellbook reads the game's spells each time it opens" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  Test.open("/spellbook")
  Game.spellbook.entries = (): Array<Game.SpellEntry> => [
    { id: 6673, name: "Battle Shout", rank: "", icon: ICON, level: 1, passive: false, line: 2 }
  ]
  Test.open("/spellbook")
  Test.expect(window.text("Battle Shout").shown())
  Test.expect(!window.text("Rend (Rank 1)").shown())
}

test "the game is asked for its words on spells and talents while the spellbook shows, and no longer once it closes" {
  Test.mount(nil, PAGE)
  _ = Test.requests()
  Test.expect(book().shown())
  const opened = Test.requests()
  Test.expect(opened.any(r => r == "Spellbook.watch true") && opened.any(r => r == "TalentTrees.watch true"))
  Test.open("/spellbook")
  const closed = Test.requests()
  Test.expect(closed.any(r => r == "Spellbook.watch false") && closed.any(r => r == "TalentTrees.watch false"))
}

test "the game's spellbook window opens ours, and closes it as it hides" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  Test.clientFrames()
  const found = Runtime.frame("PlayerSpellsFrame") ?? panic("the client has its spellbook window")
  const game: any Client.Frame = found
  Game.frames.PlayerSpells = game
  const window = Test.page().window(BOOK)
  Test.expect(!window.shown())
  game.Show()
  Test.expect(window.text("Rend (Rank 1)").shown())
  game.Hide()
  Test.expect(!window.shown())
}

test "the game's spellbook window is kept out of sight while ours stands in its place" {
  Test.mount(nil, PAGE)
  Test.clientFrames()
  const found = Runtime.frame("PlayerSpellsFrame") ?? panic("the client has its spellbook window")
  const game: any Client.Frame = found
  Game.frames.PlayerSpells = game
  game.Show()
  Test.expect(Test.page().window(BOOK).shown())
  Test.expect(game.GetAlpha() == 0)
}

test "a spellbook window the game makes again opens ours too" {
  Test.mount(nil, PAGE)
  Test.clientFrames()
  const found = Runtime.frame("PlayerSpellsFrame") ?? panic("the client has its spellbook window")
  Game.frames.PlayerSpells = found
  const second = Client.CreateFrame("Frame", "PlayerSpellsFrameAgain", Client.UIParent, nil)
  second.Hide()
  Game.frames.PlayerSpells = second
  const window = Test.page().window(BOOK)
  Test.expect(!window.shown())
  second.Show()
  Test.expect(window.shown())
}

test "the game's spellbook window already shown when it is named opens ours" {
  Test.mount(nil, PAGE)
  Test.clientFrames()
  const shown = Client.CreateFrame("Frame", "PlayerSpellsFrameShown", Client.UIParent, nil)
  shown.Show()
  Game.frames.PlayerSpells = shown
  Test.expect(Test.page().window(BOOK).shown())
}

// The spells

test "each spell's row shows its name and rank, its skill line, its kind and the level it was learned at" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  Test.expect(window.text("Heroic Strike (Rank 2)").item().texts().join(" | ") == "Heroic Strike (Rank 2) | Warrior. Active. Level 8")
  Test.expect(window.text("Parry").item().texts().join(" | ") == "Parry | Warrior. Passive. Level 6")
  Test.expect(window.text("Find Treasure").item().texts().join(" | ") == "Find Treasure | General. Active. Level 1")
  Test.expect(window.text("Mortal Strike").item().texts().join(" | ") == "Mortal Strike | Arms. Active. Level 40")
}

test "each spell's row shows its icon" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = (): Array<Game.SpellEntry> => [
    { id: 78, name: "Heroic Strike", rank: "", icon: SWORD, level: 8, passive: false, line: 2 },
    { id: 772, name: "Rend", rank: "", icon: ICON, level: 4, passive: false, line: 2 }
  ]
  const window = book()
  Test.expect(window.text("Heroic Strike").item().paintedWith(SWORD))
  Test.expect(!window.text("Rend").item().paintedWith(SWORD))
}

test "a spell learned at a new rank shows it in the open spellbook when the game's spellbook is opened" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  Test.clientFrames()
  const game = Client.CreateFrame("Frame", "PlayerSpellsFrameLater", Client.UIParent, nil)
  game.Hide()
  Game.frames.PlayerSpells = game
  const window = book()
  Test.expect(window.text("Heroic Strike (Rank 2)").shown())
  Game.spellbook.entries = (): Array<Game.SpellEntry> => [
    { id: 78, name: "Heroic Strike", rank: "Rank 3", icon: SWORD, level: 16, passive: false, line: 2 }
  ]
  game.Show()
  const row = window.text("Heroic Strike (Rank 3)").item()
  Test.expect(row.texts().join(" | ") == "Heroic Strike (Rank 3) | Warrior. Active. Level 16")
  Test.expect(row.paintedWith(SWORD))
}

test "a spell learned while the spellbook shows is in it at once" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  Game.spellbook.entries = (): Array<Game.SpellEntry> => [
    { id: 6673, name: "Battle Shout", rank: "", icon: ICON, level: 1, passive: false, line: 2 }
  ]
  Game.spellbook.changed.emit()
  Test.expect(window.text("Battle Shout").shown())
  Test.expect(!window.text("Rend (Rank 1)").shown())
}

test "a spell learned while the spellbook is shut asks the game for nothing" {
  Test.mount(nil, PAGE)
  let asked = 0
  Game.spellbook.entries = (): Array<Game.SpellEntry> => {
    asked += 1
    return []
  }
  Game.spellbook.changed.emit()
  Test.expect(asked == 0)
  Test.expect(!Test.page().window(BOOK).shown())
  Test.open("/spellbook")
  Test.expect(asked == 1)
}

test "a spell's name is drawn in ink and its detail dim" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const row = book().text("Parry").item()
  Test.expect(drawnIn(row.text("Parry"), INK))
  Test.expect(drawnIn(row.text("Warrior. Passive. Level 6"), DIM))
}

test "the spellbook has a tab for all spells and one per skill line" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  Test.expect(inOrder(book(), ["All", "General", "Warrior", "Arms"]))
}

test "the spells stand by name at first" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  Test.expect(inOrder(book(), ["Find Treasure", "Heroic Strike (Rank 2)", "Mortal Strike", "Parry", "Rend (Rank 1)"]))
}

test "a skill line's tab shows the spells of that line alone" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  window.button("Warrior").click()
  Test.expect(window.text("Heroic Strike (Rank 2)").shown() && window.text("Parry").shown() && window.text("Rend (Rank 1)").shown())
  Test.expect(!window.text("Mortal Strike").shown() && !window.text("Find Treasure").shown())
}

test "the All tab shows the spells of every skill line again" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  window.button("Warrior").click()
  window.button("All").click()
  Test.expect(window.text("Mortal Strike").shown() && window.text("Find Treasure").shown() && window.text("Parry").shown())
}

test "the search keeps the spells whose names hold it, in any case" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  window.input().type("STRIKE")
  Test.expect(window.text("Heroic Strike (Rank 2)").shown() && window.text("Mortal Strike").shown())
  Test.expect(!window.text("Parry").shown() && !window.text("Find Treasure").shown())
}

test "the search narrows the skill line's tab it is typed in" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  window.button("Warrior").click()
  window.input().type("strike")
  Test.expect(window.text("Heroic Strike (Rank 2)").shown())
  Test.expect(!window.text("Mortal Strike").shown())
}

test "a search nothing matches says nothing was found" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  Test.expect(!window.text("Nothing found.").shown())
  window.input().type("fireball")
  Test.expect(window.text("Nothing found.").shown())
}

test "sorted by level, the spells learned first stand first" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.sort, "Active first", "By level")
  Test.expect(inOrder(window, ["Find Treasure", "Rend (Rank 1)", "Parry", "Heroic Strike (Rank 2)", "Mortal Strike"]))
}

test "sorted active first, the passive spells stand last" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.sort, "Active first", "Active first")
  Test.expect(inOrder(window, ["Find Treasure", "Heroic Strike (Rank 2)", "Mortal Strike", "Rend (Rank 1)", "Parry"]))
}

test "two ranks of one spell stand by the level each is learned at" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = (): Array<Game.SpellEntry> => [
    { id: 6547, name: "Rend", rank: "", icon: ICON, level: 10, passive: false, line: 2 },
    { id: 772, name: "Rend", rank: "", icon: ICON, level: 4, passive: false, line: 2 }
  ]
  Test.expect(inOrder(book(), ["Warrior. Active. Level 4", "Warrior. Active. Level 10"]))
}

test "the spellbook's sort is kept when it opens again" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.sort, "Active first", "By level")
  Test.open("/spellbook")
  Test.open("/spellbook")
  Test.expect(inOrder(window, ["Find Treasure", "Rend (Rank 1)", "Parry", "Heroic Strike (Rank 2)", "Mortal Strike"]))
}

test "on All, sorted by specialization, the spells stand by skill line, then by name" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.sort, "Active first", "By specialization")
  Test.expect(inOrder(window, ["Find Treasure", "Heroic Strike (Rank 2)", "Parry", "Rend (Rank 1)", "Mortal Strike"]))
}

test "a skill line's tab offers no sort by specialization" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  window.button("Warrior").click()
  window.button(Ordaen.art.ctl.tool.sort).click()
  Test.expect(!Test.page().window("Active first").text("By specialization").shown())
}

test "a skill line's tab names no skill line under a spell: its kind and level alone" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  window.button("Warrior").click()
  Test.expect(window.text("Parry").item().texts().join(" | ") == "Parry | Passive. Level 6")
}

test "the spells stand in three columns" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  _ = book()
  Test.shot("five spells: three in the first row, two in the second")
}

// The spellbook's page alone, as wide as it is told.
class NarrowBook implements Component {
  state spells: Array<Game.SpellEntry> = spells()
  state lines: Array<Game.SpellLine> = lines()
  state width: Number<Length> = 562.5dp

  public render(self): Template {
    return $ltml { <SpellbookPage spells={self.spells} lines={self.lines} width={self.width} /> }
  }
}

test "a page too narrow for three columns of spells holds fewer" {
  Test.mount(new NarrowBook(), { left: 20, top: 20, width: 600, height: 400 })
  Test.shot("one column in a page of 600 units")
}

test "the filter keeps the passive spells alone, or the active ones" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.filter, "Active", "Passive")
  Test.expect(window.text("Parry").shown() && !window.text("Rend (Rank 1)").shown())
  pick(window, Ordaen.art.ctl.tool.filter, "Passive", "Active")
  Test.expect(!window.text("Parry").shown() && window.text("Rend (Rank 1)").shown())
}

test "the table view shows a spell's skill line, kind and level in columns, sorted by a heading" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  pick(window, Ordaen.art.ctl.tool.columns, "In columns", "Table")
  Test.expect(window.text("Rend (Rank 1)").item().texts().join(" | ") == "Rend (Rank 1) | Warrior | Active | 4")
  window.button("Level").click()
  Test.expect(inOrder(window, ["Find Treasure", "Rend (Rank 1)", "Parry", "Heroic Strike (Rank 2)", "Mortal Strike"]))
  window.button("Level").click()
  Test.expect(inOrder(window, ["Mortal Strike", "Heroic Strike (Rank 2)", "Parry", "Rend (Rank 1)", "Find Treasure"]))
  Test.shot("the table, by level from the highest")
}

// Dragged from a spell's row a little way: pressed, moved, a frame, let go.
function drag(name: String) {
  const from = Test.holding(name, nil)
  Test.moveTo(from)
  Test.press(nil)
  Test.moveTo({ x: from.x + 20, y: from.y + 10 })
  Test.flush()
  Test.release(nil)
}

test "a spell dragged out of the spellbook is on the cursor, for the action bars to take" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  _ = book()
  Test.expect(!Client.CursorHasSpell())
  drag("Rend (Rank 1)")
  Test.expect(Client.CursorHasSpell())
}

test "a passive spell dragged puts nothing on the cursor" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  _ = book()
  drag("Parry")
  Test.expect(!Client.CursorHasSpell())
}

test "a click on a spell's slot casts the rank clicked, the client's own doing; a passive one's casts nothing" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  _ = Test.performed()
  window.text("Rend (Rank 1)").item().button(ICON).click()
  Test.expect(Test.performed().join(", ") == "spell Rend(Rank 1)")
  window.text("Parry").item().button(ICON).click()
  Test.expect(Test.performed().length == 0)
}

test "Shift+Left-click on a spell's slot links it into the chat, and casts nothing" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  _ = Test.requests()
  _ = Test.performed()
  Test.hold([.Shift])
  Game.input.shiftDown = (): Boolean => true
  window.text("Rend (Rank 1)").item().button(ICON).click()
  Test.hold([])
  Test.expect(Test.requests().any(r => r == "Chat.linkSpell 772"))
  Test.expect(Test.performed().length == 0)
}

test "the cursor on a spell's slot shows the game's tooltip of the spell" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  _ = Test.requests()
  window.text("Mortal Strike").item().button(ICON).hover()
  Test.expect(Test.requests().any(r => r == "Items.showSpell 12294"))
}

test "a spell not learned yet is dimmed, cast by nothing and put on no bar" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = (): Array<Game.SpellEntry> => [
    { id: 100, name: "Charge", rank: "", icon: ICON, level: 4, passive: false, line: 2, learned: false }
  ]
  const window = book()
  Test.expect(drawnIn(window.text("Charge"), DIM))
  _ = Test.performed()
  window.text("Charge").item().button(ICON).click()
  Test.expect(Test.performed().length == 0)
  drag("Charge")
  Test.expect(!Client.CursorHasSpell())
}

test "a spell cooling down is shaded by the client's clock until the client says it is ready" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  let running = true
  Game.spellbook.cooldown = (spell: Game.SpellEntry): Game.SpellRun | nil => running && spell.id == 772 ? { start: 10, length: 6 } : nil
  const window = book()
  const shaded = Color.hex("#0000004d")
  Test.expect(window.text("Rend (Rank 1)").item().paintedWith(shaded) && !window.text("Parry").item().paintedWith(shaded))
  running = false
  Game.spellbook.cooldownsChanged.emit()
  Test.expect(!window.text("Rend (Rank 1)").item().paintedWith(shaded))
}

test "the pet's book is a tab of its own; the right button on a pet's spell turns its autocast, marked while on" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  Game.spellbook.petBook = (): String | nil => "Demon"
  Game.spellbook.petEntries = (): Array<Game.SpellEntry> => [
    { id: 3716, name: "Torment", rank: "", icon: SWORD, level: 10, passive: false, line: 0, pet: true, slot: 1 }
  ]
  let auto = false
  Game.spellbook.autoCast = (spell: Game.SpellEntry): Boolean | nil => spell.pet ? auto : nil
  const window = book()
  Test.expect(!window.text("Torment").shown())
  window.button("Demon").click()
  Test.expect(window.text("Torment").shown() && !window.text("Rend (Rank 1)").shown())
  const gold = Color.hex("#ffd100")
  Test.expect(!window.text("Torment").item().paintedWith(gold))
  _ = Test.requests()
  auto = true
  window.text("Torment").item().button(SWORD).rightClick()
  Test.expect(Test.requests().any(r => r == "Spellbook.toggleAutoCast 3716"))
  Test.expect(window.text("Torment").item().paintedWith(gold))
}

test "opened and closed by its command, the spellbook plays the game's sounds and tells other addons" {
  Test.mount(nil, PAGE)
  const played: Array<Integer> = []
  Client.PlaySound = (kit: Integer, channel: String | nil, once: Boolean | nil): (Boolean | nil, Unknown) => {
    played.push(kit)
    return true, nil
  }
  const heard = new Heard()
  Client.EventRegistry.RegisterCallback("PlayerSpellsFrame.SpellBookFrame.Show", (owner: Unknown): nil => heard.onShow(), heard)
  Client.EventRegistry.RegisterCallback("PlayerSpellsFrame.SpellBookFrame.Hide", (owner: Unknown): nil => heard.onHide(), heard)
  _ = book()
  Test.expect(heard.said.join(", ") == "shown")
  Test.expect(played.length == 1 && played[1] == Client.SOUNDKIT["UI_CLASS_TALENT_OPEN_WINDOW"])
  Test.open("/spellbook")
  Test.expect(heard.said.join(", ") == "shown, hidden")
  Test.expect(played.length == 2 && played[2] == Client.SOUNDKIT["UI_CLASS_TALENT_CLOSE_WINDOW"])
}

test "the spellbook's footer counts the spells shown, the active and the passive ones" {
  Test.mount(nil, PAGE)
  Game.spellbook.lines = lines
  Game.spellbook.entries = spells
  const window = book()
  Test.expect(window.texts().join(" | ").contains("Shown | 5 | Active spells | 4 | Passive spells | 1"))
  window.input().type("strike")
  Test.expect(window.texts().join(" | ").contains("Shown | 2 | Active spells | 2 | Passive spells | 0"))
}

