// What the player can learn of their class, away from a trainer: every spell a class trainer teaches the player's side
// and race (What's Training's list, `training.luna`), and the spells a quest gives in a trainer's place, each as a
// trainer's service for the trainer's page: under a heading by what it waits for (learned now, an earlier rank or a
// talent first, the next levels, later, a quest, a weapon master, a demon's grimoire, the pet trainer, known), its rank, its price at
// the trainer where it costs least (an Honored player pays a tenth less at a faction's trainers, as What's Training
// measured on Forever), and a quest's note and its way to the quest.
import Client from "$client"
import Game from "$game"
import Runtime from "$runtime"
import { PlacePrice } from "OrdaenTrainer"
import Locale from "@/locales"
import Training from "@/training"

// The levels ahead a spell is «coming soon» for.
const SOON = 2
// The standing (the client's reaction) from which a faction's trainers take a tenth off: Honored.
const HONORED = 6
const DISCOUNT = 10
// The role the pet trainers teach, as `Training.roles` names it.
const PET_ROLE = "PET"

// A spell a class trainer teaches: the level and the price it is learned at, its rank (0 for none), the talent a later rank of a talent's own
// needs (0 for none), the side and the race it is for (0 for both, or every race), the spells learned before it.
public struct TrainerSpell {
  id: Integer
  level: Integer
  rank: Integer
  cost: Integer
  talent: Integer
  side: Integer
  race: Integer
  required: Array<Integer>
}

// A way a quest gives a spell to some races: the level of its first quest, the areas it is given in, its quests.
public struct QuestWay {
  races: Array<Integer>
  level: Integer
  areas: Array<Integer>
  quests: Array<Integer>
}

// Who learns: the class by its file name, the race by its ID, the side (1 the Alliance, 2 the Horde), the level, and
// what they and their pet know and how they stand with a faction (the client's reaction; none where they haven't met it).
public struct Learner {
  classTag: String
  race: Integer
  side: Integer
  level: Integer
  known: (spell: Integer) => Boolean
  // What the learner's demon or beast knows: the one out, where one is.
  petKnown: (spell: Integer) => Boolean
  standing: (faction: Integer) => Integer | nil
}

// A spell's way to its quest, for the page's action: the quest the action opens.
public struct Learnable {
  services: Array<Game.TrainerService>
  notes: Map<Integer, String>
  actions: Map<Integer, String>
  // The quest a service's action opens, by its place.
  quests: Map<Integer, Integer>
  // What a service costs at each city whose trainers teach the class, by its place.
  prices: Map<Integer, Array<PlacePrice>>
}

// A city whose trainers teach the learner's class: its faction, how the learner stands with it, and what a price comes
// to there.
public struct CityPrice {
  faction: Integer
  standing: Integer
  price: Integer
}

function numbersOf(text: String, between: String): Array<Integer> {
  const list: Array<Integer> = []
  if (text == "") { return list }
  for (part of text.split(between)) {
    const number = part.toNumber()
    if (number != nil) { list.push(number.floor()) }
  }
  return list
}

function numberAt(parts: Array<String>, at: Integer): Integer { return (parts[at] ?? "").toNumber()?.floor() ?? 0 }

// A class's trainer spells, by level.
public function trainerSpellsOf(classTag: String): Array<TrainerSpell> {
  const list: Array<TrainerSpell> = []
  const text = Training.spells[classTag]
  if (text == nil) { return list }
  for (entry of text.split(";")) {
    const parts = entry.split(",")
    list.push({
      id: numberAt(parts, 1), level: numberAt(parts, 2), rank: numberAt(parts, 3), cost: numberAt(parts, 4),
      talent: numberAt(parts, 5), side: numberAt(parts, 6), race: numberAt(parts, 7), required: numbersOf(parts[8] ?? "", "/")
    })
  }
  return list
}

// A class's quest spells, by spell: the ways each is given.
public function questWaysOf(classTag: String): Map<Integer, Array<QuestWay>> {
  const ways: Map<Integer, Array<QuestWay>> = {}
  const text = Training.quests[classTag]
  if (text == nil) { return ways }
  for (entry of text.split(";")) {
    const spell, rest = entry.match("^(%d+):(.*)$")
    const id = spell?.toNumber()?.floor()
    if (id != nil && rest != nil) {
      const list: Array<QuestWay> = []
      for (way of rest.split("|")) {
        const parts = way.split(",")
        list.push({
          races: numbersOf(parts[1] ?? "", "/"), level: numberAt(parts, 2), areas: numbersOf(parts[3] ?? "", "/"),
          quests: numbersOf(parts[4] ?? "", "/")
        })
      }
      ways[id] = list
    }
  }
  return ways
}

// The share a faction's trainers take off for the learner: a tenth from Honored.
public function discountAt(learner: Learner, faction: Integer): Integer {
  return (learner.standing(faction) ?? 0) >= HONORED ? DISCOUNT : 0
}

// A price with a share taken off, rounded as the trainer rounds it.
public function discounted(cost: Integer, percent: Integer): Integer {
  return ((cost * (100 - percent) + 50) / 100).floor()
}

// The factions whose trainers teach a role (the learner's class, or the pet trainers') on the learner's side.
function factionsOf(learner: Learner, role: String): Array<Integer> {
  const sideName = learner.side == 1 ? "Alliance" : "Horde"
  return Training.roles[`${role}/${sideName}`] ?? []
}

// What the learner pays at the trainers of a role on their side that cost least.
public function bestPrice(learner: Learner, cost: Integer, role: String): Integer {
  let best = cost
  for (faction of factionsOf(learner, role)) { best = best.min(discounted(cost, discountAt(learner, faction))) }
  return best
}

// What a price comes to at each city whose trainers teach a role on the learner's side, cheapest first.
public function cityPricesOf(learner: Learner, cost: Integer, role: String): Array<CityPrice> {
  const list: Array<CityPrice> = []
  for (faction of factionsOf(learner, role)) {
    if (Training.factions[faction]?.city == true) {
      list.push({ faction: faction, standing: learner.standing(faction) ?? 0, price: discounted(cost, discountAt(learner, faction)) })
    }
  }
  list.sort((a, b) => a.price != b.price ? a.price < b.price : a.faction < b.faction)
  return list
}

// A city's line on a spell's card: «Stormwind (Honored): 63s», the client's names.
function cityLineOf(city: CityPrice): PlacePrice {
  const name = Client.C_Reputation.GetFactionDataByID(city.faction)?.name ?? String.of(city.faction)
  const standing = Runtime.text(`FACTION_STANDING_LABEL${city.standing}`) ?? String.of(city.standing)
  const percent = city.standing >= HONORED ? DISCOUNT : 0
  const note = percent > 0 ? Locale.CITY_DISCOUNT.format(standing, percent) : standing
  return { place: name, price: city.price, note: note }
}

// The way a quest gives the learner a spell, by their race; none where no way is theirs.
function wayFor(ways: Array<QuestWay>, race: Integer): QuestWay | nil {
  return ways.find(way => way.races.any(each => each == race))
}

// A weapon master on the learner's side: who, where (an area's ID, x and y on its map from 0 to 100), and what the
// skill costs there.
public struct WeaponMaster {
  npc: Integer
  zone: Integer
  x: Number
  y: Number
  price: Integer
}

// A weapon skill the learner's class may learn: its spell, the level and the full price, and its masters on the
// learner's side, cheapest first.
public struct WeaponWay {
  spell: Integer
  order: Integer
  level: Integer
  cost: Integer
  masters: Array<WeaponMaster>
}

// The weapon skills the learner's class may learn, in What's Training's order.
public function weaponWaysOf(learner: Learner): Array<WeaponWay> {
  const list: Array<WeaponWay> = []
  for (spell, skill of Training.weapons) {
    if (skill.classes.split("/").any(each => each == learner.classTag)) {
      const masters: Array<WeaponMaster> = []
      for (entry of skill.masters.split("|")) {
        const parts = entry.split(",")
        const npc = numberAt(parts, 2)
        if (numberAt(parts, 1) == learner.side) {
          const faction = Training.npcs[npc]
          const percent = faction == nil ? 0 : discountAt(learner, faction)
          masters.push({
            npc: npc, zone: numberAt(parts, 3), x: (parts[4] ?? "").toNumber() ?? 0, y: (parts[5] ?? "").toNumber() ?? 0,
            price: discounted(skill.cost, percent)
          })
        }
      }
      masters.sort((a, b) => a.price != b.price ? a.price < b.price : a.npc < b.npc)
      list.push({ spell: spell, order: skill.order, level: skill.level, cost: skill.cost, masters: masters })
    }
  }
  list.sort((a, b) => a.order < b.order)
  return list
}

// A master's line on a skill's card: «Bixiwobble, Ironforge (61.2, 89.5): 10s», the client's names.
function masterLineOf(master: WeaponMaster, npcName: NpcName): PlacePrice {
  const name = npcName(master.npc) ?? String.of(master.npc)
  const zone = Client.C_Map.GetAreaInfo(master.zone) ?? ""
  return { place: Locale.WEAPON_MASTER.format(name, zone, master.x, master.y), price: master.price, note: "" }
}

// A grimoire the demon trainer sells: the spell it teaches a demon, its rank (by the grimoires of that spell before
// it), the level and the full price, and the demon's family as What's Training names it.
public struct Grimoire {
  spell: Integer
  rank: Integer
  level: Integer
  cost: Integer
  family: String
}

// The demon trainer's grimoires, by level.
public function grimoiresOf(): Array<Grimoire> {
  const list: Array<Grimoire> = []
  const ranks: Map<String, Integer> = {}
  for (entry of Training.tomes.split(";")) {
    const parts = entry.split(",")
    const spell = numberAt(parts, 5)
    const name = Game.spells.name(spell) ?? String.of(spell)
    const rank = (ranks[name] ?? 0) + 1
    ranks[name] = rank
    list.push({ spell: spell, rank: rank, level: numberAt(parts, 2), cost: numberAt(parts, 3), family: parts[4] ?? "" })
  }
  return list
}

// What waits for a spell the learner hasn't, by the heading it stands under, in the headings' order.
enum Wait { Now, Needs, Soon, Later, Quest, Weapon, Grimoire, PetTrainer, Known }

function headingOf(wait: Wait): String {
  return match (wait) {
    .Now => Locale.LEARN_NOW
    .Needs => Locale.LEARN_NEEDS
    .Soon => Locale.LEARN_SOON
    .Later => Locale.LEARN_LATER
    .Quest => Locale.LEARN_QUESTS
    .Weapon => Locale.LEARN_WEAPONS
    .Grimoire => Locale.LEARN_GRIMOIRES
    .PetTrainer => Locale.LEARN_PET_TRAINER
    .Known => Locale.LEARN_KNOWN
  }
}

function orderOf(wait: Wait): Integer {
  return match (wait) {
    .Now => 1
    .Needs => 2
    .Soon => 3
    .Later => 4
    .Quest => 5
    .Weapon => 6
    .Grimoire => 7
    .PetTrainer => 8
    .Known => 9
  }
}

function waitOf(spell: TrainerSpell, learner: Learner): Wait {
  if (learner.known(spell.id)) { return .Known }
  if (spell.level > learner.level) { return spell.level <= learner.level + SOON ? .Soon : .Later }
  const ready = spell.required.all(each => learner.known(each)) && (spell.talent == 0 || learner.known(spell.talent))
  return ready ? .Now : .Needs
}

function statusOf(wait: Wait): Game.ServiceStatus {
  return match (wait) {
    .Now => .Available
    .Known => .Learned
    .Needs, .Soon, .Later, .Quest, .Weapon, .Grimoire, .PetTrainer => .Unavailable
  }
}

// One spell before it is placed: the service but its place, and its quest's.
struct Row {
  spell: Integer
  wait: Wait
  level: Integer
  // Its rank; 0 for none (a quest's spell).
  rank: Integer
  cost: Integer
  // The price before a faction takes its share off: 0 for a quest's spell.
  base: Integer
  // Whose trainers teach it: the class's file name, or the pet trainers'.
  role: String
  quest: Integer | nil
  note: String | nil
  // Its masters' lines, for a weapon skill.
  masters: Array<PlacePrice>
}

// The name a spell's quest says it by: the client's, in the player's language, where it has the quest.
public type QuestName = (quest: Integer) => String | nil

// The name an NPC is known by, where it is known.
public type NpcName = (npc: Integer) => String | nil

// The learner as it knows its ranks: the client's spellbook keeps a spell's highest rank alone, and says the ranks
// below it aren't known; each of them is, once a higher rank of the same spell is.
function withRanksBelow(learner: Learner): Learner {
  // The ranked spells by name: a spell whose name the client hasn't is no rank of another.
  const ranked: Array<TrainerSpell> = []
  const names: Map<Integer, String> = {}
  for (spell of trainerSpellsOf(learner.classTag)) {
    const name = Game.spells.name(spell.id)
    if (spell.rank > 0 && name != nil) {
      ranked.push(spell)
      names[spell.id] = name
    }
  }
  const highest: Map<String, Integer> = {}
  for (spell of ranked) {
    const name = names[spell.id] ?? ""
    if (learner.known(spell.id) && spell.rank > (highest[name] ?? 0)) { highest[name] = spell.rank }
  }
  const below: Map<Integer, Boolean> = {}
  for (spell of ranked) {
    if (spell.rank < (highest[names[spell.id] ?? ""] ?? 0)) { below[spell.id] = true }
  }
  const known = learner.known
  return {
    classTag: learner.classTag, race: learner.race, side: learner.side, level: learner.level,
    known: (spell: Integer): Boolean => below[spell] == true || known(spell), petKnown: learner.petKnown,
    standing: learner.standing
  }
}

// What the learner can learn, as the trainer's page shows it: a service for each spell (its place in this list its
// index), the notes of the quest spells and the action that opens their quest, and the weapon skills with their
// masters.
public function learnableOf(given: Learner, questName: QuestName, npcName: NpcName, openLabel: String | nil): Learnable {
  const learner = withRanksBelow(given)
  const rows: Array<Row> = []
  const quests = questWaysOf(learner.classTag)
  const pets: Map<Integer, Boolean> = {}
  for (spell of Training.petAbilities) { pets[spell] = true }
  for (spell of trainerSpellsOf(learner.classTag)) {
    const forSide = spell.side == 0 || spell.side == learner.side
    const forRace = spell.race == 0 || spell.race == learner.race
    if (forSide && forRace && quests[spell.id] == nil) {
      const pet = pets[spell.id] == true
      const role = pet ? PET_ROLE : learner.classTag
      const wait = pet ? (learner.known(spell.id) || learner.petKnown(spell.id) ? Wait.Known : Wait.PetTrainer) : waitOf(spell, learner)
      rows.push({ spell: spell.id, wait: wait, level: spell.level, rank: spell.rank, cost: bestPrice(learner, spell.cost, role), base: spell.cost, role: role, quest: nil, note: nil, masters: [] })
    }
  }
  for (spell, ways of quests) {
    const way = wayFor(ways, learner.race)
    if (way != nil) {
      const known = learner.known(spell)
      const quest = way.quests[1]
      const name = quest == nil ? nil : questName(quest)
      const note = name == nil ? Locale.LEARN_QUEST_LEVEL.format(way.level) : Locale.LEARN_QUEST.format(name, way.level)
      rows.push({ spell: spell, wait: known ? Wait.Known : Wait.Quest, level: way.level, rank: 0, cost: 0, base: 0, role: learner.classTag, quest: quest, note: known ? nil : note, masters: [] })
    }
  }
  for (way of weaponWaysOf(learner)) {
    const known = learner.known(way.spell)
    const cost = way.masters[1]?.price ?? way.cost
    const note = known || way.level <= learner.level ? nil : Locale.LEARN_WEAPON_LEVEL.format(way.level)
    const lines = known ? [] : way.masters.map(master => masterLineOf(master, npcName))
    rows.push({ spell: way.spell, wait: known ? Wait.Known : Wait.Weapon, level: way.level, rank: 0, cost: cost, base: 0, role: learner.classTag, quest: nil, note: note, masters: lines })
  }
  if (learner.classTag == "WARLOCK") {
    for (grimoire of grimoiresOf()) {
      const known = learner.petKnown(grimoire.spell)
      const note = known ? nil : Locale.LEARN_GRIMOIRE.format(grimoire.family)
      rows.push({ spell: grimoire.spell, wait: known ? Wait.Known : Wait.Grimoire, level: grimoire.level, rank: grimoire.rank, cost: bestPrice(learner, grimoire.cost, learner.classTag), base: grimoire.cost, role: learner.classTag, quest: nil, note: note, masters: [] })
    }
  }
  rows.sort((a, b) => {
    if (a.wait != b.wait) { return orderOf(a.wait) < orderOf(b.wait) }
    if (a.level != b.level) { return a.level < b.level }
    return a.spell < b.spell
  })
  const services: Array<Game.TrainerService> = []
  const notes: Map<Integer, String> = {}
  const actions: Map<Integer, String> = {}
  const questOf: Map<Integer, Integer> = {}
  const prices: Map<Integer, Array<PlacePrice>> = {}
  for (at, row of rows) {
    services.push({
      index: at, name: Game.spells.name(row.spell) ?? "", rank: row.rank == 0 ? "" : Locale.SPELL_RANK.format(row.rank),
      icon: Game.spells.texture(row.spell), status: statusOf(row.wait), level: row.level, cost: row.cost,
      description: Game.spells.description(row.spell) ?? "", skill: nil, category: headingOf(row.wait), spell: row.spell
    })
    if (row.base > 0) { prices[at] = cityPricesOf(learner, row.base, row.role).map(cityLineOf) }
    if (row.masters.length > 0) { prices[at] = row.masters }
    const note = row.note
    if (note != nil) { notes[at] = note }
    const quest = row.quest
    if (quest != nil && openLabel != nil && row.wait == Wait.Quest) {
      actions[at] = openLabel
      questOf[at] = quest
    }
  }
  return { services: services, notes: notes, actions: actions, quests: questOf, prices: prices }
}
