// The spells the player has, as the spellbook shows them: read from the client's spellbook by skill line.
import Client from "$client"
import { Art } from "$ltml"

// What a spell is: its place in the spellbook's skill lines, its rank and the level it was learned at.
public struct Spell {
  id: Integer
  name: String
  rank: String
  icon: Art
  level: Integer
  passive: Boolean
  // The skill line it stands on: 1 is the general one, then the class's and the specializations'.
  line: Integer
}

// A skill line of the spellbook: a tab of the spells' page.
public struct Line {
  index: Integer
  name: String
}

public function readLines(): Array<Line> {
  const list: Array<Line> = []
  for (index of 1..=Client.C_SpellBook.GetNumSpellBookSkillLines().floor()) {
    const info = Client.C_SpellBook.GetSpellBookSkillLineInfo(index)
    if (info != nil && !info.shouldHide) { list.push({ index: index, name: info.name }) }
  }
  return list
}

// Every spell and passive of every skill line the spellbook shows.
public function readSpells(): Array<Spell> {
  const list: Array<Spell> = []
  const bank = Client.SpellBookSpellBank.Player
  for (index of 1..=Client.C_SpellBook.GetNumSpellBookSkillLines().floor()) {
    const info = Client.C_SpellBook.GetSpellBookSkillLineInfo(index)
    if (info != nil && !info.shouldHide) {
      for (offset of 1..=info.numSpellBookItems.floor()) {
        const slot = info.itemIndexOffset.floor() + offset
        const item = Client.C_SpellBook.GetSpellBookItemInfo(slot, bank)
        if (item != nil && item.itemType == Client.SpellBookItemType.Spell && item.spellID != nil) {
          list.push({
            id: item.spellID.floor(), name: item.name, rank: item.subName, icon: item.iconID,
            level: Client.C_SpellBook.GetSpellBookItemLevelLearned(slot, bank).floor(), passive: item.isPassive,
            line: index,
          })
        }
      }
    }
  }
  return list
}
