// Ordaen Spells: the spellbook window, and the class trainer's window (the talents are Ordaen Character's, a tab for
// each spec in the character window). The spellbook window opens with `/spellbook`, and with the game's own button
// for it (the micro menu's): the game's window opens all the same, unseen and off the screen, and this one stands in
// its place while it shows. The trainer's shows while the client's class trainer is open, never for a profession's or
// a pet's. What each shows is read from `"$game"` as the window opens and when it says it changed.
import Client from "$client"
import Game from "$game"
import { Frame } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { KeptWindow, Module, ModuleMemory, Settings, SettingsPage, Window, WindowSide, WindowTabSpec, WindowsPage, playSound, windowsTitle } from "Ordaen"
import root Quests from "OrdaenQuests"
import { EDGE_TO_EDGE, PlacePrice, TrainerIgnored, TrainerList, TrainerPage, TrainerView, TrainerWindow } from "OrdaenTrainer"
import { Learnable, Learner, learnableOf } from "@/learnable"
import Locale from "@/locales"
import { Choices, TrainerSettingsPage } from "@/settings"
import { SpellbookPage } from "@/spellbook"
import Style from "@/style"

// What the game's spellbook tells other addons as it shows and hides (`EventRegistry`).
const SHOWN_EVENT = "PlayerSpellsFrame.SpellBookFrame.Show"
const HIDDEN_EVENT = "PlayerSpellsFrame.SpellBookFrame.Hide"
// The game's spellbook's own book: the icon of its General skill line, which the game's spells window shows as its
// portrait on the spellbook's page.
const BOOK: Asset = "Interface/Icons/INV_Misc_Book_09"
// The trainer's tab: the class trainer's book.
const TRAINER_TAB: WindowTabSpec = { title: Locale::TAB_TRAINER, desc: nil, icon: BOOK }
// The «Learnable» tab: a trainer's book.
const LEARNABLE_ICON: Asset = "Interface/Icons/INV_Misc_Book_11"
const LEARNABLE_TAB: WindowTabSpec = { title: Locale::TAB_LEARNABLE, desc: nil, icon: LEARNABLE_ICON, padding: EDGE_TO_EDGE }
// The window's tabs, by their place.
const SPELLS = 1
const LEARNABLE = 2

// The player as a learner of their class: their race and side, their level, what they know and how they stand with a
// faction, the client's.
function learnerOf(level: integer): Learner {
  const _, _, race = Client::UnitRace("player")
  return {
    classTag: Game::player.classTag, race: race?.floor() ?? 0, side: Game::player.faction == Game::Faction::Horde ? 2 : 1, level: level,
    known: (spell: integer): boolean => Game::spells.known(spell),
    petKnown: (spell: integer): boolean => Client::C_SpellBook::IsSpellKnown(spell, Client::SpellBookSpellBank::Pet),
    standing: (faction: integer): integer | nil => Client::C_Reputation::GetFactionDataByID(faction)?.reaction
  }
}

// A quest's name in the player's language, the client's where it has the quest, else Questie's.
function questNameOf(quest: integer): string | nil {
  return Client::C_QuestLog::GetTitleForQuestID(quest) ?? Quests?.questFacts(quest)?.name
}

// An NPC's name, Questie's.
function npcNameOf(npc: integer): string | nil { return Quests?.npc(npc)?.name }

public class Spells implements Module, App {
  public const title: string = "Ordaen Spells"
  // Its windows, declared: where each stands and what the player does with it, kept in the profile.
  public window: mut KeptWindow = new KeptWindow("book", self.title, { x: 0ui, y: 0ui, width: Style::WIDTH, height: Style::HEIGHT })
  public trainerWindow: mut KeptWindow = new KeptWindow("trainer", Locale::TAB_TRAINER, { x: 0ui, y: 0ui, width: Style::TRAINER_WIDTH, height: Style::HEIGHT })
  public const windows: mut array<mut KeptWindow> = [self.window, self.trainerWindow]
  public const pages: array<SettingsPage> = [
    { title: Locale::TAB_TRAINER, content: $ltml { <TrainerSettingsPage settings={mut self.settings} /> } },
    { title: windowsTitle(), content: $ltml { <WindowsPage windows={mut self.windows} /> } }
  ]

  public settings: mut Settings<Choices> = new Settings<Choices>({
    trainer: true, trainerView: TrainerView::List, trainerSort: 0
  })

  state open = false
  state tab = 1
  state spells: array<Game::SpellEntry> = []
  state lines: array<Game::SpellLine> = []
  state pets: array<Game::SpellEntry> = []
  state petBook: string | nil = nil
  // The game's own window's spellbook page shows (the micro menu's button opened it), and the window shows at all (a
  // page of another's, the talents, may show alone).
  state gameShown = false
  state windowShown = false
  // The game's window stands away whenever it exists, so the game's window manager never counts it among the windows
  // it shows (it holds three): it is away already as the game shows it. While the game shows another page alone, it is
  // let be (that page's own addon holds it where it draws that page).
  derived holdsGame: boolean = Game::frames.PlayerSpells != nil && (!self.windowShown || self.gameShown)
  state services: array<Game::TrainerService> = []
  const tabs: array<WindowTabSpec> = [{ title: Locale::TAB_SPELLS, icon: BOOK }, { title: Locale::TAB_LEARNABLE, icon: LEARNABLE_ICON }]
  // What the player can learn, worked out again as their spells and level change while its tab shows.
  derived learnable: Learnable = self.learnableOf()
  derived learnServices: array<Game::TrainerService> = self.learnable.services
  derived learnNotes: map<integer, string> = self.learnable.notes
  derived learnActions: map<integer, string> = self.learnable.actions
  derived learnPrices: map<integer, array<PlacePrice>> = self.learnable.prices
  derived side: WindowSide | nil = self.tab == LEARNABLE ? self.learnPage.side : nil
  // The page's cells, as the «Learnable» page reads them: its tab and its words while nothing is picked.
  derived learnTab: WindowTabSpec = LEARNABLE_TAB
  // The «Learnable» tab's page: the trainer's, away from a trainer.
  learnPage: TrainerPage
  // How the player left the «Learnable» list, the profile's.
  public learnList: mut ModuleMemory<TrainerList> = new ModuleMemory<TrainerList>({ view: TrainerView::List }, .Profile, "learnable")
  // The spellbook's page: its body in the window, its counts in the window's footer.
  page: SpellbookPage
  // The constructor has run: what changes after it is the player's doing, and sounds.
  started = false
  // How the player left the class trainer's list, the profile's: its filter is kept, its view and sort are the
  // settings' each time it opens.
  public trainerList: mut ModuleMemory<TrainerList> = new ModuleMemory<TrainerList>({ view: TrainerView::List }, .Profile, "trainer")
  // The spells the player ignored, the character's.
  public ignored: mut ModuleMemory<TrainerIgnored> = new ModuleMemory<TrainerIgnored>({}, .Character, "ignored")
  // The trainer that is open teaches a class's skills: asked as it opens.
  state classTrainer = false
  derived trainerShown: boolean = self.classTrainer && self.settings.values.trainer
  // The game's own trainer window (`Game.frames.Trainer`, there from its load) stands away, unseen, while ours shows,
  // and while no trainer is open, so the game's window manager never counts it; a trainer of another kind open (a
  // profession's, Ordaen Professions'), it is let be.
  derived holdsTrainer: boolean = self.settings.values.trainer && Game::frames.Trainer != nil && (!Game::trainer.open || self.classTrainer)

  // A trainer opened or closed: one of a class opens in the view and sort the settings give.
  mut onTrainerOpen(opened: boolean) {
    self.classTrainer = opened && Game::trainer.teachesClass()
    if (!self.classTrainer) { return }
    const settings = peek self.settings.values
    self.trainerList.write({
      shows: (peek self.trainerList.values).shows, view: settings.trainerView, sorted: settings.trainerSort, descending: false
    })
  }

  constructor() {
    self.page = new SpellbookPage(self.spells, self.lines, self.pets, self.petBook)
    self.learnPage = new TrainerPage(
      self.learnServices, self.learnList, self.ignored, self.learnTab, Locale::COL_SKILL, false, false,
      self.learnNotes, self.learnActions, self.learnPrices
    )
    self.learnPage.acted.listen(self.onActed)
    Ordaen.modules.add(self)
    Game::trainer.changed.listen(self.onTrainer)
    Game::spellbook.changed.listen(self.onSpells)
    watch (opened of Game::trainer.open) { self.onTrainerOpen(opened) }
    // The game's words about spells are heard while the spellbook shows.
    watch (opened of self.open) {
      Game::spellbook.watch(opened)
      self.onOpened(opened)
    }
    watch (frame of Game::frames.PlayerSpells) { self.hook(frame) }
    Runtime::command("/spellbook", (text: string): nil => {
      for (module of Ordaen.modules) {
        if (module == self) { self.toggle() }
      }
      return nil
    })
    self.started = true
  }

  // Opened or closed by `/spellbook`, with the game's window not shown: what the game's window does as it shows and
  // hides is done in its stead, its sound and its word to other addons (the game's own window, shown away, does both
  // itself).
  onOpened(opened: boolean) {
    if (!self.started || peek self.gameShown) { return }
    playSound(opened ? "UI_CLASS_TALENT_OPEN_WINDOW" : "UI_CLASS_TALENT_CLOSE_WINDOW")
    Client::EventRegistry.TriggerEvent(opened ? SHOWN_EVENT : HIDDEN_EVENT)
  }

  public mut toggle() {
    self.open = !self.open
    if (self.open) { self.refresh() }
  }

  public mut refresh() { self.readSpells() }

  // A spell learned or unlearned, a pet come or gone, while the window shows.
  mut onSpells() {
    if (peek self.open) { self.readSpells() }
  }

  mut readSpells() {
    self.spells = Game::spellbook.entries()
    self.lines = Game::spellbook.lines()
    self.pets = Game::spellbook.petEntries()
    self.petBook = Game::spellbook.petBook()
  }

  // The game's spells window's spellbook page: ours opens and closes with it. Its talents and specializations pages are
  // Ordaen Character's, one page showing at a time. Hooked as the game names it, on its show and hide, which are rare.
  mut hook(frame: any Frame | nil) {
    const window = Client::PlayerSpellsFrame
    if (frame == nil || window == nil) { return }
    const page: any Client::Frame = window.SpellBookFrame
    _ = window.HookScript("OnShow", (): nil => {
      self.windowShown = true
      return nil
    })
    _ = window.HookScript("OnHide", (): nil => {
      self.windowShown = false
      return nil
    })
    self.windowShown = window.IsVisible()
    _ = page.HookScript("OnShow", (): nil => {
      self.onGameShown()
      return nil
    })
    _ = page.HookScript("OnHide", (): nil => {
      self.onGameHidden()
      return nil
    })
    if (page.IsVisible()) { self.onGameShown() }
  }

  mut onGameShown() {
    self.gameShown = true
    self.open = true
    self.refresh()
  }

  mut onGameHidden() {
    self.gameShown = false
    self.open = false
  }

  // The class trainer's services, as it opens and as they change.
  mut onTrainer() {
    if (!Game::trainer.teachesClass()) { return }
    self.services = Game::trainer.services()
  }

  learnableOf(): Learnable {
    if (self.tab != LEARNABLE || !self.open) { return { services: [], notes: {}, actions: {}, quests: {}, prices: {} } }
    _ = self.spells.length
    const openLabel = Quests == nil ? nil : Locale::LEARN_OPEN_QUEST
    return learnableOf(learnerOf(Game::player.level), questNameOf, npcNameOf, openLabel)
  }

  // A quest spell's action: its quest, opened on its chain page (with its way on the map).
  onActed(index: integer) {
    const quest = (peek self.learnable).quests[index]
    if (quest != nil) { _ = Quests?.openAt(quest) }
  }

  mut onClose() { self.open = false }

  // The window's footer: the open tab's.
  const footer: Template = $ltml {
    <$if={self.tab == SPELLS}> {self.page.footer} </>
    <$else> {self.learnPage.footer} </>
  }
  onSettings() { Ordaen.toggleSettings(Runtime::Addon::of(self)) }

  public render(): Template {
    return $ltml {
      <frame $if={self.holdsGame} of={Game::frames.PlayerSpells} opacity={0} away={true} />
      <Window $if={self.open} tabs={self.tabs} selected={mut self.tab} declared={mut self.window} withSettings={true}
              side={self.side} footer={self.footer} @close={self.onClose} @settings={self.onSettings}>
        <$if={self.tab == SPELLS}> {self.page.body} </>
        <$else> {self.learnPage.body} </>
      </Window>
      <frame $if={self.holdsTrainer} of={Game::frames.Trainer} opacity={0} away={true} />
      <TrainerWindow $if={self.trainerShown} services={self.services} declared={mut self.trainerWindow} list={mut self.trainerList} ignored={mut self.ignored}
                     tabSpec={TRAINER_TAB} noun={Locale::COL_SKILL} trade={false} @settings={self.onSettings} />
    }
  }
}
