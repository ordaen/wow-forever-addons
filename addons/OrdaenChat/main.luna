// Ordaen Chat: the game's chat in Ordaen's frame. It reads every line the game's windows would show, after every
// addon's filters (`Game.chat.heard`), and draws them itself; the game's windows stand hidden meanwhile. Its tabs are
// the game's windows docked with the first (whisper windows among them, the combat log's frame held as it is), each
// showing the channels and communities its settings tick; each window the player undocked is a pane of its own, and
// the whispers have a window of their own. The input is the game's own, dressed as
// ours and placed under the lines: sending, slash commands, Shift-click links and other addons' hooks stay the
// game's. A tab's right-click menu and the «Tabs» page are ours, over the game's own window settings.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Anchored, Event, Point } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { CopyBox, Dialog, Field, KeptWindow, Module, Placed, PushButton, Settings, SettingsPage, timeText } from "Ordaen"
import { ChannelName, ChatSize, Choices, LEAST_HEIGHT, LEAST_WIDTH, TabChoices, tabDefaults, tabKey } from "@/choices"
import { ChatTab, Kept, KeptTab, Shown, channelOf, linked, marks, talkKey, talkLine, wordsOf } from "@/lines"
import Locale from "@/locales"
import { NamePick, Pane, TabPick, nameOf } from "@/pane"
import { ChatPage } from "@/settings"
import { TabsPage } from "@/tabsPage"
import { WHISPERS_LEAST, Whispers } from "@/whispers"

// Where the chat stands until the player moves it: the screen's bottom left corner, above the panel's room.
const HOME: Anchored = { point: Point.BottomLeft, x: 8dp, y: -76dp }
// Where an undocked window's pane stands until the player moves it: over the chat.
const UNDOCKED: Anchored = { point: Point.BottomLeft, x: 8dp, y: -300dp }
const PREFIX = "ordaenurl:"
// Where the last lines of each tab are kept between sessions.
const HISTORY = "OrdaenChat:history"
// Whether the character's guild tab was made, once.
const GUILD_TAB = "OrdaenChat:guildTab"
// What the guild's tab shows: the guild's lines and its officers'.
const GUILD_GROUPS: Array<String> = ["GUILD", "OFFICER"]
// The time stamp before a line: in brackets, the muted colour.
const STAMP = "|cff9d9d9d[%s]|r "
const BUTTON = 90dp
// The chat's tab of the whispers, which opens the whisper window.
const WHISPERS = "talks"
// The whispers' kinds (the client's `ChatTypeInfo` keys): a character's, a Battle.net friend's, what the player
// whispered, and the away and busy answers; the conversation is the sender's (the one told, for what was told).
const TOLD: Array<String> = ["WHISPER_INFORM", "BN_WHISPER_INFORM"]
const HEARD: Array<String> = ["WHISPER", "BN_WHISPER", "AFK", "DND"]
const BATTLE_NET: Array<String> = ["BN_WHISPER", "BN_WHISPER_INFORM"]

public class Chat implements Module, App {
  public const title: String = "Ordaen Chat"
  settings: mut Settings<Choices> = new Settings<Choices>({
    width: 430, height: 190, hide: false, hiddenOpacity: 0, tabs: {}, keywords: "", repeats: true, kept: 200, held: 500,
    history: Game.ChatHistory.All, inputAlways: false
  })
  // The window the «Tabs» page shows.
  state editing = 1
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_CHAT, content: $ltml { <ChatPage settings={mut self.settings} /> } },
    { title: Locale.TAB_TABS, content: $ltml { <TabsPage window={mut self.editing} settings={mut self.settings} /> } }
  ]

  // Every tab made, by its key, kept while its key is; the chat's own pane's in their order (the docked windows, then
  // the whispers'), and the undocked windows', each a pane.
  made: mut Map<String, mut ChatTab> = {}
  public state tabs: Array<ChatTab> = []
  public state undocked: Array<ChatTab> = []
  public state openKey = "w1"
  // A web address clicked: shown to copy.
  public state copied = ""
  // The tab being renamed, and its name meanwhile.
  state renaming: ChatTab | nil = nil
  state newName = ""
  // The whisper conversations, the one last spoken in first; the chat's tab of them, its count their unread lines;
  // the whisper window, open or not, and its conversation open.
  public state talks: Array<ChatTab> = []
  whispersTab: mut ChatTab = new ChatTab(WHISPERS, Locale.WHISPERS)
  public state talking = false
  public state talkOpen = ""
  whisperWindow: mut KeptWindow = new KeptWindow("whispers", Locale.WHISPERS, { x: 0ui, y: 0ui, width: WHISPERS_LEAST, height: 330dp })

  // The size while the grip is dragged (in dp), kept as it is let go; where the drag began.
  state sizing: ChatSize | nil = nil
  sizedFrom: ChatSize = { width: 0, height: 0 }
  // Never under the least: a size kept from before stands at it.
  derived width: Number<Length> = (self.sizing?.width ?? self.settings.values.width).max(LEAST_WIDTH) * 1dp
  derived height: Number<Length> = (self.sizing?.height ?? self.settings.values.height).max(LEAST_HEIGHT) * 1dp
  // How much of the chat shows while the cursor is off it.
  derived awayOpacity: Number = self.settings.values.hide ? self.settings.values.hiddenOpacity : 1
  derived inputAlways: Boolean = self.settings.values.inputAlways
  derived words: Array<String> = wordsOf(self.settings.values.keywords, Game.player.name)
  derived open: ChatTab | nil = self.tabs.find(tab => tab.key == self.openKey) ?? self.tabs[1]

  constructor() {
    Ordaen.modules.add(self)
    Game.chat.read(true)
    Game.chat.heard.listen(self.onLine)
    Game.chat.playerReported.listen(self.onReported)
    Events.PLAYER_LOGOUT.listen(self.keep)
    // The game's windows are loaded: the guild's tab made where it is due.
    Events.UPDATE_CHAT_WINDOWS.listen(self.guildTab)
    watch (windows of Game.chat.windows) { self.sync() }
    // Whispers are the whisper window's: the game opens no window of its own for them.
    Game.chat.whisperWindows(false)
    watch { Game.chat.inputHistory(self.settings.values.history) }
    watch { Game.chat.inputShown(self.settings.values.inputAlways) }
    watch { self.chooseTabs(self.settings.values.tabs) }
    // The input opened (Enter) while a whisper window's tab is open: it speaks there.
    watch (typing of Game.chat.typing) {
      if (typing) { self.speakHere() }
    }
    self.recall()
  }

  destructor() {
    self.keep()
    Game.chat.read(false)
  }

  // The tabs made anew from the game's windows; a tab whose key stays keeps its lines.
  sync(mut self) {
    const tabs: Array<ChatTab> = []
    const undocked: Array<ChatTab> = []
    for (window of peek Game.chat.windows) {
      const tab = self.tabOf(`w${window.index}`, window.name)
      tab.follow(window)
      if (window.docked || window.index == 1) {
        tabs.push(tab)
      } else {
        undocked.push(tab)
      }
    }
    tabs.push(self.whispersTab)
    self.tabs = tabs
    self.undocked = undocked
    self.chooseTabs((peek self.settings.values).tabs)
  }

  // Each window's tab takes its own settings: the player's, else its window's defaults.
  chooseTabs(mut self, chosen: Map<String, TabChoices>) {
    for (window of peek Game.chat.windows) {
      const tab = self.made[tabKey(window.index)]
      if (tab != nil) { tab.choose(chosen[tab.key] ?? tabDefaults(window)) }
    }
  }

  tabOf(mut self, key: String, title: String): mut ChatTab {
    const known = self.made[key]
    if (known != nil) { return known }
    const tab = new ChatTab(key, title)
    self.made[key] = tab
    return tab
  }

  // A line heard: made once as drawn, and added to each tab that shows it.
  onLine(mut self, line: Game.ChatLine) {
    const values = peek self.settings.values
    const told = TOLD.any(kind => kind == line.kind)
    if (line.sender != "" && (told || HEARD.any(kind => kind == line.kind))) {
      self.onWhisper(talkKey(line.sender, BATTLE_NET.any(kind => kind == line.kind)), talkLine(line, told), !told, values)
      return
    }
    // A channel's line names its channel as each tab chose: made for each; any other, once for all.
    const plain = line.channel > 0 ? nil : self.shownLine(line, .Name)
    const open = peek self.openKey
    for (index of line.windows) { self.addTo(tabKey(index), line, plain, open, values) }
  }

  // A player reported: their lines go from every tab and conversation, as the game's windows take them away.
  onReported(mut self, guid: String) {
    if (guid == "") { return }
    for (_, tab of self.made) { tab.forgetSender(guid) }
  }

  addTo(mut self, key: String, line: Game.ChatLine, plain: Shown | nil, open: String, values: Choices) {
    // A window opened in the same call as its first line (a whisper's): its tab is made now, not after the frame.
    if (self.made[key] == nil) { self.sync() }
    const tab = self.made[key]
    if (tab == nil) { return }
    tab.add(plain ?? self.shownLine(line, peek tab.channelName), values.repeats, values.held)
    // An undocked window's pane shows each line as it comes: nothing waits unread there.
    if (key != open && peek tab.docked && peek tab.counted) { tab.unread = (peek tab.unread) + 1 }
  }

  // A whisper: its conversation's, which goes first in the list; heard while that conversation isn't the one open in
  // the shown window, it waits unread there and on the chat's tab of the whispers.
  onWhisper(mut self, key: String, line: Shown, heard: Boolean, values: Choices) {
    const talk = self.talkOf(key)
    talk.add(line, values.repeats, values.held)
    if (heard && !(peek self.talking && peek self.talkOpen == key)) { talk.unread = (peek talk.unread) + 1 }
    self.countUnread()
  }

  // A conversation, made where there is none, put first in the list.
  talkOf(mut self, key: String): mut ChatTab {
    const talk = self.tabOf(key, "")
    const talks: Array<ChatTab> = [talk]
    for (other of peek self.talks) {
      if (other.key != key) { talks.push(other) }
    }
    self.talks = talks
    return talk
  }

  countUnread(mut self) {
    let unread = 0
    for (talk of peek self.talks) { unread += peek talk.unread }
    self.whispersTab.unread = unread
  }

  // The whisper window opened on a conversation (the one last open, or the first), whose lines are read then.
  openTalk(mut self, key: String) {
    self.talking = true
    self.talkOpen = key != "" ? key : ((peek self.talks)[1]?.key ?? "")
    const talk = self.made[peek self.talkOpen]
    if (talk != nil) { talk.unread = 0 }
    self.countUnread()
  }

  onTalk(mut self, talk: ChatTab) { self.openTalk(talk.key) }

  onTalkClose(mut self) { self.talking = false }

  onTalkStart(mut self, name: String) { self.openTalk(self.talkOf(talkKey(name, false)).key) }

  // A conversation closed: its lines go with it.
  onTalkForget(mut self, talk: ChatTab) {
    self.made[talk.key] = nil
    self.talks = (peek self.talks).filter(other => other.key != talk.key)
    if (peek self.talkOpen == talk.key) { self.talkOpen = (peek self.talks)[1]?.key ?? "" }
    self.countUnread()
  }

  // The words typed in a conversation, sent in the key's own call.
  onTalkSend(mut self, text: String) {
    const talk = self.made[peek self.talkOpen]
    if (talk != nil) { _ = Game.chat.whisper(talk.partner, text, talk.battleNet) }
  }

  shownLine(self, line: Game.ChatLine, channelName: ChannelName): Shown {
    if (line.secret != "") {
      return {
        whole: line.body, color: line.color, time: line.time, repeat: "", count: 1, marked: false, past: false, secret: true,
        mine: false, sender: line.guid
      }
    }
    // The time where the game shows the chat's times, written as every time of Ordaen's is.
    const stamp = line.stamp != "" ? STAMP.format(timeText(Game.clock.timeAt(line.time.floor()))) : ""
    const channel = line.channel > 0 ? channelOf(line, channelName) : ""
    const own = line.sender == Game.player.name || line.sender.match("^([^%-]+)") == Game.player.name
    return {
      whole: `${stamp}${channel}${linked(line.plain)}`, color: line.color, time: line.time,
      repeat: `${line.kind}|${line.channel}|${line.sender}|${line.text}`, count: 1,
      marked: line.sender != "" && !own && marks(line.text, peek self.words), past: false, secret: false, mine: false,
      sender: line.guid
    }
  }

  onPick(mut self, tab: ChatTab) {
    if (tab.key == WHISPERS) {
      self.openTalk(peek self.talkOpen)
      return
    }
    self.openKey = tab.key
    const made = self.made[tab.key]
    if (made != nil) { made.unread = 0 }
    if (tab.window > 0) { Game.chat.choose(tab.window) }
    if (peek Game.chat.typing) { self.speakTo(tab) }
  }

  // The input, opened, speaks where the open tab speaks: a whisper window's partner; elsewhere, in the input's own kind.
  speakHere(mut self) {
    const tab = peek self.open
    if (tab != nil) { self.speakTo(tab) }
  }

  speakTo(mut self, tab: ChatTab) {
    if (tab.window > 0 && tab.partner != "") { Game.chat.speak(tab.window) }
  }

  // A link clicked: a web address opens the copy box; any other is the game's.
  onLink(mut self, link: Event.Link) {
    if (link.link.sub(1, PREFIX.length) == PREFIX) {
      self.copied = link.link.sub(PREFIX.length + 1)
      return
    }
    Game.chat.click(link.link, link.text, link.button)
  }

  onCopyClose(mut self) { self.copied = "" }

  // A tab's menu: rename (a box asks the name), its page of the settings, a new tab, lock, the mouse through its lines
  // or not, undock or dock, close.
  onTab(mut self, pick: TabPick) {
    const window = pick.tab.window
    match (pick.action) {
      .Rename => {
        self.newName = pick.tab.title
        self.renaming = pick.tab
      }
      .Settings => {
        self.editing = window
        Ordaen.toggleSettings(Runtime.Addon.of(self))
      }
      .New => { _ = Game.chat.open(Locale.TAB_NEW_NAME) }
      .Lock => { Game.chat.lock(window, !pick.tab.locked) }
      .Interactable => { Game.chat.interactable(window, pick.tab.uninteractable) }
      .Undock => { Game.chat.undock(window) }
      .Dock => { Game.chat.dock(window) }
      .Close => { Game.chat.close(window) }
    }
  }

  onRename(mut self) {
    const tab = peek self.renaming
    const name = peek self.newName
    if (tab != nil && name != "") { Game.chat.rename(tab.window, name) }
    self.renaming = nil
  }

  onRenameCancel(mut self) { self.renaming = nil }

  // A player's name: whisper them, invite them, ask who they are, ignore them, or the game's own menu of them (its
  // entries the client keeps to itself are reached there).
  onName(mut self, pick: NamePick) {
    const name = nameOf(pick.link.link)
    if (name == nil) { return }
    match (pick.action) {
      .Whisper => { self.onTalkStart(name) }
      .Invite => { Client.C_PartyInfo.InviteUnit(name) }
      .Who => { Client.C_FriendList.SendWho(`n-"${name}"`, nil, nil) }
      .Ignore => { _ = Client.C_FriendList.AddIgnore(name) }
      .More => { Game.chat.click(pick.link.link, pick.link.text, .Right) }
    }
  }

  // A character's first chat has a tab of the guild's lines (the guild's and its officers'), docked after the game's
  // own two, once its windows are loaded: made once a character, and not where a window past those two shows the
  // guild already. Closed, it stays closed.
  guildTab(mut self) {
    if (Game.saved.stored(Game.Scope.Character, GUILD_TAB) != nil) { return }
    Game.saved.store(Game.Scope.Character, GUILD_TAB, true)
    const shown = (peek Game.chat.windows).any(window => window.index > 2 && Game.chat.groups(window.index).any(group => group.name == GUILD_GROUPS[1] && group.shown))
    if (shown) { return }
    const made = Game.chat.open(Locale.TAB_GUILD_NAME)
    if (made == nil) { return }
    for (group of Game.chat.groups(made)) {
      if (group.shown) { Game.chat.showGroup(made, group.name, false) }
    }
    for (group of GUILD_GROUPS) { Game.chat.showGroup(made, group, true) }
  }

  // The last lines of each tab, for the next session: written once, as the player logs out.
  keep(mut self) {
    const count = (peek self.settings.values).kept
    const tabs: Array<KeptTab> = []
    if (count > 0) {
      for (_, tab of self.made) { tabs.push({ key: tab.key, lines: tab.keptLines(count) }) }
    }
    Game.saved.store(Game.Scope.Character, HISTORY, Kept { tabs: tabs })
  }

  recall(mut self) {
    const kept = Kept.decode(Game.saved.stored(Game.Scope.Character, HISTORY), Kept { tabs: [] })
    const talks: Array<ChatTab> = []
    for (tab of kept.tabs) {
      const made = self.tabOf(tab.key, "")
      made.recall(tab.lines)
      if (made.talk) { talks.push(made) }
    }
    self.talks = talks
  }

  // The grip in the chat's top right corner taken: the chat stands by its bottom left, so it grows to the right and
  // up, up to the screen's edges and down to the least the settings allow. The chat is drawn never narrower than its
  // tabs and its lines need, whatever width is chosen.
  // The drag starts from the width drawn (the room's least as it is taken), which may be more than the width chosen.
  onSizeGrab(mut self, drag: Event.Drag) {
    self.sizedFrom = { width: drag.room.leastWidth / 1dp, height: (peek self.height) / 1dp }
  }

  onSize(mut self, drag: Event.Drag) {
    const right = drag.dx.min(drag.room.right) / 1dp
    const up = -(drag.dy.max(-drag.room.up) / 1dp)
    self.sizing = ChatSize {
      width: (self.sizedFrom.width + right).max(LEAST_WIDTH).round(),
      height: (self.sizedFrom.height + up).max(LEAST_HEIGHT).round()
    }
  }

  onSizeDrop(mut self) {
    const sized = peek self.sizing
    if (sized != nil) {
      self.settings.change((values: mut Choices): nil => {
        values.width = sized.width
        values.height = sized.height
      })
    }
    self.sizing = nil
  }

  public render(self): Template {
    return $ltml {
      <Placed id={"OrdaenChat.chat"} title={Locale.TITLE} home={HOME}>
        <Pane tabs={self.tabs} openKey={self.open?.key ?? ""} width={self.width} height={self.height} awayOpacity={self.awayOpacity}
              input={Game.chat.input} typing={Game.chat.typing} inputAlways={self.inputAlways} @picked={self.onPick}
              @tabPicked={self.onTab} @namePicked={self.onName} @link={self.onLink} @sizeGrab={self.onSizeGrab}
              @size={self.onSize} @sizeDrop={self.onSizeDrop} />
      </Placed>
      <Placed $for={tab of self.undocked} id={`OrdaenChat.${(peek tab).key}`} title={Locale.TITLE} home={UNDOCKED}>
        <Pane tabs={[tab]} openKey={tab.key} width={self.width} height={self.height} awayOpacity={self.awayOpacity}
              @tabPicked={self.onTab} @namePicked={self.onName} @link={self.onLink} @sizeGrab={self.onSizeGrab}
              @size={self.onSize} @sizeDrop={self.onSizeDrop} />
      </Placed>
      <Whispers $if={self.talking} talks={self.talks} openKey={self.talkOpen} declared={mut self.whisperWindow}
                @close={self.onTalkClose} @picked={self.onTalk} @forget={self.onTalkForget} @start={self.onTalkStart}
                @send={self.onTalkSend} @link={self.onLink} />
      <CopyBox $if={self.copied != ""} title={Locale.COPY_TITLE} value={self.copied} @close={self.onCopyClose} />
      <Dialog $if={self.renaming != nil} width={300dp} title={Locale.TAB_RENAME}>
        <Field value={mut self.newName} maxLength={40} placeholder={Locale.TAB_NAME} />
        <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.onRenameCancel} />
        <PushButton #buttons label={Locale.TAB_RENAME} width={BUTTON} @click={self.onRename} />
      </Dialog>
    }
  }
}
