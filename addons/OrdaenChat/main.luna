// Ordaen Chat: the game's chat in Ordaen's frame. It reads every line the game's windows would show, after every
// addon's filters (`Game.chat.heard`), and draws them itself; the game's windows stand hidden meanwhile. Its tabs are
// the game's windows docked with the first (the combat log's frame held as it is), each showing the channels and
// communities its settings tick; each window the player undocked is a pane of its own. Whispers are Ordaen Social's
// (its window's whispers' tab) where it is on; without it, they stand in the windows that show them. The input is the
// game's own, dressed as ours and placed under the lines: sending, slash commands, Shift-click links and other addons'
// hooks stay the game's. A tab's right-click menu and the «Tabs» page are ours, over the game's own window settings.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Anchored, Event, Point } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { BODY_TEXT, ButtonPlate, CopyBox, Dialog, Field, Module, Placed, PushButton, Settings, SettingsPage } from "Ordaen"
import root Panel from "OrdaenPanel"
import { PORTRAIT_HEIGHT, PORTRAIT_WIDTH } from "OrdaenPanel"
import root Quests from "OrdaenQuests"
import root Social from "OrdaenSocial"
import { ChannelName, ChatSize, Choices, LEAST_HEIGHT, LEAST_WIDTH, MESSAGE_GAP, TabChoices, tabDefaults, tabKey } from "@/choices"
import { ChatTab, Kept, KeptTab, Shown, THIS_SESSION, channelOf, creatureNamed, linked, marks } from "@/lines"
import Locale from "@/locales"
import { LinkPick, Pane, TabPick, nameOf, questOf, shownName } from "@/pane"
import { ChatPage } from "@/settings"
import { TabsPage } from "@/tabsPage"

// Where an undocked window's pane stands until the player moves it: over the chat.
const UNDOCKED: Anchored = { point: Point.BottomLeft, x: 8dp, y: -300dp }
const PREFIX = "ordaenurl:"
// Where the last lines of each tab are kept between sessions.
const HISTORY = "OrdaenChat:history"
// A tab every character's chat starts with, past the game's own two: its name, the message groups it shows, and
// whether it takes the character's channels, which the General window then leaves to it.
struct DefaultTab {
  // Where the character's chat keeps that it was made.
  made: String
  name: String
  groups: Array<String>
  channels: Boolean
}

const DEFAULT_TABS: Array<DefaultTab> = [
  { made: "OrdaenChat:guildWindow", name: Locale.TAB_GUILD_NAME, groups: ["GUILD", "OFFICER"], channels: false },
  { made: "OrdaenChat:channelsWindow", name: Locale.TAB_CHANNELS_NAME, groups: ["CHANNEL"], channels: true }
]
// The game's General window, which the channels leave for their own tab.
const GENERAL = 1
const BUTTON = 90dp

public class Chat implements Module, App {
  public const title: String = "Ordaen Chat"
  settings: mut Settings<Choices> = new Settings<Choices>({
    width: 430, height: 190, hide: false, hiddenOpacity: 0, ground: 0.8, tabs: {},
    inputAlways: false, ownTextSize: false, textSize: BODY_TEXT / 1ui,
    messageGap: MESSAGE_GAP
  })
  // The window the «Tabs» page shows.
  state editing = 1
  // The default tabs asked for on the next frame.
  defaultTabsAsked = false
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_CHAT, content: $ltml { <ChatPage settings={mut self.settings} /> } },
    { title: Locale.TAB_TABS, content: $ltml { <TabsPage window={mut self.editing} settings={mut self.settings} /> } }
  ]

  // Every tab made, by its key, kept while its key is; the chat's own pane's in their order (the docked windows), and
  // the undocked windows', each a pane.
  made: mut Map<String, mut ChatTab> = {}
  public state tabs: Array<ChatTab> = []
  public state undocked: Array<ChatTab> = []
  public state openKey = "w1"
  // A web address clicked: shown to copy.
  public state copied = ""
  // The quest link whose quest the player is asked to abandon, and the items abandoning it destroys.
  state abandoning: Event.Link | nil = nil
  state abandonItems: Array<String> = []
  derived abandonAsk: String = Locale.QUEST_ABANDON_ASK.format(self.abandoning != nil ? shownName(self.abandoning ?? panic("asked while set")) : "")
  derived abandonLoses: String = Locale.QUEST_ABANDON_ITEMS.format(self.abandonItems.join(", "))
  // The tab being renamed, and its name meanwhile.
  state renaming: ChatTab | nil = nil
  state newName = ""

  // The size while the grip is dragged (in dp), kept as it is let go; where the drag began.
  state sizing: ChatSize | nil = nil
  sizedFrom: ChatSize = { width: 0, height: 0 }
  // Never under the least: a size kept from before stands at it.
  derived width: Number<Length> = (self.sizing?.width ?? self.settings.values.width).max(LEAST_WIDTH) * 1dp
  derived height: Number<Length> = (self.sizing?.height ?? self.settings.values.height).max(LEAST_HEIGHT) * 1dp
  // How much of the chat shows while the cursor is off it.
  derived awayOpacity: Number = self.settings.values.hide ? self.settings.values.hiddenOpacity : 1
  // Where the chat stands until the player moves it: on the bottom panel at the screen's left, its tabs over the
  // character's portrait (the panel's room, none where it isn't along the bottom).
  derived home: Anchored = { point: Point.BottomLeft, x: 0dp, y: -Panel.bottomRoom }
  // While the portrait shows, the tabs are at least its width and keep room at their foot for what of it rises over
  // the panel, so they stand above it.
  derived tabsLeast: Number<Length> = Panel.portraitShown ? PORTRAIT_WIDTH : 0ui
  derived tabsFoot: Number<Length> = Panel.portraitShown ? (PORTRAIT_HEIGHT - Panel.bottomRoom).max(0ui) : 0ui
  derived ground: Color = { r: 0, g: 0, b: 0, a: self.settings.values.ground }
  derived inputAlways: Boolean = self.settings.values.inputAlways
  derived between: Number<Spacing> = self.settings.values.messageGap * 1sp
  // The lines' text: Ordaen's body text, as every module's, or the chat's own size (in UI units) where the player
  // chose one.
  derived textSize: Number<TextSize> = self.settings.values.ownTextSize ? self.settings.values.textSize * 1rem * 1ui / BODY_TEXT : 1rem
  derived open: ChatTab | nil = self.tabs.find(tab => tab.key == self.openKey) ?? self.tabs[1]

  constructor() {
    Ordaen.modules.add(self)
    Game.chat.read(true)
    Game.chat.heard.listen(self.onLine)
    Game.chat.playerReported.listen(self.onReported)
    Events.PLAYER_LOGOUT.listen(self.keep)
    // The game's windows loaded, and the player in the world: the guild's tab made where it is due.
    Events.UPDATE_CHAT_WINDOWS.listen(self.onWindowsLoaded)
    Events.PLAYER_ENTERING_WORLD.listen(self.onEnterWorld)
    Events.CHANNEL_UI_UPDATE.listen(self.onWindowsLoaded)
    watch (windows of Game.chat.windows) { self.sync() }
    // Whispers are Ordaen Social's: the game opens no window of its own for them.
    if (Social != nil) { Game.chat.whisperWindows(false) }
    // The input's history kept as the open tab chose.
    watch { Game.chat.inputHistory(self.open?.history ?? .All) }
    watch { Game.chat.inputShown(self.settings.values.inputAlways) }
    watch { self.chooseTabs(self.settings.values.tabs) }
    // The input opened (Enter): it speaks where the open tab's window last spoke (a whisper window, to its partner).
    watch (typing of Game.chat.typing) {
      if (typing) { self.speakHere() }
    }
    self.recall()
  }

  destructor() {
    self.keep()
    Game.chat.read(false)
  }

  // The tabs made anew from the game's windows; a tab whose key stays keeps its lines.
  sync(mut self) {
    const tabs: Array<ChatTab> = []
    const undocked: Array<ChatTab> = []
    for (window of peek Game.chat.windows) {
      const tab = self.tabOf(`w${window.index}`, window.name)
      tab.follow(window)
      if (window.docked || window.index == 1) {
        tabs.push(tab)
      } else {
        undocked.push(tab)
      }
    }
    self.tabs = tabs
    self.undocked = undocked
    self.chooseTabs((peek self.settings.values).tabs)
  }

  // Each window's tab takes its own settings: the player's, else its window's defaults.
  chooseTabs(mut self, chosen: Map<String, TabChoices>) {
    for (window of peek Game.chat.windows) {
      const tab = self.made[tabKey(window.index)]
      if (tab != nil) { tab.choose(chosen[tab.key] ?? tabDefaults(window)) }
    }
  }

  tabOf(mut self, key: String, title: String): mut ChatTab {
    const known = self.made[key]
    if (known != nil) { return known }
    const tab = new ChatTab(key, title)
    self.made[key] = tab
    return tab
  }

  // A line heard: a whisper Ordaen Social's, its words alone (their web addresses links); any other added to each tab
  // that shows it, drawn as the tab chose (its channel's name, its keywords' mark): made once for the tabs that agree.
  onLine(mut self, line: Game.ChatLine) {
    if (Social?.heard(line, line.secret != "" ? line.body : linked(line.text)) == true) { return }
    const open = peek self.openKey
    // The line as drawn, by how a tab draws it: its channel's name, its keywords.
    const drawn: Map<String, Shown> = {}
    for (index of line.windows) {
      const key = tabKey(index)
      // A window opened in the same call as its first line (a whisper's): its tab is made now, not after the frame.
      if (self.made[key] == nil) { self.sync() }
      let tab = self.made[key]
      if (tab != nil) {
        const as = `${line.channel > 0 ? peek tab.channelName : ""}|${peek tab.keywords}`
        const shown = drawn[as] ?? self.shownLine(line, peek tab.channelName, peek tab.words)
        drawn[as] = shown
        self.addTo(tab, shown, open)
      }
    }
  }

  // A player reported: their lines go from every tab and conversation, as the game's windows take them away.
  onReported(mut self, guid: String) {
    if (guid == "") { return }
    for (_, tab of self.made) { tab.forgetSender(guid) }
    Social?.reported(guid)
  }

  addTo(mut self, tab: mut ChatTab, shown: Shown, open: String) {
    tab.add(shown)
    // An undocked window's pane shows each line as it comes: nothing waits unread there.
    if (tab.key != open && peek tab.docked && peek tab.counted) { tab.unread = (peek tab.unread) + 1 }
  }

  shownLine(self, line: Game.ChatLine, channelName: ChannelName, words: Array<String>): Shown {
    if (line.secret != "") {
      return {
        whole: line.body, color: line.color, time: line.time, repeat: "", count: 1, marked: false, session: THIS_SESSION, secret: true,
        sender: line.guid
      }
    }
    const channel = line.channel > 0 ? channelOf(line, channelName) : ""
    const own = line.sender == Game.player.name || line.sender.match("^([^%-]+)") == Game.player.name
    return {
      // The time where the game shows the chat's times: drawn where the tab places it.
      whole: `${channel}${linked(creatureNamed(line))}`, color: line.color, time: line.time, stamped: line.stamp != "",
      repeat: `${line.kind}|${line.channel}|${line.sender}|${line.text}`, count: 1,
      marked: line.sender != "" && !own && marks(line.text, words), session: THIS_SESSION, secret: false,
      sender: line.guid
    }
  }

  onPick(mut self, tab: ChatTab) {
    self.openKey = tab.key
    const made = self.made[tab.key]
    if (made != nil) { made.unread = 0 }
    if (tab.window > 0) { Game.chat.choose(tab.window) }
    if (peek Game.chat.typing) { self.speakTo(tab) }
  }

  // The input, opened, speaks where the open tab's window speaks: a whisper window's partner; another, where it last
  // spoke (the game keeps each window's own), else its first kind.
  speakHere(mut self) {
    const tab = peek self.open
    if (tab != nil) { self.speakTo(tab) }
  }

  speakTo(mut self, tab: ChatTab) {
    if (tab.window > 0) { Game.chat.speak(tab.window) }
  }

  // A link clicked: a web address opens the copy box; any other is the game's.
  onLink(mut self, link: Event.Link) {
    if (link.link.sub(1, PREFIX.length) == PREFIX) {
      self.copied = link.link.sub(PREFIX.length + 1)
      return
    }
    Game.chat.click(link.link, link.text, link.button)
  }

  onCopyClose(mut self) { self.copied = "" }

  // A tab's menu: rename (a box asks the name), its page of the settings, a new tab, lock, the mouse through its lines
  // or not, undock or dock, close.
  onTab(mut self, pick: TabPick) {
    const window = pick.tab.window
    match (pick.action) {
      .Rename => {
        self.newName = pick.tab.title
        self.renaming = pick.tab
      }
      .Settings => {
        self.editing = window
        Ordaen.toggleSettings(Runtime.Addon.of(self))
      }
      .New => { _ = Game.chat.open(Locale.TAB_NEW_NAME) }
      .Lock => { Game.chat.lock(window, !pick.tab.locked) }
      .Interactable => { Game.chat.interactable(window, pick.tab.uninteractable) }
      .Undock => { Game.chat.undock(window) }
      .Dock => { Game.chat.dock(window) }
      .Close => { Game.chat.close(window) }
    }
  }

  onRename(mut self) {
    const tab = peek self.renaming
    const name = peek self.newName
    if (tab != nil && name != "") { Game.chat.rename(tab.window, name) }
    self.renaming = nil
  }

  onRenameCancel(mut self) { self.renaming = nil }

  // A link's menu picked. A player's name: whisper them, invite them, ask who they are, befriend or ignore them, or the
  // game's own menu of them (its entries the client keeps to itself are reached there). A quest of the log: tracked
  // or not, shared, or abandoned once the player says so. Any link: its name (a web address whole) in the copy box.
  onLinkPick(mut self, pick: LinkPick) {
    const name = nameOf(pick.link.link) ?? ""
    const quest = questOf(pick.link.link) ?? 0
    match (pick.action) {
      // Ordaen Social's conversation with them; without it, the game's input whispering them.
      .Whisper => {
        const social = Social
        if (social != nil) {
          social.whisperTo(name, false)
        } else {
          Game.chat.click(pick.link.link, pick.link.text, .Left)
        }
      }
      .Invite => { Client.C_PartyInfo.InviteUnit(name) }
      .Who => { Client.C_FriendList.SendWho(`n-"${name}"`, nil, nil) }
      .Befriend => { Game.friends.add(name) }
      .Ignore => { _ = Client.C_FriendList.AddIgnore(name) }
      .More => { Game.chat.click(pick.link.link, pick.link.text, .Right) }
      .ShowInLog => { _ = Quests?.openAt(quest) }
      .ShowOnMap => { _ = Quests?.showOnMap(quest) }
      .Track => { Game.questLog.track(quest, true) }
      .Untrack => { Game.questLog.track(quest, false) }
      .Share => { Game.questLog.share(quest) }
      .Abandon => {
        self.abandonItems = Game.questLog.abandonItems(quest)
        self.abandoning = pick.link
      }
      .Copy => { self.copied = pick.link.link.sub(1, PREFIX.length) == PREFIX ? pick.link.link.sub(PREFIX.length + 1) : shownName(pick.link) }
    }
  }

  onAbandon(mut self) {
    const link = peek self.abandoning
    const quest = link != nil ? questOf(link.link) : nil
    if (quest != nil) { Game.questLog.abandon(quest) }
    self.abandoning = nil
  }

  onAbandonCancel(mut self) { self.abandoning = nil }

  // A character's first chat has the default tabs, docked after the game's own two. Asked after each time the game's
  // windows load, the player enters the world or the channels change (a tab of channels waits for the character's):
  // after, as the game's own handlers of the same event lay its saved windows over whatever was opened before them.
  // A tab is done for the character once a later ask finds a window past the game's two showing its lines, so one
  // closed then stays closed.
  onWindowsLoaded(mut self) { self.defaultTabsLater() }

  onEnterWorld(mut self, initial: Boolean, reloaded: Boolean) { self.defaultTabsLater() }

  // Once a frame, however many events ask.
  defaultTabsLater(mut self) {
    if (self.defaultTabsAsked) { return }
    self.defaultTabsAsked = true
    Client.C_Timer.After(0, (): nil => {
      self.defaultTabsAsked = false
      for (tab of DEFAULT_TABS) { self.defaultTab(tab) }
    })
  }

  defaultTab(mut self, tab: DefaultTab) {
    if (Game.saved.stored(Game.Scope.Character, tab.made) != nil) { return }
    if (showsAny(tab.groups)) {
      Game.saved.store(Game.Scope.Character, tab.made, true)
      return
    }
    const joined = Game.chat.channels(GENERAL)
    if (tab.channels && joined.length == 0) { return }
    const made = Game.chat.open(tab.name)
    if (made == nil) { return }
    for (group of Game.chat.groups(made)) {
      if (group.shown) { Game.chat.showGroup(made, group.name, false) }
    }
    for (group of tab.groups) { Game.chat.showGroup(made, group, true) }
    for (channel of Game.chat.channels(made)) {
      if (channel.shown != tab.channels) { Game.chat.showChannel(made, channel.name, tab.channels) }
    }
    if (tab.channels) {
      for (channel of joined) {
        if (channel.shown) { Game.chat.showChannel(GENERAL, channel.name, false) }
      }
    }
  }

  // The last lines of each tab, as many as it keeps, for the next session: written once, as the player logs out.
  keep(mut self) {
    const tabs: Array<KeptTab> = []
    for (_, tab of self.made) {
      const count = peek tab.kept
      if (count > 0) { tabs.push({ key: tab.key, lines: tab.keptLines(count) }) }
    }
    Game.saved.store(Game.Scope.Character, HISTORY, Kept { tabs: tabs })
  }

  recall(mut self) {
    const kept = Kept.decode(Game.saved.stored(Game.Scope.Character, HISTORY), Kept { tabs: [] })
    // A window's tab's alone: the conversations kept before they were Ordaen Social's are let go.
    for (tab of kept.tabs) {
      if (tab.key.sub(1, 1) == "w") { self.tabOf(tab.key, "").recall(tab.lines) }
    }
  }

  // The grip in the chat's top right corner taken: the chat stands by its bottom left, so it grows to the right and
  // up, up to the screen's edges and down to the least the settings allow. The chat is drawn never narrower than its
  // tabs and its lines need, whatever width is chosen.
  // The drag starts from the width drawn (the room's least as it is taken), which may be more than the width chosen.
  onSizeGrab(mut self, drag: Event.Drag) {
    self.sizedFrom = { width: drag.room.leastWidth / 1dp, height: (peek self.height) / 1dp }
  }

  onSize(mut self, drag: Event.Drag) {
    const right = drag.dx.min(drag.room.right) / 1dp
    const up = -(drag.dy.max(-drag.room.up) / 1dp)
    self.sizing = ChatSize {
      width: (self.sizedFrom.width + right).max(LEAST_WIDTH).round(),
      height: (self.sizedFrom.height + up).max(LEAST_HEIGHT).round()
    }
  }

  onSizeDrop(mut self) {
    const sized = peek self.sizing
    if (sized != nil) {
      self.settings.change((values: mut Choices): nil => {
        values.width = sized.width
        values.height = sized.height
      })
    }
    self.sizing = nil
  }

  public render(self): Template {
    return $ltml {
      <Placed id={"OrdaenChat.chat"} title={Locale.TITLE} home={self.home}>
        <Pane tabsLeast={self.tabsLeast} tabsFoot={self.tabsFoot} tabs={self.tabs} openKey={self.open?.key ?? ""} width={self.width} height={self.height} awayOpacity={self.awayOpacity}
              ground={self.ground}
              textSize={self.textSize} between={self.between} input={Game.chat.input} typing={Game.chat.typing} inputAlways={self.inputAlways}
              @picked={self.onPick} @tabPicked={self.onTab} @linkPicked={self.onLinkPick} @link={self.onLink} @sizeGrab={self.onSizeGrab}
              @size={self.onSize} @sizeDrop={self.onSizeDrop} />
      </Placed>
      <Placed $for={tab of self.undocked} id={`OrdaenChat.${(peek tab).key}`} title={Locale.TITLE} home={UNDOCKED}>
        <Pane tabs={[tab]} openKey={tab.key} width={self.width} height={self.height} awayOpacity={self.awayOpacity}
              ground={self.ground}
              textSize={self.textSize} between={self.between} @tabPicked={self.onTab} @linkPicked={self.onLinkPick} @link={self.onLink} @sizeGrab={self.onSizeGrab}
              @size={self.onSize} @sizeDrop={self.onSizeDrop} />
      </Placed>
      <CopyBox $if={self.copied != ""} title={Locale.COPY_TITLE} value={self.copied} @close={self.onCopyClose} />
      <Dialog $if={self.renaming != nil} width={300dp} title={Locale.TAB_RENAME}>
        <Field value={mut self.newName} maxLength={40} placeholder={Locale.TAB_NAME} />
        <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.onRenameCancel} />
        <PushButton #buttons label={Locale.TAB_RENAME} width={BUTTON} @click={self.onRename} />
      </Dialog>
      <Dialog $if={self.abandoning != nil} width={300dp} title={Locale.QUEST_ABANDON}>
        <text value={self.abandonAsk} />
        <text $if={self.abandonItems.length > 0} value={self.abandonLoses} />
        <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.onAbandonCancel} />
        <PushButton #buttons label={Locale.QUEST_ABANDON} width={BUTTON} plate={ButtonPlate.Accent} @click={self.onAbandon} />
      </Dialog>
    }
  }
}

// Whether a window past the game's two shows any of the message groups.
function showsAny(groups: Array<String>): Boolean {
  return (peek Game.chat.windows).any(window => window.index > 2 && Game.chat.groups(window.index).any(group => group.shown && groups.any(name => name == group.name)))
}
