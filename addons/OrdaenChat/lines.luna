// The chat's tabs and the lines each holds: a tab is one of the game's chat windows (its whisper windows among them),
// and a line is what the game's window would show, made once as it is heard.
import Game from "$game"
import { ChannelName, StampPlace, TabChoices } from "@/choices"

// A line as a tab shows it. `whole` is what is drawn after its time: the channel, the words with their links and «×N».
public struct Shown implements Plain {
  whole: String
  color: Color
  // Its time is drawn (the game shows the chat's times), where the tab places it. A line kept from before the times
  // were drawn apart has it in `whole`.
  stamped: Boolean = false
  // When it was said (seconds since 1970).
  time: Number
  // What tells a repeat: who said it, where, and the words.
  repeat: String
  count: Integer
  // Someone else's line naming the player or one of the keywords.
  marked: Boolean
  // When the session that heard it began (seconds since 1970): a view sets each session's lines apart under a rule
  // naming it. 0 for a line kept before sessions were told apart.
  session: Number = 0
  // The client kept its words secret: drawn as the client gives them, never measured, never kept.
  secret: Boolean
  // Who said it (their GUID; empty for none): a player reported has their lines taken away. A line kept without one
  // was said by nobody known.
  sender: String = ""
}

// What one tab keeps between sessions.
public struct KeptTab implements Plain {
  key: String
  lines: Array<Shown>
}

public struct Kept implements Plain {
  tabs: Array<KeptTab>
}

// When this session began: the session of every line it hears.
public const THIS_SESSION: Number = peek Game.clock.server

// A line's time before it: in brackets, a muted grey. Lines were once kept with it at the start of their text.
public const STAMP = "|cff9d9d9d[%s]|r "

// A line kept with its time at the start of its text: the time taken out, the line stamped.
function stampedApart(line: Shown): Shown {
  if (line.stamped || line.secret) { return line }
  const words = line.whole.replace("^|cff9d9d9d%[[^%]]*%]|r ", "")
  if (words == line.whole) { return line }
  const apart = line.clone()
  apart.whole = words
  apart.stamped = true
  return apart
}

// Where a line's time is drawn as a view lays it out: nowhere (not stamped, or above an earlier line of its minute),
// before it, or above it, opening its minute's lines.
public enum StampShown implements Equal { None, Before, Above }

// A line as a view lays it out: the line, whether a session's rule stands above it (its session isn't the line's
// before; the first line, where it isn't this session's), and where its time is drawn.
public struct Entry {
  line: Shown
  opens: Boolean
  stamp: StampShown
}

// Where a line's time is drawn, given the line before it (nil: none) and the tab's place for times: above, a line
// opens its minute where the line before it is of another minute or isn't stamped, or a session's rule stands between.
function stampOf(line: Shown, before: Shown | nil, opens: Boolean, place: StampPlace): StampShown {
  if (!line.stamped) { return .None }
  if (place == .Inline) { return .Before }
  if (before == nil || opens || !before.stamped) { return .Above }
  return (before.time / 60).floor() != (line.time / 60).floor() ? .Above : .None
}

// A tab: a window's (`w<n>`).
public class ChatTab {
  public const key: String
  public state title: String
  // The game's window behind it (`ChatFrame<n>`).
  public const window: Integer
  // What the window is now: a whisper window's partner, whether it is the combat log's.
  public state partner = ""
  public state combatLog = false
  // Docked with the first window (a tab of the chat's own pane), or a pane of its own; locked in place.
  public state docked = true
  public state locked = false
  // The mouse goes through its lines: its links take no click.
  public state uninteractable = false
  // Its lines, oldest first; `version` moves as they change, which is what a view follows.
  public lines: mut Array<Shown> = []
  public state version = 0
  // Lines heard while another tab was open, counted where its settings show the count.
  public state unread = 0
  public state counted = true
  // How its channels' lines name their channel; where its lines' times stand.
  public state channelName: ChannelName = .Name
  public state stamps: StampPlace = .Above
  // The words that mark someone else's line in it, the player's name with them; whether it folds repeats; how many
  // lines it holds and keeps after a reload; what the input's history keeps while it is open.
  public state keywords = ""
  public derived words: Array<String> = wordsOf(self.keywords, Game.player.name)
  public state repeats = true
  public state held = 500
  public state kept = 200
  public state history: Game.ChatHistory = .All

  constructor(key: String, title: String) {
    self.key = key
    self.window = (key.sub(2).toNumber() ?? 0).floor()
    self.title = title
  }

  // The window's state as the game has it now.
  public follow(mut self, window: Game.ChatWindow) {
    self.title = window.partner != "" ? window.partner : window.name
    self.partner = window.partner
    self.combatLog = window.combatLog
    self.docked = window.docked
    self.locked = window.locked
    self.uninteractable = window.uninteractable
  }

  // Its own settings, as the player chose them or its window's defaults.
  public choose(mut self, choices: TabChoices) {
    self.counted = choices.counter
    self.channelName = choices.channelName
    self.stamps = choices.stamps
    self.keywords = choices.keywords
    self.repeats = choices.repeats
    self.held = choices.held
    self.kept = choices.kept
    self.history = choices.history
    if (!choices.counter) { self.unread = 0 }
  }

  // A sender's lines taken away (a player reported).
  public forgetSender(mut self, guid: String) {
    const kept = self.lines.filter(line => line.sender != guid)
    if (kept.length == self.lines.length) { return }
    self.lines = kept
    self.version = (peek self.version) + 1
  }

  // A line added, or the last one counted again where it repeats it (where it folds repeats); the oldest let go past
  // `held`.
  public add(mut self, line: Shown) {
    const last = self.lines[self.lines.length]
    if (peek self.repeats && !line.secret && last != nil && !last.secret && last.repeat == line.repeat) {
      const again = line.clone()
      again.count = last.count + 1
      again.whole = `${line.whole} |cff9d9d9d×${again.count}|r`
      self.lines[self.lines.length] = again
    } else {
      self.lines.push(line)
      if (self.lines.length > peek self.held) { _ = self.lines.remove(1) }
    }
    self.version = (peek self.version) + 1
  }

  // The lines kept for the next session: the last `count` that can be kept.
  public keptLines(self, count: Integer): Array<Shown> {
    const keep: Array<Shown> = []
    for (line of self.lines) {
      if (!line.secret) { keep.push(line) }
    }
    for (at of count + 1..keep.length) { _ = keep.remove(1) }
    return keep
  }

  // Lines of the last session, before this one's; a line kept with its time in its text has it drawn apart, as a line
  // heard now.
  public recall(mut self, lines: Array<Shown>) {
    const now: Array<Shown> = lines.map(stampedApart)
    for (line of self.lines) { now.push(line) }
    self.lines = now
    self.version = (peek self.version) + 1
  }

  // The lines a view shows: `count` of them, ending `back` lines before the newest.
  public slice(self, back: Integer, count: Integer): Array<Entry> {
    const shown: Array<Entry> = []
    const last = self.lines.length - back
    for (at of (1).max(last - count + 1)..last) {
      const line = self.lines[at] ?? panic("inside the lines")
      const before = self.lines[at - 1]
      const opens = before != nil ? before.session != line.session : line.session != THIS_SESSION
      shown.push({ line: line, opens: opens, stamp: stampOf(line, before, opens, self.stamps) })
    }
    return shown
  }
}

// The channel's name as the player chose it, as a link that opens the channel: «[2. Trade]».
public function channelOf(line: Game.ChatLine, style: ChannelName): String {
  const name = line.channelName.match("^([^%-]-)%s*%-") ?? line.channelName
  const shown = match (style) {
    .Number => String.of(line.channel)
    .Name => name
    .Both => `${line.channel}. ${name}`
  }
  return `|Hchannel:CHANNEL:${line.channel}|h[${shown}]|h `
}

// A creature's or a boss's name at the start of its line, in the game's gold for names, not its line's colour (a yell's
// red, a say's white): «Ragnaros: BY FIRE BE PURGED!». The game names a creature plainly, with no link.
const CREATURE_NAME = "|cffffd100%s|r"

public function creatureNamed(line: Game.ChatLine): String {
  const creature = line.kind.sub(1, 7) == "MONSTER" || line.kind.sub(1, 9) == "RAID_BOSS"
  const head = `${line.sender}: `
  if (!creature || line.sender == "" || line.plain.sub(1, head.length) != head) { return line.plain }
  return `${CREATURE_NAME.format(line.sender)}${line.plain.sub(line.sender.length + 1)}`
}

// The web addresses in a line's words made links the chat opens a copy box for.
public function linked(body: String): String {
  return body.replace("(https?://[%w%-%._~:/%?#@!%$&%%%*%+,;=]+)", "|cff69ccf0|Hordaenurl:%1|h[%1]|h|r")
}

// Whether someone else's words name the player or one of the words.
public function marks(text: String, words: Array<String>): Boolean {
  const lower = text.lower()
  return words.any(word => word != "" && lower.contains(word))
}

// The keywords as the setting writes them, lower-case, the player's name first.
public function wordsOf(keywords: String, own: String): Array<String> {
  const words: Array<String> = [own.lower()]
  for (word of keywords.split(",")) {
    const trimmed = word.replace("^%s+", "").replace("%s+$", "").lower()
    if (trimmed != "") { words.push(trimmed) }
  }
  return words
}
