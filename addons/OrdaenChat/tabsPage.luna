// «Tabs», the chat's page in the settings window: what each of the game's chat windows shows and its own settings,
// in place of Blizzard's chat settings. The windows in a sidebar, one picked, «New tab» under them; beside it the
// picked one's name, locked or not, the count of its unread lines, how its channels are named and
// «Close tab» (not for the game's General and combat log); then what the tab shows, with whether it does (groupRows.luna):
// «Общие», the kinds of speech; «Каналы», the channels' notices and each channel the character is in; «Сообщества»,
// each community's stream; «Системы», the game's own messages in sections. Every change applies at once; what a window
// shows is read anew from the game each time.
import Game from "$game"
import { Align } from "$ltml"
import { ButtonPlate, Checkbox, Choice, Component, Field, ListTab, PushButton, Section, Segmented, SettingRow, Settings, Switch } from "Ordaen"
import { ChannelName, Choices, TabChoices, tabDefaults, tabKey } from "@/choices"
import { COMMUNITIES, GroupRowView, NOTICES, RowPick, RowShown, SectionShown, TALKS, rowGroups, rowsOf, systemsOf } from "@/groupRows"
import Locale from "@/locales"

const MAX: "max-content" = "max-content"
const SIDEBAR = 180dp
const BUTTON = 130dp

const NAMES: Array<Choice<ChannelName>> = [
  { value: ChannelName.Name, label: Locale.CHANNEL_NAME },
  { value: ChannelName.Number, label: Locale.CHANNEL_NUMBER },
  { value: ChannelName.Both, label: Locale.CHANNEL_BOTH }
]

// A community's stream's key among the rows.
function streamKey(stream: Game.ChatStream): String {
  return `${stream.club}:${stream.stream}`
}

// The windows' own settings with one window's set (nil: taken away).
function withTab(tabs: Map<String, TabChoices>, key: String, choices: TabChoices | nil): Map<String, TabChoices> {
  const changed: Map<String, TabChoices> = {}
  for (other, kept of tabs) { changed[other] = kept }
  changed[key] = choices
  return changed
}

// A message group's or a channel's row: its check turns it on or off in the window. It shows what each read of the
// game says (a new value each time, so a change the game refused goes back), and the window picked.
public class ShownRow implements Component {
  public toggled: Event<Game.ChatShown> = new Event()
  state on = false
  item: Signal<Game.ChatShown>
  label: Signal<String>
  constructor(item: Signal<Game.ChatShown>, label: Signal<String>) {
    self.item = item
    self.label = label
    watch (read of self.item) { self.on = read.shown }
    watch (on of self.on) {
      const read = peek self.item
      if (on != read.shown) { self.toggled.emit({ name: read.name, shown: on }) }
    }
  }

  public render(self): Template {
    return $ltml { <Checkbox label={self.label} value={mut self.on} /> }
  }
}

// One window's entry in the sidebar.
public class WindowEntry implements Component {
  public pick: Event<Integer> = new Event()
  const window: Game.ChatWindow
  picked: Signal<Boolean>
  constructor(window: Game.ChatWindow, picked: Signal<Boolean>) {
    self.window = window
    self.picked = picked
  }

  onPick(mut self) { self.pick.emit(self.window.index) }

  public render(self): Template {
    return $ltml { <ListTab label={self.window.name} selected={self.picked} @pick={self.onPick} /> }
  }
}

public class TabsPage implements Component {
  derived chosen: Game.ChatWindow | nil = Game.chat.windows.find(window => window.index == self.window)
  // Moved by each change of what the window shows, so what it shows is read anew.
  state version = 0
  derived groups: Array<Game.ChatGroup> = self.version >= 0 ? Game.chat.groups(self.window) : []
  derived talks: Array<RowShown> = rowsOf(TALKS, self.groups)
  derived notices: Array<RowShown> = rowsOf([NOTICES], self.groups)
  derived systems: Array<SectionShown> = systemsOf(self.groups)
  derived channels: Array<Game.ChatShown> = self.version >= 0 ? Game.chat.channels(self.window) : []
  derived communities: Array<Game.ChatCommunity> = self.version >= 0 ? Game.chat.communities(self.window) : []
  derived closable: Boolean = self.window > 2
  state name = ""
  state locked = false
  state counter = true
  state channelName: ChannelName = .Name

  window: mut Signal<Integer>
  settings: mut Settings<Choices>
  constructor(window: mut Signal<Integer>, settings: mut Settings<Choices>) {
    self.window = window
    self.settings = settings
    // The picked window's own settings, taken as it is picked.
    watch (chosen of self.chosen) {
      self.name = chosen?.name ?? ""
      self.locked = chosen?.locked == true
      const own = chosen != nil ? self.choicesOf(chosen) : nil
      self.counter = own?.counter ?? true
      self.channelName = own?.channelName ?? .Name
    }
    watch (locked of self.locked) {
      const chosen = peek self.chosen
      if (chosen != nil && chosen.locked != locked) { Game.chat.lock(chosen.index, locked) }
    }
    watch (counter of self.counter) { self.writeTab() }
    watch (channelName of self.channelName) { self.writeTab() }
  }

  // A window's own settings: the player's, else its defaults.
  choicesOf(self, window: Game.ChatWindow): TabChoices {
    return (peek self.settings.values).tabs[tabKey(window.index)] ?? tabDefaults(window)
  }

  // The picked window's own settings written where they changed.
  writeTab(mut self) {
    const chosen = peek self.chosen
    if (chosen == nil) { return }
    const choices: TabChoices = { counter: peek self.counter, channelName: peek self.channelName }
    if (choices.equal(self.choicesOf(chosen))) { return }
    self.settings.change((values: mut Choices): nil => { values.tabs = withTab(values.tabs, tabKey(chosen.index), choices) })
  }

  onPick(mut self, window: Integer) { self.window = window }

  onRename(mut self) {
    const name = peek self.name
    if (name != "") { Game.chat.rename(peek self.window, name) }
  }

  // A row: each of its groups the client has, shown or not for what of it is picked.
  onRow(mut self, pick: RowPick) {
    const window = peek self.window
    const known = peek self.groups
    for (group of rowGroups(pick.key, pick.pair)) {
      if (known.any(each => each.name == group.name)) { Game.chat.showGroup(window, group.name, group.shown) }
    }
    self.version = (peek self.version) + 1
  }

  onChannel(mut self, channel: Game.ChatShown) {
    Game.chat.showChannel(peek self.window, channel.name, channel.shown)
    self.version = (peek self.version) + 1
  }

  // A community shown in the tab or not; the group that carries the communities' lines is shown while any is.
  onCommunity(mut self, row: Game.ChatShown) {
    const window = peek self.window
    const community = (peek self.communities).find(each => streamKey(each.stream) == row.name)
    if (community != nil) { Game.chat.showCommunity(window, community.stream, row.shown) }
    Game.chat.showGroup(window, COMMUNITIES, Game.chat.communities(window).any(each => each.shown))
    self.version = (peek self.version) + 1
  }

  onNew(mut self) {
    const made = Game.chat.open(Locale.TAB_NEW_NAME)
    if (made != nil) { self.window = made }
  }

  // A window closed: its own settings go with it, so a window opened later in its place starts from the defaults.
  onClose(mut self) {
    const window = peek self.window
    Game.chat.close(window)
    if ((peek self.settings.values).tabs[tabKey(window)] != nil) {
      self.settings.change((values: mut Choices): nil => { values.tabs = withTab(values.tabs, tabKey(window), nil) })
    }
    self.window = 1
  }

  public render(self): Template {
    return $ltml {
      <box columns={[SIDEBAR, { fr: 1 }]} gap={6sp}>
        <box columns={1} gap={3sp} yAlignSelf={Align.Start}>
          <box columns={1}>
            <WindowEntry $for={window of Game.chat.windows} window={peek window} picked={window.index == self.window}
                         @pick={self.onPick} />
          </box>
          <PushButton label={Locale.TAB_NEW} width={BUTTON} @click={self.onNew} />
        </box>
        <box columns={1} gap={6sp}>
          <Section title={Locale.TAB_ITSELF}>
            <box columns={[{ fr: 1 }, MAX]} gap={2sp} yAlign={Align.Center}>
              <Field value={mut self.name} maxLength={40} placeholder={Locale.TAB_NAME} />
              <PushButton label={Locale.TAB_RENAME} width={BUTTON} @click={self.onRename} />
            </box>
            <Switch label={Locale.TAB_LOCK} value={mut self.locked} />
            <Switch label={Locale.TAB_COUNTER} hint={Locale.TAB_COUNTER_TIP} value={mut self.counter} />
            <SettingRow label={Locale.TAB_CHANNEL_NAMES} hint={Locale.TAB_CHANNEL_NAMES_TIP}>
              <Segmented value={mut self.channelName} choices={NAMES} />
            </SettingRow>
            <PushButton label={Locale.TAB_CLOSE} width={BUTTON} plate={ButtonPlate.Accent} disabled={!self.closable}
                        @click={self.onClose} />
          </Section>
          <Section title={Locale.TAB_TALKS}>
            <GroupRowView $for={row of self.talks} item={row} @picked={self.onRow} />
          </Section>
          <Section title={Locale.TAB_CHANNELS}>
            <GroupRowView $for={row of self.notices} item={row} @picked={self.onRow} />
            <ShownRow $for={channel of self.channels} item={channel} label={channel.name} @toggled={self.onChannel} />
          </Section>
          <Section title={Locale.TAB_COMMUNITIES}>
            <ShownRow $for={community of self.communities} item={{ name: streamKey(community.stream), shown: community.shown }}
                      label={community.stream.name} @toggled={self.onCommunity} />
          </Section>
          <Section title={Locale.TAB_SYSTEMS}>
            <Section $for={section of self.systems} title={section.title}>
              <GroupRowView $for={row of section.rows} item={row} @picked={self.onRow} />
            </Section>
          </Section>
        </box>
      </box>
    }
  }
}
