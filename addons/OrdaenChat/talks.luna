// «Общие» on the «Вкладки» page: the kinds of speech a tab shows, each one row over the client's message groups of
// it (Blizzard keeps a group for a party's leader, a raid's warning, an NPC's say), and, where NPCs speak it too,
// whose lines: players', NPCs', both or none. Every group the client has that no kind covers is the game's own
// message, on «Системы».
import Game from "$game"
import { Checkbox, Choice, Component, Dropdown } from "Ordaen"
import Locale from "@/locales"

// Whose lines of a kind of speech a tab shows.
public enum Speakers { None = "none", Players = "players", Creatures = "creatures", All = "all" }

// A kind of speech: the client's groups of the players' lines (the first names the kind) and of the NPCs' (bosses'
// among them).
public struct Talk {
  players: Array<String>
  creatures: Array<String>
}

public const TALKS: Array<Talk> = [
  { players: ["SAY"], creatures: ["MONSTER_SAY", "MONSTER_WHISPER", "MONSTER_BOSS_WHISPER"] },
  { players: ["YELL"], creatures: ["MONSTER_YELL"] },
  { players: ["EMOTE"], creatures: ["MONSTER_EMOTE", "MONSTER_BOSS_EMOTE"] },
  { players: ["WHISPER", "BN_WHISPER"], creatures: [] },
  { players: ["PARTY", "PARTY_LEADER"], creatures: [] },
  { players: ["RAID", "RAID_LEADER", "RAID_WARNING"], creatures: [] },
  { players: ["INSTANCE_CHAT", "INSTANCE_CHAT_LEADER"], creatures: [] },
  { players: ["GUILD"], creatures: [] },
  { players: ["OFFICER"], creatures: [] }
]

const SPEAKERS: Array<Choice<Speakers>> = [
  { value: Speakers.None, label: Locale.SPEAKERS_NONE },
  { value: Speakers.Players, label: Locale.SPEAKERS_PLAYERS },
  { value: Speakers.Creatures, label: Locale.SPEAKERS_CREATURES },
  { value: Speakers.All, label: Locale.SPEAKERS_ALL }
]

// A kind of speech as a window shows it: named by its first group in the game's words, and whose lines it shows.
public struct TalkShown {
  key: String
  label: String
  // NPCs speak it too: whose lines is a choice of four, else on or off.
  creatures: Boolean
  speakers: Speakers
}

// A kind picked to show whose lines.
public struct TalkPick {
  key: String
  speakers: Speakers
}

function speakersOf(players: Boolean, creatures: Boolean): Speakers {
  if (players && creatures) { return .All }
  if (players) { return .Players }
  return creatures ? .Creatures : .None
}

// Whether a kind's groups the client has are shown in the window: the first of them speaks for them all.
function shownOf(names: Array<String>, groups: Array<Game.ChatGroup>): Boolean {
  return groups.find(group => names.any(name => name == group.name))?.shown == true
}

// The kinds of speech the client has (its first players' group), as the window's groups show them.
public function talksOf(groups: Array<Game.ChatGroup>): Array<TalkShown> {
  const shown: Array<TalkShown> = []
  for (talk of TALKS) {
    const first = groups.find(group => group.name == talk.players[1])
    if (first != nil) {
      shown.push({
        key: first.name, label: first.label, creatures: talk.creatures.length > 0,
        speakers: speakersOf(first.shown, shownOf(talk.creatures, groups))
      })
    }
  }
  return shown
}

// The game's own messages: every group no kind of speech covers, in the game's order.
public function systemsOf(groups: Array<Game.ChatGroup>): Array<Game.ChatGroup> {
  return groups.filter(group => !TALKS.any(talk => talk.players.any(name => name == group.name) || talk.creatures.any(name => name == group.name)))
}

// Each group a kind shows or not for whose lines: the players' groups, the NPCs'.
public function talkGroups(key: String, speakers: Speakers): Array<Game.ChatShown> {
  const talk = TALKS.find(each => each.players[1] == key)
  const groups: Array<Game.ChatShown> = []
  if (talk == nil) { return groups }
  const players = speakers == .Players || speakers == .All
  const creatures = speakers == .Creatures || speakers == .All
  for (name of talk.players) { groups.push({ name: name, shown: players }) }
  for (name of talk.creatures) { groups.push({ name: name, shown: creatures }) }
  return groups
}

// A kind of speech's row: whose lines where NPCs speak it too, else a check. It shows what each read of the game says.
public class TalkRow implements Component {
  public picked: Event<TalkPick> = new Event()
  state speakers: Speakers = .None
  state on = false
  item: Signal<TalkShown>
  constructor(item: Signal<TalkShown>) {
    self.item = item
    watch (read of self.item) {
      self.speakers = read.speakers
      self.on = read.speakers != .None
    }
    watch (speakers of self.speakers) {
      const read = peek self.item
      if (speakers != read.speakers) { self.picked.emit({ key: read.key, speakers: speakers }) }
    }
    watch (on of self.on) {
      const read = peek self.item
      if (on != (read.speakers != .None)) { self.picked.emit({ key: read.key, speakers: on ? .Players : .None }) }
    }
  }

  public render(self): Template {
    return $ltml {
      <Dropdown $if={self.item.creatures} label={self.item.label} value={mut self.speakers} choices={SPEAKERS} />
      <Checkbox $else label={self.item.label} value={mut self.on} />
    }
  }
}
