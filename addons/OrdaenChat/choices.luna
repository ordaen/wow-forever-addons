// What the player chooses on the chat's settings page.
import Game from "$game"
import { WINDOW_MIN_WIDTH } from "Ordaen"

// How a channel's line names its channel: by number («[2]»), by name («[Trade]») or both («[2. Trade]»); the zone
// after the name is left out either way.
public enum ChannelName implements Plain { Number = "number", Name = "name", Both = "both" }

// The chat's least width (in dp): a window's least body, Ordaen's `WINDOW_MIN_WIDTH`, which holds two of its tabs and
// the «Copy» beside them.
public const LEAST_WIDTH: Integer = (WINDOW_MIN_WIDTH / 1dp).ceil()

public struct Choices implements Plain {
  // The chat's size.
  width: Number
  height: Number
  // Seconds a line shows before it fades; 0: lines never fade.
  fade: Integer
  channelName: ChannelName
  // Words (comma-separated) that mark someone else's line, beside the player's own name.
  keywords: String
  // The same sender's same words one after another are one line with «×N».
  repeats: Boolean
  // Lines of each tab kept after a reload; 0 keeps none.
  kept: Integer
  // Lines each tab holds this session.
  held: Integer
  // The arrows alone bring back what was sent (off: Alt and the arrows do).
  plainArrows: Boolean
  // What the input's history keeps of what is sent.
  history: Game.ChatHistory
  // The input always shown under the lines (off: from Enter to the line sent).
  inputAlways: Boolean
}
