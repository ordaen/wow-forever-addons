// A pane of the chat: its tabs a sidebar, a line between them and the open tab's lines (the way back to the latest
// over their corner), and under the lines the room of the game's input, which shows there while it is open, dressed in
// a field's look. The chat's own pane holds the docked windows; each window the player undocked is a pane of its own,
// holding that window alone, with no input. Whispers are Ordaen Social's.
import Client from "$client"
import Game from "$game"
import { Align, Edges, Event, Frame, Layer, Line, MouseButton, Over, Overflow, Position, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, FIELD_EDGE, FIELD_FILL, GripCorner, Menu, MenuEntry, SECONDARY_TEXT, SizeGrip } from "Ordaen"
import root Quests from "OrdaenQuests"
import { ChatTab, Entry } from "@/lines"
import Locale from "@/locales"
import { Row, TabButton } from "@/view"

// A message's lines stand closer than the body's (`BODY_LINE`), and messages apart by the chat's setting: each
// reads as one.
const LINE: Number<Spacing> = 5sp
// Lines drawn at most: more than the tallest chat shows.
const ROWS = 80
// Lines a turn of the wheel scrolls.
const STEP = 3
const LINK: Color = Color.hex("#69ccf0")
const MAX: "max-content" = "max-content"
// The lines' least width: some sixty letters of the body's font, so a line doesn't break every few words. The chat
// stands wider than the player chose where its tabs and this need it.
const LINES_LEAST = 480dp
// The lines take all the frame's height.
const ALL: Array<Track> = [{ fr: 1 }]
// The lines' frame takes the height the input's room under it leaves.
const FRAME_AND_INPUT: Array<Track> = [{ fr: 1 }, "max-content"]
// The game's input, as high as its template makes it (FloatingChatFrame.xml): an embed is the size it is given, and
// the input's room is this high whether it shows or not.
const GAME_INPUT = 32ui
// From the frame's line to what it holds.
const ROOM: Edges = { top: 2sp, right: 3sp, bottom: 2sp, left: 3sp }
// The input's field: its text in from the edge as a field's is.
const INPUT_PAD: Edges = { right: 1sp, left: 1sp }
// The room of the field's edge, which the field's surface draws over the input's box.
const INPUT_EDGE: Line = { width: FIELD_EDGE.width, color: Color.hex("#00000000") }

// What a tab's right-click menu offers: the mouse through its lines or not (the game's «Make uninteractable»), a docked
// window undocked, an undocked one docked again.
public enum TabAction {
  Rename = "rename", Settings = "settings", New = "new", Lock = "lock"
  Interactable = "interactable", Undock = "undock", Dock = "dock", Close = "close"
}

// What a link's right-click menu offers (`actionsFor`): a player's name, whom to whisper, invite, ask about, befriend,
// ignore, or the game's own menu of them (`More`); a quest of the log, tracked or not, shared, abandoned; and any
// link's name copied.
public enum LinkAction {
  Whisper = "whisper", Invite = "invite", Who = "who", Befriend = "befriend", Ignore = "ignore", More = "more"
  ShowInLog = "showInLog", ShowOnMap = "showOnMap", Track = "track", Untrack = "untrack", Share = "share"
  Abandon = "abandon", Copy = "copy"
}

const NAME_ACTIONS: Array<LinkAction> = [.Whisper, .Invite, .Who, .Befriend, .Copy, .Ignore, .More]

// A tab's menu asked for: the tab, and what was picked.
public struct TabPick {
  tab: ChatTab
  action: TabAction
}

// A link's menu asked for: the link, and what was picked.
public struct LinkPick {
  link: Event.Link
  action: LinkAction
}

// What a link's menu offers: a name's actions; a quest's, shown in Ordaen Quests' log and on the map where it is on,
// and the log's own where the log holds it, as it stands there; and its name copied.
function actionsFor(link: Event.Link | nil): Array<LinkAction> {
  if (link == nil) { return [] }
  if (nameOf(link.link) != nil) { return NAME_ACTIONS }
  const actions: Array<LinkAction> = []
  const id = questOf(link.link)
  if (id != nil && Quests != nil) {
    actions.push(.ShowInLog)
    actions.push(.ShowOnMap)
  }
  const logged = id != nil ? Game.questLog.quests().find(quest => quest.id == id) : nil
  if (logged != nil) {
    actions.push(logged.tracked ? .Untrack : .Track)
    if (logged.shareable) { actions.push(.Share) }
    actions.push(.Abandon)
  }
  actions.push(.Copy)
  return actions
}

// A quest link's quest (`quest:123:...`).
public function questOf(link: String): Integer | nil {
  return link.match("^quest:(%d+)")?.toNumber()?.floor()
}

// What a link shows, without its brackets: a name, an item's, a quest's title.
public function shownName(link: Event.Link): String {
  return nameOf(link.link) ?? link.text.match("|h%[(.-)%]|h") ?? link.text
}

// What a tab's menu offers it: undocking a docked window but the first, docking an undocked one.
function actionsOf(tab: ChatTab | nil): Array<TabAction> {
  const actions: Array<TabAction> = [.Rename, .Settings, .New, .Lock, .Interactable]
  if (tab != nil && tab.docked && tab.window > 1) { actions.push(.Undock) }
  if (tab != nil && !tab.docked) { actions.push(.Dock) }
  actions.push(.Close)
  return actions
}

// The player's name in a link (`player:Thrall-Realm:7`).
public function nameOf(link: String): String | nil {
  return link.match("^player:([^:]+)")
}

public class Pane implements Component {
  public picked: Event<ChatTab> = new Event()
  public tabPicked: Event<TabPick> = new Event()
  public linkPicked: Event<LinkPick> = new Event()
  // A link clicked with the left button (a name's with Alt invites).
  public link: Event<Event.Link> = new Event()
  // The grip in the lines' top right corner, taken, dragged and let go.
  public sizeGrab: Event<Event.Drag> = new Event()
  public size: Event<Event.Drag> = new Event()
  public sizeDrop: Event<nil> = new Event()

  derived open: ChatTab | nil = self.tabs.find(tab => tab.key == self.openKey) ?? self.tabs[1]
  // Lines scrolled back from the newest.
  public state back = 0
  // The cursor on the tabs, on the lines.
  state onTabs = false
  state onLines = false
  // The tab whose menu is open, and the link whose menu is open.
  state menuTab: ChatTab | nil = nil
  state menuLink: Event.Link | nil = nil

  // The lines' row: the height the player chose at least, more where the tabs stand taller.
  derived rows: Array<Track> = [{ fr: 1, min: self.height }]
  derived logFrame: any Frame | nil = self.logOf()
  // The tabs' top where the lines' frame's metal begins: its art reaches this far above it, inside its box.
  derived tabsReach: Number<Length> = Ordaen.art.frame.small.reach.top * Ordaen.art.frame.small.scale * 1ui
  derived shown: Array<Entry> = self.shownOf()
  derived inputShown: Boolean = self.input != nil && (self.typing || self.inputAlways)
  // Whole while the cursor is on it, the player types or a menu of it is open; else as the settings say.
  derived opacity: Number = self.onTabs || self.onLines || self.typing || self.menuTab != nil || self.menuLink != nil ?
    1 :
    self.awayOpacity
  derived tabActions: Array<TabAction> = actionsOf(self.menuTab)
  derived tabEntries: Array<MenuEntry> = self.tabEntriesOf()
  // The open tab's lines let the mouse through (the game's «Make uninteractable»).
  derived clickThrough: Boolean = self.open?.uninteractable == true
  // The open link menu's actions, read as it opens; a name's `More` and a link's `Copy` a group of their own.
  derived linkActions: Array<LinkAction> = actionsFor(self.menuLink)
  derived menuTitle: String = self.menuLink != nil ? shownName(self.menuLink ?? panic("titled while open")) : ""
  // The map isn't opened in a fight: the client lets no addon open it there.
  derived linkEntries: Array<MenuEntry> = self.linkActions.map(action => MenuEntry {
    label: linkLabel(action), on: nil, disabled: action == LinkAction.ShowOnMap && Game.situation.combat,
    group: action == LinkAction.Copy || action == LinkAction.More || action == LinkAction.Track || action == LinkAction.Untrack, more: nil
  })

  tabs: Signal<Array<ChatTab>>
  openKey: Signal<String>
  width: Signal<Number<Length>>
  height: Signal<Number<Length>>
  awayOpacity: Signal<Number>
  textSize: Signal<Number<TextSize>>
  between: Signal<Number<Spacing>>
  input: Signal<any Frame | nil>
  typing: Signal<Boolean>
  inputAlways: Signal<Boolean>
  constructor(
    tabs: Signal<Array<ChatTab>>,
    // The tab shown: its key.
    openKey: Signal<String>,
    width: Signal<Number<Length>>,
    height: Signal<Number<Length>>,
    // How much of it shows while the cursor is off it (1: all of it).
    awayOpacity: Signal<Number>,
    // The lines' text size.
    textSize: Signal<Number<TextSize>>,
    // The room between messages.
    between: Signal<Number<Spacing>>,
    // The input it holds (nil: none; Enter opens the chat's), shown while the player types or always.
    input: Signal<any Frame | nil> = nil,
    typing: Signal<Boolean> = false,
    inputAlways: Signal<Boolean> = false
  ) {
    self.tabs = tabs
    self.openKey = openKey
    self.width = width
    self.height = height
    self.awayOpacity = awayOpacity
    self.textSize = textSize
    self.between = between
    self.input = input
    self.typing = typing
    self.inputAlways = inputAlways
    Game.chat.scrolled.listen(self.onScrolled)
  }

  // The chat's keys scroll the game's chosen window: the pane whose open tab is it scrolls a line, a page (as many
  // lines as its height holds) or to an end.
  onScrolled(mut self, window: Integer, scroll: Game.ChatScroll) {
    const tab = peek self.open
    if (tab == nil || tab.window != window) { return }
    const most = (0).max(tab.lines.length - 1)
    const page = ((peek self.height) / Ordaen.lengthOf(LINE + peek self.between)).floor().max(1)
    const back = peek self.back
    self.back = match (scroll) {
      .LineUp => most.min(back + 1)
      .LineDown => (0).max(back - 1)
      .PageUp => most.min(back + page)
      .PageDown => (0).max(back - page)
      .Top => most
      .Bottom => 0
    }
  }

  logOf(self): any Frame | nil {
    const tab = self.open
    if (tab == nil || !tab.combatLog) { return nil }
    return Game.chat.windows.find(window => window.index == tab.window)?.frame
  }

  shownOf(self): Array<Entry> {
    const tab = self.open
    // The lines change in place: their version is what tells the view.
    if (tab == nil || tab.version < 0) { return [] }
    return tab.slice(self.back, ROWS)
  }

  tabEntriesOf(self): Array<MenuEntry> {
    const tab = self.menuTab
    return self.tabActions.map(action => MenuEntry {
      label: tabLabel(action, tab?.uninteractable == true), on: action == TabAction.Lock ? tab?.locked == true : nil,
      disabled: action == TabAction.Close && (tab?.window ?? 0) <= 2, group: action == TabAction.Close, more: nil
    })
  }

  onPick(mut self, tab: ChatTab) {
    self.back = 0
    self.picked.emit(tab)
  }

  onMenu(mut self, tab: ChatTab) { self.menuTab = tab }

  onTabPick(mut self, place: Integer) {
    const tab = peek self.menuTab
    const action = (peek self.tabActions)[place]
    self.menuTab = nil
    if (tab != nil && action != nil) { self.tabPicked.emit({ tab: tab, action: action }) }
  }

  onTabMenuClose(mut self) { self.menuTab = nil }

  onLinkPick(mut self, place: Integer) {
    const link = peek self.menuLink
    const action = (peek self.linkActions)[place]
    self.menuLink = nil
    if (link != nil && action != nil) { self.linkPicked.emit({ link: link, action: action }) }
  }

  onLinkMenuClose(mut self) { self.menuLink = nil }

  // The right button opens a link's menu; Alt and the left button on a name invite the player; any other click goes
  // on.
  onLink(mut self, link: Event.Link) {
    if (link.button == MouseButton.Right) {
      self.menuLink = link
      return
    }
    if (nameOf(link.link) != nil && link.button == MouseButton.Left && Client.IsAltKeyDown()) {
      self.linkPicked.emit({ link: link, action: LinkAction.Invite })
      return
    }
    self.link.emit(link)
  }

  // The wheel scrolls three lines; with Shift, to the oldest or the newest.
  onWheel(mut self, wheel: Event.Wheel) {
    const tab = peek self.open
    if (tab == nil) { return }
    const most = (0).max(tab.lines.length - 1)
    const shift = Client.IsShiftKeyDown()
    if (wheel.direction == .Up) {
      self.back = shift ? most : most.min((peek self.back) + STEP)
    } else {
      self.back = shift ? 0 : (0).max((peek self.back) - STEP)
    }
  }

  onLatest(mut self) { self.back = 0 }

  onSizeGrab(mut self, drag: Event.Drag) { self.sizeGrab.emit(drag) }
  onSize(mut self, drag: Event.Drag) { self.size.emit(drag) }
  onSizeDrop(mut self) { self.sizeDrop.emit() }

  onTabsEnter(mut self) { self.onTabs = true }
  onTabsLeave(mut self) { self.onTabs = false }
  onLinesEnter(mut self) { self.onLines = true }
  onLinesLeave(mut self) { self.onLines = false }

  public render(self): Template {
    return $ltml {
      // The tabs a sidebar on the world at the frame's left, one a row; the lines in the window's frame and wood, at
      // least the height the player chose and never lower than the tabs, the input's room under them. As wide as the player
      // chose, or as the tabs and the lines' least need.
      <box width={{ min: self.width, max: nil }} columns={[MAX, { fr: 1 }]} opacity={self.opacity}>
        // From the frame's metal down, not the reach of its art above it.
        <box columns={1} yAlignSelf={Align.Start} @pointerEnter={self.onTabsEnter} @pointerLeave={self.onTabsLeave}>
          <box height={self.tabsReach} />
          <TabButton $for={tab of self.tabs} tab={tab} open={tab.key == self.open?.key} @pick={self.onPick}
                     @menu={self.onMenu} />
          <Menu $if={self.menuTab != nil} entries={self.tabEntries} title={self.menuTab?.title ?? ""} @pick={self.onTabPick}
                @close={self.onTabMenuClose} />
        </box>
        // The lines' frame, and under it the input's room.
        <box rows={FRAME_AND_INPUT} gap={1sp} yAlignSelf={Align.Stretch}>
          // Over the sidebar: its left line stands over the open tab's open end, one shape with it.
          <box rows={ALL} yAlignSelf={Align.Stretch} border={Ordaen.art.frame.small} background={Ordaen.art.window.wood}
               artOrigin={true} padding={ROOM} zLevel={3} @pointerEnter={self.onLinesEnter} @pointerLeave={self.onLinesLeave}>
            // The chat stands by its bottom left: it grows to the right and up, by the grip in this corner.
            <box position={Position.Absolute} top={0ui} right={0ui} zLevel={3}>
              <SizeGrip corner={GripCorner.TopRight} @grab={self.onSizeGrab} @drag={self.onSize} @drop={self.onSizeDrop} />
            </box>
            <box width={{ min: LINES_LEAST, max: nil }} rows={self.rows} yAlignSelf={Align.Stretch}>
              <embed $if={self.logFrame != nil} frame={self.logFrame ?? panic("shown with the frame")} />
              // The newest line stands at the bottom; older ones go up past the top, which cuts them.
              <box $else overflow={Overflow.Hidden} textSize={self.textSize} mouseThrough={self.clickThrough} @wheel={self.onWheel}>
                <box position={Position.Absolute} left={0ui} right={0ui} bottom={0ui} columns={1} lineHeight={LINE}
                     gap={self.between}>
                  <Row $for={entry of self.shown} line={entry.line} opens={entry.opens} stamp={entry.stamp}
                       lineHeight={Ordaen.lengthOf(LINE)}
                       @link={self.onLink} />
                </box>
              </box>
              // While scrolled back, the way back, over the lines' bottom right corner: nothing moves for it.
              <box $if={self.back > 0} position={Position.Absolute} right={0ui} bottom={0ui} zLevel={2} @pointerPress={self.onLatest}>
                <text value={Locale.LATEST} textColor={LINK} textSize={SECONDARY_TEXT} wrap={.None} />
              </box>
              <Menu $if={self.menuLink != nil} entries={self.linkEntries} title={self.menuTitle} @pick={self.onLinkPick}
                    @close={self.onLinkMenuClose} />
            </box>
          </box>
          // The game's input while it is open, in a field's floor and edge, in a room of its own height under the lines,
          // kept whether it shows or not: nothing moves as it comes and goes, and the placing mode's outline holds it.
          // The field is a surface over the input's box, on the game input's own layer, and the input stands inside it:
          // a frame takes its parent's stratum, so the field's floor is under the input's text, never over it, and a
          // window over the chat's corner covers both or neither.
          <box $if={self.input != nil} border={INPUT_EDGE} padding={INPUT_PAD}>
            <surface $if={self.inputShown} layer={Layer.Dialog} place={Over { over: "parent" }} background={FIELD_FILL}
                     border={FIELD_EDGE} padding={INPUT_PAD}>
              <embed frame={self.input ?? panic("shown with the input")} height={GAME_INPUT} />
            </surface>
            <box height={GAME_INPUT} />
          </box>
        </box>
      </box>
    }
  }
}

// An entry's words: the game's own where its tab menu has them (undock, the mouse through the lines or not).
function tabLabel(action: TabAction, uninteractable: Boolean): String {
  return match (action) {
    .Rename => Locale.TAB_RENAME
    .Settings => Locale.TAB_SETTINGS
    .New => Locale.TAB_NEW
    .Lock => Locale.TAB_LOCK
    .Interactable => uninteractable ? Client.MAKE_INTERACTABLE : Client.MAKE_UNINTERACTABLE
    .Undock => Client.UNDOCK_WINDOW
    .Dock => Locale.TAB_DOCK
    .Close => Locale.TAB_CLOSE
  }
}

function linkLabel(action: LinkAction): String {
  return match (action) {
    .Whisper => Locale.NAME_WHISPER
    .Invite => Locale.NAME_INVITE
    .Who => Locale.NAME_WHO
    .Befriend => Locale.NAME_BEFRIEND
    .Ignore => Locale.NAME_IGNORE
    .More => Locale.NAME_MORE
    .ShowInLog => Locale.QUEST_SHOW_IN_LOG
    .ShowOnMap => Locale.QUEST_SHOW_ON_MAP
    .Track => Locale.QUEST_TRACK
    .Untrack => Locale.QUEST_UNTRACK
    .Share => Locale.QUEST_SHARE
    .Abandon => Locale.QUEST_ABANDON
    .Copy => Locale.LINK_COPY
  }
}
