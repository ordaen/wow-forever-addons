test "a quest of the log's link has a menu: tracked or not, abandoned once the player says so" {
  Test::questLog([{ id: 101, title: "One", header: "Westfall" }])
  Game::chat.windows = gameWindows()
  const shown = chat()
  Game::chat.heard.emit(line("SAY", "|Hquest:101:10|h[One]|h", "Thrall", [1]))
  const said = shown.text("|Hquest:101:10|h[One]|h")
  said.clickLink("quest:101:10", .Right)
  // Shared only while the player can share it: in a group.
  Test::expect(Test::page().text("Track").shown() && !Test::page().text("Share").shown())
  Test::page().text("Track").click()
  said.clickLink("quest:101:10", .Right)
  Test::expect(Test::page().text("Stop tracking").shown())
  Test::page().text("Abandon").click()
  Test::expect(Test::page().text("Abandon «One»?").shown())
  Test::page().button("Cancel").click()
  Test::expect(Game::questLog.quests().any(quest => quest.id == 101))
  said.clickLink("quest:101:10", .Right)
  Test::page().text("Abandon").click()
  Test::page().window("Abandon «One»?").button("Abandon").click()
  Test::expect(!Game::questLog.quests().any(quest => quest.id == 101))
}

