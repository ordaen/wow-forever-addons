  Test.expect(!Test.page().window("General").text("Jaina").shown())
}

// A window's groups as the game's side gives them, the ones a test names.
function groupsOf(shown: Map<String, Boolean>): Array<Game.ChatGroup> {
  const labels: Map<String, String> = {
    SAY: "Say", MONSTER_SAY: "Say", YELL: "Yell", PARTY: "Party", PARTY_LEADER: "Party Leader", RAID: "Raid",
    RAID_LEADER: "Raid Leader", RAID_WARNING: "Raid Warning", LOOT: "Item Loot", ACHIEVEMENT: "Achievement",
    GUILD_ACHIEVEMENT: "Guild Achievement", BG_HORDE: "Horde", BG_ALLIANCE: "Alliance", CHANNEL: "Channel",
    COMMUNITIES_CHANNEL: "COMMUNITIES_CHANNEL", AFK: "AFK"
  }
  const order: Array<String> = [
    "SAY", "YELL", "PARTY", "PARTY_LEADER", "RAID", "RAID_LEADER", "RAID_WARNING", "MONSTER_SAY", "LOOT", "ACHIEVEMENT",
    "GUILD_ACHIEVEMENT", "BG_HORDE", "BG_ALLIANCE", "CHANNEL", "COMMUNITIES_CHANNEL", "AFK"
  ]
  return order.map(name => Game.ChatGroup { name: name, label: labels[name] ?? name, shown: shown[name] == true })
}

// The game's windows, and a fourth the game opens as it is asked for one: showing say as a new window does, and
// the guild, as it is told to. The client refuses the first `refused` windows asked for, as it does while it loads.
function guildOpening(refused: Integer) {
  const general = window(1, "General", "")
  const jaina = window(3, "Whisper", "Jaina")
  const guild = window(4, "Guild", "")
  let asked = 0
  Game.chat.windows = [general, jaina]
  Game.chat.groups = (index: Integer): Array<Game.ChatGroup> => index == 4 ? [{ name: "SAY", label: "Say", shown: true }, { name: "GUILD", label: "Guild", shown: true }] : []
  Game.chat.open = (name: String): Integer | nil => {
    Test.asked("Chat.open", name)
    asked += 1
    if (asked <= refused) { return nil }
    Game.chat.windows = [general, jaina, guild]
    return 4
  }
}

// The game's windows load, and the game's own handlers of the event have their turn.
function windowsLoad() {
  Events.UPDATE_CHAT_WINDOWS.emit()
  Test.pass(0.01)
}

function guildAsked(): Boolean { return Test.requests().any(r => r == "Chat.open Guild") }

test "a character's chat gets a tab of the guild's lines once its windows load, after the game's own handlers" {
  guildOpening(0)
  _ = chat()
  Events.UPDATE_CHAT_WINDOWS.emit()
  // Not in the event itself: the game lays its saved windows over what was opened before its handler.
  Test.expect(!guildAsked())
  Test.pass(0.01)
  const asked = Test.requests()
  Test.expect(asked.any(r => r == "Chat.open Guild"))
  // The new window shows the guild's and its officers' lines and nothing else.
  Test.expect(asked.any(r => r == "Chat.showGroup 4 SAY false"))
  Test.expect(asked.any(r => r == "Chat.showGroup 4 GUILD true") && asked.any(r => r == "Chat.showGroup 4 OFFICER true"))
}

test "a guild's tab the game's load closed is opened again; once a later load finds it, closed it stays closed" {
  guildOpening(0)
  _ = chat()
  windowsLoad()
  Test.expect(guildAsked())
  // The game's saved windows laid over it: gone.
  Game.chat.windows = gameWindows()
  windowsLoad()
  Test.expect(guildAsked())
  // Found by the next load: done.
  windowsLoad()
  Test.expect(!guildAsked())
  Game.chat.windows = gameWindows()
  windowsLoad()
  Events.PLAYER_ENTERING_WORLD.emit(false, true)
  Test.pass(0.01)
  Test.expect(!guildAsked())
}

test "a guild's tab the client refused while it loads its windows is asked for again as the player enters the world" {
  guildOpening(1)
  _ = chat()
  windowsLoad()
  Test.expect(guildAsked())
  Events.PLAYER_ENTERING_WORLD.emit(true, false)
  Test.pass(0.01)
  Test.expect(guildAsked())
  Test.expect(Game.chat.windows.any(each => each.index == 4))
}

test "a character's chat gets a tab of its channels once it is in some, and General leaves them to it" {
  // The guild's tab is there already (window 3): only the channels' is asked for.
  let joined: Array<Game.ChatShown> = []
  Game.chat.windows = gameWindows()
  Game.chat.groups = (index: Integer): Array<Game.ChatGroup> => index == 3 ? [{ name: "GUILD", label: "Guild", shown: true }] : []
  Game.chat.channels = (index: Integer): Array<Game.ChatShown> => index == 1 ? joined : index == 5 ? [{ name: "General", shown: false }] : []
  Game.chat.open = (name: String): Integer | nil => {
    Test.asked("Chat.open", name)
    return 5
  }
  _ = chat()
  windowsLoad()
  // In no channel yet: the tab waits for them.
  Test.expect(!Test.requests().any(r => r == "Chat.open Channels"))
  joined = [{ name: "General", shown: true }, { name: "Trade", shown: true }]
  Events.CHANNEL_UI_UPDATE.emit()
  Test.pass(0.01)
  const asked = Test.requests()
  Test.expect(asked.any(r => r == "Chat.open Channels") && asked.any(r => r == "Chat.showGroup 5 CHANNEL true"))
  Test.expect(asked.any(r => r == "Chat.showChannel 5 General true"))
  Test.expect(asked.any(r => r == "Chat.showChannel 1 General false") && asked.any(r => r == "Chat.showChannel 1 Trade false"))
}

test "no guild's tab is made where a window past the game's two shows the guild already" {
  Game.chat.windows = gameWindows()
  Game.chat.groups = (index: Integer): Array<Game.ChatGroup> => index == 3 ? [{ name: "GUILD", label: "Guild", shown: true }] : []
  _ = chat()
  windowsLoad()
  Test.expect(!guildAsked())
}

// A letter of the line's against a letter of the tab's name, Ordaen's body text.
function lineToName(shown: Test.Part): Number {
  const said = shown.text("[Thrall] says: Hello").letters()
  const name = shown.text("General").letters()
  return ((said.right - said.left) / 20) / ((name.right - name.left) / 7)
}

test "the lines are Ordaen's body text, as every module's, whatever font size the game's window has" {
  Game.chat.windows = [window(1, "General", "", true, 18)]
  const shown = chat()
  Game.chat.heard.emit(line("SAY", "[Thrall] says: Hello", "Thrall", [1]))
  Test.expect((lineToName(shown) - 1).abs() < 0.005)
}

test "the chat's own text size, where the player turns it on, is the lines' for the whole chat" {
  Game.chat.windows = gameWindows()
  _ = chat()
  Game.chat.heard.emit(line("SAY", "[Thrall] says: Hello", "Thrall", [1]))
  Test.open("/ordaen")
  const settings = Test.page().window("Move mode")
  settings.button("Chat").click()
  // The page's switches that are off: hiding, the own text size, the input always shown.
  settings.button(Ordaen.art.ctl.switchOff).nth(2).click()
  Test.expect(settings.text("Text size").shown())
  // The size's slider, at the body's 14 until changed, two steps down by its − (the page's last).
  const less = settings.text("-")
  less.nth(less.count()).click()
  less.nth(less.count()).click()
  // Found by its line: the settings window names «General» too.
  Test.expect((lineToName(Test.page().window("[Thrall] says: Hello")) - 12 / 14).abs() < 0.005)
}

test "the tabs begin where the lines' frame's metal does, not where its art's reach does" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  const frame = shown.box(Ordaen.art.window.wood).rect()
  const reach = Ordaen.art.frame.small.reach.top * Ordaen.art.frame.small.scale
  Test.expect((shown.box(TAB_SHADE).rect().top - frame.top - reach).abs() < 0.5)
}

test "the Tabs page lists the windows in a sidebar; the picked one's speech, channels, communities and system messages" {
  Game.chat.windows = gameWindows()
  Game.chat.groups = (index: Integer): Array<Game.ChatGroup> => groupsOf({ SAY: true, MONSTER_SAY: true, PARTY: true, PARTY_LEADER: true, LOOT: true })
  _ = chat()
  const settings = tabsPage()
  Test.expect(["Speech", "Channels", "Communities", "System"].all(title => settings.text(title).shown()))
  Test.expect(settings.text("Whisper").rect().left < settings.text("Speech").rect().left)
  // A kind of speech is one row over its groups: a party's leader, a raid's warning go with it; NPCs' say with say.
  Test.expect(!settings.text("Party Leader").shown() && !settings.text("Raid Warning").shown())
  Test.expect(settings.text("Item Loot").rect().top > settings.text("Communities").rect().top)
  // Say: the players' and the NPCs' lines; Yell: neither.
  Test.expect(settings.text("All").shown() && settings.text("None").shown())
  // The raid's check: the raid, its leader and its warnings.
  settings.button(Ordaen.art.ctl.check).nth(2).click()
  const asked = Test.requests()
  Test.expect(["RAID", "RAID_LEADER", "RAID_WARNING"].all(name => asked.any(r => r == `Chat.showGroup 1 ${name} true`)))
  // Say's players alone: the NPCs' lines go.
  settings.text("All").click()
  Test.page().text("Players").click()
  const said = Test.requests()
  Test.expect(said.any(r => r == "Chat.showGroup 1 SAY true") && said.any(r => r == "Chat.showGroup 1 MONSTER_SAY false"))
  Test.expect(!said.any(r => r == "Chat.showGroup 1 MONSTER_WHISPER false"))
  // Another window picked: its own rows.
  settings.text("Whisper").click()
  settings.button(Ordaen.art.ctl.check).nth(2).click()
  Test.expect(Test.requests().any(r => r == "Chat.showGroup 3 RAID true"))
}

test "the system messages stand in sections, the rest of the client's groups under Game; the communities' group is no row" {
  Game.chat.windows = gameWindows()
  Game.chat.groups = (index: Integer): Array<Game.ChatGroup> => groupsOf({ BG_HORDE: true, BG_ALLIANCE: true, AFK: true })
  _ = chat()
  const settings = tabsPage()
  Test.expect(["Progress", "Loot", "Battlegrounds", "Game"].all(title => settings.text(title).shown()))
  // The achievements' choice, the battlegrounds' one row, the channels' notices under Channels.
  Test.expect(settings.text("Achievements").shown() && settings.text("Battleground announcements").shown())
  Test.expect(!settings.text("Horde").shown() && !settings.text("COMMUNITIES_CHANNEL").shown())
  Test.expect(settings.text("Channel notices").rect().top < settings.text("Communities").rect().top)
  // A group no row covers: under Game, in the game's words.
  Test.expect(settings.text("AFK").rect().top > settings.text("Game").rect().top)
  // The guild's achievements alone.
  // Say's, Yell's and the achievements' choices each read None; the page scrolled down to the third.
  for (i of 1..6) { settings.text("Speech").wheel(-1) }
  settings.text("None").nth(3).click()
  Test.page().text("Guild").click()
  const picked = Test.requests()
  Test.expect(picked.any(r => r == "Chat.showGroup 1 ACHIEVEMENT false") && picked.any(r => r == "Chat.showGroup 1 GUILD_ACHIEVEMENT true"))
  // The battlegrounds' row turns each faction's group off: the fifth check (Party, Raid, the channels' notices, Loot).
  for (i of 1..6) { settings.text("Progress").wheel(-1) }
  settings.button(Ordaen.art.ctl.check).nth(5).click()
  const news = Test.requests()
  Test.expect(news.any(r => r == "Chat.showGroup 1 BG_HORDE false") && news.any(r => r == "Chat.showGroup 1 BG_ALLIANCE false"))
}

