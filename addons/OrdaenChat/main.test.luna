// The chat as the player meets it: the game's lines in Ordaen's frame, its windows and streams as tabs, the game's
// input under them. The fake game's chat hands it lines (`Game.chat.heard.emit`), its windows and its streams.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Key } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import { BODY_TEXT, ChatMark, FIELD_FILL, GROUND, GROUND_ROUND, say } from "Ordaen"
import root Quests from "OrdaenQuests"
import root Social from "OrdaenSocial"
import { LEAST_WIDTH, MESSAGE_GAP } from "@/choices"
import { ChatTab, Kept, Shown, StampShown, THIS_SESSION, linked, marks, wordsOf } from "@/lines"

const SCREEN: Test::Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const WHITE: Color = Color::hex("#ffffff")
// The shade a tab stands on, open or under the cursor.
const TAB_SHADE: Color = Color::hex("#00000059")
// The unread count's plain fill.
const COUNT_FILL: Color = Color::hex("#9b2c1f")
// The input's field's lit edges.
const INPUT_LIT: Color = Color::hex("#8c6a3f")

function window(index: Integer, name: String, partner: String, docked: Boolean = true, fontSize: Number = 13, combatLog: Boolean = false): Game::ChatWindow {
  // Hidden while its input is made, as the game parks its windows.
  const frame = Client::CreateFrame("Frame", `ChatFrame${index}`, Client::C_UI::GetUIParent(), nil)
  frame.Hide()
  return {
    index: index, name: name, fontSize: fontSize, partner: partner, combatLog: combatLog, docked: docked, shown: true,
    locked: false, uninteractable: false, frame: frame, input: input(frame)
  }
}

// A window's input, as the client's template makes it: never taking the keyboard by itself.
function input(parent: any Client::Frame): any Client::EditBox {
  const made = new Client::EditBox(parent)
  made.SetAutoFocus(false)
  return made
}

// A line said by someone, shown in the windows given.
function line(kind: String, body: String, sender: String, windows: Array<Integer>, channel: Integer = 0, channelName: String = ""): mut Game::ChatLine {
  return {
    kind: kind, event: `CHAT_MSG_${kind}`, body: body, plain: body, text: body, sender: sender, guid: "", lineId: 1, channel: channel,
    channelName: channelName, stream: "", color: WHITE, time: Game::clock.server, stamp: "", windows: windows, secret: ""
  }
}

// The game's General and a whisper window.
function gameWindows(): Array<Game::ChatWindow> { return [window(1, "General", ""), window(3, "Whisper", "Jaina")] }

// A whisper heard (or told, by the player): its words alone are what its bubble shows.
function whisper(sender: String, words: String, told: Boolean = false): mut Game::ChatLine {
  const said = line(told ? "WHISPER_INFORM" : "WHISPER", `[${sender}] whispers: ${words}`, sender, [1])
  said.text = words
  return said
}

// The «Tabs» page opened in the settings window.
function tabsPage(): Test::Part {
  Test::open("/ordaen")
  const settings = Test::page().window("Move mode")
  settings.button("Chat").click()
  settings.button("Tabs").click()
  return settings
}

// The chat mounted, found by its first tab.
function chat(first: String = "General"): Test::Part {
  Test::mount(nil, SCREEN)
  return Test::page().window(first)
}

test "the chat reads the game's lines and shows them in the window's tab, nothing under them until Enter" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  Game::chat.heard.emit(line("SAY", "[Thrall] says: Hello", "Thrall", [1]))
  Test::expect(shown.text("[Thrall] says: Hello").shown())
  // Its two tabs and the line: no hint, no button of the game's, no «Copy».
  Test::expect(shown.texts().join(",") == "General,Jaina,[Thrall] says: Hello")
}

test "the open tab stands on the lines' own ground, the one under the cursor on a shade, each touching the lines" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  const name = shown.text("General").rect()
  Test::expect(shown.box(Ordaen.art.window.wood).count() == 0)
  Test::expect(shown.box(TAB_SHADE).count() == 0 && standsOn(shown, "General", GROUND))
  shown.text("Jaina").click()
  Test::expect(standsOn(shown, "Jaina", GROUND) && !standsOn(shown, "General", GROUND))
  // A tab keeps its place, open or not.
  Test::expect(shown.text("General").rect().left == name.left)
  // Under the cursor, another tab stands on a shade.
  shown.text("General").hover()
  Test::expect(standsOn(shown, "General", TAB_SHADE) && standsOn(shown, "Jaina", GROUND))
  // The open tab's ground and the shade run up to the lines' ground: no gap.
  const lines = ground(shown)
  Test::expect((under(shown, "Jaina", GROUND).right - lines.left).abs() < 0.5)
  Test::expect((under(shown, "General", TAB_SHADE).right - lines.left).abs() < 0.5)
  // No list's own shade or light of its own over a tab.
  Test::expect(shown.box(Color::hex("#00000040")).count() == 0 && shown.box(Color::hex("#d6a56b")).count() == 0)
}

// The lines' dark ground, whole: its middle part, the widest of the boxes of its colour (the open tab's ground is one
// too), runs from top to bottom, a corner's round in from each side.
function ground(shown: Test::Part): Test::Rect {
  const parts = shown.box(GROUND)
  let middle = parts.nth(1).rect()
  for (n of 2..parts.count()) {
    const part = parts.nth(n).rect()
    if (part.right - part.left > middle.right - middle.left) { middle = part }
  }
  const round = GROUND_ROUND / 1ui
  return { left: middle.left - round, top: middle.top, right: middle.right + round, bottom: middle.bottom }
}

function inBox(box: Test::Rect, at: Test::Rect): Boolean {
  return box.left <= at.left && box.right >= at.right && box.top <= at.top && box.bottom >= at.bottom
}

// The box of `color` a text stands on, where one is: a tab's ground or shade.
function underOr(shown: Test::Part, text: String, color: Color): Test::Rect | nil {
  const at = shown.text(text).rect()
  const boxes = shown.box(color)
  for (n of 1..boxes.count()) {
    const box = boxes.nth(n).rect()
    if (inBox(box, at)) { return box }
  }
  return nil
}

function standsOn(shown: Test::Part, text: String, color: Color): Boolean { return underOr(shown, text, color) != nil }

function under(shown: Test::Part, text: String, color: Color): Test::Rect {
  return underOr(shown, text, color) ?? panic(`«${text}» stands on no box of that colour`)
}

test "a tab's count stands on a plain fill beside its name, never over it: nothing moves for it" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  const name = shown.text("Jaina").letters()
  const tab = shown.text("Jaina").rect()
  const lines = ground(shown)
  Game::chat.heard.emit(line("SAY", "[Jaina] says: one", "Jaina", [3]))
  const badge = shown.box(COUNT_FILL)
  const one = badge.rect()
  Test::expect(one.left >= name.right && one.top < name.bottom && one.bottom > name.top)
  for (at of 1..98) { Game::chat.heard.emit(line("SAY", `[Jaina] says: ${at}`, "Jaina", [3])) }
  Test::expect(shown.text("99").shown())
  // Wider, still clear of the name; the name, its tab and the lines where they stood.
  const now = shown.text("Jaina").letters()
  Test::expect(badge.rect().left >= now.right)
  Test::expect(now.left == name.left && now.right == name.right)
  const after = shown.text("Jaina").rect()
  Test::expect(after.left == tab.left && after.right == tab.right && after.top == tab.top && after.bottom == tab.bottom)
  Test::expect(ground(shown).left == lines.left)
}

test "messages stand further apart than a message's own lines" {
  Game::chat.windows = playersWindows()
  const shown = chat("Общий")
  const long = "[Thrall] says: a line long enough to fill the whole width of the lines and more, and then some more again and again"
  Game::chat.heard.emit(line("SAY", long, "Thrall", [1]))
  Game::chat.heard.emit(line("SAY", "[Jaina] says: next", "Jaina", [1]))
  const first = shown.text(long).letters()
  const next = shown.text("[Jaina] says: next").letters()
  // The long one takes two lines at least; between it and the next, a gap of 1.5sp (6 dp, 4.3 of the screen's units
  // here) its own lines haven't.
  Test::expect(first.bottom - first.top > (next.bottom - next.top) * 1.5)
  Test::expect(next.top - first.bottom >= 4)
}

test "the lines keep their least width, some sixty letters, however narrow the chat is chosen" {
  Game::chat.windows = playersWindows()
  const shown = chat("Общий")
  Game::chat.heard.emit(line("SAY", "[Thrall] says: a line long enough to fill the whole width of the lines and more, and then some more again", "Thrall", [1]))
  // 480 dp, 341 of the screen's units here (190 dp are 135).
  const said = shown.text("[Thrall] says: a line long enough to fill the whole width of the lines and more, and then some more again").rect()
  Test::expect(said.right - said.left >= 335)
}

test "a line for another tab waits there, counted, until the tab is opened" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  Game::chat.heard.emit(line("SAY", "[Jaina] says: psst", "Jaina", [3]))
  Test::expect(!shown.text("[Jaina] says: psst").shown())
  Test::expect(shown.text("1").shown())
  shown.text("Jaina").click()
  Test::expect(shown.text("[Jaina] says: psst").shown())
  Test::expect(Test::requests().any(r => r == "Chat.choose 3"))
}

// The game opens its input as `ChatFrameUtil.ActivateChat` does (shown, the keyboard's) and tells it typing: it
// stands in the chat's foot, under the lines, as high as the game makes it.
test "a tab clicked keeps no key: Enter goes on to the game's binding, which opens the input" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  shown.text("Jaina").click()
  Test::expect(!Test::key(Key::Enter))
}

test "Enter shows the input line, on the screen, in the chat's frame" {
  Game::chat.windows = gameWindows()
  const box = input(Client::CreateFrame("Frame", nil, Client::C_UI::GetUIParent(), nil))
  box.Hide()
  Game::chat.input = box
  _ = chat()
  Game::chat.heard.emit(line("SAY", "[Thrall] says: here", "Thrall", [1]))
  const shown = Test::page().window("[Thrall] says: here")
  box.Show()
  box.SetFocus()
  Game::chat.typing = true
  Test::pass(0.01)
  const frame = shown.rect()
  const middle = Test::centre(box)
  Test::expect(box.IsVisible() && box.GetHeight() >= 20)
  Test::expect(middle.x > frame.left && middle.x < frame.right && middle.y > frame.top && middle.y < frame.bottom)
  // Over the newest line, at the lines' bottom, drawn over it.
  const newest = shown.text("[Thrall] says: here").rect()
  Test::expect(middle.y > newest.top - 20 && middle.y < frame.bottom)
  // It stands in a field's floor and edge, the chat's own look: a surface over its box, round it.
  const field = Test::page().box(FIELD_FILL)
  Test::expect(field.count() == 1)
  const round = field.rect()
  Test::expect(round.left < middle.x && round.right > middle.x && round.top < middle.y && round.bottom > middle.y)
  // The field's floor is under the input, never over its text: the input takes the field's stratum, a level above it.
  Test::expect(box.GetFrameStrata() == "DIALOG" && box.GetFrameLevel() > field.level())
}

test "the input shows over the bottom of the lines' ground, lit on three sides, and the lines rise to stand above it" {
  Game::chat.windows = gameWindows()
  const box = input(Client::CreateFrame("Frame", nil, Client::C_UI::GetUIParent(), nil))
  box.Hide()
  Game::chat.input = box
  _ = chat()
  for (at of 1..60) { Game::chat.heard.emit(line("SAY", `line ${at}`, "Thrall", [1])) }
  const shown = Test::page().window("General")
  const chatBefore = shown.rect()
  const lines = ground(shown)
  const newest = shown.text("line 60").rect()
  // Scrolled back, the way back stands over the lines; scrolled to the newest again, it goes.
  shown.text("line 60").hover()
  Test::wheel(1)
  Test::expect(shown.text("To the latest").shown())
  Test::expect(shown.rect().bottom == chatBefore.bottom)
  shown.text("To the latest").click()
  box.Show()
  box.SetFocus()
  Game::chat.typing = true
  Test::pass(0.01)
  // The chat (what the placing mode outlines) stays where it was.
  const chatNow = shown.rect()
  Test::expect(chatNow.top == chatBefore.top && chatNow.bottom == chatBefore.bottom && chatNow.right == chatBefore.right)
  // The input stands over the bottom of the lines' ground, inside it, its field lit along its top and both sides; the
  // newest line rose to stand above the field.
  const middle = Test::centre(box)
  const field = Test::page().box(FIELD_FILL).rect()
  Test::expect(Test::page().box(INPUT_LIT).count() == 3)
  const risen = shown.text("line 60").rect()
  Test::expect(risen.bottom < newest.bottom && risen.bottom <= field.top)
  Test::expect(middle.y > (lines.top + lines.bottom) / 2 && middle.y < lines.bottom)
  Test::expect(middle.x > lines.left && middle.x < lines.right)
  // The lines' ground starts at the chat's top: no room is kept over it.
  Test::expect((lines.top - chatNow.top).abs() < 0.5)
}

test "the input's field stands over a game window opened over the chat's corner, as the game's input does" {
  Game::chat.windows = gameWindows()
  const box = input(Client::CreateFrame("Frame", nil, Client::C_UI::GetUIParent(), nil))
  Game::chat.input = box
  Game::chat.typing = true
  _ = chat()
  const field = Test::page().box(FIELD_FILL).rect()
  // A panel of the game's (the bags, the character) over the chat's foot, on the panels' layer.
  const panel = Client::CreateFrame("Frame", nil, Client::C_UI::GetUIParent(), nil)
  panel.SetFrameStrata("MEDIUM")
  panel.SetPoint("BOTTOMLEFT", Client::C_UI::GetUIParent(), "BOTTOMLEFT", 0, 0)
  panel.SetSize(field.right + 50, 900 - field.top + 50)
  panel.EnableMouse(true)
  let pressed = 0
  panel.SetScript("OnMouseDown", (...given: Unknown): nil => {
    pressed += 1
  })
  Test::click({ x: (field.left + field.right) / 2, y: (field.top + field.bottom) / 2 }, nil)
  Test::expect(pressed == 0)
  // Beside the field, the panel is over the chat.
  Test::click({ x: field.left + 2, y: field.top - 30 }, nil)
  Test::expect(pressed == 1)
}

test "a channel's line is named by its name, the zone left out, until its tab's settings say otherwise" {
  Game::chat.windows = gameWindows()
  _ = chat()
  Game::chat.heard.emit(line("CHANNEL", "[Gazlowe]: WTS ore", "Gazlowe", [1], 2, "Trade - City"))
  // Found by its whisper window's tab, named by the partner: the «Tabs» page lists the windows too, by their names.
  const shown = Test::page().window("Jaina")
  Test::expect(shown.text("|Hchannel:CHANNEL:2|h[Trade]|h [Gazlowe]: WTS ore").shown())
  const settings = tabsPage()
  settings.text("[2. Trade]").click()
  Game::chat.heard.emit(line("CHANNEL", "[Gazlowe]: WTB ore", "Gazlowe", [1, 3], 2, "Trade - City"))
  Test::expect(shown.text("|Hchannel:CHANNEL:2|h[2. Trade]|h [Gazlowe]: WTB ore").shown())
  // Another tab keeps its own.
  shown.text("Jaina").click()
  Test::expect(shown.text("|Hchannel:CHANNEL:2|h[Trade]|h [Gazlowe]: WTB ore").shown())
}

test "a tab's count goes off in its settings; the combat log's and a tab of channels alone have none until turned on" {
  Game::chat.windows = [window(1, "General", ""), window(3, "Whisper", "Jaina"), window(4, "Trade", "")]
  Game::chat.groups = (index: Integer): Array<Game::ChatGroup> => [
    { name: "SAY", label: "Say", shown: index != 4 }
  ]
  Game::chat.channels = (index: Integer): Array<Game::ChatShown> => [{ name: "Trade", shown: index == 4 }]
  _ = chat()
  const shown = Test::page().window("Jaina")
  Game::chat.heard.emit(line("CHANNEL", "[Gazlowe]: WTS ore", "Gazlowe", [4], 2, "Trade - City"))
  Test::expect(!shown.text("1").shown())
  const settings = tabsPage()
  settings.text("Whisper").click()
  // The switches on: the modules' in the sidebar, then the tab's count, then its lines' «Fold repeats», the page's last.
  const on = settings.button(Ordaen.art.ctl.switchOn)
  on.nth(on.count() - 1).click()
  Game::chat.heard.emit(line("SAY", "[Jaina] says: psst", "Jaina", [3]))
  Test::expect(!shown.text("1").shown())
}

test "a window the game tells as the combat log only once its addon loads loses its count then" {
  Game::chat.windows = [window(1, "General", ""), window(2, "Combat Log", "")]
  const shown = chat()
  Game::chat.heard.emit(line("SAY", "[Thrall] says: hit", "Thrall", [2]))
  Test::expect(shown.text("1").shown())
  // Blizzard_CombatLog loaded: the game reads its windows again.
  Game::chat.windows = [window(1, "General", ""), window(2, "Combat Log", "", true, 13, true)]
  Test::flush()
  Test::expect(!shown.text("1").shown())
}

test "the same words said again one after another are one line, counted" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  Game::chat.heard.emit(line("YELL", "[Gnoll] yells: spam", "Gnoll", [1]))
  Game::chat.heard.emit(line("YELL", "[Gnoll] yells: spam", "Gnoll", [1]))
  Test::expect(shown.text("[Gnoll] yells: spam |cff9d9d9d×2|r").shown())
}

test "a tab folds repeats as its own settings say: one turned off in the Tabs page, another still folds" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  // General picked: its «Fold repeats», the page's last switch, turned off; the whisper tab keeps its own.
  const settings = tabsPage()
  const on = settings.button(Ordaen.art.ctl.switchOn)
  on.nth(on.count() - 1).wheel(-30)
  on.nth(on.count()).click()
  _ = Test::key(Key::Escape)
  Game::chat.heard.emit(line("YELL", "[Gnoll] yells: spam", "Gnoll", [1, 3]))
  Game::chat.heard.emit(line("YELL", "[Gnoll] yells: spam", "Gnoll", [1, 3]))
  Test::expect(shown.text("[Gnoll] yells: spam").count() == 2)
  shown.text("Jaina").click()
  Test::expect(shown.text("[Gnoll] yells: spam |cff9d9d9d×2|r").shown())
}

test "a web address in a line is a link of the chat's own" {
  Test::expect(linked("see https://a.io/x?y=1 now") == "see |cff69ccf0|Hordaenurl:https://a.io/x?y=1|h[https://a.io/x?y=1]|h|r now")
}

test "a web address clicked opens a box to copy it, closed by Escape" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  Game::chat.heard.emit(line("SAY", "see https://a.io/x", "Thrall", [1]))
  shown.text(linked("see https://a.io/x")).clickLink("ordaenurl:https://a.io/x", nil)
  Test::expect(Test::page().window("Close").shown())
  _ = Test::key(Key::Escape)
  Test::expect(!Test::page().window("Close").shown())
}

test "whispers are Ordaen Social's: no tab shows them, its conversation counts them unread, a web address a link" {
  Game::chat.windows = [window(1, "General", "")]
  const shown = chat()
  Game::chat.heard.emit(whisper("Thrall", "see https://a.io/x"))
  Test::expect(!shown.texts().any(text => text.contains("a.io")))
  const social = Social ?? panic("Ordaen Social is on in the tests")
  const talk = social.talks[1] ?? panic("Thrall's conversation made")
  Test::expect(social.whispersUnread == 1 && talk.lines[1]?.whole == linked("see https://a.io/x"))
  // A player reported: their lines go from the conversations too.
  const rude = whisper("Grub", "rude")
  rude.guid = "Player-1-0001"
  Game::chat.heard.emit(rude)
  Game::chat.playerReported.emit("Player-1-0001")
  Test::expect((social.talks[1] ?? panic("Grub's conversation made")).lines.length == 0)
}

test "a name's menu whispers them in Ordaen Social's window" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  Game::chat.heard.emit(line("SAY", "|Hplayer:Jaina:7|h[Jaina]|h says: hi", "Jaina", [1]))
  shown.text("|Hplayer:Jaina:7|h[Jaina]|h says: hi").clickLink("player:Jaina:7", .Right)
  Test::page().text("Whisper").click()
  Test::expect(Social?.talkOpen == "t:Jaina")
}

test "the chat's tabs are a sidebar at its left, one a row, a right-click opening the menu alone" {
  Game::chat.windows = playersWindows()
  const shown = chat("Общий")
  Game::chat.heard.emit(line("SAY", "[Thrall] says: here", "Thrall", [1]))
  // Each tab under the one before, from the same left edge, and the lines to the right of them all.
  const names = ["Общий", "Журнал", "Гильдия", "Каналы"]
  for (at of 2..names.length) {
    const above = shown.text(names[at - 1] ?? "").rect()
    const below = shown.text(names[at] ?? "").rect()
    Test::expect(below.top >= above.bottom && below.left == above.left)
  }
  Test::expect(shown.text("[Thrall] says: here").rect().left > shown.text("Каналы").rect().right)
  Game::chat.windows = gameWindows()
  Test::pass(0.1)
  const now = Test::page().window("General")
  now.text("General").rightClick()
  Test::expect(!Test::requests().any(r => r == "Chat.choose 1"))
  Test::expect(Test::page().text("Rename").shown())
}

// A drag of the mouse from `from` by (dx, dy), in steps the client's drag takes as one.
function drag(from: Test::Point, dx: Number, dy: Number) {
  Test::moveTo(from)
  Test::press(nil)
  Test::moveTo({ x: from.x + 1, y: from.y })
  Test::pass(0.05)
  Test::moveTo({ x: from.x + dx, y: from.y + dy })
  Test::pass(0.05)
  Test::release(nil)
  Test::flush()
}

// Each size is measured after the grip is let go: the settings' size, kept.
// The chat's own grip: the panel draws grips of its own.
function gripOf(shown: Test::Part): Test::Point {
  const at = shown.box(Ordaen.art.ctl.grip).rect()
  return { x: (at.left + at.right) / 2, y: (at.top + at.bottom) / 2 }
}

test "the grip in the chat's top right corner grows it right and up, never below its least, and the size is kept" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  const before = shown.rect()
  // Up more than right: the panel's action bars stack beside the portrait, and a grip pulled over them is under them.
  drag(gripOf(shown), 60, -200)
  const grown = shown.rect()
  // It stands by its bottom left: that stays, the other sides go out.
  Test::expect(grown.left == before.left && (grown.bottom - before.bottom).abs() < 0.5)
  Test::expect(grown.right > before.right + 50 && grown.top < before.top - 150)
  // The grip followed the cursor: off it, it shows its plain art again.
  Test::moveTo({ x: 1500, y: 100 })
  Test::flush()
  drag(gripOf(shown), -2000, 2000)
  const least = shown.rect()
  // The lines' least, 480 dp (341 of the screen's units here), and the tabs beside them.
  Test::expect(least.right < grown.right && least.right - least.left >= 341)
}

test "the chat stands on the bottom panel at the screen's left, its tabs over the portrait and as wide as it" {
  Game::chat.windows = gameWindows()
  Game::player.level = 42
  const shown = chat()
  // The portrait: the panel's surface holding the player's level.
  const portrait = Test::page().window("42").rect()
  const at = shown.rect()
  const tab = under(shown, "General", GROUND)
  Test::expect(at.left == 0 && (tab.left - portrait.left).abs() < 0.5)
  Test::expect((tab.right - tab.left - (portrait.right - portrait.left)).abs() < 0.5)
  // Its foot on the panel; the tabs' room ends where the portrait rises over it, the tabs above that.
  Test::expect(at.bottom > portrait.top && at.bottom < portrait.bottom)
  Test::expect(tab.bottom <= portrait.top)
}

test "the chat is never narrower than a window's least body, 375 dp" {
  Test::expect(LEAST_WIDTH == 375)
  Game::chat.windows = gameWindows()
  // Found by a tab the settings window doesn't name.
  const shown = chat("Jaina")
  Test::open("/ordaen")
  const settings = Test::page().window("Move mode")
  settings.button("Chat").click()
  // The width's «−», the page's first, pressed past its least: it stops there.
  for (at of 1..20) { settings.text("-").nth(1).click() }
  // 375 dp, 266 of the screen's units here (190 dp are 135).
  const drawn = shown.rect()
  Test::expect(drawn.right - drawn.left >= 266)
}

