test "a window the player undocked is a pane of its own" {
  Game.chat.windows = [window(1, "General", ""), window(3, "Whisper", "Jaina", false)]
  _ = chat()
  Game.chat.heard.emit(line("SAY", "[Jaina] says: apart", "Jaina", [3]))
