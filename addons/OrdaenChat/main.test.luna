// The chat as the player meets it: the game's lines in Ordaen's frame, its windows and streams as tabs, the game's
// input under them. The fake game's chat hands it lines (`Game.chat.heard.emit`), its windows and its streams.
import Client from "$client"
import Game from "$game"
import { Key } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { ChatMark, say } from "Ordaen"
import { LEAST_WIDTH } from "@/choices"
import { ChatTab, Shown, linked, marks, wordsOf } from "@/lines"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const WHITE: Color = Color.hex("#ffffff")
const INPUT_HINT = "Enter: type"

function window(index: Integer, name: String, partner: String, docked: Boolean = true): Game.ChatWindow {
  // Hidden while its input is made, as the game parks its windows.
  const frame = Client.CreateFrame("Frame", `ChatFrame${index}`, Client.C_UI.GetUIParent(), nil)
  frame.Hide()
  return {
    index: index, name: name, fontSize: 13, partner: partner, combatLog: false, docked: docked, shown: true,
    locked: false, frame: frame, input: input(frame)
  }
}

// A window's input, as the client's template makes it: never taking the keyboard by itself.
function input(parent: any Client.Frame): any Client.EditBox {
  const made = new Client.EditBox(parent)
  made.SetAutoFocus(false)
  return made
}

// A line said by someone, shown in the windows given.
function line(kind: String, body: String, sender: String, windows: Array<Integer>, channel: Integer = 0, channelName: String = ""): mut Game.ChatLine {
  return {
    kind: kind, event: `CHAT_MSG_${kind}`, body: body, plain: body, text: body, sender: sender, guid: "", lineId: 1, channel: channel,
    channelName: channelName, stream: "", color: WHITE, time: Game.clock.server, stamp: "", windows: windows, secret: ""
  }
}

// The game's General and a whisper window.
function gameWindows(): Array<Game.ChatWindow> { return [window(1, "General", ""), window(3, "Whisper", "Jaina")] }

// The chat mounted.
function chat(): Test.Part {
  Test.mount(nil, SCREEN)
  return Test.page().window(INPUT_HINT)
}

test "the chat reads the game's lines and shows them in the window's tab, the input's hint under them" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.chat.heard.emit(line("SAY", "[Thrall] says: Hello", "Thrall", [1]))
  Test.expect(shown.text("[Thrall] says: Hello").shown())
  Test.expect(shown.text(INPUT_HINT).shown())
}

test "a line for another tab waits there, counted, until the tab is opened" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.chat.heard.emit(line("SAY", "[Jaina] says: psst", "Jaina", [3]))
  Test.expect(!shown.text("[Jaina] says: psst").shown())
  Test.expect(shown.text("1").shown())
  shown.text("Jaina").click()
  Test.expect(shown.text("[Jaina] says: psst").shown())
  Test.expect(Test.requests().any(r => r == "Chat.choose 3"))
}

// The game opens its input as `ChatFrameUtil.ActivateChat` does (shown, the keyboard's) and tells it typing: it
// stands in the chat's foot, under the lines, as high as the game makes it.
test "Enter shows the input line, on the screen, in the chat's frame" {
  Game.chat.windows = gameWindows()
  const box = input(Client.CreateFrame("Frame", nil, Client.C_UI.GetUIParent(), nil))
  box.Hide()
  Game.chat.input = box
  _ = chat()
  Game.chat.heard.emit(line("SAY", "[Thrall] says: here", "Thrall", [1]))
  // The hint goes as the input shows: the chat is found by its line.
  const shown = Test.page().window("[Thrall] says: here")
  box.Show()
  box.SetFocus()
  Game.chat.typing = true
  Test.pass(0.01)
  const frame = shown.rect()
  const middle = Test.centre(box)
  Test.expect(box.IsVisible() && box.GetHeight() >= 20)
  Test.expect(middle.x > frame.left && middle.x < frame.right && middle.y > frame.top && middle.y < frame.bottom)
  Test.expect(middle.y > shown.text("[Thrall] says: here").rect().bottom)
}

test "a channel's line is named by its number and name, the zone left out" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.chat.heard.emit(line("CHANNEL", "[Gazlowe]: WTS ore", "Gazlowe", [1], 2, "Trade - City"))
  Test.expect(shown.text("|Hchannel:CHANNEL:2|h[2. Trade]|h [Gazlowe]: WTS ore").shown())
}

test "the same words said again one after another are one line, counted" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.chat.heard.emit(line("YELL", "[Gnoll] yells: spam", "Gnoll", [1]))
  Game.chat.heard.emit(line("YELL", "[Gnoll] yells: spam", "Gnoll", [1]))
  Test.expect(shown.text("[Gnoll] yells: spam |cff9d9d9d×2|r").shown())
}

test "a web address in a line is a link of the chat's own" {
  Test.expect(linked("see https://a.io/x?y=1 now") == "see |cff69ccf0|Hordaenurl:https://a.io/x?y=1|h[https://a.io/x?y=1]|h|r now")
}

test "the open tab's lines open in a box to copy" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.chat.heard.emit(line("SAY", "[Thrall] says: one", "Thrall", [1]))
  shown.text("[Thrall] says: one").hover()
  shown.text("Copy").click()
  Test.expect(Test.page().window("Close").texts().any(t => t == "[Thrall] says: one"))
}

// A long tab's text: the box stays on the screen, its text selectable in a field, and it closes by its button and
// by Escape.
test "the copy box holds a long tab's text on the screen and closes by its button and by Escape" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  for (at of 1..200) { Game.chat.heard.emit(line("SAY", `[Thrall] says: line ${at}`, "Thrall", [1])) }
  shown.text("[Thrall] says: line 200").hover()
  shown.text("Copy").click()
  const box = Test.page().window("Close")
  Test.expect(box.texts().any(t => t.contains("[Thrall] says: line 1\n[Thrall] says: line 2\n")))
  box.button("Close").click()
  Test.expect(!Test.page().window("Close").shown())
  shown.text("[Thrall] says: line 200").hover()
  shown.text("Copy").click()
  Test.expect(Test.page().window("Close").shown())
  _ = Test.key(Key.Escape)
  Test.expect(!Test.page().window("Close").shown())
}

test "«Copy» shows in the frame's corner while the cursor is on the lines, and moves no tab" {
  Game.chat.windows = playersWindows()
  const shown = chat()
  Game.chat.heard.emit(line("SAY", "[Thrall] says: one", "Thrall", [1]))
  const before = shown.text("Каналы").rect()
  Test.expect(!shown.text("Copy").shown())
  shown.text("[Thrall] says: one").hover()
  Test.expect(shown.text("Copy").shown())
  const after = shown.text("Каналы").rect()
  Test.expect(after.left == before.left && after.top == before.top)
}

test "the chat's tabs are the window tabs of Ordaen's windows, a right-click opening the menu alone" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Test.expect(shown.button("General").paintedWith(Ordaen.art.window.wood))
  Game.chat.heard.emit(line("SAY", "[Thrall] says: here", "Thrall", [1]))
  shown.text("Whispers").rightClick()
  shown.text("General").rightClick()
  Test.expect(!Test.requests().any(r => r == "Chat.choose 1"))
  Test.expect(Test.page().text("Rename").shown())
}

test "the chat is never narrower than a window's least body, 375 dp" {
  Test.expect(LEAST_WIDTH == 375)
  Game.chat.windows = gameWindows()
  const shown = chat()
  Test.open("/ordaen")
  const settings = Test.page().window("Move mode")
  settings.button("Chat").click()
  const width = settings.input().nth(1)
  width.click()
  Test.erase(10)
  Test.type("240")
  _ = Test.key(Key.Enter)
  // 375 dp, 266 of the screen's units here (190 dp are 135).
  const drawn = shown.rect()
  Test.expect(drawn.right - drawn.left >= 266)
}

test "a link clicked is the game's" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.chat.heard.emit(line("SAY", "|Hitem:6948|h[Hearthstone]|h", "Thrall", [1]))
  shown.text("|Hitem:6948|h[Hearthstone]|h").clickLink("item:6948", nil)
  Test.expect(Test.requests().any(r => r == "Chat.click item:6948 LeftButton"))
}

test "a tab's right-click opens its menu: renamed in a box, locked, a new tab, its settings" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  shown.text("General").rightClick()
  Test.page().text("Rename").click()
  Test.page().input().type("Main")
  Test.page().window("Cancel").button("Rename").click()
  shown.text("General").rightClick()
  Test.page().text("Lock").click()
  shown.text("General").rightClick()
  Test.page().text("New tab").click()
  const asked = Test.requests()
  Test.expect(asked.any(r => r.match("^Chat%.rename 1 (.*Main)$") != nil))
  Test.expect(asked.any(r => r == "Chat.lock 1 true") && asked.any(r => r == "Chat.open New tab"))
}

test "a name's right-click opens its menu: whisper, invite, who, ignore, and the game's own" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.chat.heard.emit(line("SAY", "|Hplayer:Jaina:7|h[Jaina]|h says: hi", "Jaina", [1]))
  shown.text("|Hplayer:Jaina:7|h[Jaina]|h says: hi").clickLink("player:Jaina:7", .Right)
  Test.page().text("More…").click()
  Test.expect(Test.requests().any(r => r == "Chat.click player:Jaina:7 RightButton"))
}

test "a window the player undocked is a pane of its own" {
  Game.chat.windows = [window(1, "General", ""), window(3, "Whisper", "Jaina", false)]
  _ = chat()
  Game.chat.heard.emit(line("SAY", "[Jaina] says: apart", "Jaina", [3]))
  Test.expect(Test.page().window("[Jaina] says: apart").text("Jaina").shown())
  Test.expect(!Test.page().window("General").text("Jaina").shown())
}

test "the Tabs page shows what a window shows, each turned on and off there" {
  Game.chat.windows = gameWindows()
  Game.chat.groups = (index: Integer): Array<Game.ChatShown> => [{ name: "SAY", shown: true }, { name: "YELL", shown: false }]
  _ = chat()
  Test.open("/ordaen")
  const settings = Test.page().window("Move mode")
  settings.button("Chat").click()
  settings.button("Tabs").click()
  settings.button(Ordaen.art.ctl.check).nth(2).click()
  Test.expect(Test.requests().any(r => r == "Chat.showGroup 1 YELL true"))
}

test "the input opened in a whisper's tab whispers its partner" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  shown.text("Jaina").click()
  Game.chat.typing = true
  Test.pass(0.01)
  Test.expect(Test.requests().any(r => r == "Chat.speak 3"))
}

test "a line fades once its time is up, and shows while the cursor is on the chat" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.chat.heard.emit(line("SAY", "[Thrall] says: old", "Thrall", [1]))
  Game.clock.server = Game.clock.server + 200
  Test.pass(0.01)
  Test.expect(shown.text("[Thrall] says: old").opacity() == 0)
  shown.text("[Thrall] says: old").hover()
  Test.expect(shown.text("[Thrall] says: old").opacity() == 1)
}

test "the wheel scrolls back, and «To the latest» brings the newest back" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  for (at of 1..100) { Game.chat.heard.emit(line("SAY", `line ${at}`, "Thrall", [1])) }
  Test.expect(!shown.text("line 10").shown())
  shown.text("line 100").hover()
  for (at of 1..30) { Test.wheel(1) }
  Test.expect(shown.text("line 10").shown() && !shown.text("line 100").shown())
  shown.text("To the latest").click()
  Test.expect(!shown.text("To the latest").shown())
  Test.expect(shown.text("line 100").rect().bottom > shown.text("line 99").rect().bottom)
}

test "an Ordaen addon writes into the chat with its mark and colour" {
  const mark: ChatMark = { name: "Inventory", color: Color.hex("#e8c35a") }
  say(mark, "sorted.")
  Test.expect(Test.printed().join("\n") == "|cffe8c35aInventory:|r sorted.")
}

test "a line the client keeps secret shows one line high, never kept for the next session" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  const secret = line("SAY", "", "Boss", [1])
  Game.chat.heard.emit({
    kind: "SAY", event: "CHAT_MSG_SAY", body: Test.secretText(), plain: "", text: "", sender: "", guid: "", lineId: 1, channel: 0,
    channelName: "", stream: "", color: WHITE, time: Game.clock.server, stamp: "", windows: [1], secret: "text"
  })
  Game.chat.heard.emit(line("SAY", "[Thrall] says: after", "Thrall", [1]))
  Test.expect(shown.text("[Thrall] says: after").shown() && secret.body == "")
  Test.expect(Test.errors().length == 0)
}

test "a tab's last lines are kept for the next session and come back dimmed, before the new ones" {
  const kept = new ChatTab("w1", "General")
  kept.add(plain("one"), true, 500)
  kept.add(plain("two"), true, 500)
  kept.add(plain("three"), true, 500)
  const back = new ChatTab("w1", "General")
  back.add(plain("new"), true, 500)
  back.recall(kept.keptLines(2))
  Test.expect(back.lines.map(l => `${l.whole}${l.past ? "*" : ""}`).join(",") == "two*,three*,new")
}

test "a stream's tab speaks in its channel as the input opens" {
  Game.chat.windows = gameWindows()
  Game.chat.streams = [{ club: "12", stream: "1", name: "Friends" }]
  const shown = chat()
  shown.text("Friends").click()
  Game.chat.typing = true
  Test.pass(0.01)
  Test.expect(Test.requests().any(r => r == "Chat.speakIn 12 1"))
}

test "someone's line naming a keyword is marked" {
  Test.expect(marks("anyone selling ore?", wordsOf("Ore, cloth", "Thrall")))
  Test.expect(!marks("hello", wordsOf("Ore, cloth", "Thrall")))
  Test.expect(marks("thrall, come", wordsOf("", "Thrall")))
}

function plain(words: String): Shown {
  return { whole: words, color: WHITE, time: 0, repeat: words, count: 1, marked: false, past: false, secret: false }
}

test "tabs that don't fit the chat's width wrap to another row, none of them shortened" {
  Game.chat.windows = [
    window(1, "General", ""), window(3, "Trade and services", ""), window(4, "Guild officers", "")
  ]
  const shown = chat()
  Test.expect(shown.text("Guild officers").rect().top > shown.text("General").rect().top)
  Test.expect(shown.text("Trade and services").shown())
}

// The windows and streams of the player's game: General, the combat log, Guild, Channels, two communities.
function playersWindows(): Array<Game.ChatWindow> {
  return [window(1, "Общий", ""), window(2, "Журнал", ""), window(3, "Гильдия", ""), window(4, "Каналы", "")]
}

test "with the player's tabs wrapping, the lines keep their room and the input's hint stands under them" {
  Game.chat.windows = playersWindows()
  Game.chat.streams = [{ club: "1", stream: "1", name: "test" }, { club: "2", stream: "1", name: "Test" }]
  const shown = chat()
  Game.chat.heard.emit(line("SAY", "[Thrall] says: still here", "Thrall", [1]))
  const said = shown.text("[Thrall] says: still here").rect()
  const hint = shown.text(INPUT_HINT).rect()
  Test.expect(shown.text("[Thrall] says: still here").shown())
  Test.expect(hint.top > said.top)
  // The lines keep the chat's height (190 dp, 135 of the screen's units here) under the last row of tabs.
  Test.expect(hint.top - shown.text("Test").rect().bottom >= 130)
}

test "a stream the game lists twice is one tab" {
  Game.chat.windows = playersWindows()
  Game.chat.streams = [{ club: "1", stream: "1", name: "test" }, { club: "1", stream: "1", name: "test" }]
  const shown = chat()
  Test.expect(shown.texts().filter(t => t == "test").length == 1)
}

test "whispers are the whisper window's: a conversation a person, unread until opened, answered in its own line" {
  Game.chat.windows = [window(1, "General", "")]
  const shown = chat()
  Game.chat.heard.emit(line("WHISPER", "[Jaina] whispers: psst", "Jaina", [1]))
  Test.expect(!shown.text("[Jaina] whispers: psst").shown())
  Test.expect(shown.text("1").shown())
  shown.text("Whispers").click()
  const talks = Test.page().window("Whisper to: name, Enter")
  Test.expect(talks.text("[Jaina] whispers: psst").shown())
  Test.expect(!shown.text("1").shown() && !talks.text("1").shown())
  talks.input().nth(2).type("hello")
  _ = Test.key(Key.Enter)
  Test.expect(Test.requests().any(r => r == "Chat.whisper Jaina hello false"))
  // Another person's whisper: a conversation of their own, first in the list, waiting unread.
  Game.chat.heard.emit(line("WHISPER", "[Thrall] whispers: lok'tar", "Thrall", [1]))
  Test.expect(talks.text("Thrall").rect().top < talks.text("Jaina").rect().top)
  Test.expect(talks.text("1").shown() && !talks.text("[Thrall] whispers: lok'tar").shown())
  talks.text("Thrall").click()
  Test.expect(talks.text("[Thrall] whispers: lok'tar").shown())
  // A name typed starts one; Escape closes the window.
  talks.input().nth(1).type("Anduin")
  _ = Test.key(Key.Enter)
  Test.expect(talks.text("Anduin").shown())
  _ = Test.key(Key.Escape)
  Test.expect(!Test.page().window("Whisper to: name, Enter").shown())
}

// The game's line as it gives it: its body, and the same line plain.
test "a line shows the name bare, no «says:»: the colour tells the kind, the time before it in brackets, muted" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.clock.hours24 = true
  const said = line("SAY", "|Hplayer:Thrall:7|h[Thrall]|h says: Hello", "Thrall", [1])
  said.plain = "|Hplayer:Thrall:7|hThrall|h: Hello"
  said.stamp = "12:04 "
  said.time = 12 * 3600 + 4 * 60
  Game.chat.heard.emit(said)
  Test.expect(shown.text("|cff9d9d9d[12:04]|r |Hplayer:Thrall:7|hThrall|h: Hello").shown())
}

test "the chat's times are written by the clock's 24-hour mode, as every time of Ordaen's" {
  Game.chat.windows = gameWindows()
  const shown = chat()
  Game.clock.hours24 = false
  const said = line("SAY", "Hello", "Thrall", [1])
  said.stamp = "15:30 "
  said.time = 15 * 3600 + 30 * 60
  Game.chat.heard.emit(said)
  Test.expect(shown.text("|cff9d9d9d[3:30 PM]|r Hello").shown())
}
