  say(mark, "sorted.")
  Test::expect(Test::printed().join("\n") == "|cffe8c35aInventory:|r sorted.")
}

test "a line kept with no sender (kept before senders were) comes back, said by nobody" {
  const old: Map<String, Unknown> = {}
  old["whole"] = "[Thrall] says: from before"
  old["color"] = WHITE
  old["time"] = 1
  old["repeat"] = ""
  old["count"] = 1
  old["marked"] = false
  old["past"] = true
  old["secret"] = false
  old["mine"] = false
  const tab: Map<String, Unknown> = {}
  tab["key"] = "w1"
  tab["lines"] = [old]
  const kept: Map<String, Unknown> = {}
  kept["tabs"] = [tab]
  const back = Kept::decode(kept, Kept { tabs: [] })
  const lines = back.tabs[1]?.lines ?? []
  Test::expect(lines[1]?.sender == "")
}

test "a line the client keeps secret shows one line high, never kept for the next session" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  const secret = line("SAY", "", "Boss", [1])
  Game::chat.heard.emit({
    kind: "SAY", event: "CHAT_MSG_SAY", body: Test::secretText(), plain: "", text: "", sender: "", guid: "", lineId: 1, channel: 0,
    channelName: "", stream: "", color: WHITE, time: Game::clock.server, stamp: "", windows: [1], secret: "text"
  })
  Game::chat.heard.emit(line("SAY", "[Thrall] says: after", "Thrall", [1]))
  Test::expect(shown.text("[Thrall] says: after").shown() && secret.body == "")
  Test::expect(Test::errors().length == 0)
}

test "a tab's last lines are kept for the next session and come back as they were, before the new ones" {
  const kept = new ChatTab("w1", "General")
  kept.add(plain("one", 100))
  kept.add(plain("two", 100))
  kept.add(plain("three", 100))
  const back = new ChatTab("w1", "General")
  back.add(plain("new"))
  back.recall(kept.keptLines(2))
  Test::expect(back.lines.map(l => l.whole).join(",") == "two,three,new")
  // A rule above each session's first line: the kept session's, and this one's after it.
  Test::expect(back.slice(0, 80).map(e => `${e.opens ? "|" : ""}${e.line.whole}`).join(",") == "|two,three,|new")
}

test "each session's lines stand under a rule naming the session, in the lines' own colours" {
  Game::chat.windows = gameWindows()
  _ = chat()
  Game::chat.heard.emit(line("SAY", "[Thrall] says: before", "Thrall", [1]))
  // In this session alone: no rule.
  Test::expect(!Test::page().window("Jaina").texts().any(text => text.match("^Session · ") != nil))
  // A later session: the line kept comes back under its session's rule, this session's rule over what it hears.
  Game::clock.server = THIS_SESSION.floor() + 3600
  Events::PLAYER_LOGOUT.emit()
  Test::reload()
  Game::chat.windows = gameWindows()
  Game::chat.heard.emit(line("SAY", "[Thrall] says: now", "Thrall", [1]))
  const shown = Test::page().window("Jaina")
  const rules = shown.texts().filter(text => text.match("^Session · ") != nil)
  Test::expect(rules.length == 2)
  // Not dimmed: drawn as it was.
  Test::expect(shown.text("[Thrall] says: before").opacity() == 1)
  Test::expect(shown.text(rules[1] ?? "").rect().bottom <= shown.text("[Thrall] says: before").rect().top)
}

test "a community is no tab of its own: a tab shows it where the Tabs page ticks it" {
  Game::chat.windows = gameWindows()
  const friends: Game::ChatStream = { club: "12", stream: "1", name: "Friends" }
  const guild: Game::ChatStream = { club: "14", stream: "1", name: "Guildhall" }
  Game::chat.streams = [friends, guild]
  Game::chat.communities = (index: Integer): Array<Game::ChatCommunity> => [{ stream: friends, shown: false }, { stream: guild, shown: true }]
  const shown = chat()
  Test::expect(!shown.text("Friends").shown())
  const settings = tabsPage()
  settings.button(Ordaen.art.ctl.check).nth(1).click()
  // The group that carries the communities' lines follows: shown while any community is.
  const asked = Test::requests()
  Test::expect(asked.any(r => r == "Chat.showCommunity 1 12:1 true") && asked.any(r => r == "Chat.showGroup 1 COMMUNITIES_CHANNEL true"))
}

test "someone's line naming a keyword is marked" {
  Test::expect(marks("anyone selling ore?", wordsOf("Ore, cloth", "Thrall")))
  Test::expect(!marks("hello", wordsOf("Ore, cloth", "Thrall")))
  Test::expect(marks("thrall, come", wordsOf("", "Thrall")))
}

// A line heard in a session: this one's where none is named.
function plain(words: String, session: Number = THIS_SESSION): Shown {
  return { whole: words, color: WHITE, time: session, repeat: words, count: 1, marked: false, session: session, secret: false, sender: "" }
}

test "the chat is never lower than its tabs: the lines take the room they leave" {
  Game::chat.windows = [
    window(1, "General", ""), window(2, "Log", ""), window(3, "Guild", ""), window(4, "Trade", ""), window(5, "Officers", ""),
    window(6, "Party", ""), window(7, "Raid", ""), window(8, "Market", ""), window(9, "Friends", "")
  ]
  const shown = chat()
  // The chat's height is 190 dp, 135 of the screen's units: the tabs stand taller, and the frame reaches past the last
  // tab's foot.
  const first = shown.text("General").rect()
  const last = shown.text("Friends").rect()
  Test::expect(last.bottom - first.top > 135)
  Test::expect(shown.rect().bottom >= last.bottom)
}

// The windows of the player's game: General, the combat log, Guild, Channels.
function playersWindows(): Array<Game::ChatWindow> {
  return [window(1, "Общий", ""), window(2, "Журнал", ""), window(3, "Гильдия", ""), window(4, "Каналы", "")]
}

test "with the player's tabs, the lines keep their room, the newest at their foot" {
  Game::chat.windows = playersWindows()
  Game::chat.streams = [{ club: "1", stream: "1", name: "test" }, { club: "2", stream: "1", name: "Test" }]
  const shown = chat("Общий")
  Game::chat.heard.emit(line("SAY", "[Thrall] says: still here", "Thrall", [1]))
  const said = shown.text("[Thrall] says: still here").rect()
  // The lines keep the chat's height (190 dp, 135 of the screen's units here).
  Test::expect(said.bottom - shown.rect().top >= 130)
}

// A line said at `hour`:`minute` and `second`, where the game shows the chat's times.
function stamped(body: String, hour: Integer, minute: Integer, second: Integer = 0): mut Game::ChatLine {
  const said = line("SAY", body, "Thrall", [1])
  said.stamp = "%d:%02d ".format(hour, minute)
  said.time = hour * 3600 + minute * 60 + second
  return said
}

// The game's line as it gives it: its body, and the same line plain.
test "a line shows the name bare, no «says:»: the colour tells the kind, its time before it in brackets, muted, where its tab says" {
  Game::chat.windows = gameWindows()
  _ = chat()
  // Found by its whisper window's tab: the «Tabs» page lists the windows too, by their names.
  const shown = Test::page().window("Jaina")
  Game::clock.hours24 = true
  tabsPage().text("Before each line").click()
  const said = stamped("|Hplayer:Thrall:7|h[Thrall]|h says: Hello", 12, 4)
  said.plain = "|Hplayer:Thrall:7|hThrall|h: Hello"
  Game::chat.heard.emit(said)
  Test::expect(shown.text("|cff9d9d9d[12:04]|r |Hplayer:Thrall:7|hThrall|h: Hello").shown())
}

test "the chat's times are written by the clock's 24-hour mode, as every time of Ordaen's" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  Game::clock.hours24 = false
  Game::chat.heard.emit(stamped("Hello", 15, 30))
  Test::expect(shown.text("3:30 PM").shown() && shown.text("Hello").shown())
}

test "General's times stand above its lines, once for the lines of a minute, again as the next minute's first comes" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  Game::clock.hours24 = true
  Game::chat.heard.emit(stamped("first", 12, 4, 5))
  Game::chat.heard.emit(stamped("second", 12, 4, 50))
  Game::chat.heard.emit(stamped("third", 12, 5, 1))
  Test::expect(shown.text("12:04").count() == 1 && shown.text("12:05").count() == 1)
  const minute = shown.text("12:04").rect()
  const first = shown.text("first").rect()
  const second = shown.text("second").rect()
  const next = shown.text("12:05").rect()
  // The time close above its minute's first line, centred over the lines, smaller than them; the minute's lines one
  // under another, the next minute's time between them and its own line.
  Test::expect(minute.bottom <= first.top + 0.01 && first.top - minute.bottom < 1)
  Test::expect(minute.left > first.left + 50 && minute.bottom - minute.top < first.bottom - first.top)
  Test::expect(second.top >= first.bottom && next.top >= second.bottom && shown.text("third").rect().top >= next.bottom)
  // No line carries its time in brackets.
  Test::expect(!shown.text("|cff9d9d9d[12:04]|r first").shown())
}

test "a line kept with its time in its text comes back with its time drawn apart, above its minute's lines" {
  const tab = new ChatTab("w1", "General")
  tab.recall([
    { whole: "|cff9d9d9d[12:04]|r Hello", color: WHITE, time: 12 * 3600 + 4 * 60, repeat: "", count: 1, marked: false, secret: false },
    { whole: "|cff9d9d9d[3:30 PM]|r Later", color: WHITE, time: 15 * 3600 + 30 * 60, repeat: "", count: 1, marked: false, secret: false },
    { whole: "untimed", color: WHITE, time: 15 * 3600 + 31 * 60, repeat: "", count: 1, marked: false, secret: false }
  ])
  const first = tab.lines[1] ?? panic("kept")
  const later = tab.lines[2] ?? panic("kept")
  const untimed = tab.lines[3] ?? panic("kept")
  Test::expect(first.stamped && first.whole == "Hello" && later.stamped && later.whole == "Later")
  Test::expect(!untimed.stamped && untimed.whole == "untimed")
  const entries = tab.slice(0, 3)
  Test::expect(entries.map(entry => entry.stamp).equal([StampShown::Above, StampShown::Above, StampShown::None]))
}

test "messages stand apart by the chat's room between them, more than a message's own lines" {
  Game::chat.windows = gameWindows()
  _ = chat()
  // Found by its whisper window's tab: the settings window names «General» too.
  const shown = Test::page().window("Jaina")
  Game::chat.heard.emit(line("SAY", "[Thrall] says: one", "Thrall", [1]))
  Game::chat.heard.emit(line("SAY", "[Thrall] says: two", "Thrall", [1]))
  const room = (): Number => shown.text("[Thrall] says: two").rect().top - shown.text("[Thrall] says: one").rect().bottom
  Test::expect((room() - Ordaen.lengthOf(MESSAGE_GAP * 1sp) / 1ui).abs() < 0.05)
  // The room's slider on the Chat page, two half-steps down by its − (the page's sixth: after the width, the height,
  // the background's opacity, the lines kept and the lines held).
  Test::open("/ordaen")
  const settings = Test::page().window("Move mode")
  settings.button("Chat").click()
  settings.text("-").nth(4).click()
  settings.text("-").nth(4).click()
  Test::expect((room() - Ordaen.lengthOf((MESSAGE_GAP - 1) * 1sp) / 1ui).abs() < 0.05)
}

test "a line without the game's times has no time above it" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  Game::chat.heard.emit(line("SAY", "untimed", "Thrall", [1]))
  Test::expect(shown.text("untimed").shown() && shown.text(":").count() == 0)
}

test "a tab of neither General, the guild nor the channels has its times before its lines, until its settings say above" {
  Game::chat.windows = [window(1, "General", ""), window(4, "Drops", "Kel")]
  Game::chat.groups = (index: Integer): Array<Game::ChatGroup> => [
    { name: "SAY", label: "Say", shown: index == 1 },
    { name: "LOOT", label: "Loot", shown: index == 4 }
  ]
  _ = chat()
  // Found by its tab, named by its partner: the «Tabs» page lists the windows by their names.
  const shown = Test::page().window("Kel")
  Game::clock.hours24 = true
  shown.text("Kel").click()
  const looted = stamped("You receive loot", 12, 15)
  looted.windows = [4]
  Game::chat.heard.emit(looted)
  Test::expect(shown.text("|cff9d9d9d[12:15]|r You receive loot").shown())
  const settings = tabsPage()
  settings.text("Drops").click()
  settings.text("Above, by minute").click()
  Test::expect(shown.text("12:15").shown() && shown.text("You receive loot").shown())
}

test "a creature's name stands in the game's gold for names, not in its line's colour; a player's name stays the line's" {
  Game::chat.windows = gameWindows()
  const shown = chat()
  const yelled = line("MONSTER_YELL", "Ragnaros yells: BY FIRE BE PURGED!", "Ragnaros", [1])
  yelled.plain = "Ragnaros: BY FIRE BE PURGED!"
  Game::chat.heard.emit(yelled)
  Test::expect(shown.text("|cffffd100Ragnaros|r: BY FIRE BE PURGED!").shown())
  const said = line("YELL", "|Hplayer:Thrall:7|h[Thrall]|h yells: For the Horde!", "Thrall", [1])
  said.plain = "|Hplayer:Thrall:7|hThrall|h: For the Horde!"
  Game::chat.heard.emit(said)
  Test::expect(shown.text("|Hplayer:Thrall:7|hThrall|h: For the Horde!").shown())
}

test "the input speaks where each tab's window last spoke: opened in General it speaks as General's, a tab picked while typing as its own" {
  Game::chat.windows = [window(1, "General", ""), window(4, "Trade", "")]
  const shown = chat()
  Game::chat.typing = true
  Test::pass(0.01)
  Test::expect(Test::requests().any(r => r == "Chat.speak 1"))
  shown.text("Trade").click()
  Test::expect(Test::requests().any(r => r == "Chat.speak 4"))
}

test "the lines' ground is as dark as the Chat page says, 80% where nothing is chosen" {
  Game::chat.windows = gameWindows()
  _ = chat()
  // Found by its whisper window's tab: the settings window names «General» too.
  const shown = Test::page().window("Jaina")
  // The ground's seven parts and the open tab's ground.
  Test::expect(shown.box(GROUND).count() == 8)
  // The opacity's slider, two steps down by its − (the page's third: after the width and the height).
  Test::open("/ordaen")
  const settings = Test::page().window("Move mode")
  settings.button("Chat").click()
  settings.text("-").nth(3).click()
  settings.text("-").nth(3).click()
  // Lighter than the 80% it was: the ground follows the setting.
  Test::expect(shown.box(GROUND).count() == 0)
}
