// The chat's parts: a count's badge, a tab of its sidebar, and a line.
import { Align, Edges, Event, Line, Overflow, Position } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, ListTab, SECONDARY_TEXT } from "Ordaen"
import { ChatTab, Shown } from "@/lines"

public const BADGE_FILL: Color = Color.hex("#b3261e")
const WHITE: Color = Color.hex("#ffffff")
const CLEAR: Color = Color.hex("#00000000")
// The warm band under a line that names the player or a keyword.
const MARK: Color = Color.hex("#ff9a2e33")
const BADGE_PAD: Edges = { right: 1sp, left: 1sp }
// The room a count keeps: three digits, so the tab keeps its width as the count grows; a count past 999 takes its own.
const ROOM = "888"
const MOST_IN_ROOM = 999

// The count of lines waiting unread: white on red, in the numbers' font, at the right of room for three digits, so
// what holds it keeps its width as the count grows; a count past 999 takes its own.
public class Badge implements Component {
  derived room: String = self.count > MOST_IN_ROOM ? String.of(self.count) : ROOM

  count: Signal<Integer>
  constructor(count: Signal<Integer>) {
    self.count = count
  }

  public render(self): Template {
    return $ltml {
      <box padding={BADGE_PAD} background={BADGE_FILL}>
        <box opacity={0}>
          <text value={self.room} textFont={.Numbers} textSize={SECONDARY_TEXT} wrap={.None} />
        </box>
        <box position={Position.Absolute} top={0ui} right={0ui} bottom={0ui} left={0ui} padding={BADGE_PAD}
             xAlign={Align.End} yAlign={Align.Center}>
          <text value={"%d"} arguments={[self.count]} textColor={WHITE} textFont={.Numbers} textSize={SECONDARY_TEXT}
                wrap={.None} />
        </box>
      </box>
    }
  }
}

// A tab: an entry of the chat's sidebar, the library's list tab (its name, the shade under the cursor, the open one
// white with the light along its left), and, while lines wait unread, their count's badge at its right. The open
// one is sunk into the wood as a well is (its rim and its darker floor); the others stand on the wood itself, an
// unseen rim of the same width keeping every tab the same size. The left button picks it, the right opens its menu.
public class TabButton implements Component {
  public pick: Event<ChatTab> = new Event()
  public menu: Event<ChatTab> = new Event()

  derived unread: Boolean = self.tab.unread > 0
  derived rim: Line = self.open ? Ordaen.art.ctl.well.rim : { width: Ordaen.art.ctl.well.rim.width, color: CLEAR, sides: nil }
  derived floor: Color | nil = self.open ? Ordaen.art.ctl.well.floor : nil

  tab: Signal<ChatTab>
  open: Signal<Boolean>
  constructor(tab: Signal<ChatTab>, open: Signal<Boolean>) {
    self.tab = tab
    self.open = open
  }

  onPick(mut self) { self.pick.emit(peek self.tab) }

  onMenu(mut self) { self.menu.emit(peek self.tab) }

  public render(self): Template {
    return $ltml {
      <box columns={1} border={self.rim} background={self.floor} @pointerPress(.Right)={self.onMenu}>
        <ListTab label={self.tab.title} selected={self.open} @pick={self.onPick}>
          <Badge $if={self.unread} count={self.tab.unread} />
        </ListTab>
      </box>
    }
  }
}

// A line: its text in its colour, dimmed where it came from the last session, on a band where it names the player,
// gone once it faded. A secret line stands one line high, so nothing of it is measured.
public class Row implements Component {
  // A link of the line clicked.
  public link: Event<Event.Link> = new Event()

  derived faded: Boolean = self.line.time < self.fadeBefore
  derived opacity: Number = self.faded ? 0 : (self.line.past ? 0.6 : 1)
  derived band: Color | nil = self.line.marked ? MARK : nil

  line: Signal<Shown>
  // Lines said before this have faded.
  fadeBefore: Signal<Number>
  lineHeight: Signal<Number<Length>>
  constructor(line: Signal<Shown>, fadeBefore: Signal<Number>, lineHeight: Signal<Number<Length>>) {
    self.line = line
    self.fadeBefore = fadeBefore
    self.lineHeight = lineHeight
  }

  onLink(mut self, link: Event.Link) { self.link.emit(link) }

  public render(self): Template {
    return $ltml {
      <box $if={self.line.secret} @linkPress={self.onLink} height={self.lineHeight} overflow={Overflow.Hidden} opacity={self.opacity}>
        <text value={self.line.whole} secret={true} textColor={self.line.color} wrap={.None} />
      </box>
      <box $else opacity={self.opacity} background={self.band} @linkPress={self.onLink}>
        <text value={self.line.whole} textColor={self.line.color} />
      </box>
    }
  }
}
