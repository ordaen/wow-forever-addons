// The chat's parts: a tab on the tab row, and a line.
import { Edges, Event, Overflow, Position } from "$ltml"
import { Component, SECONDARY_TEXT, WindowTab, WindowTabSpec, tabAboveLine, tabFoot } from "Ordaen"
import { ChatTab, Shown } from "@/lines"

const BADGE: Color = Color.hex("#b3261e")
const WHITE: Color = Color.hex("#ffffff")
// The warm band under a line that names the player or a keyword.
const MARK: Color = Color.hex("#ff9a2e33")
const BADGE_PAD: Edges = { right: 1sp, left: 1sp }
// The badge in the tab's top right corner, inside its metal.
const BADGE_INSET = 4.6875dp

// A tab: the window tab of Ordaen's windows (its name on the tab's metal and wood, no picture), standing on the line
// of the pane's frame with its foot behind it, and, while lines wait unread, their count in a badge beside its name.
// The left button picks it, the right opens its menu.
public class TabButton implements Component {
  public pick: Event<ChatTab> = new Event()
  public menu: Event<ChatTab> = new Event()

  derived spec: WindowTabSpec = { title: self.tab.title }
  // The window tab's place among its tabs: the one, open or not.
  derived selected: Integer = self.open ? 1 : 0
  derived height: Number<Length> = tabAboveLine() + tabFoot()

  tab: Signal<ChatTab>
  open: Signal<Boolean>
  constructor(tab: Signal<ChatTab>, open: Signal<Boolean>) {
    self.tab = tab
    self.open = open
  }

  onPick(mut self, place: Integer) { self.pick.emit(peek self.tab) }

  onMenu(mut self) { self.menu.emit(peek self.tab) }

  public render(self): Template {
    return $ltml {
      // As high as the tab down to the line; the tab hangs its foot below, behind the frame's line.
      <box height={tabAboveLine()} @pointerPress(.Right)={self.onMenu}>
        <box position={Position.Absolute} left={0ui} right={0ui} top={0ui} columns={["max-content"]}>
          <WindowTab tab={self.spec} index={1} selected={self.selected} height={self.height} @picked={self.onPick} />
        </box>
        <box $if={self.tab.unread > 0} position={Position.Absolute} right={BADGE_INSET} top={BADGE_INSET} padding={BADGE_PAD}
             background={BADGE} zLevel={1} mouseThrough={true}>
          <text value={"%d"} arguments={[self.tab.unread]} textColor={WHITE} textSize={SECONDARY_TEXT} wrap={.None} />
        </box>
      </box>
    }
  }
}

// A line: its text in its colour, dimmed where it came from the last session, on a band where it names the player,
// gone once it faded. A secret line stands one line high, so nothing of it is measured.
public class Row implements Component {
  // A link of the line clicked.
  public link: Event<Event.Link> = new Event()

  derived faded: Boolean = self.line.time < self.fadeBefore
  derived opacity: Number = self.faded ? 0 : (self.line.past ? 0.6 : 1)
  derived band: Color | nil = self.line.marked ? MARK : nil

  line: Signal<Shown>
  // Lines said before this have faded.
  fadeBefore: Signal<Number>
  lineHeight: Signal<Number<Length>>
  constructor(line: Signal<Shown>, fadeBefore: Signal<Number>, lineHeight: Signal<Number<Length>>) {
    self.line = line
    self.fadeBefore = fadeBefore
    self.lineHeight = lineHeight
  }

  onLink(mut self, link: Event.Link) { self.link.emit(link) }

  public render(self): Template {
    return $ltml {
      <box $if={self.line.secret} @linkPress={self.onLink} height={self.lineHeight} overflow={Overflow.Hidden} opacity={self.opacity}>
        <text value={self.line.whole} secret={true} textColor={self.line.color} wrap={.None} />
      </box>
      <box $else opacity={self.opacity} background={self.band} @linkPress={self.onLink}>
        <text value={self.line.whole} textColor={self.line.color} />
      </box>
    }
  }
}
