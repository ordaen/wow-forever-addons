// The chat's parts: a tab of its sidebar and a line.
import Client from "$client"
import Game from "$game"
import { Align, Edges, Event, Overflow, Position, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, CountBadge, ListTab, SECONDARY_TEXT, TIGHT_LINE, timeText, toLeftLine } from "Ordaen"
import { ChatTab, STAMP, Shown, StampShown } from "@/lines"
import Locale from "@/locales"

// The warm band under a line that names the player or a keyword.
const MARK: Color = Color.hex("#ff9a2e33")
// A session's rule: a line each side of its name, the time stamps' muted grey.
const RULE: Color = Color.hex("#9d9d9d40")
const RULE_TEXT: Color = Color.hex("#9d9d9d")
const RULE_COLUMNS: Array<Track> = [{ fr: 1 }, "max-content", { fr: 1 }]
// A time above a minute's lines: the rule's muted grey, smaller than the secondary text, on its line's own lines.
const STAMP_TEXT: Number<TextSize> = 10rem / 13
// The shade behind the open tab and the one under the cursor: a list tab's own under the cursor.
const SHADE: Color = Color.hex("#00000059")
// The count's room at a counting tab's right, a two-digit badge's, kept in the tab's flow; the badge stands over the
// tab out of it, centred on its height, in from its right edge.
const COUNT_ROOM: Number<Length> = 28dp
const COUNT_SPOT: Edges = { right: 3sp }

// A tab: an entry of the chat's sidebar, the library's list tab (its name), and while lines wait unread, their count's
// badge at its right end, beside its name: a tab that counts keeps the badge's room whether any wait or not, the badge
// out of the flow in it (a count wider than the room grows to the left, into the gap), so nothing moves as the count
// comes, grows or goes. The open one and the one under the cursor stand on a shade, its name white on the open one;
// the shade reaches in under the lines' frame's left line, so it touches the lines. The left button picks it, the
// right opens its menu.
public class TabButton implements Component {
  public pick: Event<ChatTab> = new Event()
  public menu: Event<ChatTab> = new Event()

  state hovered = false
  derived shade: Color | nil = self.open || self.hovered ? SHADE : nil
  derived unread: Boolean = self.tab.unread > 0
  // The shade past the tab's box: to the middle of the lines' frame's left line, inside that frame's box.
  derived joined: Number<Length> = -toLeftLine(Ordaen.art.frame.small)

  tab: Signal<ChatTab>
  open: Signal<Boolean>
  constructor(tab: Signal<ChatTab>, open: Signal<Boolean>) {
    self.tab = tab
    self.open = open
  }

  onPick(mut self) { self.pick.emit(peek self.tab) }

  onMenu(mut self) { self.menu.emit(peek self.tab) }

  onEnter(mut self) { self.hovered = true }

  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box columns={1} @pointerPress(.Right)={self.onMenu} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        // The shade behind it out of the flow (every tab one size), its right under the lines' frame.
        <box position={Position.Absolute} top={0ui} right={self.joined} bottom={0ui} left={0ui} background={self.shade} />
        // The list tab draws no shade of its own (framed): this one reaches the frame.
        <box zLevel={1}>
          <ListTab label={self.tab.title} selected={self.open} framed={true} @pick={self.onPick}>
            <box $if={self.tab.counted} width={COUNT_ROOM} />
          </ListTab>
        </box>
        <box $if={self.unread} position={Position.Absolute} top={0ui} right={0ui} bottom={0ui} padding={COUNT_SPOT}
             yAlign={Align.Center} zLevel={2}>
          <CountBadge count={self.tab.unread} />
        </box>
      </box>
    }
  }
}

// A line: its text in its colour, on a band where it names the player; above it, where it opens a session, a rule with
// the session's day and time in its middle. Its time, where it is drawn, stands before its text in brackets, or above
// it alone, small and centred, close on its line. A secret line stands one line high, so nothing of it is measured.
public class Row implements Component {
  // A link of the line clicked.
  public link: Event<Event.Link> = new Event()

  derived band: Color | nil = self.line.marked ? MARK : nil
  // A line kept from before sessions were told apart is named by its own time.
  derived began: Integer = (self.line.session != 0 ? self.line.session : self.line.time).floor()
  derived session: String = Locale.SESSION.format(Client.date(Locale.SESSION_DATE, self.began), timeText(Game.clock.timeAt(self.began)))
  // Its time, written as every time of Ordaen's is.
  derived time: String = timeText(Game.clock.timeAt(self.line.time.floor()))
  derived above: Boolean = self.stamp == StampShown.Above
  derived text: String = self.stamp == StampShown.Before ? `${STAMP.format(self.time)}${self.line.whole}` : self.line.whole

  line: Signal<Shown>
  opens: Signal<Boolean>
  stamp: Signal<StampShown>
  lineHeight: Signal<Number<Length>>
  constructor(line: Signal<Shown>, opens: Signal<Boolean>, stamp: Signal<StampShown>, lineHeight: Signal<Number<Length>>) {
    self.line = line
    self.opens = opens
    self.stamp = stamp
    self.lineHeight = lineHeight
  }

  onLink(mut self, link: Event.Link) { self.link.emit(link) }

  public render(self): Template {
    return $ltml {
      <box $if={self.opens} columns={RULE_COLUMNS} gap={2sp} yAlign={Align.Center}>
        <box height={1ui} background={RULE} />
        <text value={self.session} textColor={RULE_TEXT} textSize={SECONDARY_TEXT} wrap={.None} />
        <box height={1ui} background={RULE} />
      </box>
      <box columns={1}>
        <box $if={self.above} xAlign={Align.Center}>
          <text value={self.time} textColor={RULE_TEXT} textSize={STAMP_TEXT} lineHeight={TIGHT_LINE} wrap={.None} />
        </box>
        <box $if={self.line.secret} @linkPress={self.onLink} height={self.lineHeight} overflow={Overflow.Hidden}>
          <text value={self.line.whole} secret={true} textColor={self.line.color} wrap={.None} />
        </box>
        <box $else background={self.band} @linkPress={self.onLink}>
          <text value={self.text} textColor={self.line.color} />
        </box>
      </box>
    }
  }
}
