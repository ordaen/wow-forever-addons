// What the player chooses on the minimap's settings page.
import { Visibility } from "Ordaen"

public struct Choices implements Plain {
  public mut scale: number
  public mut showZone: boolean
  public mut showClock: boolean
  public mut showCoords: boolean
  public mut buttonsHover: boolean
  public mut visibility: Visibility
  public mut drawerOn: boolean
  public mut drawerColumns: integer
}
