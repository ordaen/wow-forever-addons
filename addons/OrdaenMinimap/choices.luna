// What the player chooses on the minimap's settings page.

public enum Hide implements Plain { Never = "never", Combat = "combat", Transport = "transport" }

public struct Choices implements Plain {
  scale: Number
  showZone: Boolean
  showClock: Boolean
  showCoords: Boolean
  buttonsHover: Boolean
  hide: Hide
  drawerOn: Boolean
  drawerColumns: Integer
}
