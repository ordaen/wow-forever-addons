// The minimap on the stand-in client with a stand-in game: where everything stands after each step, what it asked
// of the game, and the game's own frames it hides, takes or lays its own over.
import Client from "$client"
import Game from "$game"
import Test from "$test"
import Runtime from "$runtime"
import root Minimap from "OrdaenMinimap"
import { RingId } from "@/ring"

// One of the game's own frames, in the screen's top right corner.
function blizzard(name: String, width: Number, height: Number, shown: Boolean): any Client.Frame {
  let ui = Client.C_UI.GetUIParent()
  let frame = Client.CreateFrame("Button", name, ui, nil)
  frame.SetSize(width, height)
  frame.SetPoint("TOPRIGHT", ui, "TOPRIGHT", 0, 0)
  frame.SetShown(shown)
  return frame
}

// The minimap stands on the screen as a part of its own, at its top right: the middle of its map, and of the
// ring's first and third buttons.
const MAP: Test.Point = { x: 1461.83, y: 163.17 }
const TRACKING: Test.Point = { x: 1337.83, y: 118.03 }
const DRAWER: Test.Point = { x: 1337.83, y: 287.17 }
// The coordinates and the clock in the strip under the map.
const COORDS: Test.Point = { x: 1400, y: 285 }
const CLOCK: Test.Point = { x: 1547, y: 285 }

// The angle round the frame's middle, the map's, of a point on the screen: degrees from the top, clockwise.
function angleOf(at: Test.Point): Number {
  let cx = at.x - MAP.x
  let cy = at.y - MAP.y
  return ((cx.atan2(-cy).deg() + 360) % 360 + 0.5).floor()
}

// A ring button follows the cursor round the frame each frame of the drag: its angle is the cursor's, never one read
// against where the last frame moved it (which swung it back and forth across the ring).
test "a ring button dragged round the frame follows the cursor, frame after frame" {
  let map = blizzard("Minimap", 140, 140, true)
  let tracking = blizzard("MinimapTrackingButton", 32, 32, true)
  Game.minimap.frame = map
  Game.frames.MinimapTrackingButton = tracking
  Test.mount(nil, { left: 100, top: 50, width: 600, height: 800, screen: true })
  Test.flush()
  // The ring shows while the cursor is on the map.
  Test.moveTo(MAP)
  Test.moveTo(TRACKING)
  Test.press(nil)
  // The client starts the drag once the cursor has moved.
  Test.moveTo({ x: TRACKING.x, y: TRACKING.y + 1 })
  Test.pass(0.02)
  let last: Test.Point = TRACKING
  for (step of 1..=10) {
    last = { x: TRACKING.x - step, y: TRACKING.y + step * 5 }
    Test.moveTo(last)
    Test.pass(0.02)
    Test.expect(Minimap.dragging == RingId.Tracking && Minimap.dragAngle == angleOf(last))
  }
  Test.release(nil)
  Test.expect(Minimap.dragging == nil && Minimap.angles[RingId.Tracking] == angleOf(last))
  Test.shot("the tracking button dragged down the frame's left side, short of the Ordaen button: it stands where it was let go")
}

// The one list of the game's parts the minimap replaces: each hidden and off the screen, where the game showing it
// again (the zoom buttons as the cursor comes onto the map) puts nothing in sight or under the cursor; the wheel
// zooms instead.
test "the game's parts the minimap replaces stay out of sight when the game shows them again" {
  let cluster = blizzard("MinimapCluster", 200, 220, true)
  let backdrop = blizzard("MinimapBackdrop", 200, 200, true)
  let zoomIn = blizzard("MinimapZoomIn", 20, 20, true)
  let zoomOut = blizzard("MinimapZoomOut", 20, 20, true)
  let zoomArea = blizzard("MinimapZoomHitArea", 40, 80, true)
  let gear = blizzard("OrdaenDevButton", 31, 31, true)
  Game.frames.MinimapCluster = cluster
  Game.frames.MinimapBackdrop = backdrop
  Game.frames.MinimapZoomIn = zoomIn
  Game.frames.MinimapZoomOut = zoomOut
  Game.frames.MinimapZoomHitArea = zoomArea
  Game.frames.OrdaenDevButton = gear
  Test.mount(nil, { left: 100, top: 50, width: 600, height: 800, screen: true })
  Test.flush()
  Test.expect(Minimap.hidden.length == 6)
  const parts = [cluster, backdrop, zoomIn, zoomOut, zoomArea, gear]
  for (part of parts) {
    Test.expect(!part.IsShown())
    part.Show()
  }
  Test.flush()
  for (part of parts) {
    Test.expect((part.GetRight() ?? 0) < 0)
  }
}

test "the minimap takes the game's map, and its ring and drawer answer the cursor" {
  let cluster = blizzard("MinimapCluster", 200, 220, true)
  let backdrop = blizzard("MinimapBackdrop", 200, 200, true)
  let map = blizzard("Minimap", 140, 140, true)
  let tracking = blizzard("MinimapTrackingButton", 32, 32, true)
  let mail = blizzard("MinimapMail", 32, 32, false)
  let other = blizzard("OtherAddonButton", 31, 31, true)
  Game.minimap.frame = map
  Game.frames.MinimapCluster = cluster
  Game.frames.MinimapBackdrop = backdrop
  Game.frames.MinimapTrackingButton = tracking
  Game.frames.MinimapMail = mail
  Game.minimap.buttons = [other]
  Game.minimap.entries = [{ text: "Details", icon: "Interface/Icons/Details" }, { text: "Plater" }]
  let shown = (): String => `cluster shown: ${cluster.IsShown()}, backdrop shown: ${backdrop.IsShown()}`

  // The module's root, made as its addon loaded and drawn by Ordaen on the screen, which this page is.
  Test.mount(nil, { left: 100, top: 50, width: 600, height: 800, screen: true })
  Test.shot("drawn in the screen's top right corner: the game's cluster hidden, its map in our frame, the ring not shown")
  Test.note(shown())

  Test.moveTo(MAP)
  Test.shot("the cursor on the map: the ring shows")
  Test.note(shown())

  Test.moveTo(TRACKING)
  Test.shot("the cursor on the first ring button, the game's tracking: its hover is passed on")
  Test.note(shown())

  // The minimap stands in the screen's top right corner: each tooltip of ours hangs under what it explains, by its
  // right edge, on the screen.
  Test.moveTo(COORDS)
  Test.shot("the cursor on the coordinates: their tooltip under them, on the screen")
  Test.moveTo(CLOCK)
  Test.shot("the cursor on the clock: its tooltip under it, by its right edge")
  Test.moveTo(MAP)

  Test.click(DRAWER, nil)
  Test.shot("the drawer's button clicked: the drawer hangs under it with another addon's button and the addon menu's entries")
  Test.note(shown())

  Game.clock.invites = 2
  Game.location.pvp = Game.Pvp.Contested
  Game.location.zone = "Stranglethorn Vale"
  Test.shot("the game's news: invites wait, the zone and its colour change")
  Test.note(shown())

  Game.minimap.entries = []
  Game.minimap.buttons = []
  Test.shot("nothing left for the drawer to hold: its button goes, and the drawer with it")
  Test.note(shown())

  (Runtime.Addon.of(Minimap) ?? panic("the minimap is installed")).disable()
  Test.expect(Test.blank())
  Test.shot("turned off: its root ended, what it drew gone")
  Test.note(`${shown()}, the map's parent is the game's again: ${map.GetParent() == Client.C_UI.GetUIParent()}`)
}
