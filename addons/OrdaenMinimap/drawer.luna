// One entry of the addon menu in the drawer: its icon in a cell, its name reported while the cursor is on it.
import Game from "$game"
import { Align, Art, Click } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, PX } from "Ordaen"

const CELL = 34 * PX
const ICON = CELL - 4 * PX

public class DrawerEntry implements Component {
  public hover: Event<String> = new Event()
  public leave: Event<nil> = new Event()

  // Ordaen's art: its root is there before this module loads.
  derived icon: Art = self.entry.icon ?? "Interface/Icons/INV_Misc_QuestionMark"

  entry: Signal<Game.Entry>
  constructor(entry: Signal<Game.Entry>) {
    self.entry = entry
  }

  onClick(mut self, click: Click) { Game.minimap.runEntry(self.entry, click.button) }
  onEnter(mut self) { self.hover.emit(self.entry.text) }
  onLeave(mut self) { self.leave.emit() }

  public render(self): Template {
    return $ltml {
      <box width={CELL} height={CELL} xAlign={Align.Center} yAlign={Align.Center}
           border={Ordaen.art.panel.slotEdge} @click={self.onClick} @enter={self.onEnter} @leave={self.onLeave}>
        <box width={ICON} height={ICON} background={self.icon} />
      </box>
    }
  }
}
