// One entry of the addon menu in the drawer: its icon in a cell, its name reported while the cursor is on it.
import Game from "$game"
import { Align, Art, Click } from "$ltml"
import Ordaen from "Ordaen"
import { PX } from "OrdaenLibrary"

private const CELL = 34 * PX
private const ICON = CELL - 4 * PX

public class DrawerEntry implements Ordaen::Component {
  public hover: Event<string> = $event()
  public leave: Event<nil> = $event()

  private icon = $computed((): Art => self.entry.icon ?? $asset("Interface/Icons/INV_Misc_QuestionMark"))

  $constructor(private entry: Reactive<Game::Entry>) {}

  private mut onClick(click: Click) { Game::Minimap::runEntry(self.entry, click.button) }
  private mut onEnter() { self.hover.emit(self.entry.text) }
  private mut onLeave() { self.leave.emit() }

  public render(): Template {
    return $ltml {
      <box width={CELL} height={CELL} xAlign={Align::Center} yAlign={Align::Center}
           border={Ordaen::theme.panel.slotEdge} @click={self.onClick} @enter={self.onEnter} @leave={self.onLeave}>
        <box width={ICON} height={ICON} background={self.icon} />
      </box>
    }
  }
}
