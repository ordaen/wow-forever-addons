package-as: OrdaenMinimap

# CHANGELOG.md is written by release-please; ship it instead of a generated git log.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - version.txt

# CurseForge/Wago project slugs; the app installs these together with this addon.
required-dependencies:
  - ordaen-core
