// The minimap's tabs in the settings window: «Map» and «Button drawer». Each control writes one entry of the
// settings, at once.
import { Checkbox, Component, Settings, Slider, Switch, Unit, VisibilityRows } from "Ordaen"
import { Choices } from "@/choices"
import Locale from "@/locales"

public class MapPage implements Component {
  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Slider label={Locale.MINIMAP_SCALE} hint={Locale.MINIMAP_SCALE_TIP} value={mut self.settings.values.scale}
              least={0.8} most={1.6} step={0.05} unit={Unit.Percent} />
      <Checkbox label={Locale.MINIMAP_SHOWZONE} hint={Locale.MINIMAP_SHOWZONE_TIP}
                value={mut self.settings.values.showZone} />
      <Checkbox label={Locale.MINIMAP_SHOWCLOCK} hint={Locale.MINIMAP_SHOWCLOCK_TIP}
                value={mut self.settings.values.showClock} />
      <Checkbox label={Locale.MINIMAP_SHOWCOORDS} hint={Locale.MINIMAP_SHOWCOORDS_TIP}
                value={mut self.settings.values.showCoords} />
      <Checkbox label={Locale.MINIMAP_BUTTONSHOVER} hint={Locale.MINIMAP_BUTTONSHOVER_TIP}
                value={mut self.settings.values.buttonsHover} />
      <VisibilityRows value={mut self.settings.values.visibility} />
    }
  }
}

public class DrawerPage implements Component {
  derived drawerOff: Boolean = !self.settings.values.drawerOn

  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Switch label={Locale.MINIMAP_DRAWERON} hint={Locale.MINIMAP_DRAWERON_TIP}
              value={mut self.settings.values.drawerOn} />
      <Slider label={Locale.MINIMAP_DRAWERCOLUMNS} hint={Locale.MINIMAP_DRAWERCOLUMNS_TIP}
              value={mut self.settings.values.drawerColumns} least={2} most={12} disabled={self.drawerOff} />
    }
  }
}
