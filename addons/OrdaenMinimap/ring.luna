// The ring: the buttons round the map. The game's own (tracking, mail, crafting orders, the expansion's page) stay
// the game's: each lies invisible under ours, which passes its clicks and its hover on.
import Game from "$game"
import { Align, Art, Click, Drag, Frame, MouseButton, Position, Shadow } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, PX, Tip } from "Ordaen"
import type { Minimap, Hint } from "@/main"

public enum RingId { Tracking = "tracking", Ordaen = "ordaen", Drawer = "drawer", Mail = "mail", CraftingOrder = "craftingOrder", Landing = "landing" }

public struct RingSpec {
  id: RingId
  // Where it stands unless the player moved it: degrees from the top, clockwise.
  angle: Number
  // The glyph drawn on ours: one of the game's own, in its own proportions.
  glyph: Art | nil
  glyphWidth: Number = 0
  glyphHeight: Number = 0
}

public const BUTTON: Number = 34 * PX
// Room round the frame for the ring: 16 px out to a button's centre, 17 its radius.
public const ROOM: Number = 33 * PX

// Ours, which other parts of the minimap stand by: the tooltip beside the Ordaen button, the drawer under its own.
public const ORDAEN_BUTTON: RingSpec = { id: RingId.Ordaen, angle: 250 }
public const DRAWER_BUTTON: RingSpec = { id: RingId.Drawer, angle: 225 }

public const RING: Array<RingSpec> = [
  { id: RingId.Tracking, angle: 290, glyph: "ui-hud-minimap-tracking-up", glyphWidth: 16 * PX, glyphHeight: 15 * PX },
  ORDAEN_BUTTON,
  DRAWER_BUTTON,
  { id: RingId.Mail, angle: 65, glyph: "ui-hud-minimap-mail-up", glyphWidth: 18 * PX, glyphHeight: 13.5 * PX },
  { id: RingId.CraftingOrder, angle: 85 },
  { id: RingId.Landing, angle: 120 },
]

const GOLD: Color = Color.hex("#ffd100")
const COUNT_SHADOW: Shadow = { color: Color.hex("#000000"), x: 1, y: -1 }

public class RingButton implements Component {
  // In the frame's box, whose places start at its line (`artOrigin`), ROOM in from the minimap's whole.
  derived left: Number = self.map.ringLeft(self.spec) - ROOM
  derived top: Number = self.map.ringTop(self.spec) - ROOM
  derived opacity: Number = self.map.ringOpacity()
  // The game's button under ours, where there is one.
  derived theirs: any Frame | nil = self.frameOf()
  derived visible: Boolean = self.shownNow()
  // Ordaen's art: its root is there before this module loads.
  derived art: Art = self.spec.id == RingId.Drawer && self.map.isDrawerOpen() ? Ordaen.art.minimap.ringLit : Ordaen.art.minimap.ring
  derived count: String = String.of(self.map.holds())
  // Ours shows its tooltip beside it (the game's buttons show their own).
  derived hinted: Boolean = self.hintNow()

  const spec: RingSpec
  map: mut Minimap
  constructor(spec: RingSpec, map: mut Minimap) {
    self.spec = spec
    self.map = map
  }

  frameOf(self): any Frame | nil {
    match (self.spec.id) {
      RingId.Tracking => return Game.frames.MinimapTrackingButton,
      RingId.Mail => return Game.frames.MinimapMail,
      RingId.CraftingOrder => return Game.frames.MinimapCraftingOrder,
      RingId.Landing => return Game.frames.ExpansionLandingPageMinimapButton,
      RingId.Ordaen, RingId.Drawer => return nil,
    }
    return nil
  }

  // The game's buttons show only while theirs would (the mail while there is mail); the drawer only while it is on
  // and holds something.
  shownNow(self): Boolean {
    match (self.spec.id) {
      RingId.Ordaen, RingId.Tracking => return true,
      RingId.Drawer => return self.map.isDrawerOn() && self.map.holds() > 0,
      else => {
        let frame = self.theirs
        return frame != nil && frame.IsShown()
      },
    }
    return true
  }

  hintNow(self): Boolean {
    match (self.spec.id) {
      RingId.Ordaen => return self.map.hinting(Hint.Ordaen),
      RingId.Drawer => return self.map.hinting(Hint.Drawer),
      else => return false,
    }
    return false
  }

  onClick(mut self, click: Click) {
    let frame = self.theirs
    match (self.spec.id) {
      RingId.Ordaen => { if (click.button == MouseButton.Right) { Ordaen.toggleDev() } else { Ordaen.toggleSettings(nil) } },
      RingId.Drawer => { self.map.toggleDrawer() },
      else => { if (frame != nil) { Game.minimap.press(frame, click.button) } },
    }
  }

  onEnter(mut self) {
    let frame = self.theirs
    if (frame != nil) {
      Game.minimap.hover(frame, true)
    } else if (self.spec.id == RingId.Drawer) {
      self.map.showHint(Hint.Drawer)
    } else {
      self.map.showHint(Hint.Ordaen)
    }
  }

  onLeave(mut self) {
    let frame = self.theirs
    if (frame != nil) { Game.minimap.hover(frame, false) } else { self.map.showHint(Hint.None) }
  }

  onDragStart(mut self) { self.map.startDrag(self.spec) }
  onDrag(mut self, drag: Drag) { self.map.dragTo(drag.x, drag.y) }
  onDragStop(mut self) { self.map.stopDrag(self.spec) }

  public render(self): Template {
    return $ltml {
      <$if={self.visible}>
        <embed $if={self.theirs != nil} frame={self.theirs} position={Position.Absolute} left={self.left}
               top={self.top} width={BUTTON} height={BUTTON} opacity={0} />
        // Over the game's own button, which lies under it unseen, and over the map: the mouse is this box's.
        <box position={Position.Absolute} left={self.left} top={self.top} width={BUTTON} height={BUTTON}
             zLevel={1} opacity={self.opacity} xAlign={Align.Center} yAlign={Align.Center} background={self.art}
             @click={self.onClick} @dragStart={self.onDragStart} @drag={self.onDrag} @dragStop={self.onDragStop}
             @enter={self.onEnter} @leave={self.onLeave}>
          <box $if={self.spec.id == RingId.Ordaen} width={22 * PX} height={22 * PX} icon={Ordaen.icon}
               mask={Ordaen.art.panel.faceRound} />
          <text $elseif={self.spec.id == RingId.Drawer} value={self.count} textColor={GOLD}
                textFont={.Numbers} textShadow={COUNT_SHADOW} wrap={false} />
          <box $elseif={self.spec.glyph != nil} width={self.spec.glyphWidth} height={self.spec.glyphHeight}
               background={self.spec.glyph} />
          <Tip $if={self.hinted} title={self.map.hintTitle} text={self.map.hintText} />
        </box>
      </>
    }
  }
}
