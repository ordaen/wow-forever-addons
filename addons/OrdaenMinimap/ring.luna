// The ring: the buttons round the map. The game's own (tracking, mail, crafting orders, the expansion's page) stay
// the game's: each lies invisible under ours, which passes its clicks and its hover on.
import Game from "$game"
import String from "$string"
import { Align, Art, Click, Drag, Frame, MouseButton, Position, Shadow } from "$ltml"
import Ordaen from "Ordaen"
import { PX } from "OrdaenLibrary"
import type { Minimap, Hint } from "@/main"

public enum RingId { Tracking = "tracking", Ordaen = "ordaen", Drawer = "drawer", Mail = "mail", CraftingOrder = "craftingOrder", Landing = "landing" }

public struct RingSpec {
  id: RingId
  // Where it stands unless the player moved it: degrees from the top, clockwise.
  angle: number
  // The glyph drawn on ours: one of the game's own, in its own proportions.
  glyph: Art | nil
  glyphWidth: number = 0
  glyphHeight: number = 0
}

public const BUTTON = 34 * PX
// Room round the frame for the ring: 16 px out to a button's centre, 17 its radius.
public const ROOM = 33 * PX

// Ours, which other parts of the minimap stand by: the tooltip beside the Ordaen button, the drawer under its own.
public const ORDAEN_BUTTON: RingSpec = { id: RingId::Ordaen, angle: 250 }
public const DRAWER_BUTTON: RingSpec = { id: RingId::Drawer, angle: 225 }

public const RING: Array<RingSpec> = [
  { id: RingId::Tracking, angle: 290, glyph: $atlas("ui-hud-minimap-tracking-up"), glyphWidth: 16 * PX, glyphHeight: 15 * PX },
  ORDAEN_BUTTON,
  DRAWER_BUTTON,
  { id: RingId::Mail, angle: 65, glyph: $atlas("ui-hud-minimap-mail-up"), glyphWidth: 18 * PX, glyphHeight: 13.5 * PX },
  { id: RingId::CraftingOrder, angle: 85 },
  { id: RingId::Landing, angle: 120 },
]

private const GOLD = $color("#ffd100")
private const COUNT_SHADOW: Shadow = { color: $color("#000000"), x: 1, y: -1 }

public class RingButton implements Ordaen::Component {
  private left = $computed((): number => self.map.ringLeft(self.spec))
  private top = $computed((): number => self.map.ringTop(self.spec))
  private opacity = $computed((): number => self.map.ringOpacity())
  // The game's button under ours, where there is one.
  private theirs = $computed((): Frame | nil => self.frameOf())
  private visible = $computed((): boolean => self.shownNow())
  private art = $computed((): Art =>
    self.spec.id == RingId::Drawer && self.map.isDrawerOpen() ? Ordaen::theme.minimap.ringLit : Ordaen::theme.minimap.ring)
  private count = $computed((): string => String::of(self.map.holds()))

  $constructor(private const spec: RingSpec, private mut map: Minimap) {}

  private frameOf(): Frame | nil {
    switch (self.spec.id) {
      case RingId::Tracking: return Game::Frames::MinimapTrackingButton
      case RingId::Mail: return Game::Frames::MinimapMail
      case RingId::CraftingOrder: return Game::Frames::MinimapCraftingOrder
      case RingId::Landing: return Game::Frames::ExpansionLandingPageMinimapButton
      case RingId::Ordaen, RingId::Drawer: return nil
    }
    return nil
  }

  // The game's buttons show only while theirs would (the mail while there is mail); the drawer only while it is on
  // and holds something.
  private shownNow(): boolean {
    switch (self.spec.id) {
      case RingId::Ordaen, RingId::Tracking: return true
      case RingId::Drawer: return self.map.isDrawerOn() && self.map.holds() > 0
      default:
        let frame = self.theirs
        return frame != nil && frame.IsShown()
    }
    return true
  }

  private mut onClick(click: Click) {
    let frame = self.theirs
    switch (self.spec.id) {
      case RingId::Ordaen:
        if (click.button == MouseButton::Right) { Ordaen::toggleDev() } else { Ordaen::toggleSettings() }
      case RingId::Drawer: self.map.toggleDrawer()
      default:
        if (frame != nil) { Game::Minimap::press(frame, click.button) }
    }
  }

  private mut onEnter() {
    let frame = self.theirs
    if (frame != nil) {
      Game::Minimap::hover(frame, true)
    } else if (self.spec.id == RingId::Drawer) {
      self.map.showHint(Hint::Drawer)
    } else {
      self.map.showHint(Hint::Ordaen)
    }
  }

  private mut onLeave() {
    let frame = self.theirs
    if (frame != nil) { Game::Minimap::hover(frame, false) } else { self.map.showHint(Hint::None) }
  }

  private mut onDragStart() { self.map.startDrag(self.spec) }
  private mut onDrag(drag: Drag) { self.map.dragTo(drag.x, drag.y) }
  private mut onDragStop() { self.map.stopDrag(self.spec) }

  public render(): Template {
    return $ltml {
      <$if={self.visible}>
        <embed $if={self.theirs != nil} frame={self.theirs} position={Position::Absolute} left={self.left}
               top={self.top} width={BUTTON} height={BUTTON} opacity={0} />
        <box position={Position::Absolute} left={self.left} top={self.top} width={BUTTON} height={BUTTON}
             opacity={self.opacity} xAlign={Align::Center} yAlign={Align::Center} background={self.art}
             @click={self.onClick} @dragStart={self.onDragStart} @drag={self.onDrag} @dragStop={self.onDragStop}
             @enter={self.onEnter} @leave={self.onLeave}>
          <box $if={self.spec.id == RingId::Ordaen} width={22 * PX} height={22 * PX} background={Ordaen::icon}
               mask={Ordaen::theme.panel.faceRound} />
          <text $elseif={self.spec.id == RingId::Drawer} value={self.count} textColor={GOLD} textSize={14 * PX}
                textFamily={Ordaen::theme.font.numbers} textShadow={COUNT_SHADOW} wrap={false} />
          <box $elseif={self.spec.glyph != nil} width={self.spec.glyphWidth} height={self.spec.glyphHeight}
               background={self.spec.glyph} />
        </box>
      </>
    }
  }
}
