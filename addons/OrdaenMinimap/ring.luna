// The ring: the buttons round the map. The game's own (tracking, mail, crafting orders, the expansion's page) stay
// the game's: each lies invisible under ours, which passes its clicks and its hover on.
import Game from "$game"
import { Align, Art, Event, Frame, MouseButton, Position, Shadow } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, Tip } from "Ordaen"
import type { Hint, Minimap } from "@/main"

public enum RingId { Tracking = "tracking", Ordaen = "ordaen", Drawer = "drawer", Mail = "mail", CraftingOrder = "craftingOrder", Landing = "landing" }

public struct RingSpec {
  id: RingId
  // Where it stands unless the player moved it: degrees from the top, clockwise.
  angle: Number
  // The glyph drawn on ours: one of the game's own, in its own proportions.
  glyph: Art | nil
  glyphWidth: Number<Length> = 0ui
  glyphHeight: Number<Length> = 0ui
  // Its side: a ring button's, the mail's larger.
  size: Number<Length> = BUTTON
}

public const BUTTON: Number<Length> = 39.84375dp
// Room round the frame for the ring: 16 px out to a button's centre, 17 its radius.
public const ROOM: Number<Length> = 38.671875dp
// Mail waiting stands out: its button and glyph a third larger than the others.
const MAIL_BUTTON: Number<Length> = BUTTON * 4 / 3

// Ours, which other parts of the minimap stand by: the tooltip beside the Ordaen button, the drawer under its own.
public const ORDAEN_BUTTON: RingSpec = { id: RingId.Ordaen, angle: 250 }
public const DRAWER_BUTTON: RingSpec = { id: RingId.Drawer, angle: 225 }

public const RING: Array<RingSpec> = [
  { id: RingId.Tracking, angle: 290, glyph: "ui-hud-minimap-tracking-up", glyphWidth: 18.75dp, glyphHeight: 17.578125dp },
  ORDAEN_BUTTON,
  DRAWER_BUTTON,
  {
    id: RingId.Mail, angle: 65, glyph: "ui-hud-minimap-mail-up", glyphWidth: 21.09375dp * 4 / 3,
    glyphHeight: 15.8203125dp * 4 / 3, size: MAIL_BUTTON
  },
  { id: RingId.CraftingOrder, angle: 85 },
  { id: RingId.Landing, angle: 120 }
]

const GOLD: Color = Color.hex("#ffd100")
const COUNT_SHADOW: Shadow = { color: Color.hex("#000000"), x: 1ui, y: -1ui }

public class RingButton implements Component {
  // In the frame's box, whose places start at its line (`artOrigin`).
  derived left: Number<Length> = self.map.ringLeft(self.spec)
  derived top: Number<Length> = self.map.ringTop(self.spec)
  derived opacity: Number = self.map.ringOpacity(self.spec)
  // The game's button under ours, where there is one.
  derived theirs: any Frame | nil = self.frameOf()
  derived visible: Boolean = self.shownNow()
  // Ordaen's art: its root is there before this module loads.
  derived art: Art = self.spec.id == RingId.Drawer && self.map.isDrawerOpen() ? Ordaen.art.minimap.ringLit : Ordaen.art.minimap.ring
  derived count: String = String.of(self.map.holds())
  // Ours shows its tooltip beside it (the game's buttons show their own).
  derived hinted: Boolean = self.hintNow()

  spec: Signal<RingSpec>
  map: mut Minimap
  constructor(spec: Signal<RingSpec>, map: mut Minimap) {
    self.spec = spec
    self.map = map
  }

  frameOf(self): any Frame | nil {
    return match (self.spec.id) {
      RingId.Tracking => Game.frames.MinimapTrackingButton
      RingId.Mail => Game.frames.MinimapMail
      RingId.CraftingOrder => Game.frames.MinimapCraftingOrder
      RingId.Landing => Game.frames.ExpansionLandingPageMinimapButton
      RingId.Ordaen, RingId.Drawer => nil
    }
  }

  // The game's buttons show only while theirs would, the mail while there is mail (the client says so by its event:
  // its frame's showing is told nothing); the drawer only while it is on
  // and holds something.
  shownNow(self): Boolean {
    let frame = self.theirs
    return match (self.spec.id) {
      RingId.Ordaen, RingId.Tracking => true
      RingId.Mail => self.map.hasMail()
      RingId.Drawer => self.map.isDrawerOn() && self.map.holds() > 0
      else => frame != nil && frame.IsShown()
    }
  }

  hintNow(self): Boolean {
    return match (self.spec.id) {
      RingId.Ordaen => self.map.hinting(Hint.Ordaen)
      RingId.Drawer => self.map.hinting(Hint.Drawer)
      else => false
    }
  }

  onClick(mut self, click: Event.Press) {
    let frame = self.theirs
    match (self.spec.id) {
      RingId.Ordaen => { if (click.button == MouseButton.Right) { Ordaen.toggleDev() } else { Ordaen.toggleSettings(nil) } }
      RingId.Drawer => { self.map.toggleDrawer() }
      else => { if (frame != nil) { Game.minimap.press(frame, click.button) } }
    }
  }

  onEnter(mut self) { self.hover(true) }
  onLeave(mut self) { self.hover(false) }

  // Ours show their tooltip; the game's own button under ours hears the cursor, where there is one.
  hover(mut self, on: Boolean) {
    let frame = self.theirs
    if (frame != nil) {
      Game.minimap.hover(frame, on)
    } else if (!on) {
      self.map.showHint(Hint.None)
    } else if (self.spec.id == RingId.Drawer) {
      self.map.showHint(Hint.Drawer)
    } else if (self.spec.id == RingId.Ordaen) {
      self.map.showHint(Hint.Ordaen)
    }
  }

  onDragStart(mut self, drag: Event.Drag) { self.map.startDrag(self.spec, drag.dx, drag.dy) }
  onDrag(mut self, drag: Event.Drag) { self.map.dragTo(drag.dx, drag.dy) }
  onDragStop(mut self) { self.map.stopDrag(self.spec) }

  public render(self): Template {
    return $ltml {
      <$if={self.visible}>
        <embed $if={self.theirs != nil} frame={self.theirs} position={Position.Absolute} left={self.left}
               top={self.top} width={self.spec.size} height={self.spec.size} opacity={0} />
        // Over the game's own button, which lies under it unseen, and over the map: the mouse is this box's.
        <box position={Position.Absolute} left={self.left} top={self.top} width={self.spec.size} height={self.spec.size}
             zLevel={1} opacity={self.opacity} xAlign={Align.Center} yAlign={Align.Center} background={self.art}
             @pointerPress={self.onClick} @dragStart={self.onDragStart} @drag={self.onDrag} @dragStop={self.onDragStop}
             @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
          <box $if={self.spec.id == RingId.Ordaen} width={25.78125dp} height={25.78125dp} icon={Ordaen.icon}
               mask={Ordaen.art.panel.faceRound} />
          <text $elseif={self.spec.id == RingId.Drawer} value={self.count} textColor={GOLD}
                textFont={.Numbers} textShadow={COUNT_SHADOW} wrap={.None} />
          <box $elseif={self.spec.glyph != nil} width={self.spec.glyphWidth} height={self.spec.glyphHeight}
               background={self.spec.glyph} />
          <Tip $if={self.hinted} title={self.map.hintTitle} text={self.map.hintText} keys={self.map.hintKeys} />
        </box>
      </>
    }
  }
}
