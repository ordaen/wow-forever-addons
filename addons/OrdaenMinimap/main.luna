import Game from "$game"
import { Align, Anchored, Click, EmbedLook, Line, MouseButton, Point, Position, Shadow } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { Module, Placed, PX, Settings, SettingsPage, Tip } from "Ordaen"
import Locale from "@/locales"
import { DrawerEntry } from "@/drawer"
import { RING, DRAWER_BUTTON, RingButton, RingId, RingSpec, BUTTON, ROOM } from "@/ring"

import { Choices, Hide } from "@/choices"
import { DrawerPage, MapPage } from "@/settings"

// Which tooltip shows.
public enum Hint { None = "none", Zone = "zone", Coords = "coords", Clock = "clock", Ordaen = "ordaen", Drawer = "drawer", Entry = "entry" }

// The map at «Map size» 100%.
const MAP = 262 * PX
// The zone's strip above, the coordinates' and clock's below.
const STRIP = 30 * PX
// From the frame's side to a ring button's centre.
const RING_OUT = 16 * PX
const CELL = 34 * PX
const CELL_GAP = 4 * PX
const DRAWER_PAD = 6 * PX
const GOLD: Color = Color.hex("#ffd100")
const INK: Color = Color.hex("#f3e1b8")
// The clock while calendar invites wait.
const PENDING: Color = Color.hex("#ff9a2e")
// Dark up-left, as the windows' titles.
const ENGRAVED: Shadow = { color: Color.hex("#000000e6"), x: -1, y: 1 }
const RULE: Color = Color.hex("#120c06")
// A strip's rule towards the map.
const RULE_BELOW: Line = { width: 2 * PX, color: RULE, sides: ["bottom"] }
const RULE_ABOVE: Line = { width: 2 * PX, color: RULE, sides: ["top"] }

// Where the map stands until the player moves it: the screen's top right corner.
const HOME: Anchored = { point: Point.TopRight }

public class Minimap implements Module, App {
  public const title: String = "Ordaen Minimap"

  settings: mut Settings<Choices> = new Settings<Choices>({
    scale: 1, showZone: true, showClock: true, showCoords: true, buttonsHover: true, hide: Hide.Never,
    drawerOn: true, drawerColumns: 4,
  })
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_MAP, content: $ltml { <MapPage settings={mut self.settings} /> } },
    { title: Locale.TAB_DRAWER, content: $ltml { <DrawerPage settings={mut self.settings} /> } },
  ]
  // The ring buttons' angles as the player left them: degrees from the top, clockwise.
  state angles: mut Map<RingId, Number> = {}
  state hovered = false
  state drawerOpen = false
  // The ring button being dragged, and its angle meanwhile.
  state dragging: RingId | nil = nil
  state dragAngle: Number = 0
  dragLeft: Number = 0
  dragTop: Number = 0
  state hint: Hint = Hint.None
  state entryName = ""

  // The frame's metal: the map sits inside its wood, the line's width and the wood's inset in from the line.
  derived out: Number = Ordaen.art.frame.small.width + Ordaen.art.frame.small.inset
  derived size: Number = MAP * self.settings.values.scale
  derived headHeight: Number = self.settings.values.showZone ? STRIP : 0
  derived hasFoot: Boolean = self.settings.values.showCoords || self.settings.values.showClock
  derived footHeight: Number = self.hasFoot ? STRIP : 0
  derived frameWidth: Number = self.size + 2 * self.out
  derived frameHeight: Number = self.size + 2 * self.out + self.headHeight + self.footHeight
  derived wholeWidth: Number = self.frameWidth + 2 * ROOM
  derived wholeHeight: Number = self.frameHeight + 2 * ROOM
  // The metal stands past its line, and the frame's box holds it: the box starts that far out.
  derived frameLeft: Number = ROOM - Ordaen.art.frame.small.reach.left * Ordaen.art.frame.small.scale
  derived frameTop: Number = ROOM - Ordaen.art.frame.small.reach.top * Ordaen.art.frame.small.scale
  derived mapTop: Number = self.out + self.headHeight

  derived showsCoords: Boolean = self.settings.values.showCoords && Game.minimap.coords != ""
  derived zoneColor: Color = self.colorOf()
  derived clockColor: Color = Game.clock.invites > 0 ? PENDING : INK
  // The map goes back into the game's hidden cluster while the player fights or travels, as chosen.
  derived shown: Boolean = !self.hiddenNow()

  // The drawer: its cells, and where it hangs from its button.
  derived held: Integer = Game.minimap.buttons.length + Game.minimap.entries.length
  derived drawerShown: Boolean = self.settings.values.drawerOn && self.drawerOpen
  derived drawerParked: Boolean = self.settings.values.drawerOn && !self.drawerOpen
  // Its cells, the room round them and its frame's line on both sides.
  derived drawerEdge: Number = 2 * DRAWER_PAD + 2 * Ordaen.art.frame.small.width
  derived drawerWidth: Number = self.settings.values.drawerColumns * CELL + (self.settings.values.drawerColumns - 1) * CELL_GAP + self.drawerEdge
  derived drawerRows: Integer = (1).max((self.held / self.settings.values.drawerColumns).ceil())
  derived drawerHeight: Number = self.drawerRows * CELL + (self.drawerRows - 1) * CELL_GAP + self.drawerEdge
  derived drawerLeft: Number = self.ringLeft(DRAWER_BUTTON) + BUTTON - self.drawerWidth
  derived drawerTop: Number = self.ringTop(DRAWER_BUTTON) + BUTTON + 2 * PX

  // The tooltip of what the cursor is on: written in that part's box, it stands beside it on the screen.
  public derived hintTitle: String = self.titleOf()
  public derived hintText: String = self.textOf()
  // Ordaen's art: its root is there before this module loads.

  constructor() {
    Game.minimap.square(true)
    Game.minimap.wheelZoom()
    Ordaen.modules.add(self)
  }

  destructor() {
    Game.minimap.square(false)
  }

  hiddenNow(self): Boolean {
    match (self.settings.values.hide) {
      Hide.Combat => return Game.situation.combat,
      Hide.Transport => return Game.situation.taxi || Game.situation.vehicle,
      Hide.Never => return false,
    }
    return false
  }

  // The zone's colour by its PvP status: the game's own minimap colours.
  colorOf(self): Color {
    let pvp = Game.location.pvp
    if (pvp == nil) { return GOLD }
    match (pvp) {
      Game.Pvp.Sanctuary => return Color.hex("#69ccf0"),
      Game.Pvp.Friendly => return Color.hex("#1aff1a"),
      Game.Pvp.Hostile, Game.Pvp.Combat => return Color.hex("#ff1a1a"),
      Game.Pvp.Contested => return Color.hex("#ffb300"),
    }
    return GOLD
  }

  zoneLabel(self): String {
    let pvp = Game.location.pvp
    if (pvp == nil) { return "" }
    match (pvp) {
      Game.Pvp.Sanctuary => return Locale.ZONE_SANCTUARY,
      Game.Pvp.Friendly, Game.Pvp.Hostile => return Locale.ZONE_FACTION,
      Game.Pvp.Contested => return Locale.ZONE_CONTESTED,
      Game.Pvp.Combat => return Locale.ZONE_COMBAT,
    }
    return ""
  }

  // ---- the ring, for its buttons

  // A ring button's angle: as dragged now, as the player left it, or its own.
  public angle(self, spec: RingSpec): Number {
    if (self.dragging == spec.id) { return self.dragAngle }
    return self.angles[spec.id] ?? spec.angle
  }

  // Where a ring button's centre sits, from the frame's centre: along its angle, onto the box RING_OUT round the
  // frame (a square's projection, not a circle's), rounded to hundredths.
  offset(self, spec: RingSpec): (Number, Number) {
    let t = self.angle(spec).rad()
    let x = t.sin()
    let y = -t.cos()
    let halfWidth = self.frameWidth / 2 + RING_OUT
    let halfHeight = self.frameHeight / 2 + RING_OUT
    let k = (halfWidth / x.abs().max(1e-9)).min(halfHeight / y.abs().max(1e-9))
    return (x * k * 100 + 0.5).floor() / 100, (y * k * 100 + 0.5).floor() / 100
  }

  public ringLeft(self, spec: RingSpec): Number {
    let x, y = self.offset(spec)
    return ROOM + self.frameWidth / 2 + x - BUTTON / 2
  }

  public ringTop(self, spec: RingSpec): Number {
    let x, y = self.offset(spec)
    return ROOM + self.frameHeight / 2 + y - BUTTON / 2
  }

  // Whether the ring shows: always, or with «Buttons on mouseover» while the cursor is on the minimap, a button is
  // dragged or the drawer is open.
  public ringOpacity(self): Number {
    if (!self.settings.values.buttonsHover || self.hovered || self.drawerOpen || self.dragging != nil) { return 1 }
    return 0
  }

  public isDrawerOpen(self): Boolean { return self.drawerOpen }
  public isDrawerOn(self): Boolean { return self.settings.values.drawerOn }
  public holds(self): Integer { return self.held }

  public startDrag(mut self, spec: RingSpec) {
    self.dragLeft = self.ringLeft(spec)
    self.dragTop = self.ringTop(spec)
    self.dragAngle = self.angle(spec)
    self.dragging = spec.id
    self.hint = Hint.None
  }

  // The cursor at `x`, `y` in the dragged button's box as it stood when the drag began.
  public dragTo(mut self, x: Number, y: Number) {
    let cx = self.dragLeft + x - ROOM - self.frameWidth / 2
    let cy = self.dragTop + y - ROOM - self.frameHeight / 2
    self.dragAngle = ((cx.atan2(-cy).deg() + 360) % 360 + 0.5).floor()
  }

  public stopDrag(mut self, spec: RingSpec) {
    self.angles[spec.id] = self.dragAngle
    self.dragging = nil
  }

  public toggleDrawer(mut self) { self.drawerOpen = !self.drawerOpen }
  public showHint(mut self, hint: Hint) { self.hint = hint }

  // ---- what the strips and the drawer report

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }
  onZoneEnter(mut self) { self.hint = Hint.Zone }
  onCoordsEnter(mut self) { self.hint = Hint.Coords }
  onClockEnter(mut self) { self.hint = Hint.Clock }
  onHintLeave(mut self) { self.hint = Hint.None }

  onEntryHover(mut self, name: String) {
    self.entryName = name
    self.hint = Hint.Entry
  }

  onCoordsClick(mut self, click: Click) {
    if (click.button == MouseButton.Left && Game.input.shiftDown()) { Game.minimap.sendCoords() }
  }

  onClockClick(mut self, click: Click) {
    if (click.button == MouseButton.Right) {
      Ordaen.toggleSettings(Runtime.Addon.of(self))
    } else {
      Game.clock.toggleCalendar()
    }
  }

  // ---- the tooltip of our own parts (the game's buttons show their own)

  titleOf(self): String {
    match (self.hint) {
      Hint.Zone => return Game.location.realZone,
      Hint.Coords => return Game.minimap.coords,
      Hint.Clock => return Game.clock.text,
      Hint.Ordaen => return Ordaen.title,
      Hint.Drawer => return Locale.DRAWER_TITLE,
      Hint.Entry => return self.entryName,
      Hint.None => return "",
    }
    return ""
  }

  textOf(self): String {
    match (self.hint) {
      Hint.Zone => return self.zoneLabel(),
      Hint.Coords => return Locale.COORDS_TIP,
      Hint.Clock => return Locale.CLOCK_TIP,
      Hint.Ordaen => return Ordaen.dev == true ? Locale.ORDAEN_TIP_DEV : Locale.ORDAEN_TIP,
      Hint.Drawer => return Locale.DRAWER_TIP,
      Hint.Entry, Hint.None => return "",
    }
    return ""
  }

  // The tooltip shown is this part's.
  public hinting(self, hint: Hint): Boolean { return self.hint == hint }

  public render(self): Template {
    return $ltml {
      <frame of={Game.frames.MinimapCluster} shown={false} />
      <frame of={Game.frames.MinimapBackdrop} shown={false} />
      // The dev addon's own button: the ring's Ordaen button opens its window.
      <frame of={Game.frames.OrdaenDevButton} shown={false} />

      <Placed $if={self.shown} id={"OrdaenMinimap.map"} title={Locale.MINIMAP_TITLE} home={HOME}>
        <box width={self.wholeWidth} height={self.wholeHeight} hoverWithin={true}
             @enter={self.onEnter} @leave={self.onLeave}>
          <box position={Position.Absolute} left={self.frameLeft} top={self.frameTop} width={self.frameWidth}
               height={self.frameHeight} border={Ordaen.art.frame.small} background={Ordaen.art.window.wood}
               artOrigin={true}>
            <embed frame={Game.minimap.frame} position={Position.Absolute} left={self.out} top={self.mapTop}
                   width={self.size} height={self.size} />

            <box $if={self.settings.values.showZone} position={Position.Absolute} left={self.out} top={self.out}
                 width={self.size} height={STRIP} background={Ordaen.art.window.wood} border={RULE_BELOW}
                 xAlign={Align.Center} yAlign={Align.Center}>
              <box @enter={self.onZoneEnter} @leave={self.onHintLeave}>
                <text value={Game.location.zone} textColor={self.zoneColor} textShadow={ENGRAVED}
                      wrap={false} />
                <Tip $if={self.hint == Hint.Zone} title={self.hintTitle} text={self.hintText} />
              </box>
            </box>

            <box $if={self.hasFoot} position={Position.Absolute} left={self.out} bottom={self.out} width={self.size}
                 height={STRIP} background={Ordaen.art.window.wood} border={RULE_ABOVE}
                 columns={[{ fr: 1 }, "auto"]} padding={{ left: 10 * PX, right: 10 * PX }} yAlign={Align.Center}>
              <box $if={self.showsCoords} @click={self.onCoordsClick} @enter={self.onCoordsEnter}
                   @leave={self.onHintLeave}>
                <text value={Game.minimap.coords} textColor={INK} textShadow={ENGRAVED}
                      textFamily={Ordaen.lookArt.fontNumbers} wrap={false} />
                <Tip $if={self.hint == Hint.Coords} title={self.hintTitle} text={self.hintText} />
              </box>
              <box $else width={1} />
              <box $if={self.settings.values.showClock} @click={self.onClockClick} @enter={self.onClockEnter}
                   @leave={self.onHintLeave}>
                <text value={Game.clock.text} textColor={self.clockColor} textShadow={ENGRAVED}
                      textFamily={Ordaen.lookArt.fontNumbers} wrap={false} />
                <Tip $if={self.hint == Hint.Clock} title={self.hintTitle} text={self.hintText} />
              </box>
            </box>
          </box>

          <RingButton $for={spec of RING} spec={spec} map={mut self} />

          <box $if={self.drawerShown} position={Position.Absolute} left={self.drawerLeft} top={self.drawerTop}
               width={self.drawerWidth} height={self.drawerHeight} columns={self.settings.values.drawerColumns} gap={CELL_GAP}
               padding={DRAWER_PAD} border={Ordaen.art.frame.small} background={Ordaen.art.window.wood}
               artOrigin={true} zLevel={20}>
            <embed $for={button of Game.minimap.buttons} frame={button} width={CELL} height={CELL}
                   look={EmbedLook.Icon} />
            <DrawerEntry $for={entry of Game.minimap.entries} entry={entry} @hover={self.onEntryHover}
                         @leave={self.onHintLeave} />
            <Tip $if={self.hint == Hint.Entry} title={self.hintTitle} text={self.hintText} />
          </box>
          <box $elseif={self.drawerParked} position={Position.Absolute} left={0} top={0} width={0} height={0}
               opacity={0}>
            <embed $for={button of Game.minimap.buttons} frame={button} width={CELL} height={CELL}
                   look={EmbedLook.Icon} />
          </box>
        </box>
      </Placed>
    }
  }
}
