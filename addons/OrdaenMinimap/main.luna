import Build from "$build"
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Align, Anchored, ArtBorder, EmbedLook, Event, Frame, Line, MouseButton, Overflow, Point, Position, Shadow, Side } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { ALWAYS, Module, Placed, Settings, SettingsPage, Tip, TipRow, opacityNow, reachAcross, reachDown, timeText } from "Ordaen"
import { DrawerEntry } from "@/drawer"
import Locale from "@/locales"
import { BUTTON, DRAWER_BUTTON, RING, ROOM, RingButton, RingId, RingSpec } from "@/ring"

import { Choices } from "@/choices"
import { DrawerPage, MapPage } from "@/settings"

// Which tooltip shows.
public enum Hint { None = "none", Zone = "zone", Coords = "coords", Clock = "clock", Ordaen = "ordaen", Drawer = "drawer", Entry = "entry" }

// The map at «Map size» 100%.
const MAP = 307.03125dp
// The zone's strip above, the coordinates' and clock's below.
const STRIP = 35.15625dp
// From the frame's side to a ring button's centre.
const RING_OUT = 18.75dp
const CELL = 39.84375dp
const CELL_GAP = 1sp
const DRAWER_PAD = 2sp
const GOLD: Color = Color.hex("#ffd100")
const INK: Color = Color.hex("#f3e1b8")
// The clock while calendar invites wait.
const PENDING: Color = Color.hex("#ff9a2e")
// Dark up-left, as the windows' titles.
const ENGRAVED: Shadow = { color: Color.hex("#000000e6"), x: -1ui, y: 1ui }
const RULE: Color = Color.hex("#120c06")
// A strip's rule towards the map.
const RULE_BELOW: Line = { width: 2.34375dp, color: RULE, sides: ["bottom"] }
const RULE_ABOVE: Line = { width: 2.34375dp, color: RULE, sides: ["top"] }

// Where the map stands until the player moves it: the screen's top right corner.
const HOME: Anchored = { point: Point.TopRight }
const FOLDER = "OrdaenMinimap"
// The map's part, as the placing mode keeps where the player put it.
const PART = "OrdaenMinimap.map"

public class Minimap implements Module, App {
  public const title: String = "Ordaen Minimap"

  settings: mut Settings<Choices> = new Settings<Choices>({
    scale: 1, showZone: true, showClock: true, showCoords: true, buttonsHover: true, visibility: ALWAYS,
    drawerOn: true, drawerColumns: 4
  })
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_MAP, content: $ltml { <MapPage settings={mut self.settings} /> } },
    { title: Locale.TAB_DRAWER, content: $ltml { <DrawerPage settings={mut self.settings} /> } }
  ]
  // The ring buttons' angles as the player left them: degrees from the top, clockwise.
  state angles: mut Map<RingId, Number> = {}
  state hovered = false
  state drawerOpen = false
  // The ring button being dragged, its angle meanwhile, and where its middle stood as the drag began, and its size.
  state dragging: RingId | nil = nil
  state dragAngle: Number = 0
  dragX: Number = 0
  dragY: Number = 0
  dragSize: Number<Length> = BUTTON
  state hint: Hint = Hint.None
  state entryName = ""
  // Whether the player has mail waiting (the client's `HasNewMail`, told anew with `UPDATE_PENDING_MAIL`).
  state mail: Boolean = Client.HasNewMail()

  // At home it stands in the screen's top right corner with nothing round it there: the frame's line on the screen's
  // edges, its metal on its left and bottom alone (the bottom left corner the one rounded), the ring along those two.
  derived docked: Boolean = Ordaen.moved(PART) == nil
  derived metal: ArtBorder = self.docked ? Minimap.cornered(Ordaen.art.frame.small) : Ordaen.art.frame.small
  // The frame is square at every setting: the map fills it, inside the metal's wood, and the zone's strip and the
  // coordinates' and clock's lie over the map's top and bottom.
  derived out: Number<Length> = (Ordaen.art.frame.small.width + Ordaen.art.frame.small.inset) * 1ui
  derived size: Number<Length> = MAP * self.settings.values.scale
  derived hasFoot: Boolean = self.settings.values.showCoords || self.settings.values.showClock
  derived frameSide: Number<Length> = self.size + 2 * self.out
  // The room round the frame for the ring: on all four sides, or docked, on its left and bottom.
  derived roomTop: Number<Length> = self.docked ? 0ui : ROOM
  derived wholeWidth: Number<Length> = self.frameSide + ROOM + self.roomTop
  derived wholeHeight: Number<Length> = self.frameSide + ROOM + self.roomTop
  // The metal stands past its line, and the frame's box holds it: the box starts that far out, and is that much
  // larger than its size at the line.
  derived frameLeft: Number<Length> = ROOM - self.metal.reach.left * self.metal.scale * 1ui
  derived frameTop: Number<Length> = self.docked ? 0ui : ROOM - self.metal.reach.top * self.metal.scale * 1ui
  derived frameBoxWidth: Number<Length> = self.frameSide + reachAcross(self.metal)
  derived frameBoxHeight: Number<Length> = self.frameSide + reachDown(self.metal)

  derived showsCoords: Boolean = self.settings.values.showCoords && Game.minimap.coords != ""
  derived zoneColor: Color = self.colorOf()
  derived clockColor: Color = Game.clock.invites > 0 ? PENDING : INK
  // How visible the map is, by its visibility in the state the player is in; hidden with nothing to see, it goes back
  // into the game's hidden cluster.
  derived opacity: Number = opacityNow(self.settings.values.visibility, self.hovered || self.drawerShown)
  derived shown: Boolean = self.opacity > 0
  // The game's parts the minimap takes the place of, the one list of them: its cluster and backdrop, the map's zoom
  // buttons and the area that shows them (the wheel zooms), and the dev addon's own button (the ring's Ordaen button
  // opens its window).
  public derived hidden: Array<any Frame> = self.hiddenParts()

  // The drawer: its cells, and where it hangs from its button. Open, it shows while it holds something: its button
  // goes with the last thing it held.
  derived held: Integer = Game.minimap.buttons.length + Game.minimap.entries.length
  derived drawerShown: Boolean = self.settings.values.drawerOn && self.drawerOpen && self.held > 0
  derived drawerParked: Boolean = self.settings.values.drawerOn && !self.drawerOpen
  // Its cells, the room round them and its frame's line on both sides.
  derived drawerEdge: Number<Length> = Ordaen.lengthOf(2 * DRAWER_PAD) + 2 * Ordaen.art.frame.small.width * 1ui
  derived cellGap: Number<Length> = Ordaen.lengthOf(CELL_GAP)
  derived drawerWidth: Number<Length> = self.settings.values.drawerColumns * CELL + (self.settings.values.drawerColumns - 1) * self.cellGap + self.drawerEdge
  derived drawerRows: Integer = (1).max((self.held / self.settings.values.drawerColumns).ceil())
  derived drawerHeight: Number<Length> = self.drawerRows * CELL + (self.drawerRows - 1) * self.cellGap + self.drawerEdge
  // The drawer's box: its size at its frame's line, and the art past the line.
  derived drawerBoxWidth: Number<Length> = self.drawerWidth + reachAcross(Ordaen.art.frame.small)
  derived drawerBoxHeight: Number<Length> = self.drawerHeight + reachDown(Ordaen.art.frame.small)
  derived drawerLeft: Number<Length> = ROOM + self.ringLeft(DRAWER_BUTTON) + BUTTON - self.drawerWidth
  derived drawerTop: Number<Length> = self.roomTop + self.ringTop(DRAWER_BUTTON) + BUTTON + 2.34375dp

  // The tooltip of what the cursor is on: written in that part's box, it stands beside it on the screen.
  public derived hintTitle: String = self.titleOf()
  public derived hintText: String = self.textOf()
  public derived hintKeys: Array<String> = self.keysOf()
  public derived hintRows: Array<TipRow> = self.rowsOf()
  // Ordaen's art: its root is there before this module loads.

  constructor() {
    Game.minimap.square(true)
    Game.minimap.wheelZoom()
    // A right click on the map opens the minimap's settings, never a ping.
    Game.minimap.takeRightClick(true)
    Game.minimap.rightClicked.listen(self.onMapRightClick)
    Events.UPDATE_PENDING_MAIL.listen(self.onMail)
    Ordaen.modules.add(self)
    // The room it keeps down from the screen's top right corner while it stands at home there: what stands along the
    // right edge (the tracker) starts under it.
    watch {
      Ordaen.keepTopRight(FOLDER, self.shown && self.docked ? self.wholeHeight : 0ui)
    }
  }

  destructor() {
    Ordaen.keepTopRight(FOLDER, 0ui)
    Game.minimap.square(false)
    Game.minimap.takeRightClick(false)
  }

  hiddenParts(self): Array<any Frame> {
    const parts: Array<any Frame> = []
    Minimap.hide(parts, Game.frames.MinimapCluster)
    Minimap.hide(parts, Game.frames.MinimapBackdrop)
    Minimap.hide(parts, Game.frames.MinimapZoomIn)
    Minimap.hide(parts, Game.frames.MinimapZoomOut)
    Minimap.hide(parts, Game.frames.MinimapZoomHitArea)
    Minimap.hide(parts, Game.frames.OrdaenDevButton)
    return parts
  }

  hide(parts: mut Array<any Frame>, part: any Frame | nil) {
    if (part != nil) { parts.push(part) }
  }

  // The zone's colour by its PvP status: the game's own minimap colours.
  colorOf(self): Color {
    return match (Game.location.pvp) {
      nil => GOLD
      Game.Pvp.Sanctuary => Color.hex("#69ccf0")
      Game.Pvp.Friendly => Color.hex("#1aff1a")
      Game.Pvp.Hostile, Game.Pvp.Combat => Color.hex("#ff1a1a")
      Game.Pvp.Contested => Color.hex("#ffb300")
    }
  }

  zoneLabel(self): String {
    return match (Game.location.pvp) {
      nil => ""
      Game.Pvp.Sanctuary => Locale.ZONE_SANCTUARY
      Game.Pvp.Friendly, Game.Pvp.Hostile => Locale.ZONE_FACTION
      Game.Pvp.Contested => Locale.ZONE_CONTESTED
      Game.Pvp.Combat => Locale.ZONE_COMBAT
    }
  }

  // ---- the ring, for its buttons: its places in the frame's box from its line's top left corner, in ui

  // A ring button's angle: as dragged now, as the player left it, or its own.
  public angle(self, spec: RingSpec): Number {
    if (self.dragging == spec.id) { return self.dragAngle }
    return self.angles[spec.id] ?? spec.angle
  }

  // The frame's side, how far out the ring runs (its box's far sides), and docked, where a button's middle stops short
  // of the screen's edges (a button's half in from them): the bottom's right end, as far down from the top.
  derived side: Number = self.frameSide / 1ui
  derived ringOut: Number = RING_OUT / 1ui
  derived ringFar: Number = self.side + self.ringOut

  // A button's middle at `angle`: along it from the frame's middle onto the box RING_OUT round the frame (a square's
  // projection, not a circle's). Docked, the screen's edges stand on the frame's top and right: what would stand on
  // the right lies along the bottom, and what on top up the left, each as far from the screen's corner, clockwise
  // still, a button of `size` whole on the screen. Rounded to hundredths.
  ringAt(self, angle: Number, size: Number<Length>): (Number, Number) {
    let cornerEnd = self.side - size / 2 / 1ui
    let t = angle.rad()
    let dx = t.sin()
    let dy = -t.cos()
    let k = (self.side / 2 + self.ringOut) / dx.abs().max(dy.abs())
    let x = self.side / 2 + dx * k
    let y = self.side / 2 + dy * k
    if (self.docked) {
      if (x >= self.ringFar - 1e-6) {
        x = self.side - y
        y = self.ringFar
      } else if (y <= -self.ringOut + 1e-6) {
        y = self.side - x
        x = -self.ringOut
      }
      x = x.min(cornerEnd)
      y = y.max(self.side - cornerEnd)
    }
    return Minimap.hundredths(x), Minimap.hundredths(y)
  }

  // The angle a place points to from the frame's middle, to the whole degree; docked, its nearest place along the
  // bottom and the left, where the ring runs, for a button of `size`.
  angleAt(self, x: Number, y: Number, size: Number<Length>): Number {
    let cornerEnd = self.side - size / 2 / 1ui
    let px = x
    let py = y
    if (self.docked) {
      let bottomX = x.max(-self.ringOut).min(cornerEnd)
      let leftY = y.max(self.side - cornerEnd).min(self.ringFar)
      let onBottom = Minimap.apart(x - bottomX, y - self.ringFar) <= Minimap.apart(x + self.ringOut, y - leftY)
      px = onBottom ? bottomX : -self.ringOut
      py = onBottom ? self.ringFar : leftY
    }
    return ((px - self.side / 2).atan2(self.side / 2 - py).deg() % 360 + 0.5).floor()
  }

  hundredths(value: Number): Number { return (value * 100 + 0.5).floor() / 100 }
  // How far apart two places are, squared.
  apart(x: Number, y: Number): Number { return x * x + y * y }

  // The small frame's metal on the left and bottom alone: docked, the screen's edges are its others.
  cornered(metal: ArtBorder): ArtBorder {
    return {
      reach: metal.reach, drawnFrom: metal.drawnFrom, art: metal.art, width: metal.width, scale: metal.scale,
      inset: metal.inset, sides: [Side.Left, Side.Bottom], curves: metal.curves, lineStart: metal.lineStart
    }
  }

  public ringLeft(self, spec: RingSpec): Number<Length> {
    let x, y = self.ringAt(self.angle(spec), spec.size)
    return x * 1ui - spec.size / 2
  }

  public ringTop(self, spec: RingSpec): Number<Length> {
    let x, y = self.ringAt(self.angle(spec), spec.size)
    return y * 1ui - spec.size / 2
  }

  // Whether the ring shows: always, or with «Buttons on mouseover» while the cursor is on the minimap, a button is
  // dragged or the drawer shows. The mail's shows whenever there is mail.
  public ringOpacity(self, spec: RingSpec): Number {
    if (spec.id == RingId.Mail) { return 1 }
    if (!self.settings.values.buttonsHover || self.hovered || self.drawerShown || self.dragging != nil) { return 1 }
    return 0
  }

  public isDrawerOpen(self): Boolean { return self.drawerOpen }
  public isDrawerOn(self): Boolean { return self.settings.values.drawerOn }
  public holds(self): Integer { return self.held }
  public hasMail(self): Boolean { return self.mail }

  onMail(mut self) { self.mail = Client.HasNewMail() }

  // The drag taken as it starts: the client starts it once the cursor has gone a few pixels from the press, and the
  // button is where those take it at once, never left behind until the cursor moves again.
  public startDrag(mut self, spec: RingSpec, dx: Number<Length>, dy: Number<Length>) {
    let x, y = self.ringAt(self.angle(spec), spec.size)
    self.dragX = x
    self.dragY = y
    self.dragSize = spec.size
    self.dragAngle = self.angle(spec)
    self.dragging = spec.id
    self.hint = Hint.None
    self.dragTo(dx, dy)
  }

  // The cursor gone `dx`, `dy` since the press: the button's middle as it stood, moved as far, held by the cursor
  // where it took it.
  public dragTo(mut self, dx: Number<Length>, dy: Number<Length>) {
    self.dragAngle = self.angleAt(self.dragX + dx / 1ui, self.dragY + dy / 1ui, self.dragSize)
  }

  public stopDrag(mut self, spec: RingSpec) {
    self.angles[spec.id] = self.dragAngle
    self.dragging = nil
  }

  public toggleDrawer(mut self) { self.drawerOpen = !self.drawerOpen }
  public showHint(mut self, hint: Hint) { self.hint = hint }

  // ---- what the strips and the drawer report

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }
  onZoneEnter(mut self) { self.hint = Hint.Zone }
  onCoordsEnter(mut self) { self.hint = Hint.Coords }
  onClockEnter(mut self) { self.hint = Hint.Clock }
  onHintLeave(mut self) { self.hint = Hint.None }

  onEntryHover(mut self, name: String) {
    self.entryName = name
    self.hint = Hint.Entry
  }

  onCoordsClick(mut self, click: Event.Press) {
    if (click.button == MouseButton.Left && Game.input.shiftDown()) { Game.minimap.sendCoords() }
  }

  onClockClick(mut self, click: Event.Press) {
    if (click.button == MouseButton.Right) {
      Game.clock.toggleTimeManager()
    } else {
      Game.clock.toggleCalendar()
    }
  }

  onMapRightClick(mut self) {
    Ordaen.toggleSettings(Runtime.Addon.of(self))
  }

  // ---- the tooltip of our own parts (the game's buttons show their own)

  titleOf(self): String {
    return match (self.hint) {
      Hint.Zone => Game.location.realZone
      Hint.Coords => Game.minimap.coords
      Hint.Clock => Locale.CLOCK_TITLE
      Hint.Ordaen => Ordaen.title
      Hint.Drawer => Locale.DRAWER_TITLE
      Hint.Entry => self.entryName
      Hint.None => ""
    }
  }

  textOf(self): String {
    return match (self.hint) {
      Hint.Zone => self.zoneLabel()
      Hint.Coords, Hint.Clock, Hint.Ordaen, Hint.Drawer, Hint.Entry, Hint.None => ""
    }
  }

  keysOf(self): Array<String> {
    return match (self.hint) {
      Hint.Coords => [Locale.COORDS_KEY]
      Hint.Clock => [Locale.CLOCK_KEY, Locale.CLOCK_KEY_RIGHT]
      // The right click opens the dev tools, which a development build alone has.
      Hint.Ordaen => Build.dev ? [Locale.ORDAEN_KEY, Locale.ORDAEN_KEY_DEV] : [Locale.ORDAEN_KEY]
      Hint.Drawer => [Locale.DRAWER_KEY, Locale.DRAWER_KEY_DRAG]
      Hint.Zone, Hint.Entry, Hint.None => []
    }
  }

  // The clock's: the computer's time and the realm's, whichever the clock shows.
  rowsOf(self): Array<TipRow> {
    return match (self.hint) {
      Hint.Clock => [
        { label: Locale.CLOCK_LOCAL, value: timeText(Game.clock.computer) },
        { label: Locale.CLOCK_REALM, value: timeText(Game.clock.realm) }
      ]
      Hint.Zone, Hint.Coords, Hint.Ordaen, Hint.Drawer, Hint.Entry, Hint.None => []
    }
  }

  // The tooltip shown is this part's.
  public hinting(self, hint: Hint): Boolean { return self.hint == hint }

  public render(self): Template {
    return $ltml {
      // Each of the game's parts the minimap replaces: hidden and sent off the screen, so the game showing one again
      // (the zoom buttons as the cursor comes onto the map) puts nothing in sight and nothing under the cursor.
      <frame $for={part of self.hidden} of={part} shown={false} away={true} />

      <Placed $if={self.shown} id={PART} title={Locale.MINIMAP_TITLE} home={HOME}>
        // The room round the frame holds the ring and takes no mouse: a click there reaches the world. The cursor
        // is on the minimap while it is on the frame or on a ring button, which stand in the frame's box.
        <box width={self.wholeWidth} height={self.wholeHeight} opacity={self.opacity}>
          <box position={Position.Absolute} left={self.frameLeft} top={self.frameTop} width={self.frameBoxWidth}
               height={self.frameBoxHeight} border={self.metal} background={Ordaen.art.window.wood}
               artOrigin={true} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
            <embed frame={Game.minimap.frame} position={Position.Absolute} left={self.out} top={self.out}
                   width={self.size} height={self.size} />

            <box $if={self.settings.values.showZone} position={Position.Absolute} left={self.out} top={self.out}
                 width={self.size} height={STRIP} zLevel={1} background={Ordaen.art.window.wood} border={RULE_BELOW}
                 xAlign={Align.Center} yAlign={Align.Center}>
              <box @pointerEnter={self.onZoneEnter} @pointerLeave={self.onHintLeave}>
                <text value={Game.location.zone} textColor={self.zoneColor} textShadow={ENGRAVED}
                      wrap={.None} />
                <Tip $if={self.hint == Hint.Zone} title={self.hintTitle} text={self.hintText} keys={self.hintKeys} />
              </box>
            </box>

            <box $if={self.hasFoot} position={Position.Absolute} left={self.out} bottom={self.out} width={self.size}
                 height={STRIP} zLevel={1} background={Ordaen.art.window.wood} border={RULE_ABOVE}
                 columns={[{ fr: 1 }, "max-content"]} padding={{ left: 3sp, right: 3sp }} yAlign={Align.Center}>
              <box $if={self.showsCoords} @pointerPress={self.onCoordsClick} @pointerEnter={self.onCoordsEnter}
                   @pointerLeave={self.onHintLeave}>
                <text value={Game.minimap.coords} textColor={INK} textShadow={ENGRAVED}
                      textFont={.Numbers} wrap={.None} />
                <Tip $if={self.hint == Hint.Coords} title={self.hintTitle} text={self.hintText} keys={self.hintKeys} />
              </box>
              <box $else width={1ui} />
              <box $if={self.settings.values.showClock} @pointerPress={self.onClockClick} @pointerEnter={self.onClockEnter}
                   @pointerLeave={self.onHintLeave}>
                <text value={timeText(Game.clock.now)} textColor={self.clockColor} textShadow={ENGRAVED}
                      textFont={.Numbers} wrap={.None} />
                <Tip $if={self.hint == Hint.Clock} title={self.hintTitle} text={self.hintText} rows={self.hintRows}
                     keys={self.hintKeys} />
              </box>
            </box>

            <RingButton $for={spec of RING} spec={spec} map={mut self} />
          </box>

          <box $if={self.drawerShown} position={Position.Absolute} left={self.drawerLeft} top={self.drawerTop}
               width={self.drawerBoxWidth} height={self.drawerBoxHeight} columns={self.settings.values.drawerColumns} gap={CELL_GAP}
               padding={DRAWER_PAD} border={Ordaen.art.frame.small} background={Ordaen.art.window.wood}
               artOrigin={true} zLevel={20}>
            <embed $for={button of Game.minimap.buttons} frame={button} width={CELL} height={CELL}
                   look={EmbedLook.Icon} />
            <DrawerEntry $for={entry of Game.minimap.entries} entry={entry} @hover={self.onEntryHover}
                         @leave={self.onHintLeave} />
            <Tip $if={self.hint == Hint.Entry} title={self.hintTitle} text={self.hintText} keys={self.hintKeys} />
          </box>
          <box $elseif={self.drawerParked} position={Position.Absolute} left={0ui} top={0ui} width={0ui} height={0ui}
               opacity={0} overflow={Overflow.Hidden}>
            <embed $for={button of Game.minimap.buttons} frame={button} width={CELL} height={CELL}
                   look={EmbedLook.Icon} />
          </box>
        </box>
      </Placed>
    }
  }
}
