// Ordaen's settings window over the modules it knows, worked as the player works it: the list, a module's page and its
// tabs, the drafts saved and taken back, a module turned off and on, the question on closing with changes unsaved, the
// profiles. Here, as a module's tests are built with Ordaen: Ordaen's own tests have no module to list.
import Client from "$client"
import { Key } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
// A text the settings window always shows.
const SETTINGS = "Move mode"
// What the minimap always shows: the zone's name, under its mover's in the move mode.
const ZONE = "Elwynn Forest"
// The minimap's «Map» tab's first checkbox: «Zone name».
const ZONE_BOX = 1
// The page of a module turned off.
const OFF = "The module is off: it isn't loaded and costs nothing. Its settings are kept."
// The question on closing with a change unsaved.
const ASK = "Save the changes?"

// The settings window, opened as the player opens it.
function opened(): Test.Part {
  Test.open("/ordaen")
  return Test.page().window(SETTINGS)
}

// The settings window at the minimap's page.
function minimapPage(): Test.Part {
  const settings = opened()
  settings.button("Minimap").click()
  return settings
}

// Whether the window's Save takes a click: a change waits.
function saveable(settings: Test.Part): Boolean {
  return !settings.button("Save").paintedWith(Ordaen.art.ctl.buttonDisabled)
}

// Whether the `nth` checkbox is ticked: its tick, always drawn, shows.
function ticked(settings: Test.Part, nth: Integer): Boolean {
  return settings.box(Ordaen.art.ctl.tick).nth(nth).opacity() == 1
}

test "/ordaen opens Ordaen's own page, its tabs, with the modules in the list" {
  Test.mount(nil, SCREEN)
  const settings = opened()
  Test.expect(settings.button("General").shown() && settings.button("Numbers").shown())
  Test.expect(settings.text("MODULES").shown() && settings.button("Minimap").shown())
}

test "a tab of Ordaen's page clicked shows its controls" {
  Test.mount(nil, SCREEN)
  const settings = opened()
  Test.expect(!settings.text("Large numbers").shown())
  settings.button("Numbers").click()
  Test.expect(settings.text("Large numbers").shown())
}

test "a module picked in the list shows its tabs and its first tab's controls" {
  Test.mount(nil, SCREEN)
  const settings = minimapPage()
  Test.expect(settings.button("Map").shown() && settings.button("Button drawer").shown())
  Test.expect(settings.text("Map size").shown() && !settings.text("Columns").shown())
  settings.button("Button drawer").click()
  Test.expect(settings.text("Columns").shown() && !settings.text("Map size").shown())
}

test "/ordaen with a module's name opens its page; a word that names none opens Ordaen's own" {
  Test.mount(nil, SCREEN)
  const slash = Client.SlashCmdList["ORDAEN"] ?? panic("/ordaen is Ordaen's command")
  slash(" Minimap")
  Test.expect(Test.page().window(SETTINGS).button("Button drawer").shown())
  slash("nothing")
  Test.expect(Test.page().window(SETTINGS).button("Numbers").shown())
}

test "a change waits for Save, which keeps it; Roll back takes the save back" {
  Test.mount(nil, SCREEN)
  const settings = minimapPage()
  Test.expect(!saveable(settings) && !settings.button("Roll back").shown())
  settings.button(Ordaen.art.ctl.check).nth(ZONE_BOX).click()
  Test.expect(saveable(settings) && Test.page().text(ZONE).shown())
  settings.button("Save").click()
  Test.expect(!saveable(settings) && !Test.page().text(ZONE).shown())
  settings.button("Roll back").click()
  Test.expect(Test.page().text(ZONE).shown() && !settings.button("Roll back").shown())
}

test "Move mode clicked names the minimap over it; again, the mode ends" {
  Test.mount(nil, SCREEN)
  const settings = opened()
  Test.expect(!Test.page().window(ZONE).text("Minimap").shown())
  settings.button(SETTINGS).click()
  Test.expect(Test.page().window(ZONE).text("Minimap").shown())
  settings.button(SETTINGS).click()
  Test.expect(!Test.page().window(ZONE).text("Minimap").shown())
}

test "a module's switch in the list turned off ends it, and its page says it is off; on again, it runs" {
  Test.mount(nil, SCREEN)
  const settings = minimapPage()
  settings.button(Ordaen.art.ctl.switchOn).nth(1).click()
  Test.expect(!Test.page().text(ZONE).shown() && settings.text(OFF).shown())
  settings.button(Ordaen.art.ctl.switchOff).click()
  Test.expect(Test.page().text(ZONE).shown() && !settings.text(OFF).shown())
}

test "Escape with a change unsaved asks first; Cancel goes back to the window, the change still waiting" {
  Test.mount(nil, SCREEN)
  const settings = minimapPage()
  settings.button(Ordaen.art.ctl.check).nth(ZONE_BOX).click()
  Test.key(Key.Escape)
  Test.page().window(ASK).button("Cancel").click()
  Test.expect(!Test.page().window(ASK).shown() && saveable(settings))
}

test "Escape with a change unsaved, and «Don't save»: the window closes and the change is dropped" {
  Test.mount(nil, SCREEN)
  const settings = minimapPage()
  settings.button(Ordaen.art.ctl.check).nth(ZONE_BOX).click()
  Test.key(Key.Escape)
  Test.page().window(ASK).button("Don't save").click()
  Test.expect(!Test.page().window(SETTINGS).shown() && Test.page().text(ZONE).shown())
  Test.expect(!saveable(opened()))
}

test "the press that opens the window under the cursor turns nothing in it as it is let go" {
  Test.mount(nil, SCREEN)
  // Where the minimap's switch stands in the list once the window is open: the cursor is left there.
  const at = opened().button(Ordaen.art.ctl.switchOn).rect()
  Test.page().window(SETTINGS).button(Ordaen.art.ctl.switchOn).hover()
  Test.key(Key.Escape)
  // A button of the client's there (an entry of its options), that opens the window on its press and goes.
  const entry = Client.CreateFrame("Button", nil, Client.UIParent, nil)
  entry.SetFrameStrata("HIGH")
  entry.SetSize(40, 40)
  entry.SetPoint("CENTER", Client.UIParent, "TOPLEFT", (at.left + at.right) / 2, -(at.top + at.bottom) / 2)
  entry.SetScript("OnMouseDown", (): nil => {
    entry.Hide()
    Ordaen.toggleSettings(nil)
  })
  Test.press(nil)
  Test.pass(0.1)
  Test.release(nil)
  Test.expect(Test.page().window(SETTINGS).button(Ordaen.art.ctl.switchOn).shown() && Test.page().text(ZONE).shown())
}

test "every kind of control takes the player's click, and Save keeps them all" {
  Test.mount(nil, SCREEN)
  const settings = opened()
  const pixel = ticked(settings, 1)
  // Ordaen's page: a dropdown's choice, a checkbox.
  settings.button("Normal").click()
  Test.page().window("Roomy").button("Compact").click()
  settings.button(Ordaen.art.ctl.check).nth(1).click()
  // The minimap's: its dropdown, a checkbox; its second tab's switch.
  settings.button("Minimap").click()
  settings.button("Never").click()
  Test.page().window("On transport").button("In combat").click()
  settings.button(Ordaen.art.ctl.check).nth(ZONE_BOX).click()
  settings.button("Button drawer").click()
  settings.button(Ordaen.art.ctl.switchOn).nth(2).click()
  settings.button("Save").click()
  Test.expect(!saveable(settings) && !Test.page().text(ZONE).shown())
  Test.expect(!settings.button(Ordaen.art.ctl.switchOn).nth(2).shown())
  settings.button("Map").click()
  Test.expect(settings.button("In combat").shown() && !ticked(settings, ZONE_BOX))
  settings.button("General").click()
  Test.expect(settings.button("Compact").shown() && ticked(settings, 1) != pixel)
}

test "the profiles page is made when its entry is picked" {
  Test.mount(nil, SCREEN)
  const settings = opened()
  Test.expect(!settings.text("Use for").shown())
  settings.button("Profiles").click()
  Test.expect(settings.text("Use for").shown())
}

test "a profile picked for the character with a change unsaved asks first; «Don't save» switches to it" {
  Test.mount(nil, SCREEN)
  const settings = opened()
  settings.button(Ordaen.art.ctl.check).nth(1).click()
  settings.button("Profiles").click()
  settings.input().nth(1).type("Raid")
  settings.button("New").click()
  settings.button(Ordaen.art.ctl.check).nth(2).click()
  Test.page().window("Save the changes in profile «Default»?").button("Don't save").click()
  Test.expect(settings.text("In use: Raid, for this character").shown() && !saveable(settings))
}
