// Where each stat the window shows comes from, as its tooltip lists it: «Stats» (its base and the stats that feed it,
// by the class's conversions), «Items» (each worn item that gives it) and «Effects» (each aura on the character that
// changes it, from Ordaen Auras), each the most first. While the tooltip is open its sources light on the window: the
// items' slots with their share, the stats that feed it.
import Game from "$game"
import { Art } from "$ltml"
import { TipRow, TipSection, qualityColor } from "Ordaen"
import { Active, Change, Kind } from "OrdaenAuras"
import Locale from "@/locales"
import { Resource, Stats, Worn, handDps, meleeDps, rangedDps } from "@/sheet"
import { EVERY_STAT, MAINS, Stat } from "@/stat"
import Style from "@/style"

// A stat's name, whether it is a percentage, and its value as the sheet has it.
struct Spec {
  const name: String
  const percent: Boolean
  const of: (stats: Stats) => Number
}

function specOf(stat: Stat): Spec {
  return match (stat) {
    .Strength => { name: Locale.STRENGTH, percent: false, of: s => s.strength }
    .Agility => { name: Locale.AGILITY, percent: false, of: s => s.agility }
    .Stamina => { name: Locale.STAMINA, percent: false, of: s => s.stamina }
    .Intellect => { name: Locale.INTELLECT, percent: false, of: s => s.intellect }
    .Spirit => { name: Locale.SPIRIT, percent: false, of: s => s.spirit }
    .Health => { name: Locale.HEALTH, percent: false, of: s => s.health }
    .Power => { name: Locale.MANA, percent: false, of: s => s.power }
    .Armor => { name: Locale.ARMOR, percent: false, of: s => s.armor }
    .FireResistance => { name: Locale.FIRE_RESISTANCE, percent: false, of: s => s.resistances[2] ?? 0 }
    .NatureResistance => { name: Locale.NATURE_RESISTANCE, percent: false, of: s => s.resistances[4] ?? 0 }
    .FrostResistance => { name: Locale.FROST_RESISTANCE, percent: false, of: s => s.resistances[3] ?? 0 }
    .ShadowResistance => { name: Locale.SHADOW_RESISTANCE, percent: false, of: s => s.resistances[5] ?? 0 }
    .ArcaneResistance => { name: Locale.ARCANE_RESISTANCE, percent: false, of: s => s.resistances[1] ?? 0 }
    .AttackPower => { name: Locale.ATTACK_POWER, percent: false, of: s => s.attackPower }
    .RangedAttackPower => { name: Locale.ATTACK_POWER, percent: false, of: s => s.rangedAttackPower }
    .MeleeHit => { name: Locale.HIT, percent: true, of: s => s.meleeHit }
    .RangedHit => { name: Locale.HIT, percent: true, of: s => s.rangedHit }
    .SpellHit => { name: Locale.HIT, percent: true, of: s => s.spellHit }
    .MeleeCrit => { name: Locale.CRIT, percent: true, of: s => s.meleeCrit }
    .RangedCrit => { name: Locale.CRIT, percent: true, of: s => s.rangedCrit }
    .SpellCrit => { name: Locale.CRIT, percent: true, of: s => s.spellCrit }
    .Expertise => { name: Locale.EXPERTISE, percent: true, of: s => s.expertise }
    .Haste => { name: Locale.HASTE, percent: true, of: s => s.haste }
    .ArmorPenetration => { name: Locale.ARMOR_PENETRATION, percent: false, of: s => s.armorPenetration }
    .SpellPenetration => { name: Locale.SPELL_PENETRATION, percent: false, of: s => s.spellPenetration }
    .Dodge => { name: Locale.DODGE, percent: true, of: s => s.dodge }
    .Parry => { name: Locale.PARRY, percent: true, of: s => s.parry }
    .Block => { name: Locale.BLOCK, percent: true, of: s => s.block }
    .BlockValue => { name: Locale.BLOCK_VALUE, percent: false, of: s => s.blockValue }
    .Defense => { name: Locale.SECTION_DEFENSE, percent: false, of: s => s.defense }
    .SpellDamage => { name: Locale.SPELL_DAMAGE, percent: false, of: s => s.spellDamage }
    .Healing => { name: Locale.HEALING, percent: false, of: s => s.healing }
    .Regen => { name: Locale.COMBAT_REGEN, percent: false, of: s => s.regen }
    .ManaRegen => { name: Locale.REGEN, percent: false, of: s => s.restingRegen }
    .HealthRegen => { name: Locale.REGEN, percent: false, of: s => s.healthRegen }
    .CombatHealthRegen => { name: Locale.COMBAT_REGEN, percent: false, of: s => s.combatHealthRegen }
    .RunSpeed => { name: Locale.RUN_SPEED, percent: true, of: s => s.runSpeed }
    .MeleeDps => { name: Locale.DPS, percent: false, of: s => meleeDps(s) }
    .RangedDps => { name: Locale.DPS, percent: false, of: s => rangedDps(s) }
  }
}

// A stat's name, as its tooltip's title says it.
public function statName(stat: Stat): String { return specOf(stat).name }

// A stat that feeds another: so much of `to` a point of `from` gives, past the first `past` points (stamina's first
// twenty give a point of health each, the rest ten).
struct Feed {
  const from: Stat
  const to: Stat
  const per: Number
  const past: Integer = 0
}

// The classes that block with a shield: a point of strength is a twentieth of a point of the block's damage.
const SHIELD_CLASSES: Array<String> = ["WARRIOR", "PALADIN", "SHAMAN"]

// The schools of an aura's resistance, by the bit of its mask (1 physical: armor; 2 holy has none of its own).
struct School {
  const bit: Integer
  const stat: Stat
}
const SCHOOLS: Array<School> = [
  { bit: 1, stat: .Armor }, { bit: 4, stat: .FireResistance }, { bit: 8, stat: .NatureResistance },
  { bit: 16, stat: .FrostResistance }, { bit: 32, stat: .ShadowResistance }, { bit: 64, stat: .ArcaneResistance }
]
// Mana among an aura's powers.
const MANA_POWER = 0

// The stats an aura's change changes; none for a change no stat of the window shows.
function changed(change: Change): Array<Stat> {
  return match (change.kind) {
    .Stat, .StatPercent => change.misc < 0 ? MAINS : [MAINS[change.misc + 1] ?? panic("five main stats")]
    .Resist, .ResistPercent => SCHOOLS.filter(school => (change.misc / school.bit).floor() % 2 == 1).map(school => school.stat)
    .Armor => [.Armor]
    .Health => [.Health]
    .Power => change.misc == MANA_POWER ? [.Power] : []
    .Regen => change.misc == MANA_POWER ? [.Regen, .ManaRegen] : []
    .AttackPower, .AttackPowerPercent => [.AttackPower]
    .RangedPower => [.RangedAttackPower]
    .SpellDamage => [.SpellDamage]
    .Healing => [.Healing]
    .Hit => [.MeleeHit, .RangedHit]
    .SpellHit => [.SpellHit]
    .Crit => [.MeleeCrit, .RangedCrit]
    .SpellCrit => [.SpellCrit]
    .Dodge => [.Dodge]
    .Parry => [.Parry]
    .Block => [.Block]
    .BlockValue => [.BlockValue]
    .Expertise => [.Expertise]
    .Haste => [.Haste]
    .RunSpeed => [.RunSpeed]
    else => []
  }
}

// A change that multiplies its stat rather than adding to it.
function multiplies(change: Change): Boolean {
  return change.kind == Kind.StatPercent || change.kind == Kind.ResistPercent || change.kind == Kind.AttackPowerPercent
}

// What the window knows of the character, all a stat's sources are read from.
public struct Facts {
  const stats: Stats
  const worn: Array<Worn>
  const auras: Array<Active>
  const classTag: String
}

// One source: its row in the tooltip, and how much it adds in the stat's unit, which orders its section.
struct Part {
  const row: TipRow
  const amount: Number
}

// A stat's tooltip and what lights while it is open: the text under its title, its sections, the stats that feed it,
// and each item's share by its slot.
public struct Breakdown {
  const text: String
  const sections: Array<TipSection>
  const fed: Array<Stat>
  const shares: Map<Integer, String>
}

public const NO_BREAKDOWN: Breakdown = { text: "", sections: [], fed: [], shares: {} }

// An amount in the stat's unit: a percentage with two decimals, points whole.
function amountText(amount: Number, percent: Boolean): String {
  return percent ? "%.2f%%".format(amount) : String.of(amount.round())
}

// An amount as a source adds it, signed.
function added(amount: Number, percent: Boolean): String {
  return `${amount < 0 ? "-" : "+"}${amountText(amount.abs(), percent)}`
}

// What a point gives, as short as it reads: whole where it is whole, else to four figures.
function perText(per: Number): String {
  return per == per.floor() ? String.of(per) : "%.4g".format(per)
}

// How a stat's share of another is worked out, written before it in its tooltip: «20 × 15 =», or with the first points
// giving one each, «20 + (280 × 10) =».
function workingOf(feed: Feed, points: Number): String {
  const counted = points.floor()
  if (feed.past > 0 && counted > feed.past) { return `${feed.past} + (${counted - feed.past} × ${perText(feed.per)}) =` }
  if (feed.past > 0) { return "" }
  return `${counted} × ${perText(feed.per)} =`
}

// A main stat's base as the client says it (without what items and auras add); none for any other stat.
function baseOf(stat: Stat, stats: Stats): Number | nil {
  for (index, main of MAINS) {
    if (main == stat) { return stats.bases[index] ?? 0 }
  }
  return nil
}

function largestFirst(parts: Array<Part>): Array<TipRow> {
  const sorted = parts.map(part => part)
  sorted.sort((a, b) => a.amount > b.amount)
  return sorted.map(part => part.row)
}

function section(title: String, parts: Array<Part>, into: mut Array<TipSection>) {
  if (parts.length > 0) { into.push({ title: title, rows: largestFirst(parts) }) }
}

// What the character's stats feed: attack power, ranged attack power, crit and spell crit as the client works them out
// for the class and level (`Conversions`); armor from agility; health from stamina (the client's table `hppersta`:
// ten a point past the first twenty, which give one each); mana from intellect, for a class with mana; the block's
// damage from strength, for a class with a shield.
function feedsOf(stats: Stats, classTag: String): Array<Feed> {
  const by = stats.conversions
  const all: Array<Feed> = [
    { from: .Strength, to: .AttackPower, per: by.attackPerStrength },
    { from: .Agility, to: .AttackPower, per: by.attackPerAgility },
    { from: .Agility, to: .RangedAttackPower, per: by.rangedPerAgility },
    { from: .Agility, to: .MeleeCrit, per: by.critPerAgility },
    { from: .Agility, to: .RangedCrit, per: by.critPerAgility },
    { from: .Intellect, to: .SpellCrit, per: by.spellCritPerIntellect },
    { from: .Agility, to: .Armor, per: 2 },
    { from: .Stamina, to: .Health, per: 10, past: 20 }
  ]
  if (stats.resource == Resource.Mana) { all.push({ from: .Intellect, to: .Power, per: 15, past: 20 }) }
  // Spirit's share of health's regeneration out of a fight, and of mana's outside casting, as the client says it.
  if (stats.spirit > 0) {
    all.push({ from: .Spirit, to: .HealthRegen, per: stats.healthFromSpirit / stats.spirit })
    if (stats.resource == Resource.Mana) { all.push({ from: .Spirit, to: .ManaRegen, per: stats.manaFromSpirit / stats.spirit }) }
  }
  if (SHIELD_CLASSES.any(tag => tag == classTag)) { all.push({ from: .Strength, to: .BlockValue, per: 1 / 20 }) }
  return all
}

// What the game's paper doll says of a stat under its name, the client's own words; empty where it says nothing. A
// crit says what it does in its own section alone (the game's `STAT_CRIT_BONUS` says both, and the stats feeding
// each, which light on the window).
public function wordsOf(stat: Stat, stats: Stats): String {
  const tips = stats.tips
  return match (stat) {
    .Strength => tips.primary[1] ?? ""
    .Agility => tips.primary[2] ?? ""
    .Stamina => tips.primary[3] ?? ""
    .Intellect => tips.primary[4] ?? ""
    .Spirit => tips.primary[5] ?? ""
    .Armor => tips.armor
    .AttackPower => tips.attackPower
    .RangedAttackPower => tips.rangedAttackPower
    .MeleeCrit, .RangedCrit => Locale.CRIT_WEAPON.format()
    .SpellCrit => Locale.CRIT_SPELL.format()
    .Expertise => Locale.EXPERTISE_TIP
    .Defense => tips.defense
    .BlockValue => tips.block
    .ArmorPenetration => tips.armorPenetration
    .SpellPenetration => tips.spellPenetration
    .SpellDamage => tips.spellDamage
    .Healing => tips.healing
    else => ""
  }
}

// A stat's sources other than its base: the stats that feed it, the items and sets that give it, the auras that change
// it; the stats that feed it and each item's share by its slot.
struct Parts {
  const fromStats: Array<Part>
  const fromItems: Array<Part>
  const fromEffects: Array<Part>
  const fed: Array<Stat>
  const shares: Map<Integer, String>
}

function sum(parts: Array<Part>): Number {
  let total: Number = 0
  for (part of parts) { total += part.amount }
  return total
}

// One weapon's lines in the damage's tooltip, as the game's paper doll writes them: its seconds between hits, its hit's
// damage (the least down, the most up, at least 1) and its damage a second.
function handRows(min: Number, max: Number, speed: Number): Array<TipRow> {
  return [
    { label: Locale.ATTACK_SPEED, value: "%.2f".format(speed) },
    { label: Locale.DAMAGE, value: `${min.floor().max(1)} - ${max.ceil().max(1)}` },
    { label: Locale.DPS, value: "%.1f".format(handDps(min, max, speed)) }
  ]
}

// The weapons' damage's tooltip (`CharacterDamageFrame_OnEnter`): the main hand's, then the off hand's where one is
// held; or the ranged weapon's. Attack power lights with it, and each weapon's slot with its damage a second.
function damageBreakdown(ranged: Boolean, stats: Stats): Breakdown {
  const sections: Array<TipSection> = []
  const shares: Map<Integer, String> = {}
  if (ranged) {
    sections.push({ title: Locale.SECTION_RANGED, rows: handRows(stats.rangedMinDamage, stats.rangedMaxDamage, stats.rangedSpeed) })
    shares[RANGED_SLOT] = "%.1f".format(rangedDps(stats))
    return { text: "", sections: sections, fed: [.RangedAttackPower], shares: shares }
  }
  sections.push({ title: Locale.MAIN_HAND, rows: handRows(stats.minDamage, stats.maxDamage, stats.speed) })
  shares[MAIN_HAND_SLOT] = "%.1f".format(handDps(stats.minDamage, stats.maxDamage, stats.speed))
  const off = stats.offSpeed ?? 0
  if (off > 0) {
    sections.push({ title: Locale.OFF_HAND, rows: handRows(stats.offMinDamage, stats.offMaxDamage, off) })
    shares[OFF_HAND_SLOT] = "%.1f".format(handDps(stats.offMinDamage, stats.offMaxDamage, off))
  }
  return { text: "", sections: sections, fed: [.AttackPower], shares: shares }
}

// The weapons' slots.
const MAIN_HAND_SLOT = 16
const OFF_HAND_SLOT = 17
const RANGED_SLOT = 18

// The hit that misses nothing (the game's `CR_<CLASS>_HIT_CAP_TOOLTIP`), in percent: against a raid's boss and a target
// of the player's level, for melee and ranged attacks, spells, and a weapon in each hand's own swings.
public struct HitCaps {
  const boss: Number
  const level: Number
}
public const WEAPON_HIT_CAPS: HitCaps = { boss: 8, level: 5 }
public const SPELL_HIT_CAPS: HitCaps = { boss: 17, level: 4 }
const DUAL_HIT_CAPS: HitCaps = { boss: 27, level: 24 }

// A cap's rows: each green once the hit reaches it.
function capRows(hit: Number, caps: HitCaps): Array<TipRow> {
  const reached = (cap: Number): Color | nil => hit >= cap ? Style.GREEN : nil
  return [
    { label: Locale.HIT_CAP_BOSS, value: amountText(caps.boss, true), valueTone: reached(caps.boss) },
    { label: Locale.HIT_CAP_LEVEL, value: amountText(caps.level, true), valueTone: reached(caps.level) }
  ]
}

// A hit's caps, its section's alone: the spells' for spell hit; for melee and ranged hit the weapons', and with a
// weapon in each hand its own swings' too.
function hitCapsOf(stat: Stat, stats: Stats): Array<TipSection> {
  if (stat == .SpellHit) { return [{ title: Locale.HIT_CAP, rows: capRows(stats.spellHit, SPELL_HIT_CAPS) }] }
  const hit = stat == .RangedHit ? stats.rangedHit : stats.meleeHit
  const sections: Array<TipSection> = [{ title: Locale.HIT_CAP, rows: capRows(hit, WEAPON_HIT_CAPS) }]
  if (stat == .MeleeHit && (stats.offSpeed ?? 0) > 0) {
    sections.push({ title: Locale.HIT_CAP_DUAL, rows: capRows(hit, DUAL_HIT_CAPS) })
  }
  return sections
}

// What a target dodges and parries, in percent (the game's `CR_EXPERTISE_TOOLTIP`, `BASE_ENEMY_DODGE_CHANCE`): a raid's
// boss, three levels over the player, and a target of the player's level. Expertise takes the dodge off first, and only
// what is past the dodge takes off the parry (`GetEnemyParryChance`).
public struct Avoidance {
  const dodge: Number
  const parry: Number
}
public const BOSS_AVOIDANCE: Avoidance = { dodge: 6.5, parry: 16.5 }
const LEVEL_AVOIDANCE: Avoidance = { dodge: 5, parry: 5 }

// One target's dodge and parry as the expertise that takes each off whole: the dodge's own, the parry's past it; each
// green once the expertise reaches it.
function avoidanceRows(expertise: Number, of: Avoidance): Array<TipRow> {
  const taken = (cap: Number): Color | nil => expertise >= cap ? Style.GREEN : nil
  const parryCap = of.dodge + of.parry
  return [
    { label: Locale.DODGE, value: amountText(of.dodge, true), valueTone: taken(of.dodge) },
    { label: Locale.PARRY, value: amountText(parryCap, true), valueTone: taken(parryCap) }
  ]
}

// Expertise's sections: a raid's boss's, and a target of the player's level's.
function avoidanceOf(expertise: Number): Array<TipSection> {
  return [
    { title: Locale.HIT_CAP_BOSS, rows: avoidanceRows(expertise, BOSS_AVOIDANCE) },
    { title: Locale.HIT_CAP_LEVEL, rows: avoidanceRows(expertise, LEVEL_AVOIDANCE) }
  ]
}

// What a stat's tooltip lists, and what lights with it.
public function breakdownOf(stat: Stat, text: String, facts: Facts): Breakdown {
  if (stat == .MeleeDps || stat == .RangedDps) { return damageBreakdown(stat == .RangedDps, facts.stats) }
  const spec = specOf(stat)
  const parts = partsOf(stat, facts)
  const fromStats = parts.fromStats.map(part => part)
  // The base: a main stat's as the client says it, any other's the rest of its value (its level, its race, talents).
  const base = baseFor(stat, facts, parts)
  if (base.abs() >= (spec.percent ? 0.005 : 0.5)) {
    fromStats.push({ row: { label: Locale.BASE, value: amountText(base, spec.percent) }, amount: base })
  }
  const sections: Array<TipSection> = []
  section(Locale.FROM_STATS, fromStats, mut sections)
  section(Locale.FROM_ITEMS, parts.fromItems, mut sections)
  section(Locale.FROM_EFFECTS, parts.fromEffects, mut sections)
  if (stat == .MeleeHit || stat == .RangedHit || stat == .SpellHit) {
    for (caps of hitCapsOf(stat, facts.stats)) { sections.push(caps) }
  }
  if (stat == .Expertise) {
    for (target of avoidanceOf(facts.stats.expertise)) { sections.push(target) }
  }
  return { text: text, sections: sections, fed: parts.fed, shares: parts.shares }
}

// A stat's base: a main stat's as the client says it, any other's what its sources leave of its value.
function baseFor(stat: Stat, facts: Facts, parts: Parts): Number {
  const counted = sum(parts.fromStats) + sum(parts.fromItems) + sum(parts.fromEffects)
  return baseOf(stat, facts.stats) ?? specOf(stat).of(facts.stats) - counted
}

// Each stat's base, by its name: what the character is without its items, its auras and what its stats feed.
public function basesOf(facts: Facts): Map<String, Number> {
  const bases: Map<String, Number> = {}
  for (stat of EVERY_STAT) { bases[`${stat}`] = baseFor(stat, facts, partsOf(stat, facts)) }
  return bases
}

// How the auras on the character change a stat: one lowers it (whatever others raise, as the game's paper doll reds
// a stat any debuff takes from), or one raises it.
public enum Boost { Up = "up", Down = "down" }

// An aura's share of a stat in its tooltip: green where it raises the stat, red where it lowers it, as the stat's
// value reads.
function boostTone(amount: Number): Color | nil {
  return amount > 0 ? Style.GREEN : amount < 0 ? Style.RED : nil
}

// Each stat an aura changes, by its name, and how; a stat none changes isn't in it.
public function boostsOf(facts: Facts): Map<String, Boost> {
  const boosts: Map<String, Boost> = {}
  if (facts.auras.length == 0) { return boosts }
  for (stat of EVERY_STAT) {
    const effects = partsOf(stat, facts).fromEffects
    if (effects.any(part => part.amount < 0)) {
      boosts[`${stat}`] = .Down
    } else if (effects.any(part => part.amount > 0)) {
      boosts[`${stat}`] = .Up
    }
  }
  return boosts
}

// What the items and the stats give a stat, without its base and its auras: a character's estimate, its base added.
public function givenTo(stat: Stat, facts: Facts): Number {
  const parts = partsOf(stat, facts)
  return sum(parts.fromStats) + sum(parts.fromItems)
}

function partsOf(stat: Stat, facts: Facts): Parts {
  const spec = specOf(stat)
  const total = spec.of(facts.stats)
  const fromStats: Array<Part> = []
  const fromItems: Array<Part> = []
  const fromEffects: Array<Part> = []
  const fed: Array<Stat> = []
  const shares: Map<Integer, String> = {}

  for (feed of feedsOf(facts.stats, facts.classTag)) {
    if (feed.to == stat) {
      const points = specOf(feed.from).of(facts.stats)
      const amount = feed.past.min(points) + (points - feed.past).max(0) * feed.per
      if (amount != 0) {
        fromStats.push({ row: { label: statName(feed.from), value: amountText(amount, spec.percent), working: workingOf(feed, points) }, amount: amount })
        fed.push(feed.from)
      }
    }
  }

  for (piece of facts.worn) {
    const item = piece.item
    if (item != nil) {
      for (given of piece.gives) {
        if (given.stat == stat) {
          const value = added(given.amount, spec.percent)
          fromItems.push({
            row: { label: piece.name, value: value, icon: Game.items.icon(item), tone: qualityColor(piece.quality) },
            amount: given.amount
          })
          shares[piece.slot] = value
        }
      }
    }
  }

  // Each set's bonuses once, however many of its pieces are worn; its pieces that give the stat nothing of their own
  // light with the set's share.
  const sets: Array<String> = []
  for (piece of facts.worn) {
    const set = piece.set
    if (set != nil && !sets.any(name => name == set.name)) {
      sets.push(set.name)
      let amount: Number = 0
      for (given of set.gives) {
        if (given.stat == stat) { amount += given.amount }
      }
      if (amount != 0) {
        const value = added(amount, spec.percent)
        fromItems.push({ row: { label: set.name, value: value }, amount: amount })
        for (other of facts.worn) {
          if (other.set?.name == set.name && shares[other.slot] == nil) { shares[other.slot] = value }
        }
      }
    }
  }

  for (aura of facts.auras) {
    for (change of aura.changes) {
      if (changed(change).any(s => s == stat)) {
        const name = Game.spells.name(aura.spell) ?? ""
        const icon: Art | nil = Game.spells.texture(aura.spell)
        const tone = boostTone(change.amount)
        if (multiplies(change)) {
          // What a share of the total it makes: the stat without it times the share.
          const amount = total - total / (1 + change.amount / 100)
          fromEffects.push({ row: { label: name, value: added(change.amount, true), icon: icon, valueTone: tone }, amount: amount })
        } else {
          fromEffects.push({
            row: { label: name, value: added(change.amount, spec.percent), icon: icon, valueTone: tone }, amount: change.amount
          })
        }
      }
    }
  }

  return { fromStats: fromStats, fromItems: fromItems, fromEffects: fromEffects, fed: fed, shares: shares }
}
