// Where each stat the window shows comes from, as its tooltip lists it: «Stats» (its base and the stats that feed it,
// by the class's conversions), «Items» (each worn item that gives it) and «Effects» (each aura on the character that
// changes it, from Ordaen Auras), each the most first. While the tooltip is open its sources light on the window: the
// items' slots with their share, the stats that feed it.
import Game from "$game"
import { Art } from "$ltml"
import { TipRow, TipSection, TipSlice, qualityColor } from "Ordaen"
import { Active, Change, Kind } from "OrdaenAuras"
import Locale from "@/locales"
import { Resource, Stats, Worn, handDps, meleeDps, rangedDps, swingOf } from "@/sheet"
import { EVERY_STAT, MAINS, Stat } from "@/stat"
import Style from "@/style"

// A stat's name, whether it is a percentage, and its value as the sheet has it.
struct Spec {
  const name: String
  const percent: Boolean
  const of: (stats: Stats) => Number
}

function specOf(stat: Stat): Spec {
  return match (stat) {
    .Strength => { name: Locale.STRENGTH, percent: false, of: s => s.strength }
    .Agility => { name: Locale.AGILITY, percent: false, of: s => s.agility }
    .Stamina => { name: Locale.STAMINA, percent: false, of: s => s.stamina }
    .Intellect => { name: Locale.INTELLECT, percent: false, of: s => s.intellect }
    .Spirit => { name: Locale.SPIRIT, percent: false, of: s => s.spirit }
    .Health => { name: Locale.HEALTH, percent: false, of: s => s.health }
    .Power => { name: Locale.MANA, percent: false, of: s => s.power }
    .Armor => { name: Locale.ARMOR, percent: false, of: s => s.armor }
    .FireResistance => { name: Locale.FIRE_RESISTANCE, percent: false, of: s => s.resistances[2] ?? 0 }
    .NatureResistance => { name: Locale.NATURE_RESISTANCE, percent: false, of: s => s.resistances[4] ?? 0 }
    .FrostResistance => { name: Locale.FROST_RESISTANCE, percent: false, of: s => s.resistances[3] ?? 0 }
    .ShadowResistance => { name: Locale.SHADOW_RESISTANCE, percent: false, of: s => s.resistances[5] ?? 0 }
    .ArcaneResistance => { name: Locale.ARCANE_RESISTANCE, percent: false, of: s => s.resistances[1] ?? 0 }
    .AttackPower => { name: Locale.ATTACK_POWER, percent: false, of: s => s.attackPower }
    .RangedAttackPower => { name: Locale.ATTACK_POWER, percent: false, of: s => s.rangedAttackPower }
    .MeleeHit => { name: Locale.HIT, percent: true, of: s => s.meleeHit }
    .RangedHit => { name: Locale.HIT, percent: true, of: s => s.rangedHit }
    .SpellHit => { name: Locale.HIT, percent: true, of: s => s.spellHit }
    .MeleeCrit => { name: Locale.CRIT, percent: true, of: s => s.meleeCrit }
    .RangedCrit => { name: Locale.CRIT, percent: true, of: s => s.rangedCrit }
    .SpellCrit => { name: Locale.CRIT, percent: true, of: s => s.spellCrit }
    .Expertise => { name: Locale.EXPERTISE, percent: true, of: s => s.expertise }
    .MeleeHaste => { name: Locale.HASTE, percent: true, of: s => s.meleeHaste }
    .RangedHaste => { name: Locale.HASTE, percent: true, of: s => s.rangedHaste }
    .SpellHaste => { name: Locale.HASTE, percent: true, of: s => s.spellHaste }
    .ArmorPenetration => { name: Locale.ARMOR_PENETRATION, percent: false, of: s => s.armorPenetration }
    .SpellPenetration => { name: Locale.SPELL_PENETRATION, percent: false, of: s => s.spellPenetration }
    .Dodge => { name: Locale.DODGE, percent: true, of: s => s.dodge }
    .Parry => { name: Locale.PARRY, percent: true, of: s => s.parry }
    .Block => { name: Locale.BLOCK, percent: true, of: s => s.block }
    .BlockValue => { name: Locale.BLOCK_VALUE, percent: false, of: s => s.blockValue }
    .Defense => { name: Locale.SECTION_DEFENSE, percent: false, of: s => s.defense }
    .SpellDamage => { name: Locale.SPELL_DAMAGE, percent: false, of: s => s.spellDamage }
    .Healing => { name: Locale.HEALING, percent: false, of: s => s.healing }
    .Regen => { name: Locale.COMBAT_REGEN, percent: false, of: s => s.regen }
    .ManaRegen => { name: Locale.REGEN, percent: false, of: s => s.restingRegen }
    .HealthRegen => { name: Locale.REGEN, percent: false, of: s => s.healthRegen }
    .CombatHealthRegen => { name: Locale.COMBAT_REGEN, percent: false, of: s => s.combatHealthRegen }
    .RunSpeed => { name: Locale.RUN_SPEED, percent: true, of: s => s.runSpeed }
    .MeleeDps => { name: Locale.DPS, percent: false, of: s => meleeDps(s) }
    .RangedDps => { name: Locale.DPS, percent: false, of: s => rangedDps(s) }
    .MeleeLands => { name: Locale.LANDS, percent: true, of: s => landsOf(.Melee, s) }
    .RangedLands => { name: Locale.LANDS, percent: true, of: s => landsOf(.Ranged, s) }
    .SpellLands => { name: Locale.LANDS, percent: true, of: s => landsOf(.Spell, s) }
    .DamageReduction => { name: Locale.DAMAGE_REDUCTION, percent: true, of: s => s.atMaxLevel ? s.bossArmorReduction : s.armorReduction }
    .HitTaken => { name: Locale.HIT_TAKEN, percent: true, of: s => hitTakenOf(s) }
    .MainHandSkill => { name: Locale.WEAPON_SKILL, percent: false, of: s => s.meleeSkillPast }
    .OffHandSkill => { name: Locale.WEAPON_SKILL, percent: false, of: s => s.offSkillPast }
    .RangedSkill => { name: Locale.WEAPON_SKILL, percent: false, of: s => s.rangedSkillPast }
    .AttackSpeed => { name: Locale.ATTACK_SPEED, percent: false, of: s => swingOf(s) }
    .RangedAttackSpeed => { name: Locale.ATTACK_SPEED, percent: false, of: s => s.rangedSpeed }
  }
}

// A stat's name, as its tooltip's title says it.
public function statName(stat: Stat): String { return specOf(stat).name }

// A stat's value, as its card and its gauge show it.
public function statValue(stat: Stat, stats: Stats): Number { return specOf(stat).of(stats) }

// A stat that feeds another: so much of `to` a point of `from` gives, past the first `past` points (stamina's first
// twenty give a point of health each, the rest ten); its points counted from `from` (the defense's from the level's,
// fewer than none below it).
struct Feed {
  const from: Stat
  const to: Stat
  const per: Number
  const past: Integer = 0
  const start: Number = 0
}

// What a feed gives of its stat at so many points (counted from its start).
function fedBy(feed: Feed, points: Number): Number {
  if (feed.past <= 0) { return points * feed.per }
  return feed.past.min(points) + (points - feed.past).max(0) * feed.per
}

// What the defense skill raises past the level's.
const DEFENDED: Array<Stat> = [.Dodge, .Parry, .Block]

// The classes that block with a shield: a point of strength is a twentieth of a point of the block's damage.
const SHIELD_CLASSES: Array<String> = ["WARRIOR", "PALADIN", "SHAMAN"]

// The schools of an aura's resistance, by the bit of its mask (1 physical: armor; 2 holy has none of its own).
struct School {
  const bit: Integer
  const stat: Stat
}
const SCHOOLS: Array<School> = [
  { bit: 1, stat: .Armor }, { bit: 4, stat: .FireResistance }, { bit: 8, stat: .NatureResistance },
  { bit: 16, stat: .FrostResistance }, { bit: 32, stat: .ShadowResistance }, { bit: 64, stat: .ArcaneResistance }
]
// Mana among an aura's powers.
const MANA_POWER = 0

// The stats an aura's change changes; none for a change no stat of the window shows.
function changed(change: Change): Array<Stat> {
  return match (change.kind) {
    .Stat, .StatPercent => change.misc < 0 ? MAINS : [MAINS[change.misc + 1] ?? panic("five main stats")]
    .Resist, .ResistPercent => SCHOOLS.filter(school => (change.misc / school.bit).floor() % 2 == 1).map(school => school.stat)
    .Armor => [.Armor]
    .Health => [.Health]
    .Power => change.misc == MANA_POWER ? [.Power] : []
    .Regen => change.misc == MANA_POWER ? [.Regen, .ManaRegen] : []
    .AttackPower, .AttackPowerPercent => [.AttackPower]
    .RangedPower => [.RangedAttackPower]
    .SpellDamage => [.SpellDamage]
    .Healing => [.Healing]
    .Hit => [.MeleeHit, .RangedHit]
    .SpellHit => [.SpellHit]
    .Crit => [.MeleeCrit, .RangedCrit]
    .SpellCrit => [.SpellCrit]
    .Dodge => [.Dodge]
    .Parry => [.Parry]
    .Block => [.Block]
    .BlockValue => [.BlockValue]
    .Expertise => [.Expertise]
    .AttackSpeed => [.MeleeHaste]
    .RangedSpeed => [.RangedHaste]
    .AttackRangedSpeed => [.MeleeHaste, .RangedHaste]
    .CastSpeed => [.SpellHaste]
    .Haste => [.MeleeHaste, .RangedHaste, .SpellHaste]
    .RunSpeed => [.RunSpeed]
    else => []
  }
}

// A change that multiplies its stat rather than adding to it.
function multiplies(change: Change): Boolean {
  return change.kind == Kind.StatPercent || change.kind == Kind.ResistPercent || change.kind == Kind.AttackPowerPercent
}

// What the window knows of the character, all a stat's sources are read from.
public struct Facts {
  const stats: Stats
  const worn: Array<Worn>
  const auras: Array<Active>
  const classTag: String
}

// One source: its row in the tooltip, and how much it adds in the stat's unit, which orders its section.
struct Part {
  const row: TipRow
  const amount: Number
}

// A stat's tooltip and what lights while it is open: the text under its title, its lines before any section, its
// sections, the stats that feed it, and each item's share by its slot.
public struct Breakdown {
  const text: String
  const rows: Array<TipRow> = []
  const sections: Array<TipSection>
  const fed: Array<Stat>
  const shares: Map<Integer, String>
}

public const NO_BREAKDOWN: Breakdown = { text: "", sections: [], fed: [], shares: {} }

// An amount in the stat's unit: a percentage with two decimals, points whole.
function amountText(amount: Number, percent: Boolean): String {
  return percent ? "%.2f%%".format(amount) : String.of(amount.round())
}

// An amount as a source adds it, signed.
function added(amount: Number, percent: Boolean): String {
  return `${amount < 0 ? "-" : "+"}${amountText(amount.abs(), percent)}`
}

// What a point gives, as short as it reads: whole where it is whole, else to four figures.
function perText(per: Number): String {
  return per == per.floor() ? String.of(per) : "%.4g".format(per)
}

// How a stat's share of another is worked out, written before it in its tooltip: «20 × 15 =», or with the first points
// giving one each, «20 + (280 × 10) =», or counted from a start, «(44 − 45) × 0.04 =».
function workingOf(feed: Feed, points: Number): String {
  // Counted from a start: the stat less it, «(44 − 45) × 0.04 =».
  if (feed.start != 0) { return `(${(points + feed.start).floor()} − ${feed.start.floor()}) × ${perText(feed.per)} =` }
  const counted = points.floor()
  if (feed.past > 0 && counted > feed.past) { return `${feed.past} + (${counted - feed.past} × ${perText(feed.per)}) =` }
  if (feed.past > 0) { return "" }
  return `${counted} × ${perText(feed.per)} =`
}

// A main stat's base as the client says it (without what items and auras add); none for any other stat.
function baseOf(stat: Stat, stats: Stats): Number | nil {
  for (index, main of MAINS) {
    if (main == stat) { return stats.bases[index] ?? 0 }
  }
  return nil
}

function largestFirst(parts: Array<Part>): Array<TipRow> {
  const sorted = parts.map(part => part)
  sorted.sort((a, b) => a.amount > b.amount)
  return sorted.map(part => part.row)
}

function section(title: String, parts: Array<Part>, into: mut Array<TipSection>) {
  if (parts.length > 0) { into.push({ title: title, rows: largestFirst(parts) }) }
}

// What the character's stats feed: attack power, ranged attack power, crit and spell crit as the client works them out
// for the class and level (`Conversions`); armor from agility; health from stamina (the client's table `hppersta`:
// ten a point past the first twenty, which give one each); mana from intellect, for a class with mana; the block's
// damage from strength, for a class with a shield.
function feedsOf(stats: Stats, classTag: String): Array<Feed> {
  const by = stats.conversions
  const all: Array<Feed> = [
    { from: .Strength, to: .AttackPower, per: by.attackPerStrength },
    { from: .Agility, to: .AttackPower, per: by.attackPerAgility },
    { from: .Agility, to: .RangedAttackPower, per: by.rangedPerAgility },
    { from: .Agility, to: .MeleeCrit, per: by.critPerAgility },
    { from: .Agility, to: .RangedCrit, per: by.critPerAgility },
    { from: .Intellect, to: .SpellCrit, per: by.spellCritPerIntellect },
    { from: .Agility, to: .Armor, per: 2 },
    { from: .Stamina, to: .Health, per: 10, past: 20 }
  ]
  if (stats.resource == Resource.Mana) { all.push({ from: .Intellect, to: .Power, per: 15, past: 20 }) }
  // Spirit's share of health's regeneration out of a fight, and of mana's outside casting, as the client says it.
  if (stats.spirit > 0) {
    all.push({ from: .Spirit, to: .HealthRegen, per: stats.healthFromSpirit / stats.spirit })
    if (stats.resource == Resource.Mana) { all.push({ from: .Spirit, to: .ManaRegen, per: stats.manaFromSpirit / stats.spirit }) }
  }
  if (SHIELD_CLASSES.any(tag => tag == classTag)) { all.push({ from: .Strength, to: .BlockValue, per: 1 / 20 }) }
  // The defense past the level's: 0.04% of dodge, parry and block a point (the game's `DEFAULT_STATDEFENSE_TOOLTIP`).
  const levels = stats.defense - stats.defensePast
  for (avoided of DEFENDED) { all.push({ from: .Defense, to: avoided, per: SKILL_STEP, start: levels }) }
  return all
}

// What the game's paper doll says of a stat under its name, the client's own words; empty where it says nothing. A
// crit says what it does in its own section alone (the game's `STAT_CRIT_BONUS` says both, and the stats feeding
// each, which light on the window).
public function wordsOf(stat: Stat, stats: Stats): String {
  const tips = stats.tips
  return match (stat) {
    .Strength => tips.primary[1] ?? ""
    .Agility => tips.primary[2] ?? ""
    .Stamina => tips.primary[3] ?? ""
    .Intellect => tips.primary[4] ?? ""
    .Spirit => tips.primary[5] ?? ""
    .Armor => tips.armor
    .AttackPower => tips.attackPower
    .RangedAttackPower => tips.rangedAttackPower
    .MeleeCrit, .RangedCrit => Locale.CRIT_WEAPON.format()
    .SpellCrit => Locale.CRIT_SPELL.format()
    .Expertise => Locale.EXPERTISE_TIP
    .Defense => tips.defense
    .BlockValue => tips.block
    .ArmorPenetration => tips.armorPenetration
    .SpellPenetration => tips.spellPenetration
    .SpellDamage => tips.spellDamage
    .Healing => tips.healing
    .MeleeHaste => Locale.HASTE_MELEE_TIP
    .RangedHaste => Locale.HASTE_RANGED_TIP
    .SpellHaste => Locale.HASTE_SPELL_TIP
    else => ""
  }
}

// A stat's sources other than its base: the stats that feed it, the items and sets that give it, the auras that change
// it; the stats that feed it and each item's share by its slot.
struct Parts {
  const fromStats: Array<Part>
  const fromItems: Array<Part>
  const fromEffects: Array<Part>
  const fed: Array<Stat>
  const shares: Map<Integer, String>
}

function sum(parts: Array<Part>): Number {
  let total: Number = 0
  for (part of parts) { total += part.amount }
  return total
}

// One weapon's lines in the damage's tooltip, as the game's paper doll writes them: its seconds between hits and its
// hit's damage (the least down, the most up, at least 1); a hand's of two, its damage a second too (the card's is both
// hands').
function handRows(min: Number, max: Number, speed: Number, ofTwo: Boolean): Array<TipRow> {
  const rows: Array<TipRow> = [
    { label: Locale.ATTACK_SPEED, value: "%.2f".format(speed) },
    { label: Locale.DAMAGE, value: `${min.floor().max(1)} - ${max.ceil().max(1)}` }
  ]
  if (ofTwo) { rows.push({ label: Locale.DPS, value: "%.1f".format(handDps(min, max, speed)) }) }
  return rows
}

// The weapons' damage's tooltip (`CharacterDamageFrame_OnEnter`): the weapon's lines, or with a weapon in each hand
// each hand's section; the melee's glancing blows. Attack power lights with it, and each weapon's slot with its damage
// a second.
function damageBreakdown(ranged: Boolean, stats: Stats): Breakdown {
  const shares: Map<Integer, String> = {}
  if (ranged) {
    shares[RANGED_SLOT] = "%.1f".format(rangedDps(stats))
    const rows = handRows(stats.rangedMinDamage, stats.rangedMaxDamage, stats.rangedSpeed, false)
    return { text: "", rows: rows, sections: [], fed: [.RangedAttackPower, .RangedAttackSpeed], shares: shares }
  }
  shares[MAIN_HAND_SLOT] = "%.1f".format(handDps(stats.minDamage, stats.maxDamage, stats.speed))
  const sections: Array<TipSection> = []
  const off = stats.offSpeed ?? 0
  let rows: Array<TipRow> = []
  if (off > 0) {
    sections.push({ title: Locale.MAIN_HAND, rows: handRows(stats.minDamage, stats.maxDamage, stats.speed, true) })
    sections.push({ title: Locale.OFF_HAND, rows: handRows(stats.offMinDamage, stats.offMaxDamage, off, true) })
    shares[OFF_HAND_SLOT] = "%.1f".format(handDps(stats.offMinDamage, stats.offMaxDamage, off))
  } else {
    rows = handRows(stats.minDamage, stats.maxDamage, stats.speed, false)
  }
  const hit = (stats.minDamage + stats.maxDamage) / 2
  sections.push({ title: Locale.GLANCING_BLOWS, rows: [
    glancingRow(Locale.HIT_CAP_BOSS, stats.bossGlancingPenalty, hit),
    glancingRow(Locale.HIT_CAP_LEVEL, stats.levelGlancingPenalty, hit)
  ] })
  return { text: "", rows: rows, sections: sections, fed: [.AttackPower, .AttackSpeed], shares: shares }
}

// A target's glancing blows in the damage's tooltip: how much less such a blow deals, in percent and in damage off the
// main hand's average hit («-35.00% (-42)»). How often a swing glances is the chance to hit's.
function glancingRow(target: String, penalty: Number, hit: Number): TipRow {
  return { label: target, value: `-${amountText(penalty, true)} (-${(hit * penalty / 100).round()})` }
}

// The weapons' slots.
const MAIN_HAND_SLOT = 16
const OFF_HAND_SLOT = 17
const RANGED_SLOT = 18

// The hit that misses nothing (the game's `CR_<CLASS>_HIT_CAP_TOOLTIP`), in percent: against a raid's boss and a target
// of the player's level, for melee and ranged attacks, spells, and a weapon in each hand's own swings.
struct HitCaps {
  const boss: Number
  const level: Number
}
const WEAPON_HIT_CAPS: HitCaps = { boss: 8, level: 5 }
const SPELL_HIT_CAPS: HitCaps = { boss: 17, level: 4 }
const DUAL_HIT_CAPS: HitCaps = { boss: 27, level: 24 }

// How a chance reads: green at its best, yellow while at least half the way there from where it starts, red short of
// that. `left` is what is left of what the stat takes off (a miss, a dodge), `whole` all of it.
function toneOf(left: Number, whole: Number): Color {
  if (left <= 0) { return Style.GREEN }
  return left * 2 <= whole ? Style.YELLOW : Style.RED
}

// The chance to hit a target, bigger better: what the hit leaves of the target's misses taken off the whole.
function hitRow(label: String, hit: Number, cap: Number): TipRow {
  const miss = (cap - hit).max(0)
  return { label: label, value: amountText(100 - miss, true), valueTone: toneOf(miss, cap) }
}

function hitRows(hit: Number, caps: HitCaps): Array<TipRow> {
  return [hitRow(Locale.HIT_CAP_BOSS, hit, caps.boss), hitRow(Locale.HIT_CAP_LEVEL, hit, caps.level)]
}

// A hit's caps, its section's alone: the spells' for spell hit; for melee and ranged hit the weapons', and with a weapon
// in each hand its own swings' too (`dual`).
function capsOf(stat: Stat, dual: Boolean): Array<HitCaps> {
  if (stat == .SpellHit) { return [SPELL_HIT_CAPS] }
  return stat == .MeleeHit && dual ? [WEAPON_HIT_CAPS, DUAL_HIT_CAPS] : [WEAPON_HIT_CAPS]
}

function hitOf(stat: Stat, stats: Stats): Number {
  return stat == .SpellHit ? stats.spellHit : stat == .RangedHit ? stats.rangedHit : stats.meleeHit
}

function dualOf(stats: Stats): Boolean { return (stats.offSpeed ?? 0) > 0 }

// A hit's chances to hit, its section's alone: a raid's boss and a target of the player's level; with a weapon in each
// hand its plain swings' too.
function hitChancesOf(stat: Stat, stats: Stats): Array<TipSection> {
  const hit = hitOf(stat, stats)
  const caps = capsOf(stat, dualOf(stats))
  return caps.map(c => TipSection { title: c == DUAL_HIT_CAPS ? Locale.HIT_CAP_DUAL : Locale.HIT_CHANCE, rows: hitRows(hit, c) })
}

// A cap a gauge marks: where it stands in the stat's own unit, and its tooltip's title and text.
public struct Cap {
  const at: Number
  const title: String
  const text: String
}

// A hit gauge's caps: each target's hit that misses nothing.
public function hitCaps(stat: Stat, stats: Stats): Array<Cap> {
  const caps: Array<Cap> = []
  for (c of capsOf(stat, dualOf(stats))) {
    const title = c == DUAL_HIT_CAPS ? Locale.HIT_CAP_DUAL : ""
    caps.push({ at: c.boss, title: title != "" ? `${title}: ${Locale.HIT_CAP_BOSS}` : Locale.HIT_CAP_BOSS, text: Locale.HIT_MARK.format(amountText(c.boss, true)) })
    caps.push({ at: c.level, title: title != "" ? `${title}: ${Locale.HIT_CAP_LEVEL}` : Locale.HIT_CAP_LEVEL, text: Locale.HIT_MARK.format(amountText(c.level, true)) })
  }
  return caps
}

// What a target dodges and parries, in percent (the game's `CR_EXPERTISE_TOOLTIP`, `BASE_ENEMY_DODGE_CHANCE`): a raid's
// boss, three levels over the player, and a target of the player's level. Expertise takes the dodge off first, and only
// what is past the dodge takes off the parry (`GetEnemyParryChance`). A blow from the front may be blocked too, with or
// without a shield: the client says no target's block, so it is the players' own measure, at most 5% at any level.
struct Avoidance {
  const dodge: Number
  const parry: Number
  const block: Number
}
const MOST_BLOCK = 5
const BOSS_AVOIDANCE: Avoidance = { dodge: 6.5, parry: 16.5, block: 5 }
// A target by its name in a tooltip, and what it dodges and parries.
struct Target {
  const name: String
  const of: Avoidance
}
const LEVEL_AVOIDANCE: Avoidance = { dodge: 5, parry: 5, block: 5 }

// One target's chances to dodge and to parry at the player's expertise, bigger worse: the dodge less the expertise, the
// parry less what is past the dodge.
function avoidanceRows(expertise: Number, of: Avoidance): Array<TipRow> {
  const dodge = (of.dodge - expertise).max(0)
  const parry = (of.parry - (expertise - of.dodge).max(0)).max(0)
  return [
    { label: Locale.DODGE, value: amountText(dodge, true), valueTone: toneOf(dodge, of.dodge) },
    { label: Locale.PARRY, value: amountText(parry, true), valueTone: toneOf(parry, of.parry) }
  ]
}

// The expertise gauge's caps: where each target no longer dodges, and where it no longer parries (past its dodge).
public function expertiseCaps(): Array<Cap> {
  const caps: Array<Cap> = []
  const targets: Array<Target> = [{ name: Locale.HIT_CAP_BOSS, of: BOSS_AVOIDANCE }, { name: Locale.HIT_CAP_LEVEL, of: LEVEL_AVOIDANCE }]
  for (target of targets) {
    const parry = target.of.dodge + target.of.parry
    caps.push({ at: target.of.dodge, title: target.name, text: Locale.DODGE_MARK.format(amountText(target.of.dodge, true)) })
    caps.push({ at: parry, title: target.name, text: Locale.PARRY_MARK.format(amountText(parry, true)) })
  }
  return caps
}

// Expertise's sections: a raid's boss's, and a target of the player's level's.
function avoidanceOf(expertise: Number): Array<TipSection> {
  return [
    { title: Locale.HIT_CAP_BOSS, rows: avoidanceRows(expertise, BOSS_AVOIDANCE) },
    { title: Locale.HIT_CAP_LEVEL, rows: avoidanceRows(expertise, LEVEL_AVOIDANCE) }
  ]
}

// What lands of a section's attacks: a melee blow, a ranged shot, a spell.
public enum Strike { Melee, Ranged, Spell }

// The strike a stat of what lands counts; none for any other stat.
function strikeOf(stat: Stat): Strike | nil {
  return match (stat) {
    .MeleeLands => .Melee
    .RangedLands => .Ranged
    .SpellLands => .Spell
    else => nil
  }
}

// What a point of weapon skill past a target's defense takes off its misses, dodges and parries and adds to crit, in
// percent (the game's skills frame).
const SKILL_STEP = 0.04

// What a strike against a target comes short of, in percent, at the player's hit, weapon skill and expertise: a miss;
// a dodge (not a spell's; expertise lowers a melee blow's alone); a parry (a melee blow's, from the front alone); a
// block (a blow's or a shot's from the front, which lands for less).
struct Odds {
  const miss: Number
  const dodge: Number
  const parry: Number
  const block: Number
}

// The weapon skill a strike's weapon has past the level's; none for a spell.
function skillPast(strike: Strike, stats: Stats): Number {
  return strike == .Melee ? stats.meleeSkillPast : strike == .Ranged ? stats.rangedSkillPast : 0
}

// A raid boss's defense past a character's of the game's greatest level, at which the hit caps and the avoidances are
// counted (level 63's 315 against level 60's 300).
const BOSS_DEFENSE_PAST_MOST = 15

// What the weapon's skill takes off a target's chances, in percent: each point past the target's defense 0.04, from
// where the caps are counted (a weapon at its level's most; against a boss, at the greatest level's).
function edgeOf(strike: Strike, stats: Stats, boss: Boolean): Number {
  if (strike == .Spell) { return 0 }
  const short = boss ? stats.bossDefensePast - BOSS_DEFENSE_PAST_MOST : 0
  return (skillPast(strike, stats) - short) * SKILL_STEP
}

function oddsOf(strike: Strike, stats: Stats, boss: Boolean, caps: HitCaps): Odds {
  const hit = strike == .Spell ? stats.spellHit : strike == .Ranged ? stats.rangedHit : stats.meleeHit
  const edge = edgeOf(strike, stats, boss)
  const miss = ((boss ? caps.boss : caps.level) - hit - edge).max(0)
  if (strike == .Spell) { return { miss: miss, dodge: 0, parry: 0, block: 0 } }
  const of = boss ? BOSS_AVOIDANCE : LEVEL_AVOIDANCE
  const dodged = (of.dodge - edge).max(0)
  const block = (of.block - edge).max(0).min(MOST_BLOCK)
  if (strike == .Ranged) { return { miss: miss, dodge: dodged, parry: 0, block: block } }
  const dodge = (dodged - stats.expertise).max(0)
  const parry = ((of.parry - edge).max(0) - (stats.expertise - dodged).max(0)).max(0)
  return { miss: miss, dodge: dodge, parry: parry, block: block }
}

function strikeCaps(strike: Strike): HitCaps { return strike == .Spell ? SPELL_HIT_CAPS : WEAPON_HIT_CAPS }

// What lands of a strike, from behind (a blow there is never parried), against the target the card counts: a raid's
// boss at the game's greatest level, else a target of the player's level. A melee blow is an ability's: a weapon in
// each hand misses no more with them.
public function landsOf(strike: Strike, stats: Stats): Number {
  const odds = oddsOf(strike, stats, stats.atMaxLevel, strikeCaps(strike))
  return 100 - odds.miss - odds.dodge
}

// A strike's chance to crit a target: its own, less what the target's defense has past the weapon's skill.
function critAt(strike: Strike, stats: Stats, boss: Boolean): Number {
  if (strike == .Spell) { return stats.spellCrit }
  const crit = strike == .Ranged ? stats.rangedCrit : stats.meleeCrit
  return (crit + (skillPast(strike, stats) - (boss ? stats.bossDefensePast : 0)) * SKILL_STEP).max(0)
}

// A part of what a strike comes to: its name, its share in percent, the colour the bar gives it, and for a part that
// fails, all of it the target starts with (its value reads green to red by what is left of that).
struct Outcome {
  const label: String
  const share: Number
  const color: Color
  const whole: Number | nil = nil
}

// What a strike comes to against a target, from the front, part by part in the order the game's roll takes them. A
// swing's or a shot's one roll: misses, dodges, parries, glancing blows and blocks first (a block in what the rest
// leave), crits in what they leave (no more: past it a crit is lost), ordinary blows the rest. A spell's two: a miss,
// then a crit of what lands.
function outcomesOf(strike: Strike, stats: Stats, boss: Boolean): Array<Outcome> {
  const caps = strike == .Melee && dualOf(stats) ? DUAL_HIT_CAPS : strikeCaps(strike)
  const odds = oddsOf(strike, stats, boss, caps)
  const whole = oddsOf(strike, {}, boss, caps)
  const crit = critAt(strike, stats, boss)
  const outcomes: Array<Outcome> = [{ label: Locale.MISS, share: odds.miss, color: Style.RED, whole: whole.miss }]
  if (strike == .Spell) {
    const crits = (100 - odds.miss) * crit / 100
    outcomes.push({ label: Locale.ORDINARY, share: 100 - odds.miss - crits, color: Style.ORDINARY })
    outcomes.push({ label: Locale.CRIT, share: crits, color: Style.GREEN })
    return outcomes
  }
  outcomes.push({ label: Locale.DODGE, share: odds.dodge, color: Style.AVOIDED, whole: whole.dodge })
  if (strike == .Melee) {
    outcomes.push({ label: Locale.PARRY, share: odds.parry, color: Style.AVOIDED, whole: whole.parry })
    outcomes.push({ label: Locale.GLANCING, share: boss ? stats.bossGlancing : stats.levelGlancing, color: Style.YELLOW })
  }
  const blocks = odds.block.min(roomOf(outcomes))
  outcomes.push({ label: Locale.BLOCK, share: blocks, color: Style.YELLOW })
  const room = roomOf(outcomes)
  const crits = crit.min(room)
  outcomes.push({ label: Locale.ORDINARY, share: room - crits, color: Style.ORDINARY })
  outcomes.push({ label: Locale.CRIT, share: crits, color: Style.GREEN })
  return outcomes
}

// What the parts so far leave of the roll.
function roomOf(outcomes: Array<Outcome>): Number {
  let taken: Number = 0
  for (o of outcomes) { taken = taken + o.share }
  return (100 - taken).max(0)
}

// How a part's value reads: a failing part's by what is left of it, any other's plain.
function gradeOf(outcome: Outcome): Color | nil {
  const whole = outcome.whole
  if (whole == nil) { return nil }
  return toneOf(outcome.share, whole)
}

// One target's section of what blows come to: a line a part, its name in the bar's colour, then the bar.
function outcomeSection(title: String, outcomes: Array<Outcome>): TipSection {
  const rows = outcomes.map(o => TipRow {
    label: o.label,
    value: amountText(o.share, true),
    tone: o.color,
    valueTone: gradeOf(o)
  })
  return { title: title, rows: rows, shares: outcomes.map(o => TipSlice { share: o.share, color: o.color }) }
}

// A tooltip's two targets, the one its card counts first (a raid's boss at the game's greatest level, else a target of
// the player's level): each target's section by `sectionOf`.
function bothTargets(stats: Stats, sectionOf: (title: String, boss: Boolean) => TipSection): Array<TipSection> {
  const boss = stats.atMaxLevel
  return [
    sectionOf(boss ? Locale.HIT_CAP_BOSS : Locale.HIT_CAP_LEVEL, boss),
    sectionOf(boss ? Locale.HIT_CAP_LEVEL : Locale.HIT_CAP_BOSS, !boss)
  ]
}

// What lands's tooltip: what the card counts, then what a strike comes to against each target, the card's first.
function landsBreakdown(strike: Strike, stats: Stats): Breakdown {
  const text = strike == .Melee ? Locale.LANDS_TIP : strike == .Ranged ? Locale.LANDS_RANGED_TIP : Locale.LANDS_SPELL_TIP
  const sections = bothTargets(stats, (title: String, boss: Boolean): TipSection => outcomeSection(title, outcomesOf(strike, stats, boss)))
  const fed: Array<Stat> = strike == .Melee ? [.MeleeHit, .Expertise] : strike == .Ranged ? [.RangedHit] : [.SpellHit]
  return { text: text, sections: sections, fed: fed, shares: {} }
}

// What an enemy's blows from the front come to on the player, part by part in the order the roll takes them, each in
// what the parts before it leave (the game's paper doll, `GetEnemyChanceToMiss` and its kin): a miss from 5%, 0.04% more
// a point of the player's defense past the enemy's weapon skill; the player's dodge, parry and block (a shield's), 0.04%
// less a point of the enemy's skill past the level's; a crit from 5%, as the miss the other way; a crushing blow from
// an enemy 15 points past the defense (at most the level's), 2% a point less 15; ordinary hits the rest. The enemy: a
// raid boss (its level 63's skill, 315), or one of the player's level.
function takenOf(stats: Stats, boss: Boolean): Array<Outcome> {
  const past = boss ? stats.bossDefensePast : 0
  const edge = (stats.defensePast - past) * SKILL_STEP
  const lose = past * SKILL_STEP
  const gap = past + (-stats.defensePast).max(0)
  const parts: Array<Outcome> = []
  const add = (label: String, chance: Number, color: Color) => {
    parts.push({ label: label, share: chance.max(0).min(roomOf(parts)), color: color })
  }
  add(Locale.MISS, BASE_ENEMY_MISS + edge, Style.GREEN)
  add(Locale.DODGE, stats.dodge - lose, Style.EVADED)
  add(Locale.PARRY, stats.parry - lose, Style.EVADED)
  if (stats.shield) { add(Locale.BLOCK, stats.block - lose, Style.YELLOW) }
  add(Locale.CRIT, BASE_ENEMY_CRIT - edge, Style.RED)
  add(Locale.CRUSHING, gap >= CRUSHING_GAP ? gap * 2 - CRUSHING_GAP : 0, Style.CRUSHED)
  add(Locale.ORDINARY, 100, Style.TAKEN)
  return parts
}
const BASE_ENEMY_MISS = 5
const BASE_ENEMY_CRIT = 5
const CRUSHING_GAP = 15

// What of an enemy's blows lands on the player, from the front, against the enemy the card counts: neither a miss, a
// dodge nor a parry.
function hitTakenOf(stats: Stats): Number {
  const parts = takenOf(stats, stats.atMaxLevel)
  let avoided: Number = 0
  for (index of 1..3) { avoided = avoided + (parts[index]?.share ?? 0) }
  return 100 - avoided
}

function takenBreakdown(stats: Stats): Breakdown {
  const sections = bothTargets(stats, (title: String, boss: Boolean): TipSection => outcomeSection(title, takenOf(stats, boss)))
  return { text: Locale.HIT_TAKEN_TIP, sections: sections, fed: [.Defense, .Dodge, .Parry, .Block], shares: {} }
}

// What a weapon's skill does against each target, as the game's skills frame says it: past the target's defense (a
// raid boss's 315, a target of the player's level's own), so much more hit and crit and less dodge and parry, signed;
// against a boss, the main hand's glancing blows too.
function skillBreakdown(stat: Stat, stats: Stats): Breakdown {
  const past = statValue(stat, stats)
  const sections = bothTargets(stats, (title: String, boss: Boolean): TipSection => {
    const edge = (past - (boss ? stats.bossDefensePast : 0)) * SKILL_STEP
    const rows: Array<TipRow> = [
      { label: Locale.SKILL_HIT, value: signedPercent(edge), valueTone: edgeTone(edge) },
      { label: Locale.CRIT, value: signedPercent(edge), valueTone: edgeTone(edge) }
    ]
    if (stat == .MainHandSkill) {
      const chance = boss ? stats.bossGlancing : stats.levelGlancing
      const penalty = boss ? stats.bossGlancingPenalty : stats.levelGlancingPenalty
      rows.push({ label: Locale.GLANCING, value: Locale.GLANCING_PENALTY.format(amountText(chance, true), amountText(penalty, true)) })
    }
    return { title: title, rows: rows }
  })
  return { text: Locale.WEAPON_SKILL_TIP, sections: sections, fed: [], shares: {} }
}

// The seconds between swings (each hand's, with a weapon in each) or between shots: the haste first, then each weapon's
// own speed divided by it, worked out before what it comes to («2.30 ÷ 1.15 = 2.00 s»). The client gives the hasted
// seconds; the weapon's own are those times the haste. The haste lights with it.
function speedBreakdown(ranged: Boolean, stats: Stats): Breakdown {
  const haste = ranged ? stats.rangedHaste : stats.meleeHaste
  const rows: Array<TipRow> = [{ label: Locale.HASTE, value: added(haste, true) }]
  if (ranged) {
    rows.push(swingRow(Locale.SECTION_RANGED, stats.rangedSpeed, haste))
  } else {
    rows.push(swingRow(Locale.MAIN_HAND, stats.speed, haste))
    const off = stats.offSpeed ?? 0
    if (off > 0) { rows.push(swingRow(Locale.OFF_HAND, off, haste)) }
  }
  const fed: Array<Stat> = [ranged ? .RangedHaste : .MeleeHaste]
  return { text: ranged ? Locale.RANGED_SPEED_TIP : Locale.ATTACK_SPEED_TIP, rows: rows, sections: [], fed: fed, shares: {} }
}

// A weapon's seconds between attacks: its own speed divided by the haste, worked out where there is haste.
function swingRow(label: String, hasted: Number, haste: Number): TipRow {
  if (haste == 0) { return { label: label, value: secondsText(hasted) } }
  const by = 1 + haste / 100
  return { label: label, working: `${"%.2f".format(hasted * by)} ÷ ${"%.2f".format(by)} =`, value: secondsText(hasted) }
}

function secondsText(seconds: Number): String { return `${"%.2f".format(seconds)} ${Locale.SECONDS}` }

// A change in percent with its sign: «+0.28%», «-11.08%».
function signedPercent(value: Number): String { return "%+.2f%%".format(value) }

// A change's colour: green in the player's favour, red against, plain at none.
function edgeTone(edge: Number): Color | nil {
  if (edge > 0) { return Style.GREEN }
  return edge < 0 ? Style.RED : nil
}

// The armor's cut of a raid boss's physical damage and of a target of the player's level's, the card's first.
function reductionBreakdown(stats: Stats): Breakdown {
  const sections = bothTargets(stats, (title: String, boss: Boolean): TipSection => TipSection {
    title: title,
    rows: [{ label: Locale.DAMAGE_REDUCTION, value: amountText(boss ? stats.bossArmorReduction : stats.armorReduction, true) }]
  })
  return { text: Locale.DAMAGE_REDUCTION_TIP, sections: sections, fed: [.Armor], shares: {} }
}

// What a stat's tooltip lists, and what lights with it.
public function breakdownOf(stat: Stat, text: String, facts: Facts): Breakdown {
  if (stat == .MeleeDps || stat == .RangedDps) { return damageBreakdown(stat == .RangedDps, facts.stats) }
  const strike = strikeOf(stat)
  if (strike != nil) { return landsBreakdown(strike, facts.stats) }
  if (stat == .HitTaken) { return takenBreakdown(facts.stats) }
  if (stat == .MainHandSkill || stat == .OffHandSkill || stat == .RangedSkill) { return skillBreakdown(stat, facts.stats) }
  if (stat == .AttackSpeed || stat == .RangedAttackSpeed) { return speedBreakdown(stat == .RangedAttackSpeed, facts.stats) }
  if (stat == .DamageReduction) { return reductionBreakdown(facts.stats) }
  const spec = specOf(stat)
  const parts = partsOf(stat, facts)
  const fromStats = parts.fromStats.map(part => part)
  // The base: a main stat's as the client says it, any other's the rest of its value (its level, its race, talents).
  const base = baseFor(stat, facts, parts)
  if (base.abs() >= (spec.percent ? 0.005 : 0.5)) {
    fromStats.push({ row: { label: Locale.BASE, value: amountText(base, spec.percent) }, amount: base })
  }
  const sections: Array<TipSection> = []
  section(Locale.FROM_STATS, fromStats, mut sections)
  section(Locale.FROM_ITEMS, parts.fromItems, mut sections)
  section(Locale.FROM_EFFECTS, parts.fromEffects, mut sections)
  if (stat == .MeleeHit || stat == .RangedHit || stat == .SpellHit) {
    for (chances of hitChancesOf(stat, facts.stats)) { sections.push(chances) }
  }
  if (stat == .Expertise) {
    for (target of avoidanceOf(facts.stats.expertise)) { sections.push(target) }
  }
  // Haste says what it speeds up, and by how much each, over its sources.
  return { text: text, sections: sections, fed: parts.fed, shares: parts.shares }
}

// A stat's base: a main stat's as the client says it, any other's what its sources leave of its value.
function baseFor(stat: Stat, facts: Facts, parts: Parts): Number {
  const counted = sum(parts.fromStats) + sum(parts.fromItems) + sum(parts.fromEffects)
  return baseOf(stat, facts.stats) ?? specOf(stat).of(facts.stats) - counted
}

// Each stat's base, by its name: what the character is without its items, its auras and what its stats feed.
public function basesOf(facts: Facts): Map<String, Number> {
  const bases: Map<String, Number> = {}
  for (stat of EVERY_STAT) { bases[`${stat}`] = baseFor(stat, facts, partsOf(stat, facts)) }
  return bases
}

// How the auras on the character change a stat: one lowers it (whatever others raise, as the game's paper doll reds
// a stat any debuff takes from), or one raises it.
public enum Boost { Up = "up", Down = "down" }

// An aura's share of a stat in its tooltip: green where it raises the stat, red where it lowers it, as the stat's
// value reads.
function boostTone(amount: Number): Color | nil {
  return amount > 0 ? Style.GREEN : amount < 0 ? Style.RED : nil
}

// Each stat an aura changes, by its name, and how; a stat none changes isn't in it.
public function boostsOf(facts: Facts): Map<String, Boost> {
  const boosts: Map<String, Boost> = {}
  if (facts.auras.length == 0) { return boosts }
  for (stat of EVERY_STAT) {
    const effects = partsOf(stat, facts).fromEffects
    if (effects.any(part => part.amount < 0)) {
      boosts[`${stat}`] = .Down
    } else if (effects.any(part => part.amount > 0)) {
      boosts[`${stat}`] = .Up
    }
  }
  return boosts
}

// What the items and the stats give a stat, without its base and its auras: a character's estimate, its base added.
public function givenTo(stat: Stat, facts: Facts): Number {
  const parts = partsOf(stat, facts)
  return sum(parts.fromStats) + sum(parts.fromItems)
}

function partsOf(stat: Stat, facts: Facts): Parts {
  const spec = specOf(stat)
  const total = spec.of(facts.stats)
  const fromStats: Array<Part> = []
  const fromItems: Array<Part> = []
  const fromEffects: Array<Part> = []
  const fed: Array<Stat> = []
  const shares: Map<Integer, String> = {}

  for (feed of feedsOf(facts.stats, facts.classTag)) {
    if (feed.to == stat) {
      const points = specOf(feed.from).of(facts.stats) - feed.start
      const amount = fedBy(feed, points)
      if (amount != 0) {
        fromStats.push({ row: { label: statName(feed.from), value: amountText(amount, spec.percent), working: workingOf(feed, points) }, amount: amount })
        fed.push(feed.from)
      }
    }
  }

  for (piece of facts.worn) {
    const item = piece.item
    if (item != nil) {
      for (given of piece.gives) {
        if (given.stat == stat) {
          const value = added(given.amount, spec.percent)
          fromItems.push({
            row: { label: piece.name, value: value, icon: Game.items.icon(item), tone: qualityColor(piece.quality) },
            amount: given.amount
          })
          shares[piece.slot] = value
        }
      }
    }
  }

  // Each set's bonuses once, however many of its pieces are worn; its pieces that give the stat nothing of their own
  // light with the set's share.
  const sets: Array<String> = []
  for (piece of facts.worn) {
    const set = piece.set
    if (set != nil && !sets.any(name => name == set.name)) {
      sets.push(set.name)
      let amount: Number = 0
      for (given of set.gives) {
        if (given.stat == stat) { amount += given.amount }
      }
      if (amount != 0) {
        const value = added(amount, spec.percent)
        fromItems.push({ row: { label: set.name, value: value }, amount: amount })
        for (other of facts.worn) {
          if (other.set?.name == set.name && shares[other.slot] == nil) { shares[other.slot] = value }
        }
      }
    }
  }

  for (aura of facts.auras) {
    for (change of aura.changes) {
      if (changed(change).any(s => s == stat)) {
        const name = Game.spells.name(aura.spell) ?? ""
        const icon: Art | nil = Game.spells.texture(aura.spell)
        const tone = boostTone(change.amount)
        if (multiplies(change)) {
          // What a share of the total it makes: the stat without it times the share.
          const amount = total - total / (1 + change.amount / 100)
          fromEffects.push({ row: { label: name, value: added(change.amount, true), icon: icon, valueTone: tone }, amount: amount })
        } else {
          fromEffects.push({
            row: { label: name, value: added(change.amount, spec.percent), icon: icon, valueTone: tone }, amount: change.amount
          })
        }
      }
    }
  }

  return { fromStats: fromStats, fromItems: fromItems, fromEffects: fromEffects, fed: fed, shares: shares }
}
