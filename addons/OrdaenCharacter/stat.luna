// The stats with sources of their own, and what the client's item stats give of them.

// A stat with sources of its own.
public enum Stat {
  Strength
  Agility
  Stamina
  Intellect
  Spirit
  Health
  Power
  Armor
  FireResistance
  NatureResistance
  FrostResistance
  ShadowResistance
  ArcaneResistance
  AttackPower
  RangedAttackPower
  MeleeHit
  RangedHit
  SpellHit
  MeleeCrit
  RangedCrit
  SpellCrit
  Expertise
  Haste
  ArmorPenetration
  SpellPenetration
  Dodge
  Parry
  Block
  BlockValue
  Defense
  SpellDamage
  Healing
  Regen
  RunSpeed
}

// What a worn item gives a stat, in the stat's own unit (a rating already made a percentage).
public struct Given {
  const stat: Stat
  const amount: Number
}

// The client's item stats (`C_Item.GetItemStats`' keys), each the stats it gives and the combat rating it is counted
// in (none: 0), which the sheet turns into the stat's percentage.
public struct ItemKey {
  const stats: Array<Stat>
  const rating: Integer = 0
}
public const ITEM_KEYS: Map<String, ItemKey> = {
  ITEM_MOD_STRENGTH_SHORT: { stats: [.Strength] },
  ITEM_MOD_AGILITY_SHORT: { stats: [.Agility] },
  ITEM_MOD_STAMINA_SHORT: { stats: [.Stamina] },
  ITEM_MOD_INTELLECT_SHORT: { stats: [.Intellect] },
  ITEM_MOD_SPIRIT_SHORT: { stats: [.Spirit] },
  RESISTANCE0_NAME: { stats: [.Armor] },
  RESISTANCE2_NAME: { stats: [.FireResistance] },
  RESISTANCE3_NAME: { stats: [.NatureResistance] },
  RESISTANCE4_NAME: { stats: [.FrostResistance] },
  RESISTANCE5_NAME: { stats: [.ShadowResistance] },
  RESISTANCE6_NAME: { stats: [.ArcaneResistance] },
  ITEM_MOD_ATTACK_POWER_SHORT: { stats: [.AttackPower, .RangedAttackPower] },
  ITEM_MOD_RANGED_ATTACK_POWER_SHORT: { stats: [.RangedAttackPower] },
  ITEM_MOD_HIT_RATING_SHORT: { stats: [.MeleeHit, .RangedHit], rating: 6 },
  ITEM_MOD_HIT_SPELL_RATING_SHORT: { stats: [.SpellHit], rating: 8 },
  ITEM_MOD_CRIT_RATING_SHORT: { stats: [.MeleeCrit, .RangedCrit], rating: 9 },
  ITEM_MOD_CRIT_SPELL_RATING_SHORT: { stats: [.SpellCrit], rating: 11 },
  ITEM_MOD_DEFENSE_SKILL_RATING_SHORT: { stats: [.Defense], rating: 2 },
  ITEM_MOD_DODGE_RATING_SHORT: { stats: [.Dodge], rating: 3 },
  ITEM_MOD_PARRY_RATING_SHORT: { stats: [.Parry], rating: 4 },
  ITEM_MOD_BLOCK_RATING_SHORT: { stats: [.Block], rating: 5 },
  ITEM_MOD_BLOCK_VALUE_SHORT: { stats: [.BlockValue] },
  ITEM_MOD_HASTE_RATING_SHORT: { stats: [.Haste], rating: 18 },
  ITEM_MOD_EXPERTISE_RATING_SHORT: { stats: [.Expertise], rating: 24 },
  ITEM_MOD_ARMOR_PENETRATION_RATING_SHORT: { stats: [.ArmorPenetration] },
  ITEM_MOD_SPELL_PENETRATION_SHORT: { stats: [.SpellPenetration] },
  ITEM_MOD_SPELL_POWER_SHORT: { stats: [.SpellDamage, .Healing] },
  ITEM_MOD_SPELL_DAMAGE_DONE_SHORT: { stats: [.SpellDamage] },
  ITEM_MOD_SPELL_HEALING_DONE_SHORT: { stats: [.Healing] },
  ITEM_MOD_MANA_REGENERATION_SHORT: { stats: [.Regen] }
}
