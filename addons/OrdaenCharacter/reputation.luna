// «Reputation»: the game's factions in its groups, which fold as the game's do (the game keeps them folded); each
// faction a row with its name, a bar in its standing's colour with the standing on it, and what it rose this
// session. The faction picked stands on the right: its standing, the bar with the numbers, how far to the next
// standing, the game's description, and its switches: at war (where the game lets it), inactive, and shown on the
// bar (the faction the game watches).
import { Align, Art, TextFont } from "$ltml"
import root Ordaen from "Ordaen"
import { Choice, Component, SECONDARY_TEXT, ScrolledList, Shown, ShownToggle, TITLE_TEXT, ToolPick, Toolbar } from "Ordaen"
import { GaugeBar } from "@/gauge"
import Locale from "@/locales"
import { Faction, standingColor, standingName } from "@/sheet"
import Style from "@/style"

const EXALTED = 8
const BAR_WIDTH = 187.5dp
const INDENT = 18.75dp
const MARK = 18.75dp
const CLEAR: Color = Color.hex("#00000000")

// How far along its standing a faction is, from 0 to 1.
function fractionOf(faction: Faction): Number {
  if (faction.max <= faction.min) { return 1 }
  return (faction.value - faction.min) / (faction.max - faction.min)
}

// What a faction rose since the window first read it this session.
public function gainOf(faction: Faction, starts: Map<Integer, Integer>): Integer {
  return faction.value - (starts[faction.id] ?? faction.value)
}

function shownOf(on: Boolean): Shown { return on ? .On : .Off }

// What the list shows: every faction, or those at war alone.
public enum FactionShow { All, AtWar }

const SHOWS: Array<Choice<FactionShow>> = [
  { value: FactionShow.All, label: Locale.SHOW_ALL },
  { value: FactionShow.AtWar, label: Locale.SHOW_AT_WAR }
]

function keeps(faction: Faction, needle: String, show: FactionShow): Boolean {
  if (show == .AtWar && !faction.atWar) { return false }
  return needle == "" || faction.name.lower().contains(needle)
}

// The factions the list shows: those whose name holds the search (and those at war alone, where so chosen), each
// under the heading the game lists it under, which stays while it holds any. A folded group's factions are the
// game's to list: a search finds them once it is opened.
public function listedOf(factions: Array<Faction>, search: String, show: FactionShow): Array<Faction> {
  const needle = search.lower()
  if (needle == "" && show == .All) { return factions }
  const listed: Array<Faction> = []
  let heading: Faction | nil = nil
  for (faction of factions) {
    if (faction.header) {
      heading = faction
      if (faction.ranked && keeps(faction, needle, show)) {
        listed.push(faction)
        heading = nil
      }
    } else if (keeps(faction, needle, show)) {
      if (heading != nil) { listed.push(heading) }
      heading = nil
      listed.push(faction)
    }
  }
  return listed
}

// The footer's count: the factions met, and those at war.
public function factionsCount(factions: Array<Faction>): String {
  const met = factions.count(f => !f.header || f.ranked)
  const atWar = factions.count(f => f.atWar)
  const count = Locale.FACTIONS_COUNT.format(met)
  return atWar == 0 ? count : `${count} · ${Locale.AT_WAR_COUNT.format(atWar)}`
}

// A row of the list: a group's heading, which folds, or a faction, which is picked.
public class FactionRow implements Component {
  public pick: Event<Faction> = new Event()
  public fold: Event<Faction> = new Event()

  derived standing: String = standingName(self.faction.standing)
  derived share: Number = fractionOf(self.faction)
  derived tone: Color = standingColor(self.faction.standing)
  derived barShown: Boolean = !self.faction.header || self.faction.ranked
  derived mark: Art | nil = self.faction.header ? (self.faction.collapsed ? Ordaen.art.ctl.markClosed : Ordaen.art.ctl.markOpen) : nil
  derived indent: Number<Length> = self.faction.child ? INDENT : 0ui
  derived gainText: String = self.gain > 0 ? `+${self.gain}` : ""
  derived nameColor: Color = self.faction.header ? Style.GOLD : self.faction.atWar ? Style.RED : Style.INK
  derived background: Color = self.picked ? Style.PICKED : CLEAR

  faction: Signal<Faction>
  gain: Signal<Integer>
  picked: Signal<Boolean>
  constructor(faction: Signal<Faction>, gain: Signal<Integer>, picked: Signal<Boolean>) {
    self.faction = faction
    self.gain = gain
    self.picked = picked
  }

  onClick(self) {
    const faction = peek self.faction
    if (faction.header) { self.fold.emit(faction) }
    if (!faction.header || faction.ranked) { self.pick.emit(faction) }
  }

  public render(self): Template {
    return $ltml {
      <box columns={[self.indent, MARK, { fr: 1 }, BAR_WIDTH, 46.875dp]} gap={3sp}
           yAlign={Align.Center} background={self.background} @pointerPress={self.onClick}
           @keyPress(.Enter)={self.onClick} @keyPress(.Space)={self.onClick}>
        <box />
        <box width={MARK} height={MARK} background={self.mark} />
        <text value={self.faction.name} textColor={self.nameColor} wrap={.None} />
        <box opacity={self.barShown ? 1 : 0}>
          <GaugeBar value={self.share} tone={self.tone} height={Style.GAUGE_BAR} text={self.standing} font={TextFont.Body} />
        </box>
        <text value={self.gainText} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers} textColor={Style.GREEN}
              wrap={.None} />
      </box>
    }
  }
}

// A switch of the picked faction, its label on the left.
public class FactionSwitch implements Component {
  public flip: Event<nil> = new Event()

  derived state: Shown = shownOf(self.on)
  derived ink: Color = self.disabled ? Style.DIM : Style.INK

  label: Signal<String>
  on: Signal<Boolean>
  disabled: Signal<Boolean>
  constructor(label: Signal<String>, on: Signal<Boolean>, disabled: Signal<Boolean> = false) {
    self.label = label
    self.on = on
    self.disabled = disabled
  }

  onFlip(self) { self.flip.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={[{ fr: 1 }, "max-content"]} gap={3sp} yAlign={Align.Center}>
        <text value={self.label} textColor={self.ink} />
        <ShownToggle state={self.state} disabled={self.disabled} @flip={self.onFlip} />
      </box>
    }
  }
}

// The picked faction, beside the list.
public class FactionDetail implements Component {
  public atWar: Event<Faction> = new Event()
  public inactive: Event<Faction> = new Event()
  public watch: Event<Faction> = new Event()

  derived standing: String = standingName(self.faction.standing)
  derived share: Number = fractionOf(self.faction)
  derived tone: Color = standingColor(self.faction.standing)
  derived numbers: String = `${self.faction.value - self.faction.min} / ${self.faction.max - self.faction.min}`
  derived toNext: String = self.faction.standing < EXALTED ?
    Locale.TO_NEXT.format(standingName(self.faction.standing + 1), String.of(self.faction.max - self.faction.value)) :
    ""
  derived gainText: String = self.gain > 0 ? `+${self.gain}` : ""
  derived noWar: Boolean = !self.faction.canToggleAtWar || self.faction.header
  derived noInactive: Boolean = !self.faction.canSetInactive

  faction: Signal<Faction>
  gain: Signal<Integer>
  isInactive: Signal<Boolean>
  constructor(faction: Signal<Faction>, gain: Signal<Integer>, isInactive: Signal<Boolean>) {
    self.faction = faction
    self.gain = gain
    self.isInactive = isInactive
  }

  onAtWar(self) { self.atWar.emit(peek self.faction) }
  onInactive(self) { self.inactive.emit(peek self.faction) }
  onWatch(self) { self.watch.emit(peek self.faction) }

  public render(self): Template {
    return $ltml {
      <box gap={3sp}>
        <box gap={2sp}>
          <text value={self.faction.name} textSize={TITLE_TEXT} leading={.Title} textFont={TextFont.Title} textColor={Style.GOLD} />
          <text value={self.standing} textColor={Style.INK} />
        </box>
        <GaugeBar value={self.share} tone={self.tone} height={Style.GAUGE_BAR} text={self.numbers} />
        <box columns={[{ fr: 1 }, "max-content"]}>
          <text value={self.toNext} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
          <text value={self.gainText} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers} textColor={Style.GREEN} />
        </box>
        <text value={self.faction.description} textSize={SECONDARY_TEXT} textColor={Style.INK} />
        <box gap={3sp}>
          <FactionSwitch label={Locale.AT_WAR} on={self.faction.atWar} disabled={self.noWar} @flip={self.onAtWar} />
          <FactionSwitch label={Locale.INACTIVE} on={self.isInactive} disabled={self.noInactive}
                         @flip={self.onInactive} />
          <FactionSwitch label={Locale.WATCHED} on={self.faction.watched} @flip={self.onWatch} />
        </box>
      </box>
    }
  }
}

public class ReputationPage implements Component {
  public pick: Event<Faction> = new Event()
  public fold: Event<Faction> = new Event()
  public atWar: Event<Faction> = new Event()
  public inactive: Event<Faction> = new Event()
  public watch: Event<Faction> = new Event()

  derived picked: Faction | nil = self.factions.find(f => f.id == self.chosen && (!f.header || f.ranked))
  derived hasPick: Boolean = self.picked != nil
  derived pickedGain: Integer = self.picked == nil ? 0 : gainOf(self.picked ?? panic("picked"), self.starts)
  derived shownPick: Faction = self.picked ?? self.factions[1] ?? panic("a faction is picked from the list")
  derived listed: Array<Faction> = listedOf(self.factions, self.search, self.show)
  derived none: Boolean = self.listed.length == 0
  derived narrowed: Boolean = self.show != .All

  factions: Signal<Array<Faction>>
  starts: Signal<Map<Integer, Integer>>
  chosen: Signal<Integer>
  chosenInactive: Signal<Boolean>
  // The toolbar's search and filter, the window's to keep.
  search: mut Signal<String>
  show: mut Signal<FactionShow>
  constructor(factions: Signal<Array<Faction>>, starts: Signal<Map<Integer, Integer>>, chosen: Signal<Integer>,
    chosenInactive: Signal<Boolean>, search: mut Signal<String>, show: mut Signal<FactionShow>) {
    self.factions = factions
    self.starts = starts
    self.chosen = chosen
    self.chosenInactive = chosenInactive
    self.search = search
    self.show = show
  }

  onPick(self, faction: Faction) { self.pick.emit(faction) }
  onFold(self, faction: Faction) { self.fold.emit(faction) }
  onAtWar(self, faction: Faction) { self.atWar.emit(faction) }
  onInactive(self, faction: Faction) { self.inactive.emit(faction) }
  onWatch(self, faction: Faction) { self.watch.emit(faction) }

  public render(self): Template {
    return $ltml {
      <box columns={[{ fr: 1 }, Style.SIDE]} yAlign={Align.Stretch}>
        <box rows={["max-content", { fr: 1 }]} gap={3sp}>
          <box padding={Style.LIST_TOOLBAR}>
            <Toolbar search={mut self.search} placeholder={Locale.SEARCH_FACTIONS}>
              <ToolPick value={mut self.show} choices={SHOWS} icon={Ordaen.art.ctl.tool.filter} title={Locale.SHOW}
                        lit={self.narrowed} />
            </Toolbar>
          </box>
          <ScrolledList>
            <text $if={self.none} value={Locale.NOTHING_FOUND} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
            <FactionRow $for={faction of self.listed} faction={faction} gain={gainOf(faction, self.starts)}
                        picked={faction.id == self.chosen} @pick={self.onPick} @fold={self.onFold} />
          </ScrolledList>
        </box>
        <box background={Ordaen.art.window.wood} border={Style.detailsLine()} padding={Style.DETAILS_ROOM}>
          <FactionDetail $if={self.hasPick} faction={self.shownPick} gain={self.pickedGain}
                         isInactive={self.chosenInactive} @atWar={self.onAtWar} @inactive={self.onInactive}
                         @watch={self.onWatch} />
          <text $else value={Locale.PICK_FACTION} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
        </box>
      </box>
    }
  }
}
