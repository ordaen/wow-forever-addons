          edges: [], current: "Parry +2%", next: "Parry +3%"
        },
        {
          id: 11, x: 600, y: 600, name: "Tactical Mastery", icon: TALENT_ICON, rank: 0, ranks: 3, canSpend: false,
          canRefund: false, edges: [], next: "Keeps 5 rage", conditions: [{ points: 5, met: false }]
        }
      ]
    }
  ]
  const window = onSpec("Primary")
  window.button("2").hover()
  Test.expect(Test.page().text("Parry +2%").shown() && Test.page().text("Parry +3%").shown())
  Test.expect(Test.page().text("2/5").shown() && Test.page().text("Click to learn.").shown())
  window.button(FRAME_GREY).hover()
  // No rank held: the first rank's words as what it does, the points its tree still needs, nothing to click for.
  Test.expect(Test.page().text("Keeps 5 rage").shown() && !Test.page().text("Parry +2%").shown())
  Test.expect(Test.page().text("Requires 5 points in this tree").shown())
}

