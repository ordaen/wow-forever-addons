  window.text("5.25%").hover()
  const tip = Test.page().window(Locale.EXPERTISE_TIP)
  // A boss: 6.5 - 5.25 of dodge, its parry whole; a target of the player's level: no dodge, 5 - 0.25 of parry.
  Test.expect(tip.texts().join(" | ").contains("Raid bosses | Dodge | 1.25% | Parry | 16.50% | Targets of your level | Dodge | 0.00% | Parry | 4.75%"))
  Test.expect(tip.text("0.00%").textColor().equal(Style.GREEN) && tip.text("1.25%").textColor().equal(Style.YELLOW))
  Test.expect(tip.text("16.50%").textColor().equal(Style.RED))
}

test "what lands of a blow is a card of its own: at the greatest level a boss's, each target's misses, dodges and parries" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { meleeHit: 6, expertise: 2, meleeCrit: 20, bossGlancing: 40, levelGlancing: 10, atMaxLevel: true }
  const window = opened(mut sheet)
  // An ability from behind against a boss: 8 - 6 of misses and 6.5 - 2 of dodges fail.
  Test.expect(window.text(Locale.LANDS).shown())
  window.text("93.50%").hover()
  const tip = Test.page().window(Locale.LANDS_TIP)
  // A swing from the front: its 16.5 of parries, 40 of glancing blows and 5 of blocks too; the boss's 15 of defense
  // past the skill take 0.6 off the crit; ordinary hits the rest.
  Test.expect(tip.texts().join(" | ").contains("Raid bosses | Miss | 2.00% | Dodge | 4.50% | Parry | 16.50% | Glancing blow | 40.00% | Block | 5.00% | Ordinary hit | 12.60% | Crit | 19.40%"))
  // A target of the player's level: no misses, 5 - 2 of dodges, its parries and blocks whole, the crit whole.
  Test.expect(tip.texts().join(" | ").contains("Targets of your level | Miss | 0.00% | Dodge | 3.00% | Parry | 5.00% | Glancing blow | 10.00% | Block | 5.00% | Ordinary hit | 57.00% | Crit | 20.00%"))
  Test.expect(tip.text("0.00%").textColor().equal(Style.GREEN) && tip.text("16.50%").textColor().equal(Style.RED))
  // Each name in its bar's colour, each section's bar under it.
  Test.expect(tip.text("Glancing blow").nth(1).textColor().equal(Style.YELLOW) && tip.text("Ordinary hit").nth(1).textColor().equal(Style.ORDINARY))
  Test.expect(tip.box(Style.ORDINARY).count() == 2 && tip.box(Style.YELLOW).count() == 4)
  // A miss bright red, a dodge and a parry dimmed.
  Test.expect(tip.text("Miss").nth(1).textColor().equal(Style.RED) && tip.text("Dodge").nth(1).textColor().equal(Style.AVOIDED))
}

test "below the greatest level a target of the player's level counts; weapon skill moves every chance; a crit fits in what is left" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { meleeHit: 1, expertise: 1, meleeCrit: 50, meleeSkillPast: 10, bossGlancing: 30, levelGlancing: 10 }
  const window = opened(mut sheet)
  // Ten points of skill past the level's take 0.4 off: 5 - 1 - 0.4 of misses, 5 - 0.4 - 1 of dodges.
  window.text("92.80%").hover()
  const tip = Test.page().window(Locale.LANDS_TIP)
  // The level's target first: a crit of 50 + 0.4 fits in what the rest leaves.
  Test.expect(tip.texts().join(" | ").contains("Targets of your level | Miss | 3.60% | Dodge | 3.60% | Parry | 4.60% | Glancing blow | 10.00% | Block | 4.60% | Ordinary hit | 23.20% | Crit | 50.40% | Raid bosses"))
  // A boss leaves 37.6 for a crit of 50 - 0.2: it takes all of it, no ordinary hit.
  Test.expect(tip.texts().join(" | ").contains("Raid bosses | Miss | 6.60% | Dodge | 5.10% | Parry | 16.10% | Glancing blow | 30.00% | Block | 4.60% | Ordinary hit | 0.00% | Crit | 37.60%"))
}

