  Test.expect(tip.texts().join(" | ").contains("Chance to hit | Raid bosses | 98.00% | Targets of your level | 100.00% | A weapon in each hand, plain swings | Raid bosses | 79.00% | Targets of your level | 82.00%"))
  Test.expect(tip.text("100.00%").textColor().equal(Style.GREEN) && tip.text("98.00%").textColor().equal(Style.YELLOW))
  Test.expect(tip.text("79.00%").textColor().equal(Style.RED))
}

