test "each talent looks as the client draws it: gold when full, green where a point may go or one is held, grey and veiled where none may, darker where its tree lacks the points, red where a rank no longer holds" {
  Test.mount(nil, PAGE)
  const node = (id: Integer, rank: Integer, canSpend: Boolean, gated: Boolean, stranded: Boolean): Game.TalentNode => {
    return {
      id: id, x: (id - 10) * 600, y: 0, name: "Talent %d".format(id), icon: TALENT_ICON, rank: rank, ranks: 5,
      canSpend: canSpend, canRefund: rank > 0, edges: [], gated: gated, locked: stranded, stranded: stranded
    }
  }
  Game.talentTrees.trees = (group: Integer): Array<Game.TalentTree> => [
    {
      id: 1, name: "Arms",
      nodes: [node(10, 5, false, false, false), node(11, 2, true, false, false), node(12, 3, false, false, false),
        node(13, 0, true, false, false), node(14, 0, false, false, false), node(15, 0, false, true, false),
        node(16, 1, false, false, true)]
    }
  ]
  const window = onSpec("Primary")
  // Full: the gold frame and its rank in gold.
  Test.expect(window.button("5").paintedWith("talents-node-square-yellow"))
  Test.expect(window.text("5").textColor().equal(Color.hex("#ffd100")))
  // A point may go, or one is held with none to spend: the green frame, the rank in green; a 0 where none is held yet.
  Test.expect(window.button("2").paintedWith("talents-node-square-green") && window.button("3").paintedWith("talents-node-square-green"))
  Test.expect(window.button("0").text("0").textColor().equal(Color.hex("#19ff19")) && window.text("3").textColor().equal(Color.hex("#19ff19")))
  // None may go: grey, no rank said, the icon grey under a light veil; its tree short of points, the locked frame and a
  // darker veil.
  Test.expect(window.button("0").count() == 1)
  const grey = window.button(FRAME_GREY)
  Test.expect(grey.box(TREE_LINE).opacity() == 0.25)
  const gated = window.button("talents-node-square-locked")
  Test.expect(gated.box(TREE_LINE).opacity() == 0.7)
  // The two that none may go to are drawn grey, no other.
  Test.expect(Test.drawn().filter(d => d.file == TALENT_ICON && d.desaturated).length == 2)
  // A rank that no longer holds: the red frame, its rank in red.
  Test.expect(window.button("1").paintedWith("talents-node-square-red"))
  Test.expect(window.text("1").textColor().equal(Color.hex("#ff2020")))
}

