// The talents

const TALENT_ICON: Asset = "Interface/Icons/INV_Misc_Note_01"
const SWORD: Asset = "Interface/Icons/INV_Sword_04"
// An arrow of a tree that leads to a talent with no rank.
const ARROW_LINE: Color = Color.hex("#4a3a24")
// The dark line between the trees, and the veil over a talent that can't be learned.
const TREE_LINE: Color = Color.hex("#000000")
// The client's talent frames, by a talent's look.
const FRAME_GREY = "talents-node-square-gray"
// The second spec's tab, by its name.
const SECOND = "Secondary"

// The trees of a spec: the first spec's two, the second's one.
function trees(group: Integer): Array<Game.TalentTree> {
  if (group == 2) {
    return [
      {
        id: 3, name: "Protection",
        nodes: [{ id: 30, x: 0, y: 0, name: "Shield Wall", icon: TALENT_ICON, rank: 1, ranks: 2, canSpend: true, canRefund: true, edges: [] }]
      }
    ]
  }
  return [
    {
      id: 1, name: "Arms",
      nodes: [
        { id: 10, x: 0, y: 0, name: "Deflection", icon: TALENT_ICON, rank: 2, ranks: 5, canSpend: true, canRefund: true, edges: [11] },
        { id: 11, x: 600, y: 600, name: "Tactical Mastery", icon: TALENT_ICON, rank: 0, ranks: 3, canSpend: false, canRefund: false, edges: [] }
      ]
    },
    {
      id: 2, name: "Fury",
      nodes: [{ id: 20, x: 0, y: 0, name: "Booming Voice", icon: TALENT_ICON, rank: 5, ranks: 5, canSpend: false, canRefund: true, edges: [] }]
    }
  ]
}

// The window opened on a spec's tab, by the tab's name.
function onSpec(name: String): Test.Part {
  Game.items.icon = icons
  const window = opened(new FakeSheet())
  window.button(name).click()
  return window
}

test "a spec's tab shows its talent trees, each with the points spent in it" {
  Test.mount(nil, PAGE)
  Game.talentTrees.trees = trees
  const window = onSpec("Primary")
  Test.expect(window.text("Arms: 2").shown() && window.text("Fury: 5").shown())
  Test.expect(!window.text("Protection: 1").shown())
}

test "a spec's trees stand on the class's art, out to the window's sides, between the header's and the footer's marble" {
  Test.login({ guid: "Player-1-0001", name: "Regy", surname: "", realm: "Realm", faction: "Alliance", classTag: "WARRIOR" })
  Test.mount(nil, PAGE)
  Game.talentTrees.trees = trees
  const window = onSpec("Primary")
  const art = Test.edges("talent-background-warrior", 0)
  const body = Test.edges(Ordaen.art.window.wood, 0)
  // Under the frame's art at either side, as the client's window draws its trees.
  const reach = Ordaen.art.frame.window.reach
  Test.expect(art.left - body.left <= reach.left + 2 && body.right - art.right <= reach.right + 2)
  // From the header's marble down to the footer's, each a rim between it and the trees.
  const head = Test.edges(Ordaen.art.window.marble, 0)
  const foot = Test.painted(Ordaen.art.window.marble, 2)
  Test.expect((head.bottom - art.top).abs() < 0.5 && foot.y > art.bottom && foot.y - art.bottom < 40)
  Test.expect(head.left - body.left <= reach.left + 2)
  // In its own proportions (2046 by 1177): the part of it drawn, read within the atlas's region as the client reads
  // it, is the box's shape, cut at its longer sides.
  const drawn = Test.drawn().find(d => d.file == "talent-background-warrior") ?? panic("the class's art")
  const shown = (drawn.right - drawn.left) * 2046 / ((drawn.bottom - drawn.top) * 1177)
  Test.expect((shown / ((art.right - art.left) / (art.bottom - art.top)) - 1).abs() < 0.01)
}

test "a talent under the cursor says what the client's tooltip says: its rank, what it does, the next rank, a click to learn" {
  Test.mount(nil, PAGE)
