  Test.expect(!window.button("Cancel").paintedWith(Ordaen.art.ctl.buttonAccent))
  const apply = window.button("Apply").rect()
  const cancel = window.button("Cancel").rect()
  Test.expect((apply.right - apply.left - (cancel.right - cancel.left)).abs() < 0.5 && cancel.right < apply.left - 200)
  _ = Test.requests()
  window.button("Apply").click()
  Test.expect(Test.requests().any(r => r == "TalentTrees.commit"))
  window.button("Cancel").click()
  Test.expect(Test.requests().any(r => r == "TalentTrees.rollback"))
}

