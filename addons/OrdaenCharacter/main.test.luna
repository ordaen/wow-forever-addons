// The game's spells window, opened on its talents page by the game's talent button, as the game's side reports it.
function talentButtonPressed(): any Client.Frame {
  Runtime.press(Client.TalentMicroButton, .Left)
  const game = Runtime.frame("PlayerSpellsFrame") ?? panic("the client made its spells window")
  Game.frames.PlayerSpells = game
  // Ours hooks the window as the game's side reports it, on the next update.
  Test.flush()
  const held: any Client.Frame = game
  return held
}

test "the game's talent button opens ours on the active spec's tab, the game's talents unseen; pressed again, it closes ours" {
  Test.mount(nil, PAGE)
  Game.talentTrees.trees = trees
  Char.sheet = new FakeSheet()
  const game = talentButtonPressed()
  const window = Test.page().window(WINDOW)
  Test.expect(window.text("Arms: 2").shown())
  Test.expect(game.IsShown())
  Runtime.press(Client.TalentMicroButton, .Left)
  Test.expect(!game.IsShown() && !Test.page().text(WINDOW).shown())
  Game.talentTrees.activeGroup = (): Integer => 2
  Runtime.press(Client.TalentMicroButton, .Left)
  Test.expect(Test.page().window(WINDOW).text("Protection: 1").shown())
}

test "closing ours closes the game's talents it opened on" {
  Test.mount(nil, PAGE)
  Char.sheet = new FakeSheet()
  const game = talentButtonPressed()
  Test.expect(game.IsShown() && Test.page().text(WINDOW).shown())
  Char.onClose()
  Test.expect(!Test.page().text(WINDOW).shown())
  Test.expect(!game.IsShown())
}

