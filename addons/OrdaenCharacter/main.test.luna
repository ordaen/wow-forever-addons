  const window = opened(new FakeSheet())
  Test.expect(window.box(Ordaen.art.ctl.cut.upright.dark).count() == 0)
  // The doll's dark (the scene's box's parent) inside the ruled box round it, a rule's width in at each side.
  const dark = Test.edges("@/media/backdrop-dwarf.tga", 1)
  const ruled = Test.edges("@/media/backdrop-dwarf.tga", 2)
  const rule = Style.DOLL_SIDES.width / 1ui
  Test.expect((dark.left - ruled.left - rule).abs() < 0.5 && (ruled.right - dark.right - rule).abs() < 0.5)
}

