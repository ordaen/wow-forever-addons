test "defence: the defense skill over all; the damage reduction and the hit on you side by side, block's two under them; then dodge, parry, the armor and the resistances" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { defense: 300, dodge: 7, parry: 6, block: 5, blockValue: 42, shield: true, armor: 2000, armorReduction: 30, resistances: [0, 10, 0, 0, 0] }
  const window = opened(mut sheet)
  const defense = window.text("300").rect()
  const reduction = window.text("Damage reduction").rect()
  const taken = window.text("Hit on you").rect()
  const block = window.text("Block").rect()
  const blocked = window.text("Damage Blocked").rect()
  const dodge = window.text("7.00%").rect()
  const parry = window.text("6.00%").rect()
  const armor = window.text("2000").rect()
  const resistance = window.text("Resistance").rect()
  Test.expect(defense.bottom <= reduction.top && defense.bottom <= taken.top && taken.left >= reduction.right)
  Test.expect(reduction.bottom <= block.top && taken.bottom <= blocked.top && blocked.left >= block.right)
  // Each card's value whole beside its name: the armor's 30, and 100 less 5 of misses, 7 of dodges and 6 of parries.
  Test.expect(window.text("30.00%").shown() && window.text("82.00%").shown() && window.text("42").shown())
  Test.expect(block.bottom <= dodge.top && dodge.bottom <= parry.top && parry.bottom <= armor.top && armor.bottom <= resistance.top)
  // Block's cards wear the shield, and the shield struck through: the glyphs' twelfth and thirteenth rows.
  const sheetArt: Asset = "@/media/character-glyphs.tga"
  const shield: Piece = { file: sheetArt, width: 64, height: 1024, rows: 16, normal: 11 }
  const struck: Piece = { file: sheetArt, width: 64, height: 1024, rows: 16, normal: 12 }
  Test.expect(window.paintedWith(shield) && window.paintedWith(struck))
}

