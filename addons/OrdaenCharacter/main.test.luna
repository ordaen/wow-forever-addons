}

// A texture the client draws of the dwarves' scene.
function isScene(texture: Test.Drawn): Boolean {
  const at, _ = `${texture.file}`.find("backdrop%-dwarf")
  return at != nil
}

test "the model stands in its race's scene from the game's dressing room, enlarged, in grey" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const window = opened(new FakeSheet())
  Test.expect(window.paintedWith("@/media/backdrop-dwarf.tga"))
  Test.expect(!window.paintedWith("@/media/backdrop-human.tga"))
  const scenes = Test.drawn().filter(texture => isScene(texture))
  Test.expect(scenes.length == 1 && scenes.all(texture => texture.desaturated))
  // As tall as the model's column at the height the tab holds the window at, so it is drawn in its own proportions,
  // neither cut at the bottom nor short of it (the veil over it is the column's whole).
  const column = window.box(Style.SCENE_VEIL).nth(2).rect()
  const body = Test.edges(Ordaen.art.window.wood, 0)
  // The tab is bare: the column runs from the sets' strip, under its tabs, to the frame's line at the bottom, no
  // window's room between (that room alone was more than the frame's art is wide).
  const sets = window.text("New Set").rect()
  // At the bottom, the frame's art past its line covers the wood's edge.
  const reach = Ordaen.art.frame.window.reach.bottom
  Test.expect(column.top >= sets.bottom && column.top - sets.bottom < 10 && body.bottom - column.bottom < reach + 2)
  Test.expect(((column.bottom - column.top) / (Style.SCENE_HEIGHT / 1ui) - 1).abs() < 0.01)
}

test "health and the resource are glass tubes as the experience bar is, each filled in its colour" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const window = opened(new FakeSheet())
  Test.expect(window.box(Ordaen.art.panel.xpTube).count() == 2)
  Test.expect(window.box(Ordaen.art.panel.xpTrough).count() == 2)
  Test.expect(window.box(xpFillArt(XpFill.Brushed)).count() == 2)
}

test "the bars' and the stats' columns share the room the model's leaves, which stays as wide in a wider window" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  _ = opened(new FakeSheet())
  // The model's box (the scene's), and the columns' grid two boxes out from it (past the grooves' row).
  const model = Test.edges("@/media/backdrop-dwarf.tga", 1)
  const columns = Test.edges("@/media/backdrop-dwarf.tga", 3)
  Test.expect(centred(model, columns))
  Char.window.memory.write({ width: 1700dp, ..Char.window.defaults })
  _ = opened(new FakeSheet())
  const wider = Test.edges("@/media/backdrop-dwarf.tga", 1)
  const widerColumns = Test.edges("@/media/backdrop-dwarf.tga", 3)
  Test.expect(widerColumns.right - widerColumns.left > columns.right - columns.left + 100)
  Test.expect((wider.right - wider.left - (model.right - model.left)).abs() < 1)
  Test.expect(centred(wider, widerColumns))
}

// A box stands in the middle of another, to a unit.
function centred(inner: Test.Rect, outer: Test.Rect): Boolean {
  return (inner.left - outer.left - (outer.right - inner.right)).abs() < 1
}

// Inspecting another player

// The test's player inspected: a dwarf warrior of level 60 with the two-hander alone, of rank 8.
class FakeInspector implements Inspector {
  heard: mut Array<String> = []

  public canInspect(self, unit: String): Boolean { return unit == "target" }
  public ask(mut self, unit: String) { self.heard.push(`ask ${unit}`) }
  public guidOf(self, unit: String): String | nil { return GROM }
  public read(self, unit: String): Inspected {
    return {
      who: { name: "Grom", level: 60, race: "Dwarf", className: "Warrior", scene: "Dwarf" }, classTag: "WARRIOR",
      worn: [{
        slot: 16, item: REAPER, quality: Quality.Epic, level: 58, durability: nil, name: "Arcanite Reaper",
        gives: [{ stat: .Strength, amount: 20 }]
      }]
    }
  }
  public honor(self, unit: String): Honor {
    return { rank: 8, title: "Knight", current: 300, next: 1000, today: 14, lifetime: 3870 }
  }
  public tryOn(mut self, unit: String, slot: Integer) { self.heard.push(`try ${slot}`) }
  public clear(mut self) { self.heard.push("clear") }
}

const GROM = "Player-1-0002"
// A text the inspect window always shows: its last tab.
const INSPECT = "PvP"

function inspecting(inspector: mut FakeInspector): Test.Part {
  Char.inspector = inspector
  Client.InspectUnit("target")
  return Test.page().window(INSPECT)
}

test "the game's inspect opens ours on the player's character and asks the server; closing it lets the answer go" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const inspector = new FakeInspector()
  const window = inspecting(mut inspector)
  Test.expect(window.text("Grom").shown())
  Test.expect(window.text("58").shown())
  Test.expect(inspector.heard.join(",") == "ask target")
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!Test.page().window(INSPECT).shown())
  Test.expect(inspector.heard.join(",") == "ask target,clear")
}

test "an inspected character's scene is as tall as its doll, with no sets' strip over it and the footer under it" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const window = inspecting(new FakeInspector())
  const column = window.box(Style.SCENE_VEIL).nth(1).rect()
  Test.expect(((column.bottom - column.top) / (Style.SCENE_HEIGHT_INSPECTED / 1ui) - 1).abs() < 0.01)
}

test "with no character of the account of the inspected class, race and level, the stats are what the gear gives, and the footer says so" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const window = inspecting(new FakeInspector())
  Test.expect(window.text("20").shown())
  Test.expect(window.text("≈ None of your characters has been this class, race and level: only what the gear gives").shown())
}

test "the stats are estimated from what the player's own character of that class, race and level showed: its base, the gear, and what strength feeds" {
  Test.login({ guid: "Player-1-0001", name: "Regy", surname: "", realm: "Realm", faction: "Alliance", classTag: "WARRIOR" })
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  // The player's own window read once: a dwarf warrior of level 60, strength's base 280, attack power's 208.
  opened(new FakeSheet()).button(Ordaen.art.ctl.corner.close).click()
  const window = inspecting(new FakeInspector())
  Test.expect(window.text("300").shown())
  Test.expect(window.text("808").shown())
  Test.expect(window.text("≈ Estimated from the gear, the base as your own characters of this class, race and level showed it").shown())
}

test "the talents come with the server's answer, only shown; the honor tab says the rank and the kills" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  Game.talentTrees.inspected = (): Array<Game.TalentTree> => [{
    id: 1, name: "Arms", nodes: [{ id: 10, x: 0, y: 0, name: "Deflection", icon: nil, rank: 5, ranks: 5, canSpend: false, canRefund: false, edges: [] }]
  }]
  const window = inspecting(new FakeInspector())
  window.button("Talents").click()
  Test.expect(window.text("The talents haven't come yet.").shown())
  Test.event("INSPECT_READY", GROM)
  Test.expect(window.text("Arms: 5").shown())
  window.button("PvP").click()
  Test.expect(window.text("Rank 8: Knight").shown())
  Test.expect(window.text("3870").shown())
}
