test "a shield worn adds block's card to defence; without one block shows nowhere, whatever its chance" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { block: 21.5, blockValue: 142 }
  const window = opened(mut sheet)
  Test.expect(!window.text("21.50%").shown() && !window.text("Block").shown())
