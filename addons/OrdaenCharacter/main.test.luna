  Test.expect(window.button(REAPER_ICON).paintedWith(FITS_GLOW))
  Test.expect(!window.button(HELM_ICON).paintedWith(FITS_GLOW))
  Test.expect(window.button(HELM_ICON).opacity() < 1)
  Test.expect(window.button(REAPER_ICON).opacity() == 1)
}

// The stats' tooltips

// Battle Shout, as the client has it on the character: 100 attack power.
const SHOUT = 6673
// The Skyborne's racial: melee and ranged speed at once, and casting speed, 2% each.
const WIND_BLESSED = 1259710
function spellNames(id: Integer): String | nil {
  if (id == WIND_BLESSED) { return "Wind Blessed" }
  return id == SHOUT ? "Battle Shout" : nil
}

test "an aura's melee and ranged speed at once is each of the two's haste; its casting speed the spells'" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  Game.spells.name = spellNames
  Game.auras.player = (): Array<Game.PlayerAura> => [{ spell: WIND_BLESSED, stacks: 0, harmful: false, points: [2, 2] }]
  Auras.refresh()
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { meleeHaste: 7, rangedHaste: 6, rangedSkill: WANDS, rangedSpeed: 1.5 }
  const window = opened(mut sheet)
  window.text("7.00%").hover()
  Test.expect(Test.page().window(Locale.HASTE_MELEE_TIP).texts().join(" | ").contains("Effects | Wind Blessed | +2.00%"))
  window.text("6.00%").hover()
  Test.expect(Test.page().window(Locale.HASTE_RANGED_TIP).texts().join(" | ").contains("Effects | Wind Blessed | +2.00%"))
}

