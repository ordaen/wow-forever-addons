// A texture the client draws of the dwarves' scene.
function isScene(texture: Test.Drawn): Boolean {
  const at, _ = `${texture.file}`.find("backdrop%-dwarf")
  return at != nil
}

test "the model stands in its race's scene from the game's dressing room, enlarged, in grey" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const window = opened(new FakeSheet())
  Test.expect(window.paintedWith("@/media/backdrop-dwarf.tga"))
  Test.expect(!window.paintedWith("@/media/backdrop-human.tga"))
  const scenes = Test.drawn().filter(texture => isScene(texture))
  Test.expect(scenes.length == 1 && scenes.all(texture => texture.desaturated))
  // As tall as the model's column at the height the tab holds the window at, so it is drawn in its own proportions,
  // neither cut at the bottom nor short of it (the veil over it is the column's whole).
  const column = window.box(Style.SCENE_VEIL).nth(1).rect()
  const body = Test.edges(Ordaen.art.window.wood, 0)
  // The tab is bare: the column runs from the sets' strip, under its tabs, to the frame's line at the bottom, no
  // window's room between (that room alone was more than the frame's art is wide).
  const sets = window.text("New Set").rect()
  // At the bottom, the frame's art past its line covers the wood's edge.
  const reach = Ordaen.art.frame.window.reach.bottom
  Test.expect(column.top >= sets.bottom && column.top - sets.bottom < 10 && body.bottom - column.bottom < reach + 2)
  Test.expect(((column.bottom - column.top) / (Style.SCENE_HEIGHT / 1ui) - 1).abs() < 0.01)
}
