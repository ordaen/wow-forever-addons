const DEMORALIZED = 1160

test "a stat an aura raises reads green, one an aura lowers red whatever else raises it, any other as it is" {
  Test.login({ guid: "Player-1-0001", name: "Regy", surname: "", realm: "Realm", faction: "Alliance", classTag: "WARRIOR" })
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  Game.spells.name = spellNames
  Game.auras.player = (): Array<Game.PlayerAura> => [{ spell: SHOUT, stacks: 0, harmful: false, points: [100] }]
  Auras.refresh()
  const window = opened(new FakeSheet())
  Test.expect(window.text("832").textColor().equal(Style.GREEN))
  Test.expect(!window.text("312").textColor().equal(Style.GREEN))
  Game.auras.player = (): Array<Game.PlayerAura> => [
    { spell: SHOUT, stacks: 0, harmful: false, points: [100] },
    { spell: DEMORALIZED, stacks: 0, harmful: true, points: [-35] }
  ]
  Auras.refresh()
  Test.expect(window.text("832").textColor().equal(Style.RED))
  // Its tooltip's «Effects»: each aura's share in the colour of what it does to the stat.
  window.text("832").hover()
  const tip = Test.page().window("Battle Shout")
  Test.expect(tip.text("+100").textColor().equal(Style.GREEN))
  Test.expect(tip.text("-35").textColor().equal(Style.RED))
}

