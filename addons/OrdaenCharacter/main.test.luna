}

test "«New Set» saves nothing until «Save», which saves what is worn as the next set, and is off while it is a set already" {
  Test.mount(nil, PAGE)
  const sheet = new FakeSheet()
  Game.items.icon = icons
  const window = opened(mut sheet)
  Test.expect(!window.text("Save").shown())
  window.button("New Set").click()
  Test.expect(sheet.heard.length == 0)
  // What is worn is «Tank»: saving it again would make a second of it.
  window.button("Save").click()
  Test.expect(sheet.heard.length == 0)
  // A piece of it taken off: what is worn is no set now.
  sheet.wornSet = -1
  Test.event("PLAYER_EQUIPMENT_CHANGED", 1, true)
  window.button("Save").click()
  Test.expect(sheet.heard.join(", ") == "save Set 3")
}

test "the slot what the cursor holds goes in is lit, the others not; a locked item is greyed" {
