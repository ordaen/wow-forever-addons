// The character window as the player meets it: the game's character window shown (its key, its micro button) shows
// ours in its place, on the tab of the game's page; the slots show what is worn and take clicks and drags as the
// game's do; the stats, the skills and the factions show what the sheet reads, and the factions' switches ask the
// game. The sheet is the test's own (what the window asks of it is heard); the client's sheet is held to the
// client's answers where the stand-in has them.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Art, Piece } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, Quality, XpFill, xpFillArt } from "Ordaen"
import root Auras from "OrdaenAuras"
import root Char from "OrdaenCharacter"
import { FITS_GLOW, wearColor } from "@/gear"
import { Honor, Inspected, Inspector } from "@/inspect"
import { WornSet } from "@/lines"
import Locale from "@/locales"
import { Choices, SlotSize } from "@/settings"
import { ClientSheet, Faction, GearSet, Sheet, Skill, Stats, Who, Worn } from "@/sheet"
import Style from "@/style"
import { KeptWipe } from "@/talents"

const PAGE: Test.Page = { left: 0, top: 0, width: 1400, height: 900, screen: true }
// A screen with room beside the window on every side.
const WIDE_PAGE: Test.Page = { left: 0, top: 0, width: 2600, height: 1800, screen: true }
// How far a tooltip's edge may stand from the one it meets.
const EDGE = 12
// A text the window always shows: its last tab.
const WINDOW = "Statistics"
const HELM = 12640
const REAPER = 12784
const HELM_ICON: Art = "Interface/Icons/INV_Helmet_41"
const REAPER_ICON: Art = "Interface/Icons/INV_Axe_09"
const EMPTY_FEET: Art = "Interface/PaperDoll/UI-PaperDoll-Slot-Feet"
const OTHER_HELM = 16866
const OTHER_ICON: Art = "Interface/Icons/INV_Helmet_01"
// The client's skill lines of maces, swords and wands.
const MACES = 54
const SWORDS = 43
const WANDS = 228
const MINING = 186

function faction(index: Integer, id: Integer, name: String, standing: Integer, value: Integer): Faction {
  return {
    index: index, id: id, name: name, description: `${name}'s description.`, standing: standing, value: value,
    min: 3000, max: 9000, header: false, ranked: false, child: false, collapsed: false, atWar: false,
    canToggleAtWar: false, canSetInactive: true, watched: false
  }
}

function heading(index: Integer, id: Integer, name: String, collapsed: Boolean): Faction {
  return {
    index: index, id: id, name: name, description: "", standing: 4, value: 0, min: 0, max: 0, header: true,
    ranked: false, child: false, collapsed: collapsed, atWar: false, canToggleAtWar: false, canSetInactive: false,
    watched: false
  }
}

// The test's warrior's stats: a two-handed mace.
function warrior(): Stats {
  return {
    strength: 312, stamina: 280, armor: 4120, attackPower: 832, meleeCrit: 20.05, speed: 3.8, mainSkill: MACES,
    bases: [280, 0, 0, 0, 0],
    conversions: { attackPerStrength: 2, rangedPerAgility: 2, critPerAgility: 0.1064 },
    tips: { primary: ["Increases your attack power with melee weapons."] }
  }
}

const PRIDE: WornSet = { name: "Lion's Pride", gives: [{ stat: .Strength, amount: 10 }, { stat: .Stamina, amount: 5 }] }

// The test's sheet: a level 60 dwarf warrior with a helm and a two-hander, two groups of factions, and what the window
// asks of it, heard.
class FakeSheet implements Sheet {
  heard: mut Array<String> = []
  // The second group folded.
  folded = false
  stand = 4500
  // The helm and the two-hander pieces of one set, whose bonus in effect gives strength.
  matched = false
  // A shield in the off hand, its block's line read as 39 of the block's damage.
  shielded = false

  public worn(self, slot: Integer): Worn {
    if (slot == 1) {
      return {
        slot: slot, item: HELM, quality: Quality.Epic, level: 63, durability: 0.2, locked: self.helmLocked,
        name: "Lionheart Helm", gives: [{ stat: .Strength, amount: 12 }, { stat: .Armor, amount: 600 }],
        set: self.matched ? PRIDE : nil
      }
    }
    if (slot == 16) {
      return {
        slot: slot, item: REAPER, quality: Quality.Epic, level: 58, durability: 1, name: "Arcanite Reaper",
        gives: [{ stat: .Strength, amount: 20 }, { stat: .MeleeCrit, amount: 1 }], set: self.matched ? PRIDE : nil
      }
    }
    if (slot == 17 && self.shielded) {
      return {
        slot: slot, item: HELM, quality: Quality.Rare, level: 40, durability: 1, name: "Guardian's Shield",
        gives: [{ stat: .Armor, amount: 1386 }, { stat: .BlockValue, amount: 39 }]
      }
    }
    return { slot: slot, item: nil, quality: Quality.Common, level: nil, durability: nil }
  }

  public usesAmmo(self): Boolean { return true }

  public who(self): Who { return { name: "Regy", level: 60, race: "Dwarf", className: "Warrior", scene: "Dwarf" } }

  // What the sheet says of the stats, made anew at each read as the client's sheet makes them: a test may put
  // others in.
  figures: () => Stats = warrior
  public stats(self): Stats { return self.figures() }

  public factions(self): Array<Faction> {
    const rows: Array<Faction> = [
      heading(1, 100, "Alliance", false),
      faction(2, 72, "Stormwind", 5, self.stand),
      heading(3, 200, "Other", self.folded)
    ]
    if (!self.folded) { rows.push(faction(4, 529, "Argent Dawn", 6, 4000)) }
    return rows
  }

  public inactive(self, index: Integer): Boolean { return false }

  // The professions' heading folded.
  craftsFolded = false
  public skills(self): Array<Skill> {
    const rows: Array<Skill> = [
      { index: 1, name: "Weapon Skills", header: true, rank: 0, modifier: 0, max: 0 },
      { id: MACES, index: 2, name: "Maces", header: false, rank: 300, modifier: 5, max: 300 },
      { id: SWORDS, index: 3, name: "Swords", header: false, rank: 290, modifier: 0, max: 300 },
      { id: WANDS, index: 4, name: "Wands", header: false, rank: 300, modifier: 0, max: 300 },
      { index: 5, name: "Professions", header: true, collapsed: self.craftsFolded, rank: 0, modifier: 0, max: 0 }
    ]
    if (!self.craftsFolded) {
      rows.push({
        id: MINING, index: 6, name: "Mining", header: false, rank: 75, modifier: 0, max: 150,
        description: "Mining's description.", abandonable: true
      })
    }
    return rows
  }

  public foldSkills(mut self, index: Integer, open: Boolean) {
    self.heard.push(`fold skills ${index} ${open}`)
    if (index == 5) { self.craftsFolded = !open }
  }

  public unlearn(mut self, skill: Integer) { self.heard.push(`unlearn ${skill}`) }

  public pickup(mut self, slot: Integer) { self.heard.push(`pickup ${slot}`) }

  public fold(mut self, index: Integer, open: Boolean) {
    self.heard.push(`fold ${index} ${open}`)
    if (index == 3) { self.folded = !open }
  }

  public watchFaction(mut self, index: Integer, on: Boolean) { self.heard.push(`watch ${index} ${on}`) }
  public toggleAtWar(mut self, index: Integer) { self.heard.push(`war ${index}`) }
  public setInactive(mut self, index: Integer, inactive: Boolean) { self.heard.push(`inactive ${index} ${inactive}`) }

  // The slot what the cursor holds goes in (none: 0), and the helm locked (picked up, on its way).
  cursorSlot = 0
  helmLocked = false
  public fits(self, slot: Integer): Boolean { return slot == self.cursorSlot }
  public tryOn(mut self, slot: Integer) { self.heard.push(`try ${slot}`) }
  // The bags hold another helm.
  public fitting(self, slot: Integer): Array<Integer> { return slot == 1 ? [OTHER_HELM] : [] }
  public equip(mut self, item: Integer, slot: Integer) { self.heard.push(`equip ${item} ${slot}`) }
  // The set worn whole, by its number; -1 for none.
  wornSet = 0
  public sets(self): Array<GearSet> {
    return [
      { id: 0, name: "Tank", worn: self.wornSet == 0, missing: 0 }, { id: 1, name: "Fury", worn: self.wornSet == 1, missing: 2 }
    ]
  }
  public useSet(mut self, id: Integer) { self.heard.push(`set ${id}`) }
  public saveSet(mut self, name: String) { self.heard.push(`save ${name}`) }
}

// The worn items' icons, as the game gives them.
function icons(id: Integer): Art | nil { return id == HELM ? HELM_ICON : id == OTHER_HELM ? OTHER_ICON : REAPER_ICON }

// The game's character window, shown as its key or its micro button shows it, with the test's sheet: ours.
function opened(sheet: mut FakeSheet): Test.Part {
  Char.sheet = sheet
  const game = Client.CreateFrame("Frame", "CharacterFrame", Client.UIParent, nil)
  game.Hide()
  Char.hook(game)
  game.Show()
  return Test.page().window(WINDOW)
}

// The window

test "the game's character window shown shows ours, and closing ours closes the game's" {
  Test.mount(nil, PAGE)
  Char.sheet = new FakeSheet()
  const game = Client.CreateFrame("Frame", "CharacterFrame", Client.UIParent, nil)
  game.Hide()
  Char.hook(game)
  Test.expect(!Test.page().window(WINDOW).shown())
  game.Show()
  const window = Test.page().window(WINDOW)
  Test.expect(window.text("Regy").shown())
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!window.shown())
  Test.expect(!game.IsShown())
}

test "the game's character window is held unseen from its making, before it first shows, and while hidden after" {
  Test.mount(nil, PAGE)
  Char.sheet = new FakeSheet()
  const game = Client.CreateFrame("Frame", "CharacterFrame", Client.UIParent, nil)
  game.Hide()
  Char.hook(game)
  Test.flush()
  Test.expect(game.GetAlpha() == 0)
  game.Show()
  game.Hide()
  Test.flush()
  Test.expect(game.GetAlpha() == 0)
}

test "the game's reputation page shown opens ours on «Progression»'s reputation" {
  Test.mount(nil, PAGE)
  const sheet = new FakeSheet()
  const game = Client.CreateFrame("Frame", "CharacterFrame", Client.UIParent, nil)
  const page = Client.CreateFrame("Frame", "ReputationFrame", game, nil)
  page.Hide()
  game.Hide()
  Char.sheet = sheet
  Char.hook(game)
  game.Show()
  page.Show()
  Test.expect(Test.page().window(WINDOW).text("Stormwind").shown())
}

// The slots

test "a slot shows what is worn there, no level written on it, and an empty one its well" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const window = opened(new FakeSheet())
  Test.expect(window.button(HELM_ICON).shown() && !window.text("63").shown())
  Test.expect(window.button(REAPER_ICON).shown() && !window.text("58").shown())
  Test.expect(window.button(EMPTY_FEET).shown())
}

test "the items' level is the median of what is worn, its tooltip listing each item's level, the highest first" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const window = opened(new FakeSheet())
  // The helm's 63 and the two-hander's 58: halfway between.
  Test.expect(window.text("Item level").shown() && window.text("60.5").shown())
  window.text("60.5").hover()
  const tip = Test.page().window(Locale.ITEM_LEVEL_TIP)
  Test.expect(tip.texts().join(" | ") == `Item level | ${Locale.ITEM_LEVEL_TIP} | Lionheart Helm | 63 | Arcanite Reaper | 58`)
}

// The helm's slot's width against the standard slot's, which the settings then pick.
function slotWidthRatio(window: Test.Part): Number {
  const picked = window.button(HELM_ICON).rect()
  Char.settings.values.slotSize = SlotSize.Standard
  Test.flush()
  const standard = window.button(HELM_ICON).rect()
  return (picked.right - picked.left) / (standard.right - standard.left)
}

test "a slot is as large as the screen draws its icon sharp, unless the settings pick a size" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  // The icon's 53 whole pixels in the screen's pixels a dp is (its height at this scale against 1080), and the edge's
  // two.
  Client.UIParent.SetScale(0.9)
  const wide, high = Client.GetPhysicalScreenSize()
  const sharpWidth = 53 * 1080 / (high * 0.9) + 2 * 2.34375
  const window = opened(new FakeSheet())
  const helm = window.button(HELM_ICON).rect()
  Test.expect(((helm.bottom - helm.top) - (helm.right - helm.left)).abs() < 0.5)
  Test.expect((slotWidthRatio(window) - sharpWidth / 46.875).abs() < 0.01)
}

test "the weapons stand level with the last slots down the sides, all four between them at the largest slots" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  Client.UIParent.SetScale(0.5)
  const window = opened(new FakeSheet())
  const wrists = window.button("Interface/PaperDoll/UI-PaperDoll-Slot-Wrists").rect()
  const trinket = window.button("Interface/PaperDoll/UI-PaperDoll-Slot-Trinket").nth(2).rect()
  const main = window.button(REAPER_ICON).rect()
  const ammo = window.button("Interface/PaperDoll/UI-PaperDoll-Slot-Ammo").rect()
  Test.expect((main.top - wrists.top).abs() < 0.5 && (ammo.top - trinket.top).abs() < 0.5)
  Test.expect(main.left > wrists.right && ammo.right < trinket.left)
  Test.expect(((ammo.right - ammo.left) - (main.right - main.left)).abs() < 0.5)
}

test "a slot the screen would draw sharp larger than the paper doll holds is as large as it holds" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  Client.UIParent.SetScale(0.5)
  const window = opened(new FakeSheet())
  Test.expect((slotWidthRatio(window) - 67.96875 / 46.875).abs() < 0.01)
}

test "left-click on a slot picks up what is worn there, and on an empty one lets go there what the cursor holds" {
  Test.mount(nil, PAGE)
  const sheet = new FakeSheet()
  Game.items.icon = icons
  const window = opened(mut sheet)
  window.button(HELM_ICON).click()
  window.button(EMPTY_FEET).click()
  Test.expect(sheet.heard.join(", ") == "pickup 1, pickup 8")
}

test "Shift+Left-click on a slot puts the item's link into the chat and picks nothing up" {
  Test.mount(nil, PAGE)
  const sheet = new FakeSheet()
  Game.items.icon = icons
  const window = opened(mut sheet)
  _ = Test.requests()
  Test.hold([.Shift])
  window.button(REAPER_ICON).click()
  Test.expect(sheet.heard.length == 0)
  Test.expect(Test.requests().any(asked => asked.contains(String.of(REAPER))))
}

test "right-click on a slot uses what is worn there, the client's own doing, and picks nothing up" {
  Test.mount(nil, PAGE)
  const sheet = new FakeSheet()
  Game.items.icon = icons
  const window = opened(mut sheet)
  window.button(HELM_ICON).rightClick()
  Test.expect(sheet.heard.length == 0)
  Test.expect(Test.performed().join(", ") == "item 1")
}

test "while a spell waits for its target (an armour kit), left-click applies it to the worn item, the client's secure doing" {
  Test.mount(nil, PAGE)
  const sheet = new FakeSheet()
  Game.items.icon = icons
  const window = opened(mut sheet)
  Game.player.targeting = true
  Test.flush()
  window.button(HELM_ICON).click()
  Test.expect(sheet.heard.length == 0)
  Test.expect(Test.performed().join(", ") == "item 1")
  Game.player.targeting = false
}

test "a slot under the cursor shows the tooltip of the slot, never the item's (which the game compares with itself)" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const window = opened(new FakeSheet())
  _ = Test.requests()
  window.button(HELM_ICON).hover()
  const asked = Test.requests()
  Test.expect(asked.any(a => a == "Items.showWorn 1"))
  Test.expect(!asked.any(a => a.contains("Items.show ")))
}

test "Ctrl+Left-click on a slot tries what it holds on in the dressing room and picks nothing up" {
  Test.mount(nil, PAGE)
  const sheet = new FakeSheet()
  Game.items.icon = icons
  const window = opened(mut sheet)
  Test.hold([.Ctrl])
  window.button(HELM_ICON).click()
  Test.expect(sheet.heard.join(", ") == "try 1")
}

test "Alt+Left-click on a slot opens what the bags hold for it; one clicked is worn there and the flyout closes" {
  Test.mount(nil, PAGE)
  const sheet = new FakeSheet()
  Game.items.icon = icons
  const window = opened(mut sheet)
  Test.hold([.Alt])
  window.button(HELM_ICON).click()
  Test.expect(window.text("From your bags").shown())
  Test.hold([])
  window.button(OTHER_ICON).click()
  Test.expect(sheet.heard.join(", ") == `equip ${OTHER_HELM} 1`)
  Test.expect(!window.text("From your bags").shown())
}

test "a slot's flyout with nothing for it says so, and Close shuts it" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const window = opened(new FakeSheet())
  Test.hold([.Alt])
  window.button(EMPTY_FEET).click()
  Test.hold([])
  Test.expect(window.text("Nothing in your bags goes here.").shown())
  window.button("Close").click()
  Test.expect(!window.text("From your bags").shown())
}

test "the game's sets are tabs over the columns, the one worn picked: another picked is put on, the worn one not again" {
  Test.mount(nil, PAGE)
  const sheet = new FakeSheet()
  Game.items.icon = icons
  const window = opened(mut sheet)
  Test.expect(window.text("Tank").textColor().equal(BRIGHT_TEXT))
  Test.expect(!window.text("Fury").textColor().equal(BRIGHT_TEXT))
  window.button("Tank").click()
  window.button("Fury").click()
  Test.expect(sheet.heard.join(", ") == "set 1")
  Test.expect(window.text("Fury").textColor().equal(BRIGHT_TEXT))
}

// The stand-in gives the client's texts in ruRU alone (its dump's): a test in enUS has no slot names, which the game's
// slots' tooltips are, so the relic's well is what a test sees.
test "a class that keeps a relic has the relic's well in the ranged slot" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { relic: true }
  const window = opened(mut sheet)
  Test.expect(window.paintedWith("Interface/PaperDoll/UI-PaperDoll-Slot-Relic"))
  Test.expect(!window.paintedWith("Interface/PaperDoll/UI-PaperDoll-Slot-Ranged"))
}

test "the damage a second's card says the weapon's speed and damage, and how much less each target's glancing blows deal" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats {
    attackPower: 832, speed: 2.5, minDamage: 100, maxDamage: 150, mainSkill: MACES,
    bossGlancing: 40, bossGlancingPenalty: 35, levelGlancing: 10, levelGlancingPenalty: 5
  }
  const window = opened(mut sheet)
  window.text("50.0").hover()
  // Its title the name alone: the value stands on the card, no hand's heading for one weapon. The glancing blows' cut,
  // in percent and off the average hit of 125 (their chance is the chance to hit's).
  const tip = Test.page().window("Glancing blows")
  Test.expect(tip.texts().join(" | ") == "DPS | Attack speed | 2.50 | Damage | 100 - 150 | Glancing blows | Raid bosses | -35.00% (-44) | Targets of your level | -5.00% (-6)")
  // The main hand's slot shows its share; attack power glows, as what feeds it.
  Test.expect(window.text("50.0").count() >= 2)
}

test "the attack speed is a card beside what lands, its tooltip each hand's seconds and the melee haste, which lights" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  // A 2.30 weapon, hasted 15%: a swing every 2.00 seconds, as the client gives it.
  sheet.figures = (): Stats => Stats { speed: 2, meleeHaste: 15 }
  const window = opened(mut sheet)
  // The card's seconds, its hourglass the glyphs' fourteenth row.
  Test.expect(window.text("2.00 s").shown() && window.text("Lands").nth(1).rect().right <= window.text("Attack speed").rect().left)
  const sheetArt: Asset = "@/media/character-glyphs.tga"
  const hourglass: Piece = { file: sheetArt, width: 64, height: 1024, rows: 16, normal: 13 }
  Test.expect(window.paintedWith(hourglass))
  window.text("Attack speed").hover()
  const tip = Test.page().window(Locale.ATTACK_SPEED_TIP)
  // The haste, then the weapon's own speed divided by it.
  Test.expect(tip.texts().join(" | ").contains("Haste | +15.00% | Main Hand | 2.30 ÷ 1.15 = | 2.00 s"))
  Test.expect(window.box(Style.SOURCE_GLOW).count() > 0)
}

test "each section has its own haste, its tooltip what it speeds up; none is shared" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { meleeHaste: 6, rangedHaste: 4, rangedSkill: WANDS, rangedSpeed: 1.5 }
  const window = opened(mut sheet)
  // Melee's and the wand's, each its own; a warrior casts nothing, so there is no spells' haste.
  Test.expect(window.text("6.00%").shown() && window.text("4.00%").shown())
  Test.expect(window.text("6.00%").rect().top < window.text("4.00%").rect().top)
  window.text("6.00%").hover()
  Test.expect(Test.page().window(Locale.HASTE_MELEE_TIP).shown())
}

test "a stat's tooltip stands beside the stat, out of the window on its column's side, level with its top" {
  Test.mount(nil, WIDE_PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { meleeHaste: 6 }
  const window = opened(mut sheet)
  // The melee haste, in the right column: the tooltip's left edge on the gauge's right one, past the window's right.
  const haste = window.text("6.00%")
  haste.hover()
  const right = Test.page().window(Locale.HASTE_MELEE_TIP).rect()
  Test.expect((right.left - haste.rect().right).abs() < EDGE)
  Test.expect(right.left > window.rect().right - EDGE * 3)
  Test.expect((right.top - haste.rect().top).abs() < EDGE)
}

test "the cards and the armor that hide what their tooltips light have their own ways: over, right or left of them" {
  Test.mount(nil, WIDE_PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { armor: 1200, meleeHit: 6, expertise: 2, atMaxLevel: true }
  const window = opened(mut sheet)
  // The damage reduction's over its card, their left edges together.
  const reduction = window.text(Locale.DAMAGE_REDUCTION)
  reduction.hover()
  const over = Test.page().window(Locale.DAMAGE_REDUCTION_TIP).rect()
  Test.expect(over.bottom <= reduction.rect().top && over.bottom > reduction.rect().top - EDGE * 2)
  Test.expect(over.left < reduction.rect().left && over.left > reduction.rect().left - EDGE * 4)
  // The hit on you's right of its card, their bottoms level.
  const taken = window.text(Locale.HIT_TAKEN)
  taken.hover()
  const right = Test.page().window(Locale.HIT_TAKEN_TIP).rect()
  Test.expect(right.left > taken.rect().right && right.bottom >= taken.rect().bottom)
  // Melee's chance to hit's left of its card.
  const lands = window.text("93.50%")
  lands.hover()
  const left = Test.page().window(Locale.LANDS_TIP).rect()
  Test.expect(left.right < lands.rect().left && left.bottom >= lands.rect().bottom)
}

test "the damage a second's tooltip lights what feeds it directly: attack power and attack speed, not the haste behind it" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats { attackPower: 832, speed: 2.5, minDamage: 100, maxDamage: 150, meleeHaste: 5 }
  const window = opened(mut sheet)
  window.text("50.0").hover()
  // The attack power's card, the attack speed's and the main hand's slot (its share) glow; the haste's gauge, attack
  // speed's own source, doesn't.
  Test.expect(window.box(Style.SOURCE_GLOW).count() == 3)
}

test "with a weapon in each hand the damage a second's card says each hand's speed, damage and damage a second" {
  Test.mount(nil, PAGE)
  Game.items.icon = icons
  const sheet = new FakeSheet()
  sheet.figures = (): Stats => Stats {
    speed: 2.5, minDamage: 100, maxDamage: 150, offSpeed: 2, offMinDamage: 40, offMaxDamage: 60
  }
  const window = opened(mut sheet)
  window.text("75.0").hover()
  const tip = Test.page().window("Off Hand")
