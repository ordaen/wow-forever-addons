// The statistics tab, whose data the window doesn't read from the game yet: it shows sample data, and says so on its
// top line, until `"$game"` has a part for it (the module's report names it).
import { Overflow } from "$ltml"
import root Ordaen from "Ordaen"
import { ARTWORK, Choice, Component, SECONDARY_TEXT, ToolPick, Toolbar } from "Ordaen"
import { Card, Filed, Group, StatGroup, grouped } from "@/cards"
import Locale from "@/locales"
import Style from "@/style"

// The line every sample tab starts with.
public class SampleNote implements Component {
  public render(): Template {
    return $ltml {
      <text value={Locale::SAMPLE} textSize={SECONDARY_TEXT} textColor={Style::YELLOW} />
    }
  }
}

// A statistic of the game's: its category, its name and its value.
struct Statistic {
  const category: string
  const name: string
  const value: string
}

const STATISTICS: array<Statistic> = [
  { category: "Character", name: "Total gold acquired", value: "1204" },
  { category: "Character", name: "Mounts owned", value: "2" },
  { category: "Combat", name: "Total damage done", value: "8 412 033" },
  { category: "Combat", name: "Total deaths", value: "57" },
  { category: "Quests", name: "Quests completed", value: "412" },
  { category: "Quests", name: "Daily quests completed", value: "—" }
]

// How the statistics stand: under their categories, or as one list.
public enum StatsView { Categories, List }

const VIEWS: array<Choice<StatsView>> = [
  { value: StatsView::Categories, label: Locale::VIEW_CATEGORIES, icon: ARTWORK.ctl.tool.categories },
  { value: StatsView::List, label: Locale::VIEW_LIST, icon: ARTWORK.ctl.tool.list }
]

function found(search: string): array<Statistic> {
  const needle = search.lower()
  return STATISTICS.filter(s => needle == "" || s.name.lower().contains(needle))
}

// The statistics whose name holds the search: under their categories, or in one group with no heading.
function groupsFound(search: string, view: StatsView): array<Group> {
  const kept = found(search)
  if (view == .List) {
    if (kept.length == 0) { return [] }
    return [{ title: "", cards: kept.map(s => Card { label: s.name, value: s.value }) }]
  }
  return grouped(kept.map(s => Filed { title: s.category, card: { label: s.name, value: s.value } }))
}

// The footer's count: the statistics the search keeps.
public function statisticsCount(search: string): string { return Locale::STATS_COUNT.format(found(search).length) }

public class StatisticsPage implements Component {
  derived groups: array<Group> = groupsFound(self.search, self.view)
  derived empty: boolean = self.groups.length == 0

  // The toolbar's search and view, the window's to keep.
  search: mut Signal<string>
  view: mut Signal<StatsView>
  constructor(search: mut Signal<string>, view: mut Signal<StatsView>) {
    self.search = search
    self.view = view
  }

  public render(): Template {
    return $ltml {
      <box rows={["max-content", "max-content", { fr: 1 }]} gap={6sp}>
        <SampleNote />
        <Toolbar search={mut self.search} placeholder={Locale::SEARCH_STATS}>
          <ToolPick value={mut self.view} choices={VIEWS} icon={Ordaen.art.ctl.tool.categories} title={Locale::VIEW} />
        </Toolbar>
        <box overflow={Overflow::Scroll}>
          <box gap={3sp}>
            <text $if={self.empty} value={Locale::NOTHING_FOUND} textSize={SECONDARY_TEXT} textColor={Style::DIM} />
            <StatGroup $for={group of self.groups} group={group} />
          </box>
        </box>
      </box>
    }
  }
}
