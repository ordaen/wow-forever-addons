// Ordaen Character's pages in the settings window: what the paper doll's slots show, and the spec tabs' names. A
// checkbox writes its entry at once; a name typed is written when the typing rests and at Enter. An empty name keeps
// nothing: the tab shows ours.
import Client from "$client"
import Game from "$game"
import { Beside, Hang, Point } from "$ltml"
import { Checkbox, Choice, Component, Dropdown, ModuleMemory, Resting, Segmented, SettingRow, Settings, SpecWeights, defaultBuildOf, specsOf } from "Ordaen"
import Locale from "@/locales"
import Style from "@/style"

// How large the paper doll's slots are: the standard, a larger, or the largest the screen draws an icon at whole.
public enum SlotSize implements Plain { Standard = "standard", Large = "large", Sharpest = "sharpest" }

const SLOT_SIZES: Array<Choice<SlotSize>> = [
  { value: SlotSize.Standard, label: Locale.SLOT_STANDARD },
  { value: SlotSize.Large, label: Locale.SLOT_LARGE },
  { value: SlotSize.Sharpest, label: Locale.SLOT_SHARPEST }
]

// The largest slot whose icon the screen draws with no texel spread over more than one pixel: the icon's picture
// (its texels less the rim the client cuts) in the screen's pixels, and the slot's edge round it; never under the
// standard slot (a dense screen draws that sharp already), never past what the paper doll holds.
function sharpestSlot(): Number<Length> {
  const wide, high = Client.GetPhysicalScreenSize()
  const pixels = high * Client.UIParent.GetEffectiveScale() / 1080
  const sharp = Style.SLOT_EDGE * 2 + 1dp * Style.ICON_TEXELS.floor() / pixels
  return sharp.max(Style.SLOT).min(Style.SLOT_MOST)
}

// A slot's size as the player chose it.
public function slotSizeOf(size: SlotSize): Number<Length> {
  return match (size) {
    .Standard => Style.SLOT
    .Large => Style.SLOT_LARGE
    .Sharpest => sharpestSlot()
  }
}

// The corners a stat's tooltip and the page meet at.
const CORNERS: Array<Choice<Point>> = [
  { value: Point.TopLeft, label: Locale.CORNER_TOP_LEFT },
  { value: Point.TopRight, label: Locale.CORNER_TOP_RIGHT },
  { value: Point.BottomLeft, label: Locale.CORNER_BOTTOM_LEFT },
  { value: Point.BottomRight, label: Locale.CORNER_BOTTOM_RIGHT }
]

// A point seen in a mirror: left for right.
function mirrored(point: Point): Point {
  return match (point) {
    .TopLeft => .TopRight
    .TopRight => .TopLeft
    .Left => .Right
    .Right => .Left
    .BottomLeft => .BottomRight
    .BottomRight => .BottomLeft
    .Top => .Top
    .Center => .Center
    .Bottom => .Bottom
  }
}

// Where a stat's tooltip stands, written in the page's box: its corner the player chose on the page's; where the
// screen has no room for that, both mirrored, on the page's other side; where it has none on either side (a window as
// wide as the screen nearly), inside the page in the chosen corner.
public function statTipPlace(choices: Choices): Beside {
  const hang: Hang = { point: choices.tipCorner, to: choices.pageCorner }
  const other: Hang = { point: mirrored(choices.tipCorner), to: mirrored(choices.pageCorner) }
  const inside: Hang = { point: mirrored(choices.tipCorner), to: choices.pageCorner }
  return { beside: "parent", prefer: [hang, other, inside] }
}

// What the player chooses.
public struct Choices implements Plain {
  // A thin bar under each slot shows its item's durability.
  durability: Boolean
  slotSize: SlotSize = SlotSize.Sharpest
  // A stat's tooltip stands beside the page, its `tipCorner` on the page's `pageCorner`: clear of what it lights.
  tipCorner: Point = Point.TopLeft
  pageCorner: Point = Point.TopRight
  // The names of the spec tabs; empty for ours.
  specOne: String = ""
  specTwo: String = ""
  // The build gear is weighed for (Ordaen's worth) before a character's first talent point, by its class and the
  // build's key (a spec of the class or one of Forever's builds within one, a Shockadin); a class not here: its default.
  classBuilds: mut Map<String, String> = {}
}

// The builds a character picked for its talent groups (Ordaen's worth), by their keys; empty: by its talents.
public struct Picks implements Plain {
  primary: String = ""
  secondary: String = ""
}

// A build's name as the player reads it: a spec's the client's own, Forever's builds ours.
function buildName(spec: SpecWeights): String {
  const index = spec.spec
  if (index != nil) {
    let _, name, _, _, _, _, _, _, _, _ = Client.C_SpecializationInfo.GetSpecializationInfo(index, nil, nil, nil, nil, nil, nil)
    if (name != nil) { return name }
  }
  if (spec.key == "shockadin") { return Locale.BUILD_SHOCKADIN }
  if (spec.key == "enhancement_tank") { return Locale.BUILD_ENHANCEMENT_TANK }
  if (spec.key == "battlemage_arcane") { return Locale.BUILD_BATTLEMAGE_ARCANE }
  if (spec.key == "battlemage_fire") { return Locale.BUILD_BATTLEMAGE_FIRE }
  if (spec.key == "battlemage_frost") { return Locale.BUILD_BATTLEMAGE_FROST }
  return spec.label
}

// The builds the player's class weighs gear for.
function buildChoices(): Array<Choice<String>> {
  return specsOf(Game.player.classTag).map((spec: SpecWeights): Choice<String> => ({ value: spec.key, label: buildName(spec) }))
}

// The class's build row, by the class's name as the client gives it.
function classBuildLabel(): String {
  let name, _, _ = Client.UnitClass("player")
  return Locale.SETTING_CLASS_BUILD.format(name ?? Game.player.classTag)
}

// A talent group's build: by its talents, or one picked.
function pickChoices(): Array<Choice<String>> {
  let choices: Array<Choice<String>> = [{ value: "", label: Locale.BUILD_BY_TALENTS }]
  for (choice of buildChoices()) { choices.push(choice) }
  return choices
}

public class GeneralPage implements Component {
  const builds: Array<Choice<String>> = buildChoices()
  const picks: Array<Choice<String>> = pickChoices()
  const classLabel: String = classBuildLabel()
  const groups: Integer = Game.talentTrees.groups()
  // The player's class's build before its first point, as the profile keeps it: written there as it is picked.
  state classBuild: String
  settings: mut Settings<Choices>
  memory: mut ModuleMemory<Picks>
  constructor(settings: mut Settings<Choices>, memory: mut ModuleMemory<Picks>) {
    self.settings = settings
    self.memory = memory
    const tag = Game.player.classTag
    self.classBuild = (peek self.settings.values).classBuilds[tag] ?? defaultBuildOf(tag)
    watch (build of self.classBuild) {
      self.settings.change((choices: mut Choices): nil => { choices.classBuilds[tag] = build })
    }
  }

  public render(self): Template {
    return $ltml {
      <Checkbox label={Locale.SETTING_DURABILITY} hint={Locale.SETTING_DURABILITY_TIP}
                value={mut self.settings.values.durability} />
      <SettingRow label={Locale.SETTING_SLOT_SIZE} hint={Locale.SETTING_SLOT_SIZE_TIP}>
        <Segmented value={mut self.settings.values.slotSize} choices={SLOT_SIZES} />
      </SettingRow>
      <Dropdown label={Locale.SETTING_TIP_CORNER} hint={Locale.SETTING_TIP_PLACE_TIP}
                value={mut self.settings.values.tipCorner} choices={CORNERS} />
      <Dropdown label={Locale.SETTING_PAGE_CORNER} hint={Locale.SETTING_TIP_PLACE_TIP}
                value={mut self.settings.values.pageCorner} choices={CORNERS} />
      <Dropdown label={self.classLabel} hint={Locale.SETTING_CLASS_BUILD_TIP} value={mut self.classBuild}
                choices={self.builds} />
      <Dropdown label={Locale.SETTING_PRIMARY_BUILD} hint={Locale.SETTING_PICKED_BUILD_TIP}
                value={mut self.memory.values.primary} choices={self.picks} />
      <Dropdown $if={self.groups > 1} label={Locale.SETTING_SECONDARY_BUILD} hint={Locale.SETTING_PICKED_BUILD_TIP}
                value={mut self.memory.values.secondary} choices={self.picks} />
    }
  }
}

// «Talents»: the spec tabs' names.
public class SpecNamesPage implements Component {
  // What each name's field shows: the setting, or what is typed and not written yet.
  state one: String
  state two: String
  const oneRest: mut Resting<String>
  const twoRest: mut Resting<String>

  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
    self.one = (peek self.settings.values).specOne
    self.two = (peek self.settings.values).specTwo
    self.oneRest = new Resting<String>((name: String): nil => {
      self.settings.change((choices: mut Choices): nil => { choices.specOne = name })
    })
    self.twoRest = new Resting<String>((name: String): nil => {
      self.settings.change((choices: mut Choices): nil => { choices.specTwo = name })
    })
    watch (typed of self.one) { self.typedOne(typed) }
    watch (typed of self.two) { self.typedTwo(typed) }
    // A name the setting takes from elsewhere (going back) shows, unless the player is typing.
    watch { self.showOne(self.settings.values.specOne) }
    watch { self.showTwo(self.settings.values.specTwo) }
  }

  typedOne(mut self, typed: String) {
    if (typed != (peek self.settings.values).specOne) { self.oneRest.move(typed) }
  }

  typedTwo(mut self, typed: String) {
    if (typed != (peek self.settings.values).specTwo) { self.twoRest.move(typed) }
  }

  showOne(mut self, name: String) {
    if (!self.oneRest.busy()) { self.one = name }
  }

  showTwo(mut self, name: String) {
    if (!self.twoRest.busy()) { self.two = name }
  }

  enterOne(mut self) { self.oneRest.end() }
  enterTwo(mut self) { self.twoRest.end() }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={2sp}>
        <text value={Locale.SETTING_SPEC_ONE} textColor={Style.INK} />
        <box height={Style.FIELD} rows={[{ fr: 1 }]}>
          <input value={mut self.one} maxLength={24} padding={Style.FIELD_PAD} textColor={Style.INK}
                 background={Style.FIELD_BACK} @submit={self.enterOne} />
        </box>
        <text value={Locale.SETTING_SPEC_TWO} textColor={Style.INK} />
        <box height={Style.FIELD} rows={[{ fr: 1 }]}>
          <input value={mut self.two} maxLength={24} padding={Style.FIELD_PAD} textColor={Style.INK}
                 background={Style.FIELD_BACK} @submit={self.enterTwo} />
        </box>
      </box>
    }
  }
}
