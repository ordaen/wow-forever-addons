// Ordaen Character: the character window, with four tabs: the character (the paper doll and the stats), the skills,
// reputation and the statistics; PvE and PvP are windows of their own, from the micro menu. It opens in place of the
// game's own character window: whatever shows the game's (its key, C, its micro button, another addon's
// `ToggleCharacter`) shows ours, the game's held unseen and off the screen while ours shows, and the game's tab picks
// ours (reputation, the skills). Closing ours closes the game's. What it shows is read as it opens and again when the
// game says it changed, and only while it shows.
import Client from "$client"
import Events from "$events"
import { Frame } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { KeptWindow, Module, SECONDARY_TEXT, Settings, SettingsPage, Window, WindowTabSpec, WindowsPage, windowsTitle } from "Ordaen"
import { SkillsPage } from "@/cards"
import { GearPage } from "@/gear"
import Locale from "@/locales"
import { FactionShow, ReputationPage, factionsCount } from "@/reputation"
import { StatisticsPage, StatsView, statisticsCount } from "@/samples"
import { Choices, GeneralPage } from "@/settings"
import { ClientSheet, Faction, GearSet, Sheet, Skill, Stats, Who, Worn } from "@/sheet"
import Style from "@/style"

// The tabs, in order.
const TAB_CHARACTER = 1
const TAB_SKILLS = 2
const TAB_REPUTATION = 3
const TAB_STATISTICS = 4
// The game's character window and its pages, by the names its code gives them, with the tab of ours each opens.
const GAME_WINDOW = "CharacterFrame"
// The tabs' pictures: the game's character window's side tabs (`CHARACTER_MODE_TAB_ICONS`), and a tabard for the
// character, where the game draws the portrait, and a book for the skills.
const CHARACTER_ICON: Asset = "Interface/ICONS/INV_Shirt_GuildTabard_01"
const SKILLS_ICON: Asset = "Interface/ICONS/INV_Misc_Book_11"
const REPUTATION_ICON: Asset = "Interface/ICONS/INV_SideTab_Reputation2_c60"
const STATISTICS_ICON: Asset = "Interface/ICONS/INV_SideTab_Stats_c60"

public class Character implements Module, App {
  public const title: String = "Ordaen Character"
  // Its window, declared: where it stands and what the player does with it, kept in the profile.
  public window: mut KeptWindow = new KeptWindow("main", self.title, { x: 0ui, y: 0ui, width: Style.WIDTH, height: Style.HEIGHT })
  public const windows: mut Array<mut KeptWindow> = [self.window]
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
    { title: windowsTitle(), content: $ltml { <WindowsPage windows={mut self.windows} /> } }
  ]

  public settings: mut Settings<Choices> = new Settings<Choices>({ itemLevels: true, durability: true })
  // Where the window reads the character and what its clicks ask of the game.
  public sheet: mut any Sheet = new ClientSheet()

  state open = false
  state tab = TAB_CHARACTER
  // The game's own window, while it shows: held unseen and off the screen.
  state gameWindow: any Frame | nil = nil
  game: any Client.Frame | nil = nil
  state worn: Array<Worn> = []
  state usesAmmo = false
  state who: Who = { name: "", level: 0, race: "", className: "" }
  state stats: Stats = {}
  state skills: Array<Skill> = []
  state factions: Array<Faction> = []
  // Each faction's value as the window first read it this session, by the faction's number: what it rose since.
  state starts: mut Map<Integer, Integer> = {}
  // The faction picked, by its number (none: 0), and whether it is inactive.
  state chosen = 0
  state chosenInactive = false
  // What the cursor holds goes in these slots; the game lights them.
  state fitsSlots: Array<Integer> = []
  state sets: Array<GearSet> = []
  // The slot whose flyout is open (none: nil), and what the bags hold for it.
  state flyoutSlot: Integer | nil = nil
  state fitting: Array<Integer> = []
  // The lists' toolbars: the reputation's search and filter, the statistics' search and view.
  state factionSearch = ""
  state factionShow = FactionShow.All
  state statsSearch = ""
  state statsView = StatsView.Categories
  // The footer's count, in dim text, of the list the tab shows; none on the other tabs.
  derived count: String = self.countOf()
  const footer: Template = $ltml {
    <text value={self.count} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
  }
  // Each tab's picture is the game's own for it.
  derived tabs: Array<WindowTabSpec> = [
    { title: Locale.TAB_CHARACTER, icon: CHARACTER_ICON },
    { title: Locale.TAB_SKILLS, icon: SKILLS_ICON },
    { title: Locale.TAB_REPUTATION, icon: REPUTATION_ICON },
    { title: Locale.TAB_STATISTICS, icon: STATISTICS_ICON }
  ]

  constructor() {
    Ordaen.modules.add(self)
    // The game's words about the character are heard while the window shows.
    watch (opened of self.open) {
      if (opened) {
        Events.PLAYER_EQUIPMENT_CHANGED.listen(self.readGear)
        Events.UPDATE_INVENTORY_DURABILITY.listen(self.readGear)
        Events.UNIT_INVENTORY_CHANGED.listen(self.onUnitGear)
        Events.UNIT_STATS.listen(self.onUnitStats)
        Events.UNIT_ATTACK_POWER.listen(self.onUnitStats)
        Events.UNIT_RESISTANCES.listen(self.onUnitStats)
        Events.UPDATE_FACTION.listen(self.readFactions)
        Events.SKILL_LINES_CHANGED.listen(self.readSkills)
        Events.CURSOR_CHANGED.listen(self.readFits)
        Events.ITEM_LOCK_CHANGED.listen(self.readGear)
        Events.BAG_UPDATE_COOLDOWN.listen(self.readGear)
        Events.EQUIPMENT_SETS_CHANGED.listen(self.readSets)
        Events.EQUIPMENT_SWAP_FINISHED.listen(self.readSets)
        Events.BAG_UPDATE.listen(self.readFitting)
      }
    }
    self.hook(Runtime.frame(GAME_WINDOW))
  }

  // The game's character window and its pages: ours opens and closes with it, on the tab its page is. Hooked as the
  // game names them, on their show and hide, which are rare.
  public hook(mut self, frame: any Frame | nil) {
    if (frame == nil) { return }
    const window: any Client.Frame = frame
    self.game = window
    _ = window.HookScript("OnShow", (): nil => {
      self.onGameShown(frame)
      return nil
    })
    _ = window.HookScript("OnHide", (): nil => {
      self.onGameHidden()
      return nil
    })
    self.hookPage("PaperDollFrame", TAB_CHARACTER)
    self.hookPage("ReputationFrame", TAB_REPUTATION)
    self.hookPage("SkillsFrame", TAB_SKILLS)
    if (window.IsShown()) { self.onGameShown(frame) }
  }

  // A page of the game's window: shown, ours turns to its tab.
  hookPage(mut self, name: String, tab: Integer) {
    const page = Runtime.frame(`${GAME_WINDOW}.${name}`) ?? Runtime.frame(name)
    if (page == nil) { return }
    const shown: any Client.Frame = page
    _ = shown.HookScript("OnShow", (): nil => {
      self.window.ask(tab)
      return nil
    })
  }

  onGameShown(mut self, frame: any Frame) {
    self.gameWindow = frame
    if (!(peek self.open)) {
      self.open = true
      self.refresh()
    }
  }

  onGameHidden(mut self) {
    self.gameWindow = nil
    self.open = false
  }

  public refresh(mut self) {
    self.readGear()
    self.readStats()
    self.readFactions()
    self.readSkills()
    self.readSets()
    self.readFits()
    self.who = self.sheet.who()
  }

  countOf(self): String {
    if (self.tab == TAB_REPUTATION) { return factionsCount(self.factions) }
    if (self.tab == TAB_STATISTICS) { return statisticsCount(self.statsSearch) }
    return ""
  }

  readSets(mut self) { self.sets = self.sheet.sets() }

  // The slots what the cursor holds goes in, as the game's slots light.
  readFits(mut self) {
    const fits: Array<Integer> = []
    for (slot of 0..19) {
      if (self.sheet.fits(slot)) { fits.push(slot) }
    }
    self.fitsSlots = fits
  }

  // What the bags hold for the open flyout's slot.
  readFitting(mut self) {
    const slot = peek self.flyoutSlot
    self.fitting = slot == nil ? [] : self.sheet.fitting(slot)
  }

  readGear(mut self) {
    const worn: Array<Worn> = []
    for (slot of 0..19) { worn.push(self.sheet.worn(slot)) }
    self.worn = worn
    self.usesAmmo = self.sheet.usesAmmo()
  }

  onUnitGear(mut self, unit: String) {
    if (unit == "player") { self.readGear() }
  }

  readStats(mut self) { self.stats = self.sheet.stats() }

  onUnitStats(mut self, unit: String) {
    if (unit == "player") { self.readStats() }
  }

  readFactions(mut self) {
    const factions = self.sheet.factions()
    for (faction of factions) {
      if ((peek self.starts)[faction.id] == nil) { self.starts[faction.id] = faction.value }
    }
    self.factions = factions
    self.readChosen()
  }

  readSkills(mut self) { self.skills = self.sheet.skills() }

  // Whether the picked faction is inactive: asked of it alone.
  readChosen(mut self) {
    const chosen = peek self.chosen
    const faction = (peek self.factions).find(f => f.id == chosen)
    self.chosenInactive = faction != nil && self.sheet.inactive(faction.index)
  }

  onPick(mut self, faction: Faction) {
    self.chosen = faction.id
    self.readChosen()
  }

  // A group's heading clicked: the game folds it or opens it, and keeps it so.
  onFold(mut self, faction: Faction) {
    self.sheet.fold(faction.index, faction.collapsed)
    self.readFactions()
  }

  onAtWar(mut self, faction: Faction) {
    self.sheet.toggleAtWar(faction.index)
    self.readFactions()
  }

  onInactive(mut self, faction: Faction) {
    self.sheet.setInactive(faction.index, !(peek self.chosenInactive))
    self.readFactions()
  }

  onWatch(mut self, faction: Faction) {
    self.sheet.watchFaction(faction.index, !faction.watched)
    self.readFactions()
  }

  // A slot clicked or dragged: in the click's own call, as the game's slot does it.
  onPicked(mut self, slot: Integer) { self.sheet.pickup(slot) }

  // Ctrl+click: the game's dressing room tries on what the slot holds.
  onTried(mut self, slot: Integer) { self.sheet.tryOn(slot) }

  // Alt+click: the slot's flyout opens, or closes where it was open.
  onFlyout(mut self, slot: Integer) {
    self.flyoutSlot = (peek self.flyoutSlot) == slot ? nil : slot
    self.readFitting()
  }

  onCloseFlyout(mut self) { self.flyoutSlot = nil }

  // An item of the flyout chosen: worn in its slot, and the flyout closes, as the game's does.
  onChose(mut self, item: Integer) {
    const slot = peek self.flyoutSlot
    if (slot == nil) { return }
    self.sheet.equip(item, slot)
    self.flyoutSlot = nil
  }

  onUseSet(mut self, id: Integer) { self.sheet.useSet(id) }

  // «+»: what is worn saved as a new set, named by its place among them.
  onSaveSet(mut self) {
    self.sheet.saveSet(Locale.SET_NAME.format((peek self.sets).length + 1))
    self.readSets()
  }

  // Ours closed: the game's closes with it.
  onClose(mut self) {
    self.open = false
    self.game?.Hide()
  }

  onSettings(self) { Ordaen.toggleSettings(Runtime.Addon.of(self)) }

  public render(self): Template {
    return $ltml {
      <frame $if={self.gameWindow != nil} of={self.gameWindow} opacity={0} away={true} />
      <Window $if={self.open} tabs={self.tabs} selected={mut self.tab} declared={mut self.window} withSettings={true}
              footer={self.footer} @close={self.onClose} @settings={self.onSettings}>
        <GearPage $if={self.tab == TAB_CHARACTER} worn={self.worn} who={self.who} stats={self.stats}
                  skills={self.skills} usesAmmo={self.usesAmmo} choices={self.settings.values}
                  fitsSlots={self.fitsSlots} sets={self.sets}
                  flyoutSlot={self.flyoutSlot} fitting={self.fitting} @picked={self.onPicked} @tried={self.onTried}
                  @flyout={self.onFlyout} @chose={self.onChose} @closeFlyout={self.onCloseFlyout}
                  @useSet={self.onUseSet} @saveSet={self.onSaveSet} />
        <SkillsPage $elseif={self.tab == TAB_SKILLS} skills={self.skills} />
        <ReputationPage $elseif={self.tab == TAB_REPUTATION} factions={self.factions} starts={self.starts}
                        chosen={self.chosen} chosenInactive={self.chosenInactive} search={mut self.factionSearch}
                        show={mut self.factionShow} @pick={self.onPick}
                        @fold={self.onFold} @atWar={self.onAtWar} @inactive={self.onInactive} @watch={self.onWatch} />
        <StatisticsPage $else search={mut self.statsSearch} view={mut self.statsView} />
      </Window>
    }
  }
}
