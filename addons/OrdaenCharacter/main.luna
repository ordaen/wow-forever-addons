// Ordaen Character: the character window, with its tabs: the character (the paper doll and the stats), each spec's
// talents, «Progression» (reputation and the skills, each a subtab) and the statistics; PvE and PvP are windows of their own, from the micro menu. It opens in place of the
// game's own character window: whatever shows the game's (its key, C, its micro button, another addon's
// `ToggleCharacter`) shows ours, the game's held unseen and off the screen while ours shows, and the game's tab picks
// ours (reputation, the skills). Closing ours closes the game's. What it shows is read as it opens and again when the
// game says it changed, and only while it shows. The game's inspect of another player (`InspectUnit`: the unit's menu,
// the inspect key) opens the inspect window in place of the game's: that player's character, talents and honor, as
// the server answers; its stats estimated from what the player's own characters of its class, race and level showed,
// which the window keeps for the account each time it reads the player's stats.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Frame, Track } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { FooterBand, KeptWindow, Module, ModuleMemory, SECONDARY_TEXT, Settings, SettingsPage, Tabs, Window, WindowTabSpec, WindowsPage, playSound, windowsTitle } from "Ordaen"
import root Auras from "OrdaenAuras"
import { KeptRates, Rates, estimate, ratesKey, ratesOf } from "@/estimate"
import { GearPage } from "@/gear"
import { ClientInspector, Honor, InspectHonor, InspectTalents, Inspected, Inspector } from "@/inspect"
import Locale from "@/locales"
import { FactionShow, ReputationPage, factionsCount } from "@/reputation"
import { StatisticsPage, StatsView, statisticsCount } from "@/samples"
import { Choices, GeneralPage, Picks, SpecNamesPage } from "@/settings"
import { ClientSheet, Faction, GearSet, Sheet, Skill, Stats, Who, Worn } from "@/sheet"
import { SkillsPage, skillsCount } from "@/skills"
import { Facts } from "@/sources"
import Style from "@/style"
import { KeptWipe, TalentsPage } from "@/talents"

// The tabs, in order: the character, each spec's talents (a spec tab's group is its place less one), «Progression»
// and the statistics; «Progression»'s subtabs, in order.
const TAB_CHARACTER = 1
const TAB_TALENTS = 2
const TAB_PROGRESSION = 3
const TAB_STATISTICS = 4
const PROGRESS_REPUTATION = 1
const PROGRESS_SKILLS = 2
// The game's character window and its pages, by the names its code gives them, with the tab of ours each opens.
const GAME_WINDOW = "CharacterFrame"
// The tabs' pictures: the game's character window's side tabs (`CHARACTER_MODE_TAB_ICONS`), and a tabard for the
// character, where the game draws the portrait.
const CHARACTER_ICON: Asset = "Interface/ICONS/INV_Shirt_GuildTabard_01"
const PROGRESSION_ICON: Asset = "Interface/ICONS/INV_SideTab_Reputation2_c60"
const STATISTICS_ICON: Asset = "Interface/ICONS/INV_SideTab_Stats_c60"
// The inspect window's tabs, in order, and their pictures; the game's inspect window and the addon that makes it.
const INSPECT_CHARACTER = 1
const INSPECT_TALENTS = 2
const TALENTS_ICON: Asset = "Interface/ICONS/Ability_Marksmanship"
const PVP_ICON: Asset = "Interface/ICONS/INV_BannerPVP_02"
const GAME_INSPECT = "InspectFrame"
const INSPECT_ADDON = "Blizzard_InspectUI"
// Where the rates the account's characters showed are kept.
const RATES = "inspectRates"
// Where the class trainer's last price for a reset of the talents is kept, for the character.
const WIPE = "talentWipe"
const NO_SKILLS: array<Skill> = []
// «Talents» and «Progression»: their subtabs over the page they pick.
const SUBTAB_ROWS: array<Track> = ["max-content", { fr: 1 }]

public class Character implements Module, App {
  public const title: string = "Ordaen Character"
  // Its window, declared: where it stands and what the player does with it, kept in the profile.
  public window: mut KeptWindow = new KeptWindow("main", self.title, { x: 0ui, y: 0ui, width: Style::WIDTH, height: Style::HEIGHT })
  public inspectWindow: mut KeptWindow = new KeptWindow("inspect", Locale::TAB_INSPECT, { x: 0ui, y: 0ui, width: Style::WIDTH, height: Style::HEIGHT })
  public const windows: mut array<mut KeptWindow> = [self.window, self.inspectWindow]
  public const pages: array<SettingsPage> = [
    { title: Locale::TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} memory={mut self.builds} /> } },
    { title: Locale::TAB_TALENTS, content: $ltml { <SpecNamesPage settings={mut self.settings} /> } },
    { title: windowsTitle(), content: $ltml { <WindowsPage windows={mut self.windows} /> } }
  ]

  public settings: mut Settings<Choices> = new Settings<Choices>({ durability: true })
  // The builds this character picked for its talent groups.
  builds: mut ModuleMemory<Picks> = new ModuleMemory<Picks>(Picks {}, Settings::Scope::Character, "builds")
  // Where the window reads the character and what its clicks ask of the game.
  public sheet: mut any Sheet = new ClientSheet()
  // Where the inspect window reads the player inspected.
  public inspector: mut any Inspector = new ClientInspector()
  // What the account's characters were without their items, by class, race and level.
  rates: mut KeptRates = load<KeptRates>(.Account, RATES, KeptRates {})
  // The class trainer's price for a reset of the talents, as it last offered one.
  wipe: mut KeptWipe = load<KeptWipe>(.Character, WIPE, KeptWipe {})
  state wipeCost = 0

  state open = false
  state tab = TAB_CHARACTER
  // The game's own window, once it is made: held away (unseen, off the screen, out of the game's own window manager,
  // which slots a window as it shows) from then on, shown or not.
  state gameWindow: any Frame | nil = nil
  game: any Client::Frame | nil = nil
  state worn: array<Worn> = []
  state usesAmmo = false
  state who: Who = { name: "", level: 0, race: "", className: "" }
  state stats: Stats = {}
  state skills: array<Skill> = []
  state factions: array<Faction> = []
  // Each faction's value as the window first read it this session, by the faction's number: what it rose since.
  state starts: mut map<integer, integer> = mut {}
  // The faction picked, by its number (none: 0), and whether it is inactive.
  state chosen = 0
  state chosenInactive = false
  // What the cursor holds goes in these slots; the game lights them.
  state fitsSlots: array<integer> = []
  state sets: array<GearSet> = []
  // The slot whose flyout is open (none: nil), and what the bags hold for it.
  state flyoutSlot: integer | nil = nil
  state fitting: array<integer> = []
  // The lists' toolbars: the reputation's search and filter, the statistics' search and view.
  state factionSearch = ""
  state factionShow = FactionShow::All
  state statsSearch = ""
  state statsView = StatsView::Categories
  // The footer's count, in dim text, of the list the tab shows; none on the other tabs.
  derived count: string = self.countOf()
  // On the marble with a thin line over it, as every window's footer; it takes no room while it has nothing to say
  // (the character tab).
  const footer: Template = $ltml {
    <FooterBand $if={self.count != ""}>
      <text value={self.count} textSize={SECONDARY_TEXT} textColor={Style::DIM} />
    </FooterBand>
  }
  // Each tab's picture is the game's own for it.
  // The inspect window: whom it shows (the unit the game inspected) and what the server said of it.
  state inspecting = false
  state inspectTab = INSPECT_CHARACTER
  state inspectUnit = ""
  state inspected: Inspected = {}
  state inspectStats: Stats = {}
  // Whether the stats are estimated from a character of the account (or only what the gear gives).
  state estimated = false
  state inspectTrees: array<Game::TalentTree> = []
  state honor: Honor = {}
  // The game's inspect window, while it shows: held unseen and off the screen.
  state inspectGame: any Frame | nil = nil
  inspectFrame: any Client::Frame | nil = nil
  addonHeard: Handle | nil = nil
  derived estimateText: string = self.inspectTab != INSPECT_CHARACTER ? "" : self.estimated ? Locale::ESTIMATED : Locale::NOT_ESTIMATED
  const inspectFooter: Template = $ltml {
    <FooterBand>
      <text value={self.estimateText} textSize={SECONDARY_TEXT} textColor={Style::DIM} />
    </FooterBand>
  }
  derived inspectTabs: array<WindowTabSpec> = [
    { title: self.inspected.who.name, icon: CHARACTER_ICON, height: Style::HEIGHT, padding: Style::PAGE_ROOM },
    { title: Locale::TAB_TALENTS, icon: TALENTS_ICON, fixed: true },
    { title: Locale::TAB_PVP, icon: PVP_ICON }
  ]
  derived tabs: array<WindowTabSpec> = [
    { title: Locale::TAB_CHARACTER, icon: CHARACTER_ICON, height: Style::HEIGHT, padding: Style::PAGE_ROOM },
    // A spec's trees run out to the window's sides: its page keeps its own room for its rows (talents.luna). The trees
    // stand on art laid out for the window's size: the tab keeps it.
    { title: Locale::TAB_TALENTS, icon: TALENTS_ICON, padding: Style::PAGE_ROOM, fixed: true },
    // Its lists run to the frame's line and the footer: the pages keep the room for what stands over them.
    { title: Locale::TAB_PROGRESSION, icon: PROGRESSION_ICON, padding: Style::PAGE_ROOM },
    { title: Locale::TAB_STATISTICS, icon: STATISTICS_ICON }
  ]
  // The spec tab shown, as the game numbers its spec groups (1 or 2; 0 on another tab), its trees, the points left in
  // it, whether points wait to be applied, the group the player has active, and how many groups the player has: the
  // second spec's tab is dimmed until it is learned, its Tip the client's own words for it (ours where the client has
  // none).
  // «Talents»' subtab: a spec, by the game's number; the second offered once the player has learned it.
  state spec = 1
  derived specTabs: array<string> = self.specGroups < 2 ? [self.specOneTitle] : [self.specOneTitle, self.specTwoTitle]
  derived specOneTitle: string = self.settings.values.specOne == "" ? Locale::TAB_MAIN : self.settings.values.specOne
  derived specTwoTitle: string = self.settings.values.specTwo == "" ? Locale::TAB_SECOND : self.settings.values.specTwo
  derived group: integer = self.tab == TAB_TALENTS ? (self.specGroups < 2 ? 1 : self.spec) : 0
  state trees: array<Game::TalentTree> = []
  state unspent = 0
  state staged = false
  state activeGroup = 1
  state specGroups = 2
  derived groupActive: boolean = self.group == self.activeGroup
  // «Progression»'s subtab, its names, and the skill picked (by its number; none: 0) and the skills' search.
  // The game's spells window, once it is made, held away as the game's own is; while its talents or specializations
  // page shows (Ordaen Spells takes its spellbook) ours opens on the active spec's tab.
  state spellsGame: any Frame | nil = nil
  spellsPaged = false
  spells: any Client::Frame | nil = nil
  state progress = PROGRESS_REPUTATION
  const progressTabs: array<string> = [Locale::TAB_REPUTATION, Locale::TAB_SKILLS]
  state chosenSkill = 0
  state skillSearch = ""

  constructor() {
    Ordaen.modules.add(self)
    // Gear is weighed for the build picked for the active talent group, else by the talents, else for the class's
    // build the profile prefers.
    watch {
      const picks = self.builds.values
      Ordaen.worth.pick(Game::player.talentGroup == 2 ? picks.secondary : picks.primary)
      Ordaen.worth.prefer(self.settings.values.classBuilds[Game::player.classTag] ?? "")
    }
    Game::saved.store(.Account, RATES, self.rates)
    Game::saved.store(.Character, WIPE, self.wipe)
    self.wipeCost = self.wipe.cost
    // The class trainer names the price only as it offers a reset.
    Events::CONFIRM_TALENT_WIPE.listen(self.onWipeOffered)
    // The server's answers about the player inspected are heard while the inspect window shows.
    watch (shown of self.inspecting) {
      if (shown) {
        Events::INSPECT_READY.listen(self.onInspectReady)
        Events::INSPECT_HONOR_UPDATE.listen(self.readHonor)
        // An item the client didn't know yet: its name and level came.
        Events::GET_ITEM_INFO_RECEIVED.listen(self.readInspected)
      }
    }
    Client::hooksecurefunc("InspectUnit", (unit: unknown): nil => {
      if (unit is string) { self.onInspect(unit) }
      return nil
    })
    const inspect = Runtime::frame(GAME_INSPECT)
    if (inspect != nil) {
      self.hookInspect(inspect)
    } else {
      self.addonHeard = Events::ADDON_LOADED.listen(self.onAddonLoaded)
    }
    // The talents are read for the spec tab shown, and again when the game says they changed.
    Game::talentTrees.changed.listen(self.refreshTalents)
    watch (group of self.group) { self.refreshTalents() }
    // The game's words about the character are heard while the window shows.
    watch (opened of self.open) {
      Game::talentTrees.watch(opened)
      if (opened) {
        Events::PLAYER_EQUIPMENT_CHANGED.listen(self.readGear)
        // Which set is worn whole follows each piece put on or taken off.
        Events::PLAYER_EQUIPMENT_CHANGED.listen(self.readSets)
        Events::UPDATE_INVENTORY_DURABILITY.listen(self.readGear)
        Events::UNIT_INVENTORY_CHANGED.listen(self.onUnitGear)
        Events::UNIT_STATS.listen(self.onUnitStats)
        Events::UNIT_ATTACK_POWER.listen(self.onUnitStats)
        Events::UNIT_RESISTANCES.listen(self.onUnitStats)
        // The statistics read again as the client gives them plain once more.
        Events::ADDON_RESTRICTION_STATE_CHANGED.listen(self.readStats)
        Events::UPDATE_FACTION.listen(self.readFactions)
        Events::SKILL_LINES_CHANGED.listen(self.readSkills)
        Events::CURSOR_CHANGED.listen(self.readFits)
        Events::ITEM_LOCK_CHANGED.listen(self.readGear)
        Events::BAG_UPDATE_COOLDOWN.listen(self.readGear)
        Events::EQUIPMENT_SETS_CHANGED.listen(self.readSets)
        Events::EQUIPMENT_SWAP_FINISHED.listen(self.readSets)
        Events::BAG_UPDATE.listen(self.readFitting)
      }
    }
    self.hook(Runtime::frame(GAME_WINDOW))
    // The game's spells window comes with its addon, loaded on demand.
    watch (frame of Game::frames.PlayerSpells) { self.hookSpells(frame) }
    // The client's alert of unspent points on its talent button goes as it shows: Ordaen Panel's portrait has a badge
    // of them on its rim.
    Client::hooksecurefunc("MainMenuMicroButton_ShowAlert", (button: unknown): nil => {
      if (button == Client::TalentMicroButton) { Client::MainMenuMicroButton_HideAlert(Client::TalentMicroButton) }
      return nil
    })
  }

  // The game's spells window: its talents and specializations pages open ours on the active spec's tab, and its
  // closing closes ours. Hooked as the game names them, on their show and hide, which are rare.
  mut hookSpells(frame: any Frame | nil) {
    const window = Client::PlayerSpellsFrame
    if (frame == nil || window == nil) { return }
    self.spells = window
    self.spellsGame = frame
    for (page of [window.TalentsFrame, window.SpecFrame]) {
      const shown: any Client::Frame = page
      _ = shown.HookScript("OnShow", (): nil => {
        self.onSpellsShown(frame)
        return nil
      })
      _ = shown.HookScript("OnHide", (): nil => {
        self.onSpellsHidden()
        return nil
      })
    }
    if (window.TalentsFrame.IsVisible() || window.SpecFrame.IsVisible()) { self.onSpellsShown(frame) }
  }

  mut onSpellsShown(frame: any Frame) {
    self.spellsPaged = true
    self.spec = Game::talentTrees.activeGroup()
    self.window.ask(TAB_TALENTS)
    if (!(peek self.open)) {
      self.open = true
      self.refresh()
    }
  }

  mut onSpellsHidden() {
    if (!self.spellsPaged) { return }
    self.spellsPaged = false
    self.open = false
  }

  // The client's alert hidden at once, ours shown by the character's button.

  // The game's character window and its pages: ours opens and closes with it, on the tab its page is. Hooked as the
  // game names them, on their show and hide, which are rare.
  public mut hook(frame: any Frame | nil) {
    if (frame == nil) { return }
    const window: any Client::Frame = frame
    self.game = window
    self.gameWindow = frame
    _ = window.HookScript("OnShow", (): nil => {
      self.onGameShown(frame)
      return nil
    })
    _ = window.HookScript("OnHide", (): nil => {
      self.onGameHidden()
      return nil
    })
    self.hookPage("PaperDollFrame", TAB_CHARACTER, 0)
    self.hookPage("ReputationFrame", TAB_PROGRESSION, PROGRESS_REPUTATION)
    self.hookPage("SkillsFrame", TAB_PROGRESSION, PROGRESS_SKILLS)
    if (window.IsShown()) { self.onGameShown(frame) }
  }

  // A page of the game's window: shown, ours turns to its tab, and to its subtab where it is one (`progress`, 0 for
  // none).
  mut hookPage(name: string, tab: integer, progress: integer) {
    const page = Runtime::frame(`${GAME_WINDOW}.${name}`) ?? Runtime::frame(name)
    if (page == nil) { return }
    const shown: any Client::Frame = page
    _ = shown.HookScript("OnShow", (): nil => {
      if (progress > 0) { self.progress = progress }
      self.window.ask(tab)
      return nil
    })
  }

  mut onGameShown(frame: any Frame) {
    if (!(peek self.open)) {
      self.open = true
      self.refresh()
    }
  }

  mut onGameHidden() {
    self.open = false
  }

  public mut refresh() {
    self.readGear()
    self.readStats()
    self.readFactions()
    self.readSkills()
    self.readSets()
    self.readFits()
    self.who = self.sheet.who()
    self.keepRates()
    self.specGroups = Game::talentTrees.groups()
    self.refreshTalents()
  }

  // The spec tab's talents, as the game has them; on another tab the game is asked for none.
  public mut refreshTalents() {
    const group = peek self.group
    if (group < 1) { return }
    self.trees = Game::talentTrees.trees(group)
    self.unspent = Game::talentTrees.unspent(group)
    self.activeGroup = Game::talentTrees.activeGroup()
    self.staged = Game::talentTrees.staged()
  }

  mut onSpend(node: integer) { _ = Game::talentTrees.spend(node) }
  mut onRefund(node: integer) { _ = Game::talentTrees.refund(node) }
  mut onApply() {
    if (Game::talentTrees.commit()) { playSound("UI_CLASS_TALENT_APPLY_COMPLETE") }
  }
  mut onCancel() { _ = Game::talentTrees.rollback() }
  // The spec switch is the player's: it runs in the click of «Activate».
  mut onActivate() { _ = Game::talentTrees.activate(peek self.group) }

  // The game's inspect window, once its addon has loaded: held unseen while it shows; closed, ours closes.
  mut onAddonLoaded(name: string) {
    if (name != INSPECT_ADDON) { return }
    if (self.addonHeard != nil) { destroy self.addonHeard }
    self.hookInspect(Runtime::frame(GAME_INSPECT))
  }

  mut hookInspect(frame: any Frame | nil) {
    if (frame == nil) { return }
    const window: any Client::Frame = frame
    self.inspectFrame = window
    self.inspectGame = frame
    _ = window.HookScript("OnHide", (): nil => {
      self.inspecting = false
      return nil
    })
  }

  // The game inspected a unit: ours shows it, on its character, and asks the server.
  mut onInspect(unit: string) {
    if (!self.inspector.canInspect(unit)) { return }
    self.inspectUnit = unit
    self.inspectTab = INSPECT_CHARACTER
    self.inspectTrees = []
    self.honor = {}
    self.inspecting = true
    self.inspector.ask(unit)
    self.readInspected()
  }

  // The server answered about a player: the one shown, its gear, talents and honor read again.
  mut onInspectReady(guid: string) {
    if (guid != self.inspector.guidOf(peek self.inspectUnit)) { return }
    self.readInspected()
    self.inspectTrees = Game::talentTrees.inspected()
    self.readHonor()
  }

  mut readInspected() {
    const read = self.inspector.read(peek self.inspectUnit)
    const rates = self.rates.byKey[ratesKey(read.classTag, read.who.scene, read.who.level)]
    self.inspected = read
    self.estimated = rates != nil
    self.inspectStats = estimate(rates ?? Rates {}, read.worn, read.classTag)
  }

  mut readHonor() { self.honor = self.inspector.honor(peek self.inspectUnit) }

  mut onInspectTried(slot: integer) { self.inspector.tryOn(peek self.inspectUnit, slot) }

  // Ours closed: the game's closes with it, and lets the answer go; without the game's, the answer is let go here.
  mut onInspectClose() {
    self.inspecting = false
    const game = self.inspectFrame
    if (game != nil && game.IsShown()) {
      game.Hide()
    } else {
      self.inspector.clear()
    }
  }

  // What the player's own character is without its items and auras, kept for estimating another of its class, race
  // and level.
  mut keepRates() {
    const who = peek self.who
    if (who.level == 0) { return }
    const facts: Facts = { stats: peek self.stats, worn: peek self.worn, auras: peek Auras.active, classTag: Game::player.classTag }
    self.rates.byKey[ratesKey(Game::player.classTag, who.scene, who.level)] = ratesOf(facts)
  }

  countOf(): string {
    if (self.tab == TAB_PROGRESSION) {
      return self.progress == PROGRESS_REPUTATION ? factionsCount(self.factions) : skillsCount(self.skills)
    }
    if (self.tab == TAB_STATISTICS) { return statisticsCount(self.statsSearch) }
    return ""
  }

  mut readSets() { self.sets = self.sheet.sets() }

  // The slots what the cursor holds goes in, as the game's slots light.
  mut readFits() {
    const fits: array<integer> = mut []
    for (slot of 0..19) {
      if (self.sheet.fits(slot)) { fits.push(slot) }
    }
    self.fitsSlots = fits
  }

  // What the bags hold for the open flyout's slot.
  mut readFitting() {
    const slot = peek self.flyoutSlot
    self.fitting = slot == nil ? [] : self.sheet.fitting(slot)
  }

  mut readGear() {
    const worn: array<Worn> = mut []
    for (slot of 0..19) { worn.push(self.sheet.worn(slot)) }
    self.worn = worn
    self.usesAmmo = self.sheet.usesAmmo()
  }

  mut onUnitGear(unit: string) {
    if (unit == "player") { self.readGear() }
  }

  // The statistics as the client gives them; while it holds them secret, those it gave last stay.
  mut readStats() {
    const read = self.sheet.stats()
    if (read != nil) { self.stats = read }
  }

  mut onUnitStats(unit: string) {
    if (unit == "player") { self.readStats() }
  }

  mut readFactions() {
    const factions = self.sheet.factions()
    for (faction of factions) {
      if ((peek self.starts)[faction.id] == nil) { self.starts[faction.id] = faction.value }
    }
    self.factions = factions
    self.readChosen()
  }

  mut readSkills() { self.skills = self.sheet.skills() }

  mut onPickSkill(skill: Skill) { self.chosenSkill = skill.id }

  // A heading of the skills clicked: the game folds it or opens it, and keeps it so.
  mut onFoldSkills(skill: Skill) {
    self.sheet.foldSkills(skill.index, skill.collapsed)
    self.readSkills()
  }

  mut onUnlearn(skill: Skill) {
    self.sheet.unlearn(skill.id)
    self.readSkills()
  }

  // Whether the picked faction is inactive: asked of it alone.
  mut readChosen() {
    const chosen = peek self.chosen
    const faction = (peek self.factions).find(f => f.id == chosen)
    self.chosenInactive = faction != nil && self.sheet.inactive(faction.index)
  }

  mut onPick(faction: Faction) {
    self.chosen = faction.id
    self.readChosen()
  }

  // A group's heading clicked: the game folds it or opens it, and keeps it so.
  mut onFold(faction: Faction) {
    self.sheet.fold(faction.index, faction.collapsed)
    self.readFactions()
  }

  mut onAtWar(faction: Faction) {
    self.sheet.toggleAtWar(faction.index)
    self.readFactions()
  }

  mut onInactive(faction: Faction) {
    self.sheet.setInactive(faction.index, !(peek self.chosenInactive))
    self.readFactions()
  }

  mut onWatch(faction: Faction) {
    self.sheet.watchFaction(faction.index, !faction.watched)
    self.readFactions()
  }

  // A slot clicked or dragged: in the click's own call, as the game's slot does it.
  mut onPicked(slot: integer) { self.sheet.pickup(slot) }

  // Ctrl+click: the game's dressing room tries on what the slot holds.
  mut onTried(slot: integer) { self.sheet.tryOn(slot) }

  // Alt+click: the slot's flyout opens, or closes where it was open.
  mut onFlyout(slot: integer) {
    self.flyoutSlot = (peek self.flyoutSlot) == slot ? nil : slot
    self.readFitting()
  }

  mut onCloseFlyout() { self.flyoutSlot = nil }

  // An item of the flyout chosen: worn in its slot, and the flyout closes, as the game's does.
  mut onChose(item: integer) {
    const slot = peek self.flyoutSlot
    if (slot == nil) { return }
    self.sheet.equip(item, slot)
    self.flyoutSlot = nil
  }

  mut onUseSet(id: integer) { self.sheet.useSet(id) }

  // «+»: what is worn saved as a new set, named by its place among them.
  mut onSaveSet() {
    self.sheet.saveSet(Locale::SET_NAME.format((peek self.sets).length + 1))
    self.readSets()
  }

  // The class trainer offered a reset of the talents: its price, in copper, kept for the footer.
  mut onWipeOffered(cost: number, kind: number) {
    self.wipe.cost = cost.floor()
    self.wipeCost = self.wipe.cost
  }

  // Ours closed: the game's closes with it.
  mut onClose() {
    self.open = false
    self.game?.Hide()
    if (self.spellsPaged) { self.spells?.Hide() }
  }

  onSettings() { Ordaen.toggleSettings(Runtime::Addon::of(self)) }

  public render(): Template {
    return $ltml {
      <frame $if={self.gameWindow != nil} of={self.gameWindow} opacity={0} away={true} />
      <frame $if={self.spellsGame != nil} of={self.spellsGame} opacity={0} away={true} />
      <Window $if={self.open} tabs={self.tabs} selected={mut self.tab} declared={mut self.window} withSettings={true}
              minWidth={Style::WIDTH} minHeight={Style::HEIGHT}
              footer={self.footer} @close={self.onClose} @settings={self.onSettings}>
        <GearPage $if={self.tab == TAB_CHARACTER} worn={self.worn} who={self.who} stats={self.stats}
                  skills={self.skills} usesAmmo={self.usesAmmo} choices={self.settings.values}
                  fitsSlots={self.fitsSlots} sets={self.sets}
                  flyoutSlot={self.flyoutSlot} fitting={self.fitting} @picked={self.onPicked} @tried={self.onTried}
                  @flyout={self.onFlyout} @chose={self.onChose} @closeFlyout={self.onCloseFlyout}
                  auras={Auras.active} @useSet={self.onUseSet} @saveSet={self.onSaveSet} />
        <box $elseif={self.tab == TAB_TALENTS} rows={SUBTAB_ROWS}>
          <Tabs tabs={self.specTabs} selected={mut self.spec} />
          <TalentsPage trees={self.trees} unspent={self.unspent} staged={self.staged} active={self.groupActive}
                       wipeCost={self.wipeCost} classTag={Game::player.classTag} @spend={self.onSpend}
                       @refund={self.onRefund} @apply={self.onApply} @cancel={self.onCancel} @activate={self.onActivate} />
        </box>
        <box $elseif={self.tab == TAB_PROGRESSION} rows={SUBTAB_ROWS} gap={3sp}>
          <Tabs tabs={self.progressTabs} selected={mut self.progress} />
          <ReputationPage $if={self.progress == PROGRESS_REPUTATION} factions={self.factions} starts={self.starts}
                          chosen={self.chosen} chosenInactive={self.chosenInactive} search={mut self.factionSearch}
                          show={mut self.factionShow} @pick={self.onPick}
                          @fold={self.onFold} @atWar={self.onAtWar} @inactive={self.onInactive} @watch={self.onWatch} />
          <SkillsPage $else skills={self.skills} chosen={self.chosenSkill} search={mut self.skillSearch}
                      @pick={self.onPickSkill} @fold={self.onFoldSkills} @unlearn={self.onUnlearn} />
        </box>
        <StatisticsPage $else search={mut self.statsSearch} view={mut self.statsView} />
      </Window>
      <frame $if={self.inspectGame != nil} of={self.inspectGame} opacity={0} away={true} />
      <Window $if={self.inspecting} tabs={self.inspectTabs} selected={mut self.inspectTab} declared={mut self.inspectWindow}
              minWidth={Style::WIDTH} minHeight={Style::HEIGHT} footer={self.inspectFooter} @close={self.onInspectClose}>
        <GearPage $if={self.inspectTab == INSPECT_CHARACTER} worn={self.inspected.worn} who={self.inspected.who}
                  stats={self.inspectStats} skills={NO_SKILLS} usesAmmo={false} choices={self.settings.values}
                  unit={self.inspectUnit} classTag={self.inspected.classTag} @tried={self.onInspectTried} />
        <InspectTalents $elseif={self.inspectTab == INSPECT_TALENTS} trees={self.inspectTrees} />
        <InspectHonor $else honor={self.honor} />
      </Window>
    }
  }
}
