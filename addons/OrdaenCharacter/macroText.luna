// A macro's text as the client reads it: the commands it knows (by the client's own spellings, the player's language's
// and the English ones), the conditions an option of a command takes, what in a body the client would refuse or not
// find, and the body made shorter with what it does the same.
import Client from "$client"
import Runtime from "$runtime"
import Locale from "@/locales"

// The most letters a macro's body holds.
public const MOST_LETTERS = 255

// The client's commands by their keys: each one's spellings are its `SLASH_<key><n>` texts.
const COMMAND_KEYS: Array<String> = [
  "TARGET", "INSPECT", "STOPATTACK", "CAST", "USE", "STOPCASTING", "STOPSPELLTARGET", "CANCELAURA", "CANCELFORM",
  "EQUIP", "EQUIP_TO_SLOT", "CHANGEACTIONBAR", "SWAPACTIONBAR", "TARGET_EXACT", "TARGET_NEAREST_ENEMY",
  "TARGET_NEAREST_ENEMY_PLAYER", "TARGET_NEAREST_FRIEND", "TARGET_NEAREST_FRIEND_PLAYER", "TARGET_NEAREST_PARTY",
  "TARGET_NEAREST_RAID", "CLEARTARGET", "TARGET_LAST_TARGET", "TARGET_LAST_ENEMY", "TARGET_LAST_FRIEND", "ASSIST",
  "FOCUS", "CLEARFOCUS", "MAINTANKON", "MAINTANKOFF", "MAINASSISTON", "MAINASSISTOFF", "DUEL", "DUEL_CANCEL",
  "PET_ATTACK", "PET_FOLLOW", "PET_MOVE_TO", "PET_STAY", "PET_PASSIVE", "PET_DEFENSIVE", "PET_DEFENSIVEASSIST",
  "PET_AGGRESSIVE", "PET_ASSIST", "PET_AUTOCASTON", "PET_AUTOCASTOFF", "PET_AUTOCASTTOGGLE", "PET_DISMISS", "STOPMACRO",
  "CANCELQUEUEDSPELL", "CLICK", "LOGOUT", "QUIT", "EQUIP_SET", "WORLD_MARKER", "CLEAR_WORLD_MARKER", "TARGET_MARKER",
  "STARTATTACK", "CONSOLE", "CHATLOG", "COMBATLOG", "UNINVITE", "PROMOTE", "REPLY", "HELP", "MACROHELP", "TIME",
  "PLAYED", "FOLLOW", "TRADE", "JOIN", "LEAVE", "WHO", "FRIENDS", "REMOVEFRIEND", "IGNORE", "UNIGNORE", "SCRIPT",
  "RUN", "RANDOM", "ROLL", "MACRO", "PVP", "READYCHECK", "DISMOUNT", "STOPWATCH", "COUNTDOWN", "INVITE",
  "CASTSEQUENCE", "CASTRANDOM", "USERANDOM", "SAY", "YELL", "PARTY", "RAID", "RAID_WARNING", "GUILD", "OFFICER",
  "EMOTE", "WHISPER", "INSTANCE_CHAT", "DND", "AFK"
]

// The commands whose text takes options, each `[conditions] what` and parted by `;`.
const OPTION_KEYS: Array<String> = [
  "TARGET", "STOPATTACK", "CAST", "USE", "STOPCASTING", "CANCELAURA", "CANCELFORM", "EQUIP", "EQUIP_TO_SLOT",
  "CHANGEACTIONBAR", "SWAPACTIONBAR", "TARGET_EXACT", "TARGET_NEAREST_ENEMY", "TARGET_NEAREST_ENEMY_PLAYER",
  "TARGET_NEAREST_FRIEND", "TARGET_NEAREST_FRIEND_PLAYER", "TARGET_NEAREST_PARTY", "TARGET_NEAREST_RAID", "CLEARTARGET",
  "TARGET_LAST_TARGET", "TARGET_LAST_ENEMY", "TARGET_LAST_FRIEND", "ASSIST", "FOCUS", "CLEARFOCUS", "PET_ATTACK",
  "PET_FOLLOW", "PET_MOVE_TO", "PET_STAY", "PET_PASSIVE", "PET_DEFENSIVE", "PET_DEFENSIVEASSIST", "PET_AGGRESSIVE",
  "PET_ASSIST", "PET_AUTOCASTON", "PET_AUTOCASTOFF", "PET_AUTOCASTTOGGLE", "PET_DISMISS", "STOPMACRO", "CLICK",
  "EQUIP_SET", "WORLD_MARKER", "CLEAR_WORLD_MARKER", "TARGET_MARKER", "STARTATTACK", "DISMOUNT", "CASTSEQUENCE",
  "CASTRANDOM", "USERANDOM"
]

// The commands that name spells or items, the client's to find.
const NAMING_KEYS: Array<String> = ["CAST", "USE", "CASTSEQUENCE", "CASTRANDOM", "USERANDOM"]

// The conditions an option takes (`[help]`, `[nodead]`, `[mod:shift]`), by the client's names.
public const CONDITIONS: Array<String> = [
  "actionbar", "bar", "bonusbar", "btn", "button", "canexitvehicle", "channeling", "combat", "cursor", "dead",
  "equipped", "worn", "exists", "extrabar", "flyable", "flying", "form", "stance", "group", "harm", "help", "indoors",
  "known", "mod", "modifier", "mounted", "outdoors", "overridebar", "party", "pet", "petbattle", "possessbar", "raid",
  "resting", "shapeshift", "spec", "stealth", "swimming", "unithasvehicleui", "vehicleui"
]

// The units an option may aim at (`@focus`, `target=mouseover`).
public const UNITS: Array<String> = [
  "player", "target", "focus", "mouseover", "pet", "targettarget", "focustarget", "party1", "party2", "party3",
  "party4", "raid1", "arena1", "none", "cursor"
]

// One condition the picker built: its name, `no` before it or not, and what follows its `:` (none where empty).
public struct PickedCondition {
  const name: String
  const negated: Boolean = false
  const value: String = ""
}

// An option's brackets as the picker builds them: the unit aimed at first (`@focus`; none where empty), then each
// condition; `[]` with neither.
public function optionText(unit: String, conditions: Array<PickedCondition>): String {
  const parts: Array<String> = []
  if (unit != "") { parts.push(`@${unit}`) }
  for (condition of conditions) {
    const value = condition.value == "" ? "" : `:${condition.value}`
    parts.push(`${condition.negated ? "no" : ""}${condition.name}${value}`)
  }
  return `[${parts.join(",")}]`
}

// What the body's checker found on a line (from 1; 0 for the whole body).
public struct Problem {
  const line: Integer
  const text: String
}

// The body's letters, as the client counts them: a letter of several bytes is one.
public function lettersOf(text: String): Integer {
  let letters = 0
  for (at of 1..text.length) {
    const byte = text.byte(at) ?? 0
    if (byte < 128 || byte >= 192) { letters += 1 }
  }
  return letters
}

// Each of the client's commands by its spellings, lower-cased (`/cast` and `/закл` alike): its key, or an addon's
// command (`/dbm`) by its own.
public function commandsOf(): Map<String, String> {
  const names: Map<String, String> = {}
  const keys: Array<String> = []
  for (key of COMMAND_KEYS) { keys.push(key) }
  for (key, _ of Client::SlashCmdList) { keys.push(key) }
  for (key of keys) {
    for (at of 1..) {
      const spelled = Runtime::text(`SLASH_${key}${at}`)
      if (spelled == nil) { break }
      names[spelled.lower()] = key
    }
  }
  return names
}

function listed(list: Array<String>, word: String): Boolean { return list.any(each => each == word) }

// A condition as written between `[` and `]`, wrong or right: the client's name, with `no` before it or not, and
// what follows its `:`.
function conditionFault(written: String): String | nil {
  const condition = written.lower().replace("^%s+", "").replace("%s+$", "")
  if (condition == "" || condition.sub(1, 1) == "@") { return nil }
  const aim = condition.match("^target%s*=%s*(.*)$")
  if (aim != nil) { return nil }
  const name = condition.match("^([%a]+)") ?? ""
  if (listed(CONDITIONS, name)) { return nil }
  if (name.sub(1, 2) == "no" && listed(CONDITIONS, name.sub(3))) { return nil }
  return Locale::MACRO_UNKNOWN_CONDITION.format(condition)
}

// The names a command's option asks the client for: a spell's or an item's, never a slot's number or an item's link;
// a sequence's and a random pick's each, its `reset=` left out.
function namesOf(key: String, what: String): Array<String> {
  let rest = what
  if (key == "CASTSEQUENCE") { rest = rest.replace("^%s*reset=%S+%s*", "") }
  const names: Array<String> = []
  const parts = key == "CAST" || key == "USE" ? [rest] : rest.split(",")
  for (part of parts) {
    const name = part.replace("^%s+", "").replace("%s+$", "").replace("^!", "").replace("%s*%(.-%)$", "")
    if (name != "" && name.toNumber() == nil && name.match("^item:") == nil) { names.push(name) }
  }
  return names
}

// What the client would refuse in a command's options, or not find: an option's conditions that aren't the client's,
// a `[` with no `]`, a name of no spell the player knows and of no item they have.
function optionProblems(line: Integer, key: String, text: String, known: (name: String) => Boolean, found: mut Array<Problem>) {
  for (option of text.split(";")) {
    let rest = option
    for (step of 1..) {
      const inner, after = rest.match("^%s*%[([^%]]*)%](.*)$")
      if (inner == nil || after == nil) { break }
      for (condition of inner.split(",")) {
        const fault = conditionFault(condition)
        if (fault != nil) { found.push({ line: line, text: fault }) }
      }
      rest = after
    }
    if (rest.contains("[")) {
      found.push({ line: line, text: Locale::MACRO_UNCLOSED })
    } else if (listed(NAMING_KEYS, key)) {
      for (name of namesOf(key, rest)) {
        if (!known(name)) { found.push({ line: line, text: Locale::MACRO_UNKNOWN_NAME.format(name) }) }
      }
    }
  }
}

// What in a body the client would refuse or not find, line by line: too many letters, a command it doesn't know, a
// line that isn't a command (said in the chat), an option's wrong condition or unclosed `[`, a name it won't find
// (`known` asks the player's spells and items).
public function problemsOf(body: String, commands: Map<String, String>, known: (name: String) => Boolean): Array<Problem> {
  const found: Array<Problem> = []
  const letters = lettersOf(body)
  if (letters > MOST_LETTERS) { found.push({ line: 0, text: Locale::MACRO_TOO_LONG.format(letters - MOST_LETTERS) }) }
  for (line, written of body.split("\n")) {
    const text = written.replace("^%s+", "").replace("%s+$", "")
    if (text != "" && text.sub(1, 1) != "#") {
      const word, rest = text.match("^(/%S+)%s*(.*)$")
      if (word == nil || rest == nil) {
        found.push({ line: line, text: Locale::MACRO_NOT_COMMAND })
      } else {
        const key = commands[word.lower()]
        if (key == nil) {
          found.push({ line: line, text: Locale::MACRO_UNKNOWN_COMMAND.format(word) })
        } else if (listed(OPTION_KEYS, key)) {
          optionProblems(line, key, rest, known, found)
        }
      }
    }
  }
  return found
}

// Whether the player has what a name names: a spell of theirs, or an item in their bags or worn.
public function knownName(name: String): Boolean {
  if (Client::C_Spell::GetSpellInfo(name) != nil) { return true }
  return Client::C_Item::GetItemCount(name, true, nil, nil, nil) > 0
}

// The body made shorter, doing the same: `target=` as `@`, the conditions' long names as their short ones, no room
// round `,` and `;`, inside `[` `]` and after `]` (the command's space before its first `[` stays: the client parts
// the command there), one space where there were several, no space at a line's ends and no empty line.
public function shortened(body: String): String {
  const lines: Array<String> = []
  for (written of body.split("\n")) {
    let line = written.replace("%s+", " ").replace("^ ", "").replace(" $", "")
    line = line.replace("target%s*=%s*", "@")
    line = line.replace("%f[%a]modifier:", "mod:").replace("%f[%a]nomodifier", "nomod").replace("%f[%a]modifier%f[%A]", "mod")
    line = line.replace("%f[%a]button:", "btn:").replace("%f[%a]equipped:", "worn:").replace("%f[%a]stance:", "form:")
    line = line.replace(" ?([,;]) ?", "%1").replace("%[ ", "[").replace(" %]", "]").replace("%] ", "]")
    if (line != "") { lines.push(line) }
  }
  return lines.join("\n")
}
