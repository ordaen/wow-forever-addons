// A talent tree as the client lays it out (`Game.TalentTree`): its name and the points spent in it over a grid of its
// nodes, each in the cell of the client's grid it stands in (a step of `CELL` from the tree's top left), the cells a
// node's width and a gap apart across and sharing the tree's height down. A node is the client's square talent frame
// round its icon (gold when full, green while it has a rank or may take one, grey otherwise, its icon grey too where
// no point may go yet), its rank in a badge at its lower right. The arrows from a node to those it leads to run under
// the nodes, cell by cell (across its row, then down the column of the one it leads to), from the node's edge to just
// short of the other's, where the client's arrowhead points at it; gold once the node it comes from is full. A node
// clicked says so (Left: spend, Right: take back); what it may do is the client's to say (`canSpend`, `canRefund`),
// and a tree only shown (another player's) is not listened to. A search dims the nodes whose names don't hold it.
// Under the cursor a node says what the client's talent tooltip says: its name, its rank of its ranks, what the rank
// held does (or the first will), what the next rank will, the points its tree still needs, and that a click learns it.
import Game from "$game"
import { Align, Event, Line, MouseButton, Position, Track } from "$ltml"
import { Component, Tip, TipRow, TipSection } from "Ordaen"
import Locale from "@/locales"

// One step of the client's grid: its talents stand this far apart in its own units.
const CELL = 600
// A node (52 px, larger than the client's 40 so its icon reads), its icon inside the frame, a cell's width (a node
// and the gap beside it), and the least a row is high (a node and the gap under it): a taller tree box spreads its rows.
const SIZE = 60.9375dp
const ICON_INSET = 6.09375dp
const STEP = 82.03125dp
const ROW_LEAST = 82.03125dp
// A cell: room over its node, the node's row, room under it.
const CELL_ROWS: Array<Track> = [{ fr: 1 }, SIZE, { fr: 1 }]
// An arrow's line and its edge, and its head (the client's is 14 by 12 px, here at the nodes' scale).
const LINE = 4.6875dp
const LINE_EDGE: Line = { width: 1.171875dp, color: Color.hex("#000000") }
const HEAD = 21.09375dp
// Where a cell's vertical line and its node stand across it, and where its horizontal line stands down its node's row.
const MIDDLE: Number<Length> = (STEP - LINE) / 2
const NODE_LEFT: Number<Length> = (STEP - SIZE) / 2
const ACROSS_TOP: Number<Length> = (SIZE - LINE) / 2
const HALF: Number<Length> = STEP / 2
// The rank, a bare number large in the node's middle (on the font's own line, as text set on art is, so the digits
// stand in the middle and not over a line's room below them; as wide as the node, its letters centred by the client
// whatever their width there), thickly outlined, in the client's colours for its look.
const RANK_TEXT = 1.75rem
const RANK_OUTLINE = 2
const GOLD: Color = Color.hex("#ffd100")
const GREEN: Color = Color.hex("#19ff19")
const GREY: Color = Color.hex("#808080")
const DIM: Color = Color.hex("#a3977f")
// The veil over a node that can't be learned: dark, darker where its tree lacks the points.
const VEIL: Color = Color.hex("#000000")
// A tooltip's line for what isn't met yet, as the client writes it.
const RED: Color = Color.hex("#ff2020")
const EDGE: Color = Color.hex("#4a3a24")
// The client's talent frames and arrowheads, by what a node may do.
const FRAME_FULL: Atlas = "talents-node-square-yellow"
const FRAME_OPEN: Atlas = "talents-node-square-green"
const FRAME_SHUT: Atlas = "talents-node-square-gray"
const FRAME_GATED: Atlas = "talents-node-square-locked"
const FRAME_STRANDED: Atlas = "talents-node-square-red"
const HEAD_GOLD: Atlas = "talents-arrow-head-yellow"
const HEAD_DIM: Atlas = "talents-arrow-head-gray"

// The client's arrowhead points down; turned, it points across.
public enum Way { Down, Right, Left }

// What an arrow draws in a cell: a line over the node's row (`up`), through the row (`through`), from the row's middle
// down (`lower`, where it turns from across to down), under it (`down`), along the row's left or right half
// (`west`, `east`), and its head (`head`, pointing `way`) where it ends at the cell's node. Each is the line's colour, or
// nil where the cell has none of it.
public struct TreeCell {
  node: Game.TalentNode | nil = nil
  up: Color | nil = nil
  through: Color | nil = nil
  lower: Color | nil = nil
  down: Color | nil = nil
  west: Color | nil = nil
  east: Color | nil = nil
  head: Atlas | nil = nil
  way: Way = Way.Down
}

// A tree's cells, row by row: how many columns and rows it has, and each cell.
public struct TreeGrid {
  columns: Integer
  rows: Integer
  cells: Array<TreeCell>
}

// Where a tree's nodes begin: the smallest x or y.
function leastOf(nodes: Array<Game.TalentNode>, vertical: Boolean): Number {
  let least = Number.huge
  for (node of nodes) { least = least.min(vertical ? node.y : node.x) }
  return nodes.length == 0 ? 0 : least
}

// The column or row of the client's grid a node stands in, from the tree's first.
function stepOf(at: Number, least: Number): Integer {
  return ((at - least) / CELL + 0.5).floor()
}

// A tree laid out on its grid, its arrows drawn into the cells they cross.
public function gridOf(nodes: Array<Game.TalentNode>): TreeGrid {
  const leastX = leastOf(nodes, false)
  const leastY = leastOf(nodes, true)
  let columns = 0
  let rows = 0
  for (node of nodes) {
    columns = columns.max(stepOf(node.x, leastX) + 1)
    rows = rows.max(stepOf(node.y, leastY) + 1)
  }
  const cells: Array<mut TreeCell> = []
  for (place of 1..columns * rows) { cells.push({}) }
  const at = (column: Integer, row: Integer): mut TreeCell => cells[row * columns + column + 1] ?? panic("a cell of the grid")
  for (node of nodes) { at(stepOf(node.x, leastX), stepOf(node.y, leastY)).node = node }
  for (node of nodes) {
    const fromColumn = stepOf(node.x, leastX)
    const fromRow = stepOf(node.y, leastY)
    const color = node.rank == node.ranks ? GOLD : EDGE
    const head = node.rank == node.ranks ? HEAD_GOLD : HEAD_DIM
    for (edge of node.edges) {
      for (target of nodes) {
        if (target.id == edge) {
          const toColumn = stepOf(target.x, leastX)
          const toRow = stepOf(target.y, leastY)
          const right = toColumn > fromColumn
          // Across the node's row, to the column of the one it leads to.
          if (toColumn != fromColumn) {
            const step = right ? 1 : -1
            for (k of 1..(toColumn - fromColumn).abs()) {
              const column = fromColumn + (k - 1) * step
              if (right) { at(column, fromRow).east = color } else { at(column, fromRow).west = color }
              if (right) { at(column + step, fromRow).west = color } else { at(column + step, fromRow).east = color }
            }
            if (toRow == fromRow) {
              at(toColumn, toRow).head = head
              at(toColumn, toRow).way = right ? Way.Right : Way.Left
            } else {
              at(toColumn, fromRow).lower = color
            }
          }
          // Down that column, to it.
          if (toRow > fromRow) {
            at(toColumn, fromRow).down = color
            for (row of fromRow + 1..toRow - 1) {
              at(toColumn, row).up = color
              at(toColumn, row).through = color
              at(toColumn, row).down = color
            }
            at(toColumn, toRow).up = color
            at(toColumn, toRow).head = head
            at(toColumn, toRow).way = Way.Down
          }
        }
      }
    }
  }
  return { columns: columns, rows: rows, cells: cells }
}

// The points spent in a tree.
public function spentIn(tree: Game.TalentTree): Integer {
  let sum = 0
  for (node of tree.nodes) { sum += node.rank }
  return sum
}

// What a node's tooltip says under its name: what the rank held does, or the first rank where it holds none.
function tipTextOf(node: Game.TalentNode): String {
  return (node.rank > 0 ? node.current : node.next) ?? ""
}

// Its rows: its rank of its ranks, each point its tree still needs (red), and that a click learns it where one may.
function tipRowsOf(node: Game.TalentNode): Array<TipRow> {
  const rows: Array<TipRow> = [{ label: Locale.TALENT_RANK, value: "%d/%d".format(node.rank, node.ranks) }]
  for (condition of node.conditions) {
    if (!condition.met) { rows.push({ label: Locale.TALENT_TREE_POINTS.format(condition.points), value: "", tone: RED }) }
  }
  if (node.canSpend) { rows.push({ label: Locale.TALENT_LEARN, value: "", tone: GREEN }) }
  return rows
}

// Its next rank, where it holds one and has another.
function tipSectionsOf(node: Game.TalentNode): Array<TipSection> {
  const next = node.next
  return node.rank > 0 && next != nil ? [{ title: Locale.TALENT_NEXT_RANK, rows: [{ label: next, value: "" }] }] : []
}

// A node's look, as the client's talent window finds it (`CalculateVisualState`), the first that holds: a rank that no
// longer holds, every rank held, a rank it may take now, a rank held, its tree short of points, its arrow's talent
// unlearned, else nothing it may do now (no points left to spend, say).
enum Look { Stranded, Maxed, Selectable, Progress, Gated, Locked, Disabled }

function lookOf(node: Game.TalentNode): Look {
  if (node.stranded) { return .Stranded }
  if (node.rank > 0 && node.rank >= node.ranks) { return .Maxed }
  if (node.canSpend && !node.locked) { return .Selectable }
  if (node.rank > 0) { return .Progress }
  if (node.gated) { return .Gated }
  if (node.locked) { return .Locked }
  return .Disabled
}

// What each look draws: the frame, the rank's colour, whether the icon is grey and how dark the veil over it.
struct LookArt {
  frame: Atlas
  rank: Color
  grey: Boolean
  veil: Number
}

function artOf(look: Look): LookArt {
  match (look) {
    .Stranded => return { frame: FRAME_STRANDED, rank: RED, grey: false, veil: 0.25 }
    .Maxed => return { frame: FRAME_FULL, rank: GOLD, grey: false, veil: 0 }
    .Selectable => return { frame: FRAME_OPEN, rank: GREEN, grey: false, veil: 0 }
    .Progress => return { frame: FRAME_OPEN, rank: GREEN, grey: false, veil: 0 }
    .Gated => return { frame: FRAME_GATED, rank: GREY, grey: true, veil: 0.7 }
    .Locked => return { frame: FRAME_SHUT, rank: GREY, grey: true, veil: 0.25 }
    .Disabled => return { frame: FRAME_SHUT, rank: GREY, grey: true, veil: 0.25 }
  }
}

class TalentNodeView implements Component {
  public spend: Event<Integer> = new Event()
  public refund: Event<Integer> = new Event()

  state hovered = false
  derived tipText: String = tipTextOf(self.node)
  derived tipRows: Array<TipRow> = tipRowsOf(self.node)
  derived tipSections: Array<TipSection> = tipSectionsOf(self.node)

  derived lit: Boolean = self.search == "" || self.node.name.lower().contains(self.search.lower())
  derived look: Look = lookOf(self.node)
  derived art: LookArt = artOf(self.look)
  derived opacity: Number = self.lit ? 1 : 0.3
  // The rank shows once one is held, or where one may be taken (a 0 then).
  derived ranked: Boolean = self.node.rank > 0 || self.look == .Selectable
  derived rank: String = "%d".format(self.node.rank)
  derived veiled: Boolean = self.art.veil > 0

  node: Signal<Game.TalentNode>
  search: Signal<String>
  constructor(node: Signal<Game.TalentNode>, search: Signal<String>) {
    self.node = node
    self.search = search
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  onClick(mut self, click: Event.Press) {
    if (click.button == MouseButton.Right) {
      self.refund.emit(self.node.id)
    } else {
      self.spend.emit(self.node.id)
    }
  }

  public render(self): Template {
    return $ltml {
      <box position={Position.Absolute} left={NODE_LEFT} top={0ui} width={SIZE} height={SIZE} opacity={self.opacity}
           zLevel={2} @pointerPress={self.onClick} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <box position={Position.Absolute} left={ICON_INSET} top={ICON_INSET} right={ICON_INSET} bottom={ICON_INSET}
             icon={self.node.icon} desaturate={self.art.grey} />
        <box $if={self.veiled} position={Position.Absolute} left={ICON_INSET} top={ICON_INSET} right={ICON_INSET}
             bottom={ICON_INSET} background={VEIL} opacity={self.art.veil} />
        <box position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} background={self.art.frame} />
        <box $if={self.ranked} position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} xAlign={Align.Stretch}
             yAlign={Align.Center}>
          <text value={self.rank} textSize={RANK_TEXT} textColor={self.art.rank} textOutline={RANK_OUTLINE} wrap={.None} textFont={.Numbers}
                leading={.Tight} textAlign={.Center} />
        </box>
        <Tip $if={self.hovered} title={self.node.name} text={self.tipText} rows={self.tipRows} sections={self.tipSections} />
      </box>
    }
  }
}

// A cell's node as a list: none, or the one.
function nodesOf(cell: TreeCell): Array<Game.TalentNode> {
  const node = cell.node
  return node == nil ? [] : [node]
}

// One cell of a tree: the arrows' pieces in it, under its node.
class TreeCellView implements Component {
  public spend: Event<Integer> = new Event()
  public refund: Event<Integer> = new Event()

  derived headTurn: Number<Angle> = self.cell.way == Way.Right ? -90deg : self.cell.way == Way.Left ? 90deg : 0deg
  derived headDown: Boolean = self.cell.head != nil && self.cell.way == Way.Down
  derived headAcross: Boolean = self.cell.head != nil && self.cell.way != Way.Down
  derived headLeft: Number<Length> = self.cell.way == Way.Right ? NODE_LEFT - HEAD : NODE_LEFT + SIZE
  // The cell's node, where it has one.
  derived nodes: Array<Game.TalentNode> = nodesOf(self.cell)

  cell: Signal<TreeCell>
  search: Signal<String>
  constructor(cell: Signal<TreeCell>, search: Signal<String>) {
    self.cell = cell
    self.search = search
  }

  onSpend(mut self, id: Integer) { self.spend.emit(id) }
  onRefund(mut self, id: Integer) { self.refund.emit(id) }

  public render(self): Template {
    return $ltml {
      // Each row's box as high as its row: what it holds is placed by offsets, and the client draws nothing of a box
      // with no height.
      <box rows={CELL_ROWS} width={STEP} yAlign={Align.Stretch}>
        <box>
          <box $if={self.cell.up != nil} position={Position.Absolute} left={MIDDLE} top={0ui} bottom={0ui} width={LINE}
               background={self.cell.up} border={LINE_EDGE} />
          <box $if={self.headDown} position={Position.Absolute} left={(STEP - HEAD) / 2} bottom={0ui} width={HEAD}
               height={HEAD} background={self.cell.head} />
        </box>
        <box>
          <box $if={self.cell.through != nil} position={Position.Absolute} left={MIDDLE} top={0ui} bottom={0ui}
               width={LINE} background={self.cell.through} border={LINE_EDGE} />
          <box $if={self.cell.lower != nil} position={Position.Absolute} left={MIDDLE} top={ACROSS_TOP} bottom={0ui}
               width={LINE} background={self.cell.lower} border={LINE_EDGE} />
          <box $if={self.cell.west != nil} position={Position.Absolute} left={0ui} top={ACROSS_TOP} width={HALF}
               height={LINE} background={self.cell.west} border={LINE_EDGE} />
          <box $if={self.cell.east != nil} position={Position.Absolute} left={HALF} top={ACROSS_TOP} width={HALF}
               height={LINE} background={self.cell.east} border={LINE_EDGE} />
          <box $if={self.headAcross} position={Position.Absolute} left={self.headLeft} top={(SIZE - HEAD) / 2}
               width={HEAD} height={HEAD} background={self.cell.head} rotation={self.headTurn} zLevel={1} />
          <TalentNodeView $for={node of self.nodes} $key={node.id} node={node} search={self.search} @spend={self.onSpend}
                          @refund={self.onRefund} />
        </box>
        <box>
          <box $if={self.cell.down != nil} position={Position.Absolute} left={MIDDLE} top={0ui} bottom={0ui}
               width={LINE} background={self.cell.down} border={LINE_EDGE} />
        </box>
      </box>
    }
  }
}

public class TalentTreeView implements Component {
  public spend: Event<Integer> = new Event()
  public refund: Event<Integer> = new Event()

  derived title: String = `${self.tree.name}: ${spentIn(self.tree)}`
  derived grid: TreeGrid = gridOf(self.tree.nodes)
  derived columns: Array<Track> = tracksOf(self.grid.columns, STEP)
  derived rows: Array<Track> = rowTracksOf(self.grid.rows)

  tree: Signal<Game.TalentTree>
  search: Signal<String>
  constructor(tree: Signal<Game.TalentTree>, search: Signal<String> = "") {
    self.tree = tree
    self.search = search
  }

  onSpend(mut self, id: Integer) { self.spend.emit(id) }
  onRefund(mut self, id: Integer) { self.refund.emit(id) }

  public render(self): Template {
    return $ltml {
      <box rows={["max-content", { fr: 1 }]} gap={3sp} xAlign={Align.Center}>
        <text value={self.title} textColor={GOLD} wrap={.None} />
        <box columns={self.columns} rows={self.rows}>
          <TreeCellView $for={index, cell of self.grid.cells} $key={index} cell={cell} search={self.search}
                        @spend={self.onSpend} @refund={self.onRefund} />
        </box>
      </box>
    }
  }
}

// `count` tracks each `width` wide.
function tracksOf(count: Integer, width: Number<Length>): Array<Track> {
  const list: Array<Track> = []
  for (place of 1..count) { list.push(width) }
  return list
}

// `count` rows sharing the tree's height, each at least a node and its gap.
function rowTracksOf(count: Integer): Array<Track> {
  const list: Array<Track> = []
  for (place of 1..count) { list.push({ fr: 1, min: ROW_LEAST }) }
  return list
}
