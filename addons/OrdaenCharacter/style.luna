// The character window's look: its size at the player's scale, the paper doll's measures and the colours of what a
// stat, a slot or a faction says. Every gap and padding is counted in Ordaen's spacing unit (`sp`); a row is as tall as
// its text.
import { Edges, Fr } from "$ltml"

// The window's body, and the least it is drawn at (a window kept smaller, from an older save, is drawn at this).
public const WIDTH: Number<Length> = 1400dp
public const HEIGHT: Number<Length> = 848dp
// The three columns: the bars and defence on the left, the paper doll (the slots' columns and the model between
// them) in the middle, the stats on the right.
public const LEFT: Number<Length> = 344dp
public const DOLL: Number<Length> = 470dp
public const SLOT: Number<Length> = 46.875dp
// The durability bar under a slot.
public const WEAR: Number<Length> = 3.515625dp
// Round the text a bar shows (a faction's standing): the bar is as tall as it.
public const BAR_PAD: Edges = { top: 2sp, right: 3sp, bottom: 2sp, left: 3sp }
// The reputation tab's side, where the chosen faction stands.
public const SIDE: Number<Length> = 328.125dp

// A health or power bar, one line of a cut in the wood (three: its shade, its depth, its lit lower lip), a gauge's
// channel and its columns (the name, the value).
public const BAR: Number<Length> = 28dp
public const CUT_LINE: Number<Length> = 1dp
public const CHANNEL: Number<Length> = 9dp
public const GAUGE_LABEL: Number<Length> = 150dp
public const GAUGE_VALUE: Number<Length> = 72dp
// A card's socket, its glyph and the socket's floor, a section's padding and the room between its cards and its gauges.
public const SOCKET: Number<Length> = 44dp
public const GLYPH: Number<Length> = 28dp
public const SOCKET_FLOOR: Color = Color.hex("#00000073")
// The least the stats' column is wide: what its main stats, cards and gauges need whole.
public const RIGHT_LEAST: Number<Length> = 440dp
public const SECTION_PAD: Edges = { top: 2.5sp, right: 2.5sp, bottom: 2.5sp, left: 2.5sp }
public const CARDS_PAD: Edges = { bottom: 2sp }
// A main stat's room and its number's size.
public const MAIN_PAD: Edges = { top: 2.5sp, bottom: 2.5sp }
public const MAIN_TEXT: Number<TextSize> = 26rem / 13
// A resistance's bar and its picture.
public const RESIST_WIDTH: Number<Length> = 20dp
public const RESIST_HEIGHT: Number<Length> = 84dp
public const RESIST_ICON: Number<Length> = 20dp

public const INK: Color = Color.hex("#e8dcc4")
public const DIM: Color = Color.hex("#a3977f")
public const WHITE: Color = Color.hex("#ffffff")
public const GOLD: Color = Color.hex("#ffd100")
public const RED: Color = Color.hex("#ff4040")
public const YELLOW: Color = Color.hex("#ffd040")
public const GREEN: Color = Color.hex("#40d060")
public const BACK: Color = Color.hex("#00000066")
// A card: a plain dark field, opaque.
public const CARD: Color = Color.hex("#0d0907")
public const PICKED: Color = Color.hex("#ffd10026")
public const TROUGH: Color = Color.hex("#000000a6")
// A cut in the wood, lit from above: its upper edge in shade, its depth, its lower lip catching the light; a gauge's
// fill, a skill's (a weapon's, defense).
public const GROOVE_SHADE: Color = Color.hex("#0000008c")
public const GROOVE_DEPTH: Color = Color.hex("#000000e6")
public const GROOVE_LIP: Color = Color.hex("#ffdeaa38")
// The model's backdrop: the race's scene from the game's dressing room (four pieces, 320 x 384 texels together), as
// tall as the model's column at the window's own size and in its own proportions, centred and cut at the column's
// sides; a veil over it so the slots read; the dark where no scene is. Then the room between the column's edges and the
// slots drawn over it.
public const SCENE_HEIGHT: Number<Length> = 800dp
public const SCENE_WIDTH: Number<Length> = SCENE_HEIGHT * 320 / 384
public const SCENE_LEFT: Number<Length> = (DOLL - SCENE_WIDTH) / 2
public const SCENE_VEIL: Color = Color.hex("#00000059")
public const MODEL_BACK: Color = Color.hex("#0b0805")
public const DOLL_PAD: Edges = { top: 6sp, right: 6sp, bottom: 6sp, left: 6sp }
// The eight slots down each side of the model, spread from its top to its bottom.
public const SLOT_ROWS: Array<Fr> = [{ fr: 1 }, { fr: 1 }, { fr: 1 }, { fr: 1 }, { fr: 1 }, { fr: 1 }, { fr: 1 }, { fr: 1 }]
// A card's name and value set close, each no taller than its font's own line.
public const TIGHT: Number<Spacing> = 1sp
public const GAUGE: Color = Color.hex("#a3864f")
public const SKILL: Color = Color.hex("#3a68b8")
// The schools' and the resistances' colours: armor, holy, fire, nature, frost, shadow and arcane; a stat's glyph
// (attack power, damage a second).
public const HOLY: Color = Color.hex("#e8d98a")
public const STAT: Color = Color.hex("#c9a24e")
public const ARMOR: Color = Color.hex("#b8b2a2")
public const FIRE: Color = Color.hex("#c9692f")
public const NATURE: Color = Color.hex("#59a84b")
public const FROST: Color = Color.hex("#5f9fcf")
public const SHADOW: Color = Color.hex("#8a6bc4")
public const ARCANE: Color = Color.hex("#c27bc0")
// The flyout over the model.
public const FLYOUT: Color = Color.hex("#000000d9")
public const HEALTH: Color = Color.hex("#1d9a2a")
// The resources' colours, as the client's power bars fill them (`PowerBarColor`).
public const MANA: Color = Color.hex("#0000ff")
public const RAGE: Color = Color.hex("#ff0000")
public const ENERGY: Color = Color.hex("#ffff00")
public const FOCUS: Color = Color.hex("#ff8040")
