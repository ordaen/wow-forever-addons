// «Character»: the paper doll and the stats. The slots stand as the game's do, eight down each side of the model and
// the weapons along the bottom; each is the library's item slot (its tooltip, Shift+Left-click's link), with the
// item's level in its corner and its durability under it. Left-click or a drag picks up what is worn (to the bags,
// the bars, another slot) and lets go there what the cursor holds, as the game's own slot does. Under the model the
// health and the resource; on the right the main stats as cards, then the rest a section at a time.
import Game from "$game"
import { Action, Align, Art, BarFill, Edges, Event, FillFrom, Line, MouseButton, Overflow, Position, TextAlign, TextFont } from "$ltml"
import { Component, ItemButton, SECONDARY_TEXT, TITLE_LINE, TITLE_TEXT, Tabs, Tip } from "Ordaen"
import Locale from "@/locales"
import { Choices } from "@/settings"
import { AMMO, GearSet, LEFT, RIGHT, Resource, Skill, SlotSpec, Stats, WEAPONS, Who, Worn, averageLevel } from "@/sheet"
import Style from "@/style"

// A stat as a card shows it: its name and its value.
public struct Card {
  const label: String
  const value: String
  // What the game's paper doll says of it under its name and value: its tooltip's text.
  const tip: String = ""
}

// A group of cards under its heading.
public struct Group {
  const title: String
  const cards: Array<Card>
}

// The ammo's slot is the game's small one.
const AMMO_SIZE = 31.640625dp
// Durability under a quarter is red, as the game's armour figure turns it.
const WORN_OUT = 0.25
// The cooldown's run over a slot's icon, and the line round a slot the cursor's item goes in (the game lights its slot).
const COOLING: Color = Color.hex("#000000a6")
const FITS: Line = { width: 2.34375dp, color: Color.hex("#ffd100") }
public const FITS_GLOW: Color = Color.hex("#ffd10040")
// A set wholly worn; a chip's room round its name.
const SET_WORN: Line = { width: 1.171875dp, color: Color.hex("#ffd100") }
const CHIP_PAD: Edges = { top: 2sp, right: 3sp, bottom: 2sp, left: 3sp }
const NO_SLOTS: Array<Integer> = []
const NO_SETS: Array<GearSet> = []
const NOTHING: Worn = { slot: 0, item: nil, quality: .Common, level: nil, durability: nil }

function percent(value: Number): String { return "%.2f%%".format(value) }
function whole(value: Number): String { return String.of(value.floor()) }

// The durability bar's colour for what is left of an item.
public function wearColor(left: Number): Color { return left < WORN_OUT ? Style.RED : Style.GREEN }

// A slot of the paper doll, as the game's own slot takes the mouse: Left-click and a drag pick up what is worn and let
// go there what the cursor holds, Ctrl+Left-click tries it on, Alt+Left-click opens what the bags hold for the slot
// (the game's flyout), Shift+Left-click links it (the library's slot), and the right button uses it, the client's own
// doing. Lit while the cursor holds what goes in it; dimmed while it is picked up or on its way; its cooldown's run
// over its icon; the ammo's count on its own.
public class GearSlot implements Component {
  // What the slot was asked: its number each time.
  public picked: Event<Integer> = new Event()
  public tried: Event<Integer> = new Event()
  public flyout: Event<Integer> = new Event()

  derived empty: Art | nil = self.worn.item == nil ? self.spec.empty : nil
  derived levelText: String = self.levels && self.worn.level != nil ? String.of(self.worn.level ?? 0) : ""
  derived wearShown: Boolean = self.wear && self.worn.durability != nil
  derived wearFill: BarFill = self.fillOf()
  derived use: Action | nil = self.worn.item != nil ? Action.UseWornItem { slot: self.spec.id } : nil
  derived cooling: Boolean = self.worn.cooldown != nil
  derived coolFill: BarFill = { duration: self.worn.cooldown, color: COOLING, from: FillFrom.Top }

  spec: Signal<SlotSpec>
  worn: Signal<Worn>
  levels: Signal<Boolean>
  wear: Signal<Boolean>
  fits: Signal<Boolean>
  size: Signal<Number<Length>>
  constructor(spec: Signal<SlotSpec>, worn: Signal<Worn>, levels: Signal<Boolean>, wear: Signal<Boolean>,
    fits: Signal<Boolean> = false, size: Signal<Number<Length>> = Style.SLOT) {
    self.spec = spec
    self.worn = worn
    self.levels = levels
    self.wear = wear
    self.fits = fits
    self.size = size
  }

  fillOf(self): BarFill {
    const left = self.worn.durability ?? 1
    return { value: left, color: wearColor(left) }
  }

  onPressed(self, press: Event.Press) {
    if (press.button != MouseButton.Left) { return }
    const slot = peek self.spec.id
    if (Game.input.controlDown()) {
      self.tried.emit(slot)
    } else if (Game.input.altDown()) {
      self.flyout.emit(slot)
    } else {
      self.picked.emit(slot)
    }
  }

  onDragged(self) { self.picked.emit(peek self.spec.id) }

  public render(self): Template {
    return $ltml {
      <box gap={2sp}>
        <ItemButton item={self.worn.item} quality={self.worn.quality} art={self.empty} size={self.size}
                    count={self.worn.count} dimmed={self.worn.locked} worn={self.spec.id} action={self.use}
                    @pressed={self.onPressed} @dragged={self.onDragged} @dropped={self.onDragged}>
          <box $if={self.cooling} position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               fill={self.coolFill} />
          <box $if={self.levelText != ""} position={Position.Absolute} top={1.171875dp} right={2.34375dp}>
            <text value={self.levelText} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers} textColor={Style.INK}
                  wrap={.None} />
          </box>
          <box $if={self.fits} position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               border={FITS} background={FITS_GLOW} zLevel={2} />
        </ItemButton>
        <box height={Style.WEAR} background={Style.TROUGH} fill={self.wearFill} opacity={self.wearShown ? 1 : 0} />
      </box>
    }
  }
}

// A stat's card; under the cursor the game's own words on it, as its paper doll's tooltip says them.
public class StatCard implements Component {
  state hovered = false
  derived tipShown: Boolean = self.hovered && self.card.tip != ""
  derived tipTitle: String = `${self.card.label} ${self.card.value}`

  card: Signal<Card>
  big: Signal<Boolean>
  constructor(card: Signal<Card>, big: Signal<Boolean> = false) {
    self.card = card
    self.big = big
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box gap={2sp} padding={3sp} background={Style.CARD} @pointerEnter={self.onEnter}
           @pointerLeave={self.onLeave}>
        <text value={self.card.label} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
        <text value={self.card.value} textSize={self.big ? TITLE_TEXT : 1rem} textFont={TextFont.Numbers}
              textColor={Style.INK} wrap={.None} />
        <Tip $if={self.tipShown} title={self.tipTitle} text={self.card.tip} />
      </box>
    }
  }
}

// A group's heading and its cards, four to a row.
public class StatGroup implements Component {
  group: Signal<Group>
  constructor(group: Signal<Group>) {
    self.group = group
  }

  public render(self): Template {
    return $ltml {
      <box gap={3sp}>
        <text $if={self.group.title != ""} value={self.group.title} textFont={TextFont.Title} textColor={Style.GOLD} />
        <box columns={4} gap={2sp}>
          <StatCard $for={card of self.group.cards} card={card} />
        </box>
      </box>
    }
  }
}

// One of the bars under the model: how much there is, on a full bar of the resource's colour; under the cursor the
// game's own words on it.
public class PoolBar implements Component {
  derived full: BarFill = { value: 1, color: self.color }
  state hovered = false
  derived tipShown: Boolean = self.hovered && self.tip != ""
  derived tipTitle: String = `${self.label} ${self.amount}`

  label: Signal<String>
  amount: Signal<Integer>
  color: Signal<Color>
  tip: Signal<String>
  constructor(label: Signal<String>, amount: Signal<Integer>, color: Signal<Color>, tip: Signal<String> = "") {
    self.label = label
    self.amount = amount
    self.color = color
    self.tip = tip
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box padding={Style.BAR_PAD} background={Style.TROUGH} fill={self.full} xAlign={Align.Center} yAlign={Align.Center}
           @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <text value={`${self.label} ${self.amount}`} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers}
              textColor={Style.INK} wrap={.None} />
        <Tip $if={self.tipShown} title={self.tipTitle} text={self.tip} />
      </box>
    }
  }
}

// The sections under the main cards, in one order for every class.
public enum Section { Melee, Ranged, Spells, Defense, Skills }
const SECTIONS: Array<Section> = [.Melee, .Ranged, .Spells, .Defense, .Skills]

function sectionName(section: Section): String {
  return match (section) {
    .Melee => Locale.SECTION_MELEE
    .Ranged => Locale.SECTION_RANGED
    .Spells => Locale.SECTION_SPELLS
    .Defense => Locale.SECTION_DEFENSE
    .Skills => Locale.SECTION_SKILLS
  }
}

function resourceName(resource: Resource): String {
  return match (resource) {
    .Mana => Locale.MANA
    .Rage => Locale.RAGE
    .Energy => Locale.ENERGY
    .Focus => Locale.FOCUS
  }
}

function resourceColor(resource: Resource): Color {
  return match (resource) {
    .Mana => Style.MANA
    .Rage => Style.RAGE
    .Energy => Style.ENERGY
    .Focus => Style.FOCUS
  }
}

// The five main stats and the three ratings, on top.
public function mainCards(stats: Stats): Array<Card> {
  return [
    { label: Locale.STRENGTH, value: String.of(stats.strength), tip: stats.tips.primary[1] ?? "" },
    { label: Locale.AGILITY, value: String.of(stats.agility), tip: stats.tips.primary[2] ?? "" },
    { label: Locale.STAMINA, value: String.of(stats.stamina), tip: stats.tips.primary[3] ?? "" },
    { label: Locale.INTELLECT, value: String.of(stats.intellect), tip: stats.tips.primary[4] ?? "" },
    { label: Locale.SPIRIT, value: String.of(stats.spirit), tip: stats.tips.primary[5] ?? "" },
    { label: Locale.HIT, value: percent(stats.hit), tip: stats.tips.hit },
    { label: Locale.CRIT, value: percent(stats.meleeCrit) },
    { label: Locale.HASTE, value: percent(stats.haste) }
  ]
}

// Seconds between hits, the off hand's after the main hand's where one is held.
function speedText(stats: Stats): String {
  const off = stats.offSpeed
  if (stats.speed <= 0) { return Locale.NONE }
  if (off == nil) { return "%.2f".format(stats.speed) }
  return "%.2f / %.2f".format(stats.speed, off)
}

function dpsText(stats: Stats): String {
  if (stats.speed <= 0) { return Locale.NONE }
  return "%.1f".format((stats.minDamage + stats.maxDamage) / 2 / stats.speed)
}

// A section's groups of cards.
public function groupsOf(section: Section, stats: Stats, skills: Array<Skill>): Array<Group> {
  return match (section) {
    .Melee => [
      {
        title: Locale.GROUP_MAIN_HAND,
        cards: [
          { label: Locale.DAMAGE, value: `${whole(stats.minDamage)} – ${whole(stats.maxDamage)}` },
          { label: Locale.ATTACK_SPEED, value: speedText(stats) },
          { label: Locale.DPS, value: dpsText(stats) },
          { label: Locale.ATTACK_POWER, value: String.of(stats.attackPower), tip: stats.tips.attackPower }
        ]
      },
      {
        title: Locale.GROUP_MODIFIERS,
        cards: [{ label: Locale.HIT, value: percent(stats.hit) }, { label: Locale.CRIT_CHANCE, value: percent(stats.meleeCrit) }]
      }
    ]
    .Ranged => [
      { title: Locale.GROUP_WEAPON, cards: [{ label: Locale.RANGED_ATTACK_POWER, value: String.of(stats.rangedAttackPower), tip: stats.tips.rangedAttackPower }] },
      {
        title: Locale.GROUP_MODIFIERS,
        cards: [{ label: Locale.HIT, value: percent(stats.hit) }, { label: Locale.CRIT_CHANCE, value: percent(stats.rangedCrit) }]
      }
    ]
    .Spells => [
      {
        title: Locale.GROUP_SPELL_POWER,
        cards: [{ label: Locale.SPELL_DAMAGE, value: String.of(stats.spellDamage) }, { label: Locale.HEALING, value: String.of(stats.healing), tip: stats.tips.healing }]
      },
      { title: Locale.GROUP_MODIFIERS, cards: [{ label: Locale.CRIT_CHANCE, value: percent(stats.spellCrit) }] },
      { title: Locale.GROUP_MANA_REGEN, cards: [{ label: Locale.MANA_REGEN, value: whole(stats.regen), tip: stats.tips.regen }] }
    ]
    .Defense => [
      { title: Locale.GROUP_ARMOR, cards: [{ label: Locale.ARMOR, value: String.of(stats.armor), tip: stats.tips.armor }] },
      {
        title: Locale.GROUP_AVOIDANCE,
        cards: [
          { label: Locale.DODGE, value: percent(stats.dodge) },
          { label: Locale.PARRY, value: percent(stats.parry) },
          { label: Locale.BLOCK, value: percent(stats.block), tip: stats.tips.block }
        ]
      },
      { title: Locale.GROUP_RESISTANCES, cards: resistanceCards(stats.resistances) }
    ]
    .Skills => skillGroups(skills)
  }
}

const SCHOOLS: Array<String> = [Locale.ARCANE, Locale.FIRE, Locale.FROST, Locale.NATURE, Locale.SHADOW]

function resistanceCards(resistances: Array<Integer>): Array<Card> {
  const cards: Array<Card> = []
  for (index, school of SCHOOLS) { cards.push({ label: school, value: String.of(resistances[index] ?? 0) }) }
  return cards
}

// A skill's value as the game writes it, its bonus after the rank: «300+5/300».
function skillValue(skill: Skill): String {
  if (skill.modifier != 0) { return `${skill.rank}+${skill.modifier}/${skill.max}` }
  return `${skill.rank}/${skill.max}`
}

// The skills under the game's headings.
function skillGroups(skills: Array<Skill>): Array<Group> {
  const filed: Array<Filed> = []
  let title = ""
  for (skill of skills) {
    if (skill.header) {
      title = skill.name
    } else {
      filed.push({ title: title, card: { label: skill.name, value: skillValue(skill) } })
    }
  }
  return grouped(filed)
}

// A card with the heading of the group it goes under.
public struct Filed {
  const title: String
  const card: Card
}

// Cards under their headings, in order: those that follow one another under one heading make one group.
public function grouped(filed: Array<Filed>): Array<Group> {
  const groups: Array<Group> = []
  let title = ""
  let cards: Array<Card> = []
  for (entry of filed) {
    if (entry.title != title && cards.length > 0) {
      groups.push({ title: title, cards: cards })
      cards = []
    }
    title = entry.title
    cards.push(entry.card)
  }
  if (cards.length > 0) { groups.push({ title: title, cards: cards }) }
  return groups
}

// A set of the game's equipment manager: its name, gold while all of it is worn, red while some of it is nowhere the
// player has it; a click puts it on (the client refuses in a fight). The last chip, «+», saves what is worn as a
// new set.
public class SetChip implements Component {
  public click: Event<nil> = new Event()

  derived ink: Color = self.disabled ? Style.DIM : self.missing ? Style.RED : self.worn ? Style.GOLD : Style.INK
  derived edge: Line | nil = self.worn ? SET_WORN : nil

  label: Signal<String>
  worn: Signal<Boolean>
  missing: Signal<Boolean>
  disabled: Signal<Boolean>
  constructor(label: Signal<String>, worn: Signal<Boolean> = false, missing: Signal<Boolean> = false,
    disabled: Signal<Boolean> = false) {
    self.label = label
    self.worn = worn
    self.missing = missing
    self.disabled = disabled
  }

  onClick(self) {
    if (!(peek self.disabled)) { self.click.emit() }
  }

  public render(self): Template {
    return $ltml {
      <box padding={CHIP_PAD} background={Style.CARD} border={self.edge} @pointerPress={self.onClick}
           @keyPress(.Enter)={self.onClick} @keyPress(.Space)={self.onClick}>
        <text value={self.label} textSize={SECONDARY_TEXT} textColor={self.ink} wrap={.None} />
      </box>
    }
  }
}

// A set's chip, which tells its number.
public class SetOf implements Component {
  public use: Event<Integer> = new Event()

  set: Signal<GearSet>
  disabled: Signal<Boolean>
  constructor(set: Signal<GearSet>, disabled: Signal<Boolean>) {
    self.set = set
    self.disabled = disabled
  }

  onClick(self) { self.use.emit(peek self.set.id) }

  public render(self): Template {
    return $ltml {
      <SetChip label={self.set.name} worn={self.set.worn} missing={self.set.missing > 0} disabled={self.disabled}
               @click={self.onClick} />
    }
  }
}

// The game's flyout of a slot: what the bags hold that goes in it, each a click away from being worn.
public class Flyout implements Component {
  // An item clicked: its number.
  public chose: Event<Integer> = new Event()
  public close: Event<nil> = new Event()

  derived none: Boolean = self.items.length == 0

  items: Signal<Array<Integer>>
  constructor(items: Signal<Array<Integer>>) {
    self.items = items
  }

  onPick(self, item: Integer) { self.chose.emit(item) }
  onClose(self) { self.close.emit() }

  public render(self): Template {
    return $ltml {
      <box gap={2sp} padding={3sp} background={Style.FLYOUT}>
        <box columns={[{ fr: 1 }, "max-content"]} gap={3sp} yAlign={Align.Center}>
          <text value={Locale.FLYOUT} textSize={SECONDARY_TEXT} textColor={Style.GOLD} />
          <SetChip label={Locale.CLOSE} @click={self.onClose} />
        </box>
        <text $if={self.none} value={Locale.NOTHING_FITS} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
        <box columns={{ each: "max-content" }} gap={2sp}>
          <ItemButton $for={item of self.items} item={peek item} @pick={self.onPick} />
        </box>
      </box>
    }
  }
}

public class GearPage implements Component {
  // A slot clicked or dragged: its number.
  public picked: Event<Integer> = new Event()
  // A slot Ctrl+clicked, to try on what it holds; one Alt+clicked, for its flyout.
  public tried: Event<Integer> = new Event()
  public flyout: Event<Integer> = new Event()
  // An item chosen in the flyout; the flyout closed.
  public chose: Event<Integer> = new Event()
  public closeFlyout: Event<nil> = new Event()
  // A set clicked, by its number; «+» clicked.
  public useSet: Event<Integer> = new Event()
  public saveSet: Event<nil> = new Event()

  derived whoText: String = Locale.WHO.format(self.who.level, self.who.race, self.who.className)
  derived levelText: String = self.levelOf()
  derived main: Array<Card> = mainCards(self.stats)
  derived sectionNames: Array<String> = SECTIONS.map(s => sectionName(s))
  derived groups: Array<Group> = groupsOf(SECTIONS[self.section] ?? .Melee, self.stats, self.skills)
  derived noGroups: Boolean = self.groups.length == 0
  derived resource: String = resourceName(self.stats.resource)
  derived resourceTint: Color = resourceColor(self.stats.resource)
  derived flyoutShown: Boolean = self.flyoutSlot != nil

  worn: Signal<Array<Worn>>
  who: Signal<Who>
  stats: Signal<Stats>
  skills: Signal<Array<Skill>>
  usesAmmo: Signal<Boolean>
  choices: Signal<Choices>
  section: mut Signal<Integer>
  // The slots where what the cursor holds goes.
  fitsSlots: Signal<Array<Integer>>
  sets: Signal<Array<GearSet>>
  // The slot whose flyout is open, and what it offers.
  flyoutSlot: Signal<Integer | nil>
  fitting: Signal<Array<Integer>>
  constructor(worn: Signal<Array<Worn>>, who: Signal<Who>, stats: Signal<Stats>, skills: Signal<Array<Skill>>,
    usesAmmo: Signal<Boolean>, choices: Signal<Choices>, section: mut Signal<Integer>,
    fitsSlots: Signal<Array<Integer>> = NO_SLOTS, sets: Signal<Array<GearSet>> = NO_SETS,
    flyoutSlot: Signal<Integer | nil> = nil, fitting: Signal<Array<Integer>> = NO_SLOTS) {
    self.worn = worn
    self.who = who
    self.stats = stats
    self.skills = skills
    self.usesAmmo = usesAmmo
    self.choices = choices
    self.section = section
    self.fitsSlots = fitsSlots
    self.sets = sets
    self.flyoutSlot = flyoutSlot
    self.fitting = fitting
  }

  levelOf(self): String {
    const level = averageLevel(self.worn)
    return level == nil ? "" : Locale.ITEM_LEVEL.format("%.1f".format(level))
  }

  wornOf(self, slot: Integer): Worn {
    return self.worn.find(piece => piece.slot == slot) ?? NOTHING
  }

  fitsIn(self, slot: Integer): Boolean { return self.fitsSlots.any(s => s == slot) }

  onPicked(self, slot: Integer) { self.picked.emit(slot) }
  onTried(self, slot: Integer) { self.tried.emit(slot) }
  onFlyout(self, slot: Integer) { self.flyout.emit(slot) }
  onChose(self, item: Integer) { self.chose.emit(item) }
  onCloseFlyout(self) { self.closeFlyout.emit() }
  onUseSet(self, id: Integer) { self.useSet.emit(id) }
  onSaveSet(self) { self.saveSet.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={[Style.DOLL, { fr: 1 }]} gap={6sp}>
        <box rows={[{ fr: 1 }, "max-content", "max-content", "max-content"]} gap={3sp}>
          <box columns={[Style.SLOT, { fr: 1 }, Style.SLOT]} gap={3sp}>
            <box gap={2sp}>
              <GearSlot $for={spec of LEFT} spec={spec} worn={self.wornOf(spec.id)} levels={self.choices.itemLevels}
                        wear={self.choices.durability} fits={self.fitsIn(spec.id)} @picked={self.onPicked}
                        @tried={self.onTried} @flyout={self.onFlyout} />
            </box>
            <box rows={["max-content", "max-content", "max-content", { fr: 1 }]} gap={2sp}
                 xAlign={Align.Center} textAlign={TextAlign.Center} background={Style.BACK} padding={3sp}>
              <text value={self.who.name} textSize={TITLE_TEXT} lineHeight={TITLE_LINE} textFont={TextFont.Title} textColor={Style.GOLD} />
              <text value={self.whoText} textSize={SECONDARY_TEXT} textColor={Style.INK} />
              <text value={self.levelText} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
              <box model={"player"} yAlign={Align.End}>
                <Flyout $if={self.flyoutShown} items={self.fitting} @chose={self.onChose} @close={self.onCloseFlyout} />
              </box>
            </box>
            <box gap={2sp}>
              <GearSlot $for={spec of RIGHT} spec={spec} worn={self.wornOf(spec.id)} levels={self.choices.itemLevels}
                        wear={self.choices.durability} fits={self.fitsIn(spec.id)} @picked={self.onPicked}
                        @tried={self.onTried} @flyout={self.onFlyout} />
            </box>
          </box>
          <box columns={{ each: "max-content" }} gap={2sp} xAlign={Align.Center} yAlign={Align.Start}>
            <GearSlot $for={spec of WEAPONS} spec={spec} worn={self.wornOf(spec.id)} levels={self.choices.itemLevels}
                      wear={self.choices.durability} fits={self.fitsIn(spec.id)} @picked={self.onPicked}
                      @tried={self.onTried} @flyout={self.onFlyout} />
            <GearSlot $if={self.usesAmmo} spec={AMMO} worn={self.wornOf(AMMO.id)} levels={false} wear={false}
                      fits={self.fitsIn(AMMO.id)} size={AMMO_SIZE} @picked={self.onPicked} />
          </box>
          <box columns={{ each: "max-content" }} gap={2sp} xAlign={Align.Center}>
            <SetOf $for={set of self.sets} set={set} disabled={Game.situation.combat} @use={self.onUseSet} />
            <SetChip label={Locale.SAVE_SET} disabled={Game.situation.combat} @click={self.onSaveSet} />
          </box>
          <box gap={2sp}>
            <PoolBar label={Locale.HEALTH} amount={self.stats.health} color={Style.HEALTH} tip={self.stats.tips.health} />
            <PoolBar label={self.resource} amount={self.stats.power} color={self.resourceTint}
                     tip={self.stats.tips.power} />
          </box>
        </box>
        <box rows={["max-content", "max-content", { fr: 1 }]} gap={3sp}>
          <box columns={4} gap={2sp}>
            <StatCard $for={card of self.main} card={card} big={true} />
          </box>
          <Tabs tabs={self.sectionNames} selected={mut self.section} />
          <box overflow={Overflow.Scroll}>
            <box gap={6sp}>
              <text $if={self.noGroups} value={Locale.NO_SKILLS} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
              <StatGroup $for={group of self.groups} group={group} />
            </box>
          </box>
        </box>
      </box>
    }
  }
}
