// «Character»: the bars and defence on the left, the paper doll in the middle, the stats on the right. The slots
// stand as the game's do, eight down each side of the model and the weapons in a row under it (the ranged slot or the
// relic, the ammo's small slot after it); each is the library's item slot (its tooltip, Shift+Left-click's link), with
// the item's level in its corner and its durability under it. Left-click or a drag picks up what is worn (to the bags,
// the bars, another slot) and lets go there what the cursor holds, as the game's own slot does. The game's sets stand
// over the three columns.
import Game from "$game"
import { Action, Align, Art, BarFill, Edges, Event, FillFrom, Line, MouseButton, Overflow, Position, TextFont, Track } from "$ltml"
import { ButtonPlate, Component, ItemButton, PushButton, SECONDARY_TEXT, TITLE_LINE, TITLE_TEXT, Tabs, TipText, classColor } from "Ordaen"
import { Active } from "OrdaenAuras"
import Locale from "@/locales"
import { Choices, slotSizeOf } from "@/settings"
import { AMMO, GearSet, LEFT, RIGHT, Resource, Skill, SlotSpec, Stats, WEAPONS, Who, Worn, averageLevel } from "@/sheet"
import { Boost, Breakdown, NO_BREAKDOWN, boostsOf, breakdownOf, wordsOf } from "@/sources"
import { Stat } from "@/stat"
import { Cut, Gauge, Groove, Main, MainStat, PoolBar, Resist, ResistColumn, Row, Section, SectionView, StatGauge, StatRow, defenceOf, defenceRows, mainsOf, resistsOf, sectionsOf, sharedGauges, sharedRows, speedsOf } from "@/stats"
import Style from "@/style"

// The ammo's slot is the game's small one.
const AMMO_SIZE = 31.640625dp
// Durability under a quarter is red, as the game's armour figure turns it.
const WORN_OUT = 0.25
// The cooldown's run over a slot's icon, and the line round a slot the cursor's item goes in (the game lights its slot).
const COOLING: Color = Color.hex("#000000a6")
const FITS: Line = { width: 2.34375dp, color: Color.hex("#ffd100") }
public const FITS_GLOW: Color = Color.hex("#ffd10040")
// A chip's room round its word; the sets' «Save».
const SAVE_WIDTH = 140dp
const CHIP_PAD: Edges = { top: 2sp, right: 3sp, bottom: 2sp, left: 3sp }
const NO_SLOTS: Array<Integer> = []
const NO_SETS: Array<GearSet> = []
const NO_AURAS: Array<Active> = []
const PLAYER = "player"
const NOTHING: Worn = { slot: 0, item: nil, quality: .Common, level: nil, durability: nil }

// Each race's scene from the game's dressing room, enlarged (art/pieces/backdrop-<race>.json), by the race's name in
// the client's files; a race without one has the dark behind its model.
const SCENES: Map<String, Asset> = {
  Human: "@/media/backdrop-human.tga", Dwarf: "@/media/backdrop-dwarf.tga",
  NightElf: "@/media/backdrop-nightelf.tga", Gnome: "@/media/backdrop-gnome.tga",
  Orc: "@/media/backdrop-orc.tga", Scourge: "@/media/backdrop-scourge.tga",
  Tauren: "@/media/backdrop-tauren.tga", Troll: "@/media/backdrop-troll.tga",
  Skyborne: "@/media/backdrop-skyborne.tga"
}

// The durability bar's colour for what is left of an item.
public function wearColor(left: Number): Color { return left < WORN_OUT ? Style.RED : Style.GREEN }

// A slot of the paper doll, as the game's own slot takes the mouse: Left-click and a drag pick up what is worn and let
// go there what the cursor holds, Ctrl+Left-click tries it on, Alt+Left-click opens what the bags hold for the slot
// (the game's flyout), Shift+Left-click links it (the library's slot), and the right button uses it, the client's own
// doing. Lit while the cursor holds what goes in it; dimmed while it is picked up or on its way; its cooldown's run
// over its icon; the ammo's count on its own. Another player's slot (not `own`) is only shown: its tooltip the
// item's, compared with what the player wears, and no click uses or picks up anything.
public class GearSlot implements Component {
  // What the slot was asked: its number each time.
  public picked: Event<Integer> = new Event()
  public tried: Event<Integer> = new Event()
  public flyout: Event<Integer> = new Event()

  derived empty: Art | nil = self.worn.item == nil ? self.spec.empty : nil
  derived levelText: String = self.levels && self.worn.level != nil ? String.of(self.worn.level ?? 0) : ""
  derived wearShown: Boolean = self.wear && self.worn.durability != nil
  derived wearFill: BarFill = self.fillOf()
  derived use: Action | nil = self.own && self.worn.item != nil ? Action.UseWornItem { slot: self.spec.id } : nil
  derived wornSlot: Integer | nil = self.own ? self.spec.id : nil
  derived cooling: Boolean = self.worn.cooldown != nil
  derived coolFill: BarFill = { duration: self.worn.cooldown, color: COOLING, from: FillFrom.Top }
  derived shared: Boolean = self.share != ""

  spec: Signal<SlotSpec>
  worn: Signal<Worn>
  levels: Signal<Boolean>
  wear: Signal<Boolean>
  fits: Signal<Boolean>
  size: Signal<Number<Length>>
  // What its item gives the stat whose tooltip is open («+40»): the slot rimmed in gold, the share in a badge centred
  // under it, room past the slot's sides for a wide one («+1.00%»); empty while it gives none.
  share: Signal<String>
  own: Signal<Boolean>
  constructor(spec: Signal<SlotSpec>, worn: Signal<Worn>, levels: Signal<Boolean>, wear: Signal<Boolean>,
    fits: Signal<Boolean> = false, size: Signal<Number<Length>> = Style.SLOT, share: Signal<String> = "",
    own: Signal<Boolean> = true) {
    self.spec = spec
    self.worn = worn
    self.levels = levels
    self.wear = wear
    self.fits = fits
    self.size = size
    self.share = share
    self.own = own
  }

  fillOf(self): BarFill {
    const left = self.worn.durability ?? 1
    return { value: left, color: wearColor(left) }
  }

  onPressed(self, press: Event.Press) {
    if (press.button != MouseButton.Left) { return }
    if (!self.own) {
      if (Game.input.controlDown()) { self.tried.emit(peek self.spec.id) }
      return
    }
    const slot = peek self.spec.id
    if (Game.input.controlDown()) {
      self.tried.emit(slot)
    } else if (Game.input.altDown()) {
      self.flyout.emit(slot)
    } else {
      self.picked.emit(slot)
    }
  }

  onDragged(self) {
    if (self.own) { self.picked.emit(peek self.spec.id) }
  }

  public render(self): Template {
    return $ltml {
      <box gap={2sp}>
        <ItemButton item={self.worn.item} quality={self.worn.quality} art={self.empty} size={self.size}
                    count={self.worn.count} dimmed={self.worn.locked} worn={self.wornSlot} action={self.use}
                    @pressed={self.onPressed} @dragged={self.onDragged} @dropped={self.onDragged}>
          <box $if={self.cooling} position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               fill={self.coolFill} />
          <box $if={self.levelText != ""} position={Position.Absolute} top={1.171875dp} right={2.34375dp}>
            <text value={self.levelText} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers} textColor={Style.INK}
                  wrap={.None} />
          </box>
          <box $if={self.fits} position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               border={FITS} background={FITS_GLOW} zLevel={2} />
          <box $if={self.shared} position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               border={Style.SOURCE_RIM} background={Style.SOURCE_GLOW} zLevel={2} />
        </ItemButton>
        <box height={Style.WEAR} background={Style.TROUGH} fill={self.wearFill} opacity={self.wearShown ? 1 : 0} />
        <box $if={self.shared} position={Position.Absolute} left={-self.size} right={-self.size} bottom={0ui}
             xAlign={Align.Center} zLevel={4}>
          <box background={Style.SHARE} padding={Style.SHARE_PAD}>
            <text value={self.share} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers} textColor={Style.SHARE_INK}
                  wrap={.None} />
          </box>
        </box>
      </box>
    }
  }
}

function resourceColor(resource: Resource): Color {
  return match (resource) {
    .Mana => Style.MANA
    .Rage => Style.RAGE
    .Energy => Style.ENERGY
    .Focus => Style.FOCUS
  }
}

// A small dark chip with a word, a click away: the flyout's «Close».
public class Chip implements Component {
  public click: Event<nil> = new Event()

  label: Signal<String>
  constructor(label: Signal<String>) {
    self.label = label
  }

  onClick(self) { self.click.emit() }

  public render(self): Template {
    return $ltml {
      <box padding={CHIP_PAD} background={Style.CARD} @pointerPress={self.onClick} @keyPress(.Enter)={self.onClick}
           @keyPress(.Space)={self.onClick}>
        <text value={self.label} textSize={SECONDARY_TEXT} textColor={Style.INK} wrap={.None} />
      </box>
    }
  }
}

// The sets of the game's equipment manager as a page's tabs, the one worn whole picked, and «New Set» after them. A
// set's tab picked puts it on (not in a fight, where the client refuses: the worn one stays picked). «New Set» picked
// saves nothing yet: «Save» stands at the strip's right, and saves what is worn as a new set, whose tab is then the
// picked one; disabled while what is worn is a set already, which its tip names.
public class GearSets implements Component {
  // A set's tab picked, by the set's number; «Save» pressed.
  public use: Event<Integer> = new Event()
  public save: Event<nil> = new Event()

  // The tab picked: a set's place, the place after them for «New Set», 0 for none.
  state chosen: Integer = 0
  derived names: Array<String> = self.namesOf()
  derived drafting: Boolean = self.chosen == self.sets.length + 1
  derived same: GearSet | nil = self.sets.find(set => set.worn)
  derived taken: Boolean = self.same != nil
  derived saveTip: TipText | nil = self.tipOf()

  sets: Signal<Array<GearSet>>
  constructor(sets: Signal<Array<GearSet>>) {
    self.sets = sets
    // The sets read anew: the one worn picked, unless «New Set» is (where a set saved takes its place).
    watch {
      const read = self.sets
      if (!(peek self.drafting)) { self.chosen = wornPlace(read) }
    }
    watch (place of self.chosen) { self.onChosen(place) }
  }

  onChosen(mut self, place: Integer) {
    const set = (peek self.sets)[place]
    if (set == nil || set.worn) { return }
    if (Game.situation.combat) {
      self.chosen = wornPlace(peek self.sets)
      return
    }
    self.use.emit(set.id)
  }

  namesOf(self): Array<String> {
    const names = self.sets.map(set => set.name)
    names.push(Locale.NEW_SET)
    return names
  }

  tipOf(self): TipText | nil {
    const same = self.same
    return same == nil ? nil : { title: Locale.SET_TAKEN, text: Locale.SET_TAKEN_TIP.format(same.name), rows: [] }
  }

  onSave(self) { self.save.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={[{ fr: 1 }, "max-content"]} gap={3sp} yAlign={Align.End}>
        <Tabs tabs={self.names} selected={mut self.chosen} />
        <PushButton $if={self.drafting} label={Locale.SAVE_SET} width={SAVE_WIDTH} plate={ButtonPlate.Accent}
                    disabled={self.taken} tip={self.saveTip} @click={self.onSave} />
      </box>
    }
  }
}

// The place of the set worn whole; 0 where none is.
function wornPlace(sets: Array<GearSet>): Integer {
  for (place, set of sets) {
    if (set.worn) { return place }
  }
  return 0
}

// The game's flyout of a slot: what the bags hold that goes in it, each a click away from being worn.
public class Flyout implements Component {
  // An item clicked: its number.
  public chose: Event<Integer> = new Event()
  public close: Event<nil> = new Event()

  derived none: Boolean = self.items.length == 0

  items: Signal<Array<Integer>>
  constructor(items: Signal<Array<Integer>>) {
    self.items = items
  }

  onPick(self, item: Integer) { self.chose.emit(item) }
  onClose(self) { self.close.emit() }

  public render(self): Template {
    return $ltml {
      <box gap={2sp} padding={3sp} background={Style.FLYOUT}>
        <box columns={[{ fr: 1 }, "max-content"]} gap={3sp} yAlign={Align.Center}>
          <text value={Locale.FLYOUT} textSize={SECONDARY_TEXT} textColor={Style.GOLD} />
          <Chip label={Locale.CLOSE} @click={self.onClose} />
        </box>
        <text $if={self.none} value={Locale.NOTHING_FITS} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
        <box columns={{ each: "max-content" }} gap={2sp}>
          <ItemButton $for={item of self.items} item={peek item} @pick={self.onPick} />
        </box>
      </box>
    }
  }
}

public class GearPage implements Component {
  // A slot clicked or dragged: its number.
  public picked: Event<Integer> = new Event()
  // A slot Ctrl+clicked, to try on what it holds; one Alt+clicked, for its flyout.
  public tried: Event<Integer> = new Event()
  public flyout: Event<Integer> = new Event()
  // An item chosen in the flyout; the flyout closed.
  public chose: Event<Integer> = new Event()
  public closeFlyout: Event<nil> = new Event()
  // A set clicked, by its number; «+» clicked.
  public useSet: Event<Integer> = new Event()
  public saveSet: Event<nil> = new Event()

  derived fullName: String = self.who.surname != "" ? `${self.who.name} ${self.who.surname}` : self.who.name
  derived whoText: String = Locale.LEVEL_RACE.format(self.who.level, self.who.race)
  derived tag: String = self.classTag ?? Game.player.classTag
  derived whoColor: Color = classColor(self.tag) ?? Style.GOLD
  derived scene: Asset | nil = SCENES[self.who.scene]
  derived levelText: String = self.levelOf()
  derived flyoutShown: Boolean = self.flyoutSlot != nil
  derived mains: Array<Main> = mainsOf(self.stats)
  derived resists: Array<Resist> = resistsOf(self.stats)
  derived defence: Array<Gauge> = defenceOf(self.stats)
  derived blocked: Array<Row> = defenceRows(self.stats)
  derived speeds: Array<Row> = speedsOf(self.stats)
  derived shared: Array<Gauge> = sharedGauges(self.stats)
  derived sharedLines: Array<Row> = sharedRows(self.stats)
  derived sections: Array<Section> = sectionsOf(self.stats, self.skills, self.tag)
  // The bars: health, the resource with what it regains, and a druid's energy beside its mana.
  derived health: String = String.of(self.stats.health)
  derived power: String = self.stats.resource == Resource.Rage ? `0 / ${self.stats.power}` : String.of(self.stats.power)
  derived powerFilled: Number = self.stats.resource == Resource.Rage ? 0 : 1
  derived powerTint: Color = resourceColor(self.stats.resource)
  derived powerRegen: String = self.regenOf(self.stats.resource)
  derived energyShown: Boolean = self.stats.energy > 0
  derived energy: String = String.of(self.stats.energy)
  derived energyRegen: String = self.regenOf(Resource.Energy)
  // Mana's sources; rage and energy have none of a stat's.
  derived powerStat: Stat | nil = self.stats.resource == Resource.Mana ? .Power : nil
  // The stat whose tooltip is open (none while none is), what it says and what lights with it.
  state tipped: Stat | nil = nil
  derived shown: Breakdown = self.shownOf()
  // The stats the auras on the character raise or lower: their values green or red.
  derived boosts: Map<String, Boost> = boostsOf({
    stats: self.stats, worn: self.worn, auras: self.auras, classTag: self.tag
  })

  worn: Signal<Array<Worn>>
  who: Signal<Who>
  stats: Signal<Stats>
  skills: Signal<Array<Skill>>
  usesAmmo: Signal<Boolean>
  choices: Signal<Choices>
  // The slots where what the cursor holds goes.
  fitsSlots: Signal<Array<Integer>>
  sets: Signal<Array<GearSet>>
  // The slot whose flyout is open, and what it offers.
  flyoutSlot: Signal<Integer | nil>
  fitting: Signal<Array<Integer>>
  // The auras on the character and what each changes (Ordaen Auras): a stat tooltip's «Effects».
  auras: Signal<Array<Active>>
  // Whose character it is: the player's own (its sets and its flyout), or another player's, inspected (`unit`, of
  // class `classTag`), whose gear is only shown.
  unit: Signal<String>
  classTag: Signal<String | nil>
  derived own: Boolean = self.unit == PLAYER
  // The slots' size as the player chose it; the model's column between them gives up what larger slots take.
  derived slot: Number<Length> = slotSizeOf(self.choices.slotSize)
  derived dollColumns: Array<Track> = [self.slot, { fr: 1 }, self.slot]
  constructor(worn: Signal<Array<Worn>>, who: Signal<Who>, stats: Signal<Stats>, skills: Signal<Array<Skill>>,
    usesAmmo: Signal<Boolean>, choices: Signal<Choices>, fitsSlots: Signal<Array<Integer>> = NO_SLOTS,
    sets: Signal<Array<GearSet>> = NO_SETS, flyoutSlot: Signal<Integer | nil> = nil, fitting: Signal<Array<Integer>> = NO_SLOTS,
    auras: Signal<Array<Active>> = NO_AURAS, unit: Signal<String> = PLAYER, classTag: Signal<String | nil> = nil) {
    self.worn = worn
    self.who = who
    self.stats = stats
    self.skills = skills
    self.usesAmmo = usesAmmo
    self.choices = choices
    self.fitsSlots = fitsSlots
    self.sets = sets
    self.flyoutSlot = flyoutSlot
    self.fitting = fitting
    self.auras = auras
    self.unit = unit
    self.classTag = classTag
  }

  shownOf(self): Breakdown {
    const stat = self.tipped
    if (stat == nil) { return NO_BREAKDOWN }
    return breakdownOf(stat, wordsOf(stat, self.stats), {
      stats: self.stats, worn: self.worn, auras: self.auras, classTag: self.tag
    })
  }

  // What the slot's item gives the stat whose tooltip is open; empty while it gives none.
  shareOf(self, slot: Integer): String { return self.shown.shares[slot] ?? "" }

  onTipped(mut self, stat: Stat | nil) { self.tipped = stat }

  levelOf(self): String {
    const level = averageLevel(self.worn)
    return level == nil ? "" : Locale.ITEM_LEVEL.format("%.1f".format(level))
  }

  // What a resource regains on its bar: mana every five seconds outside casting, energy a second; rage none.
  regenOf(self, resource: Resource): String {
    return match (resource) {
      .Mana => Locale.REGEN_FIVE.format(self.stats.restingRegen.floor())
      .Energy => Locale.REGEN_SECOND.format(self.stats.energyRegen.floor())
      else => ""
    }
  }

  wornOf(self, slot: Integer): Worn {
    return self.worn.find(piece => piece.slot == slot) ?? NOTHING
  }

  fitsIn(self, slot: Integer): Boolean { return self.fitsSlots.any(s => s == slot) }

  onPicked(self, slot: Integer) { self.picked.emit(slot) }
  onTried(self, slot: Integer) { self.tried.emit(slot) }
  onFlyout(self, slot: Integer) { self.flyout.emit(slot) }
  onChose(self, item: Integer) { self.chose.emit(item) }
  onCloseFlyout(self) { self.closeFlyout.emit() }
  onUseSet(self, id: Integer) { self.useSet.emit(id) }
  onSaveSet(self) { self.saveSet.emit() }

  public render(self): Template {
    return $ltml {
      <box rows={["max-content", { fr: 1 }]} gap={3sp}>
        <GearSets $if={self.own} sets={self.sets} @use={self.onUseSet} @save={self.onSaveSet} />
        <box columns={Style.COLUMNS} rows={[{ fr: 1 }]} gap={6sp}>
          <box gap={2.5sp}>
            <box gap={2sp} padding={Style.SECTION_PAD}>
              <box gap={0.5sp}>
                <text value={self.fullName} textSize={TITLE_TEXT} lineHeight={TITLE_LINE} textFont={TextFont.Title} textColor={self.whoColor} />
                <text value={self.whoText} textSize={SECONDARY_TEXT} textColor={Style.DIM} />
              </box>
              <box gap={1sp}>
                <PoolBar amount={self.health} color={Style.HEALTH} stat={Stat.Health} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
                <PoolBar amount={self.power} color={self.powerTint} regen={self.powerRegen} filled={self.powerFilled}
                         stat={self.powerStat} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
                <PoolBar $if={self.energyShown} amount={self.energy} color={Style.ENERGY} regen={self.energyRegen} />
              </box>
            </box>
            <Cut title={Locale.SECTION_DEFENSE} />
            <box gap={2sp} padding={Style.SECTION_PAD}>
              <box columns={6} gap={2sp} padding={Style.RESIST_PAD}>
                <ResistColumn $for={resist of self.resists} resist={resist} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
              </box>
              <box gap={1.5sp}>
                <StatGauge $for={g of self.defence} gauge={g} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
              </box>
              <box gap={0.5sp}>
                <StatRow $for={row of self.blocked} row={row} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
              </box>
            </box>
            <Cut />
            <box gap={0.5sp} padding={Style.SECTION_PAD}>
              <StatRow $for={row of self.speeds} row={row} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
            </box>
          </box>
          <box columns={[Style.CUT, { fr: 1 }, Style.CUT]} rows={[{ fr: 1 }]}>
            <Groove upright={true} />
            <box columns={self.dollColumns} rows={[{ fr: 1 }]} gap={3sp} padding={Style.DOLL_PAD}
                 background={Style.MODEL_BACK} overflow={Overflow.Hidden}>
              <box $if={self.scene != nil} position={Position.Absolute} left={Style.SCENE_LEFT} top={0ui}
                   width={Style.SCENE_WIDTH} bottom={0ui} background={self.scene} desaturate={true} />
              <box position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} background={Style.SCENE_VEIL}
                   zLevel={1} />
              <box position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} model={self.unit}
                   zLevel={2} />
              <box rows={Style.SLOT_ROWS} zLevel={3}>
                <GearSlot $for={spec of LEFT} spec={spec} worn={self.wornOf(spec.id)} levels={self.choices.itemLevels}
                          wear={self.choices.durability} fits={self.fitsIn(spec.id)} share={self.shareOf(spec.id)} size={self.slot} own={self.own} @picked={self.onPicked}
                          @tried={self.onTried} @flyout={self.onFlyout} />
              </box>
              <box rows={[{ fr: 1 }, "max-content", "max-content"]} gap={3sp} zLevel={3}>
                <box yAlign={Align.End}>
                  <Flyout $if={self.flyoutShown} items={self.fitting} @chose={self.onChose} @close={self.onCloseFlyout} />
                </box>
                <box columns={{ each: "max-content" }} gap={2sp} xAlign={Align.Center} yAlign={Align.Start}>
                  <GearSlot $for={spec of WEAPONS} spec={spec} worn={self.wornOf(spec.id)} levels={self.choices.itemLevels}
                            wear={self.choices.durability} fits={self.fitsIn(spec.id)} share={self.shareOf(spec.id)} size={self.slot} own={self.own} @picked={self.onPicked}
                            @tried={self.onTried} @flyout={self.onFlyout} />
                  <GearSlot $if={self.usesAmmo} spec={AMMO} worn={self.wornOf(AMMO.id)} levels={false} wear={false}
                            fits={self.fitsIn(AMMO.id)} size={AMMO_SIZE} @picked={self.onPicked} />
                </box>
                <text value={self.levelText} textSize={SECONDARY_TEXT} textColor={Style.DIM} xAlignSelf={Align.Center} />
              </box>
              <box rows={Style.SLOT_ROWS} zLevel={3}>
                <GearSlot $for={spec of RIGHT} spec={spec} worn={self.wornOf(spec.id)} levels={self.choices.itemLevels}
                          wear={self.choices.durability} fits={self.fitsIn(spec.id)} share={self.shareOf(spec.id)} size={self.slot} own={self.own} @picked={self.onPicked}
                          @tried={self.onTried} @flyout={self.onFlyout} />
              </box>
            </box>
            <Groove upright={true} />
          </box>
          <box>
            <box gap={2.5sp}>
              <box columns={5}>
                <MainStat $for={main of self.mains} main={main} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
              </box>
              <Cut />
              <box gap={1.5sp} padding={Style.SECTION_PAD}>
                <StatGauge $for={g of self.shared} gauge={g} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
                <StatRow $for={row of self.sharedLines} row={row} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
              </box>
              <SectionView $for={section of self.sections} section={section} shown={self.shown} boosts={self.boosts} @tipped={self.onTipped} />
            </box>
          </box>
        </box>
      </box>
    }
  }
}
