// GaugeBar: the character window's gauge, one look for the stats' gauges, the resistances', the skills' and the
// reputation's bars (the health and mana tubes are another kind). A well carved through the wood down to the marble
// the tab lies on: the game's marble its floor, a black line round it, a shade under its top edge and a lit lip along
// its bottom. The fill runs from the left (from the bottom, `vertical`) to the value's share, the client's own status
// bar texture in the gauge's tone, a gloss over its upper (left) half; its text stands in the middle over all of it,
// outlined. The fill is a grid's track, its share of the well, so it never stands past the well.
import { Align, Line, Position, Shadow, TextFont, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, Component, SECONDARY_TEXT } from "Ordaen"

// The client's classic status bar, white to grey down its height: tinted, a lit and shaded bar in one colour.
const TEXTURE: Asset = "Interface/TargetingFrame/UI-StatusBar"
const EDGE: Line = { width: 1.171875dp, color: Color.hex("#000000") }
const SHADE: Color = Color.hex("#000000a6")
const SHADE_HEIGHT = 2.34375dp
const LIP: Color = Color.hex("#ffdeaa30")
const LIP_HEIGHT = 1.171875dp
const GLOSS: Color = Color.hex("#ffffff1f")
const TEXT_SHADOW: Shadow = { color: Color.hex("#000000"), x: 1.171875dp, y: -1.171875dp }
const ONE: Array<Track> = [{ fr: 1 }]

// A carve-out's line round it: on a box whose floor is the marble, with `CarveShade` inside (the stats' cards too).
public const CARVED_EDGE: Line = EDGE

// The carve's light inside a box cut through the wood: the shade under its top edge, the lit lip along its bottom.
public class CarveShade implements Component {
  public render(self): Template {
    return $ltml {
      <box position={Position.Absolute} left={0ui} top={0ui} right={0ui} height={SHADE_HEIGHT} background={SHADE} />
      <box position={Position.Absolute} left={0ui} right={0ui} bottom={0ui} height={LIP_HEIGHT} background={LIP} />
    }
  }
}

// The well's two tracks: the fill's share and the rest; down it, the rest over the fill.
function sharesOf(value: Number, vertical: Boolean): Array<Track> {
  const share = value.max(0).min(1)
  return vertical ? [{ fr: 1 - share }, { fr: share }] : [{ fr: share }, { fr: 1 - share }]
}

public class GaugeBar implements Component {
  derived shares: Array<Track> = sharesOf(self.value, self.vertical)
  derived columns: Array<Track> = self.vertical ? ONE : self.shares
  derived rows: Array<Track> = self.vertical ? self.shares : ONE
  derived glossHeight: Number<Length> | nil = self.vertical ? nil : self.height / 2
  derived glossBottom: Number<Length> | nil = self.vertical ? 0ui : nil
  derived glossWidth: Number<Length> | nil = self.vertical ? (self.width ?? 0ui) / 2 : nil
  derived glossRight: Number<Length> | nil = self.vertical ? nil : 0ui
  derived hasText: Boolean = self.text != ""

  value: Signal<Number>
  tone: Signal<Color>
  height: Signal<Number<Length>>
  text: Signal<String>
  font: Signal<TextFont>
  vertical: Signal<Boolean>
  width: Signal<Number<Length> | nil>
  constructor(
    // How full, from 0 to 1.
    value: Signal<Number>,
    tone: Signal<Color>,
    height: Signal<Number<Length>>,
    // In its middle; none: no text. In the numbers' font unless it is words (a standing's name).
    text: Signal<String> = "",
    font: Signal<TextFont> = TextFont.Numbers,
    // Filled from the bottom up (a resistance's column), its `width` given; else from the left, as wide as it is given.
    vertical: Signal<Boolean> = false,
    width: Signal<Number<Length> | nil> = nil
  ) {
    self.value = value
    self.tone = tone
    self.height = height
    self.text = text
    self.font = font
    self.vertical = vertical
    self.width = width
  }

  public render(self): Template {
    return $ltml {
      <box width={self.width} height={self.height} background={Ordaen.art.window.marble} border={EDGE}
           columns={self.columns} rows={self.rows}>
        <box $if={self.vertical} />
        <box background={TEXTURE} tint={self.tone} />
        <box $if={!self.vertical} />
        <box position={Position.Absolute} left={0ui} top={0ui} right={self.glossRight} bottom={self.glossBottom}
             width={self.glossWidth} height={self.glossHeight} background={GLOSS} />
        <CarveShade />
        <box $if={self.hasText} position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             xAlign={Align.Center} yAlign={Align.Center}>
          <text value={self.text} textSize={SECONDARY_TEXT} textColor={BRIGHT_TEXT} leading={.Tight} textFont={self.font}
                textOutline={1} textShadow={TEXT_SHADOW} wrap={.None} />
        </box>
      </box>
    }
  }
}
