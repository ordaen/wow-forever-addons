// What the character window shows of the player's character, and what its clicks ask of the game: the slots and what
// is worn in them, the stats, the factions and the skills. `"$game"` has no part for these yet (what it should gain:
// the module's report), so `Sheet` is the window's one door to them: `ClientSheet` reads the client, a test hands
// its own.
import Client from "$client"
import Game from "$game"
import { FillDuration } from "$ltml"
import Runtime from "$runtime"
import { Quality, qualityFrom } from "Ordaen"
import { FlatWord, ItemLine, LineWords, WornSet, bonusesOf } from "@/lines"
import Locale from "@/locales"
import { Given, ITEM_KEYS, MAINS } from "@/stat"

// A slot of the paper doll: the client's number for it, the art of its well while nothing is worn there, and the
// name of the client's text that names it (its tooltip while it is empty).
public struct SlotSpec {
  const id: integer
  const empty: Asset
  const name: string
}

// The slots as the game's paper doll stands them: eight down the left, eight down the right, the weapons along the
// bottom with the ammo's after the ranged one.
public const LEFT: array<SlotSpec> = [
  { id: 1, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Head", name: "HEADSLOT" },
  { id: 2, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Neck", name: "NECKSLOT" },
  { id: 3, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Shoulder", name: "SHOULDERSLOT" },
  { id: 15, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Chest", name: "BACKSLOT" },
  { id: 5, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Chest", name: "CHESTSLOT" },
  { id: 4, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Shirt", name: "SHIRTSLOT" },
  { id: 19, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Tabard", name: "TABARDSLOT" },
  { id: 9, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Wrists", name: "WRISTSLOT" }
]
public const RIGHT: array<SlotSpec> = [
  { id: 10, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Hands", name: "HANDSSLOT" },
  { id: 6, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Waist", name: "WAISTSLOT" },
  { id: 7, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Legs", name: "LEGSSLOT" },
  { id: 8, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Feet", name: "FEETSLOT" },
  { id: 11, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Finger", name: "FINGER0SLOT" },
  { id: 12, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Finger", name: "FINGER1SLOT" },
  { id: 13, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Trinket", name: "TRINKET0SLOT" },
  { id: 14, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Trinket", name: "TRINKET1SLOT" }
]
public const WEAPONS: array<SlotSpec> = [
  { id: 16, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-MainHand", name: "MAINHANDSLOT" },
  { id: 17, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-SecondaryHand", name: "SECONDARYHANDSLOT" },
  { id: 18, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Ranged", name: "RANGEDSLOT" }
]
// The weapons of a class that keeps a relic in the ranged slot: its well and its name the relic's, as the game's paper
// doll draws it (`checkRelic` and `UnitHasRelicSlot`).
public const RELIC_WEAPONS: array<SlotSpec> = [
  { id: 16, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-MainHand", name: "MAINHANDSLOT" },
  { id: 17, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-SecondaryHand", name: "SECONDARYHANDSLOT" },
  { id: 18, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Relic", name: "RELICSLOT" }
]
public const AMMO: SlotSpec = { id: 0, empty: "Interface/PaperDoll/UI-PaperDoll-Slot-Ammo", name: "AMMOSLOT" }

// The time between two swings of both hands together: two hands swing 1/main + 1/off times a second.
public function swingOf(stats: Stats): number {
  const off = stats.offSpeed
  if (off == nil || off <= 0) { return stats.speed }
  return 1 / (1 / stats.speed + 1 / off)
}

// A hand's damage a second: its average hit over its seconds between hits; none without a weapon's speed.
public function handDps(min: number, max: number, speed: number): number {
  return speed <= 0 ? 0 : (min + max) / 2 / speed
}

// Both hands' damage a second together, and the ranged weapon's.
public function meleeDps(stats: Stats): number {
  return handDps(stats.minDamage, stats.maxDamage, stats.speed) + handDps(stats.offMinDamage, stats.offMaxDamage, stats.offSpeed ?? 0)
}
public function rangedDps(stats: Stats): number { return handDps(stats.rangedMinDamage, stats.rangedMaxDamage, stats.rangedSpeed) }
// The slots the items' level counts: every one but the shirt, the tabard and the ammo.
const SHIRT = 4
const TABARD = 19

// What is worn in a slot; `item` none for an empty one.
public struct Worn {
  const slot: integer
  const item: integer | nil
  const quality: Quality
  const level: integer | nil
  // What is left of it, from 0 to 1; none for what doesn't wear.
  const durability: number | nil
  // How many it holds (the ammo's), picked up or on its way somewhere (the client takes nothing of it), and the
  // cooldown it waits on since it was last used.
  const count: integer = 1
  const locked: boolean = false
  const cooldown: FillDuration | nil = nil
  // Its name, and the stats it gives (its stat tooltips' «Items»).
  const name: string = ""
  const gives: array<Given> = []
  // The set it is a piece of, with the bonuses in effect; none for an item of none.
  const set: WornSet | nil = nil
}

// What a point of a main stat is worth to the character, as the client works it out for its class and level: attack
// power a point of strength and of agility, ranged attack power a point of agility, and the crit a point of agility
// and the spell crit a point of intellect give, in percent.
public struct Conversions implements Plain {
  attackPerStrength: number = 0
  attackPerAgility: number = 0
  rangedPerAgility: number = 0
  critPerAgility: number = 0
  spellCritPerIntellect: number = 0
}

// One of the sets the game's equipment manager keeps: whether all of it is worn, and how many of its items are
// nowhere the player has them.
public struct GearSet {
  const id: integer
  const name: string
  const worn: boolean
  const missing: integer
}

// What the game's paper doll says of each stat as its tooltip's text, under the stat's name: the client's own words,
// filled with the player's numbers, where they tell what the window doesn't already show (what defense takes off a
// blow). Empty where the game says nothing more.
public struct StatTips {
  primary: array<string> = ["", "", "", "", ""]
  armor: string = ""
  attackPower: string = ""
  rangedAttackPower: string = ""
  defense: string = ""
  block: string = ""
  armorPenetration: string = ""
  spellPenetration: string = ""
  spellDamage: string = ""
  healing: string = ""
}

// Who the character is, as the paper doll's top says it: its name and its surname where Forever gives it one;
// `scene` its race as the client names its files (`Dwarf`, `NightElf`, `Scourge`): the scene the model stands in.
public struct Who {
  const name: string
  const surname: string = ""
  const level: integer
  const race: string
  const className: string
  const scene: string = ""
}

// What the character's resource bar holds.
public enum Resource implements Plain { Mana = "Mana", Rage = "Rage", Energy = "Energy", Focus = "Focus" }

// The character's stats as the client works them out, with every buff and item counted.
public struct Stats {
  strength: integer = 0
  agility: integer = 0
  stamina: integer = 0
  intellect: integer = 0
  spirit: integer = 0
  health: integer = 0
  power: integer = 0
  resource: Resource = Resource::Mana
  armor: integer = 0
  // Arcane, fire, frost, nature and shadow, in that order.
  resistances: array<integer> = [0, 0, 0, 0, 0]
  attackPower: integer = 0
  rangedAttackPower: integer = 0
  // The main hand's damage per hit and its seconds between hits; the off hand's where one is held.
  minDamage: number = 0
  maxDamage: number = 0
  speed: number = 0
  offSpeed: number | nil = nil
  // Chances in percent.
  meleeCrit: number = 0
  rangedCrit: number = 0
  spellCrit: number = 0
  hit: number = 0
  dodge: number = 0
  parry: number = 0
  block: number = 0
  spellDamage: integer = 0
  healing: integer = 0
  // Mana every five seconds while casting.
  regen: number = 0
  // Mana every five seconds outside casting: the mana bar's regeneration.
  restingRegen: number = 0
  // Health every five seconds out of a fight and in one; what spirit gives of health's and of mana's (standing, as
  // the game's own sheet counts it).
  healthRegen: number = 0
  combatHealthRegen: number = 0
  healthFromSpirit: number = 0
  manaFromSpirit: number = 0
  // The class keeps a relic where others keep a ranged weapon (a paladin's libram, a druid's idol, a shaman's totem).
  relic: boolean = false
  // At the game's greatest level: what lands is counted against a raid's boss, else against a target of its level.
  atMaxLevel: boolean = false
  // The five main stats' base, without what buffs and items add or take: the tooltip's «312 (300+12)».
  bases: array<integer> = [0, 0, 0, 0, 0]
  tips: StatTips = {}
  // Hit by kind, in percent: the one rating's share plus what talents and items give that kind, as the game's own
  // sheet adds them.
  meleeHit: number = 0
  rangedHit: number = 0
  spellHit: number = 0
  // The boss's dodge taken away, in percent; armor penetration and spell penetration as the client counts them.
  expertise: number = 0
  armorPenetration: integer = 0
  spellPenetration: integer = 0
  // The defense skill with its bonus, the damage a block stops, and the share of a level 63 boss's blows armor stops.
  defense: integer = 0
  blockValue: integer = 0
  armorReduction: number = 0
  // Each school's spell damage: holy, fire, nature, frost, shadow and arcane, the client's schools 2 to 7.
  schoolDamage: array<integer> = [0, 0, 0, 0, 0, 0]
  // The off hand's damage per hit, and the ranged weapon's with its seconds between shots.
  offMinDamage: number = 0
  offMaxDamage: number = 0
  rangedMinDamage: number = 0
  rangedMaxDamage: number = 0
  rangedSpeed: number = 0
  // A druid's energy beside its mana (none for the others) and what it regains a second.
  energy: integer = 0
  energyRegen: number = 0
  // Running and swimming, in percent of the game's base speeds.
  runSpeed: number = 100
  swimSpeed: number = 100
  // The skill line of what each hand and the ranged slot hold (`SkillLineAttributes.skillID`), none where nothing is
  // held or the ranged slot holds a relic.
  mainSkill: integer | nil = nil
  offSkill: integer | nil = nil
  rangedSkill: integer | nil = nil
  // The main hand's and the ranged weapon's skill past the level's (five a level), and a raid boss's defense (its level
  // 63's) past the level's: each point of skill past a target's defense takes 0.04% off its misses, dodges and parries
  // and adds as much to crit, as the game's skills frame counts it.
  meleeSkillPast: number = 0
  offSkillPast: number = 0
  rangedSkillPast: number = 0
  bossDefensePast: number = 15
  // The chance a swing of the main hand glances, and how much less a glancing blow deals, in percent: against a raid
  // boss, and against a target of the player's level.
  bossGlancing: number = 0
  levelGlancing: number = 0
  bossGlancingPenalty: number = 0
  levelGlancingPenalty: number = 0
  // Haste in percent, as the game's paper doll shows each: the melee swings', the ranged shots' (the ammo's with it),
  // the spells'.
  meleeHaste: number = 0
  rangedHaste: number = 0
  spellHaste: number = 0
  // A shield in the off hand: what blocks.
  shield: boolean = false
  // How much less physical damage the armor lets through from a raid boss, in percent (`armorReduction` a target's of
  // the player's level).
  bossArmorReduction: number = 0
  // The defense skill past the level's (five a level; below it, less than nothing).
  defensePast: number = 0
  conversions: Conversions = {}
}

// The client's skill line of each weapon kind, by the item's subclass (`WEAPON_SUBCLASS_TO_SKILL_ID`).
const WEAPON_SKILLS: map<integer, integer> = {
  [0]: 44, [1]: 172, [2]: 45, [3]: 46, [4]: 54, [5]: 160, [6]: 229, [7]: 43, [8]: 55, [10]: 136, [13]: 473, [15]: 173,
  [16]: 176, [18]: 226, [19]: 228
}
// The wands' skill line: a wand's damage is its own, no attack power counts in it.
public const WANDS = 228
// The client's item class of weapons.
const WEAPON_CLASS = 2
// The client's item class of armor, and its subclass of shields.
const ARMOR_CLASS = 4
const SHIELDS = 6
// The combat ratings' numbers for hit (`CR_HIT_MELEE`, `CR_HIT_RANGED`, `CR_HIT_SPELL`).
const RATING_HIT_MELEE = 6
const RATING_HIT_RANGED = 7
const RATING_HIT_SPELL = 8
// Energy's number among the client's powers (`Enum.PowerType.Energy`), which `GetPowerRegenForPowerType` takes as a
// plain number.
const ENERGY_POWER = 3
// The game's base speeds, yards a second.
const RUN_BASE = 7
const SWIM_BASE = 4.722222

// A row of the game's reputation list: a group's heading, or a faction with its standing (1 hated to 8 exalted) and
// where it is between the standing's start and its end. `index` is the client's place of the row in its list as it
// stands now: folding a group moves the rows after it.
public struct Faction {
  const index: integer
  const id: integer
  const name: string
  const description: string
  const standing: integer
  const value: integer
  const min: integer
  const max: integer
  const header: boolean
  // A heading that has a standing of its own.
  const ranked: boolean
  const child: boolean
  const collapsed: boolean
  const atWar: boolean
  const canToggleAtWar: boolean
  const canSetInactive: boolean
  const watched: boolean
}

// A row of the game's skill list: a heading, which folds, or a skill with its rank, the bonus on it and the cap for the
// level, the game's description, and whether the player may unlearn it (a profession, a secondary skill).
public struct Skill {
  // The client's skill line (`skillID`): what a weapon's kind names.
  const id: integer = 0
  // Its place in the game's list, which folds and unfolds by it.
  const index: integer = 0
  const name: string
  const header: boolean
  const collapsed: boolean = false
  const rank: integer
  const modifier: integer
  const max: integer
  const description: string = ""
  const abandonable: boolean = false
}

public trait Sheet {
  public worn(slot: integer): Worn
  public usesAmmo(): boolean
  public who(): Who
  // The player's statistics; none while the client holds them secret (in a fight where secrets apply).
  public stats(): Stats | nil
  public factions(): array<Faction>
  // Whether a faction of the list is inactive: asked of the one the player picks.
  public inactive(index: integer): boolean
  public skills(): array<Skill>
  // A heading of the skills, by its place, unfolded (`open`) or folded, as the game keeps it; a skill unlearned.
  public mut foldSkills(index: integer, open: boolean)
  public mut unlearn(skill: integer)
  // The slot clicked as the game's own slot is: what the cursor holds is equipped there, or what is worn there is
  // taken onto the cursor (to the bags, the bars, another slot).
  public mut pickup(slot: integer)
  // Whether what the cursor holds goes in the slot: the slot is lit, as the game's is.
  public fits(slot: integer): boolean
  // What is worn there tried on in the dressing room, as Ctrl+Left-click does.
  public mut tryOn(slot: integer)
  // What the bags hold that the slot takes (the game's flyout, Alt), by the items' numbers, and one of them put on.
  public fitting(slot: integer): array<integer>
  public mut equip(item: integer, slot: integer)
  // The equipment manager's sets, one put on, and what is worn saved as a new one.
  public sets(): array<GearSet>
  public mut useSet(id: integer)
  public mut saveSet(name: string)
  public mut fold(index: integer, open: boolean)
  public mut watchFaction(index: integer, on: boolean)
  public mut toggleAtWar(index: integer)
  public mut setInactive(index: integer, inactive: boolean)
}

function levelCounts(slot: integer): boolean { return slot != SHIRT && slot != TABARD && slot != AMMO.id }

// What is worn in the slots the items' level counts, each with its level, the highest first.
public function levelledItems(worn: array<Worn>): array<Worn> {
  const levelled = worn.filter(piece => piece.item != nil && piece.level != nil && levelCounts(piece.slot))
  levelled.sort((a, b) => (a.level ?? 0) > (b.level ?? 0))
  return levelled
}

// The median of their levels (`levelledItems`): the middle one, or halfway between the two in the middle; none while
// nothing is worn. One item far above or below the rest (a quest's weapon) moves it no more than any other.
public function medianLevel(levelled: array<Worn>): number | nil {
  const count = levelled.length
  if (count == 0) { return nil }
  const upper = levelled[((count + 1) / 2).floor()]?.level ?? 0
  const lower = levelled[(count / 2).floor() + 1]?.level ?? 0
  return (upper + lower) / 2
}

function resistanceOf(school: Client::Damageclass): integer {
  let (_, value, _, _) = Client::UnitResistance("player", school)
  return value.floor()
}

function resourceOf(kind: Client::PowerType | nil): Resource {
  return match (kind) {
    .Rage => .Rage
    .Energy => .Energy
    .Focus => .Focus
    else => .Mana
  }
}

// What the game's paper doll writes under a stat's value: its base and what buffs and items add and take («300+12»);
// empty where nothing does.
function breakdown(natural: integer, up: integer, down: integer): string {
  if (up == 0 && down == 0) { return "" }
  let text = string::of(natural)
  if (up > 0) { text += `+${up}` }
  if (down < 0) { text += string::of(down) }
  return text
}

// One of the client's own texts by its name; empty where it has none.
function said(key: string): string {
  return Runtime::text(key) ?? ""
}

// The skill line of the weapon a slot holds; none for an empty slot or what is no weapon (a shield, a book).
// A skill line's rank with its bonus, none where the player hasn't it.
function skillValue(id: integer | nil): integer | nil {
  if (id == nil) { return nil }
  for (index of 1..Client::C_SkillInfo::GetNumSkillLines()) {
    const data = Client::C_SkillInfo::GetSkillLineInfo(index)
    if (data != nil && data.skillID.floor() == id) { return (data.rank + data.modifier).floor() }
  }
  return nil
}

// Whether the off hand holds a shield.
function shieldWorn(): boolean {
  const id = Client::GetInventoryItemID("player", 17)
  if (id == nil) { return false }
  let (_, _, _, _, _, kind, subclass) = Client::C_Item::GetItemInfoInstant(id.floor())
  return kind == ARMOR_CLASS && subclass == SHIELDS
}

function weaponSkill(slot: integer): integer | nil {
  const id = Client::GetInventoryItemID("player", slot)
  if (id == nil) { return nil }
  let (_, _, _, _, _, kind, subclass) = Client::C_Item::GetItemInfoInstant(id.floor())
  if (kind != WEAPON_CLASS || subclass == nil) { return nil }
  return WEAPON_SKILLS[subclass.floor()]
}

// The stats an item gives, by its link, in each stat's own unit: a rating as the percentage it makes at the
// character's level.
// The client's numbers of the main stats (`LE_UNIT_STAT_*`).
const STRENGTH = 1
const AGILITY = 2
const INTELLECT = 4

// The start of a line the client writes with a format, its text before the format's `%s` («Чары: »).
function startOf(format: string | nil): string {
  if (format == nil) { return "" }
  const start = format.match("^(.-)%%s")
  return start ?? ""
}

// The words the client's lines are told by, in the client's language: its own names of the item stats, and this
// addon's words for what the client names nowhere (armor and every stat as a bonus says them, a chance's stem).
public function clientWords(): LineWords {
  const flat: array<FlatWord> = mut [
    { label: Locale::WORD_ARMOR, stats: [.Armor] },
    { label: Locale::WORD_ALL_STATS, stats: MAINS }
  ]
  for (key, known of ITEM_KEYS) {
    const label = Runtime::text(key)
    if (known.rating == 0 && label != nil) { flat.push({ label: label, stats: known.stats }) }
  }
  return {
    enchant: startOf(Runtime::text("ENCHANTED_TOOLTIP_LINE")),
    setBonus: startOf(Runtime::text("ITEM_SET_BONUS")),
    flat: flat,
    chances: [
      { stem: Locale::WORD_HIT, stats: [.MeleeHit, .RangedHit], spells: [.SpellHit] },
      { stem: Locale::WORD_CRIT, stats: [.MeleeCrit, .RangedCrit], spells: [.SpellCrit] },
      { stem: Locale::WORD_DODGE, stats: [.Dodge] },
      { stem: Locale::WORD_PARRY, stats: [.Parry] },
      { stem: Locale::WORD_BLOCK, stats: [.Block] }
    ],
    spells: Locale::WORD_SPELLS,
    shieldBlock: Runtime::text("SHIELD_BLOCK_TEMPLATE") ?? ""
  }
}

// The lines of the tooltip of the item a unit wears in a slot, in order.
function linesOf(unit: string, slot: integer): array<ItemLine> {
  const lines: array<ItemLine> = mut []
  const data = Client::C_TooltipInfo::GetInventoryItem(unit, slot, nil)
  if (!(data is Table)) { return lines }
  const raw = data["lines"]
  if (!(raw is Table)) { return lines }
  for (index of 1..raw.length) {
    const line = raw[index]
    if (line is Table) {
      const text = line["leftText"]
      const kind = line["type"]
      if (text is string && kind is number) { lines.push({ text: text, kind: kind.floor() }) }
    }
  }
  return lines
}

function givenBy(link: string | nil): array<Given> {
  const gives: array<Given> = mut []
  if (link == nil) { return gives }
  const table = Client::C_Item::GetItemStats(link)
  if (table is Table) {
    for (key, value of table) {
      if (key is string && value is number) {
        const known = ITEM_KEYS[key]
        if (known != nil) {
          const amount = known.rating == 0 ? value : Client::GetCombatRatingBonusForCombatRatingValue(known.rating, value) ?? value
          for (stat of known.stats) { gives.push({ stat: stat, amount: amount }) }
        }
      }
    }
  }
  return gives
}

// What a unit wears in a slot, as any unit's can be read (the player's, or the player inspected once the server
// answered): the item, its name, quality and level, and what it gives with its enchant and its set.
public function wornBy(unit: string, slot: integer, words: LineWords): Worn {
  const id = Client::GetInventoryItemID(unit, slot)
  if (id == nil) { return { slot: slot, item: nil, quality: Quality::Common, level: nil, durability: nil } }
  const item = id.floor()
  let (name, _, quality, level, _, _, _, _, _, _, _, _, _, _, _, _, _, _) = Client::C_Item::GetItemInfo(item)
  const bonuses = bonusesOf(linesOf(unit, slot), words)
  const gives: array<Given> = mut []
  for (given of givenBy(Client::GetInventoryItemLink(unit, slot))) { gives.push(given) }
  for (given of bonuses.base) { gives.push(given) }
  for (given of bonuses.enchant) { gives.push(given) }
  return {
    slot: slot, item: item, quality: qualityFrom(quality), level: level?.floor(), durability: nil, name: name ?? "",
    gives: gives, set: bonuses.set
  }
}

// Attack power a point of damage per second takes, as the game's tooltip divides it (`ATTACK_POWER_MAGIC_NUMBER`).
const ATTACK_POWER_PER_DPS = 14

// The schools a spell's damage counts: holy to arcane, as the client numbers them.
const FIRST_SCHOOL = 2
const LAST_SCHOOL = 7
// What spirit gives of health while standing, as the game's sheet takes it (`spiritStandingPenalty`).
const SPIRIT_STANDING = 0.75
// A level's defense skill (`SKILL_RANKS_PER_SKILL_LEVEL`), and what a point past it takes off a blow's chances, in
// percent (`STAT_PER_DEFENSE`).
const DEFENSE_PER_LEVEL = 5
// A raid boss's level, as the game's skills frame counts against it (`RAID_BOSS_LEVEL`).
const RAID_BOSS_LEVEL = 63
const DEFENSE_SHARE = 0.04

// The sheet read from the client, each time it is asked.
public class ClientSheet implements Sheet {
  // The client's words for the lines of an item's tooltip: read once, as they don't change while it runs.
  const words: LineWords = clientWords()

  // What anyone's slot says, and what only the player's own does: its wear, how many, whether it is locked, its
  // cooldown.
  public worn(slot: integer): Worn {
    const piece = wornBy("player", slot, self.words)
    if (piece.item == nil) { return piece }
    let (left, most) = Client::GetInventoryItemDurability(slot)
    let (start, length, _) = Client::GetInventoryItemCooldown("player", slot)
    return {
      slot: slot,
      item: piece.item,
      quality: piece.quality,
      level: piece.level,
      durability: left != nil && most != nil && most > 0 ? left / most : nil,
      count: Client::GetInventoryItemCount("player", slot).floor(),
      locked: Client::IsInventoryItemLocked(slot),
      cooldown: length > 0 ? { start: start, length: length } : nil,
      name: piece.name,
      gives: piece.gives,
      set: piece.set
    }
  }

  public fits(slot: integer): boolean { return Client::C_PaperDollInfo::CursorCanGoInSlot(slot) }

  public mut tryOn(slot: integer) {
    const link = Client::GetInventoryItemLink("player", slot)
    if (link != nil) { _ = Client::DressUpItemLink(link) }
  }

  public fitting(slot: integer): array<integer> {
    const found: map<integer, integer> = mut {}
    _ = Client::GetInventoryItemsForSlot(slot, found)
    const items: array<integer> = mut []
    for (_, item of found) {
      if (!items.any(i => i == item)) { items.push(item) }
    }
    return items
  }

  // In the player's click alone, as the game's flyout does it.
  public mut equip(item: integer, slot: integer) { Client::C_Item::EquipItemByName(item, slot) }

  public sets(): array<GearSet> {
    const sets: array<GearSet> = mut []
    for (id of Client::C_EquipmentSet::GetEquipmentSetIDs()) {
      let (name, _, _, worn, _, _, _, lost, _) = Client::C_EquipmentSet::GetEquipmentSetInfo(id)
      if (name != nil) {
        sets.push({
          id: id.floor(),
          name: name,
          worn: worn == true,
          missing: (lost ?? 0).floor()
        })
      }
    }
    return sets
  }

  // In the player's click alone: the client refuses it in a fight, which the window says before.
  public mut useSet(id: integer) { _ = Client::C_EquipmentSet::UseEquipmentSet(id) }

  public mut saveSet(name: string) { Client::C_EquipmentSet::CreateEquipmentSet(name, nil) }

  public usesAmmo(): boolean { return Client::UnitUsesAmmo("player") }

  public who(): Who {
    let (race, scene, _) = Client::UnitRace("player")
    let (className, _, _) = Client::UnitClass("player")
    return {
      name: Game::player.name, surname: Game::player.surname ?? "", level: peek Game::player.level, race: race ?? "",
      className: className ?? "", scene: scene ?? ""
    }
  }

  public stats(): Stats | nil {
    if (Client::C_Secrets::ShouldUnitStatsBeSecret()) { return nil }
    let (base, positive, negative) = Client::UnitAttackPower("player")
    let (rangedBase, rangedPositive, rangedNegative) = Client::UnitRangedAttackPower("player")
    let (_, armor, _, _) = Client::UnitArmor("player")
    let (minDamage, maxDamage, _, _, _, _, _) = Client::UnitDamage("player")
    let (speed, offSpeed, _) = Client::UnitAttackSpeed("player")
    let (resting, casting) = Client::GetManaRegen()
    let (kind, token, _, _, _) = Client::UnitPowerType("player", nil)
    let spellDamage: number = 0
    for (school of FIRST_SCHOOL..LAST_SCHOOL) { spellDamage = spellDamage.max(Client::GetSpellBonusDamage(school) ?? 0) }
    const attackPower = (base + positive + negative).floor()
    const rangedAttackPower = (rangedBase + rangedPositive + rangedNegative).floor()
    const healing = Client::GetSpellBonusHealing().floor()
    const block = Client::GetBlockChance()
    const hit = Client::GetHitModifier()
    const primary: array<integer> = mut []
    const bases: array<integer> = mut []
    const primaryTips: array<string> = mut []
    for (index of 1..5) {
      let (natural, effective, up, down) = Client::UnitStat("player", index)
      primary.push(effective.floor())
      bases.push(natural.floor())
      primaryTips.push(breakdown(natural.floor(), up.floor(), down.floor()))
    }
    const attackTip = Runtime::text(`${Game::player.classTag}_MELEE_ATTACK_POWER_TOOLTIP`) ?? said("MELEE_ATTACK_POWER_TOOLTIP")
    const reduction = Client::C_PaperDollInfo::GetArmorEffectiveness(armor, Client::UnitEffectiveLevel("player")) * 100
    let (_, _, offMin, offMax, _, _, _) = Client::UnitDamage("player")
    let (rangedSpeed, rangedMin, rangedMax, _, _, _) = Client::UnitRangedDamage("player")
    let (defenseBase, defenseBonus) = Client::UnitDefenseSkill("player")
    let (expertise, _, _) = Client::GetExpertise()
    let (_, runSpeed, _, swimSpeed) = Client::GetUnitSpeed("player")
    let (energyRegen, _) = Client::GetPowerRegenForPowerType(ENERGY_POWER)
    const schoolDamage: array<integer> = mut []
    for (school of FIRST_SCHOOL..LAST_SCHOOL) { schoolDamage.push((Client::GetSpellBonusDamage(school) ?? 0).floor()) }
    const relic = Client::UnitHasRelicSlot("player")
    let (healthRegen, combatHealthRegen) = Client::GetHealthRegen()
    let (healthFromSpirit, _) = Client::GetHealthRegenFromSpirit()
    let (manaFromSpirit, _) = Client::GetManaRegenFromSpirit()
    // What the game's sheet works out for its texts: the defense past the level's (each point takes 0.04% off a
    // blow's chances), and the resistance a point of spell penetration takes off, of the player's level.
    const level = Client::UnitLevel("player")
    const beyondDefense = (defenseBase + defenseBonus - level * DEFENSE_PER_LEVEL).max(0)
    const spellPenetration = Client::GetSpellPenetration().floor()
    const penetrated = spellPenetration * 0.75 / (level * DEFENSE_PER_LEVEL)
    const mainSkill = weaponSkill(16)
    const rangedSkill = relic ? nil : weaponSkill(18)
    const levelDefense = level * DEFENSE_PER_LEVEL
    const bossDefense = RAID_BOSS_LEVEL * DEFENSE_PER_LEVEL
    // Haste as the game's paper doll reads each: the melee's, the ranged weapon's with its ammo's, the spells'.
    const meleeHaste = Client::GetMeleeHaste()
    let (weaponHaste, ammoHaste) = Client::GetRangedHaste()
    const rangedHaste = weaponHaste + ammoHaste
    const spellHaste = Client::UnitSpellHaste("player")
    return {
      restingRegen: resting * 5,
      healthRegen: healthRegen * 5,
      combatHealthRegen: combatHealthRegen * 5,
      healthFromSpirit: healthFromSpirit * SPIRIT_STANDING * 5,
      manaFromSpirit: manaFromSpirit * 5,
      relic: relic,
      atMaxLevel: level >= Client::GetMaxPlayerLevel(),
      meleeHit: (Client::GetCombatRatingBonus(RATING_HIT_MELEE) ?? 0) + hit,
      rangedHit: (Client::GetCombatRatingBonus(RATING_HIT_RANGED) ?? 0) + Client::GetRangedHitModifier(),
      spellHit: (Client::GetCombatRatingBonus(RATING_HIT_SPELL) ?? 0) + Client::GetSpellHitModifier(),
      expertise: expertise,
      armorPenetration: Client::GetArmorPenetration().floor(),
      spellPenetration: Client::GetSpellPenetration().floor(),
      defense: (defenseBase + defenseBonus).floor(),
      blockValue: Client::GetShieldBlock().floor(),
      armorReduction: reduction,
      schoolDamage: schoolDamage,
      offMinDamage: offMin,
      offMaxDamage: offMax,
      rangedMinDamage: rangedMin,
      rangedMaxDamage: rangedMax,
      rangedSpeed: rangedSpeed,
      energy: Game::player.classTag == "DRUID" ? Client::UnitPowerMax("player", Client::PowerType::Energy, nil).floor() : 0,
      energyRegen: energyRegen,
      runSpeed: runSpeed / RUN_BASE * 100,
      swimSpeed: swimSpeed / SWIM_BASE * 100,
      mainSkill: mainSkill,
      offSkill: weaponSkill(17),
      rangedSkill: rangedSkill,
      meleeSkillPast: (skillValue(mainSkill) ?? levelDefense) - levelDefense,
      offSkillPast: (skillValue(weaponSkill(17)) ?? levelDefense) - levelDefense,
      rangedSkillPast: (skillValue(rangedSkill) ?? levelDefense) - levelDefense,
      bossDefensePast: bossDefense - levelDefense,
      bossGlancing: Client::GetGlancingBlowChance(nil, bossDefense) * 100,
      levelGlancing: Client::GetGlancingBlowChance(nil, levelDefense) * 100,
      bossGlancingPenalty: Client::GetGlancingBlowPenalty(nil, bossDefense) * 100,
      levelGlancingPenalty: Client::GetGlancingBlowPenalty(nil, levelDefense) * 100,
      shield: shieldWorn(),
      bossArmorReduction: Client::C_PaperDollInfo::GetArmorEffectiveness(armor, RAID_BOSS_LEVEL) * 100,
      defensePast: defenseBase + defenseBonus - levelDefense,
      conversions: {
        attackPerStrength: Client::GetAttackPowerForStat(STRENGTH, 1),
        attackPerAgility: Client::GetAttackPowerForStat(AGILITY, 1),
        rangedPerAgility: Client::GetRangedAttackPowerForStat(AGILITY, 1),
        critPerAgility: Client::GetCritChanceFromStat(AGILITY, 1) * 100,
        spellCritPerIntellect: Client::GetSpellCritChanceFromStat(INTELLECT, 1) * 100
      },
      strength: primary[1] ?? 0,
      agility: primary[2] ?? 0,
      stamina: primary[3] ?? 0,
      intellect: primary[4] ?? 0,
      spirit: primary[5] ?? 0,
      bases: bases,
      health: Client::UnitHealthMax("player").floor(),
      power: Client::UnitPowerMax("player", nil, nil).floor(),
      resource: resourceOf(kind),
      armor: armor.floor(),
      resistances: [
        resistanceOf(.Arcane),
        resistanceOf(.Fire),
        resistanceOf(.Frost),
        resistanceOf(.Nature),
        resistanceOf(.Shadow)
      ],
      attackPower: attackPower,
      rangedAttackPower: rangedAttackPower,
      minDamage: minDamage,
      maxDamage: maxDamage,
      speed: speed,
      offSpeed: offSpeed,
      meleeCrit: Client::GetCritChance(),
      rangedCrit: Client::GetRangedCritChance(),
      spellCrit: Client::GetSpellCritChance(),
      hit: hit,
      meleeHaste: meleeHaste,
      rangedHaste: rangedHaste,
      spellHaste: spellHaste,
      dodge: Client::GetDodgeChance(),
      parry: Client::GetParryChance(),
      block: block,
      spellDamage: spellDamage.floor(),
      healing: healing,
      regen: casting * 5,
      tips: {
        primary: primaryTips,
        armor: said("STAT_ARMOR_TOOLTIP").format(reduction),
        attackPower: attackTip.format((attackPower / ATTACK_POWER_PER_DPS).max(0)),
        rangedAttackPower: said("RANGED_ATTACK_POWER_TOOLTIP").format((rangedAttackPower / ATTACK_POWER_PER_DPS).max(0)),
        defense: said("DEFAULT_STATDEFENSE_TOOLTIP").format(beyondDefense * DEFENSE_SHARE, beyondDefense * DEFENSE_SHARE),
        block: said("STAT_BLOCK_VALUE_FLAT_TOOLTIP").format(block, Client::GetShieldBlock()),
        armorPenetration: said("ARMOR_PENETRATION_TOOLTIP").format(Client::GetArmorPenetration().floor()),
        spellPenetration: said("SPELL_PENETRATION_TOOLTIP").format(spellPenetration, penetrated, penetrated / 2),
        spellDamage: said("STAT_SPELLPOWER_TOOLTIP").format(spellDamage.floor()),
        healing: said("STAT_SPELLHEALING_TOOLTIP").format(healing)
      }
    }
  }

  public factions(): array<Faction> {
    const rows: array<Faction> = mut []
    for (index of 1..Client::C_Reputation::GetNumFactions()) {
      const data = Client::C_Reputation::GetFactionDataByIndex(index)
      if (data != nil) {
        rows.push({
          index: index,
          id: data.factionID.floor(),
          name: data.name,
          description: data.description,
          standing: data.reaction,
          value: data.currentStanding.floor(),
          min: data.currentReactionThreshold.floor(),
          max: data.nextReactionThreshold.floor(),
          header: data.isHeader,
          ranked: data.isHeaderWithRep,
          child: data.isChild,
          collapsed: data.isCollapsed,
          atWar: data.atWarWith,
          canToggleAtWar: data.canToggleAtWar,
          canSetInactive: data.canSetInactive,
          watched: data.isWatched
        })
      }
    }
    return rows
  }

  public inactive(index: integer): boolean { return !Client::C_Reputation::IsFactionActive(index) }

  public skills(): array<Skill> {
    const rows: array<Skill> = mut []
    for (index of 1..Client::C_SkillInfo::GetNumSkillLines()) {
      const data = Client::C_SkillInfo::GetSkillLineInfo(index)
      if (data != nil) {
        rows.push({
          id: data.skillID.floor(),
          index: index,
          name: data.name,
          header: data.isHeader,
          collapsed: data.isCollapsed,
          rank: data.rank.floor(),
          modifier: data.modifier.floor(),
          max: data.maxRank.floor(),
          description: data.description,
          abandonable: data.isAbandonable
        })
      }
    }
    return rows
  }

  public mut pickup(slot: integer) { Client::PickupInventoryItem(slot) }

  public mut foldSkills(index: integer, open: boolean) {
    if (open) {
      Client::C_SkillInfo::ExpandSkillHeader(index)
    } else {
      Client::C_SkillInfo::CollapseSkillHeader(index)
    }
  }

  public mut unlearn(skill: integer) { Client::C_SkillInfo::AbandonSkill(skill) }

  public mut fold(index: integer, open: boolean) {
    if (open) {
      Client::C_Reputation::ExpandFactionHeader(index)
    } else {
      Client::C_Reputation::CollapseFactionHeader(index)
    }
  }

  // The faction shown on the bar: none once the one shown is turned off (index 0, as the game's own switch does).
  public mut watchFaction(index: integer, on: boolean) { Client::C_Reputation::SetWatchedFactionByIndex(on ? index : 0) }

  public mut toggleAtWar(index: integer) { Client::C_Reputation::ToggleFactionAtWar(index) }

  public mut setInactive(index: integer, inactive: boolean) { Client::C_Reputation::SetFactionActive(index, !inactive) }
}

// A standing's name as the client writes it (`FACTION_STANDING_LABEL1`, hated, to `8`, exalted).
public function standingName(standing: integer): string {
  return Runtime::text(`FACTION_STANDING_LABEL${standing}`) ?? ""
}

// A standing's colour as the client's reputation bar fills it (`FACTION_BAR_COLORS`); neutral's where it has none.
const NEUTRAL: Color = { r: 0.9, g: 0.7, b: 0, a: 1 }
public function standingColor(standing: integer): Color {
  const color = Client::FACTION_BAR_COLORS[standing]
  if (color == nil) { return NEUTRAL }
  return { r: color.r, g: color.g, b: color.b, a: 1 }
}
