// The character's stats as the window shows them, every number in view and none behind a tooltip: the main stats as
// big numbers, then sections parted by cuts in the wood, each its cards first, then its gauges, then its plain lines.
// A gauge is a stat with a cap the player works towards (hit, crit, a weapon's skill), a line one without (attack
// speed, penetration), a card one of a section's main numbers (attack power, damage a second, a school's spell damage).
import { Align, Beside, Event, Hang, Piece, Position, TextAlign, TextFont, Track } from "$ltml"
import { BRIGHT_TEXT, Component, Corners, Groove, RoundedFill, SECONDARY_TEXT, Tip, Weights } from "Ordaen"
import { CarveShade, CarvedFloor, GaugeBar, GaugeMark, WELL_INSET, WellSlice } from "@/gauge"
import Locale from "@/locales"
import { Skill, Stats, WANDS, meleeDps, rangedDps, swingOf } from "@/sheet"
import { Boost, Breakdown, Cap, NO_BREAKDOWN, expertiseCaps, hitCaps, statName, statValue } from "@/sources"
import { Stat } from "@/stat"
import Style from "@/style"

// A stat with a cap: its name, its value against the cap, the value as written and the fill's colour.
public struct Gauge {
  const label: string
  const value: number
  const cap: number
  const text: string
  const tone: Color
  // The stat its tooltip tells the sources of; none for one without.
  const stat: Stat | nil = nil
  // Its caps, marked on it.
  const caps: array<Cap> = []
  // Where its tooltip stands, tried before its column's ways: the tooltip's corner on the gauge's.
  const tip: Hang | nil = nil
}

// A gauge whose caps are marked on it: it reaches a fifth past the greatest, so each mark stands inside it.
function capped(label: string, value: number, stat: Stat, caps: array<Cap>): Gauge {
  let most: number = 0
  for (c of caps) { most = most.max(c.at) }
  return { label: label, value: value, cap: most * CAPPED_ROOM, text: percent(value), tone: Style::GAUGE, stat: stat, caps: caps }
}
const CAPPED_ROOM = 1.2

// A stat on a line of its own: its name, its value and a unit after it.
public struct Row {
  const label: string
  const value: string
  const unit: string = ""
  const stat: Stat | nil = nil
}

// One of a section's main numbers: its glyph in the socket in its colour, its name over its value; `lit` the
// section's lead, its glyph bright.
public struct Figure {
  const label: string
  const value: string
  const glyph: Piece
  const color: Color
  const lit: boolean = false
  const stat: Stat | nil = nil
  // Where its tooltip stands, tried before its column's ways: the tooltip's corner on the card's.
  const tip: Hang | nil = nil
}

// A section of the right column: its title on the cut over it, its leading gauges (the skills it rests on: the
// weapons', the defense), its cards (a row each, a row's cards sharing its width, a lone card half of it), its gauges
// and its lines.
public struct Section {
  const title: string
  const lead: array<Gauge> = []
  const cards: array<array<Figure>>
  const gauges: array<Gauge>
  const rows: array<Row>
}

// A resistance on the resistances' bar: its value, its school's colour and its stat.
public struct Resist {
  const value: integer
  const color: Color
  const stat: Stat
}

// One of the five main stats: its value, its name in three letters, and what the game's sheet says of it; `valued`
// where the player's spec weighs it among its most (`mainsOf`).
public struct Main {
  const value: integer
  const short: string
  const label: string
  const tip: string
  const stat: Stat
  const valued: boolean = false
}

// The gauges' full: crit, defense (a level 63 boss can't crit), dodge, parry and block, haste; the armor and a
// resistance that stop three quarters of a level 63 boss's damage. Hit and expertise reach past their caps, marked
// on them (`capped`).
const CRIT_CAP = 40
const DEFENSE_CAP = 440
const AVOIDANCE_CAP = 30
const HASTE_CAP = 20
const ARMOR_CAP = 17265

// The glyphs (art/pieces/character-glyphs.json): a column of 64-texel cells, white, tinted where they are drawn: holy,
// fire, nature, frost, shadow and arcane (the client's schools 2 to 7), then heal, power, damage, armor, percent, block
// (a shield), blocked (a shield struck through) and time (an hourglass).
const GLYPH_FILE: Asset = "@/media/character-glyphs.tga"
const function glyphPieces(): array<Piece> {
  let list: array<Piece> = []
  for (row of 0..13) { list.push({ file: GLYPH_FILE, width: 64, height: 1024, rows: 16, normal: row }) }
  return list
}
const GLYPHS: array<Piece> = glyphPieces()
function glyph(row: integer): Piece { return GLYPHS[row] ?? panic("fourteen glyphs") }
const HEAL_GLYPH = 7
const POWER_GLYPH = 8
const DAMAGE_GLYPH = 9
const ARMOR_GLYPH = 10
const PERCENT_GLYPH = 11
const BLOCK_GLYPH = 12
const BLOCKED_GLYPH = 13
const TIME_GLYPH = 14
// The schools' colours, holy to arcane, as the resistances and the spells' cards wear them.
const SCHOOL_COLORS: array<Color> = [Style::HOLY, Style::FIRE, Style::NATURE, Style::FROST, Style::SHADOW, Style::ARCANE]
function schoolColor(school: integer): Color { return SCHOOL_COLORS[school - 1] ?? panic("six schools") }
// The schools' names, holy to arcane: a spell card's title.
const SCHOOL_NAMES: array<string> = [Locale::SCHOOL_HOLY, Locale::SCHOOL_FIRE, Locale::SCHOOL_NATURE, Locale::SCHOOL_FROST, Locale::SCHOOL_SHADOW, Locale::SCHOOL_ARCANE]
function schoolName(school: integer): string { return SCHOOL_NAMES[school - 1] ?? panic("six schools") }
const HOLY = 2
const FIRE = 3
const NATURE = 4
const FROST = 5
const SHADOW = 6
const ARCANE = 7

// A class's damage schools and the school it heals with (none: 0), by its tag.
struct Casting {
  const schools: array<integer>
  const heals: integer
}
const CASTING: map<string, Casting> = {
  MAGE: { schools: [FIRE, FROST, ARCANE], heals: 0 },
  WARLOCK: { schools: [SHADOW, FIRE], heals: 0 },
  PRIEST: { schools: [SHADOW, HOLY], heals: HOLY },
  DRUID: { schools: [NATURE, ARCANE], heals: NATURE },
  SHAMAN: { schools: [NATURE, FIRE, FROST], heals: NATURE },
  PALADIN: { schools: [HOLY], heals: HOLY }
}

function percent(value: number): string { return "%.2f%%".format(value) }
function seconds(value: number): string { return "%.2f".format(value) }
function tenths(value: number): string { return "%.1f".format(value) }

function measured(label: string, value: number, cap: number, text: string, stat: Stat): Gauge {
  return { label: label, value: value, cap: cap, text: text, tone: Style::GAUGE, stat: stat }
}

function rate(label: string, value: number, cap: number, stat: Stat): Gauge {
  return measured(label, value, cap, percent(value), stat)
}

// The five main stats. By the player's spec's weights (`weights`, its own sheet's alone): the most weighed first,
// those weighed at least half the most `valued`. Without: the class's own first (the greatest of strength, agility and
// intellect), then stamina, then the rest in the game's order.
public function mainsOf(stats: Stats, weights: Weights | nil): array<Main> {
  const worth: array<number> = weights == nil ? [0, 0, 0, 0, 0] :
    [weights.strength, weights.agility, weights.stamina, weights.intellect, weights.spirit]
  let most: number = 0
  for (weight of worth) { most = most.max(weight) }
  const valued = (index: integer): boolean => most > 0 && (worth[index] ?? 0) * 2 >= most
  const all: array<Main> = [
    { value: stats.strength, short: Locale::STRENGTH_SHORT, label: Locale::STRENGTH, tip: stats.tips.primary[1] ?? "", stat: .Strength, valued: valued(1) },
    { value: stats.agility, short: Locale::AGILITY_SHORT, label: Locale::AGILITY, tip: stats.tips.primary[2] ?? "", stat: .Agility, valued: valued(2) },
    { value: stats.stamina, short: Locale::STAMINA_SHORT, label: Locale::STAMINA, tip: stats.tips.primary[3] ?? "", stat: .Stamina, valued: valued(3) },
    { value: stats.intellect, short: Locale::INTELLECT_SHORT, label: Locale::INTELLECT, tip: stats.tips.primary[4] ?? "", stat: .Intellect, valued: valued(4) },
    { value: stats.spirit, short: Locale::SPIRIT_SHORT, label: Locale::SPIRIT, tip: stats.tips.primary[5] ?? "", stat: .Spirit, valued: valued(5) }
  ]
  if (most > 0) {
    let order: array<integer> = [1, 2, 3, 4, 5]
    order.sort((a: integer, b: integer): boolean => (worth[a] ?? 0) > (worth[b] ?? 0) || ((worth[a] ?? 0) == (worth[b] ?? 0) && a < b))
    return order.map(index => all[index] ?? panic("five main stats"))
  }
  const lead = stats.intellect > stats.strength.max(stats.agility) ? 4 : stats.agility > stats.strength ? 2 : 1
  const order: array<integer> = [lead, 3]
  for (index of 1..5) {
    if (index != lead && index != 3) { order.push(index) }
  }
  return order.map(index => all[index] ?? panic("five main stats"))
}

// The defence section's cards: the armor's cut of the damage and what of an enemy's blows lands on the player, side by
// side, against the enemy the cards count; under them, with a shield, block's chance and the damage a block stops. The
// reduction's tooltip stands over it, the hit's on its right, block's on its left, each clear of what it lights.
function defenceCardsOf(stats: Stats): array<array<Figure>> {
  const rows: array<array<Figure>> = [[
    {
      label: Locale::DAMAGE_REDUCTION, value: percent(statValue(.DamageReduction, stats)), glyph: glyph(ARMOR_GLYPH),
      color: Style::STAT, stat: .DamageReduction, tip: { point: .BottomLeft, to: .TopLeft }
    },
    {
      label: Locale::HIT_TAKEN, value: percent(statValue(.HitTaken, stats)), glyph: glyph(PERCENT_GLYPH), color: Style::STAT,
      stat: .HitTaken, tip: { point: .BottomLeft, to: .BottomRight }
    }
  ]]
  if (stats.shield) {
    rows.push([
      {
        label: Locale::BLOCK, value: percent(stats.block), glyph: glyph(BLOCK_GLYPH), color: Style::STAT, stat: .Block,
        tip: { point: .BottomRight, to: .BottomLeft }
      },
      { label: Locale::BLOCK_VALUE, value: string::of(stats.blockValue), glyph: glyph(BLOCKED_GLYPH), color: Style::STAT, stat: .BlockValue }
    ])
  }
  return rows
}

// The defence section: the defense skill over all of it (a skill's blue as the weapons' skills are), its cards, then
// its gauges (the resistances' bar after them is the page's).
public function defenceOf(stats: Stats): Section {
  return {
    title: Locale::SECTION_DEFENSE,
    lead: [{ label: Locale::SECTION_DEFENSE, value: stats.defense, cap: DEFENSE_CAP, text: string::of(stats.defense), tone: Style::SKILL, stat: .Defense }],
    cards: defenceCardsOf(stats),
    gauges: defenceGauges(stats),
    rows: []
  }
}

// The defence section's gauges under its cards: dodge and parry, then the armor, its tooltip over it.
function defenceGauges(stats: Stats): array<Gauge> {
  return [
    rate(Locale::DODGE, stats.dodge, AVOIDANCE_CAP, .Dodge),
    rate(Locale::PARRY, stats.parry, AVOIDANCE_CAP, .Parry),
    {
      label: Locale::ARMOR, value: stats.armor, cap: ARMOR_CAP, text: string::of(stats.armor), tone: Style::ARMOR, stat: .Armor,
      tip: { point: .BottomLeft, to: .TopLeft }
    }
  ]
}

// Under a pool's bar: what it regains, out of a fight and in one, every five seconds (energy every second, in a fight
// as out of it; rage none).
public function healthRegenRows(stats: Stats): array<Row> {
  return [
    { label: Locale::REGEN, value: string::of(stats.healthRegen.floor()), unit: Locale::PER_FIVE, stat: .HealthRegen },
    { label: Locale::COMBAT_REGEN, value: string::of(stats.combatHealthRegen.floor()), unit: Locale::PER_FIVE, stat: .CombatHealthRegen }
  ]
}
public function powerRegenRows(stats: Stats): array<Row> {
  return match (stats.resource) {
    .Mana => [
      { label: Locale::REGEN, value: string::of(stats.restingRegen.floor()), unit: Locale::PER_FIVE, stat: .ManaRegen },
      { label: Locale::COMBAT_REGEN, value: string::of(stats.regen.floor()), unit: Locale::PER_FIVE, stat: .Regen }
    ]
    .Energy => energyRegenRows(stats)
    else => []
  }
}
public function energyRegenRows(stats: Stats): array<Row> {
  return [{ label: Locale::REGEN, value: string::of(stats.energyRegen.floor()), unit: Locale::PER_SECOND }]
}

// The movement speeds, in percent of the game's base.
public function speedsOf(stats: Stats): array<Row> {
  return [
    { label: Locale::RUN_SPEED, value: string::of(stats.runSpeed.round()), unit: "%", stat: .RunSpeed },
    { label: Locale::SWIM_SPEED, value: string::of(stats.swimSpeed.round()), unit: "%" }
  ]
}

// The resistances the character has, each a share of their sum in its school's colour: fire, nature, frost, shadow,
// arcane; none at 0.
public function resistsOf(stats: Stats): array<Resist> {
  const r = stats.resistances
  const all: array<Resist> = [
    { value: r[2] ?? 0, color: Style::FIRE, stat: .FireResistance },
    { value: r[4] ?? 0, color: Style::NATURE, stat: .NatureResistance },
    { value: r[3] ?? 0, color: Style::FROST, stat: .FrostResistance },
    { value: r[5] ?? 0, color: Style::SHADOW, stat: .ShadowResistance },
    { value: r[1] ?? 0, color: Style::ARCANE, stat: .ArcaneResistance }
  ]
  return all.filter(resist => resist.value > 0)
}

// A weapon a section holds: its skill line (none where nothing is held) and the stat its skill's tooltip tells.
struct Held {
  const skill: integer | nil
  const stat: Stat
}

// The skill gauges of the weapons a section holds, the main hand's and the other's where each holds one: one a skill
// (two swords share one, the main hand's), in blue up to the cap, each with its tooltip.
function skillGauges(held: array<Held>, skills: array<Skill>): array<Gauge> {
  const gauges: array<Gauge> = []
  const seen: array<integer> = []
  for (weapon of held) {
    const id = weapon.skill
    if (id != nil && !seen.any(s => s == id)) {
      seen.push(id)
      const skill = skills.find(s => s.id == id)
      if (skill != nil) {
        const value = skill.rank + skill.modifier
        gauges.push({ label: skill.name, value: value, cap: skill.max, text: string::of(value), tone: Style::SKILL, stat: weapon.stat })
      }
    }
  }
  return gauges
}

// A section's card of what lands of its attacks, in percent to the hundredth; its tooltip on its left, clear of the
// skills, the hit and the expertise it lights.
function landsCard(stat: Stat, stats: Stats): Figure {
  return {
    label: Locale::LANDS, value: percent(statValue(stat, stats)), glyph: glyph(PERCENT_GLYPH), color: Style::STAT, stat: stat,
    tip: { point: .BottomRight, to: .BottomLeft }
  }
}

// A section's card of the seconds between its swings or its shots.
function speedCard(between: number, stat: Stat): Figure {
  return { label: Locale::ATTACK_SPEED, value: `${seconds(between)} ${Locale::SECONDS}`, glyph: glyph(TIME_GLYPH), color: Style::STAT, stat: stat }
}

// The second row of a weapon's section: what lands, and the seconds between its attacks where it has any.
function landsRow(lands: Stat, between: number, speed: Stat, stats: Stats): array<Figure> {
  const row = [landsCard(lands, stats)]
  if (between > 0) { row.push(speedCard(between, speed)) }
  return row
}

function melee(stats: Stats, skills: array<Skill>): Section {
  return {
    title: Locale::SECTION_MELEE,
    lead: skillGauges([{ skill: stats.mainSkill, stat: .MainHandSkill }, { skill: stats.offSkill, stat: .OffHandSkill }], skills),
    cards: [[
      { label: Locale::ATTACK_POWER, value: string::of(stats.attackPower), glyph: glyph(POWER_GLYPH), color: Style::STAT, stat: .AttackPower },
      { label: Locale::DPS, value: tenths(meleeDps(stats)), glyph: glyph(DAMAGE_GLYPH), color: Style::STAT, stat: .MeleeDps }
    ], landsRow(.MeleeLands, stats.speed > 0 ? swingOf(stats) : 0, .AttackSpeed, stats)],
    gauges: [
      capped(Locale::HIT, stats.meleeHit, .MeleeHit, hitCaps(.MeleeHit, stats)),
      rate(Locale::CRIT, stats.meleeCrit, CRIT_CAP, .MeleeCrit),
      capped(Locale::EXPERTISE, stats.expertise, .Expertise, expertiseCaps()),
      rate(Locale::HASTE, stats.meleeHaste, HASTE_CAP, .MeleeHaste)
    ],
    rows: [{ label: Locale::ARMOR_PENETRATION, value: string::of(stats.armorPenetration), stat: .ArmorPenetration }]
  }
}

// The ranged weapon's section; a wand's is its skill and its damage a second alone (no attack power counts in it).
function ranged(stats: Stats, skills: array<Skill>): Section | nil {
  const skill = stats.rangedSkill
  if (skill == nil) { return nil }
  const lead = skillGauges([{ skill: skill, stat: .RangedSkill }], skills)
  const haste = rate(Locale::HASTE, stats.rangedHaste, HASTE_CAP, .RangedHaste)
  if (skill == WANDS) {
    return {
      title: Locale::SECTION_RANGED,
      lead: lead,
      cards: [],
      gauges: [haste],
      rows: [
        { label: Locale::DPS, value: tenths(rangedDps(stats)), stat: .RangedDps },
        { label: Locale::ATTACK_SPEED, value: seconds(stats.rangedSpeed), unit: Locale::SECONDS, stat: .RangedAttackSpeed }
      ]
    }
  }
  return {
    title: Locale::SECTION_RANGED,
    lead: lead,
    cards: [[
      { label: Locale::ATTACK_POWER, value: string::of(stats.rangedAttackPower), glyph: glyph(POWER_GLYPH), color: Style::STAT, stat: .RangedAttackPower },
      { label: Locale::DPS, value: tenths(rangedDps(stats)), glyph: glyph(DAMAGE_GLYPH), color: Style::STAT, stat: .RangedDps }
    ], landsRow(.RangedLands, stats.rangedSpeed, .RangedAttackSpeed, stats)],
    gauges: [capped(Locale::HIT, stats.rangedHit, .RangedHit, hitCaps(.RangedHit, stats)), rate(Locale::CRIT, stats.rangedCrit, CRIT_CAP, .RangedCrit), haste],
    rows: []
  }
}

// The spells of a class that casts: a card per school its damage spells use, the greatest first and lit, then its
// healing where it heals; spell hit and crit; penetration and the mana regained while casting.
function spells(stats: Stats, classTag: string): Section | nil {
  const casting = CASTING[classTag]
  if (casting == nil) { return nil }
  const schools = casting.schools.map(school => school)
  schools.sort((a, b) => (stats.schoolDamage[a - 1] ?? 0) > (stats.schoolDamage[b - 1] ?? 0))
  const cards: array<Figure> = []
  for (index, school of schools) {
    cards.push({ label: schoolName(school), value: string::of(stats.schoolDamage[school - 1] ?? 0), glyph: glyph(school - 1), color: schoolColor(school), lit: index == 1, stat: .SpellDamage })
  }
  if (casting.heals != 0) {
    cards.push({ label: Locale::HEALING, value: string::of(stats.healing), glyph: glyph(HEAL_GLYPH), color: schoolColor(casting.heals), stat: .Healing })
  }
  return {
    title: Locale::SECTION_SPELLS,
    cards: [cards, [landsCard(.SpellLands, stats)]],
    gauges: [
      capped(Locale::HIT, stats.spellHit, .SpellHit, hitCaps(.SpellHit, stats)),
      rate(Locale::CRIT, stats.spellCrit, CRIT_CAP, .SpellCrit),
      rate(Locale::HASTE, stats.spellHaste, HASTE_CAP, .SpellHaste)
    ],
    rows: [{ label: Locale::SPELL_PENETRATION, value: string::of(stats.spellPenetration), stat: .SpellPenetration }]
  }
}

// The right column's sections in the order the class reads them: a caster's spells first, then melee and ranged;
// anyone else's melee and ranged, then their spells.
public function sectionsOf(stats: Stats, skills: array<Skill>, classTag: string): array<Section> {
  const sections: array<Section> = []
  const magic = spells(stats, classTag)
  const caster = stats.intellect > stats.strength.max(stats.agility)
  if (caster && magic != nil) { sections.push(magic) }
  sections.push(melee(stats, skills))
  const shooting = ranged(stats, skills)
  if (shooting != nil) { sections.push(shooting) }
  if (!caster && magic != nil) { sections.push(magic) }
  return sections
}

const NO_BOOSTS: map<string, Boost> = {}
const NO_ROWS: array<Row> = []

// A stat's value's ink: green while an aura raises it, red while one lowers it, else its own.
function inkOf(stat: Stat | nil, boosts: map<string, Boost>, plain: Color): Color {
  if (stat == nil) { return plain }
  const boost = boosts[`${stat}`]
  if (boost == .Up) { return Style::GREEN }
  if (boost == .Down) { return Style::RED }
  return plain
}

// Where a stat's tooltip stands: beside its view on the side away from the paper doll, out of the window, so it covers
// none of the slots and stats it lights; level with the view's top, or with its bottom where the screen has no room
// below; on the other side where the screen has none on that one.
public const TIP_RIGHT: Beside = {
  beside: "parent",
  prefer: [
    { point: .TopLeft, to: .TopRight }, { point: .BottomLeft, to: .BottomRight },
    { point: .TopRight, to: .TopLeft }, { point: .BottomRight, to: .BottomLeft }
  ]
}
public const TIP_LEFT: Beside = {
  beside: "parent",
  prefer: [
    { point: .TopRight, to: .TopLeft }, { point: .BottomRight, to: .BottomLeft },
    { point: .TopLeft, to: .TopRight }, { point: .BottomLeft, to: .BottomRight }
  ]
}

// Where a view's tooltip stands: its own way first where it has one, then its column's.
function placeFor(column: Beside, own: Hang | nil): Beside {
  if (own == nil) { return column }
  const prefer: array<Hang> = [own]
  for (hang of column.prefer ?? []) { prefer.push(hang) }
  return { beside: column.beside, prefer: prefer }
}

// What a stat's view stands in: with the cursor on it, the stat's tooltip (its name and value, the game's words on it,
// its sources) stands beside it (`tip`: on which side), and `tipped` tells the page which stat it is, so its sources
// light; a stat that feeds the one whose tooltip is open glows gold. A view of no stat (`stat` none) is a plain box.
public class StatSpot implements Component {
  // The stat under the cursor; none once the cursor leaves.
  public tipped: Event<Stat | nil> = new Event()

  state hovered = false
  derived open: boolean = self.hovered && self.stat != nil && !self.quiet
  derived glows: boolean = self.stat != nil && self.shown.fed.any(s => s == self.stat)

  stat: Signal<Stat | nil>
  title: Signal<string>
  shown: Signal<Breakdown>
  // Something in it shows a tooltip of its own (a gauge's mark under the cursor): its own stays shut meanwhile.
  quiet: Signal<boolean>
  tip: Signal<Beside>
  constructor(stat: Signal<Stat | nil>, title: Signal<string>, shown: Signal<Breakdown>, quiet: Signal<boolean> = false,
    tip: Signal<Beside> = TIP_RIGHT) {
    self.stat = stat
    self.title = title
    self.shown = shown
    self.quiet = quiet
    self.tip = tip
  }

  mut onEnter() {
    self.hovered = true
    self.tipped.emit(peek self.stat)
  }

  mut onLeave() {
    self.hovered = false
    self.tipped.emit(nil)
  }

  public render(): Template {
    return $ltml {
      <box @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <slot />
        <box $if={self.glows} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             border={Style::SOURCE_RIM} background={Style::SOURCE_GLOW} zLevel={3} />
        <Tip $if={self.open} title={self.title} text={self.shown.text} rows={self.shown.rows} sections={self.shown.sections}
             place={self.tip} />
      </box>
    }
  }
}

// A gauge's caps as marks at their shares of its full.
function marksOf(gauge: Gauge): array<GaugeMark> {
  return gauge.cap <= 0 ? [] : gauge.caps.map(c => GaugeMark { share: c.at / gauge.cap, title: c.title, text: c.text })
}

// A gauge: the name, the channel filled up to the value's share of the cap, its caps marked on it, the value at the
// right. A mark under the cursor shows its own tooltip, the gauge's shut meanwhile.
public class StatGauge implements Component {
  public tipped: Event<Stat | nil> = new Event()

  state onMark = false
  derived share: number = self.gauge.cap <= 0 ? 0 : self.gauge.value / self.gauge.cap
  derived marks: array<GaugeMark> = marksOf(self.gauge)
  derived ink: Color = inkOf(self.gauge.stat, self.boosts, self.gauge.value == 0 ? Style::DIM : BRIGHT_TEXT)
  derived title: string = self.gauge.label
  derived place: Beside = placeFor(self.tip, self.gauge.tip)

  gauge: Signal<Gauge>
  shown: Signal<Breakdown>
  boosts: Signal<map<string, Boost>>
  tip: Signal<Beside>
  constructor(gauge: Signal<Gauge>, shown: Signal<Breakdown> = NO_BREAKDOWN, boosts: Signal<map<string, Boost>> = NO_BOOSTS,
    tip: Signal<Beside> = TIP_RIGHT) {
    self.gauge = gauge
    self.shown = shown
    self.boosts = boosts
    self.tip = tip
  }

  onTipped(stat: Stat | nil) { self.tipped.emit(stat) }
  mut onMarkEntered() { self.onMark = true }
  mut onMarkLeft() { self.onMark = false }

  public render(): Template {
    return $ltml {
      <StatSpot stat={self.gauge.stat} title={self.title} shown={self.shown} quiet={self.onMark} tip={self.place}
                @tipped={self.onTipped}>
        <box columns={[Style::GAUGE_LABEL, { fr: 1 }, Style::GAUGE_VALUE]} gap={2.5sp} yAlign={Align::Center}>
          <text value={self.gauge.label} textColor={BRIGHT_TEXT} wrap={.None} />
          <GaugeBar value={self.share} tone={self.gauge.tone} height={Style::CHANNEL} marks={self.marks}
                    @markEntered={self.onMarkEntered} @markLeft={self.onMarkLeft} />
          <text value={self.gauge.text} textFont={TextFont::Numbers} textColor={self.ink} textAlign={TextAlign::End}
                wrap={.None} />
        </box>
      </StatSpot>
    }
  }
}

// A line: the name on the left, the value on the right with its unit after it, in the value's colour.
public class StatRow implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived ink: Color = inkOf(self.row.stat, self.boosts, self.row.value == "0" ? Style::DIM : BRIGHT_TEXT)
  derived title: string = self.row.label

  row: Signal<Row>
  shown: Signal<Breakdown>
  boosts: Signal<map<string, Boost>>
  tip: Signal<Beside>
  constructor(row: Signal<Row>, shown: Signal<Breakdown> = NO_BREAKDOWN, boosts: Signal<map<string, Boost>> = NO_BOOSTS,
    tip: Signal<Beside> = TIP_RIGHT) {
    self.row = row
    self.shown = shown
    self.boosts = boosts
    self.tip = tip
  }

  onTipped(stat: Stat | nil) { self.tipped.emit(stat) }

  public render(): Template {
    return $ltml {
      <StatSpot stat={self.row.stat} title={self.title} shown={self.shown} tip={self.tip} @tipped={self.onTipped}>
        <box columns={[{ fr: 1 }, "max-content", "max-content"]} gap={1sp} yAlign={Align::Center}>
          <text value={self.row.label} textColor={Style::INK} wrap={.None} />
          <text value={self.row.value} textFont={TextFont::Numbers} textColor={self.ink} wrap={.None} />
          <text value={self.row.unit} textColor={self.ink} wrap={.None} />
        </box>
      </StatSpot>
    }
  }
}

// A card carved into the wood (the gauges' floor): the picture in its socket the card's whole height at its left, the
// name after it and the value, larger, at the right, on one line; a name longer than the room the value leaves wraps.
const SOCKET_CORNERS: Corners = { topLeft: true, bottomLeft: true, topRight: false, bottomRight: false }
public class StatCard implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived glyphShade: number = self.figure.lit ? 1 : 0.7
  derived title: string = self.figure.label
  derived place: Beside = placeFor(self.tip, self.figure.tip)
  derived ink: Color = inkOf(self.figure.stat, self.boosts, BRIGHT_TEXT)

  figure: Signal<Figure>
  shown: Signal<Breakdown>
  boosts: Signal<map<string, Boost>>
  tip: Signal<Beside>
  constructor(figure: Signal<Figure>, shown: Signal<Breakdown> = NO_BREAKDOWN, boosts: Signal<map<string, Boost>> = NO_BOOSTS,
    tip: Signal<Beside> = TIP_RIGHT) {
    self.figure = figure
    self.shown = shown
    self.boosts = boosts
    self.tip = tip
  }

  onTipped(stat: Stat | nil) { self.tipped.emit(stat) }

  public render(): Template {
    return $ltml {
      <StatSpot stat={self.figure.stat} title={self.title} shown={self.shown} tip={self.place} @tipped={self.onTipped}>
        <box columns={[Style::SOCKET, { fr: 1 }, "max-content"]} gap={Style::CARD_GAP} padding={Style::CARD_PAD}
             yAlign={Align::Stretch}>
          <CarvedFloor />
          <box>
            <RoundedFill color={Style::SOCKET_FLOOR} radius={Style::SOCKET_ROUND} corners={SOCKET_CORNERS} />
            <box position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} xAlign={Align::Center}
                 yAlign={Align::Center}>
              <box width={Style::GLYPH} height={Style::GLYPH} background={self.figure.glyph} tint={self.figure.color}
                   opacity={self.glyphShade} />
            </box>
          </box>
          <box yAlign={Align::Center} padding={Style::CARD_TEXT_PAD}>
            <text value={self.figure.label} textColor={Style::INK} />
          </box>
          <box yAlign={Align::Center} xAlign={Align::End} padding={Style::CARD_TEXT_PAD}>
            <text value={self.figure.value} textSize={Style::CARD_VALUE} textFont={TextFont::Numbers} textColor={self.ink}
                  leading={.Tight} wrap={.None} />
          </box>
          <CarveShade />
        </box>
      </StatSpot>
    }
  }
}

// A section: the cut over it with its title on it, then a padded group of its cards, its gauges set a little further
// off (with what the section is given after them: the defence's resistances), its lines.
public class SectionView implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived carded: boolean = self.section.cards.length > 0
  derived led: boolean = self.section.lead.length > 0

  section: Signal<Section>
  shown: Signal<Breakdown>
  boosts: Signal<map<string, Boost>>
  // The side of its stats their tooltips stand on: the side of the window the section is on.
  tip: Signal<Beside>
  constructor(section: Signal<Section>, shown: Signal<Breakdown> = NO_BREAKDOWN, boosts: Signal<map<string, Boost>> = NO_BOOSTS,
    tip: Signal<Beside> = TIP_RIGHT) {
    self.section = section
    self.shown = shown
    self.boosts = boosts
    self.tip = tip
  }

  onTipped(stat: Stat | nil) { self.tipped.emit(stat) }

  public render(): Template {
    return $ltml {
      <box gap={2.5sp}>
        <Groove title={self.section.title} />
        <box gap={2sp} padding={Style::SECTION_PAD}>
          <box $if={self.led} gap={1.5sp}>
            <StatGauge $for={g of self.section.lead} gauge={g} shown={self.shown} boosts={self.boosts} tip={self.tip}
                       @tipped={self.onTipped} />
          </box>
          <box $if={self.carded} gap={2.5sp} padding={Style::CARDS_PAD}>
            <box $for={line of self.section.cards} columns={line.length.max(2)} gap={2.5sp}>
              <StatCard $for={card of line} figure={card} shown={self.shown} boosts={self.boosts} tip={self.tip}
                        @tipped={self.onTipped} />
            </box>
          </box>
          <box gap={1.5sp}>
            <StatGauge $for={g of self.section.gauges} gauge={g} shown={self.shown} boosts={self.boosts} tip={self.tip}
                       @tipped={self.onTipped} />
            <slot />
          </box>
          <box gap={0.5sp}>
            <StatRow $for={row of self.section.rows} row={row} shown={self.shown} boosts={self.boosts} tip={self.tip}
                     @tipped={self.onTipped} />
          </box>
        </box>
      </box>
    }
  }
}

// A main stat: the big number over its three letters; its tooltip names it in full.
public class MainStat implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived title: string = self.main.label
  derived ink: Color = inkOf(self.main.stat, self.boosts, BRIGHT_TEXT)
  // Its letters gold where the player's spec weighs it among its most.
  derived shortInk: Color = self.main.valued ? Style::GOLD : Style::DIM

  main: Signal<Main>
  shown: Signal<Breakdown>
  boosts: Signal<map<string, Boost>>
  constructor(main: Signal<Main>, shown: Signal<Breakdown> = NO_BREAKDOWN, boosts: Signal<map<string, Boost>> = NO_BOOSTS) {
    self.main = main
    self.shown = shown
    self.boosts = boosts
  }

  onTipped(stat: Stat | nil) { self.tipped.emit(stat) }

  public render(): Template {
    return $ltml {
      <StatSpot stat={self.main.stat} title={self.title} shown={self.shown} @tipped={self.onTipped}>
        <box gap={0.5sp} xAlign={Align::Center} padding={Style::MAIN_PAD}>
          <text value={string::of(self.main.value)} textSize={Style::MAIN_TEXT} textFont={TextFont::Numbers}
                textColor={self.ink} wrap={.None} />
          <text value={self.main.short} textSize={SECONDARY_TEXT} textColor={self.shortInk} wrap={.None} />
        </box>
      </StatSpot>
    }
  }
}

// A slice's track: its resistance's share of their sum.
function resistTrack(resist: Resist): Track { return { fr: resist.value } }

// The resistances' bar, as a gauge's row: «Resistance» where a gauge's name stands, then a well split among the
// resistances the character has, each a slice in its school's colour as wide as its share of their sum, its value in
// it, its own tooltip under the cursor.
public class ResistBar implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived tracks: array<Track> = self.resists.map(resistTrack)

  resists: Signal<array<Resist>>
  shown: Signal<Breakdown>
  tip: Signal<Beside>
  constructor(resists: Signal<array<Resist>>, shown: Signal<Breakdown> = NO_BREAKDOWN, tip: Signal<Beside> = TIP_RIGHT) {
    self.resists = resists
    self.shown = shown
    self.tip = tip
  }

  onTipped(stat: Stat | nil) { self.tipped.emit(stat) }

  public render(): Template {
    return $ltml {
      <box columns={[Style::GAUGE_LABEL, { fr: 1 }, Style::GAUGE_VALUE]} gap={2.5sp} yAlign={Align::Center}>
        <text value={Locale::RESISTANCE} textColor={BRIGHT_TEXT} wrap={.None} />
        <box height={Style::CHANNEL}>
          <CarvedFloor />
          <box position={Position::Absolute} left={WELL_INSET} top={WELL_INSET} right={WELL_INSET} bottom={WELL_INSET}
               columns={self.tracks} rows={[{ fr: 1 }]}>
            <StatSpot $for={index, resist of self.resists} stat={resist.stat} title={statName(resist.stat)} shown={self.shown}
                      tip={self.tip} @tipped={self.onTipped}>
              <WellSlice color={resist.color} text={string::of(resist.value)} corners={sliceCorners(index, self.resists.length)} />
            </StatSpot>
          </box>
          <CarveShade />
        </box>
        <box />
      </box>
    }
  }
}

// A slice's rounded corners: the well's left ones on the first, its right ones on the last.
function sliceCorners(index: integer, count: integer): Corners {
  return { topLeft: index == 1, bottomLeft: index == 1, topRight: index == count, bottomRight: index == count }
}

// A pool's colour laid deeper, so the bar sits on the wood and the white text over it reads.
function deeper(color: Color): Color {
  return { r: color.r * Style::POOL_DEPTH, g: color.g * Style::POOL_DEPTH, b: color.b * Style::POOL_DEPTH, a: color.a }
}

// A pool's bar, a look of its own: a slim bar with softly rounded corners and a thin bronze line round it; back to front
// the line, the dark trough, the fill in its colour rounded as the trough is, a gloss over the fill's upper part; the
// amount at its middle and what it regains at its right; the stat it shows (health, mana) its tooltip's.
public class PoolBar implements Component {
  public tipped: Event<Stat | nil> = new Event()

  // The fill and the rest of the tube, inside its ring.
  derived parts: array<Track> = [{ fr: self.filled }, { fr: 1 - self.filled }]
  derived deep: Color = deeper(self.color)
  // The fill rounded as the trough is at its left end, and at its right once the bar is full.
  derived fillCorners: Corners = { topLeft: true, bottomLeft: true, topRight: self.filled >= 1, bottomRight: self.filled >= 1 }
  derived title: string = self.stat != nil ? statName(self.stat ?? .Health) : ""
  derived ink: Color = inkOf(self.stat, self.boosts, BRIGHT_TEXT)

  amount: Signal<string>
  color: Signal<Color>
  // What it regains, as lines under it, each with its own tooltip.
  regen: Signal<array<Row>>
  // How much of the bar is full: rage is empty out of a fight.
  filled: Signal<number>
  stat: Signal<Stat | nil>
  shown: Signal<Breakdown>
  boosts: Signal<map<string, Boost>>
  tip: Signal<Beside>
  constructor(amount: Signal<string>, color: Signal<Color>, regen: Signal<array<Row>> = NO_ROWS, filled: Signal<number> = 1,
    stat: Signal<Stat | nil> = nil, shown: Signal<Breakdown> = NO_BREAKDOWN, boosts: Signal<map<string, Boost>> = NO_BOOSTS,
    tip: Signal<Beside> = TIP_RIGHT) {
    self.amount = amount
    self.color = color
    self.regen = regen
    self.filled = filled
    self.stat = stat
    self.shown = shown
    self.boosts = boosts
    self.tip = tip
  }

  onTipped(stat: Stat | nil) { self.tipped.emit(stat) }

  // Over one another by their levels: the trough, the fill, the shine, the ring, the texts; the regeneration's lines
  // under it.
  public render(): Template {
    return $ltml {
      <box gap={1sp}>
        <StatSpot stat={self.stat} title={self.title} shown={self.shown} tip={self.tip} @tipped={self.onTipped}>
          <box height={Style::POOL} xAlign={Align::Center} yAlign={Align::Center}>
            <box position={Position::Absolute} top={0ui} right={0ui} bottom={0ui} left={0ui}>
              <RoundedFill color={Style::POOL_RIM} radius={Style::POOL_ROUND} />
            </box>
            <box position={Position::Absolute} top={Style::POOL_LINE} right={Style::POOL_LINE} bottom={Style::POOL_LINE}
                 left={Style::POOL_LINE}>
              <RoundedFill color={Style::POOL_TROUGH} radius={Style::POOL_ROUND - Style::POOL_LINE} />
            </box>
            <box position={Position::Absolute} top={Style::POOL_LINE} right={Style::POOL_LINE} bottom={Style::POOL_LINE}
                 left={Style::POOL_LINE} columns={self.parts} rows={Style::ONE_ROW} zLevel={1}>
              <box>
                <RoundedFill color={self.deep} radius={Style::POOL_ROUND - Style::POOL_LINE} corners={self.fillCorners} />
                <box position={Position::Absolute} top={0ui} left={Style::POOL_ROUND} right={Style::POOL_ROUND}
                     height={Style::POOL_GLOSS} background={Style::GLOSS} />
              </box>
              <box />
            </box>
            <box zLevel={4}>
              <text value={self.amount} textSize={SECONDARY_TEXT} textFont={TextFont::Numbers} textColor={self.ink}
                    textOutline={1} textShadow={Style::TUBE_SHADOW} wrap={.None} />
            </box>
          </box>
        </StatSpot>
        <StatRow $for={row of self.regen} row={row} shown={self.shown} boosts={self.boosts} tip={self.tip}
                 @tipped={self.onTipped} />
      </box>
    }
  }
}
