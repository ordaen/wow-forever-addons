// The character's stats as the window shows them, every number in view and none behind a tooltip: the main stats as
// big numbers, then sections parted by cuts in the wood, each its cards first, then its gauges, then its plain lines.
// A gauge is a stat with a cap the player works towards (hit, crit, a weapon's skill), a line one without (attack
// speed, penetration), a card one of a section's main numbers (attack power, damage a second, a school's spell damage).
import { Align, BarFill, Event, FillFrom, Piece, Position, TextAlign, TextFont } from "$ltml"
import { BRIGHT_TEXT, Component, SECONDARY_TEXT, TITLE_TEXT, Tip } from "Ordaen"
import Locale from "@/locales"
import { Skill, Stats, WANDS } from "@/sheet"
import { Breakdown, NO_BREAKDOWN, statName } from "@/sources"
import { Stat } from "@/stat"
import Style from "@/style"

// A stat with a cap: its name, its value against the cap, the value as written and the fill's colour.
public struct Gauge {
  const label: String
  const value: Number
  const cap: Number
  const text: String
  const tone: Color
  // The stat its tooltip tells the sources of; none for one without.
  const stat: Stat | nil = nil
}

// A stat on a line of its own: its name, its value and a unit after it.
public struct Row {
  const label: String
  const value: String
  const unit: String = ""
  const stat: Stat | nil = nil
}

// One of a section's main numbers: its glyph in the socket in its colour, its name over its value; `lit` the
// section's lead, its glyph bright.
public struct Figure {
  const label: String
  const value: String
  const glyph: Piece
  const color: Color
  const lit: Boolean = false
  const stat: Stat | nil = nil
}

// A section of the right column: its title on the cut over it, its cards, its gauges and its lines.
public struct Section {
  const title: String
  const cards: Array<Figure>
  const gauges: Array<Gauge>
  const rows: Array<Row>
}

// A resistance's column: its value, its bar against the cap (the value that stops three quarters of a level 63
// boss's damage), its colour and its glyph.
public struct Resist {
  const value: Integer
  const cap: Integer
  const color: Color
  const glyph: Piece
  const stat: Stat
}

// One of the five main stats: its value, its name in three letters, and what the game's sheet says of it.
public struct Main {
  const value: Integer
  const short: String
  const label: String
  const tip: String
  const stat: Stat
}

// The caps: hit against a boss (melee and ranged, spells), crit, expertise, defense (a level 63 boss can't crit),
// dodge, parry and block, haste; the armor and a resistance that stop three quarters of a level 63 boss's damage.
const MELEE_HIT_CAP = 9
const SPELL_HIT_CAP = 17
const CRIT_CAP = 40
const EXPERTISE_CAP = 6.5
const DEFENSE_CAP = 440
const AVOIDANCE_CAP = 30
const HASTE_CAP = 20
const ARMOR_CAP = 17265
const RESISTANCE_CAP = 315

// The glyphs (art/pieces/character-glyphs.json): a column of 64-texel cells, white, tinted where they are drawn: holy,
// fire, nature, frost, shadow and arcane (the client's schools 2 to 7), then heal, power, damage and armor.
const GLYPH_FILE: Asset = "@/media/character-glyphs.tga"
const function glyphPieces(): Array<Piece> {
  let list: Array<Piece> = []
  for (row of 0..9) { list.push({ file: GLYPH_FILE, width: 64, height: 1024, rows: 16, normal: row }) }
  return list
}
const GLYPHS: Array<Piece> = glyphPieces()
function glyph(row: Integer): Piece { return GLYPHS[row] ?? panic("ten glyphs") }
const HEAL_GLYPH = 7
const POWER_GLYPH = 8
const DAMAGE_GLYPH = 9
const ARMOR_GLYPH = 10
// The schools' colours, holy to arcane, as the resistances and the spells' cards wear them.
const SCHOOL_COLORS: Array<Color> = [Style.HOLY, Style.FIRE, Style.NATURE, Style.FROST, Style.SHADOW, Style.ARCANE]
function schoolColor(school: Integer): Color { return SCHOOL_COLORS[school - 1] ?? panic("six schools") }
const HOLY = 2
const FIRE = 3
const NATURE = 4
const FROST = 5
const SHADOW = 6
const ARCANE = 7

// A class's damage schools and the school it heals with (none: 0), by its tag.
struct Casting {
  const schools: Array<Integer>
  const heals: Integer
}
const CASTING: Map<String, Casting> = {
  MAGE: { schools: [FIRE, FROST, ARCANE], heals: 0 },
  WARLOCK: { schools: [SHADOW, FIRE], heals: 0 },
  PRIEST: { schools: [SHADOW, HOLY], heals: HOLY },
  DRUID: { schools: [NATURE, ARCANE], heals: NATURE },
  SHAMAN: { schools: [NATURE, FIRE, FROST], heals: NATURE },
  PALADIN: { schools: [HOLY], heals: HOLY }
}

function percent(value: Number): String { return "%.2f%%".format(value) }
function seconds(value: Number): String { return "%.2f".format(value) }
function tenths(value: Number): String { return "%.1f".format(value) }

function measured(label: String, value: Number, cap: Number, text: String, stat: Stat): Gauge {
  return { label: label, value: value, cap: cap, text: text, tone: Style.GAUGE, stat: stat }
}

function rate(label: String, value: Number, cap: Number, stat: Stat): Gauge {
  return measured(label, value, cap, percent(value), stat)
}

// The five main stats, the class's own first (the greatest of strength, agility and intellect), then stamina, then the
// rest in the game's order.
public function mainsOf(stats: Stats): Array<Main> {
  const all: Array<Main> = [
    { value: stats.strength, short: Locale.STRENGTH_SHORT, label: Locale.STRENGTH, tip: stats.tips.primary[1] ?? "", stat: .Strength },
    { value: stats.agility, short: Locale.AGILITY_SHORT, label: Locale.AGILITY, tip: stats.tips.primary[2] ?? "", stat: .Agility },
    { value: stats.stamina, short: Locale.STAMINA_SHORT, label: Locale.STAMINA, tip: stats.tips.primary[3] ?? "", stat: .Stamina },
    { value: stats.intellect, short: Locale.INTELLECT_SHORT, label: Locale.INTELLECT, tip: stats.tips.primary[4] ?? "", stat: .Intellect },
    { value: stats.spirit, short: Locale.SPIRIT_SHORT, label: Locale.SPIRIT, tip: stats.tips.primary[5] ?? "", stat: .Spirit }
  ]
  const lead = stats.intellect > stats.strength.max(stats.agility) ? 4 : stats.agility > stats.strength ? 2 : 1
  const order: Array<Integer> = [lead, 3]
  for (index of 1..5) {
    if (index != lead && index != 3) { order.push(index) }
  }
  return order.map(index => all[index] ?? panic("five main stats"))
}

// The defence group's gauges: dodge and parry, block with a shield, and last the defense skill, a skill's blue as the
// weapons' skills are.
public function defenceOf(stats: Stats): Array<Gauge> {
  const gauges: Array<Gauge> = [rate(Locale.DODGE, stats.dodge, AVOIDANCE_CAP, .Dodge), rate(Locale.PARRY, stats.parry, AVOIDANCE_CAP, .Parry)]
  if (stats.block > 0) { gauges.push(rate(Locale.BLOCK, stats.block, AVOIDANCE_CAP, .Block)) }
  gauges.push({
    label: Locale.SECTION_DEFENSE, value: stats.defense, cap: DEFENSE_CAP, text: String.of(stats.defense), tone: Style.SKILL,
    stat: .Defense
  })
  return gauges
}

// Under the defence gauges: the damage a block stops, with a shield.
public function defenceRows(stats: Stats): Array<Row> {
  return stats.block > 0 ? [{ label: Locale.BLOCK_VALUE, value: String.of(stats.blockValue), stat: .BlockValue }] : []
}

// The movement speeds, in percent of the game's base.
public function speedsOf(stats: Stats): Array<Row> {
  return [
    { label: Locale.RUN_SPEED, value: String.of(stats.runSpeed.round()), unit: "%", stat: .RunSpeed },
    { label: Locale.SWIM_SPEED, value: String.of(stats.swimSpeed.round()), unit: "%" }
  ]
}

// Armor and the five schools' resistances, each against what stops three quarters of a boss's damage.
public function resistsOf(stats: Stats): Array<Resist> {
  const r = stats.resistances
  return [
    { value: stats.armor, cap: ARMOR_CAP, color: Style.ARMOR, glyph: glyph(ARMOR_GLYPH), stat: .Armor },
    { value: r[2] ?? 0, cap: RESISTANCE_CAP, color: Style.FIRE, glyph: glyph(FIRE - 1), stat: .FireResistance },
    { value: r[4] ?? 0, cap: RESISTANCE_CAP, color: Style.NATURE, glyph: glyph(NATURE - 1), stat: .NatureResistance },
    { value: r[3] ?? 0, cap: RESISTANCE_CAP, color: Style.FROST, glyph: glyph(FROST - 1), stat: .FrostResistance },
    { value: r[5] ?? 0, cap: RESISTANCE_CAP, color: Style.SHADOW, glyph: glyph(SHADOW - 1), stat: .ShadowResistance },
    { value: r[1] ?? 0, cap: RESISTANCE_CAP, color: Style.ARCANE, glyph: glyph(ARCANE - 1), stat: .ArcaneResistance }
  ]
}

// Under the main stats, shared by every section: haste (one rating in Forever) and armor penetration.
public function sharedGauges(stats: Stats): Array<Gauge> { return [rate(Locale.HASTE, stats.haste, HASTE_CAP, .Haste)] }
public function sharedRows(stats: Stats): Array<Row> {
  return [{ label: Locale.ARMOR_PENETRATION, value: String.of(stats.armorPenetration), stat: .ArmorPenetration }]
}

// The skill gauges of the weapons a section holds, the main hand's and the other's where each holds one: one a skill
// (two swords share one), in blue up to the cap.
function skillGauges(main: Integer | nil, other: Integer | nil, skills: Array<Skill>): Array<Gauge> {
  const ids: Array<Integer> = []
  if (main != nil) { ids.push(main) }
  if (other != nil) { ids.push(other) }
  const gauges: Array<Gauge> = []
  const seen: Array<Integer> = []
  for (id of ids) {
    if (!seen.any(s => s == id)) {
      seen.push(id)
      const skill = skills.find(s => s.id == id)
      if (skill != nil) {
        const value = skill.rank + skill.modifier
        gauges.push({ label: skill.name, value: value, cap: skill.max, text: String.of(value), tone: Style.SKILL })
      }
    }
  }
  return gauges
}

// Two lists of gauges, one after the other.
function joined(first: Array<Gauge>, then: Array<Gauge>): Array<Gauge> {
  const all: Array<Gauge> = []
  for (g of first) { all.push(g) }
  for (g of then) { all.push(g) }
  return all
}

// The time between two swings of both hands together: two hands swing 1/main + 1/off times a second.
function swingOf(stats: Stats): Number {
  const off = stats.offSpeed
  if (off == nil || off <= 0) { return stats.speed }
  return 1 / (1 / stats.speed + 1 / off)
}

function meleeDps(stats: Stats): Number {
  if (stats.speed <= 0) { return 0 }
  const main = (stats.minDamage + stats.maxDamage) / 2 / stats.speed
  const off = stats.offSpeed
  if (off == nil || off <= 0) { return main }
  return main + (stats.offMinDamage + stats.offMaxDamage) / 2 / off
}

function rangedDps(stats: Stats): Number {
  if (stats.rangedSpeed <= 0) { return 0 }
  return (stats.rangedMinDamage + stats.rangedMaxDamage) / 2 / stats.rangedSpeed
}

function melee(stats: Stats, skills: Array<Skill>): Section {
  const rows: Array<Row> = stats.speed > 0 ? [{ label: Locale.ATTACK_SPEED, value: seconds(swingOf(stats)), unit: Locale.SECONDS }] : []
  return {
    title: Locale.SECTION_MELEE,
    cards: [
      { label: Locale.ATTACK_POWER, value: String.of(stats.attackPower), glyph: glyph(POWER_GLYPH), color: Style.STAT, stat: .AttackPower },
      { label: Locale.DPS, value: tenths(meleeDps(stats)), glyph: glyph(DAMAGE_GLYPH), color: Style.STAT }
    ],
    gauges: joined([
      rate(Locale.HIT, stats.meleeHit, MELEE_HIT_CAP, .MeleeHit),
      rate(Locale.CRIT, stats.meleeCrit, CRIT_CAP, .MeleeCrit),
      rate(Locale.EXPERTISE, stats.expertise, EXPERTISE_CAP, .Expertise)
    ], skillGauges(stats.mainSkill, stats.offSkill, skills)),
    rows: rows
  }
}

// The ranged weapon's section; a wand's is its skill and its damage a second alone (no attack power counts in it).
function ranged(stats: Stats, skills: Array<Skill>): Section | nil {
  const skill = stats.rangedSkill
  if (skill == nil) { return nil }
  const speed: Row = { label: Locale.ATTACK_SPEED, value: seconds(stats.rangedSpeed), unit: Locale.SECONDS }
  if (skill == WANDS) {
    return {
      title: Locale.SECTION_RANGED,
      cards: [],
      gauges: skillGauges(skill, nil, skills),
      rows: [{ label: Locale.DPS, value: tenths(rangedDps(stats)) }, speed]
    }
  }
  return {
    title: Locale.SECTION_RANGED,
    cards: [
      { label: Locale.ATTACK_POWER, value: String.of(stats.rangedAttackPower), glyph: glyph(POWER_GLYPH), color: Style.STAT, stat: .RangedAttackPower },
      { label: Locale.DPS, value: tenths(rangedDps(stats)), glyph: glyph(DAMAGE_GLYPH), color: Style.STAT }
    ],
    gauges: joined([rate(Locale.HIT, stats.rangedHit, MELEE_HIT_CAP, .RangedHit), rate(Locale.CRIT, stats.rangedCrit, CRIT_CAP, .RangedCrit)], skillGauges(skill, nil, skills)),
    rows: [speed]
  }
}

// The spells of a class that casts: a card per school its damage spells use, the greatest first and lit, then its
// healing where it heals; spell hit and crit; penetration and the mana regained while casting.
function spells(stats: Stats, classTag: String): Section | nil {
  const casting = CASTING[classTag]
  if (casting == nil) { return nil }
  const schools = casting.schools.map(school => school)
  schools.sort((a, b) => (stats.schoolDamage[a - 1] ?? 0) > (stats.schoolDamage[b - 1] ?? 0))
  const cards: Array<Figure> = []
  for (index, school of schools) {
    cards.push({ label: "", value: String.of(stats.schoolDamage[school - 1] ?? 0), glyph: glyph(school - 1), color: schoolColor(school), lit: index == 1, stat: .SpellDamage })
  }
  if (casting.heals != 0) {
    cards.push({ label: "", value: String.of(stats.healing), glyph: glyph(HEAL_GLYPH), color: schoolColor(casting.heals), stat: .Healing })
  }
  return {
    title: Locale.SECTION_SPELLS,
    cards: cards,
    gauges: [rate(Locale.HIT, stats.spellHit, SPELL_HIT_CAP, .SpellHit), rate(Locale.CRIT, stats.spellCrit, CRIT_CAP, .SpellCrit)],
    rows: [
      { label: Locale.SPELL_PENETRATION, value: String.of(stats.spellPenetration), stat: .SpellPenetration },
      { label: Locale.CASTING_REGEN, value: String.of(stats.regen.floor()), unit: Locale.PER_FIVE, stat: .Regen }
    ]
  }
}

// The right column's sections in the order the class reads them: a caster's spells first, then melee and ranged;
// anyone else's melee and ranged, then their spells.
public function sectionsOf(stats: Stats, skills: Array<Skill>, classTag: String): Array<Section> {
  const sections: Array<Section> = []
  const magic = spells(stats, classTag)
  const caster = stats.intellect > stats.strength.max(stats.agility)
  if (caster && magic != nil) { sections.push(magic) }
  sections.push(melee(stats, skills))
  const shooting = ranged(stats, skills)
  if (shooting != nil) { sections.push(shooting) }
  if (!caster && magic != nil) { sections.push(magic) }
  return sections
}

// A straight cut in the wood, lit from above: the shaded upper edge, the depth, the lit lower lip; across (`upright`
// false) or down its box (true, the light from the left: the shade on its left, the lip on its right).
public class Groove implements Component {
  upright: Signal<Boolean>
  constructor(upright: Signal<Boolean> = false) {
    self.upright = upright
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.upright} columns={[Style.CUT_LINE, Style.CUT_LINE, Style.CUT_LINE]} rows={[{ fr: 1 }]}>
        <box background={Style.GROOVE_SHADE} />
        <box background={Style.GROOVE_DEPTH} />
        <box background={Style.GROOVE_LIP} />
      </box>
      <box $else>
        <box height={Style.CUT_LINE} background={Style.GROOVE_SHADE} />
        <box height={Style.CUT_LINE} background={Style.GROOVE_DEPTH} />
        <box height={Style.CUT_LINE} background={Style.GROOVE_LIP} />
      </box>
    }
  }
}

// A cut in the wood across the column, the title at its middle where it has one.
public class Cut implements Component {
  derived titled: Boolean = self.title != ""

  title: Signal<String>
  constructor(title: Signal<String> = "") {
    self.title = title
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.titled} columns={[{ fr: 1 }, "max-content", { fr: 1 }]} gap={2.5sp} yAlign={Align.Center}>
        <Groove />
        <text value={self.title} textSize={SECONDARY_TEXT} textColor={Style.DIM} wrap={.None} />
        <Groove />
      </box>
      <Groove $else />
    }
  }
}

// What a stat's view stands in: with the cursor on it, the stat's tooltip (its name and value, the game's words on it,
// its sources) stands beside it, and `tipped` tells the page which stat it is, so its sources light; a stat that feeds
// the one whose tooltip is open glows gold. A view of no stat (`stat` none) is a plain box.
public class StatSpot implements Component {
  // The stat under the cursor; none once the cursor leaves.
  public tipped: Event<Stat | nil> = new Event()

  state hovered = false
  derived open: Boolean = self.hovered && self.stat != nil
  derived glows: Boolean = self.stat != nil && self.shown.fed.any(s => s == self.stat)

  stat: Signal<Stat | nil>
  title: Signal<String>
  shown: Signal<Breakdown>
  constructor(stat: Signal<Stat | nil>, title: Signal<String>, shown: Signal<Breakdown>) {
    self.stat = stat
    self.title = title
    self.shown = shown
  }

  onEnter(mut self) {
    self.hovered = true
    self.tipped.emit(peek self.stat)
  }

  onLeave(mut self) {
    self.hovered = false
    self.tipped.emit(nil)
  }

  public render(self): Template {
    return $ltml {
      <box @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <slot />
        <box $if={self.glows} position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             border={Style.SOURCE_RIM} background={Style.SOURCE_GLOW} zLevel={3} />
        <Tip $if={self.open} title={self.title} text={self.shown.text} sections={self.shown.sections} />
      </box>
    }
  }
}

// A gauge: the name, the channel filled up to the value's share of the cap, the value at the right.
public class StatGauge implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived fill: BarFill = { value: (self.gauge.value / self.gauge.cap).max(0).min(1), color: self.gauge.tone }
  derived ink: Color = self.gauge.value == 0 ? Style.DIM : BRIGHT_TEXT
  derived title: String = `${self.gauge.label} ${self.gauge.text}`

  gauge: Signal<Gauge>
  shown: Signal<Breakdown>
  constructor(gauge: Signal<Gauge>, shown: Signal<Breakdown> = NO_BREAKDOWN) {
    self.gauge = gauge
    self.shown = shown
  }

  onTipped(self, stat: Stat | nil) { self.tipped.emit(stat) }

  public render(self): Template {
    return $ltml {
      <StatSpot stat={self.gauge.stat} title={self.title} shown={self.shown} @tipped={self.onTipped}>
        <box columns={[Style.GAUGE_LABEL, { fr: 1 }, Style.GAUGE_VALUE]} gap={2.5sp} yAlign={Align.Center}>
          <text value={self.gauge.label} textSize={SECONDARY_TEXT} textColor={BRIGHT_TEXT} wrap={.None} />
          <box>
            <box height={Style.CHANNEL} background={Style.TROUGH} fill={self.fill} />
            <box height={Style.CUT_LINE} background={Style.GROOVE_LIP} />
          </box>
          <text value={self.gauge.text} textFont={TextFont.Numbers} textColor={self.ink} textAlign={TextAlign.End}
                wrap={.None} />
        </box>
      </StatSpot>
    }
  }
}

// A line: the name on the left, the value on the right with its unit dimmed after it.
public class StatRow implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived ink: Color = self.row.value == "0" ? Style.DIM : BRIGHT_TEXT
  derived title: String = `${self.row.label} ${self.row.value}${self.row.unit}`

  row: Signal<Row>
  shown: Signal<Breakdown>
  constructor(row: Signal<Row>, shown: Signal<Breakdown> = NO_BREAKDOWN) {
    self.row = row
    self.shown = shown
  }

  onTipped(self, stat: Stat | nil) { self.tipped.emit(stat) }

  public render(self): Template {
    return $ltml {
      <StatSpot stat={self.row.stat} title={self.title} shown={self.shown} @tipped={self.onTipped}>
        <box columns={[{ fr: 1 }, "max-content", "max-content"]} gap={1sp} yAlign={Align.Center}>
          <text value={self.row.label} textSize={SECONDARY_TEXT} textColor={Style.INK} wrap={.None} />
          <text value={self.row.value} textFont={TextFont.Numbers} textColor={self.ink} wrap={.None} />
          <text value={self.row.unit} textSize={SECONDARY_TEXT} textColor={Style.DIM} wrap={.None} />
        </box>
      </StatSpot>
    }
  }
}

// A card: a dark field, the picture in its socket on the left, the name over the value beside it.
public class StatCard implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived labelled: Boolean = self.figure.label != ""
  derived glyphShade: Number = self.figure.lit ? 1 : 0.7
  derived title: String = self.titleOf()

  figure: Signal<Figure>
  shown: Signal<Breakdown>
  constructor(figure: Signal<Figure>, shown: Signal<Breakdown> = NO_BREAKDOWN) {
    self.figure = figure
    self.shown = shown
  }

  // A card without a label (a school's spell damage) is named by its stat.
  titleOf(self): String {
    const stat = self.figure.stat
    const name = self.figure.label != "" ? self.figure.label : stat != nil ? statName(stat) : ""
    return `${name} ${self.figure.value}`
  }

  onTipped(self, stat: Stat | nil) { self.tipped.emit(stat) }

  public render(self): Template {
    return $ltml {
      <StatSpot stat={self.figure.stat} title={self.title} shown={self.shown} @tipped={self.onTipped}>
        <box columns={[Style.SOCKET, { fr: 1 }]} gap={2.5sp} padding={2sp} background={Style.CARD} yAlign={Align.Center}>
          <box width={Style.SOCKET} height={Style.SOCKET} background={Style.SOCKET_FLOOR} xAlign={Align.Center} yAlign={Align.Center}>
            <box width={Style.GLYPH} height={Style.GLYPH} background={self.figure.glyph} tint={self.figure.color}
                 opacity={self.glyphShade} />
          </box>
          <box>
            <text $if={self.labelled} value={self.figure.label} textSize={SECONDARY_TEXT} textColor={Style.DIM} lineHeight={Style.TIGHT}
                  wrap={.None} />
            <text value={self.figure.value} textSize={TITLE_TEXT} textFont={TextFont.Numbers} textColor={BRIGHT_TEXT}
                  lineHeight={Style.TIGHT} wrap={.None} />
          </box>
        </box>
      </StatSpot>
    }
  }
}

// A section: its cut and title, then a padded group of its cards, its gauges set a little further off, its lines.
public class SectionView implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived columns: Integer = self.section.cards.length.max(2)
  derived carded: Boolean = self.section.cards.length > 0

  section: Signal<Section>
  shown: Signal<Breakdown>
  constructor(section: Signal<Section>, shown: Signal<Breakdown> = NO_BREAKDOWN) {
    self.section = section
    self.shown = shown
  }

  onTipped(self, stat: Stat | nil) { self.tipped.emit(stat) }

  public render(self): Template {
    return $ltml {
      <box gap={2.5sp}>
        <Cut title={self.section.title} />
        <box gap={2sp} padding={Style.SECTION_PAD}>
          <box $if={self.carded} columns={self.columns} gap={2.5sp} padding={Style.CARDS_PAD}>
            <StatCard $for={card of self.section.cards} figure={card} shown={self.shown} @tipped={self.onTipped} />
          </box>
          <box gap={1.5sp}>
            <StatGauge $for={g of self.section.gauges} gauge={g} shown={self.shown} @tipped={self.onTipped} />
          </box>
          <box gap={0.5sp}>
            <StatRow $for={row of self.section.rows} row={row} shown={self.shown} @tipped={self.onTipped} />
          </box>
        </box>
      </box>
    }
  }
}

// A main stat: the big number over its three letters; its tooltip names it in full.
public class MainStat implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived title: String = `${self.main.label} ${self.main.value}`

  main: Signal<Main>
  shown: Signal<Breakdown>
  constructor(main: Signal<Main>, shown: Signal<Breakdown> = NO_BREAKDOWN) {
    self.main = main
    self.shown = shown
  }

  onTipped(self, stat: Stat | nil) { self.tipped.emit(stat) }

  public render(self): Template {
    return $ltml {
      <StatSpot stat={self.main.stat} title={self.title} shown={self.shown} @tipped={self.onTipped}>
        <box gap={0.5sp} xAlign={Align.Center} padding={Style.MAIN_PAD}>
          <text value={String.of(self.main.value)} textSize={Style.MAIN_TEXT} textFont={TextFont.Numbers}
                textColor={BRIGHT_TEXT} wrap={.None} />
          <text value={self.main.short} textSize={SECONDARY_TEXT} textColor={Style.DIM} wrap={.None} />
        </box>
      </StatSpot>
    }
  }
}

// A resistance's column: the value, the bar filling from the bottom, the picture under it.
public class ResistColumn implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived fill: BarFill = { value: (self.resist.value / self.resist.cap).min(1), color: self.resist.color, from: FillFrom.Bottom }
  derived ink: Color = self.resist.value == 0 ? Style.DIM : BRIGHT_TEXT
  derived title: String = `${statName(self.resist.stat)} ${self.resist.value}`

  resist: Signal<Resist>
  shown: Signal<Breakdown>
  constructor(resist: Signal<Resist>, shown: Signal<Breakdown> = NO_BREAKDOWN) {
    self.resist = resist
    self.shown = shown
  }

  onTipped(self, stat: Stat | nil) { self.tipped.emit(stat) }

  public render(self): Template {
    return $ltml {
      <StatSpot stat={self.resist.stat} title={self.title} shown={self.shown} @tipped={self.onTipped}>
        <box gap={1sp} xAlign={Align.Center}>
          <text value={String.of(self.resist.value)} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers}
                textColor={self.ink} wrap={.None} />
          <box width={Style.RESIST_WIDTH} height={Style.RESIST_HEIGHT} background={Style.TROUGH} fill={self.fill} />
          <box width={Style.RESIST_ICON} height={Style.RESIST_ICON} background={self.resist.glyph} tint={self.resist.color} />
        </box>
      </StatSpot>
    }
  }
}

// A pool's bar: full in its colour, the amount at its middle and what it regains at its right; the stat it shows
// (health, mana) its tooltip's.
public class PoolBar implements Component {
  public tipped: Event<Stat | nil> = new Event()

  derived full: BarFill = { value: self.filled, color: self.color }
  derived regained: Boolean = self.regen != ""
  derived title: String = self.stat != nil ? `${statName(self.stat ?? .Health)} ${self.amount}` : ""

  amount: Signal<String>
  color: Signal<Color>
  regen: Signal<String>
  // How much of the bar is full: rage is empty out of a fight.
  filled: Signal<Number>
  stat: Signal<Stat | nil>
  shown: Signal<Breakdown>
  constructor(amount: Signal<String>, color: Signal<Color>, regen: Signal<String> = "", filled: Signal<Number> = 1,
    stat: Signal<Stat | nil> = nil, shown: Signal<Breakdown> = NO_BREAKDOWN) {
    self.amount = amount
    self.color = color
    self.regen = regen
    self.filled = filled
    self.stat = stat
    self.shown = shown
  }

  onTipped(self, stat: Stat | nil) { self.tipped.emit(stat) }

  // The fill lies under the texts: a box of its own, first.
  public render(self): Template {
    return $ltml {
      <StatSpot stat={self.stat} title={self.title} shown={self.shown} @tipped={self.onTipped}>
        <box height={Style.BAR} background={Style.TROUGH} xAlign={Align.Center} yAlign={Align.Center}>
          <box position={Position.Absolute} top={0ui} right={0ui} bottom={0ui} left={0ui} fill={self.full} />
          <box zLevel={2}>
            <text value={self.amount} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers} textColor={BRIGHT_TEXT}
                  wrap={.None} />
          </box>
          <box $if={self.regained} position={Position.Absolute} top={0ui} right={6dp} bottom={0ui} yAlign={Align.Center}
               zLevel={2}>
            <text value={self.regen} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers} textColor={Style.INK}
                  wrap={.None} />
          </box>
        </box>
      </StatSpot>
    }
  }
}
