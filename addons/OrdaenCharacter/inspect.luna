// Another player inspected: who it is, what it wears, its talents and its honor, read once the server answered
// (`INSPECT_READY`), and the pages of the inspect window that are its own: the talents, only shown, and the honor. Its
// character page is the character window's (`GearPage` of the unit), with the stats estimated (`estimate.luna`).
import Client from "$client"
import Game from "$game"
import { Align, Track } from "$ltml"
import Runtime from "$runtime"
import { Component, SECONDARY_TEXT, TITLE_TEXT, TalentTreeView } from "Ordaen"
import { LineWords } from "@/lines"
import Locale from "@/locales"
import { Who, Worn, clientWords, wornBy } from "@/sheet"
import Style from "@/style"

const TREES: array<Track> = [{ fr: 1 }, { fr: 1 }, { fr: 1 }]
const HONOR_ROWS: array<Track> = ["max-content", "max-content"]
// The client's number of the first rank (`Enum.PvPRanks.Rank_1`): a rank's title is its text by that count.
const FIRST_RANK = 5
const FEMALE = 3

// The inspected player's honor: the rank with its title, the honor in it and what the next needs, and the honorable
// kills today and in all.
public struct Honor {
  const rank: integer = 0
  const title: string = ""
  const current: integer = 0
  const next: integer = 0
  const today: integer = 0
  const lifetime: integer = 0
}

// Who the inspected player is and what it wears.
public struct Inspected {
  const who: Who = { name: "", level: 0, race: "", className: "" }
  const classTag: string = ""
  const guild: string = ""
  const worn: array<Worn> = []
}

// What the window asks of the client about the player inspected.
public trait Inspector {
  // Whether the unit may be inspected (a player, near enough).
  public canInspect(unit: string): boolean
  // The server asked about the unit; `INSPECT_READY` with its guid says it answered.
  public mut ask(unit: string)
  public guidOf(unit: string): string | nil
  public read(unit: string): Inspected
  public honor(unit: string): Honor
  // Ctrl+Left-click on a slot: the item tried on in the dressing room.
  public mut tryOn(unit: string, slot: integer)
  // The window closed: the server's answer let go.
  public mut clear()
}

public class ClientInspector implements Inspector {
  const words: LineWords = clientWords()

  public canInspect(unit: string): boolean { return Client::CanInspect(unit) }

  public mut ask(unit: string) { Client::NotifyInspect(unit) }

  public guidOf(unit: string): string | nil { return Client::UnitGUID(unit) }

  public read(unit: string): Inspected {
    let (race, scene, _) = Client::UnitRace(unit)
    let (className, classTag, _) = Client::UnitClass(unit)
    let (guild, _, _) = Client::GetGuildInfo(unit)
    let (name, _) = Client::UnitName(unit)
    const worn: array<Worn> = []
    for (slot of 0..19) { worn.push(wornBy(unit, slot, self.words)) }
    return {
      who: { name: name, level: Client::UnitLevel(unit).floor(), race: race ?? "", className: className ?? "", scene: scene ?? "" },
      classTag: classTag ?? "",
      guild: guild ?? "",
      worn: worn
    }
  }

  public honor(unit: string): Honor {
    let (today, _, _, _, lifetime, _, rank, current, next) = Client::GetInspectHonorData()
    const level = (rank ?? 0).floor()
    let (faction, _) = Client::UnitFactionGroup(unit, nil)
    const side = faction == "Alliance" ? 1 : 0
    const female = Client::UnitSex(unit) == FEMALE ? "_FEMALE" : ""
    const key = `PVP_RANK_${FIRST_RANK + level - 1}_${side}`
    const title = level > 0 ? Runtime::text(key + female) ?? Runtime::text(key) ?? "" : Runtime::text("PVP_RANK_0_NAME") ?? ""
    return {
      rank: level, title: title, current: (current ?? 0).floor(), next: (next ?? 0).floor(), today: today.floor(),
      lifetime: lifetime.floor()
    }
  }

  public mut tryOn(unit: string, slot: integer) {
    const link = Client::GetInventoryItemLink(unit, slot)
    if (link != nil) { _ = Client::DressUpItemLink(link) }
  }

  public mut clear() { Client::ClearInspectPlayer() }
}

// «Таланты»: the inspected player's trees side by side, only shown.
public class InspectTalents implements Component {
  derived empty: boolean = self.trees.length == 0

  trees: Signal<array<Game::TalentTree>>
  constructor(trees: Signal<array<Game::TalentTree>>) {
    self.trees = trees
  }

  public render(): Template {
    return $ltml {
      <box $if={self.empty} xAlign={Align::Center} yAlign={Align::Center}>
        <text value={Locale::INSPECT_NO_TALENTS} textColor={Style::DIM} />
      </box>
      <box $else columns={TREES} gap={1sp}>
        <TalentTreeView $for={tree of self.trees} $key={tree.id} tree={tree} />
      </box>
    }
  }
}

// «PvP»: the rank with its title and the honor towards the next, then the honorable kills today and in all.
public class InspectHonor implements Component {
  derived rankText: string = self.honor.rank > 0 ? Locale::PVP_RANK.format(self.honor.rank, self.honor.title) : self.honor.title
  derived progress: string = Locale::PVP_PROGRESS.format(self.honor.current, self.honor.next)
  derived today: string = string::of(self.honor.today)
  derived lifetime: string = string::of(self.honor.lifetime)

  honor: Signal<Honor>
  constructor(honor: Signal<Honor>) {
    self.honor = honor
  }

  public render(): Template {
    return $ltml {
      <box gap={4sp} padding={Style::SECTION_PAD}>
        <box gap={1sp}>
          <text value={self.rankText} textSize={TITLE_TEXT} textColor={Style::GOLD} />
          <text value={self.progress} textSize={SECONDARY_TEXT} textColor={Style::DIM} />
        </box>
        <box columns={HONOR_ROWS} gap={2sp}>
          <text value={Locale::PVP_TODAY} textColor={Style::DIM} />
          <text value={self.today} textColor={Style::INK} />
          <text value={Locale::PVP_LIFETIME} textColor={Style::DIM} />
          <text value={self.lifetime} textColor={Style::INK} />
        </box>
      </box>
    }
  }
}
