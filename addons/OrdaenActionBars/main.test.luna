import Client from "$client"
import Events from "$events"
import Game from "$game"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import { ALWAYS, Visibility, Visible } from "Ordaen"
import { Bar, buttonName } from "@/bars"
import { BarChoice, Choices, SPECS, defaultChoice } from "@/choices"
import { ActionBars, Shown } from "@/main"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
// What a bar is handed by its module: no keys bound, its defaults, no form.
class Holder {
  state keys: Map<String, String> = {}
  state choices: Map<String, BarChoice> = {}
  state defaults: Map<String, BarChoice> = {}
  state paging: String = "1"
  state forms: Integer = 0
}

// Shown out of a fight, hidden in one.
const PEACEFUL: Visibility = { combat: { visible: Visible.Hide, opacity: 0 }, ..ALWAYS }

// One of the game's bars, shown or hidden.
function gameBar(name: String, shown: Boolean): any Client.Frame {
  const made = Client.CreateFrame("Frame", name, Client.UIParent, nil)
  if (!shown) { made.Hide() }
  return made
}

// The client's frame of that name made last, from `at` on.
function lastNamed(name: String, at: any Client.Frame | nil, found: any Client.Frame | nil): any Client.Frame | nil {
  if (at == nil) { return found }
  return lastNamed(name, Client.EnumerateFrames(at), at.GetName() == name ? at : found)
}

// The client's button of a bar, by its name.
function button(id: String, index: Integer): any Client.Frame {
  const name = buttonName(id, index)
  return lastNamed(name, Client.EnumerateFrames(nil), nil) ?? panic(`the module made ${name}`)
}

// The module Ordaen started at login is turned off: the test's own is the only one, made after what the test set.
function alone() {
  const running = (peek Ordaen.modules).find(module => module.title == "Ordaen Action Bars")
  if (running == nil) { return }
  const addon = Runtime.Addon.of(running) ?? panic("Ordaen's module is an addon's root")
  Ordaen.turn(addon, false)
  Test.flush()
}

// The ids of the bars drawn, in their order.
function drawn(bars: Array<Shown>): String {
  return bars.map(shown => shown.spec.id).join(",")
}

// A bar's settings with one change.
function changed(values: Choices, id: String, change: (choice: mut BarChoice) => nil): BarChoice {
  const spec = SPECS.find(spec => spec.id == id) ?? panic("a bar of the module")
  const choice = (values.bars[id] ?? defaultChoice(spec, true)).clone()
  change(mut choice)
  return choice
}

test "the bars drawn are Панель 1, those the character's settings show and the pet's, and the game's are put away" {
  alone()
  const main = gameBar("MainActionBar", true)
  const bottomLeft = gameBar("MultiBarBottomLeft", true)
  Game.frames.MainActionBar = main
  Game.frames.MultiBarBottomLeft = bottomLeft
  const bars = new ActionBars()
  Test.mount(nil, SCREEN)
  Test.flush()
  // The stand-in's new character shows the two bottom bars, and has no forms.
  Test.expect(drawn(bars.bars) == "1,2,3,pet")
  Test.expect(!main.IsVisible())
  // The client shows its bars again (entering the world, their toggles): they stay unseen.
  bottomLeft.Show()
  Test.flush()
  Test.expect(!bottomLeft.IsVisible())
}

test "turned on in a fight, the module makes its bars as the fight ends" {
  alone()
  Test.mount(nil, SCREEN)
  Test.combat(true)
  const bars = new ActionBars()
  Test.flush()
  Test.expect(drawn(bars.bars) == "")
  Test.combat(false)
  Test.flush()
  Test.expect(bars.ready)
  Test.expect(drawn(bars.bars) == "1,2,3,pet")
}

test "with Bartender4 loaded the bars stay off, and the game's are left as they are" {
  alone()
  Client.C_AddOns.IsAddOnLoaded = name => {
    return name == "Bartender4", true
  }
  const main = gameBar("MainActionBar", true)
  Game.frames.MainActionBar = main
  const bars = new ActionBars()
  Test.mount(nil, SCREEN)
  Test.flush()
  Test.expect(bars.conflict && drawn(bars.bars) == "")
  Test.expect(main.IsShown() && main.GetParent() == Client.UIParent)
}

test "a key of the game's bindings presses our button in its place, and the button shows its key" {
  alone()
  _ = Client.SetBinding("SHIFT-2", "MULTIACTIONBAR1BUTTON2", nil)
  const bars = new ActionBars()
  Test.mount(nil, SCREEN)
  Test.flush()
  Test.expect(Test.page().text("S2").shown())
  // Each bar's buttons stand on its own slots: Панель 2's second is slot 62.
  Test.expect(Test.keyBound("SHIFT-2"))
  Test.expect(Test.performed().join(", ") == "action 62")
  // The player binds another key: the buttons follow.
  _ = Client.SetBinding("Q", "MULTIACTIONBAR1BUTTON3", nil)
  Events.UPDATE_BINDINGS.emit()
  Test.expect(Test.keyBound("Q"))
  Test.expect(Test.page().text("Q").shown())
  Test.expect(Test.performed().join(", ") == "action 63")
}

test "Панель 1 shows a form's page while the player is in it, in a fight too, unless the player keeps it as it is" {
  alone()
  const bars = new ActionBars()
  Test.mount(nil, SCREEN)
  Test.flush()
  const first = button("1", 1)
  Test.expect(first.GetAttribute("actionpage") == "1")
  Test.stance(1)
  Test.expect(first.GetAttribute("actionpage") == "7")
  Test.combat(true)
  Test.stance(3)
  Test.expect(first.GetAttribute("actionpage") == "9")
  Test.combat(false)
  bars.settings.change((values: mut Choices): nil => {
    values.unpaged["3"] = true
  })
  Test.flush()
  Test.expect(first.GetAttribute("actionpage") == "1")
}

test "the pet's buttons show while there is a pet, in a fight too" {
  alone()
  const bars = new ActionBars()
  Test.mount(nil, SCREEN)
  Test.flush()
  const first = button("pet", 1)
  Test.expect(!first.IsShown())
  Test.combat(true)
  Test.pet(true)
  Test.expect(first.IsShown())
  Test.combat(false)
}

test "a bar's buttons, rows and look change as chosen, and in a fight only as it ends" {
  alone()
  _ = Client.SetBinding("F6", "MULTIACTIONBAR1BUTTON6", nil)
  const bars = new ActionBars()
  Test.mount(nil, SCREEN)
  Test.flush()
  Test.combat(true)
  bars.settings.change((values: mut Choices): nil => {
    values.bars["2"] = changed(values, "2", (choice: mut BarChoice): nil => {
      choice.buttons = 5
    })
  })
  Test.flush()
  Test.expect(button("2", 6).IsShown())
  Test.combat(false)
  Test.flush()
  Test.expect(!button("2", 6).IsShown())
  Test.expect(!Test.page().text("F6").shown())
  bars.settings.change((values: mut Choices): nil => {
    values.bars["2"] = changed(values, "2", (choice: mut BarChoice): nil => {
      choice.on = false
    })
  })
  Test.flush()
  Test.expect(drawn(bars.bars) == "1,3,pet")
}

test "a bar the player never moved stands above what keeps the bottom edge, the highest of them" {
  alone()
  const holder = new Holder()
  const spec = SPECS[1]
  const bar = new Bar(spec, 2, holder.choices, holder.defaults, holder.keys, holder.paging, holder.forms)
  // Higher than the bottom panel, whatever it keeps: the highest decides.
  Ordaen.keepBottom("Ledge", 1000ui)
  const above = bar.home.y ?? 0ui
  Ordaen.keepBottom("Shelf", 1100ui)
  Test.expect(bar.home.y == above - 100ui)
  Ordaen.keepBottom("Shelf", 0ui)
  Ordaen.keepBottom("Ledge", 0ui)
  Test.expect((bar.home.y ?? 0ui) > above + 900ui)
}

test "a bar fades as its visibility says: hidden in a fight, its buttons keep their keys" {
  alone()
  _ = Client.SetBinding("F7", "ACTIONBUTTON1", nil)
  const bars = new ActionBars()
  Test.mount(nil, SCREEN)
  Test.flush()
  bars.settings.change((values: mut Choices): nil => {
    values.bars["1"] = changed(values, "1", (choice: mut BarChoice): nil => {
      choice.visibility = PEACEFUL
    })
  })
  Test.expect(Test.page().text("F7").opacity() == 1)
  Test.combat(true)
  Test.expect(Test.page().text("F7").opacity() == 0)
  Test.expect(Test.keyBound("F7"))
  Test.combat(false)
  Test.expect(Test.page().text("F7").opacity() == 1)
}

test "turned off in a fight, the buttons fade at once, and are put away with the keys as it ends" {
  alone()
  _ = Client.SetBinding("F8", "ACTIONBUTTON2", nil)
  const bars = new ActionBars()
  Test.mount(nil, SCREEN)
  Test.flush()
  const second = button("1", 2)
  Test.combat(true)
  destroy bars
  Test.flush()
  Test.expect(second.GetAlpha() == 0 && second.IsShown())
  Test.combat(false)
  Test.flush()
  Test.expect(!second.IsShown())
  Test.expect(Client.GetBindingAction("F8", true) == "ACTIONBUTTON2")
}
