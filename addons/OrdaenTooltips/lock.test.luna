// What its parts open

test "a locked tooltip underlines the parts that open something; one not locked underlines nothing" {
  Game.spells.cost = (id: Integer): Game.SpellCost | nil => ({ amount: 65 })
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(frostbolt())
  Test.pass(0.1)
  Test.expect(Test.page().window("Frostbolt").box(TERM_DASH).count() == 0)
  Test.pass(CHARGED)
  // The range's cell and the cast's: the cost names no term.
  Test.expect(locked().box(TERM_DASH).count() == 2)
}

test "the cursor on a cell that names a term opens the term beside it, under the help cursor" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(frostbolt())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("30 yd range").hover()
  Test.expect(reads(Test.page().window("Range"), "Range | How far from the target you can use it."))
  Test.expect(Test.cursor() == HELP)
}

// A player of a side, on the screen: their tooltip names the side.
function sided(faction: String): Game.UnitInfo {
  return {
    name: "Varian", player: true, dead: false, ghost: false, afk: false, dnd: false, pvp: false, level: 60,
    faction: faction, sameFaction: true, inParty: false, friend: false, ignored: false, tapped: false,
    classification: "normal"
  }
}

test "a player's side opens its term: the Alliance's, the Horde's, and none for a side Ordaen doesn't know" {
  let faction = "Alliance"
  Game.units.of = (unit: String): Game.UnitInfo | nil => sided(faction)
  Test.mount(new Elsewhere(), SCREEN)
  for (side of ["Alliance", "Horde"]) {
    faction = side
    Game.tooltip.main = inSlot({ kind: 2, about: side, lines: [{ left: "Varian", kind: 2, unit: "mouseover" }] })
    Test.pass(CHARGED)
    Game.tooltip.main = hidden()
    locked().text(side).hover()
    Test.expect(reads(Test.page().window(`Faction: ${side}.`), `${side} | Faction: ${side}.`))
    locked().button(CLOSE).click()
  }
  faction = "Neutral"
  Game.tooltip.main = inSlot({ kind: 2, about: "Neutral", lines: [{ left: "Varian", kind: 2, unit: "mouseover" }] })
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("Neutral").hover()
  Test.expect(Test.surfaces().length == 1)
}

test "the cursor off the cell takes its term away and keeps the lock" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(frostbolt())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("30 yd range").hover()
  locked().text("Frostbolt").hover()
  Test.pass(0.5)
  Test.expect(!Test.page().window("Range").shown() && isLocked() && Test.cursor() == nil)
}

test "the cursor on the term a cell opened keeps the lock" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(frostbolt())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("2.5 sec").hover()
  Test.pass(1)
  Test.expect(isLocked())
}

test "a piece of a locked tooltip's title opens its term" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot({
    kind: 0, id: 9010, about: "item:9010", lines: [{ left: "Sword", kind: 22 }, { left: "Soulbound", kind: 20 }]
  })
