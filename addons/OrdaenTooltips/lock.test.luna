test "a worn item compared with a locked one opens its terms too, and the cursor going onto it keeps the lock" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.compared = [{ kind: 0, lines: [{ left: "Worn Shield", kind: 22 }, { left: "30 Armor", kind: 0 }] }]
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("Sword").hover()
  locked().text("30").hover()
  Test.pass(0.5)
  Test.expect(isLocked())
  Test.expect(reads(Test.page().window(ARMOUR), `Armour 30 | ${ARMOUR}`))
}

test "a building of the camp opens its whole sentence" {
