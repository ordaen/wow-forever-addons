// The lock as the player meets it: a tooltip held under the cursor fills a bar, then locks, and stays for the cursor
// to come onto it; there what its parts name opens beside them. The cursor's place is the player's: on the locked
// tooltip (a part of it hovered), on its source (the game shows the tooltip it is about again), on another thing
// with a tooltip (the game shows that), or elsewhere on the screen.
import Client from "$client"
import Game from "$game"
import { Key } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { TERM_DASH } from "Ordaen"
import root Tooltips from "OrdaenTooltips"
import { ItemKeys, ItemLines, Line } from "@/extend"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const SETTINGS = "Move mode"
// What a locked tooltip says in its bar's place, and its close button, the game's red X.
const LOCKED = "Locked — hover the underlined parts"
const CLOSE: Asset = "Interface/Buttons/UI-Panel-MinimizeButton-Up"
// The lock's bar: its dark track, and the gold that fills it.
const TRACK: Color = Color.hex("#00000073")
// The cursor on a part that opens something.
const HELP = "Interface/Cursor/QuestTurnIn"
// What armour is, as its term says it.
const ARMOUR = "Reduces the |cffffffffphysical damage|r you take."

// A frame of the game's, by its name, at a place on the screen.
function frame(kind: String, name: String, x: Number, y: Number, width: Number, height: Number): any Client.Frame {
  const made = Client.CreateFrame(kind, name, Client.C_UI.GetUIParent(), nil)
  made.SetSize(width, height)
  made.SetPoint("TOPLEFT", Client.C_UI.GetUIParent(), "TOPLEFT", x, -y)
  return made
}

// The game's tooltip for a thing in a bag's slot at the screen's top right: ours stands under the slot.
function inSlot(data: Game.TooltipData): Game.ShownTip {
  return {
    shown: true, data: data, owner: frame("Button", "ContainerFrame1Item3", 1300, 200, 40, 40),
    ownerName: "ContainerFrame1Item3", placeable: true, ownerHigh: true, ownerRight: true,
    corner: frame("Frame", "GameTooltip", 1300, 720, 200, 80), below: false, right: true, home: Client.UIParent,
    homeBelow: false, homeRight: true
  }
}

// The game's tooltip gone.
function hidden(): Game.ShownTip {
  return { shown: false, ..inSlot({ lines: [] }) }
}

function sword(): Game.TooltipData {
  return { kind: 0, id: 9010, about: "item:9010", lines: [{ left: "Sword", kind: 22 }] }
}

function shield(): Game.TooltipData {
  return { kind: 0, id: 9011, about: "item:9011", lines: [{ left: "Shield", kind: 22 }] }
}

// A spell whose band names terms: its range's cell and its cast's.
function frostbolt(): Game.TooltipData {
  return {
    kind: 1, id: 116, about: "spell:116",
    lines: [
      { left: "Frostbolt", kind: 13 },
      { left: "65 Mana", right: "30 yd range", kind: 0 },
      { left: "2.5 sec cast", kind: 0 }
    ]
  }
}

// Long enough under the cursor to lock.
const CHARGED = 1.3

// The locked tooltip, by its hint.
function locked(): Test.Part {
  return Test.page().window(LOCKED)
}

// Whether a tooltip is locked: its hint shows.
function isLocked(): Boolean {
  return Test.page().text(LOCKED).shown()
}

// A place on the screen with nothing of the tooltips' on it: where the cursor goes when it goes elsewhere.
class Elsewhere {
  public render(self): Template {
    return $ltml { <text value={"Elsewhere"} /> }
  }
}

// The cursor somewhere on the screen with nothing of ours under it.
function elsewhere() {
  Test.page().text("Elsewhere").hover()
}

// Whether a part's texts read exactly this, joined by « | »: where they don't, the test fails with what they read.
function reads(part: Test.Part, expected: String): Boolean {
  const read = part.texts().join(" | ")
  if (read != expected) { panic(`it reads «${read}», not «${expected}»`) }
  return true
}

// The charge

test "a tooltip under a passing cursor shows no bar" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(0.1)
  Test.expect(!Test.page().window("Sword").box(TRACK).shown())
}

test "a tooltip held under the cursor fills its bar, half of it half a second in" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(0.68)
  const track = Test.page().window("Sword").box(TRACK).rect()
  const filled = Test.page().window("Sword").box(TRACK).fill().rect
  const share = (filled.right - filled.left) / (track.right - track.left)
  Test.expect(share > 0.45 && share < 0.55)
}

test "the game showing the tooltip again on the way keeps its charge" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(0.6)
  Game.tooltip.main = hidden()
  Test.pass(0.05)
  Game.tooltip.main = inSlot(sword())
  Test.pass(0.7)
  Test.expect(isLocked())
}

test "a tooltip charged in full locks: its hint in the bar's place, and its close button" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Test.expect(reads(locked(), `Sword | ${LOCKED}`))
  Test.expect(locked().button(CLOSE).shown() && !locked().box(TRACK).shown())
}

// A hotkey another module has for every item.
class Keyed implements ItemKeys {
  public keys(self, item: Integer, link: String): Array<String> { return ["Alt+Left-click: hold"] }
}

test "a locked tooltip's hint stands a section under its hotkeys, as under any section" {
  Test.mount(new Elsewhere(), SCREEN)
  const added = Tooltips.keys.add(new Keyed())
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  const key = locked().text("Alt+Left-click: hold").rect()
  const hint = locked().text(LOCKED).rect()
  // A section is 3sp; the hint stands in the middle of the bar's row, which is a little higher than it.
  const section = Ordaen.lengthOf(3sp) / 1ui
  Test.expect(hint.top - key.bottom < 1.5 * section)
  destroy added
}

// The slot under the cursor, as a bags' module tells it: its hotkey and its note are said only while it is hovered.
class OnSlot {
  public state hovered = true
}

class SlotKey implements ItemKeys {
  const slot: OnSlot
  constructor(slot: OnSlot) { self.slot = slot }
  public keys(self, item: Integer, link: String): Array<String> { return self.slot.hovered ? ["Alt+Left-click: protect"] : [] }
}

class SlotNote implements ItemLines {
  const slot: OnSlot
  constructor(slot: OnSlot) { self.slot = slot }
  public lines(self, item: Integer, link: String): Array<Line> { return self.slot.hovered ? [{ left: "Protected from sorting" }] : [] }
}

test "the cursor gone from the slot onto the locked tooltip keeps the hotkeys and notes said of the slot" {
  Test.mount(new Elsewhere(), SCREEN)
  const slot = new OnSlot()
  const key = Tooltips.keys.add(new SlotKey(slot))
  const note = Tooltips.held.add(new SlotNote(slot))
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  const before = locked().text("Alt+Left-click: protect").rect()
  slot.hovered = false
  Game.tooltip.main = hidden()
  locked().text("Sword").hover()
  Test.pass(0.1)
  Test.expect(locked().text("Alt+Left-click: protect").rect().top == before.top)
  Test.expect(locked().text("Protected from sorting").shown())
  destroy key
  destroy note
}

test "a tooltip's title, one line, is as high as its letters: no line height round it" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(0.1)
  const title = Test.page().window("Sword").text("Sword")
  const box = title.rect()
  const letters = title.letters()
  Test.expect((box.bottom - box.top) - (letters.bottom - letters.top) < 0.5)
}

test "a locked tooltip stays once the game's is gone" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  Test.pass(1)
  Test.expect(isLocked())
}

test "a tooltip that locks keeps the game's own unseen while it stays" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  _ = Test.requests()
  Game.tooltip.main = hidden()
  Test.pass(1)
  Test.expect(!Test.requests().any(asked => asked == "Tooltip.hide false"))
}

test "a button's tooltip never charges" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = {
    ownerName: "CharacterMicroButton",
    ..inSlot({ plain: true, lines: [{ left: "Character Info", kind: 0 }] })
  }
  Test.pass(2)
  Test.expect(!Test.page().window("Character Info").box(TRACK).shown() && !isLocked())
}

test "with «Tooltips in tooltips» unticked for items an item never charges" {
  Test.mount(new Elsewhere(), SCREEN)
  Test.open("/ordaen")
  const settings = Test.page().window(SETTINGS)
  settings.button("Tooltips").click()
  settings.button("Items").click()
  settings.button("Tooltips in tooltips").click()
  Test.key(Key.Escape)
  Game.tooltip.main = inSlot(sword())
  Test.pass(2)
  Test.expect(!Test.page().window("Sword").box(TRACK).shown() && !isLocked())
}

// Where the cursor goes

test "the cursor on the locked tooltip keeps it, however long" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("Sword").hover()
  Test.pass(1)
  Test.expect(isLocked())
}

test "the cursor on its close button is on the locked tooltip" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().button(CLOSE).hover()
  Test.pass(1)
  Test.expect(isLocked())
}

test "the cursor off the locked tooltip and back within the grace keeps it" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("Sword").hover()
  elsewhere()
  Test.pass(0.1)
  locked().text("Sword").hover()
  Test.pass(0.3)
  Test.expect(isLocked())
}

test "the cursor off the locked tooltip for longer than the grace takes it away" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("Sword").hover()
  elsewhere()
  Test.pass(0.3)
  Test.expect(!isLocked() && !Test.page().window("Sword").shown())
}

// A button on the screen with nothing of the tooltips' on it, counting its presses: what a press elsewhere lands on.
class Pressed {
  public state presses = 0

  onPress(mut self) { self.presses += 1 }

  public render(self): Template {
    return $ltml {
      <box @pointerPress={self.onPress}>
        <text value={"Elsewhere"} />
      </box>
    }
  }
}

test "a press elsewhere takes the locked tooltip away at once, and still reaches what it was on" {
  const page = new Pressed()
  Test.mount(page, SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("Sword").hover()
  Test.page().text("Elsewhere").click()
  Test.expect(!isLocked() && !Test.page().window("Sword").shown() && page.presses == 1)
}

test "a press elsewhere takes a locked tooltip away before the cursor has come onto it" {
  const page = new Pressed()
  Test.mount(page, SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  Test.page().text("Elsewhere").click()
  Test.expect(!isLocked() && page.presses == 1)
}

test "a press on the locked tooltip keeps it" {
  Test.mount(new Pressed(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("Sword").click()
  Test.pass(1)
  Test.expect(isLocked())
}

test "a press on a term the locked tooltip opened keeps it" {
  Test.mount(new Pressed(), SCREEN)
  Game.tooltip.main = inSlot(frostbolt())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
  locked().text("30 yd range").hover()
  Test.page().window("Range").text("Range").click()
  Test.pass(1)
