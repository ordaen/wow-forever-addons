// Closed

test "a locked tooltip's close button unlocks it, its bar empty, and what was closed doesn't charge again while held" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  locked().button(CLOSE).click()
  Test.pass(0.05)
  Test.expect(!isLocked() && Test.page().window("Sword").shown())
  Test.pass(2)
  Test.expect(!isLocked() && !Test.page().window("Sword").box(TRACK).shown())
}

test "a tooltip closed locks again after the cursor left its source and came back" {
