test "the cursor off its source for longer than the grace, once it has been on the tooltip, takes it away" {
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot(sword())
  Test.pass(CHARGED)
  Game.tooltip.main = hidden()
