}

// A player as the game knows them, by the game's name for the unit: Jaina under the cursor, her target Ann.
function known(unit: String): Game.UnitInfo | nil {
  if (unit == "mouseover") {
    return {
      name: "Jaina", player: true, dead: false, ghost: false, afk: false, dnd: false, pvp: false, level: 60,
      inParty: false, friend: false, ignored: false, tapped: false, classification: "normal",
      target: { name: "Ann", color: Color.hex("#ffffff") }, sameFaction: true
    }
  }
  if (unit == "mouseovertarget") {
    return {
      name: "Ann", player: true, className: "Priest", dead: false, ghost: false, afk: false, dnd: false, pvp: false,
      level: 58, race: "Human", inParty: false, friend: false, ignored: false, tapped: false, classification: "normal",
      sameFaction: true
    }
  }
  return nil
}

test "a player's target opens the target's own tooltip" {
  Game.units.of = known
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot({ kind: 2, about: "unit:Jaina", lines: [{ left: "Jaina", kind: 2, unit: "mouseover" }] })
  Test.pass(CHARGED)
  locked().text("Ann").hover()
  Test.expect(reads(Test.page().window("Level 58"), "Ann | Priest | Level 58 | Human"))
}

test "a caster who is gone opens nothing" {
  Game.auras.shown = (data: Game.TooltipData): Game.AuraInfo | nil => ({
    harmful: true, source: "party3", sourceName: "Gone", stacks: 1, own: false, hostile: false
  })
  Test.mount(new Elsewhere(), SCREEN)
  Game.tooltip.main = inSlot({ kind: 7, id: 14914, about: "spell:14914", lines: [{ left: "Holy Fire", kind: 0 }] })
  Test.pass(CHARGED)
  const before = Test.page().texts().join(" | ")
  locked().text("Gone").hover()
  Test.expect(Test.page().texts().join(" | ") == before)
}

// A tooltip of each kind that locks, by the tab its «Tooltips in tooltips» is on: an item, an ability, an effect, a
// player, an NPC, a world object.
function ofKind(tab: String): Game.TooltipData {
  if (tab == "Items") { return sword() }
  if (tab == "Abilities") { return frostbolt() }
  if (tab == "Effects") { return { kind: 7, id: 1, about: "spell:1", lines: [{ left: "Renew", kind: 0 }] } }
  if (tab == "Objects") { return { kind: 4, about: "object", lines: [{ left: "Chest", kind: 0 }] } }
  return { kind: 2, about: tab, lines: [{ left: tab == "Players" ? "Jaina" : "Wolf", kind: 2, unit: tab }] }
}

// «Tooltips in tooltips» of a kind's tab clicked: it applies at once.
function lockOf(tab: String) {
  Test.open("/ordaen")
  const settings = Test.page().window(SETTINGS)
  settings.button("Tooltips").click()
  settings.button(tab).click()
  settings.button("Tooltips in tooltips").click()
  Test.key(Key.Escape)
}

function anyone(unit: String): Game.UnitInfo | nil {
  return {
    name: unit, player: unit == "Players", dead: false, ghost: false, afk: false, dnd: false, pvp: false, level: 10,
    inParty: false, friend: false, ignored: false, tapped: false, classification: "normal", sameFaction: true
  }
}

test "with «Tooltips in tooltips» unticked for abilities an ability never locks, and an item still does" {
  Test.mount(new Elsewhere(), SCREEN)
  lockOf("Abilities")
  Game.tooltip.main = inSlot(ofKind("Abilities"))
  Test.pass(CHARGED)
  Test.expect(!isLocked())
  Game.tooltip.main = inSlot(ofKind("Items"))
  Test.pass(CHARGED)
  Test.expect(isLocked())
}

