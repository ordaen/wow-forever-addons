  Game::tooltip.main = atButton("TalentMicroButton", text("Talents (N)"))
  Test::pass(SHOWS)
  Test::expect(reads(Test::page().window("Talents (N)"), "Talents (N)"))
}

test "the character's button tells the talent points not spent too, after the item level, its window holding the talents" {
