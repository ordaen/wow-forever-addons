// Ordaen Tooltips as the player meets it: while the game shows its tooltip, Ordaen's stands in its place, beside
// what it is about or in the screen's corner, and the game's own is kept unseen; a kind turned off, or one Ordaen's
// doesn't read, is the game's own. The micro menu's and the bags' buttons tell more than their names. What is
// chosen on the module's tabs of the settings (`/ordaen`, «Tooltips») is kept between sessions.
import Client from "$client"
import Game from "$game"
import { Key } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Tooltips from "OrdaenTooltips"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const SETTINGS = "Move mode"
// The colours a button's facts are in: a value, and a durability under a quarter.
const VALUE: Color = Color.hex("#f3e7cc")
const RED: Color = Color.hex("#ff4040")

// A frame of the game's, by its name, at a place on the screen.
function frame(kind: String, name: String, x: Number, y: Number, width: Number, height: Number): any Client.Frame {
  const made = Client.CreateFrame(kind, name, Client.C_UI.GetUIParent(), nil)
  made.SetSize(width, height)
  made.SetPoint("TOPLEFT", Client.C_UI.GetUIParent(), "TOPLEFT", x, -y)
  return made
}

// The game's own tooltip, in the screen's bottom right corner: 200 wide, its top at 720.
function corner(): any Client.Frame {
  return frame("Frame", "GameTooltip", 1300, 720, 200, 80)
}

// The game's tooltip showing `data`, which the game put in the corner.
function showing(data: Game.TooltipData): Game.ShownTip {
  return {
    shown: true, data: data, placeable: false, ownerHigh: false, ownerRight: false, corner: corner(), below: false,
    right: true
  }
}

// The game's tooltip gone.
function hidden(): Game.ShownTip {
  return { shown: false, ..showing({ lines: [] }) }
}

// A button of the micro menu in the screen's lower half, its top left at 600,800, 30 wide: the game's tooltip for it.
function atButton(name: String, data: Game.TooltipData): Game.ShownTip {
  return {
    owner: frame("Button", name, 600, 800, 30, 40), ownerName: name, placeable: true, ..showing(data)
  }
}

// A thing in a slot of the game's at the screen's top right, its top left at 1300,200, 40 wide: under it and on its
// right edge, as the game asks.
function inSlot(name: String, data: Game.TooltipData): Game.ShownTip {
  return {
    owner: frame("Button", name, 1300, 200, 40, 40), ownerName: name, placeable: true, ownerHigh: true,
    ownerRight: true, ..showing(data)
  }
}

function text(title: String): Game.TooltipData {
  return { plain: true, lines: [{ left: title, kind: 0 }] }
}

function sword(): Game.TooltipData {
  return { kind: 0, id: 9010, about: "item:9010", lines: [{ left: "Sword", kind: 22 }] }
}

// Whether a part's texts read exactly this, joined by « | »: where they don't, the test fails with what they read.
function reads(part: Test.Part, expected: String): Boolean {
  const read = part.texts().join(" | ")
  if (read != expected) { panic(`it reads «${read}», not «${expected}»`) }
  return true
}

// Whether a number is this one, to a hundredth: where it isn't, the test fails with what it is.
function near(value: Number, expected: Number): Boolean {
  if ((value - expected).abs() > 0.01) { panic(`it is ${value}, not ${expected}`) }
  return true
}

// The module's tab in the settings: `/ordaen`, «Tooltips», the tab.
function tab(title: String): Test.Part {
  Test.open("/ordaen")
  const settings = Test.page().window(SETTINGS)
  settings.button("Tooltips").click()
  // «General» is Ordaen's own page too, the first.
  settings.button(title).nth(title == "General" ? 2 : 1).click()
  return settings
}

// A control of the module's tab clicked and saved, and the window closed.
function choose(title: String, control: String) {
  const settings = tab(title)
  settings.button(control).click()
  settings.button("Save").click()
  Test.key(Key.Escape)
}

// A dropdown of the module's tab, the `nth` of those that say what it says now, set to another choice and saved.
function pick(title: String, now: String, nth: Integer, choice: String) {
  const settings = tab(title)
  settings.button(now).nth(nth).click()
  Test.page().window(choice).button(choice).click()
  settings.button("Save").click()
  Test.key(Key.Escape)
}

// Shown and unseen

test "with the game showing no tooltip nothing is drawn, and the game's own isn't kept unseen" {
  Test.mount(nil, SCREEN)
  Test.expect(Test.surfaces().length == 0)
  Test.expect(!Test.requests().any(asked => asked == "Tooltip.hide true"))
}

test "a tooltip drawn here keeps the game's own unseen; the game's tooltip gone, it is seen again" {
  Test.mount(nil, SCREEN)
  _ = Test.requests()
  Game.tooltip.main = showing(sword())
  Test.expect(Test.page().window("Sword").shown())
  Test.expect(Test.requests().join(", ") == "Tooltip.hide true")
  Game.tooltip.main = hidden()
  Test.pass(0.3)
  Test.expect(!Test.page().window("Sword").shown())
  Test.expect(Test.requests().join(", ") == "Tooltip.hide false")
}

test "the module turned off draws nothing and leaves the game's tooltip seen" {
  Test.mount(nil, SCREEN)
  Game.tooltip.main = showing(sword())
  Test.flush()
  _ = Test.requests()
  (Runtime.Addon.of(Tooltips) ?? panic("the tooltips are installed")).disable()
  Test.expect(Test.surfaces().length == 0)
  Test.expect(Test.requests().join(", ") == "Tooltip.hide false")
}

// Where it stands

test "a button's tooltip stands above the button on its left edge in the screen's lower half" {
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  const at = Test.page().window("Character Info").rect()
  Test.expect(near(at.bottom, 800) && near(at.left, 600))
}

test "with «Tooltips at buttons» unticked a button's tooltip stands where the game put its own" {
  Test.mount(nil, SCREEN)
  choose("General", "Tooltips at buttons")
  Game.tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  const at = Test.page().window("Character Info").rect()
  Test.expect(near(at.bottom, 720) && near(at.right, 1500))
}

test "a tooltip the game can't place by its owner stands where the game put its own" {
  Test.mount(nil, SCREEN)
  Game.tooltip.main = { placeable: false, ..atButton("SomeAddonButton", text("Some Addon")) }
  const at = Test.page().window("Some Addon").rect()
  Test.expect(near(at.bottom, 720) && near(at.right, 1500))
}

test "an item in the bags stands under its slot on its right edge in the screen's upper right, though buttons' tooltips don't" {
  Test.mount(nil, SCREEN)
  choose("General", "Tooltips at buttons")
  Game.tooltip.main = inSlot("ContainerFrame1Item3", sword())
  const at = Test.page().window("Sword").rect()
  Test.expect(near(at.top, 240) && near(at.right, 1340))
}

test "an item in the bank stands beside its slot as one in the bags does" {
  Test.mount(nil, SCREEN)
  choose("General", "Tooltips at buttons")
  Game.tooltip.main = inSlot("BankFrameItem1", sword())
  Test.expect(near(Test.page().window("Sword").rect().top, 240))
}

test "with bags' items set to the screen's corner an item in the bags stands where the game put its own" {
  Test.mount(nil, SCREEN)
  pick("Items", "Beside the item", 1, "In the screen's corner")
  Game.tooltip.main = inSlot("ContainerFrame1Item3", sword())
  const at = Test.page().window("Sword").rect()
  Test.expect(near(at.bottom, 720) && near(at.right, 1500))
}

test "a worn item stands beside its slot of the character, and in the corner where the character's are set so" {
  Test.mount(nil, SCREEN)
  choose("General", "Tooltips at buttons")
  Game.tooltip.main = inSlot("CharacterHeadSlot", sword())
  Test.expect(near(Test.page().window("Sword").rect().top, 240))
  pick("Items", "Beside the item", 2, "In the screen's corner")
  Game.tooltip.main = inSlot("CharacterHeadSlot", sword())
  Test.expect(near(Test.page().window("Sword").rect().bottom, 720))
}

test "the tooltips beside an item stand in a column away from the corner, and the worn one beyond them" {
  Game.spells.tooltip = (id: Integer): Game.TooltipData | nil => ({
    kind: 1, id: 7001, lines: [{ left: "Healing Touch", kind: 13 }, { left: "Instant", kind: 0 }]
  })
  Test.mount(nil, SCREEN)
  Game.tooltip.compared = [{ kind: 0, lines: [{ left: "Worn Axe", kind: 22 }] }]
  Game.tooltip.main = showing({
    kind: 0, id: 9001,
    lines: [
      { left: "Axe", kind: 22 }, { left: "Use: Heals you.", kind: 44, spell: 7001 },
      { left: "Deep Woods (1/3)", kind: 42 }
    ]
  })
  const group = Test.page().window("Axe")
  const main = group.text("Axe").rect()
  const worn = group.text("Worn Axe").rect()
  const use = group.text("Healing Touch").rect()
  const set = group.text("Deep Woods (1/3)").rect()
  // The group runs leftwards from the corner: the column beside the axe, the worn axe beyond it.
  Test.expect(use.right < main.left && worn.right < use.left)
  Test.expect(near(use.left, set.left) && use.bottom < set.top)
}

// What is drawn here and what is left to the game

test "a kind turned off on its tab is the game's own" {
  Test.mount(nil, SCREEN)
  choose("Items", "On")
  Game.tooltip.main = showing(sword())
  Test.expect(Test.surfaces().length == 0)
}

test "abilities, effects and objects turned off on their tabs are the game's own" {
  Test.mount(nil, SCREEN)
  choose("Abilities", "On")
  choose("Effects", "On")
  choose("Objects", "On")
  Game.tooltip.main = showing({ kind: 1, id: 1, lines: [{ left: "Frostbolt", kind: 13 }] })
  Test.expect(Test.surfaces().length == 0)
  Game.tooltip.main = showing({ kind: 7, id: 1, lines: [{ left: "Renew", kind: 0 }] })
  Test.expect(Test.surfaces().length == 0)
  Game.tooltip.main = showing({ kind: 4, lines: [{ left: "Chest", kind: 0 }] })
  Test.expect(Test.surfaces().length == 0)
}

// The unit under the cursor: a player or an NPC as the test says.
function unitTip(name: String): Game.TooltipData {
  return { kind: 2, lines: [{ left: name, kind: 2, unit: "mouseover" }] }
}

function aUnit(player: Boolean): Game.UnitInfo {
  return {
    name: player ? "Jaina" : "Wolf", player: player, dead: false, ghost: false, afk: false, dnd: false, pvp: false,
    level: 10, inParty: false, friend: false, ignored: false, tapped: false, classification: "normal",
    sameFaction: true
  }
}

test "players turned off are the game's own, and NPCs still drawn here" {
  Game.units.of = (unit: String): Game.UnitInfo | nil => aUnit(true)
  Test.mount(nil, SCREEN)
  choose("Players", "On")
  Game.tooltip.main = showing(unitTip("Jaina"))
  Test.expect(Test.surfaces().length == 0)
  Game.units.of = (unit: String): Game.UnitInfo | nil => aUnit(false)
  Game.tooltip.main = showing(unitTip("Wolf"))
  Test.expect(Test.page().window("Wolf").shown())
}

test "NPCs turned off are the game's own, and players still drawn here" {
  Game.units.of = (unit: String): Game.UnitInfo | nil => aUnit(false)
  Test.mount(nil, SCREEN)
  choose("NPCs", "On")
  Game.tooltip.main = showing(unitTip("Wolf"))
  Test.expect(Test.surfaces().length == 0)
  Game.units.of = (unit: String): Game.UnitInfo | nil => aUnit(true)
  Game.tooltip.main = showing(unitTip("Jaina"))
  Test.expect(Test.page().window("Jaina").shown())
}

test "buttons and texts turned off are the game's own" {
  Test.mount(nil, SCREEN)
  choose("Buttons and text", "On")
  Game.tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  Test.expect(Test.surfaces().length == 0)
}

test "a kind's switch off greys the rest of its tab" {
  Test.mount(nil, SCREEN)
  const settings = tab("Items")
  settings.button("On").click()
  Test.expect(settings.button("Item level").opacity() < 1)
}

test "a setting changed on its tab is kept after a reload" {
  Test.mount(nil, SCREEN)
  choose("General", "Tooltips at buttons")
  Test.reload()
  // Its box shows no tick.
  Test.expect(tab("General").button("Tooltips at buttons").box(Ordaen.art.ctl.tick).opacity() == 0)
}

test "a setting's box shows its tick before it is changed" {
  Test.mount(nil, SCREEN)
  Test.expect(tab("General").button("Tooltips at buttons").box(Ordaen.art.ctl.tick).opacity() == 1)
}

// What buttons tell more

test "the character's button tells the item level and the most worn piece's durability, red under a quarter" {
  Game.character.itemLevel = (): Number | nil => 61.7
  Game.character.durability = (): Number | nil => 0.2
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("CharacterMicroButton", {
    plain: true, lines: [{ left: "Character Info |cffffd200(C)|r", kind: 0 }]
  })
  const tip = Test.page().window("Character Info")
  Test.expect(reads(tip, "Character Info | Item level | 61 | Durability | 20% | C: open"))
  Test.expect(tip.text("20%").textColor().equal(RED))
  Game.character.durability = (): Number | nil => 0.25
  Game.tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  Test.expect(Test.page().window("Character Info").text("25%").textColor().equal(VALUE))
}

test "the character's button with no item level says none" {
  Game.character.itemLevel = (): Number | nil => 0
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  Test.expect(reads(Test.page().window("Character Info"), "Character Info"))
}

test "the backpack tells the free slots of every bag together, a bag's slot its own" {
  Game.bags.roomOf = (bag: Integer): Game.BagRoom => bag == 1 ? { free: 0, slots: 6 } : { free: 0, slots: 0 }
  Game.bags.roomOfAll = (): Game.BagRoom => ({ free: 3, slots: 22 })
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("MainMenuBarBackpackButton", text("Backpack"))
  Test.expect(reads(Test.page().window("Backpack"), "Backpack | Free slots | 3 / 22"))
  Game.tooltip.main = atButton("CharacterBag0Slot", text("Linen Bag"))
  Test.expect(reads(Test.page().window("Linen Bag"), "Linen Bag | Free slots | 0 / 6"))
  Game.tooltip.main = atButton("CharacterBag1Slot", text("Empty Slot"))
  Test.expect(reads(Test.page().window("Empty Slot"), "Empty Slot"))
}

test "the talents' button tells the points not spent, and nothing with none" {
  Game.character.unspentTalents = (): Integer => 3
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("TalentMicroButton", text("Talents"))
  Test.expect(reads(Test.page().window("Talents"), "Talents | Unspent points | 3"))
  Game.character.unspentTalents = (): Integer => 0
  Game.tooltip.main = atButton("TalentMicroButton", text("Talents (N)"))
  Test.expect(reads(Test.page().window("Talents (N)"), "Talents (N)"))
}

test "the professions' button tells each profession's rank" {
  Game.professions.list = [
    { skillLine: 186, name: "Mining", icon: 136248, rank: 75, max: 150, kind: .Gathering },
    { skillLine: 182, name: "Herbalism", icon: 136246, rank: 1, max: 75, kind: .Gathering }
  ]
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("ProfessionMicroButton", text("Professions"))
  Test.expect(reads(Test.page().window("Professions"), "Professions | Mining | 75 / 150 | Herbalism | 1 / 75"))
}

test "the achievements' button tells the points, and nothing with none" {
  Game.character.achievementPoints = (): Integer => 450
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("AchievementMicroButton", text("Achievements"))
  Test.expect(reads(Test.page().window("Achievements"), "Achievements | Achievement points | 450"))
  Game.character.achievementPoints = (): Integer => 0
  Game.tooltip.main = atButton("AchievementMicroButton", text("Achievements (Y)"))
  Test.expect(reads(Test.page().window("Achievements (Y)"), "Achievements (Y)"))
}

test "the quest log's button tells how many quests are taken of the most" {
  Game.character.quests = (): Game.QuestCount => ({ have: 12, most: 25 })
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("QuestLogMicroButton", text("Quest Log"))
  Test.expect(reads(Test.page().window("Quest Log"), "Quest Log | Quests | 12 / 25"))
}

test "the guild's button tells how many are online, and nothing out of a guild" {
  Game.character.guild = (): Game.GuildCount | nil => ({ online: 4, members: 30 })
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("GuildMicroButton", text("Guild"))
  Test.expect(reads(Test.page().window("Guild"), "Guild | Online | 4 / 30"))
  Game.character.guild = (): Game.GuildCount | nil => nil
  Game.tooltip.main = atButton("GuildMicroButton", text("Guild (J)"))
  Test.expect(reads(Test.page().window("Guild (J)"), "Guild (J)"))
}

test "with «More on buttons» unticked a button tells its own lines alone" {
  Game.character.itemLevel = (): Number | nil => 61.7
  Test.mount(nil, SCREEN)
  choose("Buttons and text", "More on buttons")
  Game.tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  Test.expect(reads(Test.page().window("Character Info"), "Character Info"))
}

// Shown anew

test "a tooltip shown again draws only what differs: nothing of the group is made anew" {
  Test.mount(nil, SCREEN)
  Game.tooltip.main = inSlot("ContainerFrame1Item3", sword())
  Test.pass(0.1)
  Game.tooltip.main = hidden()
  Test.pass(0.2)
  const said = Test.calls((): nil => {
    Game.tooltip.main = inSlot("ContainerFrame1Item3", { kind: 0, id: 9011, about: "item:9011", lines: [{ left: "Shield", kind: 22 }] })
    Test.flush()
  })
  Test.expect(!said.contains("SetParent") && !said.contains("SetAtlas") && !said.contains("SetScript"))
  Test.expect(said.contains("SetText=1"))
}

function kragos(unit: String): Game.UnitInfo | nil {
  if (unit != "mouseover") { return nil }
  return {
    name: "Kragos", player: true, className: "Warrior", guild: "Kirin Tor", guildRank: "Officer", dead: false,
    ghost: false, afk: false, dnd: false, pvp: false, level: 34, race: "Human", faction: "Alliance",
    factionName: "Alliance", sameFaction: true, inParty: false, friend: false, ignored: false, tapped: false,
    classification: "normal"
  }
}

function frostbolt(): Game.TooltipData {
  return {
    kind: 1, id: 116, about: "spell:116",
    lines: [{ left: "Frostbolt", kind: 13 }, { left: "65 Mana", right: "30 yd range", kind: 0 }]
  }
}

// Whether anything shown says one of the unit's texts.
function anyOfKragos(): Boolean {
  const all = Test.page().texts()
  return ["Kirin Tor", "Officer", "Human", "Alliance", "Kragos"].any(said => all.any(shown => shown == said))
}

test "a spell's tooltip straight after a unit's holds nothing of the unit's, charging or locked" {
  Game.units.of = kragos
  Game.spells.cost = (id: Integer): Game.SpellCost | nil => ({ amount: 65 })
  Test.mount(nil, SCREEN)
  Game.tooltip.main = showing({ kind: 2, lines: [{ left: "Kragos", kind: 2, unit: "mouseover" }] })
  Test.pass(0.1)
  Game.tooltip.main = inSlot("ContainerFrame1Item3", frostbolt())
  Test.pass(0.1)
  Test.expect(Test.page().window("Frostbolt").shown() && !anyOfKragos())
  Test.pass(1.3)
  Test.expect(!anyOfKragos())
}

test "a spell's tooltip after a unit's, the game's gone between, holds nothing of the unit's, charging or locked" {
  Game.units.of = kragos
  Game.spells.cost = (id: Integer): Game.SpellCost | nil => ({ amount: 65 })
  Test.mount(nil, SCREEN)
  Game.tooltip.main = showing({ kind: 2, lines: [{ left: "Kragos", kind: 2, unit: "mouseover" }] })
  Test.pass(0.1)
  Game.tooltip.main = hidden()
  Test.pass(0.1)
  Game.tooltip.main = inSlot("ContainerFrame1Item3", frostbolt())
  Test.pass(0.1)
  Test.expect(Test.page().window("Frostbolt").shown() && !anyOfKragos())
  Test.pass(1.3)
  Test.expect(!anyOfKragos())
}

// The lock's room

test "a button's tooltip, which never locks, ends at its last line; an item's keeps the lock's bar's room under it" {
  Test.mount(nil, SCREEN)
  Game.tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  const button = Test.page().window("Character Info")
  const under = button.rect().bottom - button.text("Character Info").rect().bottom
  Game.tooltip.main = hidden()
  Test.pass(0.3)
  Game.tooltip.main = inSlot("ContainerFrame1Item3", sword())
  const item = Test.page().window("Sword")
  // The bar's row and the room above it: more than 15 more.
  Test.expect(item.rect().bottom - item.text("Sword").rect().bottom > under + 15)
}
