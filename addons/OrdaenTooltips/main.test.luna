  Test::expect(reads(Test::page().window("Character Info"), "Character Info"))
}

// Shown anew

test "a tooltip shown again draws only what differs: nothing of the group is made anew" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = inSlot("ContainerFrame1Item3", sword())
  Test::pass(SHOWS)
  Test::pass(0.1)
  Game::tooltip.main = hidden()
  Test::pass(0.2)
  const said = Test::calls((): nil => {
    Game::tooltip.main = inSlot("ContainerFrame1Item3", { kind: 0, id: 9011, about: "item:9011", lines: [{ left: "Shield", kind: 22 }] })
    Test::pass(SHOWS)
    Test::flush()
  })
  Test::expect(!said.contains("SetParent") && !said.contains("SetAtlas") && !said.contains("SetScript"))
  Test::expect(said.contains("SetText=1"))
}

function kragos(unit: string): Game::UnitInfo | nil {
  if (unit != "mouseover") { return nil }
  return {
    name: "Kragos", player: true, className: "Warrior", guild: "Kirin Tor", guildRank: "Officer", dead: false,
    ghost: false, afk: false, dnd: false, pvp: false, level: 34, race: "Human", faction: "Alliance",
    factionName: "Alliance", sameFaction: true, inParty: false, friend: false, ignored: false, tapped: false,
    classification: "normal"
  }
}

function frostbolt(): Game::TooltipData {
  return {
    kind: 1, id: 116, about: "spell:116",
    lines: [{ left: "Frostbolt", kind: 13 }, { left: "65 Mana", right: "30 yd range", kind: 0 }]
  }
}

// Whether anything shown says one of the unit's texts.
function anyOfKragos(): boolean {
  const all = Test::page().texts()
  return ["Kirin Tor", "Officer", "Human", "Alliance", "Kragos"].any(said => all.any(shown => shown == said))
}

test "a spell's tooltip straight after a unit's holds nothing of the unit's, charging or locked" {
  Game::units.of = kragos
  Game::spells.cost = (id: integer): Game::SpellCost | nil => ({ amount: 65 })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 2, lines: [{ left: "Kragos", kind: 2, unit: "mouseover" }] })
  Test::pass(SHOWS)
  Test::pass(0.1)
  Game::tooltip.main = inSlot("ContainerFrame1Item3", frostbolt())
  Test::pass(SHOWS)
  Test::pass(0.1)
  Test::expect(Test::page().window("Frostbolt").shown() && !anyOfKragos())
  Test::pass(1.3)
  Test::expect(!anyOfKragos())
}

test "a spell's tooltip after a unit's, the game's gone between, holds nothing of the unit's, charging or locked" {
  Game::units.of = kragos
  Game::spells.cost = (id: integer): Game::SpellCost | nil => ({ amount: 65 })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 2, lines: [{ left: "Kragos", kind: 2, unit: "mouseover" }] })
  Test::pass(SHOWS)
  Test::pass(0.1)
  Game::tooltip.main = hidden()
  Test::pass(0.1)
  Game::tooltip.main = inSlot("ContainerFrame1Item3", frostbolt())
  Test::pass(SHOWS)
  Test::pass(0.1)
  Test::expect(Test::page().window("Frostbolt").shown() && !anyOfKragos())
  Test::pass(1.3)
  Test::expect(!anyOfKragos())
}

// The lock's room

test "a button's tooltip, which never locks, ends at its last line; an item's keeps the lock's bar's room under it" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  Test::pass(SHOWS)
  const button = Test::page().window("Character Info")
  const under = button.rect().bottom - button.text("Character Info").rect().bottom
  Game::tooltip.main = hidden()
  Test::pass(0.3)
  Game::tooltip.main = inSlot("ContainerFrame1Item3", sword())
  Test::pass(SHOWS)
  const item = Test::page().window("Sword")
  // The bar's row and the room above it: more than 15 more.
  Test::expect(item.rect().bottom - item.text("Sword").rect().bottom > under + 15)
}

// Where the group stands

// An item that stands beside its slot of the bags on the screen's left, under it on its left edge: what using it
// does and its set beside it, `worn` the items it is compared with.
function leftSlot(data: Game::TooltipData): Game::ShownTip {
  return {
    owner: frame("Button", "ContainerFrame2Item1", 100, 200, 40, 40), ownerName: "ContainerFrame2Item1", placeable: true,
    ownerHigh: true, ownerRight: false, ..showing(data)
  }
}

function axeWithSides(): Game::TooltipData {
  return {
    kind: 0, id: 9001,
    lines: [
      { left: "Axe", kind: 22 }, { left: "Use: Heals you.", kind: 44, spell: 7001 }, { left: "Deep Woods (1/3)", kind: 42 }
    ]
  }
}

function healingTouch(id: integer): Game::TooltipData | nil {
  return { kind: 1, id: 7001, lines: [{ left: "Healing Touch", kind: 13 }, { left: "Instant", kind: 0 }] }
}

test "right of its owner the group runs rightwards: the axe at the owner, the column beside it, the worn one beyond" {
  Game::spells.tooltip = healingTouch
  Test::mount(nil, SCREEN)
  Game::tooltip.compared = [{ kind: 0, lines: [{ left: "Worn Axe", kind: 22 }] }]
  Game::tooltip.main = leftSlot(axeWithSides())
  Test::pass(SHOWS)
  const group = Test::page().window("Axe")
  const main = group.text("Axe").rect()
  const use = group.text("Use").rect()
  const worn = group.text("Worn Axe").rect()
  Test::expect(near(group.rect().left, 140) && main.right < use.left && use.right < worn.left)
}

test "two worn items stand from the main tooltip outwards in the game's order, whichever way the group runs" {
  Test::mount(nil, SCREEN)
  Game::tooltip.compared = [{ kind: 0, lines: [{ left: "Worn Axe", kind: 22 }] }, { kind: 0, lines: [{ left: "Old Axe", kind: 22 }] }]
  Game::tooltip.main = leftSlot({ kind: 0, lines: [{ left: "Axe", kind: 22 }] })
  Test::pass(SHOWS)
  const right = Test::page().window("Axe")
  Test::expect(right.text("Axe").rect().right < right.text("Worn Axe").rect().left)
  Test::expect(right.text("Worn Axe").rect().right < right.text("Old Axe").rect().left)
  Game::tooltip.main = showing({ kind: 0, lines: [{ left: "Axe", kind: 22 }] })
  Test::pass(SHOWS)
  const left = Test::page().window("Axe")
  Test::expect(left.text("Worn Axe").rect().right < left.text("Axe").rect().left)
  Test::expect(left.text("Old Axe").rect().right < left.text("Worn Axe").rect().left)
}

test "under its owner the tooltips beside line up their tops with the main one's; above it, their bottoms" {
  Game::spells.tooltip = healingTouch
  Test::mount(nil, SCREEN)
  Game::tooltip.main = leftSlot(axeWithSides())
  Test::pass(SHOWS)
  const below = Test::page().window("Axe")
  // What using it does stands under its «Use» tab, the tab level with the axe's title or above it.
  Test::expect(below.text("Use").rect().top <= below.text("Axe").rect().top)
  Game::tooltip.main = showing(axeWithSides())
  Test::pass(SHOWS)
  const above = Test::page().window("Axe")
  // The set's tooltip is the column's last: its bottom on the axe's.
  const set = above.text("Deep Woods (1/3)").item().rect()
  Test::expect(near(set.bottom, above.rect().bottom))
  Test::expect(above.text("Axe").rect().top > above.text("Use").rect().top)
}

test "compared, the main tooltip's title stands level with the worn item's under its «Equipped»" {
  Test::mount(nil, SCREEN)
  Game::tooltip.compared = [{ kind: 0, lines: [{ left: "Worn Axe", kind: 22 }] }]
  Game::tooltip.main = showing({ kind: 0, lines: [{ left: "Axe", kind: 22 }] })
  Test::pass(SHOWS)
  const group = Test::page().window("Axe")
  Test::expect(near(group.text("Axe").rect().top, group.text("Worn Axe").rect().top))
  // «Equipped» a tab on the worn item's frame: in its middle, over its title.
  const header = group.text("Equipped").rect()
  const worn = group.text("Equipped").item().rect()
  Test::expect(header.bottom < group.text("Worn Axe").rect().top)
  Test::expect(near((header.left + header.right) / 2, (worn.left + worn.right) / 2))
}

// What buttons tell more: their edges

test "each bag's slot tells its own free slots" {
  Game::bags.roomOf = (bag: integer): Game::BagRoom => ({ free: bag, slots: 10 * bag })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = atButton("CharacterBag1Slot", text("Bag 2"))
  Test::pass(SHOWS)
  Test::expect(reads(Test::page().window("Bag 2"), "Bag 2 | Free slots | 2 / 20"))
  Game::tooltip.main = atButton("CharacterBag2Slot", text("Bag 3"))
  Test::pass(SHOWS)
  Test::expect(reads(Test::page().window("Bag 3"), "Bag 3 | Free slots | 3 / 30"))
  Game::tooltip.main = atButton("CharacterBag3Slot", text("Bag 4"))
  Test::pass(SHOWS)
  Test::expect(reads(Test::page().window("Bag 4"), "Bag 4 | Free slots | 4 / 40"))
}

test "a bag of one slot, an item level of one, a durability of a half and a single point are told" {
  Game::bags.roomOf = (bag: integer): Game::BagRoom => ({ free: 1, slots: 1 })
  Game::character.itemLevel = (): number | nil => 1
  Game::character.durability = (): number | nil => 0.5
  Game::character.unspentTalents = (): integer => 1
  Game::character.achievementPoints = (): integer => 1
  Test::mount(nil, SCREEN)
  Game::tooltip.main = atButton("CharacterBag0Slot", text("Pouch"))
  Test::pass(SHOWS)
  Test::expect(reads(Test::page().window("Pouch"), "Pouch | Free slots | 1 / 1"))
  Game::tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  Test::pass(SHOWS)
  Test::expect(reads(Test::page().window("Character Info"), "Character Info | Item level | 1 | Durability | 50% | Unspent points | 1"))
  Game::tooltip.main = atButton("TalentMicroButton", text("Talents"))
  Test::pass(SHOWS)
  Test::expect(reads(Test::page().window("Talents"), "Talents | Unspent points | 1"))
  Game::tooltip.main = atButton("AchievementMicroButton", text("Achievements"))
  Test::pass(SHOWS)
  Test::expect(reads(Test::page().window("Achievements"), "Achievements | Achievement points | 1"))
}

test "a button's facts come after its own lines" {
  Game::character.quests = (): Game::QuestCount => ({ have: 3, most: 25 })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = atButton("QuestLogMicroButton", {
    plain: true, lines: [{ left: "Quest Log", kind: 0 }, { left: "See your quests.", kind: 0 }, { left: "Press L.", kind: 0 }]
  })
  Test::pass(SHOWS)
  Test::expect(reads(Test::page().window("Quest Log"), "Quest Log | See your quests. | Press L. | Quests | 3 / 25"))
}

// The tabs

test "each kind's switch off greys the rest of its tab" {
  Test::mount(nil, SCREEN)
  for (title of ["Abilities", "Effects", "Players", "NPCs", "Objects", "Buttons and text"]) {
    const settings = tab(title)
    settings.button("On").click()
    const rest = title == "Buttons and text" ? "More on buttons" : "Tooltips in tooltips"
    if (settings.button(rest).opacity() >= 1) { panic(`${title}: «${rest}» isn't greyed`) }
    settings.button("On").click()
    Test::key(Key::Escape)
  }
}

// The wait before it shows

test "a tooltip shows once the cursor has stayed the delay, and straight from one shown to the next at once" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(sword())
  Test::pass(0.2)
  Test::expect(Test::surfaces().length == 0)
  Test::pass(0.14)
  Test::expect(Test::page().window("Sword").shown())
  Game::tooltip.main = showing({ kind: 0, id: 9003, about: "item:9003", lines: [{ left: "Mace", kind: 22 }] })
  Test::flush()
  Test::expect(Test::page().window("Mace").shown())
}

test "a kind's own delay stands over the general one" {
  Test::mount(nil, SCREEN)
  pick("Items", "As on General", 1, "Long (1 s)")
  Game::tooltip.main = showing(sword())
  Test::pass(0.6)
  Test::expect(Test::surfaces().length == 0)
  Test::pass(0.45)
  Test::expect(Test::page().window("Sword").shown())
}

test "with the general delay at None a tooltip shows at once" {
  Test::mount(nil, SCREEN)
  pick("General", "Short (0.3 s)", 1, "None")
  Game::tooltip.main = showing(sword())
  Test::flush()
  Test::expect(Test::page().window("Sword").shown())
}

test "straight from a button's tooltip to a slot's, the slot's shows at once beside the slot" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
  Test::pass(SHOWS)
  Game::tooltip.main = inSlot("ContainerFrame1Item3", sword())
  Test::pass(0.02)
  const at = Test::page().window("Sword").rect()
  Test::expect(near(at.top, 200) && near(at.right, 1300))
}

test "an item's worth to the spec stands at its foot, and a weapon whose skill isn't trained says so" {
  Client::C_Item::GetItemInfoInstant = (item: string | integer): (number | nil, string | nil, string | nil, string | nil, FileId | nil, number | nil, number | nil) => {
    return 1201, "Weapon", "Mace", "INVTYPE_WEAPON", nil, 2, 4
  }
  Client::C_Item::GetItemStats = (link: string): unknown => {
    const stats: map<string, number> = { ["ITEM_MOD_INTELLECT_SHORT"]: 5 }
    return stats
  }
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 0, id: 1201, about: "item:1201",
    lines: [{ left: "Dull Mace", kind: 22 }, { left: "Mace", kind: 0, validType: false }]
  })
  Test::pass(SHOWS)
  const tip = Test::page().window("Dull Mace")
  Test::expect(tip.text("+100%").shown() && tip.text("Needs the weapon skill: train it first").shown())
}

test "what is drawn here is claimed from the game's show itself: an item while items are drawn, nothing with their switch off" {
  Test::mount(nil, { left: 0, top: 0, width: 800, height: 600, screen: true })
  const cloth: Game::TooltipData = { kind: 0, id: 2589, about: "item:2589", lines: [{ left: "Linen Cloth", kind: 22 }] }
  Test::expect(Tooltips.claims(cloth))
  Tooltips.settings.values.itemsOn = false
  Test::expect(!Tooltips.claims(cloth))
  Tooltips.settings.values.itemsOn = true
}
