test "with «More on buttons» unticked a button tells its own lines alone" {
  Game::character.itemLevel = (): number | nil => 61.7
  Test::mount(nil, SCREEN)
  choose("Buttons and text", "More on buttons")
  Game::tooltip.main = atButton("CharacterMicroButton", text("Character Info"))
