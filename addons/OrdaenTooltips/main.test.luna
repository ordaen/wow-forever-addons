// Ordaen Tooltips' module on the stand-in client: the game's tooltip shows this and that, and the module reads it,
// draws its group where it belongs and keeps the game's own unseen, or leaves the show to the game; a tooltip held
// under the cursor locks, and what a part of a locked one opens.
import Client from "$client"
import Game from "$game"
import { Frame } from "$ltml"
import root Ordaen from "Ordaen"
import Test from "$test"
import { Place } from "@/choices"
import Runtime from "$runtime"
import root Tooltips from "OrdaenTooltips"

// The game's tooltip showing `data`, where the game put its own: in `corner`.
function showing(corner: any Frame, data: Game.TooltipData): Game.ShownTip {
  return {
    shown: true, data: data, placeable: false, ownerHigh: false, ownerRight: false, corner: corner, below: false,
    right: true,
  }
}

// The game's tooltip gone.
function hidden(corner: any Frame): Game.ShownTip {
  return { shown: false, ..showing(corner, { lines: [] }) }
}

// An item in a bag's slot.
function inSlot(corner: any Frame, slot: any Frame, data: Game.TooltipData): Game.ShownTip {
  return {
    owner: slot, ownerName: "ContainerFrame1Item3", placeable: true, ownerHigh: true, ownerRight: true,
    ..showing(corner, data),
  }
}

function axe(name: String): Game.TooltipData {
  return { kind: 0, lines: [{ left: name, kind: 22 }] }
}

function sword(): Game.TooltipData {
  return { kind: 0, id: 9010, about: "item:9010", lines: [{ left: "Sword", kind: 22 }] }
}

// The strength of each axe, as the game reads an item's stats.
function strength(data: Game.TooltipData): Array<Game.ItemStat> {
  let name = data.lines[1]?.left
  let value = name == "Greataxe" ? 30 : name == "Worn Axe" ? 21 : name == "Other Axe" ? 40 : 0
  if (value == 0) { return [] }
  return [{ key: "ITEM_MOD_STRENGTH_SHORT", name: "Strength", value: value }]
}

// A frame of the game's, by its name, at a place on the screen.
function frame(kind: String, name: String, x: Number, y: Number, width: Number, height: Number): any Frame {
  let made = Client.CreateFrame(kind, name, Client.C_UI.GetUIParent(), nil)
  made.SetSize(width, height)
  made.SetPoint("TOPLEFT", Client.C_UI.GetUIParent(), "TOPLEFT", x, -y)
  return made
}

// The settings window's «Save»: every draft becomes its values.
function saveAll() {
  const ordaen = Ordaen
  ordaen.keeper.saveAll()
}

function cursorSaid() {
  Test.note(`the cursor's look: ${Test.cursor() ?? "nil"}`)
}

test "the module reads the game's tooltip, draws it where it belongs, and locks it" {
  // The game's own tooltip, in the screen's bottom right corner, and two things a tooltip belongs to.
  let corner = frame("Frame", "GameTooltip", 1300, 720, 200, 80)
  let button = frame("Button", "CharacterMicroButton", 600, 800, 30, 40)
  let slot = frame("Button", "ContainerFrame1Item3", 1300, 200, 40, 40)

  // The module's root, made as its addon loaded and drawn by Ordaen on the screen, which this page is.
  Test.mount(nil, { left: 100, top: 50, width: 700, height: 600, screen: true })
  Test.shot("the game shows no tooltip: nothing is drawn, and the game's own isn't kept unseen")

  Game.character.itemLevel = (): Number | nil => 61.7
  Game.character.durability = (): Number | nil => 0.2
  Game.tooltip.main = {
    owner: button, ownerName: "CharacterMicroButton", placeable: true,
    ..showing(corner, { plain: true, lines: [{ left: "Character Info |cffffd200(C)|r", kind: 0 }] }),
  }
  Test.shot("a button's text: read, with the item level and the most worn piece, drawn above the button on its left edge")

  // A setting as the settings window writes and saves it.
  Tooltips.settings.draft.anchorToButtons = false
  saveAll()
  Test.shot("«Tooltips at buttons» off: where the game put its own, in the corner")

  Tooltips.settings.draft.textsExtra = false
  saveAll()
  Test.shot("«More on buttons» off: the button's own lines alone")

  Game.bags.roomOf = (bag: Integer): Game.BagRoom => bag == 0 ? { free: 3, slots: 16 } : bag == 1 ? { free: 0, slots: 6 } : { free: 0, slots: 0 }
  Game.bags.roomOfAll = (): Game.BagRoom => ({ free: 3, slots: 22 })
  Tooltips.settings.draft.textsExtra = true
  saveAll()
  Game.tooltip.main = {
    ownerName: "MainMenuBarBackpackButton",
    ..showing(corner, { plain: true, lines: [{ left: "Backpack", kind: 0 }] }),
  }
  Test.shot("the backpack: the free slots of every bag together")

  Tooltips.settings.draft.textsOn = false
  saveAll()
  Test.shot("text tooltips off: the show is the game's again")

  Game.items.stats = strength
  Game.tooltip.main = inSlot(corner, slot, axe("Greataxe"))
  Test.shot("an item in the bags: beside its slot, under it and on its right edge, though buttons' tooltips aren't")

  Game.tooltip.compared = [axe("Worn Axe")]
  Test.shot("compared with the worn one: its differences on the hovered item, the worn one under «Equipped»")

  Game.tooltip.compared = [axe("Worn Axe"), axe("Other Axe")]
  Test.shot("compared with two: the differences on each worn one")
  // The differences' marks are art (no font the look ships carries ▲ or ▼): more's on the right, less's on the
  // first worn one, at the left.
  Test.expect(Test.painted(Ordaen.art.ctl.compareUp, nil).x > Test.painted(Ordaen.art.ctl.compareDown, nil).x)

  Tooltips.settings.draft.itemsAnchorBags = Place.Corner
  saveAll()
  Game.tooltip.compared = []
  Test.shot("bags' items in the corner: where the game put its own")

  Game.spells.cooldown = (id: Integer): Number | nil => id == 116 ? 95 : nil
  Tooltips.settings.draft.spellsId = false
  saveAll()
  Tooltips.settings.draft.spellsLock = false
  saveAll()
  Game.tooltip.main = showing(corner, { kind: 1, id: 116, lines: [{ left: "Frostbolt", kind: 13 }] })
  Test.shot("a spell cooling down: how long until it is ready")

  Game.spells.cooldown = (id: Integer): Number | nil => id == 116 ? 30 : nil
  Test.pass(0.5)
  Test.shot("half a second on: not read again yet")

  Test.pass(0.6)
  Test.shot("a second on: read again, the time it shows has moved")

  Game.spells.cooldown = (id: Integer): Number | nil => nil
  Test.pass(1.1)
  Test.shot("ready: nothing counts down, and nothing is waited for")

  Game.tooltip.main = showing(corner, { kind: 9, lines: [{ left: "?", kind: 0 }] })
  Test.shot("a kind Ordaen Tooltips doesn't read: left to the game")

  Game.tooltip.main = hidden(corner)
  Test.shot("the game's tooltip gone")

  // The lock.
  Tooltips.settings.draft.itemsAnchorBags = Place.Anchor
  saveAll()
  Game.tooltip.main = inSlot(corner, slot, sword())
  Test.shot("an item under the cursor: the bar's room, nothing in it yet")

  Test.pass(0.1)
  Game.tooltip.main = hidden(corner)
  Test.pass(0.05)
  Game.tooltip.main = inSlot(corner, slot, sword())
  Test.pass(0.535)
  Test.shot("half a second into the charge, the game having shown it again on the way: the bar half full")

  Test.pass(0.6)
  Test.shot("charged: locked, the line in the bar's place and the close button")

  Game.tooltip.main = hidden(corner)
  Test.pass(1)
  Test.shot("the game's tooltip gone: the locked one stays")

  // The locked group stands at 1068.83,240, 271.17 wide and 76.25 high; its close button at 1316.08,248.92.
  Test.moveTo({ x: 1100, y: 300 })
  Test.pass(1)
  Test.shot("the cursor on the locked group: it stays")

  Test.moveTo({ x: 1326, y: 258 })
  Test.pass(1)
  Test.shot("on its close button: still on the group")

  Test.moveTo({ x: 500, y: 500 })
  Test.pass(0.1)
  Test.moveTo({ x: 1100, y: 300 })
  Test.pass(0.3)
  Test.shot("off it and back within the grace: it stays")

  Test.moveTo({ x: 500, y: 500 })
  Test.pass(0.3)
  Test.shot("off it for longer than the grace: gone")

  Game.tooltip.main = inSlot(corner, slot, sword())
  Test.pass(1.3)
  Test.shot("shown again: charged anew, and locked")

  Test.click({ x: 1326, y: 258 }, nil)
  Test.pass(0.05)
  Test.shot("its close button clicked while the game still shows it: not locked, the bar empty")

  Test.pass(2)
  Test.shot("held on: what was closed doesn't charge again")

  Game.tooltip.main = hidden(corner)
  Test.pass(0.2)
  Game.tooltip.main = inSlot(corner, slot, sword())
  Test.pass(1.3)
  Test.shot("after the cursor left it and came back: locked once more")

  Game.tooltip.main = inSlot(corner, slot, { kind: 0, id: 9011, about: "item:9011", lines: [{ left: "Shield", kind: 22 }] })
  Test.pass(0.05)
  Test.shot("the game shows another thing: the locked one goes, and this one starts")

  // What a part of a locked tooltip opens.
  Tooltips.settings.draft.spellsLock = true
  saveAll()
  Game.spells.cost = (id: Integer): Game.SpellCost | nil => id == 116 ? { amount: 65 } : nil
  Game.tooltip.main = hidden(corner)
  Test.pass(0.2)
  Game.tooltip.main = inSlot(corner, slot, {
    kind: 1, id: 116, about: "spell:116",
    lines: [
      { left: "Frostbolt", kind: 13 },
      { left: "65 Mana", right: "30 yd range", kind: 0 },
      { left: "2.5 sec cast", kind: 0 },
    ],
  })
  Test.pass(1.3)
  Test.shot("a spell locked: the cells of its band that open a term are underlined")
  cursorSaid()

  // The cursor leaves the slot for the locked tooltip: the game's goes.
  Game.tooltip.main = hidden(corner)
  Test.moveTo({ x: 1160, y: 297 })
  Test.pass(0.1)
  Test.shot("the cursor on the range's cell: the term's tooltip beside the cell, under it")
  cursorSaid()

  Test.moveTo({ x: 1100, y: 270 })
  Test.pass(0.1)
  Test.shot("off the cell, still on the tooltip: the term's tooltip gone, the locked one stays")
  cursorSaid()

  Test.moveTo({ x: 1260, y: 297 })
  Test.pass(0.1)
  Test.shot("on the cast's cell: its term")

  Test.moveTo({ x: 500, y: 500 })
  Test.pass(0.5)
  Test.shot("off the tooltip for longer than the grace: the lock goes")
  cursorSaid()
  Tooltips.settings.draft.itemsLock = false
  saveAll()
  Game.tooltip.main = hidden(corner)
  Test.pass(0.2)
  Game.tooltip.main = inSlot(corner, slot, sword())
  Test.pass(2)
  Test.shot("«Tooltips in tooltips» off for items: it never charges")

  Game.tooltip.main = hidden(corner)
  Test.pass(0.2)
  Test.expect(Test.idle())
  (Runtime.Addon.of(Tooltips) ?? panic("the tooltips are installed")).disable()
  Test.expect(Test.blank())
}

test "a tooltip shown again is drawn by changing what differs: nothing of the group is drawn anew" {
  let corner = frame("Frame", "GameTooltip", 1300, 720, 200, 80)
  let slot = frame("Button", "ContainerFrame1Item3", 1300, 200, 40, 40)
  Test.mount(nil, { left: 100, top: 50, width: 700, height: 600, screen: true })
  Game.tooltip.main = inSlot(corner, slot, sword())
  Test.pass(0.1)
  Game.tooltip.main = hidden(corner)
  Test.pass(0.2)
  const said = Test.calls((): nil => {
    Game.tooltip.main = inSlot(corner, slot, { kind: 0, id: 9011, about: "item:9011", lines: [{ left: "Shield", kind: 22 }] })
    Test.flush()
  })
  Test.shot("shown again")
  // No frame is taken from the pool and dressed anew: the group's frames stay, and the one text that differs is set.
  Test.expect(!said.contains("SetParent") && !said.contains("SetAtlas") && !said.contains("SetScript"))
  Test.expect(said.contains("SetText=1"))
}

// A spell in a bag's slot whose band opens terms: the range's cell stands at 1160,297 once it is locked.
function frostbolt(corner: any Frame, slot: any Frame): Game.ShownTip {
  return inSlot(corner, slot, {
    kind: 1, id: 116, about: "spell:116",
    lines: [
      { left: "Frostbolt", kind: 13 },
      { left: "65 Mana", right: "30 yd range", kind: 0 },
      { left: "2.5 sec cast", kind: 0 },
    ],
  })
}

// Where the cursor is while a tooltip is locked: on its source (the game shows the tooltip it is about), on the
// locked group, on a part of it that opens a tooltip of its own, on another thing with a tooltip, or elsewhere. Off
// the source the game's tooltip goes; on another thing it shows that.
const PLACES: Array<String> = ["source", "tooltip", "nested", "another", "elsewhere"]

// The cursor moved to `place`, and what the game's tooltip shows then.
function goTo(place: String, corner: any Frame, slot: any Frame): Game.ShownTip {
  if (place == "source") {
    Test.moveTo({ x: 1320, y: 220 })
    return frostbolt(corner, slot)
  } else if (place == "another") {
    Test.moveTo({ x: 600, y: 820 })
    return inSlot(corner, slot, sword())
  } else {
    if (place == "tooltip") {
      Test.moveTo({ x: 1100, y: 270 })
    } else if (place == "nested") {
      Test.moveTo({ x: 1160, y: 297 })
    } else {
      Test.moveTo({ x: 500, y: 500 })
    }
  }
  return hidden(corner)
}

// The locked tooltip stays while the cursor is on it, on what it opens or on its source, for as long as it likes,
// and goes at once on another thing with a tooltip. Anywhere else it goes after the grace once the cursor has been on
// it, and stays until then: the cursor finds its way to it.
function stays(place: String, touched: Boolean): Boolean {
  return place == "source" || place == "tooltip" || place == "nested" || (place == "elsewhere" && !touched)
}

function onIt(place: String): Boolean {
  return place == "tooltip" || place == "nested"
}

test "a locked tooltip goes only when the cursor goes onto something other than it and its source: every move between the places" {
  let corner = frame("Frame", "GameTooltip", 1300, 720, 200, 80)
  let slot = frame("Button", "ContainerFrame1Item3", 1300, 200, 40, 40)
  Test.mount(nil, { left: 100, top: 50, width: 700, height: 600, screen: true })
  Tooltips.settings.draft.itemsAnchorBags = Place.Anchor
  Tooltips.settings.draft.spellsLock = true
  saveAll()
  Game.spells.cost = (id: Integer): Game.SpellCost | nil => id == 116 ? { amount: 65 } : nil
  let moves = 0
  for (visit of [false, true]) {
    for (from of PLACES) {
      if (from == "another") { continue }
      for (to of PLACES) {
        const walked = `${visit ? "on it, then " : ""}${from} to ${to}`
        // Locked anew on the source, from nothing held.
        Tooltips.close()
        Test.moveTo({ x: 500, y: 500 })
        Game.tooltip.main = hidden(corner)
        Test.pass(0.3)
        Game.tooltip.main = goTo("source", corner, slot)
        Test.pass(1.3)
        if (!Tooltips.locked) { panic(`${walked}: not locked on its source`) }
        if (visit) {
          Game.tooltip.main = goTo("tooltip", corner, slot)
          Test.pass(0.1)
        }
        // A while at `from`: longer than the grace, but off everything only within it.
        Game.tooltip.main = goTo(from, corner, slot)
        Test.pass(from == "elsewhere" ? 0.1 : 0.5)
        if (!Tooltips.locked) { panic(`${walked}: not locked at ${from}`) }
        if (visit && from == "nested" && to == "nested") {
          Test.shot("the cursor on a part of the locked tooltip that opens a term: the term's tooltip, and the lock stays")
        }
        const touched = visit || onIt(from)
        Game.tooltip.main = goTo(to, corner, slot)
        Test.pass(0.1)
        if (Tooltips.locked != (to != "another")) { panic(`${walked}: locked ${Tooltips.locked} at once`) }
        Test.pass(0.5)
        if (Tooltips.locked != stays(to, touched)) { panic(`${walked}: locked ${Tooltips.locked} after the grace`) }
        moves += 1
      }
    }
  }
  Test.expect(moves == 40)
}

test "a locked item compared with a worn one: the cursor crossing the gap between them keeps it, and a click there is the group's" {
  let corner = frame("Frame", "GameTooltip", 1300, 720, 200, 80)
  let slot = frame("Button", "ContainerFrame1Item3", 1300, 200, 40, 40)
  Test.mount(nil, { left: 100, top: 50, width: 700, height: 600, screen: true })
  Tooltips.settings.draft.itemsAnchorBags = Place.Anchor
  saveAll()
  Game.items.stats = strength
  Game.tooltip.compared = [axe("Worn Axe")]
  Game.tooltip.main = inSlot(corner, slot, sword())
  Test.pass(1.3)
  Test.expect(Tooltips.locked)
  Test.shot("locked, the worn axe beside it")

  // A button of the game's under the gap (1065.5 to 1068.83 between the worn axe and the sword), which would hear a
  // click that went through.
  let clicked = 0
  const behind = Client.CreateFrame("Button", "Behind", Client.C_UI.GetUIParent(), nil)
  behind.SetSize(40, 40)
  behind.SetPoint("TOPLEFT", Client.C_UI.GetUIParent(), "TOPLEFT", 1050, -280)
  behind.SetScript("OnClick", (button: any Client.Frame): nil => { clicked += 1 })
  // Off the slot onto the sword, into the gap, onto the worn axe: each longer than the grace.
  Game.tooltip.main = hidden(corner)
  Test.moveTo({ x: 1200, y: 320 })
  Test.pass(0.5)
  Test.moveTo({ x: 1067.2, y: 300 })
  Test.pass(0.5)
  Test.expect(Tooltips.locked)
  Test.click({ x: 1067.2, y: 300 }, nil)
  Test.pass(0.1)
  Test.expect(clicked == 0 && Tooltips.locked)
  Test.moveTo({ x: 950, y: 300 })
  Test.pass(0.5)
  Test.expect(Tooltips.locked)
}

// The text of every tooltip drawn now, one after another.
function shownTexts(): String {
  let all = ""
  for (shown of Test.surfaces()) {
    for (text of shown.texts) { all = `${all}|${text}` }
  }
  return all
}

// Whether a tooltip drawn now holds this text.
function holds(text: String): Boolean {
  return shownTexts().contains(text)
}

test "a spell's tooltip after a unit's holds nothing of the unit's, locked or not, the game's gone between or not" {
  let corner = frame("Frame", "GameTooltip", 1300, 720, 200, 80)
  let slot = frame("Button", "ContainerFrame1Item3", 1300, 200, 40, 40)
  Test.mount(nil, { left: 100, top: 50, width: 700, height: 600, screen: true })
  Game.units.of = (unit: String): Game.UnitInfo | nil => unit != "mouseover" ? nil : {
    name: "Kragos", player: true, className: "Warrior", guild: "Kirin Tor", guildRank: "Officer", dead: false,
    ghost: false, afk: false, dnd: false, pvp: false, level: 34, race: "Human", faction: "Alliance",
    factionName: "Alliance", sameFaction: true, inParty: false, friend: false, ignored: false, tapped: false,
    classification: "normal",
  }
  Game.spells.cost = (id: Integer): Game.SpellCost | nil => id == 116 ? { amount: 65 } : nil
  for (lock of [false, true]) {
    for (gone of [false, true]) {
      Tooltips.settings.draft.spellsLock = lock
      saveAll()
      Tooltips.close()
      Game.tooltip.main = hidden(corner)
      Test.pass(0.3)
      Game.tooltip.main = showing(corner, {
        kind: 2, lines: [{ left: "Kragos", kind: 2, unit: "mouseover" }, { left: "Level 34 Human Warrior", kind: 0 }],
      })
      Test.pass(0.1)
      Test.expect(holds("Kirin Tor") && holds("Human"))
      if (gone) {
        Game.tooltip.main = hidden(corner)
        Test.pass(0.1)
      }
      Game.tooltip.main = frostbolt(corner, slot)
      Test.pass(1.3)
      Test.expect(Tooltips.locked == lock)
      Test.expect(holds("Frostbolt"))
      for (text of ["Kirin Tor", "Officer", "Human", "Alliance", "Kragos"]) {
        if (holds(text)) { panic(`locked ${lock}, gone ${gone}: the spell's tooltip holds the unit's «${text}»: ${shownTexts()}`) }
      }
    }
  }
}
