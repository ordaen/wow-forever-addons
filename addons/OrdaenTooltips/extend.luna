// What other modules add to Ordaen Tooltips' tooltips: the contract, imported by type alone
// (`import type { ItemLines, Line } from "OrdaenTooltips"`). Each section is a registry of Tooltips' root (`worth`,
// `uses`, `held` for an item, `gives` for a world object, `wants` for a creature), added to in a watch that follows that root; Tooltips
// draws what was added after its own footer (before the hotkeys), a section after another, each entry's lines
// together. An item's hotkeys take what `keys` gives after their own.

// A line another module adds: a label at the left, a value at the right.
public struct Line {
  left: String
  right: String | nil = nil
  color: Color | nil = nil
  rightColor: Color | nil = nil
  indent: Boolean = false
  // What its label opens once the tooltip is locked and the cursor comes onto it: a list of its own.
  opens: Listing | nil = nil
}

// A list a line opens, drawn as a tooltip beside it: its title, its rows, and the notes under them.
public struct Listing {
  name: String
  rows: Array<Listed>
  foot: Array<Line> = []
}

// A row of a list: a name with its value at the right; it may open an item's own tooltip (a recipe's product).
public struct Listed {
  left: String
  right: String | nil = nil
  color: Color | nil = nil
  item: Integer | nil = nil
}

// What a module adds to an item's tooltip. Asked each time an item is shown (the same item shown again after the
// game's tooltip went is a show of its own: what the entry reads unfollowed, an age by the clock, is read anew), and
// again when something it read changes; not while the item stays shown, however often the game fills its tooltip
// anew. Budget: one map read where nothing changed. The lines it gives are drawn as they are.
public trait ItemLines {
  public lines(self, item: Integer, link: String): Array<Line>
}

// What a module adds to an item tooltip's hotkeys («Alt+Left-click: protect the slot from sorting»): drawn after the
// tooltip's own, as they are. Budget as for `ItemLines`.
public trait ItemKeys {
  public keys(self, item: Integer, link: String): Array<String>
}

// An objective of a quest of the player's that a creature serves (it drops an item the quest asks for): the
// quest's title, the objective's text without its count, and the count.
public struct Wanted {
  quest: String
  objective: String
  have: Integer
  need: Integer
}

// What a module says a creature is wanted for, by the creature's number (`Game.UnitInfo.creature`): drawn as the
// game's own quest rows are, after them, a quest the game's rows already name left out. Budget as for `ItemLines`.
public trait UnitWants {
  public wants(self, creature: Integer): Array<Wanted>
}

// What a module adds to a world object's tooltip (a vein, a herb, a chest), by the object's name. Budget as for
// `ItemLines`.
public trait ObjectLines {
  public lines(self, name: String): Array<Line>
}
