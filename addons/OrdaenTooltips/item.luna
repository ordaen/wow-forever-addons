// An item's tooltip, read from the game's lines for it and from what the game knows of the item: its stats as rows,
// the band (damage and speed, damage per second, armour, block, a bag's slots), what it needs and what it is worth
// in the footer. What it does when used, the set it belongs to and the item a recipe makes are tooltips of their
// own beside it.
import Game from "$game"
import Ordaen from "Ordaen"
import { GOLD, GREEN, GREY, RED, WHITE, YELLOW, colorOf, hex } from "@/colors"
import Locale from "@/locales"
import { Fact, Kind, Model, Note, Opens, Part, TextLine, iconOf, named, namedWith } from "@/model"
import { Options } from "@/options"
import { spell } from "@/spell"
import { Term } from "@/terms"
import { clean, duration, form, last, number } from "@/text"

// The game's numbers for what a line of a tooltip is.
const BLANK = 1
const SELL_PRICE = 11
const NESTED = 19
const BINDING = 20
const ITEM_SLOT = 21
const ITEM_NAME = 22
const TEACHES = 38
const SET_LINE = 42
const REQUIREMENT = 43
const USE = 44
const EQUIP = 45
const CHANCE = 46

// An item as it was read.
// The term for how an item is bound, by the game's own text for it.
function binding(text: String): Opens {
  if (text == Game.strings.soulbound) { return named(Term.Bound) }
  if (text == Game.strings.bindOnEquip) { return named(Term.Boe) }
  if (text == Game.strings.bindOnPickup) { return named(Term.Bop) }
  return Opens.None
}

public struct ItemRead {
  model: Model
  // The tooltips beside it: what using it does, its set.
  sides: Array<Model>
  // What a recipe makes: the game's data for it, read as an item of its own.
  makes: Array<Game.TooltipData>
  // Its stats by the game's key for each, for a comparison.
  stats: Map<String, Number>
}

// A number as Ordaen writes it, by Ordaen's number settings.
function shown(n: Number): String {
  return Ordaen.number(n)
}

// What stood where a format of the game's has its first value, and its first two.
function one(text: String, format: String): String | nil {
  let parts = text.unformat(format)
  if (parts == nil) { return nil }
  return parts[1]
}

function two(text: String, format: String): (String | nil, String | nil) {
  let parts = text.unformat(format)
  if (parts == nil) { return nil, nil }
  return parts[1], parts[2]
}

// Durability's colour: red when broken, yellow at a quarter or less, the footer's own otherwise.
function durabilityColor(current: Number, most: Number): Color | nil {
  if (current <= 0) { return RED }
  if (current <= most / 4) { return YELLOW }
  return nil
}

// «%d slots», in the form the number takes.
function slots(count: Integer): String {
  let which = Game.client.locale == "ruRU" ? form(count) : (count == 1 ? 1 : 3)
  match (which) {
    1 => return Locale.COL_SLOTS_ONE.format(count),
    2 => return Locale.COL_SLOTS_FEW.format(count),
    else => return Locale.COL_SLOTS_MANY.format(count),
  }
}

// A recipe's reagents written as one line («Thick Leather (6), Citrine (2)») as rows, the count on the right.
// Whether there were any.
function reagents(text: String, body: mut Array<TextLine>): Boolean {
  let any = false
  for (part of text.split(",")) {
    let name, count = part.match("^%s*(.-)%s*%((%d+)%)%s*$")
    if (name != nil && count != nil && name != "") {
      body.push({ left: name, right: Locale.COUNT.format((count.toNumber() ?? 1).floor()) })
      any = true
    }
  }
  return any
}

// A model with one more line in its footer.
function withNote(model: Model, note: Note): Model {
  let foot: Array<Note> = []
  for (kept of model.foot) { foot.push(kept) }
  foot.push(note)
  return { foot: foot, timer: true, ..model }
}

public function item(data: Game.TooltipData, options: Options): ItemRead | nil {
  let id = data.id
  let name: String | nil = nil
  let nameColor = WHITE
  let desc: Array<Part> = []
  let info: Array<Part> = []
  let facts: Array<Fact> = []
  let body: Array<TextLine> = []
  let foot: Array<Note> = []
  let sides: Array<Model> = []
  let makes: Array<Game.TooltipData> = []
  let stats: Map<String, Number> = {}
  let timer = false

  let level = id != nil ? Game.items.level(id) : nil
  if (options.itemsIlvl && level != nil && level > 1) {
    body.push({ left: Locale.ITEM_LEVEL_ROW, right: shown(level), stat: "ilvl" })
    stats["ilvl"] = level
  }
  // The item's stats as rows; the stat lines among the game's are then left out.
  let hasStats = false
  for (stat of Game.items.stats(data)) {
    stats[stat.key] = stat.value
    body.push({ left: stat.name, right: "%+d".format(stat.value), stat: stat.key })
    hasStats = true
  }

  // Inside the lines of the item a recipe makes: they are that item's own tooltip.
  let nested = false
  let recipe = false
  let learned = false
  let setName: String | nil = nil
  let setBody: Array<TextLine> = []
  for (line of data.lines) {
    let kind = line.kind
    let left = clean(line.left)
    if (nested && kind == TEACHES) { nested = false }
    if (nested) { continue }
    let unmet = line.usable == false ? RED : nil
    if (kind == NESTED) {
      recipe = true
      let makes_id = line.made
      let made = makes_id != nil ? Game.items.tooltip(makes_id) : nil
      if (made != nil) { makes.push(made) }
      nested = true
    } else if (kind == ITEM_NAME) {
      name = left
      nameColor = line.quality ?? WHITE
    } else if (kind == ITEM_SLOT) {
      let right = clean(line.right)
      if (left != nil) { desc.push({ text: left, color: line.validSlot == false ? RED : nil }) }
      if (right != nil) { desc.push({ text: right, color: line.validType == false ? RED : nil }) }
    } else if (kind == BINDING) {
      if (left != nil) { info.push({ text: left, opens: binding(left) }) }
    } else if (kind == SELL_PRICE) {
      let price = line.price
      if (price != nil && price > 0) {
        foot.push({ left: Game.strings.sellPrice, right: Game.money.format(price) })
      }
    } else if (kind == REQUIREMENT) {
      if (left != nil) {
        let skill, rank = two(left, Game.strings.itemMinSkill)
        let needed = one(left, Game.strings.itemMinLevel)
        if (skill != nil && rank != nil) {
          foot.push({ left: skill, right: rank, valueColor: unmet, opens: named(Term.Prof) })
        } else if (needed != nil) {
          foot.push({ left: Locale.REQ_LEVEL, right: needed, valueColor: unmet, opens: named(Term.Req) })
        } else {
          foot.push({ left: left, valueColor: unmet, opens: named(Term.Req) })
        }
      }
    } else if (kind == USE) {
      // What using it does is a tooltip of its own beside the item: the spell with its cast and its cooldown.
      let cast = line.spell
      let used = cast != nil ? Game.spells.tooltip(cast) : nil
      let side = used != nil ? spell(used, options) : nil
      if (side != nil) {
        let wait = options.itemsCooldown && id != nil ? Game.items.cooldown(id) : nil
        if (wait != nil) {
          let ready = duration(wait, Game.strings.hours, Game.strings.minutes, Game.strings.seconds)
          sides.push(withNote(side, { left: Locale.READY_IN, right: ready, valueColor: YELLOW }))
          timer = true
        } else {
          sides.push(side)
        }
      } else if (left != nil) {
        body.push({ left: left, color: GREEN })
      }
    } else if (kind == TEACHES) {
      // A recipe's «Use: Teaches…»: the made item beside it says it.
      if (left != nil && !recipe) { body.push({ left: left, color: colorOf(line.leftColor) }) }
    } else if (kind == EQUIP || kind == CHANCE) {
      if (left != nil) { body.push({ left: left, color: GREEN }) }
    } else if (left != nil && left == Game.strings.itemSpellKnown) {
      learned = true
    } else if (kind == SET_LINE) {
      // The set is named only in its own tooltip beside the item: its first line the name, the rest its pieces
      // and bonuses.
      if (left != nil) {
        if (setName == nil) {
          setName = left
        } else {
          setBody.push({ left: left, color: colorOf(line.leftColor) ?? GREY })
        }
      }
    } else if (kind == BLANK || left == nil) {
      // Nothing to draw.
    } else if (left == Game.strings.itemUnique || left == Game.strings.itemUniqueEquippable) {
      desc.push({ text: left, opens: named(Term.Uni) })
    } else {
      // The band: damage and speed, damage per second, armour, block, a bag's slots; and the footer's lines.
      let lowSchool, highSchool = two(left, Game.strings.damageSchool)
      let lowPlain, highPlain = two(left, Game.strings.damage)
      let low = lowSchool ?? lowPlain
      let high = highSchool ?? highPlain
      let single = one(left, Game.strings.singleDamageSchool) ?? one(left, Game.strings.singleDamage)
      let dps = one(left, Game.strings.dps)
      let armor = one(left, Game.strings.armor)
      let block = one(left, Game.strings.shieldBlock)
      // The line as the game wrote it: its plural code is part of the format.
      let slotsA, slotsB = two(line.left ?? "", Game.strings.containerSlots)
      let room = number(slotsA ?? "") ?? number(slotsB ?? "")
      let current, most = two(left, Game.strings.durability)
      let classes = one(left, Game.strings.classesAllowed)
      let needs = one(left, Game.strings.spellReagents)
      if (low != nil && high != nil) {
        let from = number(low) ?? 0
        let to = number(high) ?? 0
        facts.push({ text: Locale.COL_DAMAGE.format(shown(from), shown(to)), glyph: .Dmg, opens: named(Term.Dmg) })
        stats["dmg"] = (from + to) / 2
        let speed = last(clean(line.right) ?? "")
        if (speed != nil) {
          facts.push({ text: Locale.COL_SPEED.format(shown(speed)), glyph: .Spd, opens: named(Term.Spd) })
          stats["spd"] = speed
        }
      } else if (single != nil) {
        facts.push({ text: shown(number(single) ?? 0), glyph: .Dmg, opens: named(Term.Dmg) })
      } else if (dps != nil) {
        let perSecond = number(dps) ?? 0
        facts.push({ text: Locale.COL_DPS.format(shown(perSecond)), opens: named(Term.Dps) })
        stats["dps"] = perSecond
      } else if (armor != nil) {
        // Armour beyond the item's own is in green.
        let worn = number(armor) ?? 0
        facts.push({
          text: shown(worn), color: colorOf(line.leftColor), glyph: .Arm,
          opens: namedWith(Term.Arm, shown(worn)),
        })
        stats["arm"] = worn
      } else if (block != nil) {
        let blocked = number(block) ?? 0
        facts.push({ text: shown(blocked), glyph: .Blk, opens: namedWith(Term.Blk, shown(blocked)) })
        stats["blk"] = blocked
      } else if (room != nil) {
        facts.push({ text: slots(room.floor()), opens: namedWith(Term.Bag, `${room.floor()}`) })
      } else if (current != nil && most != nil) {
        let now = number(current) ?? 0
        let whole = number(most) ?? 1
        foot.push({
          left: Locale.DURABILITY, right: "%d / %d".format(now, whole),
          valueColor: durabilityColor(now, whole), opens: named(Term.Dur),
        })
      } else if (classes != nil) {
        foot.push({
          left: Locale.CLASSES, right: classes, valueColor: colorOf(line.leftColor), opens: named(Term.Cls),
        })
      } else if (needs != nil && reagents(needs, mut body)) {
        // A recipe's reagents: rows.
      } else if (hasStats && left.match("^[%+%-]%d") != nil && colorOf(line.leftColor) == nil) {
        // A stat: its row is drawn from the item's stats.
      } else {
        body.push({ left: left, color: colorOf(line.leftColor) })
      }
    }
  }
  if (name == nil) { return nil }

  // «Known» or «Not known» joins a recipe's description.
  if (recipe) { desc.push({ text: learned ? Locale.KNOWN : Locale.NOT_KNOWN, color: learned ? GREY : nil }) }
  if (id != nil && options.itemsId) { info.push({ text: `ID ${id}` }) }
  if (id != nil) {
    let stack = Game.items.maxStack(id) ?? 1
    let bags = Game.items.inBags(id)
    let everywhere = Game.items.owned(id).max(bags)
    if (options.itemsCount && (stack > 1 || everywhere > 1)) {
      if (bags > 0) { foot.push({ left: Locale.IN_BAGS, right: shown(bags), opens: named(Term.Own) }) }
      if (everywhere - bags > 0) {
        foot.push({ left: Locale.IN_BANK, right: shown(everywhere - bags), opens: named(Term.Own) })
      }
    }
    if (options.itemsStack && stack > 1) {
      foot.push({ left: Locale.STACK, right: shown(stack), opens: named(Term.Stack) })
    }
  }
  if (setName != nil) {
    sides.push({
      kind: Kind.Set, name: setName, nameColor: GOLD,
      desc: [], info: [], facts: [], body: setBody, more: [], foot: [], keys: [],
    })
  }
  return {
    model: {
      kind: Kind.Item, picture: iconOf(id != nil ? Game.items.icon(id) : nil), name: name, nameColor: nameColor,
      desc: desc, info: info, facts: facts, body: body, more: [], foot: foot, keys: [], timer: timer,
    },
    sides: sides, makes: makes, stats: stats,
  }
}

// An item against the one it is compared with: each stat row of `target` gets the difference `better - worse` in
// brackets, a green ▲ when it is more and a red ▼ when it is less, nothing when they are equal. With `lacks`, the
// stats only `worse` has follow as «—» with what is lost: the hovered item against the worn one.
public function compare(
  target: Model, better: Map<String, Number>, worse: Map<String, Number>, lacks: Boolean,
): Model {
  let body: Array<TextLine> = []
  for (row of target.body) {
    let key = row.stat
    let right = row.right
    let diff = key != nil ? (better[key] ?? 0) - (worse[key] ?? 0) : 0
    if (right == nil || diff == 0) {
      body.push(row)
    } else {
      let mark = diff > 0 ? `|c${hex(GREEN)}(▲${shown(diff)})|r` : `|c${hex(RED)}(▼${shown(-diff)})|r`
      body.push({ right: `${right} ${mark}`, ..row })
    }
  }
  if (lacks) {
    for (key, value of worse) {
      if (better[key] == nil && key.match("^ITEM_MOD_") != nil) {
        body.push({
          left: Game.items.statName(key) ?? key, right: `— |c${hex(RED)}(▼${shown(value)})|r`, color: GREY,
        })
      }
    }
  }
  return { body: body, ..target }
}
