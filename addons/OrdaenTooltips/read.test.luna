  spells[7001] = {
    texture: "Interface/Icons/Spell_Holy_Heal",
    tooltip: {
      kind: 1, id: 7001,
      lines: [
        { left: "Healing Touch", kind: 13 },
        { left: "Instant", kind: 0 },
