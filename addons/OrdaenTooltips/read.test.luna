// Ordaen Tooltips' reader: the game's tooltip data as a test writes it, what the game answers about the spells, items,
// units, auras and talents in it, and the model the reader makes of it, written out as the snapshot.
import Game from "$game"
import { Art } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { compare } from "@/item"
import { Model, Opens, Picture } from "@/model"
import { Options } from "@/options"
import { Group, fill, group } from "@/read"
import { term } from "@/term"
import { Term } from "@/terms"

const WHITE: Color = { r: 1, g: 1, b: 1, a: 1 }
const GOLD: Color = { r: 1, g: 0.82, b: 0, a: 1 }
const RED: Color = { r: 1, g: 0.1, b: 0.1, a: 1 }
const GREEN: Color = { r: 0.12, g: 1, b: 0, a: 1 }
const BLUE: Color = { r: 0.3, g: 0.6, b: 1, a: 1 }
const ORANGE: Color = { r: 1, g: 0.5, b: 0, a: 1 }
const EPIC: Color = { r: 0.64, g: 0.21, b: 0.93, a: 1 }

const OPTIONS: Options = {
  spellsCooldown: true, spellsId: true, spellsNext: true, aurasCaster: true, aurasTotal: true, aurasId: true,
  classNames: true, playersTarget: true, playersRelation: true, npcsLoot: true, npcsParty: true, npcsRep: true,
  itemsIlvl: true, itemsCooldown: true, itemsId: true, itemsCount: true, itemsStack: true,
}

// What the test says the game knows of a spell, by its number.
struct Spell {
  texture: Art | nil
  cost: Game.SpellCost | nil
  tab: String | nil
  cooldown: Number | nil
  name: String | nil
  known: Boolean | nil
  tooltip: Game.TooltipData | nil
}

// What the test says the game knows of an item, by its number.
struct Item {
  icon: Art | nil
  level: Integer | nil
  cooldown: Number | nil
  maxStack: Integer | nil
  inBags: Integer = 0
  owned: Integer = 0
  tooltip: Game.TooltipData | nil
}

function colour(c: Color | nil): String {
  if (c == nil) { return "" }
  return " #%02x%02x%02x".format((c.r * 255).round(), (c.g * 255).round(), (c.b * 255).round())
}

function artOf(art: Art): String {
  if (art is String) { return art }
  if (art is Number) { return `${art}` }
  return `${art.file}`
}

// What a part opens in a locked tooltip.
function opens(what: Opens): String {
  match (what) {
    Opens.Term => {
      let amount = what.amount
      return ` (opens the term ${what.term}${amount != nil ? ` of ${amount}` : ""})`
    },
    Opens.Text => return ` (opens «${what.name}»: ${what.text})`,
    Opens.Unit => return ` (opens the unit ${what.unit})`,
    Opens.None => return "",
  }
}

function describe(model: Model) {
  let picture = model.picture
  let shown = ""
  match (picture) {
    Picture.Icon => { shown = ` [${artOf(picture.art)}]` },
    Picture.Face => { shown = ` [the face of ${picture.unit}]` },
    else => {},
  }
  Test.note(`${model.kind}: ${model.name}${colour(model.nameColor)}${shown}${model.timer == true ? " (counts down)" : ""}`)
  for (part of model.desc) { Test.note(`  desc: ${part.text}${colour(part.color)}${opens(part.opens)}`) }
  for (part of model.info) { Test.note(`  info: ${part.text}${colour(part.color)}${opens(part.opens)}`) }
  for (fact of model.facts) {
    let glyph = fact.glyph
    Test.note(`  fact: ${fact.text}${colour(fact.color)}${glyph != nil ? ` [glyphs/${glyph}]` : ""}${colour(fact.tint)}${opens(fact.opens)}`)
  }
  for (line of model.body) {
    let right = line.right
    Test.note(`  body: ${line.left}${colour(line.color)}${right != nil ? ` | ${right}${colour(line.rightColor)}` : ""}${line.desc == true ? " (a description)" : ""}${opens(line.opens)}`.replace("\n", " / "))
  }
  for (line of model.more) {
    let right = line.right
    Test.note(`  more: ${line.indent == true ? "    " : ""}${line.left}${colour(line.color)}${right != nil ? ` | ${right}${colour(line.rightColor)}` : ""}${opens(line.opens)}`)
  }
  for (note of model.foot) {
    Test.note(`  foot: ${note.left}${opens(note.opens)} | ${note.right ?? "nil"}${colour(note.valueColor)}${opens(note.valueOpens)}`)
  }
  for (key of model.keys) { Test.note(`  key: ${key}`) }
}

function show(title: String, data: Game.TooltipData) {
  Test.note(`== ${title}`)
  let model = fill(data, OPTIONS)
  if (model == nil) { Test.note("left to the game") } else { describe(model) }
  Test.note("")
}

function showGroup(title: String, data: Game.TooltipData): Group | nil {
  Test.note(`== ${title}`)
  let read = group(data, OPTIONS)
  if (read == nil) {
    Test.note("left to the game")
    Test.note("")
    return nil
  }
  describe(read.model)
  for (side of read.sides) {
    Test.note("beside it:")
    describe(side)
  }
  let keys: Array<String> = []
  for (key, _ of read.stats) { keys.push(key) }
  keys.sort((a: String, b: String): Boolean => a < b)
  for (key of keys) { Test.note(`  stat ${key} = ${read.stats[key] ?? 0}`) }
  Test.note("")
  return read
}

function noTalent(data: Game.TooltipData): Game.TalentInfo | nil { return nil }
function noAura(data: Game.TooltipData): Game.AuraInfo | nil { return nil }

test "the reader's model of each kind of the game's tooltips" {
  let spells: Map<Integer, Spell> = {}
