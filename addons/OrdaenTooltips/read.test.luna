  _ = showGroup("an item with no name line", { kind: 0, lines: [{ left: "?", kind: 0 }] })

  statNames["ITEM_MOD_AGILITY_SHORT"] = "Agility"
  let hovered = group({ kind: 0, lines: [{ left: "Greataxe", kind: 22 }] }, OPTIONS)
  Test.note("== compared: the hovered item against the worn one, and the worn one against the hovered")
  Test.expect(worn != nil && hovered != nil)
  if (worn != nil && hovered != nil) {
    let wornStats: Map<String, Number> = {}
    for (key, value of worn.stats) { wornStats[key] = value }
    wornStats["ITEM_MOD_AGILITY_SHORT"] = 7
    describe(compare(hovered.model, hovered.stats, wornStats, true))
    describe(compare(worn.model, wornStats, hovered.stats, false))
  }
  Test.note("")

  Test.note("== terms of the glossary: the name and the text, the amount a part speaks of in them")
  describe(term(Term.Cd, nil))
  describe(term(Term.Arm, "120"))
  describe(term(Term.Bag, "16"))
  Test.note("")

  show("what the game has no kind for", { kind: 9, lines: [{ left: "?", kind: 0 }] })
}

test "an item's numbers are written as Ordaen writes them" {
  let data: Game.TooltipData = {
    kind: 0, id: 9100,
    lines: [
      { left: "Tower Shield", kind: 22 },
      { left: "1234 Armor", kind: 0 },
      { left: "216 - 325 Damage", right: "Speed 3,40", kind: 0 },
      { left: "(78.35 damage per second)", kind: 0 },
    ],
  }
  _ = showGroup("as Ordaen starts: a space between thousands, two decimals", data)
  // Ordaen's settings as its window writes and saves them: Ordaen's own, changed through its methods.
  const ordaen = Ordaen ?? panic("Ordaen is needed by name: its root is made before a module's")
  ordaen.globals.choose({ numberFormat: .Dot, numberRound: true, ..ordaen.globals.values })
  ordaen.keeper.saveAll()
  _ = showGroup("dots between thousands, whole numbers", data)
}
