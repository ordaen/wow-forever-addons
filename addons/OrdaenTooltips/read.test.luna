  }
  _ = showGroup("a recipe: what it makes beside it, its reagents as rows, not known", {
    kind: 0, id: 9003,
    lines: [
      { left: "Pattern: Swift Boots", kind: 22 },
      { kind: 19, made: 9004 },
      { left: "Swift Boots", kind: 22 },
      { left: "40 Armor", kind: 0 },
