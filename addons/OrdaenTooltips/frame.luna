// One Ordaen tooltip's frame: the small metal frame round the windows' wood, a panel's room inside, and the sections in the
// one order, each left out when empty: the header, the title (the icon beside three lines), the band of facts, the
// body, what there is more of, the footer, what other modules add, the hotkeys. A rule only between two present sections, none between the
// title and the body. As wide as its title and its band (they never wrap), 314 px at least; the body wraps at that
// width.
import { Align, Art, BarFill, Beside, Bounds, Cursor, Edges, Layer, Line, Overflow, Position, Scrollbar, Side, TextFont, Track } from "$ltml"
import root Ordaen from "Ordaen"
import {
  BandCell, Component, HeaderTab, Hotkeys, SECONDARY_TEXT, TERM_DASH, TERM_UNDERLINE, TERM_UNDERLINE_HEIGHT, TITLE_TEXT, termUnderlineAt
} from "Ordaen"
import { GREEN, RED } from "@/colors"
import Locale from "@/locales"
import { Compared, Model, Opens, Part, Picture, TextLine } from "@/model"

const WIDTH = 367.96875dp
// The most a tooltip's body stands: past it, it scrolls.
const BODY_MOST: Bounds = { min: nil, max: 421.875dp }
// A tooltip beside another: a little narrower.
const SIDE_WIDTH = 309.375dp
const ICON = 70.3125dp
// The ladder's steps (`space`): a line's between the lines of a section, an item's round a section, a panel's
// inside the frame.
const LINE: number<Spacing> = 2sp
const SECTION: number<Spacing> = 3sp
const INSIDE: number<Spacing> = 5sp
const LABEL: color = #cbb994
const QUIET: color = #857a66
const QUIET_VALUE: color = #a39883
public const BODY: color = #f3e7cc
const FREE: color = #e6dcc6
const BLACK: color = #000000
public const RULE: Line = { width: 1.171875dp, color: #d6a56b2e, sides: [Side::Top] }
const RIM: Line = { width: 1.171875dp, color: #6c5535 }
const FILL: array<Track> = [{ fr: 1 }]
const WITH_ICON: array<Track> = [ICON, { fr: 1 }]
const ALONE: array<Track> = [{ fr: 1 }]
public const NAME_VALUE: array<Track> = [{ fr: 1 }, "max-content"]
// A line's icon (a reagent's), a line of the footer's text high.
const LINE_ICON = 16.40625dp
const ICON_NAME_VALUE: array<Track> = [LINE_ICON, { fr: 1 }, "max-content"]
const ICON_NAME: array<Track> = [LINE_ICON, { fr: 1 }]
// A compared value: the value, then its difference «(by», the mark, «)», 3 px apart (the design's `.diff`), the mark
// 10 px (ctl.compareUp, ctl.compareDown).
const COMPARED: array<Track> = ["max-content", "max-content", "max-content", "max-content"]
const COMPARED_GAP = 1sp
const COMPARED_MARK = 11.71875dp
// A text at its own width, the rest of its row empty.
public const OWN_WIDTH: array<Track> = ["max-content", { fr: 1 }]
public const SECTION_PAD: Edges = { top: SECTION, bottom: SECTION }
// The hotkeys, last in a tooltip that has no bar, keep a section's room under them (`Hotkeys` keeps it over them);
// before the bar, the bar's own room is all there is between them.
const KEYS_PAD: Edges = { bottom: SECTION }
const NO_KEYS_PAD: Edges = {}
// The lock's bar: the tooltip's last section, a dark track that gold fills as the lock charges, in a hundred steps;
// quiet, never louder than the text. Its row is as high as the line that stands there once locked, so nothing
// moves when the lock lands.
const BAR_PAD: Edges = { top: SECTION }
const BAR_ROW = 22.5dp
const BAR_HEIGHT = 3.515625dp
const TRACK: color = #00000073
const BAR_GOLD: color = #d6a56b80
// What opens something is underlined while the tooltip is locked (Ordaen's TERM_DASH), and its tooltip stands
// beside it.
// A compared tooltip's header («Equipped») over its title: the main tooltip beside it stands as much lower, so the
// titles are level.
public const HEADER: number<Spacing> = 10.5sp
const BY_ITS_TEXT: Beside = { beside: "parent" }
// The game's red X.
const CLOSE_ART: Asset = "Interface/Buttons/UI-Panel-MinimizeButton-Up"
const UNDER_TITLE: Edges = { bottom: SECTION }
public const NO_PAD: Edges = {}
public const INDENT: Edges = { left: 3.5sp }
// Where the body turns from rows into sentences or back.
const SPACED: Edges = { top: 2sp }
// Over a quest's title that follows another quest's rows.
const APART: Edges = { top: 4sp }

// A line as it is drawn: its texts, their colours, its size, and the room round it.
public struct Drawn {
  public mut left: string
  public mut right: string | nil
  public mut leftColor: color
  public mut rightColor: color
  public mut size: number<TextSize>
  public mut padding: Edges
  // A sentence (a description), its lines a little apart.
  public mut sentence: boolean = false
  // What its name opens, and what its value does.
  public mut opens: Opens
  public mut valueOpens: Opens
  // An item's stat against the compared item's, after the value.
  public mut compared: Compared | nil
  // The icon before its name: a reagent's.
  public mut icon: Art | nil = nil
}

function opensSomething(opens: Opens): boolean {
  match (opens) {
    Opens::None => return false
    else => return true
  }
}

// A text that may open something: in a locked tooltip it is underlined, the cursor on it is the question mark, and
// what it opens is drawn beside it, by whoever fills `opened`, until the cursor leaves both (what it opens may open
// further: a list's rows). Never wrapped; the underline and the cursor's reach are the text's own width.
public class TermText implements Component {
  public slot opened(opens: Opens)

  state over = false
  state onOpened = false
  derived lit: boolean = self.locked && self.opensSomething()
  derived open: boolean = self.lit && (self.over || self.onOpened)

  text: Signal<string>
  color: Signal<color>
  size: Signal<number<TextSize>>
  opens: Signal<Opens>
  locked: Signal<boolean>
  const font: TextFont | nil
  constructor(
    text: Signal<string>,
    color: Signal<color>,
    size: Signal<number<TextSize>>,
    opens: Signal<Opens>,
    locked: Signal<boolean>,
    // A value's text is in the numbers' font; nothing keeps the text's.
    font: TextFont | nil = nil
  ) {
    self.text = text
    self.color = color
    self.size = size
    self.opens = opens
    self.locked = locked
    self.font = font
    watch { self.forgetCursor() }
  }

  opensSomething(): boolean { return opensSomething(self.opens) }

  // What takes the cursor goes with the lock, and says nothing as it goes.
  mut forgetCursor() {
    if (!self.lit) {
      self.over = false
      self.onOpened = false
    }
  }

  mut onEnter() { self.over = true }
  mut onLeave() { self.over = false }
  mut onEnterOpened() { self.onOpened = true }
  mut onLeaveOpened() { self.onOpened = false }

  public render(): Template {
    return $ltml {
      <box>
        <text value={self.text} textColor={self.color} textSize={self.size} wrap={.None}
              textFont={self.font} />
        <box $if={self.lit} position={Position::Absolute} left={0ui} right={0ui} bottom={termUnderlineAt()} height={TERM_UNDERLINE_HEIGHT}
             background={TERM_DASH} tint={TERM_UNDERLINE} />
        <box $if={self.lit} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             cursor={Cursor::Help} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave} />
        <surface leading={.Tight} $if={self.open} layer={Layer::Tooltip} place={BY_ITS_TEXT}>
          <box mouseThrough={true} @pointerEnter={self.onEnterOpened} @pointerLeave={self.onLeaveOpened}>
            <slot #opened opens={self.opens} />
          </box>
        </surface>
      </box>
    }
  }
}

// A piece of a title's line, after the « · » that joins it to the one before.
public class PartText implements Component {
  public slot opened(opens: Opens)

  derived notFirst: boolean = self.index > 1
  derived own: color = self.part.color ?? self.color

  part: Signal<Part>
  index: Signal<integer>
  const color: color
  locked: Signal<boolean>
  constructor(
    part: Signal<Part>,
    index: Signal<integer>,
    // The line's colour, for a piece without its own.
    color: color,
    locked: Signal<boolean> = false
  ) {
    self.part = part
    self.index = index
    self.color = color
    self.locked = locked
  }

  public render(): Template {
    return $ltml {
      // In the numbers' font: the client's own for texts has no middle dot.
      <text $if={self.notFirst} value={" · "} textColor={self.color} textSize={SECONDARY_TEXT} wrap={.None}
            textFont={.Numbers} />
      <TermText text={self.part.text} color={self.own} size={SECONDARY_TEXT} opens={self.part.opens} locked={self.locked}>
        <box #opened={opens}>
          <slot #opened opens={opens} />
        </box>
      </TermText>
    }
  }
}

// A line: a name with its value on the right, never wrapped, or free text that wraps at the tooltip's width. A
// name that opens something is a `TermText` of its own width, the rest of its row empty.
public class Row implements Component {
  public slot opened(opens: Opens)

  derived paired: boolean = self.line.right != nil
  derived right: string = self.line.right ?? ""
  derived opening: boolean = opensSomething(self.line.opens)
  derived valueOpening: boolean = opensSomething(self.line.valueOpens)
  // A compared stat's difference: «(by ▲)» green when it is more, «(by ▼)» red when less, after the value.
  derived hasCompared: boolean = self.line.compared != nil
  derived plainValue: boolean = !self.hasCompared && !self.valueOpening
  derived comparedMore: boolean = self.line.compared?.more == true
  derived comparedColor: color = self.comparedMore ? GREEN : RED
  derived comparedMark: Art = self.comparedMore ? Ordaen.art.ctl.compareUp : Ordaen.art.ctl.compareDown
  derived comparedBy: string = `(${self.line.compared?.by ?? ""}`
  // A line with an icon (a reagent's) has it in a column before its name.
  derived hasIcon: boolean = self.line.icon != nil
  derived tracks: array<Track> = self.hasIcon ? ICON_NAME_VALUE : NAME_VALUE

  line: Signal<Drawn>
  locked: Signal<boolean>
  constructor(line: Signal<Drawn>, locked: Signal<boolean> = false) {
    self.line = line
    self.locked = locked
  }

  public render(): Template {
    return $ltml {
      <box $if={self.paired} columns={self.tracks} gap={3sp} padding={self.line.padding}>
        <box $if={self.hasIcon} width={LINE_ICON} height={LINE_ICON} icon={self.line.icon} />
        <box $if={self.opening} columns={OWN_WIDTH}>
          <TermText text={self.line.left} color={self.line.leftColor} size={self.line.size} opens={self.line.opens}
                    locked={self.locked}>
            <box #opened={opens}>
              <slot #opened opens={opens} />
            </box>
          </TermText>
        </box>
        <text $else value={self.line.left} textColor={self.line.leftColor} textSize={self.line.size} />
        // A value, in the numbers' font; a compared one (an item's stat: it opens nothing) with its difference after
        // it, the mark art (no font carries it) tinted as the difference's text.
        <box $if={self.hasCompared} columns={COMPARED} gap={COMPARED_GAP} yAlign={Align::Center}>
          <text value={self.right} textColor={self.line.rightColor} textSize={self.line.size} wrap={.None}
                textFont={.Numbers} />
          <text value={self.comparedBy} textColor={self.comparedColor} textSize={self.line.size} wrap={.None}
                textFont={.Numbers} />
          <box width={COMPARED_MARK} height={COMPARED_MARK} background={self.comparedMark} tint={self.comparedColor} />
          <text value={")"} textColor={self.comparedColor} textSize={self.line.size} wrap={.None} textFont={.Numbers} />
        </box>
        <TermText $if={self.valueOpening} text={self.right} color={self.line.rightColor} size={self.line.size}
                  opens={self.line.valueOpens} locked={self.locked} font={.Numbers}>
          <box #opened={opens}>
            <slot #opened opens={opens} />
          </box>
        </TermText>
        <text $if={self.plainValue} value={self.right} textColor={self.line.rightColor} textSize={self.line.size}
              wrap={.None} textFont={.Numbers} />
      </box>
      <box $elseif={self.hasIcon} columns={ICON_NAME} gap={3sp} yAlign={Align::Center} padding={self.line.padding}>
        <box width={LINE_ICON} height={LINE_ICON} icon={self.line.icon} />
        <text value={self.line.left} textColor={self.line.leftColor} textSize={self.line.size} />
      </box>
      <box $else padding={self.line.padding}>
        <box $if={self.opening} columns={OWN_WIDTH}>
          <TermText text={self.line.left} color={self.line.leftColor} size={self.line.size} opens={self.line.opens}
                    locked={self.locked}>
            <box #opened={opens}>
              <slot #opened opens={opens} />
            </box>
          </TermText>
        </box>
        <text $elseif={self.line.sentence} value={self.line.left} textColor={self.line.leftColor} textSize={self.line.size}
              leading={.Prose} />
        <text $else value={self.line.left} textColor={self.line.leftColor} textSize={self.line.size} />
      </box>
    }
  }
}

// A section's lines as they are drawn, each the ladder's `Primary`: a row with a value and a description in the
// body's colour, other free lines in their own; 6 px more above a line where rows turn into sentences or back.
// `was` is the section as it was drawn, made from the lines `from`: a line that is the one it was made from, with
// the room it had, is `was`'s again, and with every line so, `was` itself.
function rows(lines: array<TextLine>, was: array<Drawn>, from: array<TextLine>): array<Drawn> {
  let list: array<Drawn> = mut []
  let same = lines.length == was.length
  let pairedBefore = false
  let underHead = false
  for (index, line of lines) {
    let paired = line.right != nil
    let padding = NO_PAD
    if (line.indent == true) {
      padding = INDENT
    } else if (line.heads == true) {
      padding = index > 1 ? APART : NO_PAD
    } else if (index > 1 && paired != pairedBefore && !underHead) {
      padding = SPACED
    }
    pairedBefore = paired
    underHead = line.heads == true
    let old = was[index]
    if (old != nil && from[index] == line && old.padding == padding) {
      list.push(old)
      continue
    }
    same = false
    let plain = paired || line.desc == true ? BODY : FREE
    list.push({
      left: line.left, right: line.right, leftColor: line.color ?? plain,
      rightColor: line.rightColor ?? line.color ?? BODY, size: 1rem, padding: padding, opens: line.opens,
      valueOpens: Opens::None, compared: line.compared, sentence: line.desc == true, icon: line.icon
    })
  }
  return same ? was : list
}

public class TipFrame implements Component {
  derived width: number<Length> = self.side ? SIDE_WIDTH : WIDTH
  derived hasHeader: boolean = self.model.header != nil
  derived header: string = self.model.header ?? ""
  derived headerHigh: number<Length> = Ordaen.lengthOf(HEADER)
  // The picture by the title: an icon, or a unit's face.
  derived hasIcon: boolean = self.pictured()
  derived icon: Art | nil = self.iconArt()
  derived face: string | nil = self.faceUnit()
  derived titleColumns: array<Track> = self.hasIcon ? WITH_ICON : ALONE
  // A tooltip with no name nor picture (what using an item does, under its tab) has no title: its first section
  // stands at its top, with no rule over it.
  derived titled: boolean = self.model.name != "" || self.hasIcon
  derived factsRule: Line | nil = self.titled ? RULE : nil
  derived hasDesc: boolean = self.model.desc.length > 0
  derived hasInfo: boolean = self.model.info.length > 0
  derived descColumns: array<Track> = self.tracks(self.model.desc.length)
  derived infoColumns: array<Track> = self.tracks(self.model.info.length)

  derived facts: integer = self.model.facts.length
  derived hasFacts: boolean = self.facts > 0
  // The body's lines and what there is more of, as they are drawn, kept from one model to the next: a line of the
  // model that is the line it was is drawn by the row it had, so a model with one line changed draws that line
  // anew and nothing else. `bodyOf` and `moreOf` are the model's lines each was made from.
  state body: array<Drawn> = []
  state more: array<Drawn> = []
  bodyOf: array<TextLine> = []
  moreOf: array<TextLine> = []
  derived foot: array<Drawn> = self.notes()
  derived hasBody: boolean = self.body.length > 0
  derived hasMore: boolean = self.more.length > 0
  derived hasFoot: boolean = self.foot.length > 0
  derived hasKeys: boolean = self.model.keys.length > 0
  // The band ends the tooltip.
  derived bandLast: boolean = !self.hasBody && !self.hasMore && !self.hasFoot && !self.hasKeys
  // The title alone (a sign): no room under it.
  derived titlePadding: Edges = self.hasFacts || !self.bandLast || self.hasHeader ? UNDER_TITLE : NO_PAD
  // A rule only between two present sections; none between the title and the body. The title is always there,
  // so every section after the body has one.
  derived bodyRule: Line | nil = self.hasFacts ? RULE : nil

  // The track shows once the charge starts; its room is there from the start.
  derived track: color | nil = self.charge > 0 ? TRACK : nil
  derived filled: BarFill = { value: self.charge / 100, color: BAR_GOLD }

  // The close button of a locked tooltip was clicked.
  public close: Event<nil> = new Event()
  // What a part of the locked tooltip opens, drawn beside the part while the cursor is on it.
  public slot opened(opens: Opens)

  model: Signal<Model>
  side: Signal<boolean>
  locks: Signal<boolean>
  charge: Signal<integer>
  locked: Signal<boolean>
  constructor(
    model: Signal<Model>,
    side: Signal<boolean> = false,
    // The main tooltip of a group that locks: it has the lock's bar, filled this far of a hundred, and is locked or
    // not. One that never locks (a button's text) keeps no room for a bar: it is its content's height.
    locks: Signal<boolean> = false,
    charge: Signal<integer> = 0,
    locked: Signal<boolean> = false
  ) {
    self.model = model
    self.side = side
    self.locks = locks
    self.charge = charge
    self.locked = locked
    watch { self.keepBody() }
    watch { self.keepMore() }
  }

  mut onClose() { self.close.emit() }

  mut keepBody() {
    const lines = self.model.body
    self.body = rows(lines, peek self.body, self.bodyOf)
    self.bodyOf = lines
  }

  mut keepMore() {
    const lines = self.model.more
    self.more = rows(lines, peek self.more, self.moreOf)
    self.moreOf = lines
  }

  pictured(): boolean {
    let picture = self.model.picture
    match (picture) {
      Picture::None => return false
      else => return true
    }
  }

  iconArt(): Art | nil {
    let picture = self.model.picture
    match (picture) {
      Picture::Icon => return picture.art
      else => return nil
    }
  }

  faceUnit(): string | nil {
    let picture = self.model.picture
    match (picture) {
      Picture::Face => return picture.unit
      else => return nil
    }
  }

  // One column as wide as each piece and each « · » between two, and the rest of the row empty.
  tracks(pieces: integer): array<Track> {
    let list: array<Track> = mut []
    for (i of 1..pieces) {
      if (i > 1) { list.push("max-content") }
      list.push("max-content")
    }
    list.push({ fr: 1 })
    return list
  }

  notes(): array<Drawn> {
    let list: array<Drawn> = mut []
    for (note of self.model.foot) {
      let alone = note.right == nil
      list.push({
        left: note.left, right: note.right, leftColor: alone ? note.valueColor ?? QUIET : QUIET,
        rightColor: note.valueColor ?? QUIET_VALUE, size: SECONDARY_TEXT, padding: NO_PAD, opens: note.opens,
        valueOpens: note.valueOpens, compared: nil, icon: note.icon
      })
    }
    return list
  }

  public render(): Template {
    return $ltml {
      // A header («Equipped») is a tab on the frame's top, in its middle, as high as `HEADER` takes: the main tooltip
      // beside it stands as much lower, so the titles are level.
      <box width={"min-content"}>
        <box $if={self.hasHeader} height={self.headerHigh} xAlign={Align::Center} yAlign={Align::End}>
          <HeaderTab title={self.header} height={self.headerHigh} />
        </box>
        <box width={"min-content"} padding={INSIDE} border={Ordaen.art.frame.small}
             background={Ordaen.art.window.wood}>
          <box width={self.width} height={0ui} />
          <box $if={self.titled} columns={self.titleColumns} gap={3sp} yAlign={Align::Center} padding={self.titlePadding}>
            <box $if={self.hasIcon} width={ICON} height={ICON} border={RIM} padding={0.5sp} background={BLACK}
                 rows={FILL}>
              <box icon={self.icon} portrait={self.face} />
            </box>
            <box gap={LINE} yAlign={Align::Center}>
              <text value={self.model.name} textColor={self.model.nameColor} textSize={TITLE_TEXT} leading={.Tight} wrap={.None}
                    textFont={.Title} />
              <box $if={self.hasDesc} columns={self.descColumns} yAlign={Align::Center}>
                <PartText $for={index, part of self.model.desc} part={part} index={index} color={LABEL}
                          locked={self.locked}>
                  <box #opened={opens}>
                    <slot #opened opens={opens} />
                  </box>
                </PartText>
              </box>
              <box $if={self.hasInfo} columns={self.infoColumns} yAlign={Align::Center}>
                <PartText $for={index, part of self.model.info} part={part} index={index} color={QUIET}
                          locked={self.locked}>
                  <box #opened={opens}>
                    <slot #opened opens={opens} />
                  </box>
                </PartText>
              </box>
            </box>
          </box>
          <box $if={self.hasFacts} columns={self.facts} border={self.factsRule}>
            <BandCell $for={index, fact of self.model.facts} fact={fact.cell} index={index} last={self.bandLast}
                      lit={self.locked && opensSomething(fact.opens)}>
              <box #opened>
                <slot #opened opens={fact.opens} />
              </box>
            </BandCell>
          </box>
          // A long body (a cloth in thirty recipes) scrolls past its most height, its scrollbar shown on hover.
          <box $if={self.hasBody} gap={LINE} padding={SECTION_PAD} border={self.bodyRule} height={BODY_MOST}
               overflow={Overflow::Scroll} scrollbar={Scrollbar::Hover}>
            <Row $for={line of self.body} line={line} locked={self.locked}>
              <box #opened={opens}>
                <slot #opened opens={opens} />
              </box>
            </Row>
          </box>
          <box $if={self.hasMore} gap={LINE} padding={SECTION_PAD} border={RULE}>
            <Row $for={line of self.more} line={line} locked={self.locked}>
              <box #opened={opens}>
                <slot #opened opens={opens} />
              </box>
            </Row>
          </box>
          <box $if={self.hasFoot} gap={LINE} padding={SECTION_PAD} border={RULE}>
            <Row $for={line of self.foot} line={line} locked={self.locked}>
              <box #opened={opens}>
                <slot #opened opens={opens} />
              </box>
            </Row>
          </box>
          // What other modules add, after the footer: the main tooltip's owner fills it.
          <slot />
          <box $if={self.hasKeys} padding={self.locks ? NO_KEYS_PAD : KEYS_PAD}>
            <Hotkeys keys={self.model.keys} />
          </box>
          <box $if={self.locks} padding={BAR_PAD}>
            <box height={BAR_ROW} yAlign={Align::Center}>
              <text $if={self.locked} value={Locale::LOCKED_HINT} textColor={QUIET} textSize={SECONDARY_TEXT} wrap={.None} />
              <box $else height={BAR_HEIGHT} background={self.track} fill={self.filled} />
            </box>
          </box>
          <box $if={self.locked} position={Position::Absolute} right={2.34375dp} top={2.34375dp} width={28.125dp}
               height={28.125dp} background={CLOSE_ART} @pointerPress={self.onClose} @keyPress(.Enter)={self.onClose} @keyPress(.Space)={self.onClose} />
        </box>
      </box>
    }
  }
}
