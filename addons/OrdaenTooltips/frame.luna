// One Ordaen tooltip's frame: the small metal frame round the windows' wood, 12 px inside, and the sections in the
// one order, each left out when empty: the header, the title (the icon beside three lines), the band of facts, the
// body, what there is more of, the footer, what other modules add, the hotkeys. A rule only between two present sections, none between the
// title and the body. As wide as its title and its band (they never wrap), 314 px at least; the body wraps at that
// width.
import { Align, Art, Piece, Beside, Cursor, Edges, Layer, Line, Position, Side, Size, TextFont, TextSize, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "Ordaen"
import Locale from "@/locales"
import { GREEN, RED } from "@/colors"
import { Compared, Fact, Glyph, Model, Opens, Part, Picture, TextLine } from "@/model"

public const PX: Number = 1 / 1.2
// The glyphs' pictures (art/pieces/tooltip-glyphs.json): a column of 20 px cells, a row each in the order of
// `Glyph`, the 16 px glyph 2 px in from its cell's top left, its shadow inside the cell; then the cost's dot's light
// and shade alone, drawn over the tinted dot.
const GLYPH_FILE: Asset = "@/assets/tooltip-glyphs.tga"
const GLYPH = 16 * PX
const GLYPH_CELL = 20 * PX
const GLYPH_IN = -2 * PX
const function glyphPieces(): Array<Piece> {
  let list: Array<Piece> = []
  for (row of 0..=13) { list.push({ file: GLYPH_FILE, width: 32, height: 512, rows: 16, normal: row }) }
  return list
}
const GLYPH_ART: Array<Piece> = glyphPieces()
const DOT_LIGHT: Piece = GLYPH_ART[14] ?? panic("the dot's light is the last row")
// A glyph's picture.
public function glyphArt(glyph: Glyph): Piece {
  const row = match (glyph) {
    .Dmg => 1, .Spd => 2, .Arm => 3, .Blk => 4, .Alliance => 5, .Horde => 6, .Elite => 7, .Time => 8, .Cost => 9,
    .CastNow => 10, .CastTime => 11, .CastChan => 12, .CastNext => 13,
  }
  return GLYPH_ART[row] ?? panic("a row for every glyph")
}
const WIDTH = 314 * PX
// A tooltip beside another: a little narrower.
const SIDE_WIDTH = 264 * PX
const ICON = 60 * PX
const SECTION = 8 * PX
const HEADING: Color = Color.hex("#ffd100")
const LABEL: Color = Color.hex("#cbb994")
const QUIET: Color = Color.hex("#857a66")
const QUIET_VALUE: Color = Color.hex("#a39883")
public const BODY: Color = Color.hex("#f3e7cc")
const FREE: Color = Color.hex("#e6dcc6")
const BLACK: Color = Color.hex("#000000")
public const RULE: Line = { width: 1 * PX, color: Color.hex("#d6a56b2e"), sides: [Side.Top] }
const DIVIDER: Line = { width: 1 * PX, color: Color.hex("#d6a56b2e"), sides: [Side.Left] }
const GROOVE: Line = { width: 1 * PX, color: Color.hex("#000000d9"), sides: [Side.Top, Side.Bottom] }
const RIM: Line = { width: 1 * PX, color: Color.hex("#6c5535") }
const FILL: Array<Track> = [{ fr: 1 }]
const WITH_ICON: Array<Track> = [ICON, { fr: 1 }]
const ALONE: Array<Track> = [{ fr: 1 }]
public const NAME_VALUE: Array<Track> = [{ fr: 1 }, "auto"]
// A compared value: the value, then its difference «(by», the mark, «)», 3 px apart (the design's `.diff`), the mark
// 10 px (ctl.compareUp, ctl.compareDown).
const COMPARED: Array<Track> = ["auto", "auto", "auto", "auto"]
const COMPARED_GAP = 3 * PX
const COMPARED_MARK = 10 * PX
// A text at its own width, the rest of its row empty.
const OWN_WIDTH: Array<Track> = ["auto", { fr: 1 }]
public const SECTION_PAD: Edges = { top: SECTION, bottom: SECTION }
// The lock's bar: the tooltip's last section, a dark track that gold fills as the lock charges, in a hundred steps;
// quiet, never louder than the text. Its row is as high as the line that stands there once locked, so nothing
// moves when the lock lands.
const BAR_PAD: Edges = { top: SECTION }
const BAR_ROW = 16 * PX
const BAR_HEIGHT = 3 * PX
const TRACK: Color = Color.hex("#00000073")
const BAR_GOLD: Color = Color.hex("#d6a56b80")
// What opens something is underlined while the tooltip is locked, and its tooltip stands beside it.
const UNDERLINE: Color = Color.hex("#ffd100b3")
const BY_ITS_TEXT: Beside = { beside: "parent" }
// The game's red X.
const CLOSE_ART: Asset = "Interface/Buttons/UI-Panel-MinimizeButton-Up"
const UNDER_TITLE: Edges = { bottom: SECTION }
public const NO_PAD: Edges = {}
const CELL_PAD: Edges = { top: 8 * PX, right: 10 * PX, bottom: 8 * PX, left: 10 * PX }
// The band ends the tooltip: no room under it.
const CELL_PAD_LAST: Edges = { top: 8 * PX, right: 10 * PX, left: 10 * PX }
public const INDENT: Edges = { left: 12 * PX }
// Where the body turns from rows into sentences or back.
const SPACED: Edges = { top: 6 * PX }

// A line as it is drawn: its texts, their colours, its size, and the room round it.
public struct Drawn {
  left: String
  right: String | nil
  leftColor: Color
  rightColor: Color
  size: TextSize
  padding: Edges
  // What its name opens, and what its value does.
  opens: Opens
  valueOpens: Opens
  // An item's stat against the compared item's, after the value.
  compared: Compared | nil
}

function opensSomething(opens: Opens): Boolean {
  match (opens) {
    Opens.None => return false,
    else => return true,
  }
}

// A text that may open something: in a locked tooltip it is underlined, the cursor on it is the question mark, and
// what it opens is drawn beside it, by whoever fills `opened`, until the cursor leaves it. Never wrapped; the
// underline and the cursor's reach are the text's own width.
public class TermText implements Component {
  public slot opened(opens: Opens)

  state over = false
  derived lit: Boolean = self.locked && self.opensSomething()
  derived open: Boolean = self.lit && self.over

  text: Signal<String>
  color: Signal<Color>
  size: Signal<TextSize>
  opens: Signal<Opens>
  locked: Signal<Boolean>
  const font: TextFont | nil
  constructor(
    text: Signal<String>,
    color: Signal<Color>,
    size: Signal<TextSize>,
    opens: Signal<Opens>,
    locked: Signal<Boolean>,
    // A value's text is in the numbers' font; nothing keeps the text's.
    font: TextFont | nil = nil,
  ) {
    self.text = text
    self.color = color
    self.size = size
    self.opens = opens
    self.locked = locked
    self.font = font
    watch { self.forgetCursor() }
  }

  opensSomething(self): Boolean { return opensSomething(self.opens) }

  // What takes the cursor goes with the lock, and says nothing as it goes.
  forgetCursor(mut self) {
    if (!self.lit) { self.over = false }
  }

  onEnter(mut self) { self.over = true }
  onLeave(mut self) { self.over = false }

  public render(self): Template {
    return $ltml {
      <box>
        <text value={self.text} textColor={self.color} textSize={self.size} wrap={false}
              textFont={self.font} />
        <box $if={self.lit} position={Position.Absolute} left={0} right={0} bottom={0} height={1 * PX}
             background={UNDERLINE} />
        <box $if={self.lit} position={Position.Absolute} left={0} top={0} right={0} bottom={0}
             cursor={Cursor.Help} @enter={self.onEnter} @leave={self.onLeave} />
        <surface $if={self.open} layer={Layer.Tooltip} place={BY_ITS_TEXT}>
          <slot #opened opens={self.opens} />
        </surface>
      </box>
    }
  }
}

// A piece of a title's line, after the « · » that joins it to the one before.
public class PartText implements Component {
  public slot opened(opens: Opens)

  derived notFirst: Boolean = self.index > 1
  derived own: Color = self.part.color ?? self.color

  part: Signal<Part>
  index: Signal<Integer>
  const color: Color
  locked: Signal<Boolean>
  constructor(
    part: Signal<Part>,
    index: Signal<Integer>,
    // The line's colour, for a piece without its own.
    color: Color,
    locked: Signal<Boolean> = false,
  ) {
    self.part = part
    self.index = index
    self.color = color
    self.locked = locked
  }

  public render(self): Template {
    return $ltml {
      // In the numbers' font: the client's own for texts has no middle dot.
      <text $if={self.notFirst} value={" · "} textColor={self.color} textSize={.Secondary} wrap={false}
            textFont={.Numbers} />
      <TermText text={self.part.text} color={self.own} size={TextSize.Secondary} opens={self.part.opens} locked={self.locked}>
        <box #opened={opens}>
          <slot #opened opens={opens} />
        </box>
      </TermText>
    }
  }
}

// A fact of the band: its glyph before its text, in the cell's middle, never wrapped. In a locked tooltip a fact
// that opens something is underlined; with the cursor on the cell, what it opens is drawn beside the cell, by
// whoever fills `opened`, and goes as the cursor leaves. The whole cell is the fact it explains.
public class FactCell implements Component {
  public slot opened(opens: Opens)

  state over = false
  derived lit: Boolean = self.locked && self.opensSomething()
  derived open: Boolean = self.lit && self.over

  derived divider: Line | nil = self.index > 1 ? DIVIDER : nil
  derived padding: Edges = self.last ? CELL_PAD_LAST : CELL_PAD
  derived glyph: Piece | nil = self.glyphOf()
  derived dot: Boolean = self.fact.glyph == .Cost
  derived color: Color = self.fact.color ?? BODY

  fact: Signal<Fact>
  index: Signal<Integer>
  last: Signal<Boolean>
  locked: Signal<Boolean>
  constructor(
    fact: Signal<Fact>,
    index: Signal<Integer>,
    last: Signal<Boolean>,
    locked: Signal<Boolean> = false,
  ) {
    self.fact = fact
    self.index = index
    self.last = last
    self.locked = locked
    watch { self.forgetCursor() }
  }

  opensSomething(self): Boolean { return opensSomething(self.fact.opens) }

  glyphOf(self): Piece | nil {
    const glyph = self.fact.glyph
    return glyph != nil ? glyphArt(glyph) : nil
  }

  // What takes the cursor goes with the lock, and says nothing as it goes.
  forgetCursor(mut self) {
    if (!self.lit) { self.over = false }
  }

  onEnter(mut self) { self.over = true }
  onLeave(mut self) { self.over = false }

  public render(self): Template {
    return $ltml {
      <box padding={self.padding} border={self.divider} xAlign={Align.Center}>
        <box columns={["auto", "auto"]} gap={5 * PX} yAlign={Align.Center}>
          // The glyph, in its tint (a cost's dot in its resource's colour): its cell reaches past its room to hold
          // its shadow.
          <box $if={self.glyph != nil} width={GLYPH} height={GLYPH}>
            <box position={Position.Absolute} left={GLYPH_IN} top={GLYPH_IN} width={GLYPH_CELL} height={GLYPH_CELL}
                 background={self.glyph} tint={self.fact.tint}>
              // The cost's dot keeps the design's light: its light and shade, untinted, over the tinted dot.
              <box $if={self.dot} position={Position.Absolute} left={0} top={0} width={GLYPH_CELL}
                   height={GLYPH_CELL} background={DOT_LIGHT} />
            </box>
          </box>
          <box>
            <text value={self.fact.text} textColor={self.color} wrap={false} />
            <box $if={self.lit} position={Position.Absolute} left={0} right={0} bottom={0} height={1 * PX}
                 background={UNDERLINE} />
          </box>
        </box>
        <box $if={self.lit} position={Position.Absolute} left={0} top={0} right={0} bottom={0}
             cursor={Cursor.Help} @enter={self.onEnter} @leave={self.onLeave} />
        <surface $if={self.open} layer={Layer.Tooltip} place={BY_ITS_TEXT}>
          <slot #opened opens={self.fact.opens} />
        </surface>
      </box>
    }
  }
}

// A line: a name with its value on the right, never wrapped, or free text that wraps at the tooltip's width. A
// name that opens something is a `TermText` of its own width, the rest of its row empty.
public class Row implements Component {
  public slot opened(opens: Opens)

  derived paired: Boolean = self.line.right != nil
  derived right: String = self.line.right ?? ""
  derived opening: Boolean = opensSomething(self.line.opens)
  derived valueOpening: Boolean = opensSomething(self.line.valueOpens)
  // A compared stat's difference: «(by ▲)» green when it is more, «(by ▼)» red when less, after the value.
  derived hasCompared: Boolean = self.line.compared != nil
  derived plainValue: Boolean = !self.hasCompared && !self.valueOpening
  derived comparedMore: Boolean = self.line.compared?.more == true
  derived comparedColor: Color = self.comparedMore ? GREEN : RED
  derived comparedMark: Art = self.comparedMore ? Ordaen.art.ctl.compareUp : Ordaen.art.ctl.compareDown
  derived comparedBy: String = `(${self.line.compared?.by ?? ""}`

  line: Signal<Drawn>
  locked: Signal<Boolean>
  constructor(line: Signal<Drawn>, locked: Signal<Boolean> = false) {
    self.line = line
    self.locked = locked
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.paired} columns={NAME_VALUE} gap={10 * PX} padding={self.line.padding}>
        <box $if={self.opening} columns={OWN_WIDTH}>
          <TermText text={self.line.left} color={self.line.leftColor} size={self.line.size} opens={self.line.opens}
                    locked={self.locked}>
            <box #opened={opens}>
              <slot #opened opens={opens} />
            </box>
          </TermText>
        </box>
        <text $else value={self.line.left} textColor={self.line.leftColor} textSize={self.line.size} />
        // A value, in the numbers' font; a compared one (an item's stat: it opens nothing) with its difference after
        // it, the mark art (no font carries it) tinted as the difference's text.
        <box $if={self.hasCompared} columns={COMPARED} gap={COMPARED_GAP} yAlign={Align.Center}>
          <text value={self.right} textColor={self.line.rightColor} textSize={self.line.size} wrap={false}
                textFont={.Numbers} />
          <text value={self.comparedBy} textColor={self.comparedColor} textSize={self.line.size} wrap={false}
                textFont={.Numbers} />
          <box width={COMPARED_MARK} height={COMPARED_MARK} background={self.comparedMark} tint={self.comparedColor} />
          <text value={")"} textColor={self.comparedColor} textSize={self.line.size} wrap={false} textFont={.Numbers} />
        </box>
        <TermText $if={self.valueOpening} text={self.right} color={self.line.rightColor} size={self.line.size}
                  opens={self.line.valueOpens} locked={self.locked} font={.Numbers}>
          <box #opened={opens}>
            <slot #opened opens={opens} />
          </box>
        </TermText>
        <text $if={self.plainValue} value={self.right} textColor={self.line.rightColor} textSize={self.line.size}
              wrap={false} textFont={.Numbers} />
      </box>
      <box $else padding={self.line.padding}>
        <box $if={self.opening} columns={OWN_WIDTH}>
          <TermText text={self.line.left} color={self.line.leftColor} size={self.line.size} opens={self.line.opens}
                    locked={self.locked}>
            <box #opened={opens}>
              <slot #opened opens={opens} />
            </box>
          </TermText>
        </box>
        <text $else value={self.line.left} textColor={self.line.leftColor} textSize={self.line.size} />
      </box>
    }
  }
}

public class TipFrame implements Component {
  derived width: Number = self.side ? SIDE_WIDTH : WIDTH
  derived hasHeader: Boolean = self.model.header != nil
  derived header: String = self.model.header ?? ""
  // The picture by the title: an icon, or a unit's face.
  derived hasIcon: Boolean = self.pictured()
  derived icon: Art | nil = self.iconArt()
  derived face: String | nil = self.faceUnit()
  derived titleColumns: Array<Track> = self.hasIcon ? WITH_ICON : ALONE
  derived hasDesc: Boolean = self.model.desc.length > 0
  derived hasInfo: Boolean = self.model.info.length > 0
  derived descColumns: Array<Track> = self.tracks(self.model.desc.length)
  derived infoColumns: Array<Track> = self.tracks(self.model.info.length)

  derived facts: Integer = self.model.facts.length
  derived hasFacts: Boolean = self.facts > 0
  derived body: Array<Drawn> = self.rows(self.model.body)
  derived more: Array<Drawn> = self.rows(self.model.more)
  derived foot: Array<Drawn> = self.notes()
  derived keys: Array<Drawn> = self.hotkeys()
  derived hasBody: Boolean = self.body.length > 0
  derived hasMore: Boolean = self.more.length > 0
  derived hasFoot: Boolean = self.foot.length > 0
  derived hasKeys: Boolean = self.keys.length > 0
  // The band ends the tooltip.
  derived bandLast: Boolean = !self.hasBody && !self.hasMore && !self.hasFoot && !self.hasKeys
  // The title alone (a sign): no room under it.
  derived titlePadding: Edges = self.hasFacts || !self.bandLast || self.hasHeader ? UNDER_TITLE : NO_PAD
  // A rule only between two present sections; none between the title and the body. The title is always there,
  // so every section after the body has one.
  derived bodyRule: Line | nil = self.hasFacts ? RULE : nil

  // The track shows once the charge starts; its room is there from the start.
  derived track: Color | nil = self.charge > 0 ? TRACK : nil
  derived filled: Size = { percent: self.charge }

  // The close button of a locked tooltip was clicked.
  public close: Event<nil> = new Event()
  // What a part of the locked tooltip opens, drawn beside the part while the cursor is on it.
  public slot opened(opens: Opens)

  model: Signal<Model>
  side: Signal<Boolean>
  locks: Signal<Boolean>
  charge: Signal<Integer>
  locked: Signal<Boolean>
  constructor(
    model: Signal<Model>,
    side: Signal<Boolean> = false,
    // The main tooltip of a group that locks: it has the lock's bar, filled this far of a hundred, and is locked or
    // not. One that never locks (a button's text) keeps no room for a bar: it is its content's height.
    locks: Signal<Boolean> = false,
    charge: Signal<Integer> = 0,
    locked: Signal<Boolean> = false,
  ) {
    self.model = model
    self.side = side
    self.locks = locks
    self.charge = charge
    self.locked = locked
  }

  onClose(mut self) { self.close.emit() }

  pictured(self): Boolean {
    let picture = self.model.picture
    match (picture) {
      Picture.None => return false,
      else => return true,
    }
  }

  iconArt(self): Art | nil {
    let picture = self.model.picture
    match (picture) {
      Picture.Icon => return picture.art,
      else => return nil,
    }
  }

  faceUnit(self): String | nil {
    let picture = self.model.picture
    match (picture) {
      Picture.Face => return picture.unit,
      else => return nil,
    }
  }

  // One column as wide as each piece and each « · » between two, and the rest of the row empty.
  tracks(self, pieces: Integer): Array<Track> {
    let list: Array<Track> = []
    for (i of 1..=pieces) {
      if (i > 1) { list.push("auto") }
      list.push("auto")
    }
    list.push({ fr: 1 })
    return list
  }

  // The body's lines as they are drawn, each the ladder's `Primary`: a row with a value and a description in the
  // body's colour, other free lines in their own; 6 px more above a line where rows turn into sentences or back.
  rows(self, lines: Array<TextLine>): Array<Drawn> {
    let list: Array<Drawn> = []
    let pairedBefore = false
    for (index, line of lines) {
      let paired = line.right != nil
      let padding = NO_PAD
      if (line.indent == true) { padding = INDENT } else if (index > 1 && paired != pairedBefore) { padding = SPACED }
      let plain = paired || line.desc == true ? BODY : FREE
      list.push({
        left: line.left, right: line.right, leftColor: line.color ?? plain,
        rightColor: line.rightColor ?? line.color ?? BODY, size: TextSize.Primary, padding: padding, opens: line.opens,
        valueOpens: Opens.None, compared: line.compared,
      })
      pairedBefore = paired
    }
    return list
  }

  notes(self): Array<Drawn> {
    let list: Array<Drawn> = []
    for (note of self.model.foot) {
      let alone = note.right == nil
      list.push({
        left: note.left, right: note.right, leftColor: alone ? note.valueColor ?? QUIET : QUIET,
        rightColor: note.valueColor ?? QUIET_VALUE, size: TextSize.Secondary, padding: NO_PAD, opens: note.opens,
        valueOpens: note.valueOpens, compared: nil,
      })
    }
    return list
  }

  hotkeys(self): Array<Drawn> {
    let list: Array<Drawn> = []
    for (key of self.model.keys) {
      list.push({
        left: key, right: nil, leftColor: QUIET, rightColor: QUIET, size: TextSize.Secondary, padding: NO_PAD,
        opens: Opens.None, valueOpens: Opens.None, compared: nil,
      })
    }
    return list
  }

  public render(self): Template {
    return $ltml {
      <box width={"min"} minWidth={self.width} padding={12 * PX} border={Ordaen.art.frame.small}
           background={Ordaen.art.window.wood}>
        <box $if={self.hasHeader} height={35 * PX} gap={6 * PX}>
          <box xAlign={Align.Center}>
            <text value={self.header} textColor={HEADING} wrap={false} />
          </box>
          <box height={2 * PX} border={GROOVE} />
        </box>
        <box columns={self.titleColumns} gap={10 * PX} yAlign={Align.Center} padding={self.titlePadding}>
          <box $if={self.hasIcon} width={ICON} height={ICON} border={RIM} padding={1 * PX} background={BLACK}
               rows={FILL}>
            <box icon={self.icon} portrait={self.face} />
          </box>
          <box gap={2 * PX} yAlign={Align.Center}>
            <text value={self.model.name} textColor={self.model.nameColor} textSize={.Title} wrap={false}
                  textFont={.Title} />
            <box $if={self.hasDesc} columns={self.descColumns} height={18 * PX} yAlign={Align.Center}>
              <PartText $for={index, part of self.model.desc} part={part} index={index} color={LABEL}
                        locked={self.locked}>
                <box #opened={opens}>
                  <slot #opened opens={opens} />
                </box>
              </PartText>
            </box>
            <box $if={self.hasInfo} columns={self.infoColumns} height={18 * PX} yAlign={Align.Center}>
              <PartText $for={index, part of self.model.info} part={part} index={index} color={QUIET}
                        locked={self.locked}>
                <box #opened={opens}>
                  <slot #opened opens={opens} />
                </box>
              </PartText>
            </box>
          </box>
        </box>
        <box $if={self.hasFacts} columns={self.facts} border={RULE}>
          <FactCell $for={index, fact of self.model.facts} fact={fact} index={index} last={self.bandLast}
                    locked={self.locked}>
            <box #opened={opens}>
              <slot #opened opens={opens} />
            </box>
          </FactCell>
        </box>
        <box $if={self.hasBody} gap={2 * PX} padding={SECTION_PAD} border={self.bodyRule}>
          <Row $for={line of self.body} line={line} locked={self.locked}>
            <box #opened={opens}>
              <slot #opened opens={opens} />
            </box>
          </Row>
        </box>
        <box $if={self.hasMore} gap={2 * PX} padding={SECTION_PAD} border={RULE}>
          <Row $for={line of self.more} line={line} locked={self.locked}>
            <box #opened={opens}>
              <slot #opened opens={opens} />
            </box>
          </Row>
        </box>
        <box $if={self.hasFoot} gap={2 * PX} padding={SECTION_PAD} border={RULE}>
          <Row $for={line of self.foot} line={line} locked={self.locked}>
            <box #opened={opens}>
              <slot #opened opens={opens} />
            </box>
          </Row>
        </box>
        // What other modules add, after the footer: the main tooltip's owner fills it.
        <slot />
        <box $if={self.hasKeys} gap={2 * PX} padding={SECTION_PAD} border={RULE}>
          <Row $for={line of self.keys} line={line} locked={self.locked}>
            <box #opened={opens}>
              <slot #opened opens={opens} />
            </box>
          </Row>
        </box>
        <box $if={self.locks} padding={BAR_PAD}>
          <box height={BAR_ROW} yAlign={Align.Center}>
            <text $if={self.locked} value={Locale.LOCKED_HINT} textColor={QUIET} textSize={.Secondary} wrap={false} />
            <box $else height={BAR_HEIGHT} background={self.track}>
              <box position={Position.Absolute} left={0} top={0} bottom={0} width={self.filled}
                   background={BAR_GOLD} />
            </box>
          </box>
        </box>
        <box $if={self.locked} position={Position.Absolute} right={2 * PX} top={2 * PX} width={24 * PX}
             height={24 * PX} background={CLOSE_ART} @click={self.onClose} />
      </box>
    }
  }
}
