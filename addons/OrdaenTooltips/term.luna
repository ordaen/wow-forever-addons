// A term of the glossary as a tooltip: its name in gold, its text under it. A «%s» in either is the amount the
// part that named the term speaks of.
import { GOLD } from "@/colors"
import { Kind, Model } from "@/model"
import { Term, glossary } from "@/terms"

function with(text: String, amount: String): String {
  return text.contains("%s") ? text.format(amount) : text
}

public function term(which: Term, amount: String | nil): Model {
  let entry = glossary(which)
  let spoken = amount ?? ""
  return {
    kind: Kind.Term, name: with(entry.name, spoken), nameColor: GOLD,
    desc: [], info: [], facts: [], body: [{ left: with(entry.text, spoken) }], more: [], foot: [], keys: [],
  }
}
