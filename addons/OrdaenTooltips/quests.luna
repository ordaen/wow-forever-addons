// The quest lines of a unit's or an object's tooltip, as a section of their own under the body: first the quests a
// creature gives or takes back, each with the game's mark of it and its level in its colour; then each quest it is
// part of, its name in gold, each objective a row with the player's counter, green once done, and the party's under
// it, set in. A quest's title stands apart from the quest before it, its objectives close under it.
import Game from "$game"
import { questLevelColor } from "Ordaen"
import { GOLD, GREEN } from "@/colors"
import { Offered, Wanted } from "@/extend"
import { TextLine, named } from "@/model"
import { Term } from "@/terms"
import { clean } from "@/text"

// The game's numbers for a quest's lines: its title, an objective, and the party member whose objectives follow.
public const QUEST_TITLE = 17
public const QUEST_OBJECTIVE = 8
public const QUEST_PLAYER = 18

// The game's marks of a quest to take and of one to hand in.
const TO_TAKE: Asset = "Interface/GossipFrame/AvailableQuestIcon"
const TO_HAND_IN: Asset = "Interface/GossipFrame/ActiveQuestIcon"

// One quest's rows as the game says them: its title ("" for objectives under none), the player's objectives, then
// the party's.
struct Block {
  mut title: string
  mut own: array<TextLine>
  mut party: array<TextLine>
}

// An objective's text without its count, wherever the client puts it («Wolf slain: 2/5», «2/5 Wolf slain», «- Wolf
// slain: 2/5»).
public function labelOf(text: string): string {
  return text.replace("^%s*%-%s*", "").replace("^%d+%s*/%s*%d+%s*", "").replace("%s*:?%s*%d+%s*/%s*%d+%s*$", "")
}

// A row of the game's objective: its text without its count, the count at the right, green once done.
function objectiveRow(text: string, label: string, done: boolean, indent: boolean): TextLine {
  let (have, need) = text.match("(%d+)%s*/%s*(%d+)")
  let counted = have != nil && need != nil && (have.toNumber() ?? 0) >= (need.toNumber() ?? 0)
  let value = have != nil && need != nil ? have + "/" + need : nil
  return {
    left: label, right: value, rightColor: done || counted ? GREEN : nil, indent: indent, opens: named(Term::Quest)
  }
}

// The game's quest rows as blocks, in its order. `party`: the party's objectives are kept too.
function blocksOf(lines: array<Game::TooltipLine>, party: boolean): array<Block> {
  const blocks: array<Block> = mut []
  let started = false
  let title = ""
  let own: array<TextLine> = mut []
  let theirs: array<TextLine> = mut []
  let member: string | nil = nil
  for (line of lines) {
    let text = clean(line.left)
    if (text == nil) { continue }
    if (line.kind == QUEST_TITLE) {
      if (started) { blocks.push({ title: title, own: own, party: theirs }) }
      started = true
      title = text
      own = mut []
      theirs = mut []
      member = nil
    } else if (line.kind == QUEST_PLAYER) {
      member = text
    } else if (line.kind == QUEST_OBJECTIVE) {
      started = true
      if (member == nil) {
        own.push(objectiveRow(text, labelOf(text), line.completed == true, false))
      } else if (party) {
        theirs.push(objectiveRow(text, member, line.completed == true, true))
      }
    }
  }
  if (started) { blocks.push({ title: title, own: own, party: theirs }) }
  return blocks
}

// The place of the game's block of a quest's title; nil where the game names no such quest.
function blockOf(blocks: array<Block>, title: string): integer | nil {
  for (at, block of blocks) {
    if (block.title == title) { return at }
  }
  return nil
}

// An objective another module adds, as the game's own are drawn.
function wantedRow(want: Wanted): TextLine {
  return {
    left: want.objective, right: `${want.have}/${want.need}`, rightColor: want.done ? GREEN : nil,
    opens: named(Term::Quest)
  }
}

// A quest a creature gives or takes: the game's mark, then «[level] title» in the level's colour.
function offeredRow(offer: Offered): TextLine {
  return {
    left: `[${offer.level}] ${offer.title}`, color: questLevelColor(offer.level, Game::player.level, GOLD),
    icon: offer.turnIn ? TO_HAND_IN : TO_TAKE
  }
}

// The section: the quests offered, then the game's quest rows with the objectives other modules add. A want joins
// the game's block of its quest's title, unless that block already has its objective; else its quest's own block,
// after the game's.
public function questRows(
  lines: array<Game::TooltipLine>, party: boolean, wants: array<Wanted>, offers: array<Offered>
): mut array<TextLine> {
  const blocks = blocksOf(lines, party)
  // The rows added to each of the game's blocks, by its place; and the quests the game names none of, in order.
  const added: map<integer, mut array<TextLine>> = mut {}
  const ownRows: map<integer, mut array<TextLine>> = mut {}
  const ownQuests: array<Wanted> = mut []
  for (want of wants) {
    const at = blockOf(blocks, want.title)
    if (at != nil) {
      if ((blocks[at] ?? panic("a block")).own.any(row => row.left == want.objective)) { continue }
      const list = added[at]
      if (list == nil) { added[at] = mut [wantedRow(want)] } else { list.push(wantedRow(want)) }
    } else {
      const list = ownRows[want.quest]
      if (list == nil) {
        ownRows[want.quest] = mut [wantedRow(want)]
        ownQuests.push(want)
      } else {
        list.push(wantedRow(want))
      }
    }
  }
  const rows: array<TextLine> = offers.map(offer => offeredRow(offer))
  for (at, block of blocks) {
    if (block.title != "") { rows.push({ left: block.title, color: GOLD, heads: true }) }
    for (row of block.own) { rows.push(row) }
    for (row of added[at] ?? []) { rows.push(row) }
    for (row of block.party) { rows.push(row) }
  }
  for (want of ownQuests) {
    rows.push({ left: want.title, color: GOLD, heads: true })
    for (row of ownRows[want.quest] ?? []) { rows.push(row) }
  }
  return rows
}

// The game's quest rows alone (an object's tooltip). `party`: the party's objectives are shown too.
public function quests(lines: array<Game::TooltipLine>, party: boolean): mut array<TextLine> {
  return questRows(lines, party, [], [])
}
