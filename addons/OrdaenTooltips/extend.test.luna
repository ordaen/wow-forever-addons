// What another module adds to Ordaen Tooltips' sections, made up by the test: a price row that follows its own
// cell, a row of a world object's, each in its section after the main tooltip's footer, and gone with its handle.
import Client from "$client"
import Game from "$game"
import { Frame } from "$ltml"
import Test from "$test"
import { ItemKeys, ItemLines, Line, ObjectLines } from "@/extend"
import Runtime from "$runtime"
import root Tooltips from "OrdaenTooltips"

// A price another module keeps: its row is asked again when the price moves, and only then.
class Priced implements ItemLines {
  public state copper = 1200

  public lines(self, item: Integer, link: String): Array<Line> {
    const copper = self.copper
    return [{ left: "Auction", right: `${copper / 100}g · ${item} · ${link}` }]
  }

  public raise(mut self) { self.copper += 300 }
}

// What a vein gives, by its name.
class Mined implements ObjectLines {
  public lines(self, name: String): Array<Line> {
    if (name != "Copper Vein") { return [] }
    return [{ left: "Copper Ore", right: "2–4" }, { left: "Rough Stone", indent: true }]
  }
}

function frame(name: String, x: Number, y: Number): any Frame {
  let made = Client.CreateFrame("Frame", name, Client.C_UI.GetUIParent(), nil)
  made.SetSize(200, 80)
  made.SetPoint("TOPLEFT", Client.C_UI.GetUIParent(), "TOPLEFT", x, -y)
  return made
}

function showing(corner: any Frame, data: Game.TooltipData): Game.ShownTip {
  return {
    shown: true, data: data, placeable: false, ownerHigh: false, ownerRight: false, corner: corner, below: false,
    right: true,
  }
}

test "a row another module adds stands in its section, follows what it read, and goes with its handle" {
  let corner = frame("GameTooltip", 1300, 720)
  // The module's root, made as its addon loaded and drawn by Ordaen on the screen, which this page is.
  Test.mount(nil, { left: 100, top: 50, width: 700, height: 600, screen: true })
  const priced = new Priced()
  const added = Tooltips.worth.add(priced)
  const mined = Tooltips.gives.add(new Mined())

  Game.tooltip.main = showing(corner, { kind: 0, id: 2770, about: "item:2770", lines: [{ left: "Copper Ore", kind: 22 }] })
  Test.shot("an item: the row of another module after the body")

  priced.raise()
  Test.pass(0.02)
  Test.shot("its price moved: its row drawn again")

  Game.tooltip.main = showing(corner, { kind: 4, lines: [{ left: "Copper Vein", kind: 0 }] })
  Test.shot("a world object: its section's rows, the item's gone")

  destroy mined
  Test.pass(0.02)
  Test.shot("the object's entry ended: its rows gone")

  Game.tooltip.main = showing(corner, { kind: 0, id: 2770, about: "item:2770", lines: [{ left: "Copper Ore", kind: 22 }] })
  destroy added
  Test.pass(0.02)
  Test.shot("the item's entry ended: the tooltip as Tooltips draws it alone")

  Game.tooltip.main = { shown: false, ..showing(corner, { lines: [] }) }
  Test.pass(0.2)
  (Runtime.Addon.of(Tooltips) ?? panic("the tooltips are installed")).disable()
  Test.expect(Test.blank())
}

// A hotkey another module has for an item where it shows it: asked again when what it read moves.
class Keyed implements ItemKeys {
  public state held = false

  public keys(self, item: Integer, link: String): Array<String> {
    return [self.held ? `Alt+Left-click: let ${item} go` : `Alt+Left-click: hold ${item}`]
  }

  public hold(mut self) { self.held = true }
}

test "a hotkey another module adds stands after the tooltip's own, follows what it read, and goes with its handle" {
  let corner = frame("GameTooltip", 1300, 720)
  Test.mount(nil, { left: 100, top: 50, width: 700, height: 600, screen: true })
  const keyed = new Keyed()
  const added = Tooltips.keys.add(keyed)
  Game.tooltip.main = showing(corner, { kind: 0, id: 2770, about: "item:2770", lines: [{ left: "Copper Ore", kind: 22 }] })
  Test.expect(Tooltips.model.keys.length == 1 && Tooltips.model.keys[1] == "Alt+Left-click: hold 2770")
  Test.shot("an item: the module's hotkey in the hotkeys")
  keyed.hold()
  Test.pass(0.02)
  Test.expect(Tooltips.model.keys[1] == "Alt+Left-click: let 2770 go")
  // A world object is no item: no hotkey of the item's.
  Game.tooltip.main = showing(corner, { kind: 4, lines: [{ left: "Copper Vein", kind: 0 }] })
  Test.pass(0.02)
  Test.expect(Tooltips.model.keys.length == 0)
  Game.tooltip.main = showing(corner, { kind: 0, id: 2770, about: "item:2770", lines: [{ left: "Copper Ore", kind: 22 }] })
  destroy added
  Test.pass(0.02)
  Test.expect(Tooltips.model.keys.length == 0)
  Game.tooltip.main = { shown: false, ..showing(corner, { lines: [] }) }
  Test.pass(0.2)
}

test "what another module adds comes after the tooltip's own footer" {
  let corner = frame("GameTooltip", 1300, 720)
  Test.mount(nil, { left: 100, top: 50, width: 700, height: 600, screen: true })
  Game.items.owned = (id: Integer): Integer => 4
  const added = Tooltips.worth.add(new Priced())
  Game.tooltip.main = showing(corner, { kind: 0, id: 2770, about: "item:2770", lines: [{ left: "Copper Ore", kind: 22 }] })
  Test.shot("an item held in the bank: the footer's «In the bank», then the added row")
  destroy added
  Game.tooltip.main = { shown: false, ..showing(corner, { lines: [] }) }
  Test.pass(0.2)
}
