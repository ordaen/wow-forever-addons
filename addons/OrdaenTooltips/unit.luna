// A unit's tooltip. A player: the title and the name, the guild and the rank, the class, whether they are away or
// dead, the level, the race and the faction, their target and what they are to the player. An NPC: the name in its
// reaction's colour, its role and what kind of creature it is, the level against the player's, elite or rare, its
// faction, the quests it is part of, whose loot it is and the player's standing with its faction.
import Game from "$game"
import { GOLD, GREEN, GREY, LABEL, RED, WHITE, YELLOW, colorOf, hex } from "@/colors"
import Locale from "@/locales"
import { Fact, Glyph, Kind, Model, Note, Opens, Part, Picture, TextLine, named, side } from "@/model"
import { Term } from "@/terms"
import { Options } from "@/options"
import { QUEST_OBJECTIVE, QUEST_PLAYER, QUEST_TITLE, quests } from "@/quests"
import { clean } from "@/text"

// The game's numbers for what a line of a tooltip is.
const BLANK = 1
const UNIT_NAME = 2
const UNIT_OWNER = 16

const ORANGE: Color = Color.hex("#ff8040")
const FRIENDLY: Color = Color.hex("#40bf40")

// A standing's colour: hated to hostile red, unfriendly orange, neutral yellow, friendly and up green.
function standingColor(rank: Integer): Color {
  if (rank <= 2) { return RED }
  if (rank == 3) { return ORANGE }
  if (rank == 4) { return YELLOW }
  return FRIENDLY
}

// A player's name with their title: the title quieter, the name in its colour, in the order the game puts them.
function titledName(name: String, titled: String | nil, color: Color): String {
  if (titled == nil || titled == name) { return name }
  let around = titled.split(name)
  let before = around[1]
  if (around.length < 2 || before == nil) { return titled }
  let after = titled.sub(before.length + name.length + 1)
  return `|c${hex(LABEL)}${before}|r|c${hex(color)}${name}|r|c${hex(LABEL)}${after}|r`
}

function player(token: String, who: Game.UnitInfo, options: Options): Model | nil {
  let name = who.name
  if (name == nil) { return nil }
  let color = (options.classNames ? who.classColor : nil) ?? WHITE
  let desc: Array<Part> = []
  let info: Array<Part> = []
  let facts: Array<Fact> = []
  let foot: Array<Note> = []
  let guild = who.guild
  if (guild != nil) {
    desc.push({ text: guild, opens: named(Term.Guild) })
    let rank = who.guildRank
    if (rank != nil) { desc.push({ text: rank, opens: named(Term.Rank) }) }
  }
  let className = who.className
  if (className != nil) { info.push({ text: className, opens: named(Term.Pclass) }) }
  if (who.dead || who.ghost) {
    info.push({ text: who.ghost ? Locale.GHOST : Locale.CORPSE, opens: named(Term.Status) })
  } else if (who.afk) {
    info.push({ text: Locale.AFK, opens: named(Term.Status) })
  } else if (who.dnd) {
    info.push({ text: Locale.DND, opens: named(Term.Status) })
  }
  if (who.pvp) { info.push({ text: "PvP", opens: named(Term.Pvp) }) }

  facts.push({
    text: who.level > 0 ? Locale.LEVEL_CELL.format(who.level) : "??", opens: named(Term.Plvl),
  })
  let race = who.race
  if (race != nil) { facts.push({ text: race }) }
  let faction = who.faction
  if (faction != nil) {
    facts.push({
      text: who.factionName ?? faction, color: who.sameFaction ? GREEN : RED,
      glyph: faction == "Alliance" ? Glyph.Alliance : (faction == "Horde" ? Glyph.Horde : nil),
      opens: side(faction),
    })
  }

  let target = who.target
  if (options.playersTarget && target != nil) {
    foot.push({
      left: Locale.TARGET, right: target.name, valueColor: target.color, opens: named(Term.Ptarget),
      valueOpens: Opens.Unit { unit: token + "target" },
    })
  }
  if (options.playersRelation) {
    let group = who.raidGroup
    if (group != nil) {
      foot.push({
        left: Locale.RAID, right: Locale.RAID_GROUP.format(group), opens: named(Term.Relation),
      })
    } else if (who.inParty) {
      foot.push({ left: Locale.PARTY, right: Locale.PARTY_YOURS, opens: named(Term.Relation) })
    }
    if (who.friend) {
      foot.push({ left: Locale.FRIEND, right: who.friendNote ?? "", opens: named(Term.Relation) })
    }
    if (who.ignored) {
      foot.push({ left: Locale.IGNORED, right: Locale.IGNORED_YES, valueColor: RED, opens: named(Term.Relation) })
    }
  }
  return {
    kind: Kind.Unit, name: titledName(name, who.titled, color), nameColor: color,
    desc: desc, info: info, facts: facts, body: [], more: [], foot: foot, keys: [],
  }
}

function npc(who: Game.UnitInfo, name: String, data: Game.TooltipData, options: Options): Model {
  let nameColor = WHITE
  let reaction = who.reactionColor
  if (options.npcsLoot && who.tapped) {
    nameColor = GREY
  } else if (reaction != nil) {
    nameColor = reaction
  }
  let level = who.level
  let creature = who.creatureType
  let factionName: String | nil = nil
  let desc: Array<Part> = []
  let info: Array<Part> = []
  let facts: Array<Fact> = []
  let body: Array<TextLine> = []
  let foot: Array<Note> = []
  for (i, line of data.lines) {
    if (i == 1) { continue }
    let text = clean(line.left)
    if (text == nil || line.kind == BLANK) { continue }
    // Quest lines are rows of their own.
    if (line.kind == QUEST_TITLE || line.kind == QUEST_OBJECTIVE || line.kind == QUEST_PLAYER) { continue }
    // «PvP» and the level's line go: the band has the level.
    if (text == Game.strings.pvp) { continue }
    let numbered = text.match("%d") != nil
    if (i <= 3 && level > 0 && numbered && text.contains(String.of(level))) { continue }
    let role = text.match("^<(.+)>$")
    if (role != nil) {
      desc.push({ text: role })
    } else if (line.kind == UNIT_OWNER) {
      // A pet's owner.
      desc.push({ text: text })
    } else if (i <= 4 && factionName == nil && who.faction != nil) {
      factionName = text
    } else if (i <= 4 && desc.length == 0 && !numbered && text != creature) {
      desc.push({ text: text })
    } else if (text != creature) {
      body.push({ left: text, color: colorOf(line.leftColor) })
    }
  }
  if (creature != nil) { info.push({ text: creature, opens: named(Term.Beast) }) }
  if (who.dead) { info.push({ text: Locale.CORPSE, opens: named(Term.Npcdead) }) }

  // The level in its colour against the player's; «??» far above.
  if (level > 0) {
    facts.push({ text: Locale.LEVEL_CELL.format(level), color: who.levelColor, opens: named(Term.Lvlcolor) })
  } else {
    facts.push({ text: "??", color: RED, opens: named(Term.Lvlcolor) })
  }
  let rank = who.classification
  if (rank == "elite" || rank == "worldboss" || rank == "rareelite") {
    facts.push({ text: Locale.ELITE, color: GOLD, glyph: .Elite, opens: named(Term.Elite) })
  }
  if (rank == "rare" || rank == "rareelite") { facts.push({ text: Locale.RARE, opens: named(Term.Rare) }) }
  let faction = who.faction
  if (faction != nil) {
    facts.push({ text: factionName ?? faction, color: who.sameFaction ? GREEN : RED, opens: side(faction) })
  }

  // The footer: someone else's loot, and the player's standing with its faction, where they have met it.
  if (options.npcsLoot && who.tapped) { foot.push({ left: Locale.TAPPED, right: "", opens: named(Term.Tapped) }) }
  if (options.npcsRep && factionName != nil) {
    let standing = Game.reputation.with(factionName)
    if (standing != nil) {
      foot.push({ left: factionName, right: standing.label, valueColor: standingColor(standing.rank) })
    }
  }
  return {
    kind: Kind.Unit, name: name, nameColor: nameColor, desc: desc, info: info, facts: facts, body: body,
    more: quests(data.lines, options.npcsParty), foot: foot, keys: [],
  }
}

public function unit(data: Game.TooltipData, options: Options): Model | nil {
  let first = data.lines[1]
  if (first == nil) { return nil }
  let name = clean(first.left)
  let token = first.kind == UNIT_NAME ? first.unit : nil
  let who = token != nil ? Game.units.of(token) : nil
  if (token == nil || who == nil) {
    // A unit gone: what the game wrote.
    if (name == nil) { return nil }
    let body: Array<TextLine> = []
    for (i, line of data.lines) {
      if (i == 1) { continue }
      let text = clean(line.left)
      if (text != nil) { body.push({ left: text, color: colorOf(line.leftColor) }) }
    }
    return {
      kind: Kind.Unit, name: name, nameColor: WHITE,
      desc: [], info: [], facts: [], body: body, more: [], foot: [], keys: [],
    }
  }
  if (who.player) {
    let read = player(token, who, options)
    return read != nil ? { picture: Picture.Face { unit: token }, ..read } : nil
  }
  if (name == nil) { return nil }
  return { picture: Picture.Face { unit: token }, ..npc(who, name, data, options) }
}

// A unit's tooltip by the game's name for it, as a part of another tooltip opens it: a player's whole; an NPC's
// without the lines only the game's tooltip of it has (its role, its quests). Nothing once the unit is gone.
public function unitOf(token: String, options: Options): Model | nil {
  let who = Game.units.of(token)
  if (who == nil) { return nil }
  if (who.player) {
    let read = player(token, who, options)
    return read != nil ? { picture: Picture.Face { unit: token }, ..read } : nil
  }
  let name = who.name
  if (name == nil) { return nil }
  return { picture: Picture.Face { unit: token }, ..npc(who, name, { lines: [] }, options) }
}
