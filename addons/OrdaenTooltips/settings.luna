// The tooltips' tabs in the settings window: one for what holds for every tooltip, one for each kind. A kind's
// switch comes first; off, that kind stays the game's and its rows are greyed. Each control writes one entry of the
// settings, at once.
import { Checkbox, Choice, Component, Dropdown, Section, Settings, Switch } from "Ordaen"
import { Choices, Delay, KindDelay, KindPlace, Place } from "@/choices"
import Locale from "@/locales"

const PLACES: Array<Choice<Place>> = [
  { value: Place.Anchor, label: Locale.TOOLTIPS_PLACE_ANCHOR },
  { value: Place.Blizzard, label: Locale.TOOLTIPS_PLACE_BLIZZARD }
]
const DELAYS: Array<Choice<Delay>> = [
  { value: Delay.Instant, label: Locale.TOOLTIPS_DELAY_INSTANT },
  { value: Delay.Short, label: Locale.TOOLTIPS_DELAY_SHORT },
  { value: Delay.Medium, label: Locale.TOOLTIPS_DELAY_MEDIUM },
  { value: Delay.Long, label: Locale.TOOLTIPS_DELAY_LONG }
]
const KINDDELAYS: Array<Choice<KindDelay>> = [
  { value: KindDelay.Default, label: Locale.TOOLTIPS_DELAY_DEFAULT },
  { value: KindDelay.Instant, label: Locale.TOOLTIPS_DELAY_INSTANT },
  { value: KindDelay.Short, label: Locale.TOOLTIPS_DELAY_SHORT },
  { value: KindDelay.Medium, label: Locale.TOOLTIPS_DELAY_MEDIUM },
  { value: KindDelay.Long, label: Locale.TOOLTIPS_DELAY_LONG }
]
const KINDPLACES: Array<Choice<KindPlace>> = [
  { value: KindPlace.Default, label: Locale.TOOLTIPS_PLACE_DEFAULT },
  { value: KindPlace.Anchor, label: Locale.TOOLTIPS_PLACE_ANCHOR },
  { value: KindPlace.Blizzard, label: Locale.TOOLTIPS_PLACE_BLIZZARD }
]

public class GeneralPage implements Component {
  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Dropdown label={Locale.TOOLTIPS_PLACE} hint={Locale.TOOLTIPS_PLACE_TIP} value={mut self.settings.values.place}
                choices={PLACES} />
      <Dropdown label={Locale.TOOLTIPS_DELAY} hint={Locale.TOOLTIPS_DELAY_TIP} value={mut self.settings.values.delay}
                choices={DELAYS} />
    }
  }
}

public class ItemsPage implements Component {
  derived off: Boolean = !self.settings.values.itemsOn

  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Switch label={Locale.TOOLTIPS_ITEMSON} hint={Locale.TOOLTIPS_ITEMSON_TIP}
              value={mut self.settings.values.itemsOn} />
      <Checkbox label={Locale.TOOLTIPS_LOCK} hint={Locale.TOOLTIPS_LOCK_TIP}
                value={mut self.settings.values.itemsLock} disabled={self.off} />
      <Dropdown label={Locale.TOOLTIPS_PLACE} hint={Locale.TOOLTIPS_KINDPLACE_TIP} value={mut self.settings.values.itemsPlace}
                choices={KINDPLACES} disabled={self.off} />
      <Dropdown label={Locale.TOOLTIPS_DELAY} hint={Locale.TOOLTIPS_KINDDELAY_TIP} value={mut self.settings.values.itemsDelay}
                choices={KINDDELAYS} disabled={self.off} />
      <Section title={Locale.SECTION_MORE}>
        <Checkbox label={Locale.TOOLTIPS_ITEMSILVL} hint={Locale.TOOLTIPS_ITEMSILVL_TIP}
                  value={mut self.settings.values.itemsIlvl} disabled={self.off} />
        <Checkbox label={Locale.TOOLTIPS_ITEMSID} hint={Locale.TOOLTIPS_ITEMSID_TIP}
                  value={mut self.settings.values.itemsId} disabled={self.off} />
        <Checkbox label={Locale.TOOLTIPS_ITEMSCOUNT} hint={Locale.TOOLTIPS_ITEMSCOUNT_TIP}
                  value={mut self.settings.values.itemsCount} disabled={self.off} />
        <Checkbox label={Locale.TOOLTIPS_ITEMSSTACK} hint={Locale.TOOLTIPS_ITEMSSTACK_TIP}
                  value={mut self.settings.values.itemsStack} disabled={self.off} />
        <Checkbox label={Locale.TOOLTIPS_ITEMSCOOLDOWN} hint={Locale.TOOLTIPS_ITEMSCOOLDOWN_TIP}
                  value={mut self.settings.values.itemsCooldown} disabled={self.off} />
      </Section>
    }
  }
}

