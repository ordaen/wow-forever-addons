// The tooltips' tabs in the settings window: one for what holds for every tooltip, one for each kind. A kind's
// switch comes first; off, that kind stays the game's and its rows are greyed. Each control writes one entry of the
// settings' draft.
import { Checkbox, Choice, Component, Dropdown, Section, Settings, Switch } from "Ordaen"
import Locale from "@/locales"
import { Choices, Place } from "@/choices"

const ITEMSANCHORBAGS: Array<Choice<Place>> = [
  { value: Place.Corner, label: Locale.TOOLTIPS_ITEMSANCHORBAGS_CORNER },
  { value: Place.Anchor, label: Locale.TOOLTIPS_ITEMSANCHORBAGS_ANCHOR },
]
const ITEMSANCHORCHAR: Array<Choice<Place>> = [
  { value: Place.Corner, label: Locale.TOOLTIPS_ITEMSANCHORCHAR_CORNER },
  { value: Place.Anchor, label: Locale.TOOLTIPS_ITEMSANCHORCHAR_ANCHOR },
]

public class GeneralPage implements Component {
  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Checkbox label={Locale.TOOLTIPS_ANCHORTOBUTTONS} hint={Locale.TOOLTIPS_ANCHORTOBUTTONS_TIP}
                value={mut self.settings.draft.anchorToButtons} />
    }
  }
}

public class ItemsPage implements Component {
  derived off: Boolean = !self.settings.draft.itemsOn

  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Switch label={Locale.TOOLTIPS_ITEMSON} hint={Locale.TOOLTIPS_ITEMSON_TIP}
              value={mut self.settings.draft.itemsOn} />
      <Checkbox label={Locale.TOOLTIPS_LOCK} hint={Locale.TOOLTIPS_LOCK_TIP}
                value={mut self.settings.draft.itemsLock} disabled={self.off} />
      <Dropdown label={Locale.TOOLTIPS_ITEMSANCHORBAGS} hint={Locale.TOOLTIPS_ITEMSANCHORBAGS_TIP} value={mut self.settings.draft.itemsAnchorBags}
                choices={ITEMSANCHORBAGS} disabled={self.off} />
      <Dropdown label={Locale.TOOLTIPS_ITEMSANCHORCHAR} hint={Locale.TOOLTIPS_ITEMSANCHORCHAR_TIP} value={mut self.settings.draft.itemsAnchorChar}
                choices={ITEMSANCHORCHAR} disabled={self.off} />
      <Section title={Locale.SECTION_MORE}>
        <Checkbox label={Locale.TOOLTIPS_ITEMSILVL} hint={Locale.TOOLTIPS_ITEMSILVL_TIP}
                  value={mut self.settings.draft.itemsIlvl} disabled={self.off} />
        <Checkbox label={Locale.TOOLTIPS_ITEMSID} hint={Locale.TOOLTIPS_ITEMSID_TIP}
                  value={mut self.settings.draft.itemsId} disabled={self.off} />
        <Checkbox label={Locale.TOOLTIPS_ITEMSCOUNT} hint={Locale.TOOLTIPS_ITEMSCOUNT_TIP}
                  value={mut self.settings.draft.itemsCount} disabled={self.off} />
        <Checkbox label={Locale.TOOLTIPS_ITEMSSTACK} hint={Locale.TOOLTIPS_ITEMSSTACK_TIP}
                  value={mut self.settings.draft.itemsStack} disabled={self.off} />
        <Checkbox label={Locale.TOOLTIPS_ITEMSCOOLDOWN} hint={Locale.TOOLTIPS_ITEMSCOOLDOWN_TIP}
                  value={mut self.settings.draft.itemsCooldown} disabled={self.off} />
      </Section>
    }
  }
}

