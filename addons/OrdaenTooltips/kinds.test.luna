  Test::pass(SHOWS)
  Test::expect(reads(tip("Ogre"), "Ogre | Tunnel Rat | Level 60"))
  Game::tooltip.main = showing(npcTip(["Level 60", "", "", "Tunnel Rat"]))
  Test::pass(SHOWS)
  Test::expect(reads(tip("Ogre"), "Ogre | Level 60 | Tunnel Rat"))
}

