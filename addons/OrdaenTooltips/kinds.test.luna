// The edges of what the reader reads

const QUIET: color = #857a66
const FREE: color = #e6dcc6

test "a hotkey and a footer's label are quiet, a value of the footer quieter than the body" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ plain: true, lines: [{ left: "Bags |cffffd200(B)|r", kind: 0 }] })
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Bags").text("B: open"), QUIET))
  Game::tooltip.main = showing({
    kind: 0, id: 1,
    lines: [
      { left: "Mace", kind: NAME_OF_ITEM }, { left: "Requires Level 5", kind: REQUIRES },
      { left: "Requires Honored", kind: REQUIRES }
    ]
  })
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Mace").text("Requires level"), QUIET))
  Test::expect(inColor(tip("Mace").text("5"), QUIET_VALUE))
  // A requirement of no form the game names: the line alone, as a label.
  Test::expect(inColor(tip("Mace").text("Requires Honored"), QUIET))
}

