// Talents

test "a talent reads its tree and its rank, and the next rank with what changes in it lit" {
  Game::spells.name = (id: integer): string | nil => id == 11069 ? "Improved Fireball" : nil
  Game::spells.texture = (id: integer): Art | nil => "Interface/Icons/Spell_Fire_FlameBolt"
  Game::talents.shown = (data: Game::TooltipData): Game::TalentInfo | nil => ({
    spell: 11069, rank: 2, ranks: 5, current: "Reduces the cast time of Fireball by |cffffffff0.2|r sec.",
    next: "Reduces  the cast time of Fireball by |cffffffff0.3|r sec.", conditions: [], locked: false
  })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 1, id: 11069,
    lines: [{ left: "Passive", kind: 33 }, { left: "Reduces the cast time of Fireball by 0.2 sec.", kind: DESCRIBED }]
  })
  Test::pass(SHOWS)
  const talent = tip("Improved Fireball")
  Test::expect(reads(talent, "Improved Fireball | Talent | · | 2/5 | · | Fire | Reduces the cast time of Fireball by |cffffd1000.2 sec.|r | Next rank: | Reduces the cast time of Fireball by |cff40ff600.3|r sec."))
  Test::expect(talent.paintedWith("Interface/Icons/Spell_Fire_FlameBolt"))
  Test::expect(inColor(talent.text("2/5"), #cbb994))
}

test "a talent's next rank whose first word changes starts with that word lit, nothing before it" {
  Game::spells.name = (id: integer): string | nil => "Improved Fireball"
  Game::talents.shown = (data: Game::TooltipData): Game::TalentInfo | nil => ({
    spell: 11069, rank: 1, ranks: 5, current: "2 sec. off Fireball's cast.", next: "3 sec. off Fireball's cast.",
    conditions: [], locked: false
  })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 1, id: 11069, lines: [{ left: "2 sec. off Fireball's cast.", kind: DESCRIBED }] })
  Test::pass(SHOWS)
  const texts = tip("Improved Fireball").texts()
  Test::expect(texts.any(text => text == "|cff40ff603|r sec. off Fireball's cast.") || throw Error { message: texts.join(" | ") })
}

test "a talent at its last rank shows its rank in green and no next rank" {
  Game::spells.name = (id: integer): string | nil => "Improved Fireball"
  Game::talents.shown = (data: Game::TooltipData): Game::TalentInfo | nil => ({
    spell: 11069, rank: 5, ranks: 5, current: "Reduces it by 0.5 sec.", next: "Reduces it by 0.6 sec.",
    conditions: [], locked: false
  })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 1, id: 11069, lines: [{ left: "Reduces it by 0.5 sec.", kind: DESCRIBED }] })
  Test::pass(SHOWS)
  const talent = tip("Improved Fireball")
  Test::expect(inColor(talent.text("5/5"), GREEN))
  Test::expect(!talent.text("Next rank:").shown())
}

test "a talent's «Next rank» unticked shows no next rank" {
  Game::spells.name = (id: integer): string | nil => "Improved Fireball"
  Game::talents.shown = (data: Game::TooltipData): Game::TalentInfo | nil => ({
    spell: 11069, rank: 2, ranks: 5, current: "Reduces it by 0.2 sec.", next: "Reduces it by 0.3 sec.",
    conditions: [], locked: false
  })
  Test::mount(nil, SCREEN)
  choose("Abilities", "Next rank")
  Game::tooltip.main = showing({ kind: 1, id: 11069, lines: [{ left: "Reduces it by 0.2 sec.", kind: DESCRIBED }] })
  Test::pass(SHOWS)
  Test::expect(!tip("Improved Fireball").text("Next rank:").shown())
}

test "a talent not learned names the points its tree wants, red while not spent, and the talent before it" {
  Game::spells.name = (id: integer): string | nil => "Improved Fireball"
  Game::talents.shown = (data: Game::TooltipData): Game::TalentInfo | nil => ({
    spell: 11069, rank: 0, ranks: 5, current: "Reduces it.", next: "Reduces the cast time.",
    conditions: [{ points: 5, met: false }, { points: 0, met: true }, { points: 10, met: true }], locked: true
  })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 1, id: 11069, lines: [{ left: "Reduces the cast time of Fireball by 0.1 sec.", kind: DESCRIBED }] })
  Test::pass(SHOWS)
  const talent = tip("Improved Fireball")
  Test::expect(reads(talent, "Improved Fireball | Talent | · | 0/5 | · | Fire | Reduces the cast time of Fireball by |cffffd1000.1 sec.|r | Talent points required | 5 | Talent points required | 10 | Learn the talent before it first"))
  Test::expect(inColor(talent.text("5"), RED))
  Test::expect(inColor(talent.text("10"), QUIET_VALUE))
  Test::expect(inColor(talent.text("Learn the talent before it first"), RED))
}

test "a talent whose spell the game doesn't name is left to the game" {
  Game::talents.shown = (data: Game::TooltipData): Game::TalentInfo | nil => ({
    spell: 1, rank: 0, ranks: 1, conditions: [], locked: false
  })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 1, lines: [] })
  Test::pass(SHOWS)
  Test::expect(none())
}

// Effects

function holyFire(): Game::TooltipData {
  return {
    kind: 7, id: 14914,
    lines: [
      { left: "Holy Fire", kind: 0 },
      { left: "Burns for 12 damage every 3 sec.", kind: DESCRIBED },
      { left: "9 seconds remaining", kind: 0 },
      { left: "ID 14914", kind: 0 }
    ]
  }
}

function burning(): Game::AuraInfo {
  return {
    harmful: true, dispel: "Magic", dispelName: "Magic", source: "target", sourceName: "Scarlet Monk",
    sourceColor: BLUE, stacks: 3, left: 9, own: false, hostile: false
  }
}

test "a harmful effect reads what it is, its stacks and time, the spell of the player's that removes it, who cast it and what it will still deal" {
  Game::spells.known = (id: integer): boolean => id == 527
  Game::spells.name = (id: integer): string | nil => id == 527 ? "Dispel Magic" : nil
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => burning()
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(holyFire())
  Test::pass(SHOWS)
  const effect = tip("Holy Fire")
  Test::expect(reads(effect, "Holy Fire | Debuff | · | Magic | ×3 | 9 s | Dispel Magic | Burns for 12 damage every 3 sec. | Cast by | Scarlet Monk | Damage left | 108 over 9 s"))
  Test::expect(inColor(effect.text("Holy Fire"), RED))
  Test::expect(inColor(effect.text("Magic"), MAGIC))
  Test::expect(inColor(effect.text("Dispel Magic"), REMOVER))
  Test::expect(inColor(effect.text("Scarlet Monk"), BLUE))
  Test::expect(effect.text("9 s").item().box(glyphArt(.Time)).shown())
}

test "a harmful effect the player's class can't remove names no spell" {
  Game::spells.known = (id: integer): boolean => false
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => burning()
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(holyFire())
  Test::pass(SHOWS)
  Test::expect(reads(tip("Holy Fire").text("×3").item(), "×3"))
  Test::expect(!tip("Holy Fire").text("Dispel Magic").shown())
}

test "an effect that heals says how much healing is left, its description starting with «Heals» or not" {
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => ({
    harmful: false, stacks: 1, left: 12, own: false, hostile: false
  })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 7, id: 139, lines: [{ left: "Renew", kind: 0 }, { left: "Heals 20 every 3 sec.", kind: DESCRIBED }]
  })
  Test::pass(SHOWS)
  Test::expect(reads(tip("Renew").text("Healing left").item(), "Healing left | 80 over 12 s"))
  Game::tooltip.main = showing({
    kind: 7, id: 139, lines: [{ left: "Rejuvenation", kind: 0 }, { left: "Will heal 20 every 3 sec.", kind: DESCRIBED }]
  })
  Test::pass(SHOWS)
  Test::expect(tip("Rejuvenation").text("Healing left").shown())
}

test "an effect's «Who cast it» and «Damage and healing left» unticked leave the footer out" {
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => burning()
  Test::mount(nil, SCREEN)
  choose("Effects", "Who cast it")
  choose("Effects", "Damage and healing left")
  Game::tooltip.main = showing(holyFire())
  Test::pass(SHOWS)
