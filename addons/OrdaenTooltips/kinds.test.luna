test "a cast of any kind beside a cooldown makes the cooldown a cell of its own" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 1, id: 4,
    lines: [
      { left: "Arcane Missiles", kind: NAME_OF_SPELL }, { left: "85 Mana", right: "30 yd range", kind: 0 },
      { left: "Channeled", right: "Cooldown: 8 sec", kind: 0 }
    ]
  })
  Test::pass(SHOWS)
  Test::expect(tip("Arcane Missiles").text("CD 8 sec").shown())
  Game::tooltip.main = showing({
    kind: 1, id: 5,
    lines: [{ left: "Heroic Strike", kind: NAME_OF_SPELL }, { left: "Next melee", right: "Cooldown: 3 sec", kind: 0 }]
  })
  Test::pass(SHOWS)
  Test::expect(reads(tip("Heroic Strike"), "Heroic Strike | Next | CD 3 sec"))
  Game::tooltip.main = showing({
    kind: 1, id: 6,
    lines: [{ left: "Fireball", kind: NAME_OF_SPELL }, { left: "3.5 sec cast", right: "Cooldown: 1 min", kind: 0 }]
  })
  Test::pass(SHOWS)
  Test::expect(reads(tip("Fireball"), "Fireball | 3.5 sec | CD 1 min"))
  Game::tooltip.main = showing({
    kind: 1, id: 7,
    lines: [{ left: "Teleport", kind: NAME_OF_SPELL }, { left: "1.5 min cast", right: "Cooldown: 1 h", kind: 0 }]
  })
  Test::pass(SHOWS)
  Test::expect(reads(tip("Teleport"), "Teleport | 1.5 min | CD 1 h"))
}

