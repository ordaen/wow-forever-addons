// Players and NPCs

function jaina(): Game::UnitInfo {
  return {
    name: "Jaina", player: true, titled: "Jaina the Patient", className: "Mage", classColor: BLUE,
    guild: "Kirin Tor", guildRank: "Archmage", dead: false, ghost: false, afk: true, dnd: false, pvp: true,
    level: 60, race: "Human", faction: "Alliance", factionName: "Alliance", sameFaction: true,
    target: { name: "Thrall", color: ORANGE }, raidGroup: 2, inParty: false, friend: true,
    friendNote: "met in Dalaran", ignored: false, tapped: false, classification: "normal"
  }
}

function hovered(name: string): Game::TooltipData {
  return { kind: 2, lines: [{ left: name, kind: NAME_OF_UNIT, unit: "mouseover" }, { left: "Level 60", kind: 0 }] }
}

test "a player reads their title round their name, guild and rank, class, away, PvP, level, race and side, target, raid and friend" {
  Game::units.of = (unit: string): Game::UnitInfo | nil => unit == "mouseover" ? jaina() : nil
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(hovered("Jaina"))
  Test::pass(SHOWS)
  const player = tip("Kirin Tor")
  Test::expect(reads(player, "|cffcbb994|r|cff4d99ffJaina|r|cffcbb994 the Patient|r | Kirin Tor | · | Archmage | Mage | · | Away | · | PvP | Level 60 | Human | Alliance | Target | Thrall | Raid | Group 2 | Friend | met in Dalaran"))
  Test::expect(inColor(player.text("Alliance"), GREEN))
  Test::expect(player.text("Alliance").item().box(glyphArt(.Alliance)).shown())
  Test::expect(inColor(player.text("Thrall"), ORANGE))
}

test "a player of the other side is in red with the Horde's glyph" {
  Game::units.of = (unit: string): Game::UnitInfo | nil => ({
    name: "Rexxar", player: true, dead: false, ghost: false, afk: false, dnd: false, pvp: false, level: 0,
    faction: "Horde", sameFaction: false, inParty: false, friend: false, ignored: false, tapped: false,
    classification: "normal"
  })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(hovered("Rexxar"))
  Test::pass(SHOWS)
  const player = tip("Rexxar")
  Test::expect(reads(player, "Rexxar | ?? | Horde"))
  Test::expect(inColor(player.text("Horde"), RED))
  Test::expect(player.text("Horde").item().box(glyphArt(.Horde)).shown())
}

test "a player's state reads dead, a ghost or not to be disturbed; a party member is the player's group, one ignored is red" {
  let who: Game::UnitInfo = { ...jaina(), dead: true }
  Game::units.of = (unit: string): Game::UnitInfo | nil => who
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(hovered("Jaina"))
  Test::pass(SHOWS)
  Test::expect(tip("Kirin Tor").text("Corpse").shown())
  who = { ...jaina(), ghost: true }
  Game::tooltip.main = showing(hovered("Jaina"))
  Test::pass(SHOWS)
  Test::expect(reads(tip("Kirin Tor"), "|cffcbb994|r|cff4d99ffJaina|r|cffcbb994 the Patient|r | Kirin Tor | · | Archmage | Mage | · | Ghost | · | PvP | Level 60 | Human | Alliance | Target | Thrall | Raid | Group 2 | Friend | met in Dalaran"))
  who = { ...jaina(), afk: false, dnd: true, raidGroup: nil, inParty: true, friend: false, ignored: true }
  Game::tooltip.main = showing(hovered("Jaina"))
  Test::pass(SHOWS)
  const player = tip("Kirin Tor")
  Test::expect(player.text("Do not disturb").shown())
  Test::expect(player.text("Group").item().texts().join(" | ") == "Group | Yours")
  Test::expect(inColor(player.text("On the list"), RED))
}

test "a player's «The player's target» and «Group and friends» unticked leave the footer out" {
  Game::units.of = (unit: string): Game::UnitInfo | nil => jaina()
  Test::mount(nil, SCREEN)
  choose("Players", "The player's target")
  choose("Players", "Group and friends")
  Game::tooltip.main = showing(hovered("Jaina"))
  Test::pass(SHOWS)
  Test::expect(reads(tip("Kirin Tor"), "|cffcbb994|r|cff4d99ffJaina|r|cffcbb994 the Patient|r | Kirin Tor | · | Archmage | Mage | · | Away | · | PvP | Level 60 | Human | Alliance"))
}

function pillager(): Game::UnitInfo {
  return {
    name: "Defias Pillager", player: false, dead: false, ghost: false, afk: false, dnd: false, pvp: false,
    level: 15, levelColor: ORANGE, faction: "Horde", sameFaction: false, inParty: false, friend: false,
    ignored: false, reactionColor: GAME_RED, tapped: true, creatureType: "Humanoid", classification: "rareelite"
  }
}

function pillagerTip(): Game::TooltipData {
  return {
    kind: 2,
    lines: [
      { left: "Defias Pillager", kind: NAME_OF_UNIT, unit: "target" },
      { left: "<Brotherhood Scout>", kind: 0 },
      { left: "Level 15 Humanoid (Rare Elite)", kind: 0 },
      { left: "Defias Brotherhood", kind: 0 },
      { left: "PvP", kind: 0 },
      { left: "Carries a torch.", leftColor: GAME_GREEN, kind: 0 },
      { left: "The Defias Brotherhood", kind: 17 },
      { left: " - Pillagers slain: 3/8", kind: 8 },
      { left: "Anduin", kind: 18 },
      { left: " - Pillagers slain: 8/8", kind: 8 }
    ]
  }
}

test "an NPC reads its role, its kind, its level in its colour, elite and rare, its faction, the quests with the party's, whose loot it is and the standing" {
  Game::units.of = (unit: string): Game::UnitInfo | nil => unit == "target" ? pillager() : nil
  Game::reputation.with = (faction: string): Game::Standing | nil => faction == "Defias Brotherhood" ? { rank: 2, label: "Hostile" } : nil
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(pillagerTip())
  Test::pass(SHOWS)
  const npc = tip("Brotherhood Scout")
  Test::expect(reads(npc, "Defias Pillager | Brotherhood Scout | Humanoid | Level 15 | Elite | Rare | Defias Brotherhood | Carries a torch. | The Defias Brotherhood | Pillagers slain | 3/8 | Anduin | 8/8 | Someone else's loot | Defias Brotherhood | Hostile"))
  Test::expect(inColor(npc.text("Defias Pillager"), GREY))
  Test::expect(inColor(npc.text("Level 15"), ORANGE))
  Test::expect(npc.text("Elite").item().box(glyphArt(.Elite)).shown())
  Test::expect(inColor(npc.text("Hostile"), RED))
  Test::expect(inColor(npc.text("8/8"), GREEN))
}

test "an NPC no one else has tapped is in its reaction's colour" {
  Game::units.of = (unit: string): Game::UnitInfo | nil => ({ ...pillager(), tapped: false })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(pillagerTip())
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Brotherhood Scout").text("Defias Pillager"), GAME_RED))
  Test::expect(!tip("Brotherhood Scout").text("Someone else's loot").shown())
}

test "a standing reads red to hostile, orange unfriendly, yellow neutral, green from friendly" {
  let rank = 3
  Game::units.of = (unit: string): Game::UnitInfo | nil => pillager()
  Game::reputation.with = (faction: string): Game::Standing | nil => ({ rank: rank, label: "Standing" })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(pillagerTip())
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Brotherhood Scout").text("Standing"), #ff8040))
  rank = 4
  Game::tooltip.main = showing({ kind: 2, lines: [{ left: "Defias Pillager", kind: NAME_OF_UNIT, unit: "target" }, { left: "<Brotherhood Scout>", kind: 0 }, { left: "Defias Brotherhood", kind: 0 }] })
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Brotherhood Scout").text("Standing"), GOLD))
  rank = 5
  Game::tooltip.main = showing(pillagerTip())
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Brotherhood Scout").text("Standing"), FRIENDLY))
}

test "an NPC's «Party quests», «Someone else's loot» and «Reputation» unticked leave them out" {
