// Comparisons

// The strength, stamina and agility of each axe, as the game reads an item's stats.
function axes(data: Game::TooltipData): array<Game::ItemStat> {
  const name = data.lines[1]?.left
  if (name == "Greataxe") {
    return [
      { key: "ITEM_MOD_STRENGTH_SHORT", name: "Strength", value: 30 },
      { key: "ITEM_MOD_STAMINA_SHORT", name: "Stamina", value: 12 }
    ]
  }
  if (name == "Worn Axe") {
    return [
      { key: "ITEM_MOD_STRENGTH_SHORT", name: "Strength", value: 21 },
      { key: "ITEM_MOD_STAMINA_SHORT", name: "Stamina", value: 12 },
      { key: "ITEM_MOD_AGILITY_SHORT", name: "Agility", value: 7 }
    ]
  }
  if (name == "Old Axe") { return [{ key: "ITEM_MOD_STRENGTH_SHORT", name: "Strength", value: 40 }] }
  return []
}

function wielded(name: string): Game::TooltipData {
  return { kind: 0, lines: [{ left: name, kind: NAME_OF_ITEM }] }
}

test "an item compared with the worn one shows it under «Equipped», and on itself what it has more or less of" {
  Game::items.stats = axes
  Game::items.statName = (key: string): string | nil => key == "ITEM_MOD_AGILITY_SHORT" ? "Agility" : nil
  Test::mount(nil, SCREEN)
  Game::tooltip.compared = [wielded("Worn Axe")]
  Game::tooltip.main = showing(wielded("Greataxe"))
  Test::pass(SHOWS)
  const group = tip("Greataxe")
  Test::expect(reads(group.text("Equipped").item(), "Equipped | Worn Axe | Strength | +21 | Stamina | +12 | Agility | +7"))
  // More strength, the same stamina, and the agility it lacks.
  const more = group.text("+30").item()
  Test::expect(reads(more, "Strength | +30 | (9 | )"))
  Test::expect(inColor(more.text("(9"), GREEN) && more.paintedWith(Ordaen.art.ctl.compareUp))
  Test::expect(reads(group.text("+12").nth(1).item(), "Stamina | +12"))
  const lacks = group.text("Agility").nth(2).item()
  Test::expect(reads(lacks, "Agility | — | (7 | )"))
  Test::expect(inColor(lacks.text("(7"), RED) && lacks.paintedWith(Ordaen.art.ctl.compareDown))
  Test::expect(inColor(lacks.text("Agility"), GREY))
}

test "an item compared with two worn ones shows the differences on each of them" {
  Game::items.stats = axes
  Test::mount(nil, SCREEN)
  Game::tooltip.compared = [wielded("Worn Axe"), wielded("Old Axe")]
  Game::tooltip.main = showing(wielded("Greataxe"))
  Test::pass(SHOWS)
  const group = tip("Greataxe")
  Test::expect(reads(group.text("Old Axe").item(), "Equipped | Old Axe | Strength | +40 | (10 | )"))
  Test::expect(reads(group.text("Worn Axe").item(), "Equipped | Worn Axe | Strength | +21 | (9 | ) | Stamina | +12 | Agility | +7 | (7 | )"))
  Test::expect(reads(group.text("+30").item(), "Strength | +30"))
}

// The game's texts

function towerShield(): Game::TooltipData {
  return {
    kind: 0, id: 9100,
    lines: [
      { left: "Tower Shield", kind: NAME_OF_ITEM },
      { left: "1234 Armor", kind: 0 },
      { left: "216 - 325 Damage", right: "Speed 3,40", kind: 0 },
      { left: "(78.35 damage per second)", kind: 0 }
    ]
  }
}

test "an item's numbers are written as Ordaen writes them at first: a space between thousands, two decimals" {
