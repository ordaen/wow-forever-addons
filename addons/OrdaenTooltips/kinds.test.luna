test "a spell's first lines with no right side are cells of its band; a later one, in a free line's colour, is the body's" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 1, id: 3,
    lines: [
      { left: "Shoot", kind: NAME_OF_SPELL }, { left: "30 yd range", kind: 0 }, { left: "Instant", kind: 0 },
      { left: "Uses a wand.", kind: DESCRIBED }, { left: "Needs a wand.", kind: 0 }, { left: "---", kind: 1 }
    ]
  })
  Test::pass(SHOWS)
  const shoot = tip("Shoot")
  // The range without its label and its full stop.
  Test::expect(reads(shoot, "Shoot | 30 yd | Instant | Uses a wand. | Needs a wand."))
  Test::expect(inColor(shoot.text("Uses a wand."), BODY) && inColor(shoot.text("Needs a wand."), FREE))
}

