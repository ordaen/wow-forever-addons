  Test::expect(reads(tip("Tower Shield"), "Tower Shield | 1\194\160234 | 216–325 | 3.4/s | 78.35 DPS"))
}

test "an item's numbers follow Ordaen's number settings: dots between thousands, whole numbers" {
  Test::mount(nil, SCREEN)
  Test::open("/ordaen")
  const settings = Test::page().window(SETTINGS)
  settings.button("Numbers").click()
  settings.button("1\194\160000\194\160000.09").click()
  Test::page().window("1.000.000,09").button("1.000.000,09").click()
  settings.button("Round to whole numbers").click()
  Test::key(Key::Escape)
  Game::tooltip.main = showing(towerShield())
  Test::pass(SHOWS)
  Test::expect(reads(tip("Tower Shield"), "Tower Shield | 1.234 | 216–325 | 3/s | 78 DPS"))
}

