// Each kind of the game's tooltips as the player reads it in Ordaen's: the game's tooltip shows something (the fake
// game's `Game.tooltip.main`), and the tooltip drawn in its place says it, a text after another, in their colours
// where a colour says something. What a kind shows more or less of is chosen on its tab of the settings (`/ordaen`,
// «Tooltips»).
import Client from "$client"
import Game from "$game"
import { Art, Key } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, glyphArt } from "Ordaen"

// The general delay before a tooltip shows, and the frame its watch takes to see the show.
const SHOWS = 0.32

const SCREEN: Test::Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
// A text the settings window always shows.
const SETTINGS = "Move mode"

// The game's colours as its lines come.
const WHITE: color = #ffffff
const GAME_GOLD: color = #ffd100
const GAME_RED: color = #ff1a1a
const GAME_GREEN: color = #1fff00
const BLUE: color = #4d99ff
const ORANGE: color = #ff8000
const EPIC: color = #a336ed

// The colours Ordaen's tooltip writes in: what can't be done or is lacking, what is done or more, a heading, what
// is neither good nor bad yet, something put aside; and a free line's own, a footer's value.
const RED: color = #ff4040
const GREEN: color = #1eff00
const GOLD: color = #ffd100
const GREY: color = #808080
const MAGIC: color = #3c9cff
const REMOVER: color = #8fd2ff
const QUIET_VALUE: color = #a39883
const BODY: color = #f3e7cc
const FRIENDLY: color = #40bf40

// The game's own tooltip, in the screen's bottom right corner: where its show is, and where ours stands.
function corner(): any Client::Frame {
  const made = Client::CreateFrame("Frame", "GameTooltip", Client::C_UI::GetUIParent(), nil)
  made.SetSize(200, 80)
  made.SetPoint("TOPLEFT", Client::C_UI::GetUIParent(), "TOPLEFT", 1300, -720)
  return made
}

// The game's tooltip showing `data`.
function showing(data: Game::TooltipData): Game::ShownTip {
  const at = corner()
  return {
    shown: true, data: data, placeable: false, ownerHigh: false, ownerRight: false, corner: at, below: false,
    right: true, home: at, homeBelow: false, homeRight: true
  }
}

// Whether a part's texts read exactly this, each without the room round it (the « · » between a title's pieces is
// «·»), joined by « | »: where they don't, the test fails with what they read.
function reads(part: Test::Part, expected: string): boolean {
  const read = part.texts().map(text => text.match("^%s*(.-)%s*$") ?? text).join(" | ")
  if (read != expected) { throw Error { message: `it reads «${read}», not «${expected}»` } }
  return true
}

// Whether a text is drawn in this colour: where it isn't, the test fails with the colour it is in.
function inColor(part: Test::Part, color: color): boolean {
  const drawn = part.textColor()
  if (!drawn.equal(color)) { throw Error { message: `it is drawn in ${code(drawn)}, not ${code(color)}` } }
  return true
}

function code(color: color): string {
  return "#%02x%02x%02x".format((color.r * 255).round(), (color.g * 255).round(), (color.b * 255).round())
}

// The tooltip that holds this text.
function tip(holding: string): Test::Part {
  return Test::page().window(holding)
}

// Nothing of Ordaen's shows: the show is the game's.
function none(): boolean {
  return Test::surfaces().length == 0
}

// A control of the module's tab in the settings, clicked as the player clicks it, which applies at once: `/ordaen`,
// «Tooltips», the tab, the control, and the window closed.
function choose(tab: string, control: string) {
  Test::open("/ordaen")
  const settings = Test::page().window(SETTINGS)
  settings.button("Tooltips").click()
  settings.button(tab).click()
  settings.button(control).click()
  Test::key(Key::Escape)
}

// The game's numbers for what a line is, as the tests below write them.
const NAME_OF_ITEM = 22
const NAME_OF_SPELL = 13
const NAME_OF_UNIT = 2
const REQUIRES = 43
const DESCRIBED = 34

function frostbolt(): Game::TooltipData {
  return {
    kind: 1, id: 116,
    lines: [
      { left: "Frostbolt", right: "Rank 4", kind: NAME_OF_SPELL },
      { left: "65 Mana", right: "30 yd range", kind: 0 },
      { left: "2.5 sec cast", kind: 0 },
      { left: "Launches a bolt of frost at the enemy.", kind: DESCRIBED },
      { left: "Requires: Staff", kind: REQUIRES, usable: false }
    ]
  }
}

function eviscerate(): Game::TooltipData {
  return {
    kind: 1, id: 2098,
    lines: [
      { left: "Eviscerate", kind: NAME_OF_SPELL },
      { left: "35 Energy", right: "Melee Range", kind: 0 },
      { left: "Instant", right: "Cooldown: 10 sec", kind: 0 },
      { left: "Reagents: Flash Powder (2), Rune", kind: 0 },
      {
        left: "Finishing move that causes damage per combo point:\n  1 point: 46-66 damage\n  2 points: 80 – 100 damage\nStrikes hard.",
        kind: DESCRIBED
      },
      { left: "Passive", kind: 33 }
    ]
  }
}

// Buttons' and addons' texts

test "a button's tooltip reads its title, its lines and the key the game appends to the title, as a hotkey" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    plain: true,
    lines: [
      { left: "Character Info |cffffd200(C)|r", leftColor: WHITE, kind: 0 },
      { left: "Your character's gear and statistics.", leftColor: GAME_GOLD, kind: 0 },
      { left: "Item level", right: "62", leftColor: GAME_GOLD, rightColor: WHITE, kind: 0 },
      { left: "Durability is low", leftColor: GAME_RED, kind: 0 },
      { right: "only a right text", kind: 0 }
    ]
  })
  Test::pass(SHOWS)

  Test::expect(reads(tip("Character Info"), "Character Info | Your character's gear and statistics. | Item level | 62 | Durability is low | only a right text | C: open"))
}

test "a button's line in a colour of its own keeps it; one in the game's gold or white is in the tooltip's" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    plain: true,
    lines: [
      { left: "Game Menu", kind: 0 },
      { left: "Latency:", leftColor: GAME_GOLD, kind: 0 },
      { left: "Home 31 ms", leftColor: WHITE, kind: 0 },
      { left: "Durability is low", leftColor: GAME_RED, kind: 0 }
    ]
  })
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Latency:").text("Latency:"), BODY))
  Test::expect(inColor(tip("Latency:").text("Home 31 ms"), BODY))
  Test::expect(inColor(tip("Latency:").text("Durability is low"), GAME_RED))
}

// The game menu's button as the game fills it each second: its latency.
function menu(latency: integer, color: color): Game::TooltipData {
  return {
    plain: true,
    lines: [
      { left: "Game Menu |cffffd200(Esc)|r", kind: 0 }, { left: "Latency:", right: `${latency} ms`, rightColor: color, kind: 0 },
      { left: "Durability is low", leftColor: GAME_RED, kind: 0 }
    ]
  }
}

test "a text tooltip the game fills anew with the same lines draws nothing anew" {
  Test::mount(nil, SCREEN)
  const shown = showing(menu(31, GAME_GREEN))
  Game::tooltip.main = shown
  Test::pass(SHOWS)
  Test::flush()
  const said = Test::calls((): nil => {
    Game::tooltip.main = { ...shown, data: menu(31, GAME_GREEN) }
    Test::pass(SHOWS)
    Test::flush()
  })
  // The tooltip is placed again where the game's stands; no text of it is set or tinted.
  Test::expect(!said.contains("SetText") || throw Error { message: said })
}

test "a text tooltip the game fills anew draws anew only the line that changed, in its text or its colour" {
  Test::mount(nil, SCREEN)
  const shown = showing(menu(31, GAME_GREEN))
  Game::tooltip.main = shown
  Test::pass(SHOWS)
  Test::flush()
  const said = Test::calls((): nil => {
    Game::tooltip.main = { ...shown, data: menu(32, GAME_GREEN) }
    Test::pass(SHOWS)
    Test::flush()
  })
  Test::expect(said.contains("SetText=1") || throw Error { message: said })
  const tinted = Test::calls((): nil => {
    Game::tooltip.main = { ...shown, data: menu(32, GAME_RED) }
    Test::pass(SHOWS)
    Test::flush()
  })
  Test::expect((!tinted.contains("SetText=") && tinted.contains("SetTextColor=1")) || throw Error { message: tinted })
  Test::expect(inColor(tip("Latency:").text("32 ms"), GAME_RED))
}

// The menu button's tooltip with a dozen addons' memory, the third's as given.
function memory(third: string): Game::TooltipData {
  let lines: array<Game::TooltipLine> = mut [{ left: "Game Menu |cffffd200(Esc)|r", kind: 0 }]
  for (i of 1..12) { lines.push({ left: `Addon ${i}`, right: i == 3 ? third : `${i}.10 MB`, kind: 0 }) }
  return { plain: true, lines: lines }
}

test "a text tooltip the game fills anew with the same lines makes no tooltip anew: under half the garbage of a line changed" {
  Test::mount(nil, SCREEN)
  const shown = showing(memory("1 MB"))
  Game::tooltip.main = shown
  Test::pass(SHOWS)
  Test::flush()
  // Filled anew once, as the game does each second, and the first measure (what is made once) made; then measured.
  Game::tooltip.main = { ...shown, data: memory("2 MB") }
  Test::pass(SHOWS)
  _ = Test::garbage((): nil => Test::flush())
  const same = memory("2 MB")
  const kept = Test::garbage((): nil => {
    Game::tooltip.main = { ...shown, data: same }
    Test::pass(SHOWS)
    Test::flush()
  })
  // A line of another width: one that measures what it did lays nothing out, and costs little more than none.
  const other = memory("1024 MB")
  const changed = Test::garbage((): nil => {
    Game::tooltip.main = { ...shown, data: other }
    Test::pass(SHOWS)
    Test::flush()
  })
  Test::expect(kept * 2 < changed || throw Error { message: "%.2f kB the same, %.2f kB a line changed".format(kept, changed) })
}

// The game's tooltip at the same place showing other lines.
function refilled(shown: Game::ShownTip, lines: array<Game::TooltipLine>): Game::ShownTip {
  return { ...shown, data: { plain: true, lines: lines } }
}

test "a text tooltip filled anew with the same lines under another title, key or title colour shows them" {
  Test::mount(nil, SCREEN)
  const latency: Game::TooltipLine = { left: "Latency:", right: "31 ms", kind: 0 }
  const shown = showing({ plain: true, lines: [{ left: "Game Menu |cffffd200(Esc)|r", kind: 0 }, latency] })
  Game::tooltip.main = shown
  Test::pass(SHOWS)
  Test::expect(reads(tip("Latency:"), "Game Menu | Latency: | 31 ms | Esc: open"))
  Game::tooltip.main = refilled(shown, [{ left: "Options |cffffd200(Esc)|r", kind: 0 }, latency])
  Test::pass(SHOWS)
  Test::expect(reads(tip("Latency:"), "Options | Latency: | 31 ms | Esc: open"))
  Game::tooltip.main = refilled(shown, [{ left: "Options |cffffd200(F10)|r", kind: 0 }, latency])
  Test::pass(SHOWS)
  Test::expect(reads(tip("Latency:"), "Options | Latency: | 31 ms | F10: open"))
  Game::tooltip.main = refilled(shown, [{ left: "Options", kind: 0 }, latency])
  Test::pass(SHOWS)
  Test::expect(reads(tip("Latency:"), "Options | Latency: | 31 ms"))
  Game::tooltip.main = refilled(shown, [{ left: "Options", leftColor: GAME_RED, kind: 0 }, latency])
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Latency:").text("Options"), GAME_RED))
}

test "a text tooltip filled anew with a line fewer shows it no more" {
  Test::mount(nil, SCREEN)
  const shown = showing(menu(31, GAME_GREEN))
  Game::tooltip.main = shown
  Test::pass(SHOWS)
  Test::flush()
  Game::tooltip.main = refilled(shown, [{ left: "Game Menu |cffffd200(Esc)|r", kind: 0 }, menu(31, GAME_GREEN).lines[2] ?? throw Error { message: "a line" }])
  Test::pass(SHOWS)
  Test::expect(reads(tip("Latency:"), "Game Menu | Latency: | 31 ms | Esc: open"))
}

test "a text tooltip filled anew shows a line's colour changed in any of its parts, gained or lost" {
  Test::mount(nil, SCREEN)
  const title: Game::TooltipLine = { left: "Game Menu", kind: 0 }
  const shown = showing({ plain: true, lines: [title, { left: "Durability is low", leftColor: GAME_RED, kind: 0 }] })
  Game::tooltip.main = shown
  Test::pass(SHOWS)
  Test::flush()
  for (color of [#801a1a, #80401a, #804040, #80404080]) {
    Game::tooltip.main = refilled(shown, [title, { left: "Durability is low", leftColor: color, kind: 0 }])
    Test::pass(SHOWS)
    Test::expect(tip("Game Menu").text("Durability is low").textColor().equal(color) || throw Error { message: code(color) })
  }
  Game::tooltip.main = refilled(shown, [title, { left: "Durability is low", kind: 0 }])
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Game Menu").text("Durability is low"), BODY))
  Game::tooltip.main = refilled(shown, [title, { left: "Durability is low", leftColor: GAME_RED, kind: 0 }])
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Game Menu").text("Durability is low"), GAME_RED))
}

test "a text tooltip with no lines is left to the game" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ plain: true, lines: [] })
  Test::pass(SHOWS)
  Test::expect(none())
}

test "a tooltip of a kind Ordaen's doesn't read is left to the game" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 9, lines: [{ left: "?", kind: 0 }] })
  Test::pass(SHOWS)
  Test::expect(none())
}

// World objects

test "a chest names the skill and the rank that open it, the rank red while the player lacks it" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 4,
    lines: [
      { left: "Battered Chest", kind: 0 },
      { left: "Requires Lockpicking (75)", kind: REQUIRES, usable: false },
      { left: "", kind: 1 },
      { left: "Locked", leftColor: GAME_RED, kind: 0 },
      { left: "2 |4charge:charges; left", leftColor: GAME_GREEN, kind: 0 }
    ]
  })
  Test::pass(SHOWS)
  const chest = tip("Battered Chest")
  Test::expect(reads(chest, "Battered Chest | Locked | 2 charges left | Lockpicking | 75"))
  Test::expect(inColor(chest.text("Battered Chest"), GOLD))
  Test::expect(inColor(chest.text("75"), RED))
  Test::expect(inColor(chest.text("Locked"), GAME_RED))
}

test "a chest whose skill the player has names its rank in the footer's colour" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 4,
    lines: [{ left: "Battered Chest", kind: 0 }, { left: "Requires Lockpicking (75)", kind: REQUIRES }]
  })
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Battered Chest").text("75"), QUIET_VALUE))
}

test "a door names the keys that open it, a key the player doesn't carry in red" {
  Test::mount(nil, SCREEN)
  Game::items.count = (name: string): integer => name == "Workshop Key" ? 1 : 0
  Game::tooltip.main = showing({
    kind: 4,
    lines: [
      { left: "Workshop Door", kind: 0 },
      { left: "Requires: Workshop Key", kind: REQUIRES },
      { left: "Requires Defias Chest Key", kind: REQUIRES }
    ]
  })
  Test::pass(SHOWS)
  const door = tip("Workshop Door")
  Test::expect(reads(door, "Workshop Door | Needs a key | Workshop Key | Needs a key | Defias Chest Key"))
  Test::expect(inColor(door.text("Workshop Key"), QUIET_VALUE))
  Test::expect(inColor(door.text("Defias Chest Key"), RED))
}

test "a key the player carries is red while the game says the door can't be opened" {
  Test::mount(nil, SCREEN)
  Game::items.count = (name: string): integer => 1
  Game::tooltip.main = showing({
    kind: 4,
    lines: [{ left: "Workshop Door", kind: 0 }, { left: "Requires: Workshop Key", kind: REQUIRES, usable: false }]
  })
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Workshop Door").text("Workshop Key"), RED))
}

test "an object with no name is left to the game" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 4, lines: [{ left: "", kind: 0 }] })
  Test::pass(SHOWS)
  Test::expect(none())
}

test "an object a quest wants names the quest and its objective after its own lines, the objective done in green" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 4,
    lines: [
      { left: "Sack of Oats", kind: 0 },
      { left: "Smells of hay.", kind: 0 },
      { left: "Feeding the Horses", kind: 17 },
      { left: "Oats gathered: 4/4", kind: 8 },
      { left: "Hay bundled: 1/3", kind: 8 }
    ]
  })
  Test::pass(SHOWS)
  const sack = tip("Sack of Oats")
  Test::expect(reads(sack, "Sack of Oats | Smells of hay. | Feeding the Horses | Oats gathered | 4/4 | Hay bundled | 1/3"))
  Test::expect(inColor(sack.text("Feeding the Horses"), GOLD))
  Test::expect(inColor(sack.text("4/4"), GREEN))
  Test::expect(inColor(sack.text("1/3"), BODY))
}

test "an objective the game says is done is green before its count is reached" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 4,
    lines: [
      { left: "Sack of Oats", kind: 0 },
      { left: "Feeding the Horses", kind: 17 },
      { left: "Oats gathered: 1/4", kind: 8, completed: true }
    ]
  })
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Sack of Oats").text("1/4"), GREEN))
}

// Abilities

test "a spell reads its rank and tab, its cost and range, its cast, its description and what it requires" {
  Game::spells.texture = (id: integer): Art | nil => id == 116 ? "Interface/Icons/Spell_Frost_FrostBolt02" : nil
  Game::spells.cost = (id: integer): Game::SpellCost | nil => id == 116 ? { amount: 65, color: BLUE } : nil
  Game::spells.tab = (id: integer): string | nil => id == 116 ? "Frost" : nil
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(frostbolt())
  Test::pass(SHOWS)
  const bolt = tip("Frostbolt")
  Test::expect(reads(bolt, "Frostbolt | Rank 4 | · | Frost | 65 | 30 yd | 2.5 sec | Launches a bolt of frost at the enemy. | Requires | Staff"))
  Test::expect(bolt.paintedWith("Interface/Icons/Spell_Frost_FrostBolt02"))
  Test::expect(inColor(bolt.text("Staff"), RED))
}

test "a spell's cost is a dot in its resource's colour, each cast its own glyph" {
  Game::spells.cost = (id: integer): Game::SpellCost | nil => ({ amount: 65, color: BLUE })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(frostbolt())
  Test::pass(SHOWS)
  const bolt = tip("Frostbolt")
  Test::expect(bolt.text("65").item().box(glyphArt(.Cost)).paintedWith(BLUE))
  Test::expect(bolt.text("2.5 sec").item().box(glyphArt(.CastTime)).shown())
  Test::expect(!bolt.text("30 yd range").item().box(glyphArt(.Cost)).shown())
}

test "a cost in mana, rage or energy is the design's colour of it, not the client's" {
  Game::spells.cost = (id: integer): Game::SpellCost | nil => ({ amount: 65, resource: .Mana, color: BLUE })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(frostbolt())
  Test::pass(SHOWS)
  Test::expect(tip("Frostbolt").text("65").item().box(glyphArt(.Cost)).paintedWith(#2f6fe0))
}

test "a finishing move reads instant, melee range, its cooldown, its points as rows and its reagents" {
  Game::spells.cost = (id: integer): Game::SpellCost | nil => ({ amount: 35, color: GAME_GOLD })
  Game::items.count = (name: string): integer => name == "Flash Powder" ? 1 : 3
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(eviscerate())
  Test::pass(SHOWS)
  const move = tip("Eviscerate")
  Test::expect(reads(move, "Eviscerate | Passive | 35 | 5 yd | Instant | CD 10 sec | Finishing move that causes damage per combo point:\nStrikes hard. | 1 point | 46–66 | 2 points | 80–100 | Flash Powder | 2 | Rune | 1"))
  Test::expect(move.text("Instant").item().box(glyphArt(.CastNow)).shown())
  Test::expect(inColor(move.text("2"), RED))
  Test::expect(inColor(move.text("1"), QUIET_VALUE))
}

// A trainer's recipe, as the game gives its tooltip (Forever, 2026-11-22): the recipe's spell, its tools and reagents
// with their colours and the line break after the label, what it does, then the item it makes after the line that
// opens it.
function wandRecipe(): Game::TooltipData {
  return {
    kind: 1, id: 14293,
    lines: [
      { left: "Enchanting: Lesser Magic Wand", kind: NAME_OF_SPELL },
      { left: "", kind: 0 },
      { left: "Tools:Runed Copper Rod", kind: 0 },
      { left: "Reagents: |n|cffff2020Simple Wood|r, |cffff2020Lesser Magic Essence|r", kind: 0 },
      { left: "Creates a Lesser Magic Wand.", kind: DESCRIBED },
      { left: "", kind: 19 },
      { left: "\nLesser Magic Wand", kind: 22 },
      { left: "Binds when equipped", kind: 20 },
      { left: "Ranged", right: "Wand", kind: 21 },
      { left: "12 - 22 Arcane Damage", right: "Speed 1.50", kind: 0 },
      { left: "Requires Level 5", kind: REQUIRES }
    ]
  }
}

test "a trainer's recipe is the recipe's tooltip, its reagents in the footer, with the item it makes beside it" {
  Game::items.count = (name: string): integer => name == "Simple Wood" ? 1 : 0
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(wandRecipe())
  Test::pass(SHOWS)
  // What it makes beside it, then the recipe: its name, what it does, its reagents.
  Test::expect(reads(tip("Enchanting: Lesser Magic Wand"), "Lesser Magic Wand | Ranged | · | Wand | Binds when equipped | 12–22 | 1.5/s | Requires level | 5 | Enchanting: Lesser Magic Wand | Tools:Runed Copper Rod | Creates a Lesser Magic Wand. | Simple Wood | 1 | Lesser Magic Essence | 1"))
  Test::expect(inColor(tip("Enchanting: Lesser Magic Wand").text("Lesser Magic Essence").item().text("1"), RED))
}

test "a channelled spell and one on the next swing have their casts' glyphs" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 1, id: 10,
    lines: [{ left: "Blizzard", kind: NAME_OF_SPELL }, { left: "Channeled", right: "Next melee", kind: 0 }]
  })
  Test::pass(SHOWS)
  const blizzard = tip("Blizzard")
  Test::expect(reads(blizzard, "Blizzard | Channeled | Next"))
  Test::expect(blizzard.text("Channeled").item().box(glyphArt(.CastChan)).shown())
  Test::expect(blizzard.text("Next").item().box(glyphArt(.CastNext)).shown())
}

test "a channelled spell's cell says for how long, as its description has it; the description's numbers and school lit" {
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 1, id: 10,
    lines: [
      { left: "Arcane Missiles", kind: NAME_OF_SPELL }, { left: "Channeled", kind: 0 },
      { left: "Launches 3 missiles, each dealing 24 Arcane damage, over 3 sec. Unlike «Frostbolt».", kind: DESCRIBED }
    ]
  })
  Test::pass(SHOWS)
  const missiles = tip("Arcane Missiles")
  Test::expect(missiles.text("3 sec").item().box(glyphArt(.CastChan)).shown())
  Test::expect(reads(
    missiles,
    "Arcane Missiles | 3 sec | Launches |cffffd1003|r missiles, each dealing |cffffd10024|r |cffe48af0Arcane damage|r, over |cffffd1003 sec.|r Unlike «|cffffd100Frostbolt|r»."
  ))
}

test "a spell's rank is the client's subtext where its tooltip says none, in Ordaen's words" {
  Client::C_Spell::GetSpellSubtext = (spell: string | integer): string | nil => spell == 10 ? "Уровень 7" : nil
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 1, id: 10, lines: [{ left: "Blizzard", kind: NAME_OF_SPELL }, { left: "Channeled", kind: 0 }] })
  Test::pass(SHOWS)
  Test::expect(tip("Blizzard").text("Rank 7").shown())
}

test "a spell cooling down says how long until it is ready, in yellow" {
  Game::spells.cooldown = (id: integer): number | nil => 95
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(frostbolt())
  Test::pass(SHOWS)
  const bolt = tip("Frostbolt")
  Test::expect(bolt.text("Ready in").item().texts().join(" | ") == "Ready in | 2 m")
  Test::expect(inColor(bolt.text("2 m"), GOLD))
}

test "a wait is said in whole hours from an hour, in whole minutes from a minute, in seconds below" {
  let left: number = 3600
  Game::spells.cooldown = (id: integer): number | nil => left
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(frostbolt())
  Test::pass(SHOWS)
  Test::expect(tip("Frostbolt").text("1 h").shown())
  left = 3599
  Test::pass(1)
  Test::expect(tip("Frostbolt").text("60 m").shown())
  left = 60
  Test::pass(1)
  Test::expect(tip("Frostbolt").text("1 m").shown())
  left = 59.4
  Test::pass(1)
  Test::expect(tip("Frostbolt").text("59 s").shown())
}

test "a spell's wait is read again as the seconds pass" {
  let left: number = 95
  Game::spells.cooldown = (id: integer): number | nil => left
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(frostbolt())
  Test::pass(SHOWS)
  left = 30
  Test::pass(1.1)
  Test::expect(tip("Frostbolt").text("30 s").shown())
}

test "a spell that comes ready says no wait, and nothing waits for a second once it is locked" {
  let left: number | nil = 30
  Game::spells.cooldown = (id: integer): number | nil => left
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(frostbolt())
  Test::pass(SHOWS)
  left = nil
  Test::pass(1.3)
  Test::expect(!tip("Frostbolt").text("Ready in").shown())
  Test::expect(Test::idle())
}

test "a spell's «Cooldown» unticked says no wait" {
  Game::spells.cooldown = (id: integer): number | nil => 95
  Test::mount(nil, SCREEN)
  choose("Abilities", "Cooldown")
  Game::tooltip.main = showing(frostbolt())
  Test::pass(SHOWS)
  Test::expect(!tip("Frostbolt").text("Ready in").shown())
}

test "a spell's «Spell ID» ticked shows its number" {
