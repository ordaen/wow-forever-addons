test "an item compared by level: the level it has more of, and no row for a level it lacks" {
  Game::items.stats = axes
  Game::items.level = (id: integer): integer | nil => id == 1 ? 62 : id == 2 ? 60 : nil
  Test::mount(nil, SCREEN)
  Game::tooltip.compared = [{ kind: 0, id: 2, lines: [{ left: "Worn Axe", kind: NAME_OF_ITEM }] }]
  Game::tooltip.main = showing({ kind: 0, id: 1, lines: [{ left: "Greataxe", kind: NAME_OF_ITEM }] })
  Test::pass(SHOWS)
  Test::expect(reads(tip("Greataxe").text("62").item(), "Item level | 62 | (2 | )"))
  Game::tooltip.main = showing({ kind: 0, id: 3, lines: [{ left: "Greataxe", kind: NAME_OF_ITEM }] })
  Test::pass(SHOWS)
  Test::expect(tip("Greataxe").text("Item level").count() == 1)
}

test "an NPC's first lines: a title in its role's place, a pet's owner, its level's line and a line like its kind gone" {
  Game::units.of = (unit: string): Game::UnitInfo | nil => ({
    name: "Wolf", player: false, dead: false, ghost: false, afk: false, dnd: false, pvp: false, level: 5,
    inParty: false, friend: false, ignored: false, tapped: false, creatureType: "Beast", classification: "rare",
    sameFaction: true
  })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 2,
    lines: [
      { left: "Wolf", kind: NAME_OF_UNIT, unit: "target" }, { left: "Pack Leader", kind: 0 },
      { left: "Level 5 Beast", kind: 0 }, { left: "Beast", kind: 0 }, { left: "Jaina's Pet", kind: 16 },
      { left: "Howls.", kind: 0 }, { left: "---", kind: 1 }
    ]
  })
  Test::pass(SHOWS)
  Test::expect(reads(tip("Pack Leader"), "Wolf | Pack Leader | · | Jaina's Pet | Beast | Level 5 | Rare | Howls."))
}

// An NPC of this level and side, with the game's lines after its name.
function npcOf(level: integer, faction: string | nil): Game::UnitInfo {
  return {
    name: "Ogre", player: false, dead: false, ghost: false, afk: false, dnd: false, pvp: false, level: level,
    faction: faction, sameFaction: true, inParty: false, friend: false, ignored: false, tapped: false,
    classification: "normal"
  }
}

function npcTip(lines: array<string>): Game::TooltipData {
  let all: array<Game::TooltipLine> = mut [{ left: "Ogre", kind: NAME_OF_UNIT, unit: "target" }]
  for (text of lines) { all.push(text == "" ? { left: "---", kind: 1 } : { left: text, kind: 0 }) }
  return { kind: 2, lines: all }
}

test "an NPC's level line goes only among its first three lines, and only for a level the game knows" {
  let who = npcOf(60, nil)
  Game::units.of = (unit: string): Game::UnitInfo | nil => who
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(npcTip(["Level 60", "Brute", "Slain 60 times"]))
  Test::pass(SHOWS)
  Test::expect(reads(tip("Ogre"), "Ogre | Brute | Level 60 | Slain 60 times"))
  who = npcOf(1, nil)
  Game::tooltip.main = showing(npcTip(["Level 1"]))
  Test::pass(SHOWS)
  Test::expect(reads(tip("Ogre"), "Ogre | Level 1"))
  who = npcOf(0, nil)
  Game::tooltip.main = showing(npcTip(["<Legion of 1000>"]))
  Test::pass(SHOWS)
  Test::expect(reads(tip("Ogre"), "Ogre | Legion of 1000 | ??"))
}

test "an NPC's faction is its line among the first four; a later one is the body's" {
  Game::units.of = (unit: string): Game::UnitInfo | nil => npcOf(60, "Alliance")
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(npcTip(["<Watch>", "Level 60", "Stormwind"]))
  Test::pass(SHOWS)
  Test::expect(reads(tip("Ogre"), "Ogre | Watch | Level 60 | Stormwind"))
  Game::tooltip.main = showing(npcTip(["<Watch>", "Level 60", "", "Stormwind"]))
  Test::pass(SHOWS)
  Test::expect(reads(tip("Ogre"), "Ogre | Watch | Level 60 | Alliance | Stormwind"))
}

test "an NPC's first plain line among the first four says what it is; a later one is the body's" {
