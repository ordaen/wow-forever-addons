}

test "an effect's «Spell ID» ticked shows its number" {
  Test::mount(nil, SCREEN)
  choose("Effects", "Spell ID")
  Game::tooltip.main = showing(holyFire())
  Test::pass(SHOWS)
  Test::expect(tip("Holy Fire").text("ID 14914").shown())
}

test "a buff of the player's own is theirs in gold, cancelled with a click, cast by them, with no time when it doesn't end" {
  Game::spells.texture = (id: integer): Art | nil => "Interface/Icons/Spell_Holy_WordFortitude"
