// Items

function axeTip(): Game::TooltipData {
  return {
    kind: 0, id: 9001,
    lines: [
      { left: "Axe of the Deep Woods", kind: NAME_OF_ITEM, quality: EPIC },
      { left: "Soulbound", kind: 20 },
      { left: "Unique", kind: 0 },
      { left: "Two-Hand", right: "Axe", kind: 21, validType: false },
      { left: "216 - 325 Damage", right: "Speed 3,40", kind: 0 },
      { left: "(78.3 damage per second)", kind: 0 },
      { left: "+21 Strength", kind: 0 },
      { left: "+12 Stamina", kind: 0 },
      { left: "+5 Fire Resistance", leftColor: GAME_GREEN, kind: 0 },
      { left: "Durability 20 / 120", kind: 0 },
      { left: "Classes: Warrior, Paladin", leftColor: GAME_RED, kind: 0 },
      { left: "Requires Level 57", kind: REQUIRES, usable: false },
      { left: "Requires Blacksmithing (250)", kind: REQUIRES },
      { left: "Use: Heals you.", kind: 44, spell: 7001 },
      { left: "Chance on hit: Blasts the target.", kind: 46 },
      { left: "Deep Woods (1/3)", kind: 42 },
      { left: "  Helm of the Deep Woods", kind: 42 },
      { left: "(2) Set: +10 Strength", leftColor: GAME_GREEN, kind: 42 },
      { left: "", kind: 1 },
      { kind: 11, price: 51200 }
    ]
  }
}

function axeStats(data: Game::TooltipData): array<Game::ItemStat> {
  if (data.id != 9001) { return [] }
  return [
    { key: "ITEM_MOD_STRENGTH_SHORT", name: "Strength", value: 21 },
    { key: "ITEM_MOD_STAMINA_SHORT", name: "Stamina", value: 12 }
  ]
}

function healingTouch(): Game::TooltipData {
  return {
    kind: 1, id: 7001,
    lines: [{ left: "Healing Touch", kind: NAME_OF_SPELL }, { left: "Instant", kind: 0 }, { left: "Heals you for 100.", kind: DESCRIBED }]
  }
}

test "a weapon reads its band, its level and stats as rows, what it does, and its footer" {
  Game::items.icon = (id: integer): Art | nil => "Interface/Icons/INV_Axe_01"
  Game::items.level = (id: integer): integer | nil => 62
  Game::items.stats = axeStats
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(axeTip())
  Test::pass(SHOWS)
  const axe = tip("Axe of the Deep Woods")
  // Its set beside it, then the axe.
  Test::expect(reads(axe, "Deep Woods (1/3) | Helm of the Deep Woods | (2) Set: +10 Strength | Axe of the Deep Woods | Unique | · | Two-Hand | · | Axe | Soulbound | 216–325 | 3.4/s | 78.3 DPS | Item level | 62 | Strength | +21 | Stamina | +12 | +5 Fire Resistance | Use: Heals you. | Chance on hit: Blasts the target. | Durability | 20 / 120 | Classes | Warrior, Paladin | Requires level | 57 | Blacksmithing | 250 | Sell Price | 5g 12s 0c"))
  Test::expect(inColor(axe.text("Axe of the Deep Woods"), EPIC))
  Test::expect(axe.paintedWith("Interface/Icons/INV_Axe_01"))
  // What the player can't use it as, and what they lack, in red; the stats' bonuses and effects in green.
  Test::expect(inColor(axe.text("Axe"), RED) && inColor(axe.text("Two-Hand"), #cbb994))
  Test::expect(inColor(axe.text("57"), RED) && inColor(axe.text("250"), QUIET_VALUE))
  Test::expect(inColor(axe.text("Warrior, Paladin"), GAME_RED))
  Test::expect(inColor(axe.text("+5 Fire Resistance"), GAME_GREEN))
  Test::expect(inColor(axe.text("Chance on hit: Blasts the target."), GREEN))
  Test::expect(axe.text("216–325").item().box(glyphArt(.Dmg)).shown())
  Test::expect(axe.text("3.4/s").item().box(glyphArt(.Spd)).shown())
}

