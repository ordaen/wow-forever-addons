test "an effect's own lines: a blank one and the time left gone, its description in the body's colour" {
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => burning()
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 7, id: 14914,
    lines: [
      { left: "Holy Fire", kind: 0 }, { left: "---", kind: 1 },
      { left: "Burns for 12 damage every 3 sec.", kind: DESCRIBED }, { left: "8 minutes remaining", kind: 0 }
    ]
  })
  Test::pass(SHOWS)
  const effect = tip("Holy Fire")
  Test::expect(inColor(effect.text("Burns for 12 damage every 3 sec."), BODY))
  Test::expect(!effect.text("---").shown() && !effect.text("8 minutes remaining").shown())
}

test "what an effect will still deal counts the whole ticks left, its stacks as one at least, and nothing of no amount or period" {
  let info: Game::AuraInfo = { ...burning(), stacks: 0, left: 10 }
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => info
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(holyFire())
  Test::pass(SHOWS)
  Test::expect(tip("Holy Fire").text("36 over 10 s").shown())
  info = { ...burning(), stacks: 1, left: 10 }
  Game::tooltip.main = showing({
    kind: 7, id: 1, lines: [{ left: "Ember", kind: 0 }, { left: "Burns for 0 damage every 3 sec.", kind: DESCRIBED }]
  })
  Test::pass(SHOWS)
  Test::expect(!tip("Ember").text("Damage left").shown())
  Game::tooltip.main = showing({
    kind: 7, id: 2, lines: [{ left: "Spark", kind: 0 }, { left: "Burns for 5 damage every 0 sec.", kind: DESCRIBED }]
  })
  Test::pass(SHOWS)
  Test::expect(!tip("Spark").text("Damage left").shown())
}

test "an effect's time is read again as the seconds pass, and a time run out is nought" {
  let left: number = 9
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => ({ ...burning(), left: left })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(holyFire())
  Test::pass(SHOWS)
  Test::expect(tip("Holy Fire").text("9 s").shown())
  left = -2
  Test::pass(1.1)
  Test::expect(tip("Holy Fire").text("0 s").shown())
}

test "an effect that doesn't end waits for no second once it is locked" {
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => ({ ...burning(), left: nil })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(holyFire())
  Test::pass(SHOWS)
  Test::pass(1.3)
  Test::expect(tip("Holy Fire").text("Holy Fire").shown() && Test::idle())
}

test "a disease on a priest names the first of the class's cures the priest knows, in the disease's colour" {
  Game::spells.known = (id: integer): boolean => id == 528
  Game::spells.name = (id: integer): string | nil => id == 528 ? "Cure Disease" : id == 552 ? "Abolish Disease" : nil
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => ({ ...burning(), dispel: "Disease", dispelName: "Disease" })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing(holyFire())
  Test::pass(SHOWS)
  Test::expect(inColor(tip("Holy Fire").text("Disease"), #c89040))
  Test::expect(tip("Holy Fire").text("Cure Disease").shown())
}

test "a class other than a priest names its own cures: a mage's for a curse, a druid's, a paladin's, a shaman's" {
  // The class, what it cures, its spell, the character's number.
  const cures = [
    ["MAGE", "Curse", "475", "11"], ["DRUID", "Poison", "2893", "12"], ["PALADIN", "Disease", "4987", "13"],
    ["SHAMAN", "Poison", "526", "14"]
  ]
  Game::spells.known = (id: integer): boolean => true
  Game::spells.name = (id: integer): string | nil => `Spell ${id}`
  Test::mount(nil, SCREEN)
  for (cure of cures) {
    const tag = cure[1] ?? ""
    const dispel = cure[2] ?? ""
    Test::login(Test::Character { name: tag, guid: `Player-1-000000${cure[4] ?? ""}`, classTag: tag })
    Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => ({ ...burning(), dispel: dispel, dispelName: dispel })
    Game::tooltip.main = showing(holyFire())
    Test::pass(SHOWS)
    Test::expect(tip("Holy Fire").text(`Spell ${cure[3] ?? ""}`).shown() || throw Error { message: tag })
  }
}

test "a shaman purges an enemy's magic buff with its own spell; a warrior names none" {
  Game::spells.known = (id: integer): boolean => true
  Game::spells.name = (id: integer): string | nil => `Spell ${id}`
  Game::auras.shown = (data: Game::TooltipData): Game::AuraInfo | nil => ({
    harmful: false, dispel: "Magic", stacks: 1, own: false, hostile: true
  })
  Test::mount(nil, SCREEN)
  Test::login(Test::Character { name: "Thrall", guid: "Player-1-00000003", classTag: "SHAMAN" })
  Game::tooltip.main = showing({ kind: 7, id: 1243, lines: [{ left: "Power Word: Fortitude", kind: 0 }] })
  Test::pass(SHOWS)
  Test::expect(tip("Power Word: Fortitude").text("Spell 8012").shown())
  Test::login(Test::Character { name: "Garrosh", guid: "Player-1-00000004", classTag: "WARRIOR" })
  Game::tooltip.main = showing({ kind: 7, id: 1243, lines: [{ left: "Power Word: Fortitude", kind: 0 }] })
  Test::pass(SHOWS)
  Test::expect(reads(tip("Power Word: Fortitude"), "Power Word: Fortitude | Buff | · | Magic"))
}

