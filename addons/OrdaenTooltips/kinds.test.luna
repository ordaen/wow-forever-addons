test "a long body scrolls past its most height: the tooltip stands no taller" {
  // A quest's text of sixty lines, each its own line of the body.
  const lines: array<Game::TooltipLine> = mut [{ left: "A Long Errand", kind: 0 }]
  for (n of 1..60) { lines.push({ left: `Step ${n} of the errand`, kind: 0 }) }
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({ kind: 2, lines: lines })
  Test::pass(SHOWS)
  const shown = tip("A Long Errand")
  Test::expect(shown.shown())
  // Sixty lines would stand far past the screen's height; the body holds at its most.
  Test::expect(shown.rect().bottom - shown.rect().top < 700)
}
