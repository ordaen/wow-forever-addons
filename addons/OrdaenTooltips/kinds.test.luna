  Test::pass(SHOWS)
  Test::expect(reads(tip("Linen"), "Linen | In bags | 1 | In the bank | 2 | Stack size | 20"))
  Game::tooltip.main = showing({ kind: 0, id: 9003, lines: [{ left: "Wool", kind: NAME_OF_ITEM }] })
  Test::pass(SHOWS)
  Test::expect(reads(tip("Wool"), "Wool | In bags | 1 | Stack size | 20"))
}

test "what using an item does has no title of its own: under its «Use» tab, what the spell's title says as rows" {
  Game::spells.tooltip = (id: integer): Game::TooltipData | nil => ({
    kind: 1, id: 7002,
    lines: [{ left: "Light Armor Kit", kind: 13 }, { left: "Armor: +24", kind: 0 }, { left: "Lasts 30 min.", kind: 0 }]
  })
  Test::mount(nil, SCREEN)
  Game::tooltip.main = showing({
    kind: 0, id: 2304,
    lines: [{ left: "Light Armor Kit", kind: 22 }, { left: "Use: Permanently increase the armor of an item.", kind: 44, spell: 7002 }]
  })
  Test::pass(SHOWS)
  const group = tip("Use")
  // The kit's name once, the item's; the spell's armour a row, its label on the left.
  Test::expect(group.text("Light Armor Kit").count() == 1)
  Test::expect(group.text("+24").rect().left > group.text("Armor").rect().right)
}

