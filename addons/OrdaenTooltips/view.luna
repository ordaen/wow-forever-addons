// One Ordaen tooltip in place of the game's, and the group round it: the tooltip itself, the ones open beside it
// from the start (a use effect, the set, the item a recipe makes: one column), and the items it is compared with.
//
// Where the group stands is decided by whoever shows it: at a frame of the game's (its owner, or the game's own
// unseen tooltip), above it with the group's bottom edges on the frame's top, or below it with their tops on its
// bottom; on the frame's left edge, or on its right edge with the group running leftwards. The main tooltip is
// always the one at the frame; the others follow it in one row, lined up on the edge that faces the frame, so no
// tooltip floats off it.
import { Align, Edges, Frame, Place, Point } from "$ltml"
import { Component, TooltipGroup } from "Ordaen"
import { GOLD } from "@/colors"
import { TipFrame } from "@/frame"
import { Kind, Model, Opens } from "@/model"
import { Options } from "@/options"
import { term } from "@/term"
import { unitOf } from "@/unit"

const PX = 1 / 1.2
const GAP = 4 * PX
// With a comparison shown the main tooltip sits this much lower, so its title lines up with the worn item's under
// its «Equipped» header.
const LOWERED: Edges = { top: 35 * PX }
const LEVEL: Edges = {}

// Where a group stands by a frame of the game's.
public struct Standing {
  by: any Frame
  // Under the frame; above it otherwise.
  below: Boolean
  // On the frame's right edge, the group running leftwards; on its left edge otherwise.
  right: Boolean
}

// What stands in an opened tooltip's place while it opens nothing.
const NOTHING: Model = {
  kind: Kind.Text, name: "", nameColor: Color.hex("#ffffff"),
  desc: [], info: [], facts: [], body: [], more: [], foot: [], keys: [],
}

// The tooltip a part of a locked tooltip opens. It takes no cursor, and opens nothing further. A unit that is gone
// opens nothing.
class Opened implements Component {
  derived read: Model | nil = self.readNow()
  derived some: Boolean = self.read != nil
  derived model: Model = self.read ?? NOTHING

  opens: Signal<Opens>
  options: Signal<Options>
  constructor(opens: Signal<Opens>, options: Signal<Options>) {
    self.opens = opens
    self.options = options
  }

  readNow(self): Model | nil {
    let opens = self.opens
    match (opens) {
      Opens.Term => return term(opens.term, opens.amount),
      Opens.Text => return {
        kind: Kind.Text, name: opens.name, nameColor: GOLD,
        desc: [], info: [], facts: [], body: [{ left: opens.text, desc: true }], more: [], foot: [], keys: [],
      },
      Opens.Unit => return unitOf(opens.unit, self.options),
      Opens.None => return nil,
    }
  }

  public render(self): Template {
    return $ltml {
      <TipFrame $if={self.some} model={self.model} side={true} />
    }
  }
}

public class TipGroup implements Component {
  derived comparing: Boolean = self.compared.length > 0
  derived hasSides: Boolean = self.sides.length > 0
  derived leftwards: Boolean = self.standing.right
  // Beside the main tooltip, away from it: the column of sides, then the worn items.
  derived sidesFirst: Boolean = self.hasSides && !self.leftwards
  derived sidesLast: Boolean = self.hasSides && self.leftwards
  derived worn: Array<Model> = self.inOrder()
  derived besides: Integer = (self.hasSides ? 1 : 0) + self.compared.length
  derived place: Place = self.at()
  // Every tooltip's edge on the frame's side lined up; compared, their titles are, at the top.
  derived across: Align = self.standing.below || self.comparing ? Align.Start : Align.End
  derived lowered: Edges = self.comparing ? LOWERED : LEVEL

  // A locked group's close button was clicked; the cursor came onto the group, and left it.
  public close: Event<nil> = new Event()
  public enter: Event<nil> = new Event()
  public leave: Event<nil> = new Event()

  model: Signal<Model>
  sides: Signal<Array<Model>>
  compared: Signal<Array<Model>>
  standing: Signal<Standing>
  shown: Signal<Boolean>
  options: Signal<Options>
  locks: Signal<Boolean>
  charge: Signal<Integer>
  locked: Signal<Boolean>
  constructor(
    model: Signal<Model>,
    // The tooltips open beside it from the start, top to bottom.
    sides: Signal<Array<Model>>,
    // The items it is compared with, from the main tooltip outwards.
    compared: Signal<Array<Model>>,
    standing: Signal<Standing>,
    shown: Signal<Boolean>,
    // What the player asked a tooltip to show: a unit a part opens is read with it.
    options: Signal<Options>,
    // The main tooltip's lock: whether it locks at all (its bar's room is kept only then), how far it is charged, of a
    // hundred, and whether it is locked. The group takes the cursor locked or not: what holds the tooltips listens
    // for it always (a listener is bound for good), and tells it always.
    locks: Signal<Boolean> = false,
    charge: Signal<Integer> = 0,
    locked: Signal<Boolean> = false,
  ) {
    self.model = model
    self.sides = sides
    self.compared = compared
    self.standing = standing
    self.shown = shown
    self.options = options
    self.locks = locks
    self.charge = charge
    self.locked = locked
  }

  onClose(mut self) { self.close.emit() }
  // The cursor on the group and off it, locked or not: a group that locks under a cursor already on it is told so.
  onEnter(mut self) { self.enter.emit() }
  onLeave(mut self) { self.leave.emit() }

  // The worn items from the screen's left to its right: away from the main tooltip, which stands at the frame.
  inOrder(self): Array<Model> {
    if (!self.leftwards) { return self.compared }
    let leftwards: Array<Model> = []
    for (i of self.compared.length..=1 step -1) {
      let model = self.compared[i]
      if (model != nil) { leftwards.push(model) }
    }
    return leftwards
  }

  at(self): Place {
    let standing = self.standing
    if (standing.below) {
      return standing.right
        ? { point: Point.TopRight, to: Point.BottomRight, by: standing.by }
        : { point: Point.TopLeft, to: Point.BottomLeft, by: standing.by }
    }
    return standing.right
      ? { point: Point.BottomRight, to: Point.TopRight, by: standing.by }
      : { point: Point.BottomLeft, to: Point.TopLeft, by: standing.by }
  }

  public render(self): Template {
    return $ltml {
      // The library's group: the cursor on any tooltip and on the gaps between them is on the group, the lock's.
      <TooltipGroup shown={self.shown} place={self.place} beside={self.besides} across={self.across}
                    leftwards={self.leftwards} @enter={self.onEnter} @leave={self.onLeave}>
        <box #primary padding={self.lowered}>
          <TipFrame model={self.model} locks={self.locks} charge={self.charge} locked={self.locked} @close={self.onClose}>
            <Opened #opened={opens} opens={opens} options={self.options} />
            // What other modules add, after the main tooltip's body: the group's owner fills it.
            <slot />
          </TipFrame>
        </box>
        // Every tooltip of a locked group opens what its parts name.
        <box #secondary $if={self.sidesFirst} gap={GAP} yAlign={self.across}>
          <TipFrame $for={side of self.sides} model={side} side={true} locked={self.locked}>
            <Opened #opened={opens} opens={opens} options={self.options} />
          </TipFrame>
        </box>
        <TipFrame #secondary $for={model of self.worn} model={model} side={true} locked={self.locked}>
          <Opened #opened={opens} opens={opens} options={self.options} />
        </TipFrame>
        <box #secondary $if={self.sidesLast} gap={GAP} yAlign={self.across}>
          <TipFrame $for={side of self.sides} model={side} side={true} locked={self.locked}>
            <Opened #opened={opens} opens={opens} options={self.options} />
          </TipFrame>
        </box>
      </TooltipGroup>
    }
  }
}
