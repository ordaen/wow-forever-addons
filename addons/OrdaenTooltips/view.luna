// One Ordaen tooltip in place of the game's, and the group round it: the tooltip itself, the ones open beside it
// from the start (a use effect, the set, the item a recipe makes: one column), and the items it is compared with.
//
// Where the group stands is decided by whoever shows it: at a frame of the game's (its owner, or the game's own
// unseen tooltip), above it with the group's bottom edges on the frame's top, or below it with their tops on its
// bottom; on the frame's left edge, or on its right edge with the group running leftwards. The main tooltip is
// always the one at the frame; the others follow it in one row, lined up on the edge that faces the frame, so no
// tooltip floats off it.
import { Align, Edges, Frame, Layer, Place, Point, Position, Track } from "$ltml"
import Ordaen from "Ordaen"
import { TipFrame } from "@/frame"
import { Kind, Model, Opens } from "@/model"
import { term } from "@/term"

private const PX = 1 / 1.2
private const GAP = 4 * PX
// With a comparison shown the main tooltip sits this much lower, so its title lines up with the worn item's under
// its «Equipped» header.
private const LOWERED: Edges = { top: 35 * PX }
private const LEVEL: Edges = {}

// Where a group stands by a frame of the game's.
public struct Standing {
  by: Frame
  // Under the frame; above it otherwise.
  below: boolean
  // On the frame's right edge, the group running leftwards; on its left edge otherwise.
  right: boolean
}

// What a place in the group's row holds.
private enum Slot { Main = "main", Sides = "sides", Compared = "compared" }

private struct Piece {
  slot: Slot
  // The tooltip drawn there; the main one's for the column of sides.
  model: Model
}

// What stands in an opened tooltip's place while it opens nothing.
private const NOTHING: Model = {
  kind: Kind::Text, name: "", nameColor: $color("#ffffff"),
  desc: [], info: [], facts: [], body: [], more: [], foot: [], keys: [],
}

// The tooltip a part of a locked tooltip opens. It takes no cursor, and opens nothing further.
private class Opened implements Ordaen::Component {
  private model = $computed((): Model => self.read())

  $constructor(private opens: Reactive<Opens>) {}

  private read(): Model {
    let opens = self.opens
    switch (opens) {
      case Opens::Term: return term(opens.term, opens.amount)
      case Opens::None: return NOTHING
    }
  }

  public render(): Template {
    return $ltml {
      <TipFrame model={self.model} side={true} />
    }
  }
}

public class TipGroup implements Ordaen::Component {
  private comparing = $computed((): boolean => self.compared.length > 0)
  private pieces = $computed((): Array<Piece> => self.inOrder())
  private columns = $computed((): Array<Track> => self.autos(self.pieces.length))
  private place = $computed((): Place => self.at())
  // Every tooltip's edge on the frame's side lined up; compared, their titles are, at the top.
  private across = $computed((): Align => self.standing.below || self.comparing ? Align::Start : Align::End)
  private lowered = $computed((): Edges => self.comparing ? LOWERED : LEVEL)

  // A locked group: its close button was clicked; the cursor came onto it, and left it.
  public close: Event<nil> = $event()
  public enter: Event<nil> = $event()
  public leave: Event<nil> = $event()

  $constructor(
    private model: Reactive<Model>,
    // The tooltips open beside it from the start, top to bottom.
    private sides: Reactive<Array<Model>>,
    // The items it is compared with, from the main tooltip outwards.
    private compared: Reactive<Array<Model>>,
    private standing: Reactive<Standing>,
    private shown: Reactive<boolean>,
    // The main tooltip's lock: how far it is charged, of a hundred, and whether it is locked. A locked group
    // takes the cursor; one that isn't lets it through to what is under it.
    private charge: Reactive<integer> = 0,
    private locked: Reactive<boolean> = false,
  ) {}

  private mut onClose() { self.close.emit() }
  private mut onEnter() { self.enter.emit() }
  private mut onLeave() { self.leave.emit() }

  // The group's row from the screen's left to its right: the main tooltip at the frame, the rest away from it.
  private inOrder(): Array<Piece> {
    let mut outwards: Array<Piece> = [{ slot: Slot::Main, model: self.model }]
    if (self.sides.length > 0) { outwards.push({ slot: Slot::Sides, model: self.model }) }
    for (model of self.compared) { outwards.push({ slot: Slot::Compared, model: model }) }
    if (!self.standing.right) { return outwards }
    let mut leftwards: Array<Piece> = []
    for (let i = outwards.length; i >= 1; i -= 1) {
      let piece = outwards[i]
      if (piece != nil) { leftwards.push(piece) }
    }
    return leftwards
  }

  private autos(count: integer): Array<Track> {
    let mut list: Array<Track> = []
    for (let i = 1; i <= count; i += 1) { list.push("auto") }
    return list
  }

  private at(): Place {
    let standing = self.standing
    if (standing.below) {
      return standing.right
        ? { point: Point::TopRight, to: Point::BottomRight, by: standing.by }
        : { point: Point::TopLeft, to: Point::BottomLeft, by: standing.by }
    }
    return standing.right
      ? { point: Point::BottomRight, to: Point::TopRight, by: standing.by }
      : { point: Point::BottomLeft, to: Point::TopLeft, by: standing.by }
  }

  public render(): Template {
    return $ltml {
      <surface $if={self.shown} layer={Layer::Tooltip} place={self.place} columns={self.columns} gap={GAP}
               yAlign={self.across}>
        <box $if={self.locked} position={Position::Absolute} left={0} top={0} right={0} bottom={0}
             hoverWithin={true} @enter={self.onEnter} @leave={self.onLeave} />
        <$for={piece of self.pieces}>
          <$switch={piece.slot}>
            <box $case={Slot::Main} padding={self.lowered}>
              <TipFrame model={piece.model} main={true} charge={self.charge} locked={self.locked}
                        @close={self.onClose}>
                <Opened #opened={opens} opens={opens} />
              </TipFrame>
            </box>
            <box $case={Slot::Sides} gap={GAP} yAlign={self.across}>
              <TipFrame $for={side of self.sides} model={side} side={true} />
            </box>
            <TipFrame $case={Slot::Compared} model={piece.model} side={true} />
          </>
        </>
      </surface>
    }
  }
}
