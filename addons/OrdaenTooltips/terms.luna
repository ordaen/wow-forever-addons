// The glossary: the terms a part of a tooltip can name, each with its name and its text in the locales. A
// «%s» in either is the amount the part speaks of.
// Generated by `lunatype generate terms` from the `TERM_` keys of locales/enUS.json: never edited by hand.
import Locale from "@/locales"

public enum Term {
  Dmg = "dmg",
  Fire = "fire",
  Nature = "nature",
  Frost = "frost",
  Shadow = "shadow",
  Arcane = "arcane",
  Holy = "holy",
  Spd = "spd",
  Dps = "dps",
  Arm = "arm",
  Blk = "blk",
  Bag = "bag",
  Bop = "bop",
  Boe = "boe",
  Uni = "uni",
  Bound = "bound",
  Req = "req",
  Prof = "prof",
  Stack = "stack",
  Own = "own",
  Ready = "ready",
  Cls = "cls",
  Dur = "dur",
  Plvl = "plvl",
  Lvlcolor = "lvlcolor",
  Pvp = "pvp",
  Alliance = "alliance",
  Horde = "horde",
  Mana = "mana",
  Energy = "energy",
  Rage = "rage",
  Castnow = "castnow",
  Casttime = "casttime",
  Castchan = "castchan",
  Range = "range",
  Cd = "cd",
  Elite = "elite",
  Rare = "rare",
  Beast = "beast",
  Time = "time",
  Magic = "magic",
  Curse = "curse",
  Poison = "poison",
  Disease = "disease",
  Pclass = "pclass",
  Rank = "rank",
  Guild = "guild",
  Npcdead = "npcdead",
  Status = "status",
  Ptarget = "ptarget",
  Relation = "relation",
  Cancel = "cancel",
  Mine = "mine",
  Caster = "caster",
  Stacks = "stacks",
  Health = "health",
  Focus = "focus",
  Melee = "melee",
  Castnext = "castnext",
  Phys = "phys",
  Combo = "combo",
  Camp = "camp",
  Total = "total",
  Removeby = "removeby",
  Tapped = "tapped",
  Rep = "rep",
  Quest = "quest",
  Pspec = "pspec",
  Pgear = "pgear",
  Lock = "lock",
  Talent = "talent",
}

public struct Entry {
  name: string
  text: string
}

public function glossary(term: Term): Entry {
  switch (term) {
    case Term::Dmg: return { name: Locale::TERM_DMG, text: Locale::TERM_DMG_TEXT }
    case Term::Fire: return { name: Locale::TERM_FIRE, text: Locale::TERM_FIRE_TEXT }
    case Term::Nature: return { name: Locale::TERM_NATURE, text: Locale::TERM_NATURE_TEXT }
    case Term::Frost: return { name: Locale::TERM_FROST, text: Locale::TERM_FROST_TEXT }
    case Term::Shadow: return { name: Locale::TERM_SHADOW, text: Locale::TERM_SHADOW_TEXT }
    case Term::Arcane: return { name: Locale::TERM_ARCANE, text: Locale::TERM_ARCANE_TEXT }
    case Term::Holy: return { name: Locale::TERM_HOLY, text: Locale::TERM_HOLY_TEXT }
    case Term::Spd: return { name: Locale::TERM_SPD, text: Locale::TERM_SPD_TEXT }
    case Term::Dps: return { name: Locale::TERM_DPS, text: Locale::TERM_DPS_TEXT }
    case Term::Arm: return { name: Locale::TERM_ARM, text: Locale::TERM_ARM_TEXT }
    case Term::Blk: return { name: Locale::TERM_BLK, text: Locale::TERM_BLK_TEXT }
    case Term::Bag: return { name: Locale::TERM_BAG, text: Locale::TERM_BAG_TEXT }
    case Term::Bop: return { name: Locale::TERM_BOP, text: Locale::TERM_BOP_TEXT }
    case Term::Boe: return { name: Locale::TERM_BOE, text: Locale::TERM_BOE_TEXT }
    case Term::Uni: return { name: Locale::TERM_UNI, text: Locale::TERM_UNI_TEXT }
    case Term::Bound: return { name: Locale::TERM_BOUND, text: Locale::TERM_BOUND_TEXT }
    case Term::Req: return { name: Locale::TERM_REQ, text: Locale::TERM_REQ_TEXT }
    case Term::Prof: return { name: Locale::TERM_PROF, text: Locale::TERM_PROF_TEXT }
    case Term::Stack: return { name: Locale::TERM_STACK, text: Locale::TERM_STACK_TEXT }
    case Term::Own: return { name: Locale::TERM_OWN, text: Locale::TERM_OWN_TEXT }
    case Term::Ready: return { name: Locale::TERM_READY, text: Locale::TERM_READY_TEXT }
    case Term::Cls: return { name: Locale::TERM_CLS, text: Locale::TERM_CLS_TEXT }
    case Term::Dur: return { name: Locale::TERM_DUR, text: Locale::TERM_DUR_TEXT }
