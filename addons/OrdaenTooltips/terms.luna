    case Term::Guild: return { name: Locale::TERM_GUILD, text: Locale::TERM_GUILD_TEXT }
    case Term::Npcdead: return { name: Locale::TERM_NPCDEAD, text: Locale::TERM_NPCDEAD_TEXT }
    case Term::Status: return { name: Locale::TERM_STATUS, text: Locale::TERM_STATUS_TEXT }
    case Term::Ptarget: return { name: Locale::TERM_PTARGET, text: Locale::TERM_PTARGET_TEXT }
    case Term::Relation: return { name: Locale::TERM_RELATION, text: Locale::TERM_RELATION_TEXT }
    case Term::Cancel: return { name: Locale::TERM_CANCEL, text: Locale::TERM_CANCEL_TEXT }
    case Term::Mine: return { name: Locale::TERM_MINE, text: Locale::TERM_MINE_TEXT }
    case Term::Caster: return { name: Locale::TERM_CASTER, text: Locale::TERM_CASTER_TEXT }
    case Term::Stacks: return { name: Locale::TERM_STACKS, text: Locale::TERM_STACKS_TEXT }
    case Term::Health: return { name: Locale::TERM_HEALTH, text: Locale::TERM_HEALTH_TEXT }
    case Term::Focus: return { name: Locale::TERM_FOCUS, text: Locale::TERM_FOCUS_TEXT }
    case Term::Melee: return { name: Locale::TERM_MELEE, text: Locale::TERM_MELEE_TEXT }
    case Term::Castnext: return { name: Locale::TERM_CASTNEXT, text: Locale::TERM_CASTNEXT_TEXT }
    case Term::Phys: return { name: Locale::TERM_PHYS, text: Locale::TERM_PHYS_TEXT }
    case Term::Combo: return { name: Locale::TERM_COMBO, text: Locale::TERM_COMBO_TEXT }
    case Term::Camp: return { name: Locale::TERM_CAMP, text: Locale::TERM_CAMP_TEXT }
    case Term::Total: return { name: Locale::TERM_TOTAL, text: Locale::TERM_TOTAL_TEXT }
    case Term::Removeby: return { name: Locale::TERM_REMOVEBY, text: Locale::TERM_REMOVEBY_TEXT }
    case Term::Tapped: return { name: Locale::TERM_TAPPED, text: Locale::TERM_TAPPED_TEXT }
    case Term::Rep: return { name: Locale::TERM_REP, text: Locale::TERM_REP_TEXT }
    case Term::Quest: return { name: Locale::TERM_QUEST, text: Locale::TERM_QUEST_TEXT }
    case Term::Pspec: return { name: Locale::TERM_PSPEC, text: Locale::TERM_PSPEC_TEXT }
    case Term::Pgear: return { name: Locale::TERM_PGEAR, text: Locale::TERM_PGEAR_TEXT }
