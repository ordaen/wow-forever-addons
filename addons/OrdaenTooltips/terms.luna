    case Term::Alliance: return { name: Locale::TERM_ALLIANCE, text: Locale::TERM_ALLIANCE_TEXT }
    case Term::Horde: return { name: Locale::TERM_HORDE, text: Locale::TERM_HORDE_TEXT }
    case Term::Mana: return { name: Locale::TERM_MANA, text: Locale::TERM_MANA_TEXT }
    case Term::Energy: return { name: Locale::TERM_ENERGY, text: Locale::TERM_ENERGY_TEXT }
    case Term::Rage: return { name: Locale::TERM_RAGE, text: Locale::TERM_RAGE_TEXT }
    case Term::Castnow: return { name: Locale::TERM_CASTNOW, text: Locale::TERM_CASTNOW_TEXT }
    case Term::Casttime: return { name: Locale::TERM_CASTTIME, text: Locale::TERM_CASTTIME_TEXT }
    case Term::Castchan: return { name: Locale::TERM_CASTCHAN, text: Locale::TERM_CASTCHAN_TEXT }
    case Term::Range: return { name: Locale::TERM_RANGE, text: Locale::TERM_RANGE_TEXT }
    case Term::Cd: return { name: Locale::TERM_CD, text: Locale::TERM_CD_TEXT }
    case Term::Elite: return { name: Locale::TERM_ELITE, text: Locale::TERM_ELITE_TEXT }
    case Term::Rare: return { name: Locale::TERM_RARE, text: Locale::TERM_RARE_TEXT }
    case Term::Beast: return { name: Locale::TERM_BEAST, text: Locale::TERM_BEAST_TEXT }
    case Term::Time: return { name: Locale::TERM_TIME, text: Locale::TERM_TIME_TEXT }
    case Term::Magic: return { name: Locale::TERM_MAGIC, text: Locale::TERM_MAGIC_TEXT }
    case Term::Curse: return { name: Locale::TERM_CURSE, text: Locale::TERM_CURSE_TEXT }
    case Term::Poison: return { name: Locale::TERM_POISON, text: Locale::TERM_POISON_TEXT }
    case Term::Disease: return { name: Locale::TERM_DISEASE, text: Locale::TERM_DISEASE_TEXT }
    case Term::Pclass: return { name: Locale::TERM_PCLASS, text: Locale::TERM_PCLASS_TEXT }
