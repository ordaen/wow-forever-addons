// The glossary: the terms a part of a tooltip can name, each with its name and its text in the locales. A
// «%s» in either is the amount the part speaks of.
// Generated by `lunatype generate terms` from the `TERM_` keys of locales/enUS.json: never edited by hand.
import Locale from "@/locales"

public enum Term {
  Dmg = "dmg",
  Fire = "fire",
  Nature = "nature",
  Frost = "frost",
  Shadow = "shadow",
  Arcane = "arcane",
  Holy = "holy",
  Spd = "spd",
  Dps = "dps",
  Arm = "arm",
  Blk = "blk",
  Bag = "bag",
  Bop = "bop",
  Boe = "boe",
  Uni = "uni",
  Bound = "bound",
  Req = "req",
  Prof = "prof",
  Stack = "stack",
  Own = "own",
  Ready = "ready",
  Cls = "cls",
  Dur = "dur",
  Plvl = "plvl",
  Lvlcolor = "lvlcolor",
  Pvp = "pvp",
  Alliance = "alliance",
  Horde = "horde",
  Mana = "mana",
  Energy = "energy",
  Rage = "rage",
  Castnow = "castnow",
  Casttime = "casttime",
  Castchan = "castchan",
  Range = "range",
  Cd = "cd",
  Elite = "elite",
  Rare = "rare",
  Beast = "beast",
  Time = "time",
  Magic = "magic",
  Curse = "curse",
  Poison = "poison",
  Disease = "disease",
  Pclass = "pclass",
  Rank = "rank",
  Guild = "guild",
  Npcdead = "npcdead",
  Status = "status",
  Ptarget = "ptarget",
  Relation = "relation",
  Cancel = "cancel",
  Mine = "mine",
  Caster = "caster",
  Stacks = "stacks",
  Health = "health",
  Focus = "focus",
  Melee = "melee",
  Castnext = "castnext",
  Phys = "phys",
  Combo = "combo",
  Camp = "camp",
  Total = "total",
  Removeby = "removeby",
  Tapped = "tapped",
  Rep = "rep",
  Quest = "quest",
  Pspec = "pspec",
  Pgear = "pgear",
  Lock = "lock",
  Talent = "talent",
}

public struct Entry {
  name: String
  text: String
}

public function glossary(term: Term): Entry {
  return match (term) {
    Term.Dmg => { name: Locale.TERM_DMG, text: Locale.TERM_DMG_TEXT },
    Term.Fire => { name: Locale.TERM_FIRE, text: Locale.TERM_FIRE_TEXT },
