// A spell's tooltip, read from the game's lines for it: the name with its rank and its spellbook tab, the band of
// facts in the design's short form (the cost as a dot in its resource's colour and the number, the range, the cast,
// the cooldown as «CD 10 sec»), the description with a finishing move's list as rows, what it needs in the footer.
import Game from "$game"
import { Art, Color } from "$ltml"
import Math from "$math"
import String from "$string"
import { RED, WHITE, YELLOW, colorOf } from "@/colors"
import Locale from "@/locales"
import { Fact, Kind, Model, Note, Opens, Part, TextLine, iconOf, named } from "@/model"
import { Term } from "@/terms"
import { Options } from "@/options"
import { clean, duration, form, labelled } from "@/text"

// The game's numbers for what a line of a tooltip is.
private const BLANK = 1
private const SPELL_NAME = 13
private const PASSIVE = 33
private const DESCRIPTION = 34
private const REQUIREMENT = 43

// What follows a label's colon («Cooldown: 10 sec» is «10 sec»), or the text.
private function valueOf(text: string): string {
  return $match(text, "^[^:]+:%s*(.+)$") ?? text
}

// «%d points», in the form the number takes: the Russian rule on a Russian client, one and the rest elsewhere.
private function combo(points: integer): string {
  let which = Game::Client::locale == "ruRU" ? form(points) : (points == 1 ? 1 : 3)
  switch (which) {
    case 1: return String::format(Locale::COMBO_ONE, points)
    case 2: return String::format(Locale::COMBO_FEW, points)
    default: return String::format(Locale::COMBO_MANY, points)
  }
}

// The spell's reagents («Reagents: Rune of Teleportation, Powder (2)») as footer rows: the reagent, how many it
// takes, red where the player carries fewer. Whether the line was the reagents'.
private function reagents(text: string, mut foot: Array<Note>): boolean {
  let parts = String::unformat(text, Game::Strings::spellReagents)
  if (parts == nil) { return false }
  let list = parts[1]
  if (list == nil) { return false }
  for (part of String::split(list, ",")) {
    let counted, count = $match(part, "^%s*(.-)%s*%((%d+)%)%s*$")
    let name = counted ?? $match(part, "^%s*(.-)%s*$") ?? ""
    let need = Math::floor(String::toNumber(count ?? "") ?? 1)
    if (name != "") {
      let have = Game::Items::count(name)
      foot.push({ left: name, right: String::format(Locale::COUNT, need), valueColor: have < need ? RED : nil })
    }
  }
  return true
}

// What a line of a finishing move's list gives: the range it names («46-66», «46 – 66») as «46–66», or its first
// number.
private function comboValue(effect: string): string | nil {
  let low, high = $match(effect, "(%d+)%s*%-%s*(%d+)")
  if (low != nil && high != nil) { return low + "–" + high }
  let from, to = $match(effect, "(%d+)%s*–%s*(%d+)")
  if (from != nil && to != nil) { return from + "–" + to }
  return $match(effect, "%d+")
}

// A description into the body. A finishing move's («1 point: 46-66 damage» on a line each) gives its sentence
// first and then a row for each line of the list.
private function describe(text: string, mut body: Array<TextLine>) {
  if ($match(text, "^%s*%d%s") == nil && $match(text, "\n%s*%d%s") == nil) {
    body.push({ left: text, desc: true })
    return
  }
  let mut rows: Array<TextLine> = []
  let first: string | nil = nil
  let rest: string | nil = nil
  for (line of String::split(text, "\n")) {
    if (line == "") { continue }
    let points, effect = $match(line, "^%s*(%d)%s+[^%d:]-:%s*(.+)$")
    let value = effect != nil ? comboValue(effect) : nil
    if (points != nil && value != nil) {
      rows.push({
        left: combo(Math::floor(String::toNumber(points) ?? 0)), right: value, opens: named(Term::Combo),
      })
    } else if (first == nil) {
      first = line
    } else {
      rest = (rest ?? first) + "\n" + line
    }
  }
  if (first != nil) { body.push({ left: rest ?? first, desc: true }) }
  for (row of rows) { body.push(row) }
}

// A cell of the band from one side of one of the spell's first lines. `first`: the line is the band's first, where
// the cost and the range stand; `right`: the line's right side; `cast`: its left side was the cast, so this is the
// cooldown. Whether this side was the cast.
private function cell(
  text: string, first: boolean, right: boolean, cost: Game::SpellCost | nil, cast: boolean, mut facts: Array<Fact>,
): boolean {
  let glyph: Art | nil = nil
  let tint: Color | nil = nil
  let shown = text
  let isCast = false
  let opens: Opens = Opens::None
  let digits = $match(text, "%d[%d%s\194\160]*")
  if (text == Game::Strings::castInstant || text == Game::Strings::castInstantNoMana) {
    shown = Locale::CAST_INSTANT
    glyph = "glyphs/castNow"
    opens = named(Term::Castnow)
    isCast = true
  } else if (String::contains(text, Game::Strings::castChanneled)) {
    glyph = "glyphs/castChan"
    opens = named(Term::Castchan)
    isCast = true
  } else if (String::unformat(text, Game::Strings::castTimeSec) != nil
      || String::unformat(text, Game::Strings::castTimeMin) != nil) {
    glyph = "glyphs/castTime"
    opens = named(Term::Casttime)
    isCast = true
  } else if (text == Game::Strings::onNextSwing || text == Game::Strings::onNextRanged) {
    shown = Locale::CAST_NEXT
    glyph = "glyphs/castNext"
    opens = named(Term::Castnext)
    isCast = true
  } else if (!right && first && cost != nil && digits != nil
      && String::toNumber($replace(digits, "%D", "")) == cost.amount) {
    // The cost: a dot in its resource's colour and the number.
    glyph = "glyphs/cost"
    tint = cost.color
    shown = $replace(digits, "%s+$", "")
  } else if (right && cast) {
    if (digits != nil) {
      shown = "CD " + valueOf(text)
      opens = named(Term::Cd)
    }
  } else if (first) {
    // The range, beside the cost or alone: its value only, the closing full stop dropped.
    if (text == Game::Strings::meleeRange || text == Locale::MELEE_RANGE_TEXT) {
      shown = Locale::MELEE_RANGE_SHORT
      opens = named(Term::Melee)
    } else {
      shown = $replace(valueOf(text), "%.$", "")
      opens = named(Term::Range)
    }
  }
  facts.push({ text: shown, glyph: glyph, tint: tint, opens: opens })
  return isCast
}

public function spell(data: Game::TooltipData, options: Options): Model | nil {
  let id = data.id
  let cost = id != nil ? Game::Spells::cost(id) : nil
  let name: string | nil = nil
  let mut desc: Array<Part> = []
  let mut info: Array<Part> = []
  let mut facts: Array<Fact> = []
  let mut body: Array<TextLine> = []
  let mut foot: Array<Note> = []
  // The band's lines read so far.
  let band = 0
  for (i, line of data.lines) {
    let left = clean(line.left)
    let right = clean(line.right)
    if (line.kind == SPELL_NAME && name == nil) {
      name = left
      // The rank, then the spellbook's tab.
      if (right != nil) { desc.push({ text: right }) }
      let tab = id != nil ? Game::Spells::tab(id) : nil
      if (tab != nil) { desc.push({ text: tab }) }
    } else if (line.kind == REQUIREMENT) {
      if (left != nil) {
        let label, value = labelled(left)
        foot.push({ left: label, right: value, valueColor: line.usable == false ? RED : nil })
      }
    } else if (line.kind == DESCRIPTION) {
      if (left != nil) { describe(left, mut body) }
    } else if (line.kind == PASSIVE) {
      if (left != nil) { desc.push({ text: left }) }
    } else if (line.kind != BLANK && left != nil) {
      // Cost and range, cast and cooldown: the game's two-sided lines, cells of the band.
      if (right != nil) {
        band += 1
        let cast = cell(left, band == 1, false, cost, false, mut facts)
        _ = cell(right, band == 1, true, cost, cast, mut facts)
      } else if (!reagents(left, mut foot)) {
        if (i <= 4 && body.length == 0) {
          band += 1
          _ = cell(left, band == 1, false, cost, false, mut facts)
        } else {
          body.push({ left: left, color: colorOf(line.leftColor) })
        }
      }
    }
  }
  let timer = false
  if (id != nil && options.spellsCooldown) {
    let left = Game::Spells::cooldown(id)
    if (left != nil) {
      let wait = duration(left, Game::Strings::hours, Game::Strings::minutes, Game::Strings::seconds)
      foot.push({ left: Locale::READY_IN, right: wait, valueColor: YELLOW, opens: named(Term::Ready) })
      timer = true
    }
  }
  if (id != nil && options.spellsId) { info.push({ text: `ID ${id}` }) }
  if (name == nil) { return nil }
  return {
    kind: Kind::Spell, picture: iconOf(id != nil ? Game::Spells::texture(id) : nil), name: name, nameColor: WHITE,
    desc: desc, info: info, facts: facts, body: body, more: [], foot: foot, keys: [], timer: timer,
  }
}
