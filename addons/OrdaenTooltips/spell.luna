// A spell's tooltip, read from the game's lines for it: the name with its rank and its spellbook tab, the band of
// facts in the design's short form (the cost as a dot in its resource's colour and the number, the range, the cast,
// the cooldown as «CD 10 sec»), the description with a finishing move's list as rows, what it needs in the footer.
import Client from "$client"
import Game from "$game"
import Runtime from "$runtime"
import { BRIGHT_TEXT } from "Ordaen"
import { RED, YELLOW, colorOf } from "@/colors"
import Locale from "@/locales"
import { Fact, Glyph, Kind, Model, Note, Opens, Part, TextLine, iconOf, named } from "@/model"
import { Options } from "@/options"
import { Term } from "@/terms"
import { clean, duration, form, labelled } from "@/text"

// The game's numbers for what a line of a tooltip is.
const BLANK = 1
const SPELL_NAME = 13
const PASSIVE = 33
const DESCRIPTION = 34
const REQUIREMENT = 43
// The description's colours (the design's Tooltip.vue): numbers, the damage schools, a spell's name.
const NUMBER = "ffffff"
const PHYSICAL = "e0c9a0"
const FIRE = "ff8a3c"
const NATURE = "6ed04a"
const FROST = "8fd2ff"
const SHADOW = "b48ae8"
const ARCANE = "e48af0"
const HOLY = "ffe680"
const SPELL_NAME_COLOR = "ffd100"
// Before the lines of the item a recipe makes: from it on they are that item's own tooltip.
const NESTED = 19

// What follows a label's colon («Cooldown: 10 sec» is «10 sec»), or the text.
function valueOf(text: String): String {
  return text.match("^[^:]+:%s*(.+)$") ?? text
}

// «%d points», in the form the number takes: the Russian rule on a Russian client, one and the rest elsewhere.
function combo(points: Integer): String {
  let which = Game.client.locale == "ruRU" ? form(points) : (points == 1 ? 1 : 3)
  match (which) {
    1 => return Locale.COMBO_ONE.format(points)
    2 => return Locale.COMBO_FEW.format(points)
    else => return Locale.COMBO_MANY.format(points)
  }
}

// The word of a label the game writes before a list («Reagents: %s», «Материалы: |n», «Инструменты:»).
function wordOf(label: String): String {
  return label.match("^%s*([^:|%%]-)%s*:") ?? ""
}

// The list after `word:` in a line, its colour codes and line breaks taken out; nothing for a line of another label.
function listAfter(text: String, word: String): String | nil {
  let label, rest = text.match("^%s*([^:]-)%s*:(.*)$")
  if (word == "" || label != word || rest == nil) { return nil }
  let bare = rest.replace("|n", " ").replace("|c%x%x%x%x%x%x%x%x", "").replace("|r", "")
  return bare.match("^%s*(.-)%s*$")
}

// The spell's reagents («Reagents: Rune of Teleportation, Powder (2)») as footer rows: the reagent, how many it
// takes, red where the player carries fewer. Whether the line was the reagents'.
function reagents(text: String, foot: mut Array<Note>): Boolean {
  let list = listAfter(text, wordOf(Game.strings.spellReagents))
  if (list == nil) { return false }
  for (part of list.split(",")) {
    let counted, count = part.match("^%s*(.-)%s*%((%d+)%)%s*$")
    let name = counted ?? part.match("^%s*(.-)%s*$") ?? ""
    let need = ((count ?? "").toNumber() ?? 1).floor()
    if (name != "") {
      let have = Game.items.count(name)
      // The reagent by its name, as the client knows it: its icon, and its own tooltip from a locked one.
      let id, _, _, _, icon, _, _ = Client.C_Item.GetItemInfoInstant(name)
      foot.push({
        left: name, right: Locale.COUNT.format(need), valueColor: have < need ? RED : nil, icon: icon,
        opens: id != nil ? Opens.Item { id: id.floor() } : Opens.None
      })
    }
  }
  return true
}

// The tools a recipe needs («Tools: Runed Copper Rod») as one footer row, red where the player carries one of them
// not. Whether the line was the tools'.
function tools(text: String, foot: mut Array<Note>): Boolean {
  let word = wordOf(Runtime.text("SPELL_TOTEMS") ?? "")
  let list = listAfter(text, word)
  if (list == nil) { return false }
  let missing = list.split(",").any(name => Game.items.count(name.match("^%s*(.-)%s*$") ?? name) == 0)
  foot.push({ left: word, right: list, valueColor: missing ? RED : nil })
  return true
}

// The item a recipe makes, as a tooltip of its own: the game's own for it where the line before its lines names it,
// else its lines as the recipe's tooltip gives them (its name's line without the line break the game puts first).
public function madeBy(data: Game.TooltipData): Game.TooltipData | nil {
  let at = 0
  for (i, line of data.lines) {
    if (line.kind == NESTED && at == 0) { at = i }
  }
  let marker = data.lines[at]
  if (marker == nil) { return nil }
  let made = marker.made
  if (made != nil) {
    let own = Game.items.tooltip(made)
    if (own != nil) { return own }
  }
  let lines: Array<Game.TooltipLine> = []
  for (i, line of data.lines) {
    if (i > at) { lines.push(Game.TooltipLine { left: line.left?.match("^%s*(.-)$"), ..line }) }
  }
  if (lines.length == 0) { return nil }
  return { kind: 0, id: made, lines: lines }
}

// What a line of a finishing move's list gives: the range it names («46-66», «46 – 66») as «46–66», or its first
// number.
function comboValue(effect: String): String | nil {
  let low, high = effect.match("(%d+)%s*%-%s*(%d+)")
  if (low != nil && high != nil) { return low + "–" + high }
  let from, to = effect.match("(%d+)%s*–%s*(%d+)")
  if (from != nil && to != nil) { return from + "–" + to }
  return effect.match("%d+")
}

// A colour as the game's text codes write it: «|cffffffff».
function code(color: String): String { return "|cff" + color }

// A number lit, a full stop or a comma after it left as it was.
function litNumber(number: String): String {
  const digits, tail = number.match("^(.-)([,%.]*)$")
  return digits == nil || digits == "" ? number : code(NUMBER) + digits + "|r" + (tail ?? "")
}

// A description as the design draws it: its numbers white, a damage school in its colour, a spell's name in «» gold.
// A text the game coloured itself is left as it is.
public function rich(text: String): String {
  if (text.contains("|c")) { return text }
  let lit = text.replace("(%d[%d,%.]*%%?)", number => litNumber(number))
  lit = lit.replace("(физическ[^%s]* урон[^%s,%.]*)", school => code(PHYSICAL) + school + "|r")
  lit = lit.replace("([Pp]hysical damage)", school => code(PHYSICAL) + school + "|r")
  lit = lit.replace("(урон[^%s]* от огня)", school => code(FIRE) + school + "|r")
  lit = lit.replace("([Ff]ire damage)", school => code(FIRE) + school + "|r")
  lit = lit.replace("(урон[^%s]* от сил природы)", school => code(NATURE) + school + "|r")
  lit = lit.replace("([Nn]ature damage)", school => code(NATURE) + school + "|r")
  lit = lit.replace("(урон[^%s]* от магии льда)", school => code(FROST) + school + "|r")
  lit = lit.replace("([Ff]rost damage)", school => code(FROST) + school + "|r")
  lit = lit.replace("(урон[^%s]* от т[^%s]-мной магии)", school => code(SHADOW) + school + "|r")
  lit = lit.replace("([Ss]hadow damage)", school => code(SHADOW) + school + "|r")
  lit = lit.replace("(урон[^%s]* от тайной магии)", school => code(ARCANE) + school + "|r")
  lit = lit.replace("([Aa]rcane damage)", school => code(ARCANE) + school + "|r")
  lit = lit.replace("(урон[^%s]* от светлой магии)", school => code(HOLY) + school + "|r")
  lit = lit.replace("([Hh]oly damage)", school => code(HOLY) + school + "|r")
  return lit.replace("«([^»]+)»", name => "«" + code(SPELL_NAME_COLOR) + name + "|r»")
}

// A description into the body. A finishing move's («1 point: 46-66 damage» on a line each) gives its sentence
// first and then a row for each line of the list.
function describe(text: String, body: mut Array<TextLine>) {
  if (text.match("^%s*%d%s") == nil && text.match("\n%s*%d%s") == nil) {
    body.push({ left: rich(text), desc: true })
    return
  }
  let rows: Array<TextLine> = []
  let first: String | nil = nil
  let rest: String | nil = nil
  for (line of text.split("\n")) {
    if (line == "") { continue }
    let points, effect = line.match("^%s*(%d)%s+[^%d:]-:%s*(.+)$")
    let value = effect != nil ? comboValue(effect) : nil
    if (points != nil && value != nil) {
      rows.push({
        left: combo((points.toNumber() ?? 0).floor()), right: value, opens: named(Term.Combo)
      })
    } else if (first == nil) {
      first = line
    } else {
      rest = (rest ?? first) + "\n" + line
    }
  }
  if (first != nil) { body.push({ left: rich(rest ?? first), desc: true }) }
  for (row of rows) { body.push(row) }
}

// A number as the game wrote it in a line («1,5», «2.5»).
function digitsOf(text: String): String { return text.match("%d+[,%.]?%d*") ?? "" }

// How long a channelled spell lasts, as its description says it («over 5 sec.», «в течение 5 сек.»), else its first
// time in seconds; nothing where it says none.
function channelOf(description: String): String | nil {
  const seconds = description.match("в течение (%d+[,%.]?%d*)%s*сек") ?? description.match("over (%d+[,%.]?%d*)%s*sec") ??
    description.match("(%d+[,%.]?%d*)%s*сек") ?? description.match("(%d+[,%.]?%d*)%s*sec")
  return seconds == nil ? nil : Locale.CAST_SECONDS.format(seconds)
}

// A cell of the band from one side of one of the spell's first lines. `first`: the line is the band's first, where
// the cost and the range stand; `right`: the line's right side; `cast`: its left side was the cast, so this is the
// cooldown; `channel`: how long the spell is channelled, where it is. Whether this side was the cast.
function cell(
  text: String, first: Boolean, right: Boolean, cost: Game.SpellCost | nil, cast: Boolean, channel: String | nil,
  facts: mut Array<Fact>
): Boolean {
  let glyph: Glyph | nil = nil
  let tint: Color | nil = nil
  let shown = text
  let isCast = false
  let opens: Opens = Opens.None
  let digits = text.match("%d[%d%s\194\160]*")
  if (text == Game.strings.castInstant || text == Game.strings.castInstantNoMana) {
    shown = Locale.CAST_INSTANT
    glyph = .CastNow
    opens = named(Term.Castnow)
    isCast = true
  } else if (text.contains(Game.strings.castChanneled)) {
    // The glyph says it is channelled; the cell says for how long, as the description has it (the game's word where
    // it says no time).
    shown = channel ?? text
    glyph = .CastChan
    opens = named(Term.Castchan)
    isCast = true
  } else if (text.unformat(Game.strings.castTimeSec) != nil) {
    shown = Locale.CAST_SECONDS.format(digitsOf(text))
    glyph = .CastTime
    opens = named(Term.Casttime)
    isCast = true
  } else if (text.unformat(Game.strings.castTimeMin) != nil) {
    shown = Locale.CAST_MINUTES.format(digitsOf(text))
    glyph = .CastTime
    opens = named(Term.Casttime)
    isCast = true
  } else if (text == Game.strings.onNextSwing || text == Game.strings.onNextRanged) {
    shown = Locale.CAST_NEXT
    glyph = .CastNext
    opens = named(Term.Castnext)
    isCast = true
  } else if (!right && first && cost != nil && digits != nil &&
      (digits.replace("%D", "")).toNumber() == cost.amount) {
    // The cost: a dot in its resource's colour and the number.
    glyph = .Cost
    tint = cost.color
    shown = digits.replace("%s+$", "")
  } else if (right && cast) {
    if (digits != nil) {
      shown = "CD " + valueOf(text)
      opens = named(Term.Cd)
    }
  } else if (first) {
    // The range, beside the cost or alone: its value only, the closing full stop dropped.
    if (text == Game.strings.meleeRange || text == Locale.MELEE_RANGE_TEXT) {
      shown = Locale.MELEE_RANGE_SHORT
      opens = named(Term.Melee)
    } else {
      shown = valueOf(text).replace("%.$", "")
      opens = named(Term.Range)
    }
  }
  facts.push({ text: shown, glyph: glyph, tint: tint, opens: opens })
  return isCast
}

public function spell(data: Game.TooltipData, options: Options): Model | nil {
  let id = data.id
  let cost = id != nil ? Game.spells.cost(id) : nil
  let name: String | nil = nil
  let desc: Array<Part> = []
  let info: Array<Part> = []
  let facts: Array<Fact> = []
  let body: Array<TextLine> = []
  let foot: Array<Note> = []
  // The band's lines read so far.
  let band = 0
  let description = ""
  for (line of data.lines) {
    if (line.kind == DESCRIPTION) { description = description + (line.left ?? "") }
  }
  const channel = channelOf(description)
  for (i, line of data.lines) {
    // A recipe's made item: a tooltip of its own beside this one (`madeBy`).
    if (line.kind == NESTED) { break }
    let left = clean(line.left)
    let right = clean(line.right)
    if (line.kind == SPELL_NAME && name == nil) {
      name = left
      // The rank, then the spellbook's tab.
      const rank = right ?? (id != nil ? clean(Client.C_Spell.GetSpellSubtext(id)) : nil)
      if (rank != nil) { desc.push({ text: rank }) }
      let tab = id != nil ? Game.spells.tab(id) : nil
      if (tab != nil) { desc.push({ text: tab }) }
    } else if (line.kind == REQUIREMENT) {
      if (left != nil) {
        let label, value = labelled(left)
        foot.push({ left: label, right: value, valueColor: line.usable == false ? RED : nil })
      }
    } else if (line.kind == DESCRIPTION) {
      if (left != nil) { describe(left, mut body) }
    } else if (line.kind == PASSIVE) {
      if (left != nil) { desc.push({ text: left }) }
    } else if (line.kind != BLANK && left != nil) {
      // Cost and range, cast and cooldown: the game's two-sided lines, cells of the band.
      if (right != nil) {
        band += 1
        let cast = cell(left, band == 1, false, cost, false, channel, mut facts)
        _ = cell(right, band == 1, true, cost, cast, channel, mut facts)
      } else if (!reagents(left, mut foot) && !tools(left, mut foot)) {
        if (i <= 4 && body.length == 0) {
          band += 1
          _ = cell(left, band == 1, false, cost, false, channel, mut facts)
        } else {
          body.push({ left: left, color: colorOf(line.leftColor) })
        }
      }
    }
  }
  let timer = false
  if (id != nil && options.spellsCooldown) {
    let left = Game.spells.cooldown(id)
    if (left != nil) {
      let wait = duration(left, Game.strings.hours, Game.strings.minutes, Game.strings.seconds)
      foot.push({ left: Locale.READY_IN, right: wait, valueColor: YELLOW, opens: named(Term.Ready) })
      timer = true
    }
  }
  if (id != nil && options.spellsId) { info.push({ text: `ID ${id}` }) }
  if (name == nil) { return nil }
  return {
    kind: Kind.Spell, picture: iconOf(id != nil ? Game.spells.texture(id) : nil), name: name, nameColor: BRIGHT_TEXT,
    desc: desc, info: info, facts: facts, body: body, more: [], foot: foot, keys: [], timer: timer
  }
}
