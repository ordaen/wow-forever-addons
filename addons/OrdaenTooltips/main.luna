// Ordaen Tooltips: every tooltip in the one Ordaen skeleton, in place of the game's. The game's tooltip keeps its
// content and its owner, so every addon that fills it works as before: for a show drawn here the game's own is kept
// unseen, and this module draws its group where the tooltip belongs. Each kind of tooltip has its switch: off, that
// kind stays the game's, unchanged. The tooltip a link pins (a link clicked in chat) is drawn here too, where the
// game's stands: locked from the start, closed by its button or Escape, dragged by the player, compared on Shift.
import Events from "$events"
import Game from "$game"
import { Hang, Point } from "$ltml"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, Module, Settings, SettingsPage } from "Ordaen"
import { AddedToItem, AddedToObject } from "@/added"
import { extras } from "@/buttons"
import { Choices, Delay, KindDelay, KindPlace, Place, delaySeconds } from "@/choices"
import { GREEN, RED } from "@/colors"
import { CreatureQuests, ItemKeys, ItemLines, ObjectLines, Offered, Wanted } from "@/extend"
import { compare, item } from "@/item"
import Locale from "@/locales"
import { Kind, Model, Note } from "@/model"
import { Options } from "@/options"
import { questRows } from "@/quests"
import { group, kindOf } from "@/read"
import { AurasPage, GeneralPage, ItemsPage, NpcsPage, ObjectsPage, PlayersPage, SpellsPage, TextsPage } from "@/settings"
import { creatureOf } from "@/unit"
import { Standing, TipGroup } from "@/view"

// The game's number for the line a unit's name stands on.
const UNIT_NAME = 2

// The lock: a tooltip held under the cursor charges, then locks, and stays for the cursor to come onto it. The
// charge starts `DELAY` seconds into the show (a passing cursor sees no bar) and takes `CHARGE` seconds, in
// `STEPS`. A locked group goes `GRACE` seconds after the cursor went onto anything but the group and its source,
// unless it came back to either; onto another thing with a tooltip, at once; a press of the mouse anywhere but on the
// group (its tooltips, a term it opened), at once, the press still going to what it was on. The game hides and
// shows a button's tooltip again as it refreshes it: only a hide longer than `REFRESH` is the cursor leaving.
const DELAY = 0.18
const CHARGE = 1
const STEPS = 100
const GRACE = 0.22
const REFRESH = 0.1

// Beside what it explains: its top left on the row's or the button's top right.
const BY_THE_RIGHT: Hang = { point: Point::TopLeft, to: Point::TopRight }

// What the game's tooltip is about, since when, and whether a tooltip of its kind locks; how long it waits before it
// shows (its kind's delay), and whether it waited that long (`ripe`).
struct Target {
  kind: integer | nil
  about: string | nil
  since: number
  locks: boolean
  delay: number = 0
  ripe: boolean = false
}

// What is drawn for the tooltip the game shows now.
struct Shown {
  model: Model
  // The tooltips beside it from the start, and the worn items it is compared with.
  sides: array<Model>
  compared: array<Model>
  // What other modules' sections are asked about: the item by its number and its link (0 and "" for anything
  // else), the world object by its name ("" for anything else).
  item: integer
  link: string
  object: string
  // It locks as the cursor stays: the main tooltip keeps the room of the lock's bar (a button's text never does).
  locks: boolean
  // Where its kind stands, the general place put in for the kind's «Default».
  place: Place
}

// A locked tooltip: what was shown when it locked, and where.
struct Held {
  shown: Shown
  standing: Standing
}

// What the group shows while there is nothing to show: it isn't drawn then.
const NOTHING: Model = {
  kind: Kind::Text, name: "", nameColor: BRIGHT_TEXT,
  desc: [], info: [], facts: [], body: [], more: [], foot: [], keys: []
}

public class Tooltips implements Module, App {
  public const title: string = "Ordaen Tooltips"

  // Each kind's place is where Blizzard's own UI puts it: what a frame holds (an item, an ability, an effect, a
  // button) beside its frame, what is in the world (a player, an NPC, an object) in Blizzard's place.
  settings: mut Settings<Choices> = new Settings<Choices>({
    place: Place::Blizzard,
    itemsOn: true, itemsPlace: KindPlace::Anchor, itemsIlvl: true, itemsId: false,
    itemsCount: true, itemsStack: true, itemsCooldown: true,
    spellsOn: true, spellsPlace: KindPlace::Anchor, spellsId: false, spellsNext: true, spellsCooldown: true,
    aurasOn: true, aurasPlace: KindPlace::Anchor, aurasId: false, aurasCaster: true, aurasTotal: true,
    playersOn: true, playersPlace: KindPlace::Default, playersTarget: true, playersRelation: true,
    npcsOn: true, npcsPlace: KindPlace::Default, npcsParty: true, npcsLoot: true, npcsRep: true, npcsQuests: true,
    objectsOn: true, objectsPlace: KindPlace::Default, textsOn: true, textsPlace: KindPlace::Anchor, textsExtra: true,
    itemsLock: true, spellsLock: true, aurasLock: true, playersLock: true, npcsLock: true, objectsLock: true
  })
  public const pages: array<SettingsPage> = [
    { title: Locale::TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
    { title: Locale::TAB_ITEMS, content: $ltml { <ItemsPage settings={mut self.settings} /> } },
    { title: Locale::TAB_SPELLS, content: $ltml { <SpellsPage settings={mut self.settings} /> } },
    { title: Locale::TAB_AURAS, content: $ltml { <AurasPage settings={mut self.settings} /> } },
    { title: Locale::TAB_PLAYERS, content: $ltml { <PlayersPage settings={mut self.settings} /> } },
    { title: Locale::TAB_NPCS, content: $ltml { <NpcsPage settings={mut self.settings} /> } },
    { title: Locale::TAB_OBJECTS, content: $ltml { <ObjectsPage settings={mut self.settings} /> } },
    { title: Locale::TAB_TEXTS, content: $ltml { <TextsPage settings={mut self.settings} /> } }
  ]

  derived read: Shown | nil = self.readNow()
  // What the game's tooltip is about now; kept through a refresh.
  state target: Target | nil = nil
  // The player closed the locked tooltip: its target doesn't charge again.
  state closed = false
  // Locked: what was shown then and where, which stays once the game's tooltip is gone.
  state kept: Held | nil = nil
  // When the game's tooltip went, while it is gone; since when the cursor has been on neither the locked group nor
  // its source, while it is away.
  state hiddenAt: number | nil = nil
  state leftAt: number | nil = nil
  // The cursor is on the group (on a part of it that opens another tooltip too); it has been on it since it locked.
  state over = false
  state visited = false
  // The game's word of every press of the mouse, heard while a tooltip is locked.
  pressHeard: Handle | nil = nil
  derived locked: boolean = self.kept != nil
  // What is drawn locks: it is locked, or it charges as the cursor stays (a button's text never does). Kept with
  // the last show while nothing shows, as the rest of it is.
  derived locking: boolean = self.locked || (self.drawn?.locks ?? false)
  derived charge: integer = self.chargeNow()
  derived gone: boolean = self.goneNow()
  derived away: boolean = self.awayNow()
  // The game's tooltip shows what is locked: the cursor is back on its source.
  derived onSource: boolean = self.onSourceNow()
  derived current: Shown | nil = self.read ?? self.kept?.shown
  // It shows once its target waited its delay, or while it is locked.
  derived shown: boolean = self.current != nil && (self.kept != nil || (self.target?.ripe ?? false))
  // The last show, kept while nothing shows: the group is drawn once, and a show changes only what differs from
  // the one before.
  state last: Shown | nil = nil
  derived drawn: Shown | nil = self.current ?? self.last
  // The group is drawn from the first show on.
  derived ever: boolean = self.drawn != nil
  derived keysAsked: array<string> = self.keysAddedNow()
  state keysAdded: array<string> = []
  derived model: Model = self.withKeys(self.drawn?.model ?? NOTHING)
  derived sides: array<Model> = self.drawn?.sides ?? []
  derived compared: array<Model> = self.drawn?.compared ?? []
  derived standing: Standing = self.kept?.standing ?? self.where()
  derived chosen: Options = self.options()

  // The sections other modules add to, drawn after the main tooltip's body in this order (`@/extend`).
  // What an item is worth: the auction's price.
  public const worth = new Registry<any ItemLines>()
  // What an item is for: the recipes that take it.
  public const uses = new Registry<any ItemLines>()
  // Where an item is, and how many are still wanted: the characters who hold it, the shopping list.
  public const held = new Registry<any ItemLines>()
  // How the item can be handled where it is shown: a hotkey line each, after the tooltip's own.
  public const keys = new Registry<any ItemKeys>()
  // What a world object gives.
  public const gives = new Registry<any ObjectLines>()
  // What a creature is to the player's quests: the objectives it serves, the quests it gives or takes.
  public const creatures = new Registry<any CreatureQuests>()

  // The pinned tooltip, read as the hover one is; nothing while none is pinned, or one of a kind left to the game.
  derived pinnedRead: Shown | nil = self.pinnedNow()
  derived pinnedShown: boolean = self.pinnedRead != nil
  derived pinnedModel: Model = self.pinnedRead?.model ?? NOTHING
  derived pinnedSides: array<Model> = self.pinnedRead?.sides ?? []
  derived pinnedCompared: array<Model> = self.pinnedRead?.compared ?? []
  derived pinnedItem: integer = self.pinnedRead?.item ?? 0
  derived pinnedLink: string = self.pinnedRead?.link ?? ""
  // Where the game's pinned tooltip stands, hanging by its top left as it does.
  derived pinnedStanding: Standing = { by: Game::tooltip.pinned.corner, inPlace: true, below: true, right: false }

  // The item the tooltip shows, 0 where it shows none; the world object, "" where it shows none.
  derived item: integer = self.current?.item ?? 0
  derived link: string = self.current?.link ?? ""
  derived object: string = self.current?.object ?? ""

  constructor() {
    Ordaen.modules.add(self)
    // What is drawn here is unseen from the game's show itself; the watch's word follows a frame later.
    Game::tooltip.claim((data: Game::TooltipData): boolean => self.claims(data))
    watch { self.keepUnseen() }
    watch { Game::tooltip.hidePinned(self.pinnedShown) }
    watch { self.follow() }
    watch { self.ripen() }
    watch { self.lockCharged() }
    watch { self.forget() }
    watch { self.trackAway() }
    watch { self.graceOut() }
    watch { self.keepLast() }
    watch { self.keepKeys() }
    watch (locked of self.locked) { self.hearPresses(locked) }
  }

  // A press is heard while a tooltip is locked, and not otherwise.
  mut hearPresses(locked: boolean) {
    if (locked && self.pressHeard == nil) {
      self.pressHeard = Events::GLOBAL_MOUSE_DOWN.listen(self.onPress)
    } else if (!locked && self.pressHeard != nil) {
      destroy self.pressHeard
      self.pressHeard = nil
    }
  }

  // A press of the mouse anywhere but on the locked group takes it away. The game says it of every press, and takes
  // nothing of it: the press still goes to what it was on (a window starts its drag, a button its click). The close
  // button is on the group, and closes it as itself.
  mut onPress(button: string) {
    if (peek self.kept != nil && !(peek self.over)) { self.close() }
  }

  // The hotkeys other modules add for the item shown. A module may say them of the frame under the cursor (a bag's
  // slot): read while the tooltip isn't locked, kept as they were while it is (the cursor gone onto the tooltip).
  keysAddedNow(): array<string> {
    const shownItem = self.drawn?.item ?? 0
    let added: array<string> = mut []
    if (shownItem == 0) { return added }
    const link = self.drawn?.link ?? ""
    for (row of self.keys) {
      for (key of row.keys(shownItem, link)) { added.push(key) }
    }
    return added
  }

  mut keepKeys() {
    if (!self.locked) { self.keysAdded = self.keysAsked }
  }

  // The model drawn, its hotkeys followed by what other modules add for the item it shows: the model as it is where
  // they add none.
  withKeys(model: Model): Model {
    const added = self.keysAdded
    if (added.length == 0) { return model }
    let keys: array<string> = mut []
    for (key of model.keys) { keys.push(key) }
    for (key of added) { keys.push(key) }
    return { keys: keys, ..model }
  }

  mut keepLast() {
    let current = self.current
    if (current != nil) { self.last = current }
  }

  // How far the lock is charged, of `STEPS`. The time is read only while a target charges.
  chargeNow(): integer {
    if (self.kept != nil) { return STEPS }
    let target = self.target
    if (target == nil || !target.locks || self.closed) { return 0 }
    let steps = ((Game::clock.time - target.since - target.delay - DELAY) / CHARGE * STEPS).floor()
    if (steps < 0) { return 0 }
    return steps < STEPS ? steps : STEPS
  }

  // The game's tooltip has been gone for longer than a refresh takes.
  goneNow(): boolean {
    let at = self.hiddenAt
    return at != nil && self.kept == nil && Game::clock.time >= at + REFRESH
  }

  // The cursor has been off the locked group for longer than the grace.
  awayNow(): boolean {
    let at = self.leftAt
    return at != nil && Game::clock.time >= at + GRACE
  }

  // The game's tooltip shows, shows another thing, or goes. The same thing shown again keeps its charge; another
  // one starts anew, and the locked one goes.
  mut follow() {
    let tip = Game::tooltip.main
    if (!tip.shown) {
      if (peek self.hiddenAt == nil) { self.hiddenAt = peek Game::clock.time }
      return
    }
    self.hiddenAt = nil
    let data = tip.data
    let target = peek self.target
    if (target != nil && target.kind == data.kind && target.about == data.about) { return }
    let kind = kindOf(data)
    self.kept = nil
    self.leftAt = nil
    self.visited = false
    self.closed = false
    // Straight from a tooltip that showed to the next: the next shows at once.
    const warm = target != nil && target.ripe
    const delay = kind != nil && !warm ? self.delayOf(kind, data) : 0
    self.target = {
      kind: data.kind, about: data.about, since: peek Game::clock.time,
      locks: kind != nil && self.wanted(kind, data) && self.locks(kind, data), delay: delay, ripe: delay <= 0
    }
  }

  // The target waited its delay: it shows. The time is read only while it waits.
  mut ripen() {
    const target = self.target
    if (target == nil || target.ripe) { return }
    if (Game::clock.time >= target.since + target.delay) { self.target = { ripe: true, ..target } }
  }

  // Charged in full: what is shown stays.
  mut lockCharged() {
    if (self.charge < STEPS || peek self.kept != nil) { return }
    let read = peek self.read
    if (read == nil) {
      self.closed = true
      return
    }
    self.kept = { shown: read, standing: peek self.standing }
  }

  // Gone for good and not locked: nothing is kept of it (the next show is a target of its own, not closed), and the
  // time is no longer read.
  mut forget() {
    if (self.gone) {
      self.target = nil
      self.hiddenAt = nil
    }
  }

  mut graceOut() {
    if (self.away) { self.close() }
  }

  // Not locked, and its target doesn't charge again; with nothing kept the grace stops (`trackAway`), and the next
  // target starts unvisited (`follow`).
  mut close() {
    self.closed = true
    self.kept = nil
  }

  unpin() { Game::tooltip.unpin() }
  dragPinned(moving: boolean) { Game::tooltip.dragPinned(moving) }

  mut onEnter() { self.over = true }
  mut onLeave() { self.over = false }

  onSourceNow(): boolean {
    let tip = Game::tooltip.main
    let target = self.target
    return tip.shown && target != nil && target.kind == tip.data.kind && target.about == tip.data.about
  }

  // A locked group the cursor has been on is away while the cursor is on neither it nor its source: the grace runs
  // from then, and the cursor coming back onto either stops it. Until the cursor first comes onto it, it stays.
  mut trackAway() {
    if (self.kept == nil) {
      self.leftAt = nil
    } else if (self.over) {
      self.visited = true
      self.leftAt = nil
    } else if (!(peek self.visited) || self.onSource) {
      self.leftAt = nil
    } else if (peek self.leftAt == nil) {
      self.leftAt = peek Game::clock.time
    }
  }

  destructor() {
    if (self.pressHeard != nil) { destroy self.pressHeard }
    // Nothing here draws the game's tooltips any more: they are seen again.
    Game::tooltip.hide(false)
    Game::tooltip.hidePinned(false)
  }

  // Whether what the game's tooltip shows is drawn here: a kind read here, its switch on.
  public claims(data: Game::TooltipData): boolean {
    const kind = kindOf(data)
    return kind != nil && self.wanted(kind, data)
  }

  // The game's own tooltip is unseen for a show drawn here, and seen for one left to it.
  keepUnseen() {
    Game::tooltip.hide(self.current != nil)
  }

  options(): Options {
    let chosen = self.settings.values
    return {
      spellsCooldown: chosen.spellsCooldown, spellsId: chosen.spellsId, spellsNext: chosen.spellsNext,
      aurasCaster: chosen.aurasCaster, aurasTotal: chosen.aurasTotal, aurasId: chosen.aurasId,
      classNames: true, playersTarget: chosen.playersTarget, playersRelation: chosen.playersRelation,
      npcsLoot: chosen.npcsLoot, npcsParty: chosen.npcsParty, npcsRep: chosen.npcsRep,
      itemsIlvl: chosen.itemsIlvl, itemsCooldown: chosen.itemsCooldown, itemsId: chosen.itemsId,
      itemsCount: chosen.itemsCount, itemsStack: chosen.itemsStack
    }
  }

  // The unit a tooltip is about is a player.
  aPlayer(data: Game::TooltipData): boolean {
    let first = data.lines[1]
    let token = first != nil && first.kind == UNIT_NAME ? first.unit : nil
    let who = token != nil ? Game::units.of(token) : nil
    return who != nil && who.player
  }

  // Whether tooltips of this kind are drawn here. A unit is a player or an NPC, each with its own switch.
  wanted(kind: Kind, data: Game::TooltipData): boolean {
    let chosen = self.settings.values
    match (kind) {
      Kind::Item => return chosen.itemsOn
      Kind::Spell => return chosen.spellsOn
      Kind::Aura => return chosen.aurasOn
      Kind::Object => return chosen.objectsOn
      Kind::Text => return chosen.textsOn
      Kind::Set => return false
      Kind::Term => return false
      Kind::Unit => return self.aPlayer(data) ? chosen.playersOn : chosen.npcsOn
    }
  }

  // Whether a tooltip of this kind locks. One that is only text has nothing to open.
  locks(kind: Kind, data: Game::TooltipData): boolean {
    let chosen = self.settings.values
    match (kind) {
      Kind::Item => return chosen.itemsLock
      Kind::Spell => return chosen.spellsLock
      Kind::Aura => return chosen.aurasLock
      Kind::Object => return chosen.objectsLock
      Kind::Text => return false
      Kind::Set => return false
      Kind::Term => return false
      Kind::Unit => return self.aPlayer(data) ? chosen.playersLock : chosen.npcsLock
    }
  }

  // How long a tooltip of this kind waits before it shows: its kind's delay, or the general one where it is «Default».
  delayOf(kind: Kind, data: Game::TooltipData): number {
    let chosen = self.settings.values
    let own = match (kind) {
      Kind::Item => chosen.itemsDelay
      Kind::Spell => chosen.spellsDelay
      Kind::Aura => chosen.aurasDelay
      Kind::Object => chosen.objectsDelay
      Kind::Text => chosen.textsDelay
      Kind::Set => KindDelay::Default
      Kind::Term => KindDelay::Default
      Kind::Unit => self.aPlayer(data) ? chosen.playersDelay : chosen.npcsDelay
    }
    return delaySeconds(match (own) {
      KindDelay::Default => chosen.delay
      KindDelay::Instant => Delay::Instant
      KindDelay::Short => Delay::Short
      KindDelay::Medium => Delay::Medium
      KindDelay::Long => Delay::Long
    })
  }

  // Where a tooltip of this kind stands: its kind's place, or the general one where the kind's is «Default».
  placeOf(kind: Kind, data: Game::TooltipData): Place {
    let chosen = self.settings.values
    let own = match (kind) {
      Kind::Item => chosen.itemsPlace
      Kind::Spell => chosen.spellsPlace
      Kind::Aura => chosen.aurasPlace
      Kind::Object => chosen.objectsPlace
      Kind::Text => chosen.textsPlace
      Kind::Set => KindPlace::Default
      Kind::Term => KindPlace::Default
      Kind::Unit => self.aPlayer(data) ? chosen.playersPlace : chosen.npcsPlace
    }
    return match (own) {
      KindPlace::Anchor => Place::Anchor
      KindPlace::Blizzard => Place::Blizzard
      KindPlace::Default => chosen.place
    }
  }

  // What the game's tooltip shows, read; nothing while it shows nothing, or what Ordaen Tooltips leaves to it.
  readNow(): Shown | nil {
    let tip = Game::tooltip.main
    if (!tip.shown) { return nil }
    // Against the show before: a tooltip the game fills anew keeps the lines that say the same.
    return self.shownOf(tip.data, tip.ownerName, Game::tooltip.compared, (peek self.last)?.model)
  }

  // The tooltip a link pinned, read as the hover one is: it has no owner, and nothing before it.
  pinnedNow(): Shown | nil {
    let tip = Game::tooltip.pinned
    if (!tip.shown) { return nil }
    return self.shownOf(tip.data, nil, Game::tooltip.pinnedCompared, nil)
  }

  // What a tooltip of the game's shows (its data, the frame it is shown for, the worn items it is compared with), as
  // drawn here; nothing for a kind left to the game.
  shownOf(data: Game::TooltipData, ownerName: string | nil, worn: array<Game::TooltipData>, before: Model | nil): Shown | nil {
    let kind = kindOf(data)
    if (kind == nil || !self.wanted(kind, data)) { return nil }
    let options = self.chosen
    let read = group(data, options, before)
    if (read == nil) { return nil }
    // Something in it counts down: it is read again as the seconds pass.
    if (read.model.timer == true) { _ = Game::clock.seconds }
    // What a button of the menu or of the bags adds to its tooltip.
    let extra = self.settings.values.textsExtra ? extras(ownerName, read.model) : read.model
    // The hotkeys other modules give the frame it is shown for: an action button's binding.
    let told = ownerKeys(ownerName, extra)
    const locks = self.locks(kind, data)
    const place = self.placeOf(kind, data)
    if (told.kind != Kind::Item) {
      const object = told.kind == Kind::Object ? told.name : ""
      return {
        model: self.withQuests(told, data), sides: read.sides, compared: [], item: 0, link: "", object: object, locks: locks, place: place
      }
    }

    // The worn items it is compared with, each under «Equipped». With one, the differences stand on the hovered
    // item; with two, on each worn one.
    let compared: array<Model> = mut []
    let model = told
    for (wornData of worn) {
      let other = item(wornData, options)
      if (other == nil) { continue }
      if (worn.length == 1) {
        model = compare(model, read.stats, other.stats, true)
        compared.push({ header: Locale::EQUIPPED, ..other.model })
      } else {
        compared.push({ header: Locale::EQUIPPED, ..compare(other.model, read.stats, other.stats, false) })
      }
    }
    const link = data.about ?? ""
    return {
      model: withWorth(model, link, data.lines.any(line => line.validType == false)), sides: read.sides, compared: compared, item: data.id ?? 0, link: link,
      object: "", locks: locks, place: place
    }
  }

  // A creature's tooltip with what other modules say of its quests among the game's quest rows: the objectives it
  // serves, and the quests it gives or takes while the NPCs' «Quests» setting is on; anything else as it is.
  withQuests(model: Model, data: Game::TooltipData): Model {
    if (model.kind != Kind::Unit || self.creatures.length == 0) { return model }
    const creature = creatureOf(data)
    if (creature == 0) { return model }
    const offering = self.settings.values.npcsQuests
    const wants: array<Wanted> = mut []
    const offers: array<Offered> = mut []
    for (entry of self.creatures) {
      for (want of entry.wants(creature)) { wants.push(want) }
      if (offering) {
        for (offer of entry.offers(creature)) { offers.push(offer) }
      }
    }
    if (wants.length == 0 && offers.length == 0) { return model }
    return { more: questRows(data.lines, self.chosen.npcsParty, wants, offers), ..model }
  }

  // Beside its owner where its kind stands so and the owner is a frame it can stand by: by the list's row the owner
  // is in (never over the rows round it), else by the owner; to its right, the tops level, or to its left where the
  // right has no room. One it can't stand by (a unit's frame, the world) is
  // where the game put its own, beside the owner where the game anchored it there. Otherwise in Blizzard's place.
  where(): Standing {
    let tip = Game::tooltip.main
    let owner = tip.owner
    let place = self.read?.place ?? self.settings.values.place
    if (place == Place::Blizzard) { return blizzardPlace(tip) }
    if (owner != nil && tip.placeable) {
      return { by: tip.by ?? owner, inPlace: false, below: tip.ownerHigh, right: tip.ownerRight, hang: BY_THE_RIGHT }
    }
    return { by: tip.corner, inPlace: true, below: tip.below, right: tip.right }
  }

  public render(): Template {
    return $ltml {
      <TipGroup $if={self.ever} model={self.model} sides={self.sides} compared={self.compared} standing={self.standing}
                shown={self.shown} options={self.chosen} locks={self.locking} charge={self.charge} locked={self.locked}
                @close={self.close}
                @enter={self.onEnter} @leave={self.onLeave}>
        // Each entry asks nothing while the tooltip isn't of its kind; with no entry, nothing is drawn or asked.
        <AddedToItem $for={row of self.worth} $key={row} row={row} item={self.item} link={self.link} locked={self.locked} options={self.chosen} />
        <AddedToItem $for={row of self.uses} $key={row} row={row} item={self.item} link={self.link} locked={self.locked} options={self.chosen} />
        <AddedToItem $for={row of self.held} $key={row} row={row} item={self.item} link={self.link} locked={self.locked} options={self.chosen} />
        <AddedToObject $for={row of self.gives} $key={row} row={row} name={self.object} locked={self.locked} options={self.chosen} />
      </TipGroup>
      // The pinned tooltip: locked from the start; its close button closes the game's, and a drag moves it.
      <TipGroup $if={self.pinnedShown} model={self.pinnedModel} sides={self.pinnedSides} compared={self.pinnedCompared}
                standing={self.pinnedStanding} shown={true} options={self.chosen} locks={true} charge={STEPS} locked={true}
                draggable={true} @close={self.unpin} @drag={self.dragPinned}>
        <AddedToItem $for={row of self.worth} $key={row} row={row} item={self.pinnedItem} link={self.pinnedLink} locked={true} options={self.chosen} />
        <AddedToItem $for={row of self.uses} $key={row} row={row} item={self.pinnedItem} link={self.pinnedLink} locked={true} options={self.chosen} />
        <AddedToItem $for={row of self.held} $key={row} row={row} item={self.pinnedItem} link={self.pinnedLink} locked={true} options={self.chosen} />
      </TipGroup>
    }
  }
}

// The item's worth to the player's spec, as a note at the foot: how much more or less than what is worn, green or
// red; nothing for an item that isn't worn or that the spec weighs at nothing. A weapon of a kind the class can learn
// and the player hasn't (`untrained`: the client marks its type) says so after it.
function withWorth(model: Model, link: string, untrained: boolean): Model {
  if (link == "") { return model }
  const share = Ordaen.worth.upgradeOf(link)
  if (share == nil) { return model }
  const spec = Game::player.spec?.name ?? Ordaen.worth.spec?.label ?? ""
  const percent = (share * 100).round()
  const right = percent > 0 ? `+${percent}%` : percent < 0 ? `−${-percent}%` : "="
  const color = percent > 0 ? GREEN : percent < 0 ? RED : nil
  let foot: array<Note> = mut []
  for (note of model.foot) { foot.push(note) }
  foot.push({ left: Locale::WORTH_FOR.format(spec), right: right, valueColor: color })
  if (untrained) { foot.push({ left: Locale::WORTH_UNTRAINED, valueColor: RED }) }
  return { foot: foot, ..model }
}

// Blizzard's place: the game's default anchor, where it puts a tooltip with no place of its own (the world, a unit's
// frame, an action button), hanging by the corner the game hangs one by there: the screen's bottom right corner
// unless the player moved it in Edit Mode.
function blizzardPlace(tip: Game::ShownTip): Standing {
  return { by: tip.home, inPlace: true, below: tip.homeBelow, right: tip.homeRight }
}

// The model with the hotkeys other modules give its owner, by the owner's name, after its own.
function ownerKeys(owner: string | nil, model: Model): Model {
  if (owner == nil || Ordaen.hotkeys.length == 0) { return model }
  let keys: array<string> = mut []
  for (key of model.keys) { keys.push(key) }
  for (row of Ordaen.hotkeys) {
    for (key of row.keys(owner)) { keys.push(key) }
  }
  if (keys.length == model.keys.length) { return model }
  return { keys: keys, ..model }
}
