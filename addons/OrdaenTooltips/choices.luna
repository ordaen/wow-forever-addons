// What the player chooses on the tooltips' settings pages.

// Where a tooltip stands: beside what it belongs to (the item, the slot, the button), or in Blizzard's place, where
// the game puts a tooltip with no place of its own (the screen's bottom right corner unless the player moved it).
public enum Place implements Plain { Anchor = "anchor", Blizzard = "blizzard" }

// Where a kind's tooltips stand: as the general setting says, or a place of their own.
public enum KindPlace implements Plain { Default = "default", Anchor = "anchor", Blizzard = "blizzard" }

// How long the cursor stays on something before its tooltip shows (`delaySeconds`): at once, or a short, a medium or
// a long wait. Moving straight from one tooltip's thing to the next shows the next at once.
public enum Delay implements Plain { Instant = "instant", Short = "short", Medium = "medium", Long = "long" }

// A kind's wait: as the general setting says, or one of its own.
public enum KindDelay implements Plain {
  Default = "default", Instant = "instant", Short = "short", Medium = "medium", Long = "long"
}

// A wait in seconds.
public function delaySeconds(delay: Delay): number {
  return match (delay) {
    .Instant => 0
    .Short => 0.3
    .Medium => 0.6
    .Long => 1
  }
}

// A kind's `Lock`: held under the cursor, a tooltip of that kind locks, and stays for the cursor to come onto it.
public struct Choices implements Plain {
  public mut place: Place
  public mut delay: Delay = Delay::Short
  public mut itemsOn: boolean
  public mut itemsLock: boolean
  public mut itemsPlace: KindPlace
  public mut itemsDelay: KindDelay = KindDelay::Default
  public mut itemsIlvl: boolean
  public mut itemsId: boolean
  public mut itemsCount: boolean
  public mut itemsStack: boolean
  public mut itemsCooldown: boolean
  public mut spellsOn: boolean
  public mut spellsLock: boolean
  public mut spellsPlace: KindPlace
  public mut spellsDelay: KindDelay = KindDelay::Default
  public mut spellsId: boolean
  public mut spellsNext: boolean
  public mut spellsCooldown: boolean
  public mut aurasOn: boolean
  public mut aurasLock: boolean
  public mut aurasPlace: KindPlace
  public mut aurasDelay: KindDelay = KindDelay::Default
  public mut aurasId: boolean
  public mut aurasCaster: boolean
  public mut aurasTotal: boolean
  public mut playersOn: boolean
  public mut playersLock: boolean
  public mut playersPlace: KindPlace
  public mut playersDelay: KindDelay = KindDelay::Default
  public mut playersTarget: boolean
  public mut playersRelation: boolean
  public mut npcsOn: boolean
  public mut npcsLock: boolean
  public mut npcsPlace: KindPlace
  public mut npcsDelay: KindDelay = KindDelay::Default
  public mut npcsParty: boolean
  public mut npcsLoot: boolean
  public mut npcsRep: boolean
  // The quests an NPC gives and takes back, in its tooltip.
  public mut npcsQuests: boolean = true
  public mut objectsOn: boolean
  public mut objectsLock: boolean
  public mut objectsPlace: KindPlace
  public mut objectsDelay: KindDelay = KindDelay::Default
  public mut textsOn: boolean
  public mut textsPlace: KindPlace
  public mut textsDelay: KindDelay = KindDelay::Default
  public mut textsExtra: boolean
}
