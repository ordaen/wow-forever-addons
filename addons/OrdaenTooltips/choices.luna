// What the player chooses on the tooltips' settings pages.

// Where a tooltip stands: beside what it belongs to (the item, the slot, the button), or in Blizzard's place, where
// the game puts a tooltip with no place of its own (the screen's bottom right corner unless the player moved it).
public enum Place implements Plain { Anchor = "anchor", Blizzard = "blizzard" }

// Where a kind's tooltips stand: as the general setting says, or a place of their own.
public enum KindPlace implements Plain { Default = "default", Anchor = "anchor", Blizzard = "blizzard" }

// How long the cursor stays on something before its tooltip shows (`delaySeconds`): at once, or a short, a medium or
// a long wait. Moving straight from one tooltip's thing to the next shows the next at once.
public enum Delay implements Plain { Instant = "instant", Short = "short", Medium = "medium", Long = "long" }

// A kind's wait: as the general setting says, or one of its own.
public enum KindDelay implements Plain {
  Default = "default", Instant = "instant", Short = "short", Medium = "medium", Long = "long"
}

// A wait in seconds.
public function delaySeconds(delay: Delay): number {
  return match (delay) {
    .Instant => 0
    .Short => 0.3
    .Medium => 0.6
    .Long => 1
  }
}

// A kind's `Lock`: held under the cursor, a tooltip of that kind locks, and stays for the cursor to come onto it.
public struct Choices implements Plain {
  place: Place
  delay: Delay = Delay::Short
  itemsOn: boolean
  itemsLock: boolean
  itemsPlace: KindPlace
  itemsDelay: KindDelay = KindDelay::Default
  itemsIlvl: boolean
  itemsId: boolean
  itemsCount: boolean
  itemsStack: boolean
  itemsCooldown: boolean
  spellsOn: boolean
  spellsLock: boolean
  spellsPlace: KindPlace
  spellsDelay: KindDelay = KindDelay::Default
  spellsId: boolean
  spellsNext: boolean
  spellsCooldown: boolean
  aurasOn: boolean
  aurasLock: boolean
  aurasPlace: KindPlace
  aurasDelay: KindDelay = KindDelay::Default
  aurasId: boolean
  aurasCaster: boolean
  aurasTotal: boolean
  playersOn: boolean
  playersLock: boolean
  playersPlace: KindPlace
  playersDelay: KindDelay = KindDelay::Default
  playersTarget: boolean
  playersRelation: boolean
  npcsOn: boolean
  npcsLock: boolean
  npcsPlace: KindPlace
  npcsDelay: KindDelay = KindDelay::Default
  npcsParty: boolean
  npcsLoot: boolean
  npcsRep: boolean
  // The quests an NPC gives and takes back, in its tooltip.
  npcsQuests: boolean = true
  objectsOn: boolean
  objectsLock: boolean
  objectsPlace: KindPlace
  objectsDelay: KindDelay = KindDelay::Default
  textsOn: boolean
  textsPlace: KindPlace
  textsDelay: KindDelay = KindDelay::Default
  textsExtra: boolean
}
