// What the player chooses on the tooltips' settings pages.

// Where an item's tooltip shows: in the screen's corner, as the game puts it, or beside the item.
public enum Place implements Plain { Corner = "corner", Anchor = "anchor" }

// A kind's `Lock`: held under the cursor, a tooltip of that kind locks, and stays for the cursor to come onto it.
public struct Choices implements Plain {
  anchorToButtons: Boolean
  itemsOn: Boolean
  itemsLock: Boolean
  itemsAnchorBags: Place
  itemsAnchorChar: Place
  itemsIlvl: Boolean
  itemsId: Boolean
  itemsCount: Boolean
  itemsStack: Boolean
  itemsCooldown: Boolean
  spellsOn: Boolean
  spellsLock: Boolean
  spellsId: Boolean
  spellsNext: Boolean
  spellsCooldown: Boolean
  aurasOn: Boolean
  aurasLock: Boolean
  aurasId: Boolean
  aurasCaster: Boolean
  aurasTotal: Boolean
  playersOn: Boolean
  playersLock: Boolean
  playersTarget: Boolean
  playersRelation: Boolean
  npcsOn: Boolean
  npcsLock: Boolean
  npcsParty: Boolean
  npcsLoot: Boolean
  npcsRep: Boolean
  objectsOn: Boolean
  objectsLock: Boolean
  textsOn: Boolean
  textsExtra: Boolean
}
