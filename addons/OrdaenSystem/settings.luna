// Blizzard's settings as the «Settings» tab reads them: the window's groups and their pages in the client's order
// (`SettingsPanel`'s category list), and a page's lines (its layout's initializers), each told by the template it is
// drawn with. What a line shows is read from the client's setting (`GetValue`); nothing here writes through Blizzard's
// setting objects, whose fields a write from addon code would taint. A setting over a console variable is written to
// the variable itself (`SetCVar`), as Blizzard's setting would write it; one that isn't (Blizzard's own getter and
// setter) is read only, and Blizzard's window changes it.
import Client from "$client"
import Runtime from "$runtime"

// What a line of a page is, by the template Blizzard draws it with.
public enum LineKind {
  // A section's header.
  Header
  // A setting that is on or off.
  Check
  // A number in a range.
  Slider
  // One of a list of choices.
  Choice
  // Anything else: a button, a section of Blizzard's own drawing. Blizzard's window shows it. A control of two settings
  // (a checkbox with a slider or a dropdown) is two lines: the checkbox's, and the other's under it.
  Blizzard
}

// A line of a page.
public struct SettingLine {
  kind: LineKind
  name: String
  tooltip: String
  // The setting's variable (`""` for a header or Blizzard's own line).
  variable: String
  // Whether the variable is a console variable: the window writes it.
  cvar: Boolean
  // The checkbox the line stands under, by its variable (`""`: none): a slider's or a dropdown's of a line of two
  // controls, greyed while the checkbox is off, as Blizzard's is.
  under: String
  // A slider's range.
  least: Number
  most: Number
  step: Number
}

// A page of the list: its id (what `Settings.OpenToCategory` takes), its name, and whether Blizzard draws it as a
// frame of its own (a canvas), which only Blizzard's window shows.
public struct SettingsPage {
  id: Integer
  name: String
  canvas: Boolean
  // A page under another: drawn under it, indented.
  child: Boolean
}

// A group of the list (Game, Accessibility, System) and its pages, in order.
public struct PageGroup {
  name: String
  pages: Array<SettingsPage>
}

// A line's kind by its template's name.
function kindOf(template: String, data: Client.SettingsData): LineKind {
  if (template.contains("SectionHeader")) { return .Header }
  if (data.setting == nil) { return .Blizzard }
  if (template.contains("Checkbox")) { return .Check }
  if (template.contains("Slider")) { return .Slider }
  if (template.contains("Dropdown")) { return .Choice }
  return .Blizzard
}

// The pages Blizzard lists that the tab doesn't: an addon's (the «Mods» tab has its addons), the key bindings (the tab's
// own «Key Bindings» has them), and what the client names `NoDisplayKB`, the key bindings' pages its list never shows.
const HIDDEN = "NoDisplayKB"

function shown(category: any Client.SettingsCategory): Boolean {
  const name = category.GetName()
  return category.GetCategorySet() != .AddOns && name != HIDDEN && name != Runtime.text("SETTINGS_KEYBINDINGS_LABEL")
}

// A line of a page: its kind, name and tooltip, its setting (none: a header or Blizzard's own), a slider's range, and
// the checkbox it stands under.
function lineOf(
  kind: LineKind, name: String, tooltip: String, setting: any Client.Setting | nil, range: Client.SettingsSliderOptions | nil,
  under: String
): SettingLine {
  const variable = setting?.GetVariable() ?? ""
  return {
    kind: kind,
    name: name,
    tooltip: tooltip,
    variable: variable,
    cvar: variable != "" && Client.C_CVar.GetCVar(variable) != nil,
    under: under,
    least: range?.minValue ?? 0,
    most: range?.maxValue ?? 0,
    step: range == nil || range.steps <= 0 ? 1 : (range.maxValue - range.minValue) / range.steps
  }
}

function pageOf(panel: any Client.SettingsPanelFrame, category: any Client.SettingsCategory, child: Boolean): SettingsPage {
  const layout = panel.GetLayout(category)
  return { id: category.GetID(), name: category.GetName(), canvas: layout?.layoutType == .Canvas, child: child }
}

public class SystemSettings {
  public state groups: Array<PageGroup> = []
  // The page shown, by its id: its lines, and the value each of its settings has now.
  public state page = 0
  public state lines: Array<SettingLine> = []
  public state values: Map<String, Boolean | Number | String> = {}
  // Each page's lines, by the page's id: what the search reads.
  state everyLine: Map<Integer, Array<SettingLine>> = {}

  // The list read anew, as the tab opens: the client's groups, each with its pages and the pages under them, and every
  // page's lines (a thousand lines, read once a tab's open, for the search). The first page is shown.
  public read(mut self) {
    const panel = Client.SettingsPanel
    if (panel == nil) { return }
    const groups: Array<PageGroup> = []
    const everyLine: Map<Integer, Array<SettingLine>> = {}
    for (group of panel.GetCategoryList().groups) {
      const pages: Array<SettingsPage> = []
      for (category of group.categories) {
        if (!shown(category)) { continue }
        pages.push(pageOf(panel, category, false))
        for (under of category.GetSubcategories()) {
          if (shown(under)) { pages.push(pageOf(panel, under, true)) }
        }
      }
      for (page of pages) { everyLine[page.id] = self.linesOf(page.id) }
      if (pages.length > 0) { groups.push({ name: group.groupText, pages: pages }) }
    }
    self.groups = groups
    self.everyLine = everyLine
    if ((peek self.page) == 0) { self.open((groups[1]?.pages ?? [])[1]?.id ?? 0) }
  }

  // A page's lines, read from its layout: none for an addon's own frame.
  public linesOf(self, id: Integer): Array<SettingLine> {
    const panel = Client.SettingsPanel
    const category = Client.Settings?.GetCategory(id)
    if (panel == nil || category == nil) { return [] }
    const lines: Array<SettingLine> = []
    for (initializer of panel.GetLayout(category)?.initializers ?? []) {
      const data = initializer.data
      if (data == nil) { continue }
      const box = data.cbSetting
      if (box != nil) {
        // A line of two controls: its checkbox, then its slider or its dropdown under it.
        const check = box.GetVariable()
        lines.push(lineOf(.Check, data.cbLabel ?? box.GetName(), data.cbTooltip ?? "", box, nil, ""))
        const slider = data.sliderSetting
        const dropdown = data.dropdownSetting
        if (slider != nil) {
          lines.push(lineOf(.Slider, data.sliderLabel ?? slider.GetName(), data.sliderTooltip ?? "", slider, data.sliderOptions, check))
        } else if (dropdown != nil) {
          lines.push(lineOf(.Choice, data.dropDownLabel ?? dropdown.GetName(), data.dropDownTooltip ?? "", dropdown, nil, check))
        }
        continue
      }
      const options = data.options
      const range = options is Client.SettingsSliderOptions ? options : nil
      const kind = kindOf(initializer.GetTemplate(), data)
      lines.push(lineOf(kind, data.name ?? data.setting?.GetName() ?? "", data.tooltip ?? "", data.setting, range, ""))
    }
    return lines
  }

  // The page shown: its lines read, and their values.
  public open(mut self, id: Integer) {
    self.page = id
    self.lines = self.linesOf(id)
    self.refresh()
  }

  // Every value of the page shown read again (a console variable changed: `CVAR_UPDATE`, or another window).
  public refresh(mut self) {
    const values: Map<String, Boolean | Number | String> = {}
    for (line of peek self.lines) {
      if (line.variable != "") {
        const setting = Client.Settings?.GetSetting(line.variable)
        if (setting != nil) { values[line.variable] = setting.GetValue() }
      }
    }
    self.values = values
  }

  // A setting over a console variable set to a value: the variable written as Blizzard's setting writes it (a Boolean
  // as `1` or `0`), and the page's values read again. Whether the client took it.
  public write(mut self, variable: String, value: Boolean | Number | String): Boolean {
    const text = value is Boolean ? (value ? "1" : "0") : String.of(value)
    const took = Client.C_CVar.SetCVar(variable, text)
    self.refresh()
    return took
  }

  // A dropdown's choices, asked of the client as the line is drawn (they may follow other settings).
  public choicesOf(self, id: Integer, variable: String): Array<Client.SettingsOption> {
    const panel = Client.SettingsPanel
    const category = Client.Settings?.GetCategory(id)
    if (panel == nil || category == nil) { return [] }
    for (initializer of panel.GetLayout(category)?.initializers ?? []) {
      const data = initializer.data
      if (data == nil) { continue }
      const options = data.options
      if (data.setting?.GetVariable() == variable && options != nil && !(options is Client.SettingsSliderOptions)) {
        return options()
      }
      const offered = data.dropdownOptions
      if (data.dropdownSetting?.GetVariable() == variable && offered != nil) { return offered() }
    }
    return []
  }

  // The pages a search finds, by their ids: those whose name, or a line's name or tooltip, holds it.
  public matching(self, query: String): Map<Integer, Boolean> {
    const found: Map<Integer, Boolean> = {}
    if (query == "") { return found }
    for (group of self.groups) {
      for (page of group.pages) {
        const lines: Array<SettingLine> = self.everyLine[page.id] ?? []
        if (page.name.lower().contains(query) || lines.any((line: SettingLine): Boolean => lineMatches(line, query))) {
          found[page.id] = true
        }
      }
    }
    return found
  }
}

// Whether a line's name or tooltip holds the search.
public function lineMatches(line: SettingLine, query: String): Boolean {
  return query == "" || line.name.lower().contains(query) || line.tooltip.lower().contains(query)
}
