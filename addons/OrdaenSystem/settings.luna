// Blizzard's settings as the «Settings» tab reads them: the window's groups and their pages in the client's order
// (`SettingsPanel`'s category list), and a page's lines (its layout's initializers), each told by the template it is
// drawn with. What a line shows is read from the client's setting (`GetValue`). A setting over a console variable is
// written to the variable itself (`SetCVar`), as Blizzard's setting writes it; any other through the setting
// (`SetValue`, Blizzard's own setter: what the API gives addons). One that waits for Blizzard's Apply holds its new
// value until `apply` (the panel's own `Commit`, with its timed question after a resolution).
import Client from "$client"
import { Event } from "$ltml"
import Runtime from "$runtime"

// How a setting is written: its console variable itself; through Blizzard's setting, now; through it, held until
// Apply; or not at all (a header, Blizzard's own line).
public enum Writing { Variable, Setting, Apply, None }

// How a setting is written, by what it is kept in and what its change asks.
function writingOf(setting: any Client::Setting | nil): Writing {
  if (setting == nil) { return .None }
  if (setting.HasCommitFlag(.Apply)) { return .Apply }
  return Client::C_CVar::GetCVar(setting.GetVariable()) != nil ? .Variable : .Setting
}

// A setting's value now, by its variable; none where the client has no such setting.
public function readSetting(variable: string): boolean | number | string | nil {
  return Client::Settings?.GetSetting(variable)?.GetValue()
}

// A setting set, as its line would write it: its console variable itself (a Boolean as `1` or `0`), or through
// Blizzard's setting. Whether it waits for Apply.
public function writeSetting(variable: string, value: boolean | number | string): boolean {
  const setting = Client::Settings?.GetSetting(variable)
  const writing = writingOf(setting)
  if (writing == .Variable) {
    _ = Client::C_CVar::SetCVar(variable, value is boolean ? (value ? "1" : "0") : string::of(value))
  } else if (writing != .None) {
    setting?.SetValue(value)
  }
  return writing == .Apply
}

// A setting written through the window: its variable and its value, and whether that is its default (a page's
// defaults), which the profile no longer holds.
public struct SettingWritten {
  public mut variable: string
  public mut value: boolean | number | string
  public mut byDefault: boolean
}

// What a line of a page is, by the template Blizzard draws it with.
public enum LineKind {
  // A section's header.
  Header
  // A setting that is on or off.
  Check
  // A number in a range.
  Slider
  // One of a list of choices.
  Choice
  // Anything else: a button, a section of Blizzard's own drawing. Blizzard's window shows it. A control of two settings
  // (a checkbox with a slider or a dropdown) is two lines: the checkbox's, and the other's under it.
  Blizzard
}

// A line of a page.
public struct SettingLine {
  public mut kind: LineKind
  public mut name: string
  public mut tooltip: string
  // The setting's variable (`""` for a header or Blizzard's own line).
  public mut variable: string
  // How the window writes it.
  public mut writing: Writing
  // The checkbox the line stands under, by its variable (`""`: none): a slider's or a dropdown's of a line of two
  // controls, hidden while the checkbox is off.
  public mut under: string
  // A slider's range, and how Blizzard's window writes its value beside it (none: as a number).
  public mut least: number
  public mut most: number
  public mut step: number
  public mut format: ((value: number) => string) | nil
}

// A page of the list: its id (what `Settings.OpenToCategory` takes), its name, and whether Blizzard draws it as a
// frame of its own (a canvas), which only Blizzard's window shows.
public struct SettingsPage {
  public mut id: integer
  public mut name: string
  public mut canvas: boolean
  // A page under another: drawn under it, indented.
  public mut child: boolean
}

// A group of the list (Game, Accessibility, System) and its pages, in order.
public struct PageGroup {
  public mut name: string
  public mut pages: array<SettingsPage>
}

// A line's kind by its template's name.
function kindOf(template: string, data: Client::SettingsData): LineKind {
  if (template.contains("SectionHeader")) { return .Header }
  if (data.setting == nil) { return .Blizzard }
  if (template.contains("Checkbox")) { return .Check }
  if (template.contains("Slider")) { return .Slider }
  if (template.contains("Dropdown")) { return .Choice }
  return .Blizzard
}

// The pages Blizzard lists that the tab doesn't: an addon's (the «Mods» tab has its addons), the key bindings (the tab's
// own «Key Bindings» has them), and what the client names `NoDisplayKB`, the key bindings' pages its list never shows.
const HIDDEN = "NoDisplayKB"

function shown(category: any Client::SettingsCategory): boolean {
  const name = category.GetName()
  return category.GetCategorySet() != .AddOns && name != HIDDEN && name != Runtime::text("SETTINGS_KEYBINDINGS_LABEL")
}

// A tooltip Blizzard gives as its text, or as the function that writes it.
function textOf(tooltip: string | (() => string) | nil): string {
  if (tooltip == nil) { return "" }
  if (tooltip is string) { return tooltip }
  return tooltip()
}

// What a slider's label beside it writes (`MinimalSliderWithSteppersMixin.Label.Right`).
const SLIDER_RIGHT = 2

function formatOf(range: Client::SettingsSliderOptions | nil): ((value: number) => string) | nil {
  const formatters = range?.formatters
  return formatters == nil ? nil : formatters[SLIDER_RIGHT]
}

// Text in a colour of Blizzard's tooltips.
const HIGHLIGHT = "ffffffff"
const NORMAL = "ffffd100"
const DISABLED = "ff808080"
const ERROR = "ffff2020"
const GREEN = "ff19ff19"
const WARNING = "ffff8000"

function colored(color: string, text: string): string { return "|c" + color + text + "|r" }

// A line of a page: its kind, name and tooltip, its setting (none: a header or Blizzard's own), a slider's range, and
// the checkbox it stands under.
function lineOf(
  kind: LineKind, name: string, tooltip: string | (() => string) | nil, setting: any Client::Setting | nil, range: Client::SettingsSliderOptions | nil,
  under: string
): SettingLine {
  const variable = setting?.GetVariable() ?? ""
  return {
    kind: kind,
    name: name,
    tooltip: textOf(tooltip),
    variable: variable,
    writing: writingOf(setting),
    under: under,
    least: range?.minValue ?? 0,
    most: range?.maxValue ?? 0,
    step: range == nil || range.steps <= 0 ? 1 : (range.maxValue - range.minValue) / range.steps,
    format: formatOf(range)
  }
}

function pageOf(panel: any Client::SettingsPanelFrame, category: any Client::SettingsCategory, child: boolean): SettingsPage {
  const layout = panel.GetLayout(category)
  return { id: category.GetID(), name: category.GetName(), canvas: layout?.layoutType == .Canvas, child: child }
}

public class SystemSettings {
  // Each setting the window writes, as it writes it: what the profile keeps (`GameKeeping`).
  public written: Event<SettingWritten> = new Event()
  public state groups: array<PageGroup> = []
  // The page shown, by its id: its lines, and the value each of its settings has now.
  public state page = 0
  public state lines: array<SettingLine> = []
  public state values: map<string, boolean | number | string> = {}
  // Each page's lines, by the page's id: what the search reads.
  state everyLine: map<integer, array<SettingLine>> = {}
  // Settings changed that wait for Apply, by their variable.
  public state waiting: array<string> = []

  // The list read anew, as the tab opens: the client's groups, each with its pages and the pages under them, and every
  // page's lines (a thousand lines, read once a tab's open, for the search). The first page is shown.
  public mut read() {
    const panel = Client::SettingsPanel
    if (panel == nil) { return }
    const groups: array<PageGroup> = mut []
    const everyLine: map<integer, array<SettingLine>> = mut {}
    for (group of panel.GetCategoryList().groups) {
      const pages: array<SettingsPage> = mut []
      for (category of group.categories) {
        if (!shown(category)) { continue }
        pages.push(pageOf(panel, category, false))
        for (under of category.GetSubcategories()) {
          if (shown(under)) { pages.push(pageOf(panel, under, true)) }
        }
      }
      for (page of pages) { everyLine[page.id] = self.linesOf(page.id) }
      if (pages.length > 0) { groups.push({ name: group.groupText, pages: pages }) }
    }
    self.groups = groups
    self.everyLine = everyLine
    if ((peek self.page) == 0) { self.open((groups[1]?.pages ?? [])[1]?.id ?? 0) }
  }

  // A page's lines, read from its layout: none for an addon's own frame.
  public linesOf(id: integer): array<SettingLine> {
    const panel = Client::SettingsPanel
    const category = Client::Settings?.GetCategory(id)
    if (panel == nil || category == nil) { return [] }
    const lines: array<SettingLine> = mut []
    for (initializer of panel.GetLayout(category)?.initializers ?? []) {
      const data = initializer.data
      if (data == nil) { continue }
      const box = data.cbSetting
      if (box != nil) {
        // A line of two controls: its checkbox, then its slider or its dropdown under it.
        const check = box.GetVariable()
        lines.push(lineOf(.Check, data.cbLabel ?? box.GetName(), data.cbTooltip, box, nil, ""))
        const slider = data.sliderSetting
        const dropdown = data.dropdownSetting
        if (slider != nil) {
          lines.push(lineOf(.Slider, data.sliderLabel ?? slider.GetName(), data.sliderTooltip, slider, data.sliderOptions, check))
        } else if (dropdown != nil) {
          lines.push(lineOf(.Choice, data.dropDownLabel ?? dropdown.GetName(), data.dropDownTooltip, dropdown, nil, check))
        }
        continue
      }
      const options = data.options
      const range = options is Client::SettingsSliderOptions ? options : nil
      const kind = kindOf(initializer.GetTemplate(), data)
      lines.push(lineOf(kind, data.name ?? data.setting?.GetName() ?? "", data.tooltip, data.setting, range, ""))
    }
    return lines
  }

  // The page shown: its lines read, and their values.
  public mut open(id: integer) {
    self.page = id
    self.lines = self.linesOf(id)
    self.refresh()
  }

  // Every value of the page shown read again (a console variable changed: `CVAR_UPDATE`, or another window).
  public mut refresh() {
    const values: map<string, boolean | number | string> = mut {}
    for (line of peek self.lines) {
      if (line.variable != "") {
        const setting = Client::Settings?.GetSetting(line.variable)
        if (setting != nil) { values[line.variable] = setting.GetValue() }
      }
    }
    self.values = values
  }

  // A line's setting set to a value, as the line writes it (a console variable's Boolean as `1` or `0`), and the
  // page's values read again; one that waits for Apply is kept as waiting.
  public mut write(line: SettingLine, value: boolean | number | string, byDefault: boolean = false) {
    if (line.writing != .None) {
      if (writeSetting(line.variable, value)) {
        const waiting = peek self.waiting
        if (!waiting.any(each => each == line.variable)) {
          const next = waiting.map(each => each)
          next.push(line.variable)
          self.waiting = next
        }
      }
      self.written.emit({ variable: line.variable, value: value, byDefault: byDefault })
    }
    self.refresh()
  }

  // What waits for Apply takes hold: the panel's own commit, as its Apply button does.
  public mut apply() {
    Client::SettingsPanel?.Commit(nil)
    self.waiting = []
    self.refresh()
  }

  // Every setting of the page shown back to its default.
  public mut defaults() {
    for (line of peek self.lines) {
      const value = Client::Settings?.GetSetting(line.variable)?.GetDefaultValue()
      if (value != nil && line.writing != .None && value != (peek self.values)[line.variable]) { self.write(line, value, true) }
    }
  }

  // A dropdown's choices, asked of the client as the line is drawn (they may follow other settings).
  public choicesOf(id: integer, variable: string): array<Client::SettingsOption> {
    const panel = Client::SettingsPanel
    const category = Client::Settings?.GetCategory(id)
    if (panel == nil || category == nil) { return [] }
    for (initializer of panel.GetLayout(category)?.initializers ?? []) {
      const data = initializer.data
      if (data == nil) { continue }
      const options = data.options
      if (data.setting?.GetVariable() == variable && options != nil && !(options is Client::SettingsSliderOptions)) {
        return options()
      }
      const offered = data.dropdownOptions
      if (data.dropdownSetting?.GetVariable() == variable && offered != nil) { return offered() }
    }
    return []
  }

  // A line's tooltip as Blizzard's window writes it under the line's name: its text; a dropdown's choices that say
  // more of themselves, the one the game recommends and what the one picked warns of; and what the change asks, a
  // restart of the client or a reload.
  public tipOf(line: SettingLine): string {
    const parts: array<string> = line.tooltip == "" ? [] : [line.tooltip]
    const setting = line.variable == "" ? nil : Client::Settings?.GetSetting(line.variable)
    if (setting == nil) { return parts.join("\n") }
    if (line.kind == .Choice) {
      const now = self.values[line.variable]
      const fallback = setting.GetDefaultValue()
      let recommended = ""
      let warning = ""
      for (option of self.choicesOf(self.page, line.variable)) {
        const said = option.tooltip
        const disabled = option.disabled
        if (said != nil || disabled != nil) {
          const label = colored(disabled == nil ? HIGHLIGHT : DISABLED, option.label)
          parts.push("")
          parts.push(said == nil ? label : label + ": " + colored(disabled == nil ? NORMAL : DISABLED, said))
          if (disabled != nil) { parts.push(colored(ERROR, disabled)) }
        }
        if (option.value == fallback && option.recommend == true) { recommended = option.label }
        const warns = option.warning
        if (warns != nil && option.value == now) { warning = warns }
      }
      if (recommended != "") {
        parts.push("")
        parts.push(colored(HIGHLIGHT, (Runtime::text("VIDEO_OPTIONS_RECOMMENDED") ?? "") + ": ") + colored(GREEN, recommended))
      }
      if (warning != "") {
        parts.push("")
        parts.push(colored(WARNING, warning))
      }
    }
    if (setting.HasCommitFlag(.ClientRestart)) {
      parts.push("")
      parts.push(colored(ERROR, Runtime::text("VIDEO_OPTIONS_NEED_CLIENTRESTART") ?? ""))
    }
    if (setting.HasCommitFlag(.UIReload)) {
      parts.push("")
      parts.push(colored(ERROR, Runtime::text("VIDEO_OPTIONS_NEED_UIRELOAD") ?? ""))
    }
    return parts.join("\n")
  }

  // The pages a search finds, by their ids: those whose name, or a line's name or tooltip, holds it.
  public matching(query: string): map<integer, boolean> {
    const found: map<integer, boolean> = mut {}
    if (query == "") { return found }
    for (group of self.groups) {
      for (page of group.pages) {
        const lines: array<SettingLine> = self.everyLine[page.id] ?? []
        if (page.name.lower().contains(query) || lines.any((line: SettingLine): boolean => lineMatches(line, query))) {
          found[page.id] = true
        }
      }
    }
    return found
  }
}

// Whether a line's name or tooltip holds the search.
public function lineMatches(line: SettingLine, query: string): boolean {
  return query == "" || line.name.lower().contains(query) || line.tooltip.lower().contains(query)
}
