// The client's key bindings as the «Keys» tab reads and writes them: every command `GetBinding` lists, in the
// client's order, under its section, with its keys (none, one or two). A change is the client's at once: the keys
// set with the command's context (`SetBinding`) and the current set saved (`SaveBindings`), as Blizzard's window
// commits; the window keeps no draft. The last change is kept as a step that puts back, exactly, the keys of every
// command it touched (the command's own, and those of a command a key was taken from). The client refuses every change
// in a fight: each says so and changes nothing.
import Client from "$client"

// A command of the list.
public struct Command implements Plain {
  // The client's name for it (`MOVEFORWARD`), and the one the player reads (`GetBindingName`).
  action: string
  name: string
  // Its section's text: the header's (`BINDING_HEADER_MOVEMENT`) in the client's language.
  section: string
  // Its keys in the client's order: the first and the second.
  keys: array<string>
}

// What a change did to one command: its keys before it.
public struct Before implements Plain {
  action: string
  keys: array<string>
}

// The last change, for «Undo»: each command it touched, with its keys before. `taken` names the command a key was
// taken from (`""` where none was), with the key.
public struct Step implements Plain {
  before: array<Before>
  taken: string
  key: string
}

// Why a change wasn't made.
public enum Refusal { Fight, Client }

// A list's caption for the actions that are no command: Blizzard's spacers and texts between them.
function isCommand(action: string): boolean {
  return action.sub(1, 6) != "HEADER" && action.sub(1, 7) != "PREFACE"
}

// A section's text: the global its header names, or the name itself where the client has no text; a command with
// none stands under «Other», as in Blizzard's window.
function sectionOf(category: string | nil): string {
  const name = category ?? "BINDING_HEADER_OTHER"
  const text = Client::getglobal(name)
  return text is string ? text : name
}

function keysOf(first: string | nil, second: string | nil): array<string> {
  const keys: array<string> = mut []
  if (first != nil) { keys.push(first) }
  if (second != nil) { keys.push(second) }
  return keys
}

public class Bindings {
  public state commands: array<Command> = []
  // The set the keys are kept in: the account's or this character's.
  public state set: Client::BindingSet = Client::BindingSet::Account
  public state step: Step | nil = nil
  // Where each command stands in `commands`.
  state places: map<string, integer> = {}

  // The list read anew, in one pass.
  public mut read() {
    const commands: array<Command> = mut []
    const places: map<string, integer> = mut {}
    const count = Client::GetNumBindings().floor()
    for (i of 1..count) {
      const (action, category, first, second) = Client::GetBinding(i)
      if (isCommand(action)) {
        commands.push({ action: action, name: Client::GetBindingName(action), section: sectionOf(category), keys: keysOf(first, second) })
        places[action] = commands.length
      }
    }
    self.commands = commands
    self.places = places
    self.set = Client::GetCurrentBindingSet()
  }

  public command(action: string): Command | nil {
    const at = self.places[action]
    return at == nil ? nil : self.commands[at]
  }

  // The command a key does now, in that command's context, or `""`.
  public holder(action: string, key: string): string {
    return Client::GetBindingAction(key, false, Client::C_KeyBindings::GetBindingContextForAction(action))
  }

  // The command's key at `slot` (1 or 2) set to `key`: the key leaves its other slot, and whatever command held it
  // loses it (the client takes it), which the step records.
  public mut bind(action: string, slot: integer, key: string): Refusal | nil {
    const before = self.command(action)?.keys ?? []
    const keys = before.filter(held => held != key)
    if (slot <= keys.length) {
      keys[slot] = key
    } else {
      keys.push(key)
    }
    const holder = self.holder(action, key)
    const changes: array<Before> = mut [{ action: action, keys: before.clone() }]
    if (holder != "" && holder != action) {
      changes.push({ action: holder, keys: (self.command(holder)?.keys ?? []).clone() })
    }
    const taken = holder != action ? holder : ""
    return self.change(changes, [{ action: action, keys: keys }], taken, key)
  }

  // The command loses one key.
  public mut unbind(action: string, key: string): Refusal | nil {
    const before = self.command(action)?.keys ?? []
    return self.change([{ action: action, keys: before.clone() }], [{ action: action, keys: before.filter(held => held != key) }], "", "")
  }

  // The command's keys made `keys` (its default keys, read from the default set).
  public mut reset(action: string, keys: array<string>): Refusal | nil {
    const before = self.command(action)?.keys ?? []
    return self.change([{ action: action, keys: before.clone() }], [{ action: action, keys: keys.clone() }], "", "")
  }

  // The last step put back: every command it touched gets its keys before it, and the set is saved once.
  public mut undo(): Refusal | nil {
    const step = self.step
    if (step == nil) { return nil }
    if (Client::InCombatLockdown()) { return .Fight }
    for (i of step.before.length..1 step -1) {
      const was = step.before[i] ?? panic("a command the step touched")
      _ = self.put(was.action, was.keys)
    }
    Client::SaveBindings(self.set)
    self.step = nil
    self.read()
    return nil
  }

  // Every key back to the client's defaults, kept in the current set (Blizzard's «Defaults»).
  public mut resetAll(): Refusal | nil {
    if (Client::InCombatLockdown()) { return .Fight }
    Client::LoadBindings(.Default)
    Client::SaveBindings(self.set)
    self.step = nil
    self.read()
    return nil
  }

  // The keys kept for this character alone, or for the account. Turning to the character's copies the account's
  // keys into it; turning back drops the character's (the window asks first), as Blizzard's checkbox does.
  public mut keepFor(character: boolean): Refusal | nil {
    if (Client::InCombatLockdown()) { return .Fight }
    if (character) {
      Client::SaveBindings(.Account)
      Client::LoadBindings(.Character)
      Client::SaveBindings(.Character)
    } else {
      Client::LoadBindings(.Account)
      Client::SaveBindings(.Account)
    }
    self.step = nil
    self.read()
    return nil
  }

  // `after`'s commands given their keys; where the client refuses one, every command is put back as `before` says.
  mut change(before: array<Before>, after: array<Before>, taken: string, key: string): Refusal | nil {
    if (Client::InCombatLockdown()) { return .Fight }
    for (wanted of after) {
      if (!self.put(wanted.action, wanted.keys)) {
        for (was of before) { _ = self.put(was.action, was.keys) }
        self.read()
        return .Client
      }
    }
    Client::SaveBindings(self.set)
    self.step = { before: before, taken: taken, key: key }
    self.read()
    return nil
  }

  // A command's keys made exactly `keys`: the ones it has unbound, then each bound in order (the client keeps the
  // first bound first). False where the client refuses a key.
  public put(action: string, keys: array<string>): boolean {
    const context = Client::C_KeyBindings::GetBindingContextForAction(action)
    const (first, second) = Client::GetBindingKey(action, nil, context)
    for (held of keysOf(first, second)) { _ = Client::SetBinding(held, nil, context) }
    for (key of keys) {
      if (!Client::SetBinding(key, action, context)) { return false }
    }
    return true
  }
}
