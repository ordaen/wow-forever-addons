// The game menu (Escape's `GameMenuFrame`), dressed. Blizzard's buttons stay Blizzard's, each with its own click: the
// dress draws a plate of ours where each stands (Blizzard's at alpha 0, its mouse kept), the exits in red, a «new»
// label of Blizzard's as the gem on its button. «AddOns» is ours, a plate laid over Blizzard's in its slot
// (Blizzard's at alpha 0, the mouse off it), and opens Ordaen's AddOns window. The plates stand `space(.Item)` apart:
// each is its button less half the gap above and below, and the button's mouse is cut to it (its hit insets). The
// dialog's frame round the menu, its title engraved inside near its top with a carved groove under it. The menu
// itself takes no mouse while dressed: shown, the client raises it over everything of its strata, ours too, and it
// would take the click meant for our «AddOns». Nothing is written on Blizzard's frames but their alpha, mouse and hit
// insets; what is kept per button is this file's own weak table, and every widget is put back as the dress ends.
import { Align, Anchored, Art, Layer, Point, Position, Shadow, Stated } from "$ltml"
import Client from "$client"
import { Component, PX, space } from "Ordaen"
import root Ordaen from "Ordaen"

// The dress's head, from its top: the frame's band, a gap, the title's line, a gap, the carved groove, the gap to
// Blizzard's first button.
const TITLE_TOP: Number = 14 * PX + space(.Item)
// The title's text, as tall as it is drawn.
const TITLE_LINE = 18 * PX
const GROOVE_TOP: Number = TITLE_TOP + TITLE_LINE + space(.Item)
const GROOVE = 4 * PX
const GROOVE_SIDE = 40 * PX
const HEAD: Number = GROOVE_TOP + GROOVE + space(.Group)
// Half the gap between two plates: taken off each plate above and below.
const HALF_GAP: Number = space(.Item) / 2
const TITLE: Color = Color.hex("#ffd100")
const ENGRAVED: Shadow = { color: Color.hex("#000000e6"), x: -1 * PX, y: 1 * PX }
const LABEL: Color = Color.hex("#ffd100")
// «AddOns», ours: its label white under the cursor and down while pressed, as a PushButton's.
const OWN_DROP: Stated<Number> = { default: 0, pressed: 2 * PX }
const OWN_LABEL: Stated<Color> = { default: Color.hex("#ffd100"), hover: Color.hex("#ffffff") }
const LABEL_HOVER: Color = Color.hex("#ffffff")
const SHADOW: Shadow = { color: Color.hex("#000000"), x: 1 * PX, y: -1 * PX }
const GEM = 16 * PX
const GEM_LEFT = 12 * PX
const DOWN = 2 * PX

// One of Blizzard's buttons as the dress draws it.
public struct Dressed {
  button: any Client.Button
  label: String
  // One of the exits: in red.
  accent: Boolean
  // Blizzard's «new» label hangs by it.
  gem: Boolean
  // «AddOns»: ours stands over it.
  addons: Boolean
  width: Number
  height: Number
}

// The values a client's call gives, one after another, as a list.
function framesOf(...frames: any Client.Frame): Array<any Client.Frame> {
  const list: Array<any Client.Frame> = []
  for (i of 1..=frames.length) {
    const frame = frames[i]
    if (frame != nil) { list.push(frame) }
  }
  return list
}

// A frame's own textures and texts at an alpha: its art.
function fade(alpha: Number, ...regions: any Client.Region) {
  for (i of 1..=regions.length) {
    const region = regions[i]
    if (region is Client.Texture) { region.SetAlpha(alpha) }
    if (region is Client.FontString) { region.SetAlpha(alpha) }
  }
}

// Whether what a hook of the client's calls still runs: the hook holds this, and calls nothing once it is off.
public struct Live {
  on: Boolean
}

// The game menu as the dress sees it: whether it shows, its buttons and its size, read again at each show and each
// time Blizzard builds its buttons anew.
public class GameMenu {
  public state shown = false
  public state buttons: Array<Dressed> = []
  public state width: Number = 0
  public state height: Number = 0
  // How far Blizzard's first button stands under the menu's top (its point on the menu's), nothing when it stands by
  // something else.
  public state lead: Number = 0
  // The button under the cursor and the one held down: Blizzard's, which keep the mouse.
  public state hovered: any Client.Button | nil = nil
  public state held: any Client.Button | nil = nil
  // The buttons already hooked: a pooled button is hooked once, whatever it holds later.
  hooked: mut WeakMap<any Client.Button, Boolean> = {}
  // Whether the dress is on: a hook of the client's can't be taken back, so a hook finds it off once the dress ends,
  // and calls nothing of it.
  const live: mut Live = { on: true }

  constructor() {
    const menu = Client.GameMenuFrame
    const live = self.live
    _ = menu.HookScript("OnShow", (...args: Unknown): nil => {
      if (live.on) { self.onShow() }
    })
    _ = menu.HookScript("OnHide", (...args: Unknown): nil => {
      if (live.on) { self.onHide() }
    })
    Client.hooksecurefunc(menu, "InitButtons", (...args: Unknown): nil => {
      if (live.on) { self.onInit() }
    })
  }

  destructor() {
    self.live.on = false
    self.restore()
  }

  // The menu shows (its `OnShow`, after Blizzard built its buttons).
  public onShow(mut self) {
    self.shown = true
    self.match()
  }

  onHide(mut self) {
    self.shown = false
    self.hovered = nil
    self.held = nil
  }

  onInit(mut self) {
    if (peek self.shown) { self.match() }
  }

  // Blizzard's buttons by their text against the client's own strings, in every language; Blizzard's art at alpha 0.
  match(mut self) {
    const menu = Client.GameMenuFrame
    const options = menu.NewOptionsFrame.IsShown()
    const event = menu.NewExternalEventFrame.IsShown()
    fade(0, ...menu.GetRegions())
    menu.EnableMouse(false)
    const list: Array<Dressed> = []
    for (child of framesOf(...menu.GetChildren())) {
      if (child is Client.Button) {
        if (child.IsShown()) {
          const label = child.GetText()
          const addons = label == Client.ADDONS
          child.SetAlpha(0)
          child.EnableMouse(!addons)
          child.SetHitRectInsets(0, 0, HALF_GAP, HALF_GAP)
          self.hook(child)
          list.push({
            button: child,
            label: label,
            accent: label == Client.LOG_OUT || label == Client.EXIT_GAME,
            gem: (options && label == Client.GAMEMENU_OPTIONS) || (event && label == Client.GAMEMENU_EXTERNALEVENT),
            addons: addons,
            width: child.GetWidth(),
            height: child.GetHeight(),
          })
        }
      } else {
        // Blizzard's frame, its title and its «new» labels: the dress draws its own.
        child.SetAlpha(0)
      }
    }
    self.buttons = list
    self.width = menu.GetWidth()
    self.height = menu.GetHeight()
    self.lead = 0
    const first = list[1]
    if (first != nil) {
      const point, relative, to, _, y = first.button.GetPoint(1, nil)
      if (relative == menu && point == to && y != nil) { self.lead = -y }
    }
  }

  // The cursor and the press on a button of Blizzard's: hooked once, read by the plate drawn there.
  hook(mut self, button: any Client.Button) {
    if (self.hooked[button] == true) { return }
    self.hooked[button] = true
    const live = self.live
    _ = button.HookScript("OnEnter", (...args: Unknown): nil => {
      if (live.on) { self.hovered = button }
    })
    _ = button.HookScript("OnLeave", (...args: Unknown): nil => {
      if (live.on) { self.onLeave(button) }
    })
    _ = button.HookScript("OnMouseDown", (...args: Unknown): nil => {
      if (live.on) { self.held = button }
    })
    _ = button.HookScript("OnMouseUp", (...args: Unknown): nil => {
      if (live.on) { self.held = nil }
    })
  }

  onLeave(mut self, button: any Client.Button) {
    if (peek self.hovered == button) { self.hovered = nil }
  }

  // Every widget as Blizzard had it.
  restore(self) {
    const menu = Client.GameMenuFrame
    fade(1, ...menu.GetRegions())
    menu.EnableMouse(true)
    for (child of framesOf(...menu.GetChildren())) {
      child.SetAlpha(1)
      if (child is Client.Button) {
        child.EnableMouse(true)
        child.SetHitRectInsets(0, 0, 0, 0)
      }
    }
  }

  public close(self) { Client.HideUIPanel(Client.GameMenuFrame) }
}

// A plate of ours where one of Blizzard's buttons stands, half the gap shorter above and below. Blizzard's button
// keeps the mouse, so the plate follows its cursor and its press as the menu hears them; on «AddOns» the plate is
// ours alone and hears them itself.
public class Plate implements Component {
  // «AddOns» was clicked.
  public pick: Event<nil> = new Event()

  derived over: Boolean = self.menu.hovered == self.dressed.button
  derived down: Boolean = self.menu.held == self.dressed.button
  derived art: Art = self.dressed.accent ? (self.down ? Ordaen.art.ctl.buttonAccentDown : Ordaen.art.ctl.buttonAccent) :
    self.down ? Ordaen.art.ctl.buttonDown : Ordaen.art.ctl.button
  derived light: Number = self.over ? 1 : 0
  derived color: Color = self.over ? LABEL_HOVER : LABEL
  derived drop: Number = self.down ? DOWN : 0
  derived gem: Number = self.dressed.gem ? 1 : 0
  derived high: Number = self.dressed.height - 2 * HALF_GAP
  derived gemTop: Number = (self.high - GEM) / 2
  derived place: Anchored = { point: Point.TopLeft, to: Point.TopLeft, y: HALF_GAP, by: self.dressed.button }
  // «AddOns», ours: lit while the cursor is on it.
  derived ownLight: Number = self.ownOver ? 1 : 0
  state ownOver = false

  dressed: Signal<Dressed>
  const menu: GameMenu
  constructor(dressed: Signal<Dressed>, menu: GameMenu) {
    self.dressed = dressed
    self.menu = menu
  }

  onClick(self) { self.pick.emit() }
  onEnter(mut self) { self.ownOver = true }
  onLeave(mut self) { self.ownOver = false }

  public render(self): Template {
    return $ltml {
      <surface layer={Layer.Dialog} place={self.place} width={self.dressed.width} height={self.high}>
        <box $if={self.dressed.addons} position={Position.Absolute} left={0} top={0} right={0} bottom={0}
             background={Ordaen.art.ctl.button} @click={self.onClick} @enter={self.onEnter} @leave={self.onLeave}>
          <box position={Position.Absolute} left={0} top={0} right={0} bottom={0} background={Ordaen.art.ctl.buttonLight}
               opacity={self.ownLight} />
          <box position={Position.Absolute} left={0} right={0} top={OWN_DROP} height={self.high}
               xAlign={Align.Center} yAlign={Align.Center} stateFromParent={true}>
            <text value={self.dressed.label} textColor={OWN_LABEL} textShadow={SHADOW} wrap={false}
                  stateFromParent={true} />
          </box>
        </box>
        <box $else position={Position.Absolute} left={0} top={0} right={0} bottom={0} background={self.art}>
          <box position={Position.Absolute} left={0} top={0} right={0} bottom={0}
               background={Ordaen.art.ctl.buttonLight} opacity={self.light} />
          <box position={Position.Absolute} left={GEM_LEFT} top={self.gemTop} width={GEM} height={GEM}
               background={Ordaen.art.ctl.newGem} opacity={self.gem} zLevel={1} />
          <box position={Position.Absolute} left={0} right={0} top={self.drop} height={self.high}
               xAlign={Align.Center} yAlign={Align.Center}>
            <text value={self.dressed.label} textColor={self.color} textShadow={SHADOW} wrap={false} />
          </box>
        </box>
      </surface>
    }
  }
}

// The dress: the dialog's frame round Blizzard's menu, grown upward to hold its engraved title and carved groove; a
// plate on each of Blizzard's buttons, «AddOns» ours.
public class MenuDress implements Component {
  // «AddOns» was clicked.
  public addons: Event<nil> = new Event()

  derived wide: Number = self.menu.width
  // The head stands over Blizzard's first button, which stands `lead` under the menu's top.
  derived high: Number = self.menu.height - self.menu.lead + HEAD

  // Made as the menu first shows: dressed at once, then at each show.
  const menu: mut GameMenu = new GameMenu()
  constructor() { self.menu.onShow() }

  onAddons(mut self) {
    self.addons.emit()
    self.menu.close()
  }

  public render(self): Template {
    return $ltml {
      <$if={self.menu.shown}>
        <surface layer={Layer.Dialog} place={{ point: Point.Bottom, to: Point.Bottom, by: Client.GameMenuFrame }}
                 width={self.wide} height={self.high} border={Ordaen.art.frame.small}
                 background={Ordaen.art.window.wood} artOrigin={true} ownsGaps={true}>
          <box position={Position.Absolute} left={GROOVE_SIDE} right={GROOVE_SIDE} top={TITLE_TOP}
               xAlign={Align.Center}>
            <text value={Client.MAINMENU_BUTTON} textColor={TITLE} textShadow={ENGRAVED} wrap={false} />
          </box>
          <box position={Position.Absolute} left={GROOVE_SIDE} right={GROOVE_SIDE} top={GROOVE_TOP} height={GROOVE}
               background={Ordaen.art.ctl.carved} />
        </surface>
        <Plate $for={dressed of self.menu.buttons} dressed={dressed} menu={self.menu} @pick={self.onAddons} />
      </>
    }
  }
}
