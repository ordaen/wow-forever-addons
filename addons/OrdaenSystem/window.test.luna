// The AddOns window as the player meets it: opened by the game menu's «AddOns», the client's addons by category with
// Ordaen's modules under Ordaen, each row's state and numbers; switching on with what an addon needs and «Undo»,
// switching off what others need after a question, Ctrl on a group's parent, a caption's switch, for whom; the search,
// the filter, the sort and the table; a row's menu; the card; «Reset», sets and «Reload»; the numbers read only while
// it shows; how the player left the list, kept in the profile. The client's list is the stand-in's (the runtime,
// Ordaen, Ordaen System) and the addons a test's `World` adds after it: a test that adds them says so to the client's
// functions that list addons, and to those that switch them where it switches one of its own.
import Build from "$build"
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Art, Key } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import Locale from "@/locales"
import Style from "@/style"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1300, height: 760, screen: true }
// A text the settings window always shows.
const SETTINGS = "Move mode"
// The client's interface for an addon built for it, and for one built for an older client.
const CURRENT = 16001
const OLDER = 11507

// An addon the test adds to the client's list, as its TOC says it and as the client has it.
struct Fake {
  const name: String
  const title: String
  const notes: String = ""
  const author: String = ""
  const version: String = ""
  const category: String = ""
  const group: String = ""
  const demand: Boolean = false
  const outdated: Boolean = false
  // Why the client doesn't load it while it is on: nil where it does.
  const reason: Client.AddOnReason | nil = nil
  loaded: Boolean = false
  // What `LoadAddOn` answers where it refuses one on demand.
  const refuses: String | nil = nil
  const icon: String = ""
}

// The client's list of addons as the test makes it, and what the client keeps of them: off for this character, the
// characters differing (as the stand-in keeps them), each as this session has it and as last saved. A test that
// answers the client's functions from it answers for every addon (an answer replaces the stand-in's whole), so the
// list starts with the stand-in's own three as their TOCs say them; what each needs is the stand-in's.
class World {
  public fakes: mut Array<mut Fake>
  public off: mut Map<String, Boolean> = {}
  public split: mut Map<String, Boolean> = {}
  public savedOff: mut Map<String, Boolean> = {}
  savedSplit: mut Map<String, Boolean> = {}

  constructor(fakes: mut Array<mut Fake>) { self.fakes = fakes }

  fake(self, name: String | Integer): Fake | nil {
    if (name is Integer) { return self.fakes[name] }
    return self.fakes.find(fake => fake.name == name)
  }

  // An addon taken out of the folder.
  public remove(mut self, name: String) {
    let at = 0
    for (index, fake of self.fakes) {
      if (fake.name == name) { at = index }
    }
    _ = self.fakes.remove(at)
  }

  public count(self): Number { return self.fakes.length }

  public name(self, index: String | Integer): String { return self.fake(index)?.name ?? "" }

  public metadata(self, name: String | Integer, field: String): String | nil {
    const fake = self.fake(name)
    if (fake == nil) { return nil }
    const value = match (field) {
      "Title" => fake.title
      "Notes" => fake.notes
      "Author" => fake.author
      "Version" => fake.version
      "Category" => fake.category
      "Group" => fake.group
      "IconTexture" => fake.icon
      else => ""
    }
    return value == "" ? nil : value
  }

  public demand(self, name: String | Integer): Boolean { return self.fake(name)?.demand == true }

  public interface(self, name: String | Integer): Number { return self.fake(name)?.outdated == true ? OLDER : CURRENT }

  public state(self, name: String | Integer, character: String | nil): Client.AddOnEnableState {
    const fake = self.fake(name)
    if (fake == nil) { return .None }
    if (character == nil && self.split[fake.name] == true) { return .Some }
    return self.off[fake.name] == true ? .None : .All
  }

  public turn(mut self, name: String | Integer, character: String | nil, isOff: Boolean) {
    const fake = self.fake(name)
    if (fake == nil) { return }
    const key = fake.name
    if (character == nil) {
      self.split[key] = nil
    } else if ((self.off[key] == true) != isOff) {
      self.split[key] = self.split[key] == true ? nil : true
    }
    self.off[key] = isOff ? true : nil
  }

  public save(mut self) {
    self.savedOff = self.off.clone()
    self.savedSplit = self.split.clone()
  }

  public reset(mut self) {
    self.off = self.savedOff.clone()
    self.split = self.savedSplit.clone()
  }

  public loaded(self, name: String | Integer): (Boolean, Boolean) {
    const done = self.fake(name)?.loaded == true
    return done, done
  }

  public loadable(self, name: String | Integer, character: String | nil, demandLoaded: Boolean | nil): (
    Boolean, Client.AddOnReason | nil
  ) {
    const fake = self.fake(name)
    if (fake == nil) { return false, "MISSING" }
    const reason = self.reason(fake, demandLoaded == true)
    return reason == nil, reason
  }

  // Why the client doesn't load an addon: off, what it needs missing or not loading, its own reason, or on demand.
  reason(self, fake: Fake, demandLoaded: Boolean): Client.AddOnReason | nil {
    if (self.off[fake.name] == true) { return "DISABLED" }
    for (need of needsOf(...Client.C_AddOns.GetAddOnDependencies(fake.name))) {
      const other = self.fake(need)
      if (other == nil) { return "DEP_MISSING" }
      if (self.reason(other, true) != nil) { return "DEP_DISABLED" }
    }
    if (fake.reason != nil) { return fake.reason }
    if (fake.demand && !demandLoaded) { return "DEMAND_LOADED" }
    return nil
  }

  public load(mut self, name: String | Integer): (Boolean | nil, String | nil) {
    const fake = self.fake(name)
    if (fake == nil) { return false, "MISSING" }
    const reason = self.reason(fake, true)
    if (reason != nil) { return false, reason }
    if (!fake.demand) { return false, "NOT_DEMAND_LOADED" }
    if (fake.refuses != nil) { return false, fake.refuses }
    for (held of self.fakes) {
      if (held.name == fake.name) { held.loaded = true }
    }
    return true, nil
  }
}

// What a client's call gives, one after another, as a list.
function needsOf(...names: String): Array<String> {
  const list: Array<String> = []
  for (i of 1..=names.length) { list.push(names[i] ?? "") }
  return list
}

// The stand-in's own three, as their TOCs say them; then three addons of other authors: one in its category, loaded;
// one built for an older client, which the client doesn't load; one on demand, not loaded, with no category.
function everyday(): mut Array<mut Fake> {
  return [
    { name: "LunaType", title: "LunaType", loaded: true },
    {
      name: "Ordaen", title: "Ordaen", notes: "Ordaen Core: what every Ordaen module runs in. Its settings: /ordaen.",
      version: "1.0.0", category: "User Interface", loaded: true
    },
    {
      name: "OrdaenSystem", title: "Ordaen System", category: "User Interface", group: "Ordaen", demand: true,
      loaded: true
    },
    { name: "Bagger", title: "Bagger", notes: "All bags in one window.", author: "Ann", version: "2.1", category: "Inventory", loaded: true },
    { name: "OldMap", title: "Old Map", version: "1.0", category: "Map", outdated: true, reason: "INTERFACE_VERSION" },
    { name: "Chatter", title: "Chatter", author: "Bo", demand: true }
  ]
}

// What the client measures of each addon while it measures: CPU now and at its peak (in per cent of the client's own
// time, 10 now and at its peak, 20 on average), the frames over 5 and over 50 ms, memory in KB; how often it was
// sampled and weighed.
class Meter {
  public now: mut Map<String, Number> = {}
  public peak: mut Map<String, Number> = {}
  public spikes: mut Map<String, Number> = {}
  public spikes50: mut Map<String, Number> = {}
  public memory: mut Map<String, Number> = {}
  public samples = 0
  public weighed = 0
  constructor() {}

  public whole(mut self, metric: Client.AddOnProfilerMetric): Number {
    if (metric == .RecentAverageTime) { self.samples += 1 }
    return metric == .SessionAverageTime ? 20 : 10
  }

  public of(self, name: String, metric: Client.AddOnProfilerMetric): Number {
    return match (metric) {
      .RecentAverageTime => self.now[name] ?? 0
      .PeakTime => self.peak[name] ?? 0
      .SessionAverageTime => self.now[name] ?? 0
      .EncounterAverageTime => (self.peak[name] ?? 0) / 2
      .CountTimeOver5Ms => self.spikes[name] ?? 0
      .CountTimeOver50Ms => self.spikes50[name] ?? 0
      else => 0
    }
  }

  // Every addon together, now: 1.4 of the client's 10.
  public overall(self, metric: Client.AddOnProfilerMetric): Number { return metric == .RecentAverageTime ? 1.4 : 0 }

  // The ten heaviest now, as the client names them: those over 1 % here.
  public top(self, metric: Client.AddOnProfilerMetric, k: Number): Array<Client.AddOnProfilerResult> {
    const list: Array<Client.AddOnProfilerResult> = []
    if (metric != .RecentAverageTime || k != 10) { return list }
    for (name, now of self.now) {
      if (now >= 1) { list.push({ addOnName: name, metricValue: now }) }
    }
    return list
  }

  public weigh(mut self) { self.weighed += 1 }

  public kb(self, name: String | Integer): Number { return name is String ? self.memory[name] ?? 0 : 0 }
}

// The AddOns window: found by «Reset», which its footer always shows.
function window(): Test.Part {
  return Test.page().window(Locale.RESET)
}

// The game menu shown by Escape, as the player opens it (the client lays it out on the frame after).
function gameMenu() {
  _ = Test.key(Key.Escape)
  Test.pass(0.02)
}

// The window opened as the player opens it: Escape, then the menu's «AddOns».
function open() {
  gameMenu()
  Test.page().text(Client.ADDONS).click()
}

// An addon's row, or a category's caption, by its title: the first drawn, the list's (the card may name it too).
function row(title: String): Test.Part {
  return window().text(title).nth(1).item()
}

// Whether a part's texts read exactly this, joined by « | »: where they don't, the test fails with what they read.
function reads(part: Test.Part, expected: String): Boolean {
  return same(part.texts().join(" | "), expected)
}

// Whether a text is exactly this: where it isn't, the test fails with what it is.
function same(read: String, expected: String): Boolean {
  if (read != expected) { panic(`it reads «${read}», not «${expected}»`) }
  return true
}

// Whether a row's switch is on (lit whole), off, or on for some (its knob halfway, lit at half).
function switchOn(part: Test.Part): Boolean {
  return part.button(Ordaen.art.ctl.switchOn).shown() && part.box(Ordaen.art.ctl.knobOn).opacity() == 1
}
function switchOff(part: Test.Part): Boolean { return part.button(Ordaen.art.ctl.switchOff).shown() }
function switchSome(part: Test.Part): Boolean { return part.box(Ordaen.art.ctl.knobOn).opacity() == 0.5 }

// A row's switch clicked.
function flip(title: String) {
  const part = row(title)
  part.button(switchOff(part) ? Ordaen.art.ctl.switchOff : Ordaen.art.ctl.switchOn).click()
}

// The question's dialog: found by its title.
function question(title: String): Test.Part {
  return Test.page().window(Locale.DISABLE_TITLE.format(title))
}

// A choice of one of the header's pickers: the picker by its glyph, then the choice in its list.
function pick(glyph: Art, choice: String) {
  window().button(glyph).click()
  Test.page().window(choice).button(choice).click()
}

// A kind of the filter picked: its list opened, the choice clicked, the list closed again by a click on the button.
function filter(choice: String) {
  window().button(Ordaen.art.ctl.tool.filter).click()
  Test.page().window(Locale.FILTER_PERFORMANCE).button(choice).click()
  window().button(Ordaen.art.ctl.tool.filter).click()
}

// The window's texts in the order drawn: the list and its footer up to «Reload», and the card's after it.
function listed(): Array<String> {
  const texts = window().texts()
  const list: Array<String> = []
  for (text of texts) {
    if (text == Locale.RELOAD) { break }
    list.push(text)
  }
  return list
}

// The titles of the addons' rows in the order they stand, captions left out.
function titles(): String {
  const names = ["Bagger", "Old Map", "Ordaen", "Ordaen System", "Chatter", "LunaType", "Ordaen Bank", "Fresh"]
  return listed().filter(text => names.any(name => name == text)).join(", ")
}

// What the card says, joined by « | »: the window's texts after its footer's «Reload», up to its tab's title.
function card(): String {
  const texts = window().texts()
  const list: Array<String> = []
  let after = false
  for (text of texts) {
    if (after && text == Client.ADDONS) { break }
    if (after) { list.push(text) }
    if (text == Locale.RELOAD) { after = true }
  }
  return list.join(" | ")
}

// A row's menu of quick actions: right-click on it, the menu found by «Details», which it always offers.
function menu(title: String): Test.Part {
  row(title).rightClick()
  return Test.page().window(Locale.MENU_DETAILS)
}

// Ordaen's settings window, opened by `/ordaen`.
function settings(): Test.Part {
  (Client.SlashCmdList["ORDAEN"] ?? panic("/ordaen is Ordaen's command"))("")
  return Test.page().window(SETTINGS)
}

// Opened

test "the menu's «AddOns» opens the window and shuts the menu; Blizzard's list stays shut" {
  Test.mount(nil, SCREEN)
  open()
  Test.expect(window().shown() && !Test.page().text(Client.MAINMENU_BUTTON).shown())
  Test.expect(!Client.AddonList.IsShown())
}

test "Escape closes the window, and the menu's «AddOns» opens it again" {
  Test.mount(nil, SCREEN)
  open()
  _ = Test.key(Key.Escape)
  Test.expect(!window().shown())
  open()
  Test.expect(window().shown())
}

test "the list stands by category, a caption with its count over its addons, «Other» last, modules under Ordaen" {
  const world = new World(everyday())
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Test.mount(nil, SCREEN)
  open()
  Test.expect(reads(
    window(),
    "Search by title, folder, author, notes | 6 | AddOn | Now | Peak | Memory | Inventory | 1 | Bagger | — | — | 0 KB | " +
      `Map | 1 | Old Map | ${Client.ADDON_INTERFACE_VERSION} | — | — | — | User Interface | 2 | Ordaen | — | — | 0 KB | ` +
      "Ordaen System | on in Ordaen | — | — | 0 KB | Other | 2 | Chatter | on demand | — | — | — | LunaType | — | — | " +
      "0 KB | The client isn't measuring addons. | Reset | Sets | Reload | AddOns | 6 of 6"
  ))
}

test "a title keeps its colours on its row, and sorts as it reads without them" {
  const world = new World(everyday())
  world.fakes.push({ name: "Zed", title: "|cff33ff99Arrows|r", category: "Inventory", loaded: true })
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Test.mount(nil, SCREEN)
  open()
  Test.expect(reads(row("Inventory"), "Inventory | 2"))
  Test.expect(window().texts().join(" | ").contains("Inventory | 2 | |cff33ff99Arrows|r | — | — | 0 KB | Bagger"))
}

test "the cursor on a row shows its title and notes, without their colour codes" {
  const world = new World(everyday())
  world.fakes.push({ name: "Zed", title: "|cff33ff99Zed|r", notes: "In |cffffffffwhite|r.", category: "Inventory", loaded: true })
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Test.mount(nil, SCREEN)
  open()
  row("|cff33ff99Zed|r").hover()
  Test.expect(reads(Test.page().window("In white."), "Zed | In white."))
}

test "an addon with no notes shows no tip" {
  const world = new World(everyday())
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Test.mount(nil, SCREEN)
  open()
  row("Chatter").hover()
  Test.expect(Test.page().window("Chatter").count() == 1)
