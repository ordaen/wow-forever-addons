// The AddOns window on the stand-in's list of addons (Ordaen, its modules, the runtime): opened from the game menu,
// the list by category with Ordaen's modules under Ordaen; switching on with what an addon needs and «Undo»;
// switching off what others need asks first; Ctrl on a group's parent switches the group; for whom; the search, the
// filter and the table; the card; sets; the reload's secure box; the numbers read only while it shows.
import Client from "$client"
import Game from "$game"
import { Key } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import root System from "OrdaenSystem"
import { AddOnsWindow, ListView } from "@/addonsWindow"
import Locale from "@/locales"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1300, height: 760, screen: true }

test "at login the module holds one hook and nothing else: no dress, no window, no data" {
  Test.mount(nil, SCREEN)
  Test.flush()
  Test.expect(!System.dressed)
  Test.expect(!System.made)
  Test.expect(Test.surfaces().length == 0)
}

test "the menu's «AddOns» opens the window: by category, Ordaen's modules under Ordaen, said on in Ordaen" {
  Test.mount(nil, SCREEN)
  Test.flush()
  Client.ToggleGameMenu()
  Test.flush()
  Test.click(Test.holding("AddOns", nil), nil)
  Test.flush()
  Test.expect(System.made && System.open)
  Test.shot("the window: User Interface with Ordaen and its modules, the runtime under Other, nothing picked")
  // Escape closes it, as every Ordaen window.
  Test.key(Key.Escape)
  Test.flush()
  Test.expect(!System.open)
}

test "every Ordaen module stands under Ordaen in the client's list, in its category" {
  const own = Runtime.Addon.of(Ordaen) ?? panic("Ordaen is an addon")
  const category = Client.C_AddOns.GetAddOnMetadata(own.name, "Category") ?? ""
  Test.expect(category == "User Interface")
  let modules = 0
  for (addon of own.dependents()) {
    if (Client.C_AddOns.IsAddOnLoadOnDemand(addon.name)) {
      modules += 1
      Test.expect(Client.C_AddOns.GetAddOnMetadata(addon.name, "Group") == own.name)
      Test.expect(Client.C_AddOns.GetAddOnMetadata(addon.name, "Category") == category)
    }
  }
  Test.expect(modules > 0)
}

test "switching off what others need asks first: «Cancel» changes nothing, «Disable» switches it off alone" {
  const window = new AddOnsWindow("Ordaen")
  Test.mount(window, SCREEN)
  Test.flush()
  // Ordaen's checkbox: the first, its modules have none.
  Test.click(Test.painted(Ordaen.art.ctl.check, nil), nil)
  Test.flush()
  Test.shot("the question: Ordaen System stops loading")
  Test.click(Test.holding("Cancel", nil), nil)
  Test.flush()
  Test.expect(window.catalog.isOn("Ordaen"))
  Test.click(Test.painted(Ordaen.art.ctl.check, nil), nil)
  Test.click(Test.holding("Disable", nil), nil)
  Test.flush()
  Test.expect(!window.catalog.isOn("Ordaen"))
  Test.expect(window.catalog.isOn("OrdaenSystem"))
  Test.expect((peek window.catalog.statuses)["OrdaenSystem"]?.reason == "DEP_DISABLED")
  Test.shot("Ordaen off; its module on, its reason the client's")
  Client.C_AddOns.EnableAddOn("Ordaen", nil)
  Client.C_AddOns.SaveAddOns()
  destroy window
}

test "switching on enables what it needs in one step, «Undo» puts back exactly that" {
  const window = new AddOnsWindow("Ordaen")
  Test.mount(window, SCREEN)
  Test.flush()
  window.catalog.switchOff(["Ordaen", "OrdaenSystem"])
  Test.expect(peek window.catalog.step == nil)
  window.catalog.switchOn(["OrdaenSystem"])
  Test.flush()
  Test.expect(window.catalog.isOn("Ordaen") && window.catalog.isOn("OrdaenSystem"))
  const step = peek window.catalog.step
  Test.expect(step != nil && step.also[1] == "Ordaen")
  Test.shot("the strip: also enabled, Ordaen, with «Undo»")
  Test.click(Test.holding("Undo", nil), nil)
  Test.flush()
  Test.expect(!window.catalog.isOn("Ordaen") && !window.catalog.isOn("OrdaenSystem"))
  Test.expect(peek window.catalog.step == nil)
  // «Reset» puts back what the client last saved: the undo saved both off.
  Client.C_AddOns.EnableAddOn("Ordaen", nil)
  window.catalog.reset()
  Test.expect(!window.catalog.isOn("Ordaen"))
  window.catalog.switchOn(["Ordaen", "OrdaenSystem"])
  destroy window
}

test "Ctrl on a group's parent switches the parent and its group together, the parent's new state for all" {
  Game.input.controlDown = (): Boolean => true
  const window = new AddOnsWindow("Ordaen")
  Test.mount(window, SCREEN)
  Test.flush()
  Test.click(Test.painted(Ordaen.art.ctl.check, nil), nil)
  Test.flush()
  Test.expect(!window.catalog.isOn("Ordaen") && !window.catalog.isOn("OrdaenSystem"))
  Test.shot("the group off: Ordaen and every module folder")
  Test.click(Test.painted(Ordaen.art.ctl.check, nil), nil)
  Test.flush()
  Test.expect(window.catalog.isOn("Ordaen") && window.catalog.isOn("OrdaenSystem"))
  destroy window
}

test "for whom: this character's switch leaves the others; all characters shows it on for some" {
  const window = new AddOnsWindow("Ordaen")
  Test.mount(window, SCREEN)
  Test.flush()
  window.list.values.everyone = false
  Test.flush()
  window.catalog.switchOff(["Ordaen"])
  window.list.values.everyone = true
  Test.flush()
  Test.expect((peek window.catalog.statuses)["Ordaen"]?.enabled == .Some)
  Test.shot("Ordaen on for some characters: the tick dim")
  window.catalog.switchOn(["Ordaen"])
  Test.expect((peek window.catalog.statuses)["Ordaen"]?.enabled == .On)
  destroy window
}

test "the search, the filter and the table: what shows, and how many of how many" {
  const window = new AddOnsWindow("Ordaen")
  Test.mount(window, SCREEN)
  Test.flush()
  Test.click(Test.field(nil), nil)
  Test.type("system")
  Test.flush()
  Test.expect(window.visible.length == 1)
  Test.shot("searched: one row, «1 of» the whole list")
  Test.erase(6)
  window.list.values.filter = .Demand
  Test.flush()
  Test.expect(window.visible.all(addon => addon.demand))
  window.list.values.filter = .All
  window.list.values.view = .Table
  Test.flush()
  Test.shot("one table: no captions, the sort's button gone")
  Test.click(Test.holding("AddOn", nil), nil)
  Test.flush()
  Test.expect(window.list.values.descending)
  destroy window
}

test "the card: the picked addon's state, what it needs and what needs it, and an Ordaen module's settings" {
  const window = new AddOnsWindow("Ordaen")
  Test.mount(window, SCREEN)
  Test.flush()
  Test.click(Test.holding("Ordaen System", nil), nil)
  Test.flush()
  Test.expect(window.list.values.picked == "OrdaenSystem")
  Test.shot("the card of Ordaen System: loaded on demand, needs Ordaen, «Ordaen settings»")
  // A link to what it needs picks that row.
  Test.click(Test.holding("Ordaen", 2), nil)
  Test.flush()
  Test.expect(window.list.values.picked == "Ordaen")
  Test.shot("the card of Ordaen: needed by its modules")
  // A module's state opens Ordaen's settings at it: one more surface, the settings window.
  const before = Test.surfaces().length
  Test.click(Test.holding("on in Ordaen", nil), nil)
  Test.flush()
  Test.expect(Test.surfaces().length > before)
  destroy window
}

test "sets: saved under a name, applied (one not in the folder skipped), renamed, deleted" {
  const window = new AddOnsWindow("Ordaen")
  Test.mount(window, SCREEN)
  Test.flush()
  Test.click(Test.holding("Sets ▾", nil), nil)
  Test.click(Test.holding("Save current as…", nil), nil)
  Test.flush()
  // The search's field is the first; the set's name the second.
  Test.click(Test.field(2), nil)
  Test.type("Raid")
  Test.click(Test.holding("Save", nil), nil)
  Test.flush()
  Test.expect(window.sets.list.length == 1)
  Test.expect(window.sets.list[1]?.name == "Raid")
  _ = window.sets.save("Gone", ["Ordaen", "NotThere"])
  window.onSet(3)
  Test.flush()
  Test.click(Test.holding("Apply", nil), nil)
  Test.flush()
  Test.expect(window.setNote != "")
  Test.shot("applied: what isn't in the folder is listed and skipped")
  Test.expect(!window.catalog.isOn("OrdaenSystem"))
  Test.click(Test.holding("Cancel", nil), nil)
  window.onSet(2)
  Test.flush()
  Test.click(Test.holding("Apply", nil), nil)
  Test.flush()
  Test.expect(window.catalog.isOn("OrdaenSystem"))
  window.sets.rename(1, "Solo")
  Test.expect(window.sets.list[1]?.name == "Solo")
  window.sets.remove(1)
  window.sets.remove(1)
  Test.expect(window.sets.list.length == 0)
  destroy window
}

test "«Reload» is a secure box the client runs: /reload; in a fight it waits" {
  const window = new AddOnsWindow("Ordaen")
  Test.mount(window, SCREEN)
  Test.flush()
  Test.click(Test.holding("Reload", nil), nil)
  Test.expect(Test.performed().length == 1)
  Test.combat(true)
  Test.flush()
  Test.shot("in a fight: «Reload» greyed")
  Test.combat(false)
  destroy window
}

test "the numbers: CPU sampled once a second only while the window shows, memory on open and «Refresh» alone" {
  let samples = 0
  let weighed = 0
  Client.C_AddOnProfiler.IsEnabled = (): Boolean => true
  Client.C_AddOnProfiler.GetApplicationMetric = (metric: Client.AddOnProfilerMetric): Number => {
    if (metric == .RecentAverageTime) { samples += 1 }
    return 10
  }
  Client.C_AddOnProfiler.GetAddOnMetric = (name: String, metric: Client.AddOnProfilerMetric): Number => {
    return name == "Ordaen" ? 1 : 0.2
  }
  Client.C_AddOnProfiler.GetOverallMetric = (metric: Client.AddOnProfilerMetric): Number => 1.4
  Client.UpdateAddOnMemoryUsage = (): nil => {
    weighed += 1
  }
  Client.GetAddOnMemoryUsage = (name: String | Integer): Number => name == "Ordaen" ? 2048 : 300
  Test.mount(nil, SCREEN)
  Test.flush()
  System.openWindow()
  Test.flush()
  Test.expect(weighed == 1)
  const first = samples
  Test.expect(first > 0)
  Test.shot("Ordaen the heaviest: 10.0 % now, 2.0 MB, in the accent; all addons 14.0 %")
  Test.pass(1.1)
  Test.expect(samples > first)
  Test.click(Test.painted(Ordaen.art.ctl.tool.refresh, nil), nil)
  Test.expect(weighed == 2)
  System.closeWindow()
  Test.flush()
  const closed = samples
  Test.pass(3.1)
  Test.expect(samples == closed)
  Test.expect(weighed == 2)
}

// The window opened from the game menu, as the player opens it.
function openFromMenu() {
  Client.ToggleGameMenu()
  Test.flush()
  Test.click(Test.holding("AddOns", nil), nil)
  Test.flush()
}

// Where the side's line is, which takes a drag: its column (the card, the room on its sides and the frame's line) in
// from the body's right.
function sideLine(): Test.Point {
  const body = Test.edges(Ordaen.art.window.wood, 0)
  return { x: body.right - 297.4, y: (body.top + body.bottom) / 2 }
}

function near(a: Number, b: Number): Boolean { return (a - b).abs() < 0.01 }

test "the list's filter, view and picked addon, and the card's width, are the profile's: there after a reload" {
  Test.mount(nil, SCREEN)
  Test.flush()
  openFromMenu()
  Test.click(Test.painted(Ordaen.art.ctl.tool.filter, nil), nil)
  Test.flush()
  Test.click(Test.holding(Locale.FILTER_DEMAND, nil), nil)
  Test.flush()
  Test.click(Test.painted(Ordaen.art.ctl.tool.categories, nil), nil)
  Test.flush()
  Test.click(Test.holding(Locale.VIEW_TABLE, nil), nil)
  Test.flush()
  Test.click(Test.holding("Ordaen System", nil), nil)
  Test.flush()
  const before = Test.holding("Ordaen System", 2)
  const line = sideLine()
  Test.moveTo(line)
  Test.press(nil)
  Test.moveTo({ x: line.x - 1, y: line.y })
  Test.pass(0.05)
  Test.moveTo({ x: line.x - 60, y: line.y })
  Test.pass(0.05)
  Test.release(nil)
  Test.flush()
  const title = Test.holding("Ordaen System", 2)
  Test.expect(title.x < before.x - 15)
  const key = "OrdaenSystem:addons"
  const kept = ListView.decode(Ordaen.keeper.profiles.recalled(Ordaen.keeper.profiles.active, key), ListView {})
  Test.expect(kept.filter == .Demand && kept.view == .Table && kept.picked == "OrdaenSystem")
  Test.reload()
  Test.flush()
  openFromMenu()
  // The card stands beside the list again, as wide as it was dragged to.
  const again = Test.holding("Ordaen System", 2)
  Test.expect(near(again.x, title.x) && near(again.y, title.y))
  Test.expect(Ordaen.keeper.profiles.make("Other", nil))
  Ordaen.keeper.profiles.use("Other")
  Test.flush()
  Test.expect(Ordaen.keeper.profiles.recalled("Other", key) == nil)
  Test.shot("another profile: the list as it starts, by category, nothing picked")
}
