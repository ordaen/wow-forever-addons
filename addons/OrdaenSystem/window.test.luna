test "the tab says how many addons are on, of all" {
  const world = new World(everyday())
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Client.C_AddOns.EnableAddOn = (name, character) => world.turn(name, character, false)
  Client.C_AddOns.DisableAddOn = (name, character) => world.turn(name, character, true)
  Client.C_AddOns.SaveAddOns = () => world.save()
  Client.C_AddOns.ResetAddOns = () => world.reset()
  Test.mount(nil, SCREEN)
  open()
  flip("Bagger")
  Test.expect(window().text("5 of 6").shown())
}

// A row's state

test "a row says why the client doesn't load an addon, in red" {
  const world = new World(everyday())
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Test.mount(nil, SCREEN)
  open()
  Test.expect(window().text(Client.ADDON_INTERFACE_VERSION).textColor().equal(Style.RED))
}

test "an addon switched off says «disabled», dim; switched on, not loaded, it waits for a reload" {
  const world = new World(everyday())
  world.fakes.push({ name: "Fresh", title: "Fresh" })
  world.off["Fresh"] = true
  world.savedOff["Fresh"] = true
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Client.C_AddOns.EnableAddOn = (name, character) => world.turn(name, character, false)
  Client.C_AddOns.DisableAddOn = (name, character) => world.turn(name, character, true)
  Client.C_AddOns.SaveAddOns = () => world.save()
  Client.C_AddOns.ResetAddOns = () => world.reset()
  Test.mount(nil, SCREEN)
  open()
  Test.expect(reads(row("Fresh"), "Fresh | disabled | — | — | —") && switchOff(row("Fresh")))
  Test.expect(window().text(Locale.STATE_OFF).textColor().equal(Style.DIM))
  flip("Fresh")
  Test.expect(reads(row("Fresh"), "Fresh | waits for a reload | — | — | —") && switchOn(row("Fresh")))
}

test "an addon off and refused says it is off, dim, not why it is refused" {
  const world = new World(everyday())
  world.off["OldMap"] = true
  world.savedOff["OldMap"] = true
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Test.mount(nil, SCREEN)
  open()
  Test.expect(reads(row("Old Map"), "Old Map | disabled | — | — | —"))
  Test.expect(window().text(Locale.STATE_OFF).textColor().equal(Style.DIM))
}

test "a loaded addon switched off stays loaded until a reload, and the footer counts what waits for one" {
  const world = new World(everyday())
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Client.C_AddOns.EnableAddOn = (name, character) => world.turn(name, character, false)
  Client.C_AddOns.DisableAddOn = (name, character) => world.turn(name, character, true)
  Client.C_AddOns.SaveAddOns = () => world.save()
  Client.C_AddOns.ResetAddOns = () => world.reset()
  Test.mount(nil, SCREEN)
  open()
  Test.expect(!window().text(Locale.RELOAD_NEEDED.format(1)).shown())
  flip("Bagger")
  Test.expect(reads(row("Bagger"), "Bagger | loaded until a reload | — | — | 0 KB"))
  window().text(Locale.RELOAD_NEEDED.format(1)).hover()
  Test.expect(reads(Test.page().window(Locale.STATE_UNTIL).nth(2), "Reload needed: 1 | Bagger | loaded until a reload"))
  flip("Bagger")
  Test.expect(!window().text(Locale.RELOAD_NEEDED.format(1)).shown())
}

