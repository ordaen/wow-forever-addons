// Sets

// A set saved under a name, as the player saves one: «Sets», «Save current as…», the name, «Save».
function saveSet(name: String) {
  window().button(Locale.SETS).click()
  Test.page().button(Locale.SET_SAVE).click()
  Test.page().window(Locale.SET_NEW).input().type(name)
  Test.page().window(Locale.SET_NEW).button(Locale.SAVE).click()
}

// A set's dialog, opened from «Sets».
function set(name: String): Test.Part {
  window().button(Locale.SETS).click()
  Test.page().window(Locale.SET_SAVE).button(name).click()
  return Test.page().window(Locale.SET_TITLE.format(name))
}

test "a set saved under a name is listed under «Sets»" {
  Test.mount(nil, SCREEN)
  open()
  saveSet("Raid")
  Test.expect(!Test.page().window(Locale.SET_NEW).shown())
  window().button(Locale.SETS).click()
  Test.expect(reads(Test.page().window(Locale.SET_SAVE), "Save current as… | Raid"))
}

test "a set isn't saved with no name" {
  Test.mount(nil, SCREEN)
  open()
  window().button(Locale.SETS).click()
  Test.page().button(Locale.SET_SAVE).click()
  Test.page().window(Locale.SET_NEW).button(Locale.SAVE).click()
  Test.expect(Test.page().window(Locale.SET_NEW).shown())
  Test.page().window(Locale.SET_NEW).button(Locale.CANCEL).click()
  window().button(Locale.SETS).click()
  Test.expect(reads(Test.page().window(Locale.SET_SAVE), "Save current as…"))
}

test "a set applied switches on what it holds and off the rest" {
  Test.addon({ name: "Bagger", title: "Bagger", category: "Inventory" })
  Test.addon({ name: "Chatter", title: "Chatter", onDemand: true })
  Test.mount(nil, SCREEN)
  open()
  flip("Bagger")
  saveSet("Lean")
  flip("Bagger")
  set("Lean").button(Locale.APPLY).click()
  Test.expect(switchOff(row("Bagger")) && switchOn(row("Chatter")) && !Test.page().window(Locale.SET_TITLE.format("Lean")).shown())
}

test "a set applied takes the last step's strip away: «Undo» is for that step alone" {
  Test.addon({ name: "Saddle", title: "Saddle", needs: ["Strap"], category: "Tack", enabled: .Off })
  Test.addon({ name: "Strap", title: "Strap", category: "Tack", enabled: .Off })
  Test.mount(nil, SCREEN)
  open()
  saveSet("Bare")
  flip("Saddle")
  Test.expect(window().button(Locale.UNDO).shown())
  set("Bare").button(Locale.APPLY).click()
  Test.expect(!window().button(Locale.UNDO).shown() && switchOff(row("Saddle")) && switchOff(row("Strap")))
}

