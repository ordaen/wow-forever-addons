  Client.C_AddOnProfiler.IsEnabled = () => true
  Client.C_AddOnProfiler.GetApplicationMetric = metric => meter.whole(metric)
  Client.C_AddOnProfiler.GetAddOnMetric = (name, metric) => meter.of(name, metric)
  Client.C_AddOnProfiler.GetOverallMetric = metric => meter.overall(metric)
  Client.C_AddOnProfiler.GetTopKAddOnsForMetric = (metric, k) => meter.top(metric, k)
  Client.UpdateAddOnMemoryUsage = () => meter.weigh()
  Client.GetAddOnMemoryUsage = name => meter.kb(name)
  Client.C_AddOnProfiler.GetApplicationMetric = metric => 1
  Test.mount(nil, SCREEN)
  open()
  Test.expect(reads(row("Ordaen"), "Ordaen | 100.0 % | 0.0 % | 0 KB") && window().text(Locale.ALL_ADDONS.format("140.0 %")).shown())
}

