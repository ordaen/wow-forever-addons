// Switching

test "switching off what others need asks first: «Cancel» changes nothing" {
  Test.mount(nil, SCREEN)
  open()
  flip("LunaType")
  Test.expect(reads(question("LunaType"), "These stop loading: Ordaen, Ordaen System | Cancel | Disable | Disable LunaType?"))
  question("LunaType").button(Locale.CANCEL).click()
  Test.expect(!question("LunaType").shown() && switchOn(row("LunaType")))
}

test "«Disable» in the question switches it off alone: what needs it stays on and says why it won't load" {
  Test.mount(nil, SCREEN)
  open()
  flip("Ordaen")
  question("Ordaen").button(Locale.DISABLE).click()
  Test.expect(!question("Ordaen").shown())
  Test.expect(switchOff(row("Ordaen")) && reads(row("Ordaen"), "Ordaen | loaded until a reload | — | — | 0 KB"))
  Test.expect(reads(row("Ordaen System"), `Ordaen System | ${Client.ADDON_DEP_DISABLED} | — | — | 0 KB`))
  Test.expect(window().text(Client.ADDON_DEP_DISABLED).textColor().equal(Style.RED))
}

test "the question comes at every switching off that stops another addon, and never otherwise" {
  const world = new World(everyday())
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Client.C_AddOns.EnableAddOn = (name, character) => world.turn(name, character, false)
  Client.C_AddOns.DisableAddOn = (name, character) => world.turn(name, character, true)
  Client.C_AddOns.SaveAddOns = () => world.save()
  Client.C_AddOns.ResetAddOns = () => world.reset()
  Test.mount(nil, SCREEN)
  open()
  for (round of 1..=3) {
    flip("Ordaen")
    Test.expect(question("Ordaen").shown())
    question("Ordaen").button(Locale.CANCEL).click()
  }
  flip("Bagger")
  Test.expect(!Test.page().text(Locale.CANCEL).shown() && switchOff(row("Bagger")))
}

test "what stops loading is asked of through what needs it in turn, and only what is on" {
  Test.mount(nil, SCREEN)
  open()
  flip("Ordaen")
  question("Ordaen").button(Locale.DISABLE).click()
  // Ordaen off: what stops with the runtime is Ordaen System, through Ordaen, which stays named though it is off.
  flip("LunaType")
  Test.expect(reads(question("LunaType"), "These stop loading: Ordaen System | Cancel | Disable | Disable LunaType?"))
}

test "switching on enables what it needs in one step, said under the list; «Undo» puts back exactly that" {
  Test.mount(nil, SCREEN)
  open()
  flip("LunaType")
  question("LunaType").button(Locale.DISABLE).click()
  flip("Ordaen")
  question("Ordaen").button(Locale.DISABLE).click()
  flip("Ordaen")
  Test.expect(switchOn(row("Ordaen")) && switchOn(row("LunaType")))
  Test.expect(window().text(Locale.ALSO.format("LunaType")).shown())
  window().button(Locale.UNDO).click()
  Test.expect(switchOff(row("Ordaen")) && switchOff(row("LunaType")))
  Test.expect(!window().text(Locale.ALSO.format("LunaType")).shown() && !window().button(Locale.UNDO).shown())
}

test "switching on enables what it needs through what those need, and names each once" {
  Test.addon({ name: "Saddle", title: "Saddle", needs: ["Strap"], category: "Tack", enabled: .Off })
  Test.addon({ name: "Strap", title: "Strap", needs: ["Buckle"], category: "Tack", enabled: .Off })
  Test.addon({ name: "Buckle", title: "Buckle", category: "Tack", enabled: .Off })
  Test.mount(nil, SCREEN)
  open()
  flip("Saddle")
  Test.expect(switchOn(row("Saddle")) && switchOn(row("Strap")) && switchOn(row("Buckle")))
  Test.expect(window().text(Locale.ALSO.format("Strap, Buckle")).shown())
}

test "switching on one of a ring of addons that need each other enables the ring once" {
  Test.addon({ name: "Rope", title: "Rope", needs: ["Knot"], category: "Ring", enabled: .Off })
  Test.addon({ name: "Knot", title: "Knot", needs: ["Loop"], category: "Ring", enabled: .Off })
  Test.addon({ name: "Loop", title: "Loop", needs: ["Rope"], category: "Ring", enabled: .Off })
  Test.mount(nil, SCREEN)
  open()
  flip("Rope")
  Test.expect(switchOn(row("Rope")) && switchOn(row("Knot")) && switchOn(row("Loop")))
  Test.expect(window().text(Locale.ALSO.format("Knot, Loop")).shown())
}

test "a caption's switch enables what its addons need once, though more than one needs it" {
  Test.addon({ name: "Hammer", title: "Hammer", needs: ["Anvil"], category: "Smithy", enabled: .Off })
  Test.addon({ name: "Tongs", title: "Tongs", needs: ["Anvil"], category: "Smithy", enabled: .Off })
  Test.addon({ name: "Anvil", title: "Anvil", category: "Stone", enabled: .Off })
  Test.mount(nil, SCREEN)
  open()
  flip("Smithy")
  Test.expect(switchOn(row("Hammer")) && switchOn(row("Tongs")) && switchOn(row("Anvil")))
  Test.expect(window().text(Locale.ALSO.format("Anvil")).shown())
}

test "a needed addon missing from the folder is left to the client, which says why the addon won't load" {
