test "a set applied switches on what it holds that is off, and off the last addon of the list too; saved, with no strip" {
  const world = new World(everyday())
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  Client.C_AddOns.EnableAddOn = (name, character) => world.turn(name, character, false)
  Client.C_AddOns.DisableAddOn = (name, character) => world.turn(name, character, true)
  Client.C_AddOns.SaveAddOns = () => world.save()
  Client.C_AddOns.ResetAddOns = () => world.reset()
  Test.mount(nil, SCREEN)
  open()
  flip("Chatter")
  saveSet("Quiet")
  flip("Chatter")
  flip("Bagger")
  set("Quiet").button(Locale.APPLY).click()
  Test.expect(switchOff(row("Chatter")) && switchOn(row("Bagger")) && !window().button(Locale.UNDO).shown())
  window().button(Locale.RESET).click()
  Test.expect(switchOff(row("Chatter")) && switchOn(row("Bagger")))
}

test "a set renamed, deleted or saved again is so after a reload" {
  Test.mount(nil, SCREEN)
  open()
  saveSet("Raid")
  saveSet("Gone")
  saveSet("Raid")
  set("Raid").input().type("")
  Test.erase(4)
  Test.type("Solo")
  Test.page().window(Locale.SET_TITLE.format("Raid")).button(Locale.RENAME).click()
  set("Gone").button(Locale.DELETE).click()
  Test.reload()
  open()
  window().button(Locale.SETS).click()
  Test.expect(reads(Test.page().window(Locale.SET_SAVE), "Save current as… | Solo"))
}

