test "a long list scrolls, and each switch switches the addon its row shows, at every scroll" {
  for (i of 1..=30) { Test.addon({ name: `Many${i}`, title: `Many ${i}`, category: "Many" }) }
  Test.mount(nil, SCREEN)
  open()
  let at = "Many 1"
  for (round of 1..=3) {
    window().text(at).wheel(-3)
    // The last row in view that isn't switched yet: a row the list handed another addon as it moved.
    let found = ""
    for (i of 30..=1 step -1) {
      const title = `Many ${i}`
      if (found == "" && window().text(title).shown() && Test.refused(() => window().text(title).hover()) == nil &&
          window().text(title).item().text(Locale.STATE_UNTIL).count() == 0) { found = title }
    }
    Test.expect(found != "")
    at = found
    flip(at)
    Test.expect(reads(row(at), `${at} | loaded until a reload | — | — | 0 KB`))
  }
  Test.expect(Test.errors().length == 0)
}

// The numbers

test "the numbers: each addon's CPU now, at its peak and its memory, the heaviest third in the accent" {
  const world = new World(everyday())
  Client.C_AddOns.GetNumAddOns = () => world.count()
  Client.C_AddOns.GetAddOnName = index => world.name(index)
  Client.C_AddOns.GetAddOnMetadata = (name, field) => world.metadata(name, field)
  Client.C_AddOns.IsAddOnLoadOnDemand = name => world.demand(name)
  Client.C_AddOns.GetAddOnInterfaceVersion = name => world.interface(name)
  Client.C_AddOns.GetAddOnEnableState = (name, character) => world.state(name, character)
  Client.C_AddOns.IsAddOnLoaded = name => {
    const loading, loaded = world.loaded(name)
    return loading, loaded
  }
  Client.C_AddOns.IsAddOnLoadable = (name, character, demandLoaded) => {
    const can, reason = world.loadable(name, character, demandLoaded)
    return can, reason
  }
  const meter = new Meter()
  meter.now["Bagger"] = 1
  meter.now["Ordaen"] = 0.5
  meter.peak["Bagger"] = 2
  meter.peak["Ordaen"] = 3
  meter.memory["Bagger"] = 300
  meter.memory["Ordaen"] = 2048
  Client.C_AddOnProfiler.IsEnabled = () => true
  Client.C_AddOnProfiler.GetApplicationMetric = metric => meter.whole(metric)
  Client.C_AddOnProfiler.GetAddOnMetric = (name, metric) => meter.of(name, metric)
  Client.C_AddOnProfiler.GetOverallMetric = metric => meter.overall(metric)
  Client.C_AddOnProfiler.GetTopKAddOnsForMetric = (metric, k) => meter.top(metric, k)
  Client.UpdateAddOnMemoryUsage = () => meter.weigh()
  Client.GetAddOnMemoryUsage = name => meter.kb(name)
  Test.mount(nil, SCREEN)
  open()
  Test.expect(reads(row("Bagger"), "Bagger | 10.0 % | 20.0 % | 300 KB"))
  Test.expect(reads(row("Ordaen"), "Ordaen | 5.0 % | 30.0 % | 2.0 MB"))
  Test.expect(reads(row("LunaType"), "LunaType | 0.0 % | 0.0 % | 0 KB"))
  Test.expect(reads(row("Chatter"), "Chatter | on demand | — | — | —"))
  Test.expect(window().text("10.0 %").textColor().equal(Style.HOT) && window().text("5.0 %").textColor().equal(Style.INK))
  Test.expect(window().text("30.0 %").textColor().equal(Style.HOT) && window().text("20.0 %").textColor().equal(Style.INK))
  Test.expect(window().text("2.0 MB").textColor().equal(Style.HOT) && window().text("300 KB").textColor().equal(Style.INK))
  Test.expect(row("LunaType").text("0 KB").textColor().equal(Style.INK))
  Test.expect(row("LunaType").text("0.0 %").nth(1).textColor().equal(Style.INK))
  Test.expect(window().text(Locale.ALL_ADDONS.format("14.0 %")).shown() && !window().text(Locale.NOT_MEASURING).shown())
}

test "CPU is sampled once a second only while the window shows" {
  const meter = new Meter()
  Client.C_AddOnProfiler.IsEnabled = () => true
  Client.C_AddOnProfiler.GetApplicationMetric = metric => meter.whole(metric)
  Client.C_AddOnProfiler.GetAddOnMetric = (name, metric) => meter.of(name, metric)
  Client.C_AddOnProfiler.GetOverallMetric = metric => meter.overall(metric)
  Client.C_AddOnProfiler.GetTopKAddOnsForMetric = (metric, k) => meter.top(metric, k)
  Client.UpdateAddOnMemoryUsage = () => meter.weigh()
  Client.GetAddOnMemoryUsage = name => meter.kb(name)
  Test.mount(nil, SCREEN)
  Test.pass(2.1)
  Test.expect(meter.samples == 0)
  open()
  const first = meter.samples
  Test.expect(first > 0)
  Test.pass(1.1)
  const second = meter.samples
  Test.expect(second > first)
  Test.pass(1.1)
  Test.expect(meter.samples > second)
  _ = Test.key(Key.Escape)
  const closed = meter.samples
  Test.pass(3.1)
  Test.expect(meter.samples == closed)
  open()
  Test.pass(1.1)
  Test.expect(meter.samples > closed + 1)
}

test "the numbers follow the client's each second the window shows" {
  const meter = new Meter()
  meter.now["Ordaen"] = 1
  Client.C_AddOnProfiler.IsEnabled = () => true
  Client.C_AddOnProfiler.GetApplicationMetric = metric => meter.whole(metric)
  Client.C_AddOnProfiler.GetAddOnMetric = (name, metric) => meter.of(name, metric)
  Client.C_AddOnProfiler.GetOverallMetric = metric => meter.overall(metric)
  Client.C_AddOnProfiler.GetTopKAddOnsForMetric = (metric, k) => meter.top(metric, k)
  Client.UpdateAddOnMemoryUsage = () => meter.weigh()
  Client.GetAddOnMemoryUsage = name => meter.kb(name)
  Test.mount(nil, SCREEN)
  open()
  meter.now["Ordaen"] = 2
  Test.expect(reads(row("Ordaen"), "Ordaen | 10.0 % | 0.0 % | 0 KB"))
  Test.pass(1.1)
  Test.expect(reads(row("Ordaen"), "Ordaen | 20.0 % | 0.0 % | 0 KB"))
}

