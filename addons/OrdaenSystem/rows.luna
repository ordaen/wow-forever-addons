// The list's lines: a category's caption (its mark folds it) or an addon's row, each with a switch at the right, the
// switches of all lines one column. A row: the title with its colour codes, its state where it isn't plainly loaded,
// CPU now, CPU peak and memory (the heaviest third of each column in the accent), and the switch (three states with
// «All characters»: on, off, on for some). A caption's switch is its whole group's: on where every addon of it is,
// off where none is, on for some between. Hover: our Tip with the notes. Left-click picks a row for the card; the
// switch switches the addon, with Ctrl on a group's parent the whole group. An Ordaen module has no switch: Ordaen's
// own is its one, and its state's text opens Ordaen's settings at it.
import { Align, Art, Click, Edges, MouseButton, Stated, Track } from "$ltml"
import Game from "$game"
import { Component, Menu, MenuEntry, PX, Shown, ShownToggle, space, SWITCH_WIDTH, Tip } from "Ordaen"
import root Ordaen from "Ordaen"
import { AddOn, Catalog, plain, Status, Switch } from "@/catalog"
import Locale from "@/locales"
import { Load, memory, percent, Profiler } from "@/perf"
import Style from "@/style"

// One line of the list.
public struct Line {
  // A category's caption, or an addon.
  caption: Boolean
  // The addon's folder, or the category as the client groups by it.
  name: String
  // A caption's: how many addons it holds, and whether it is folded.
  count: Integer
  folded: Boolean
  // An addon under its group's parent, which stands right above it.
  child: Boolean
  // A caption's: the addons its switch switches, every one of its group (none for an addon's row).
  names: Array<String>
  // An addon's row in the table, which shows its category in a column after its title.
  tabled: Boolean
}

// From which value each numbers' column is lit: its heaviest third.
public struct Hot {
  now: Number
  peak: Number
  memory: Number
}

public const COLUMNS: Array<Track> = [{ fr: 1 }, "auto", Style.NUMBER, Style.NUMBER, Style.MEMORY, SWITCH_WIDTH]
const CAPTION: Array<Track> = ["auto", "auto", { fr: 1 }, SWITCH_WIDTH]
// The table's: the category in a column of its own, among the fixed ones so that it lines up from row to row.
public const TABLE_COLUMNS: Array<Track> = [
  { fr: 1 }, "auto", Style.CATEGORY, Style.NUMBER, Style.NUMBER, Style.MEMORY, SWITCH_WIDTH,
]
// The fold's mark (ctl.markClosed, ctl.markOpen), as TreeRow draws it: a 16 px cell, its triangle in the middle.
const MARK = 16 * PX
const PAD: Edges = { left: space(.Item), right: space(.Item) }
const LIGHT: Stated<Color> = { default: Style.CLEAR, hover: Color.hex("#d6a56b1f") }
const DASH = "—"

// What a row's menu of quick actions offers.
enum RowAction { Switch, Load, Settings, Details }

// An addon's switch as the client has it for whom the header says.
function shownOf(switched: Switch): Shown {
  return match (switched) {
    .On => Shown.On,
    .Off => Shown.Off,
    .Some => Shown.Some,
  }
}

// What a row's state says: nothing for an addon plainly loaded.
public function stateOf(addon: AddOn, status: Status, module: Boolean): String {
  const reason = status.reason
  if (module) {
    if (reason != nil && reason != "DISABLED") { return Style.reasonText(reason) }
    return Ordaen.isChosen(addon.name) ? Locale.MODULE_ON : Locale.MODULE_OFF
  }
  if (!status.mine && status.loaded) { return Locale.STATE_UNTIL }
  if (status.enabled == .Off) { return Locale.STATE_OFF }
  if (reason != nil && reason != "DISABLED") { return Style.reasonText(reason) }
  if (!status.loaded && status.mine) { return addon.demand ? Locale.STATE_DEMAND : Locale.STATE_WAITS }
  return ""
}

public class LineRow implements Component {
  public pick: Event<String> = new Event()
  // The switch: the addon, and whether Ctrl was held.
  public toggle: Event<(String, Boolean)> = new Event()
  // A caption's switch: every addon of its group.
  public toggleGroup: Event<Array<String>> = new Event()
  // The row's menu: «Load» (an addon on demand, not loaded, that can be).
  public loadNow: Event<String> = new Event()
  public fold: Event<String> = new Event()
  // An Ordaen module's state: its page in Ordaen's settings.
  public settings: Event<String> = new Event()

  state hovered = false
  // Right-click opened the row's menu of quick actions.
  state menuOpen = false
  derived actions: Array<RowAction> = self.actionsOf()
  derived entries: Array<MenuEntry> = self.actions.map(action => self.entryOf(action))
  derived addon: AddOn | nil = self.line.caption ? nil : self.catalog.byName[self.line.name]
  derived status: Status | nil = self.catalog.statuses[self.line.name]
  derived load: Load | nil = self.profiler.loads[self.line.name]
  derived title: String = self.addon?.title ?? (self.line.name == "" ? Locale.OTHER : self.line.name)
  derived category: String = (self.addon?.category ?? "") == "" ? Locale.OTHER : self.addon?.category ?? ""
  derived columns: Array<Track> = self.line.tabled ? TABLE_COLUMNS : COLUMNS
  derived module: Boolean = self.addon?.group == self.framework && self.line.name != self.framework
  derived switched: Switch = self.status?.enabled ?? Switch.Off
  derived shown: Shown = self.line.caption ? self.groupShown() : shownOf(self.switched)
  derived said: String = self.sayOf()
  derived bad: Boolean = self.badOf()
  derived stateColor: Color = self.bad ? Style.RED : Style.DIM
  // A share, or -1 where the addon isn't measured.
  derived nowShare: Number = self.load?.now ?? -1
  derived peakShare: Number = self.load?.peak ?? -1
  derived now: String = self.nowShare < 0 ? DASH : percent(self.nowShare)
  derived peak: String = self.peakShare < 0 ? DASH : percent(self.peakShare)
  derived kb: Number = self.profiler.memory[self.line.name] ?? 0
  derived weight: String = self.loaded ? memory(self.kb) : DASH
  derived loaded: Boolean = self.status?.loaded == true
  derived nowColor: Color = self.nowShare > 0 && self.nowShare >= self.hot.now ? Style.HOT : Style.INK
  derived peakColor: Color = self.peakShare > 0 && self.peakShare >= self.hot.peak ? Style.HOT : Style.INK
  derived weightColor: Color = self.loaded && self.kb > 0 && self.kb >= self.hot.memory ? Style.HOT : Style.INK
  derived background: Color | Stated<Color> = self.line.name == self.picked ? Style.PICKED : LIGHT
  derived indent: Edges = { left: self.line.child ? Style.INDENT : 0 }
  derived notes: String = plain(self.addon?.notes ?? "")
  derived tipShown: Boolean = self.hovered && self.notes != ""
  derived plainTitle: String = plain(self.title)
  derived countText: String = "%d".format(self.line.count)
  derived mark: Art = self.line.folded ? Ordaen.art.ctl.markClosed : Ordaen.art.ctl.markOpen

  line: Signal<Line>
  const catalog: Catalog
  const profiler: Profiler
  hot: Signal<Hot>
  picked: Signal<String>
  const framework: String
  constructor(
    line: Signal<Line>,
    catalog: Catalog,
    profiler: Profiler,
    hot: Signal<Hot>,
    picked: Signal<String>,
    // Ordaen's folder: the addon its modules stand under.
    framework: String,
  ) {
    self.line = line
    self.catalog = catalog
    self.profiler = profiler
    self.hot = hot
    self.picked = picked
    self.framework = framework
  }

  // A caption's switch: on where every addon of its group is on, off where none is, on for some between.
  groupShown(self): Shown {
    let on = 0
    let off = 0
    for (name of self.line.names) {
      const enabled = self.catalog.statuses[name]?.enabled ?? Switch.Off
      if (enabled == .On) { on += 1 }
      if (enabled == .Off) { off += 1 }
    }
    const count = self.line.names.length
    return on == count ? Shown.On : off == count ? Shown.Off : Shown.Some
  }

  sayOf(self): String {
    const addon = self.addon
    const status = self.status
    if (addon == nil || status == nil) { return "" }
    return stateOf(addon, status, self.module)
  }

  badOf(self): Boolean {
    const reason = self.status?.reason
    return reason != nil && reason != "DISABLED" && (self.status?.enabled != .Off || self.module)
  }

  onPick(mut self, click: Click) {
    if (self.line.caption) {
      self.fold.emit(self.line.name)
    } else if (click.button == MouseButton.Right) {
      self.menuOpen = true
    } else {
      self.pick.emit(self.line.name)
    }
  }

  // The row's quick actions: its switch (but a module's, whose switch is Ordaen's), «Load» where it can be loaded
  // now, a module's page in Ordaen's settings, and its card.
  actionsOf(self): Array<RowAction> {
    const list: Array<RowAction> = []
    if (!self.module) { list.push(.Switch) }
    const status = self.status
    if (self.addon?.demand == true && status != nil && !status.loaded && status.mine && status.reason == nil) {
      list.push(.Load)
    }
    if (self.module) { list.push(.Settings) }
    list.push(.Details)
    return list
  }

  entryOf(self, action: RowAction): MenuEntry {
    return match (action) {
      .Switch => { label: self.switched == .Off ? Locale.ENABLE : Locale.DISABLE },
      .Load => { label: Locale.LOAD_NOW, disabled: Game.situation.combat },
      .Settings => { label: Locale.ORDAEN_SETTINGS },
      .Details => { label: Locale.MENU_DETAILS, group: true },
    }
  }

  onMenu(mut self, index: Integer) {
    self.menuOpen = false
    const action = self.actions[index]
    if (action == nil) { return }
    match (action) {
      .Switch => self.toggle.emit(self.line.name, false),
      .Load => self.loadNow.emit(self.line.name),
      .Settings => self.settings.emit(self.line.name),
      .Details => self.pick.emit(self.line.name),
    }
  }

  closeMenu(mut self) { self.menuOpen = false }

  // Ctrl is read here, in the click's own handler.
  onCheck(mut self) { self.toggle.emit(self.line.name, Game.input.controlDown()) }
  onGroup(mut self) { self.toggleGroup.emit(self.line.names) }
  onSettings(mut self) { self.settings.emit(self.line.name) }
  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box $if={self.line.caption} columns={CAPTION} gap={space(.Item)} padding={PAD} yAlign={Align.Center}
           @click={self.onPick}>
        <box width={MARK} height={MARK} background={self.mark} tint={Style.GOLD} />
        <text value={self.title} textColor={Style.GOLD} textFont={.Title} wrap={false} />
        <text value={self.countText} textColor={Style.DIM} textFont={.Numbers} wrap={false} />
        <ShownToggle state={self.shown} @flip={self.onGroup} />
      </box>
      <box $else columns={self.columns} gap={space(.Item)} padding={PAD} yAlign={Align.Center}
           background={self.background} @click={self.onPick} @enter={self.onEnter} @leave={self.onLeave}>
        <box padding={self.indent}>
          <text value={self.title} textColor={Style.INK} wrap={false} />
        </box>
        <box $if={self.module} @click={self.onSettings}>
          <text value={self.said} textColor={self.stateColor} textSize={.Secondary} wrap={false} />
        </box>
        <box $else>
          <text value={self.said} textColor={self.stateColor} textSize={.Secondary} wrap={false} />
        </box>
        <text $if={self.line.tabled} value={self.category} textColor={Style.DIM} textSize={.Secondary} wrap={false} />
        <box xAlign={Align.End}>
          <text value={self.now} textColor={self.nowColor} textFont={.Numbers} wrap={false} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.peak} textColor={self.peakColor} textFont={.Numbers} wrap={false} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.weight} textColor={self.weightColor} textFont={.Numbers} wrap={false} />
        </box>
        <ShownToggle $if={!self.module} state={self.shown} @flip={self.onCheck} />
        <box $else />
        <Menu $if={self.menuOpen} entries={self.entries} @pick={self.onMenu} @close={self.closeMenu} />
        <Tip $if={self.tipShown} title={self.plainTitle} text={self.notes} />
      </box>
    }
  }
}
