// The «Settings» tab against the stand-in's options window: Game (Controls, Mouse under it, Interface) and System
// (Audio), each page a list of the client's settings; the addons' pages are the «Mods» tab's.
import Client from "$client"
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import { SettingLine, SystemSettings } from "@/settings"
import { SettingsTab } from "@/settingsPage"

function read(): mut SystemSettings {
  const settings = new SystemSettings()
  settings.read()
  return settings
}

function names(settings: SystemSettings): String {
  const all: Array<String> = []
  for (group of settings.groups) {
    all.push(group.name)
    for (page of group.pages) { all.push(page.child ? `  ${page.name}` : page.name) }
  }
  return all.join(" | ")
}

test "the pages are the client's game groups and their pages in its order, a page under another marked so" {
  const settings = read()
  Test::expect(names(settings) == "Game | Controls |   Mouse | Interface | System | Audio")
}

test "the first page shows as the tab opens, each line read as its kind with the client's value" {
  const settings = read()
  Test::expect(settings.lines.length > 0)
  const first = settings.lines.find(line => line.variable != "") ?? panic("a setting on the first page")
  Test::expect(settings.values[first.variable] != nil)
}

test "the search finds a page by a setting's name, and the tab shows only the settings that match" {
  const settings = read()
  Test::expect(settings.matching("auto loot")[(settings.groups[1]?.pages ?? [])[1]?.id ?? 0] == true)
  Test::mount(new SettingsTab(settings), { left: 0, top: 0, width: 1100, height: 600 })
  Test::expect(Test::page().text("Auto Loot").shown() && Test::page().text("Interact on Left Click").shown())
  Test::page().input().type("auto loot")
  Test::expect(Test::page().text("Auto Loot").shown() && !Test::page().text("Interact on Left Click").shown())
  Test::expect(!Test::page().text("Audio").shown())
}

test "a setting is written as it is changed: a console variable itself, any other through its setter; nothing in a fight" {
  const settings = read()
  Test::mount(new SettingsTab(settings), { left: 0, top: 0, width: 1100, height: 600 })
  Test::expect(Client::C_CVar::GetCVar("autoLootDefault") != "1")
  Test::expect(settings.lines.find(line => line.variable == "autoLootDefault")?.writing == .Variable)
  Test::expect(settings.values["autoLootDefault"] == false)
  Test::page().text("Auto Loot").item().button(Ordaen.art.ctl.check).click()
  Test::expect(Client::C_CVar::GetCVar("autoLootDefault") == "1")
  Test::page().text("Interface").click()
  const tutorials = Test::page().text("Tutorials")
  Test::expect(tutorials.shown())
  // Over no console variable: written through Blizzard's own setter.
  tutorials.item().button(Ordaen.art.ctl.check).click()
  Test::expect(Client::Settings?.GetSetting("PROXY_TUTORIALS")?.GetValue() == false)
  Test::page().text("Controls").click()
  Game::situation.combat = true
  Test::flush()
  Test::page().text("Auto Loot").item().button(Ordaen.art.ctl.check).click()
  Test::expect(Client::C_CVar::GetCVar("autoLootDefault") == "1")
  Game::situation.combat = false
}

test "a line of two controls is its checkbox and, set in under it, its slider or dropdown, hidden while the box is off" {
  const settings = read()
  Test::mount(new SettingsTab(settings), { left: 0, top: 0, width: 1100, height: 600 })
  Test::page().text("Mouse").click()
  const box = settings.lines.find(line => line.variable == "enableMouseSpeed") ?? panic("the checkbox's line")
  const slider = settings.lines.find(line => line.variable == "mouseSpeed") ?? panic("the slider's line")
  Test::expect(box.kind == .Check && slider.kind == .Slider && slider.under == "enableMouseSpeed")
  Test::expect((settings.lines.find(line => line.variable == "cameraSmoothTrackingStyle")?.under ?? "") == "autoInteract")
  Test::expect(!Test::page().button("Open in the game's window").shown())
  // Off, the slider isn't shown; on, it shows and writes its variable.
  Test::expect(!Test::page().text("Sensitivity").shown())
  const before = Client::C_CVar::GetCVar("mouseSpeed")
  Test::page().text("Mouse Sensitivity").item().button(Ordaen.art.ctl.check).click()
  Test::expect(Client::C_CVar::GetCVar("enableMouseSpeed") == "1")
  Test::page().text("Sensitivity").item().button("+").click()
  Test::expect(Client::C_CVar::GetCVar("mouseSpeed") != before)
}

test "the list names its group only while searching: the tabs name it otherwise" {
  const settings = read()
  Test::mount(new SettingsTab(settings), { left: 0, top: 0, width: 1100, height: 600 })
  Test::expect(Test::page().text("Controls").shown() && !Test::page().text("Game").shown())
  Test::page().input().type("auto loot")
  Test::expect(Test::page().text("Game").shown())
}

test "a setting that waits for Apply holds its value until Apply, which commits it as Blizzard's button does" {
  const settings = read()
  Test::mount(new SettingsTab(settings), { left: 0, top: 0, width: 1100, height: 600 })
  Test::page().text("Interface").click()
  const before = Client::C_CVar::GetCVar("cameraDistanceMaxZoomFactor")
  Test::page().text("Max Camera Distance").item().button("+").click()
  Test::expect(Client::C_CVar::GetCVar("cameraDistanceMaxZoomFactor") == before && settings.waiting.length == 1)
  settings.apply()
  Test::expect(Client::C_CVar::GetCVar("cameraDistanceMaxZoomFactor") != before && settings.waiting.length == 0)
}

test "the page's defaults set each of its settings back to the game's" {
  const settings = read()
  Test::mount(new SettingsTab(settings), { left: 0, top: 0, width: 1100, height: 600 })
  _ = Client::C_CVar::SetCVar("autoLootDefault", "1")
  settings.refresh()
  settings.defaults()
  Test::expect(Client::C_CVar::GetCVar("autoLootDefault") == Client::C_CVar::GetCVarDefault("autoLootDefault"))
}

// The line of a variable, its page opened.
function lineFor(settings: mut SystemSettings, variable: String): SettingLine {
  for (group of settings.groups) {
    for (page of group.pages) {
      const line = settings.linesOf(page.id).find(line => line.variable == variable)
      if (line != nil) {
        settings.open(page.id)
        return line
      }
    }
  }
  return panic(`the line of ${variable}`)
}

test "a line's tooltip is Blizzard's: its text, a dropdown's choices that say more, the one recommended" {
  const settings = read()
  const status = lineFor(settings, "statusText")
  const tip = settings.tipOf(status)
  Test::expect(tip.contains("What the bars write on them."))
  Test::expect(tip.contains("|cffffffffNumeric|r: |cffffd100Their numbers.|r"))
  Test::expect(tip.contains("|cff19ff19None|r"))
}

test "a slider writes its value as Blizzard's window does: 72% for 0.72" {
  const settings = read()
  const distance = lineFor(settings, "cameraDistanceMaxZoomFactor")
  const format = distance.format ?? panic("its format")
  Test::expect(format(0.72) == "72%")
}
