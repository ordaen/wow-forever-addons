// The game's settings and key bindings, kept per Ordaen profile as a module's settings are (`OrdaenSystem:game`). A
// profile holds each setting the player set through the window, and the keys of every command. At login the active
// profile's are applied as they are; at a switch of profile the player is asked first, with what would change, and
// either applies them or keeps the game's as they are (the profile takes those). A profile that never held them takes
// the game's at once: Ordaen changes nothing by itself. Nothing is applied in a fight: it waits for the fight's end.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { Settings } from "Ordaen"
import { Bindings } from "@/keys"
import { readSetting, writeSetting } from "@/settings"

public struct GameValues implements Plain {
  // Whether the profile holds the game's yet.
  taken: boolean = false
  // Each setting set through the window, by its variable, as its text (`settingText`).
  settings: mut map<string, string> = {}
  // The keys of every command bound, by the command.
  keys: mut map<string, array<string>> = {}
}

// What applying a profile would change: a setting's or a command's, from what the game has to what the profile holds.
public struct GameChange {
  label: string
  from: string
  to: string
}

// A setting's value as a profile keeps it, its type first (`b:1`, `n:0.5`, `s:text`), and back.
public function settingText(value: boolean | number | string): string {
  if (value is boolean) { return value ? "b:1" : "b:0" }
  if (value is number) { return `n:${value}` }
  return `s:${value}`
}

public function settingValue(text: string): boolean | number | string {
  const kind = text.sub(1, 2)
  const rest = text.sub(3)
  if (kind == "b:") { return rest == "1" }
  if (kind == "n:") { return rest.toNumber() ?? 0 }
  return rest
}

// A value as the question shows it.
function shown(value: boolean | number | string | nil): string {
  if (value == nil) { return "—" }
  if (value is boolean) { return Runtime::text(value ? "YES" : "NO") ?? (value ? "Yes" : "No") }
  return string::of(value)
}

function sameKeys(a: array<string>, b: array<string>): boolean {
  if (a.length != b.length) { return false }
  for (at, key of a) {
    if (b[at] != key) { return false }
  }
  return true
}

function sameMaps(a: map<string, array<string>>, b: map<string, array<string>>): boolean {
  for (action, keys of a) {
    if (!sameKeys(keys, b[action] ?? [])) { return false }
  }
  for (action, keys of b) {
    if (a[action] == nil) { return false }
  }
  return true
}

public class GameKeeping {
  public const kept: mut Settings<GameValues> = new Settings<GameValues>(GameValues {}, "game")
  // What applying the profile switched to would change, asked first; empty: nothing asked.
  public state asking: array<GameChange> = []
  // An apply waiting for the fight's end.
  state waiting = false
  // The game is in the world: what a profile holds may be applied.
  started = false
  // The keys are being set from the profile: the client's own change of them isn't the player's.
  applying = false
  // The profile last seen active.
  profile: string | nil = nil
  const bindings: mut Bindings = new Bindings()

  constructor() {
    Events::PLAYER_ENTERING_WORLD.listen(self.onWorld)
    Events::UPDATE_BINDINGS.listen(self.onBindings)
    watch (name of Ordaen.keeper.profiles.active) { self.switched(name) }
    watch (fight of Game::situation.combat) {
      if (!fight && peek self.waiting) { self.apply() }
    }
    // Made once the character is in the world already (the module turned on, a load on demand): now.
    if (Client::IsLoggedIn()) { self.onWorld() }
  }

  // The first time in the world: the profile's applied as they are, or taken from the game.
  mut onWorld() {
    if (self.started) { return }
    self.started = true
    // A profile that never held the game's has nothing to apply: it takes them at its first change or switch.
    if ((peek self.kept.values).taken) { self.apply() }
  }

  // Another profile: one that never held the game's takes them; one that holds others asks first. The same profile
  // worked out again (the player's specialisation read) is no switch.
  mut switched(name: string) {
    const before = self.profile
    self.profile = name
    if (!self.started || before == nil || before == name) { return }
    if (!(peek self.kept.values).taken) {
      self.take()
      return
    }
    self.asking = self.changes()
  }

  // The keys the player changed (anywhere: ours, Blizzard's window, another addon's): the profile's now.
  // A profile that doesn't hold the game's yet keeps nothing, and keys as the profile has them are no change.
  mut onBindings() {
    if (!self.started || self.applying || !(peek self.kept.values).taken) { return }
    const keys = self.keysNow()
    if (sameMaps(keys, (peek self.kept.values).keys)) { return }
    self.kept.change((values: mut GameValues): nil => { values.keys = keys.clone() })
  }

  // A setting set through the window: the profile's now; one set back to its default: the game's again.
  // The first holds the game's as they are, with it.
  public mut record(variable: string, value: boolean | number | string) {
    const text = settingText(value)
    const taken = (peek self.kept.values).taken
    const keys = taken ? nil : self.keysNow()
    self.kept.change((values: mut GameValues): nil => {
      values.settings[variable] = text
      if (keys != nil) {
        values.taken = true
        values.keys = keys.clone()
      }
    })
  }

  public mut forget(variable: string) {
    self.kept.change((values: mut GameValues): nil => { values.settings[variable] = nil })
  }

  // The player's answer: the profile's applied, or the game's kept as they are, which the profile takes.
  public mut answer(apply: boolean) {
    self.asking = []
    if (apply) {
      self.apply()
    } else {
      self.adopt()
    }
  }

  // The game's settings as the profile holds them, and its keys; out of a fight, or once it ends.
  mut apply() {
    if (Game::situation.combat) {
      self.waiting = true
      return
    }
    self.waiting = false
    let commits = false
    for (variable, text of (peek self.kept.values).settings) {
      const value = settingValue(text)
      if (readSetting(variable) != value) { commits = writeSetting(variable, value) || commits }
    }
    if (commits) { Client::SettingsPanel?.Commit(true) }
    const keys = (peek self.kept.values).keys
    self.applying = true
    self.bindings.read()
    let changed = false
    for (command of self.bindings.commands) {
      const wanted = keys[command.action] ?? []
      if (!sameKeys(command.keys, wanted)) {
        _ = self.bindings.put(command.action, wanted)
        changed = true
      }
    }
    if (changed) { Client::SaveBindings(Client::GetCurrentBindingSet()) }
    self.applying = false
  }

  // The game's as they are now: the profile's.
  mut take() {
    const keys = self.keysNow()
    self.kept.change((values: mut GameValues): nil => {
      values.taken = true
      values.keys = keys.clone()
    })
  }

  // The game's kept as they are: each setting the profile holds takes the game's value, and the keys are the game's.
  mut adopt() {
    const keys = self.keysNow()
    self.kept.change((values: mut GameValues): nil => {
      for (variable, _ of values.settings) {
        const now = readSetting(variable)
        values.settings[variable] = now == nil ? nil : settingText(now)
      }
      values.keys = keys.clone()
    })
  }

  // Every command's keys now, those with any.
  mut keysNow(): map<string, array<string>> {
    self.bindings.read()
    const keys: map<string, array<string>> = {}
    for (command of self.bindings.commands) {
      if (command.keys.length > 0) { keys[command.action] = command.keys.clone() }
    }
    return keys
  }

  // What applying the profile would change: each setting it holds that the game has otherwise, then each command's keys.
  mut changes(): array<GameChange> {
    const list: array<GameChange> = []
    const values = peek self.kept.values
    for (variable, text of values.settings) {
      const wanted = settingValue(text)
      const now = readSetting(variable)
      if (now != wanted) {
        const name = Client::Settings?.GetSetting(variable)?.GetName() ?? variable
        list.push({ label: name, from: shown(now), to: shown(wanted) })
      }
    }
    self.bindings.read()
    for (command of self.bindings.commands) {
      const wanted = values.keys[command.action] ?? []
      if (!sameKeys(command.keys, wanted)) {
        list.push({ label: command.name, from: command.keys.join(", "), to: wanted.join(", ") })
      }
    }
    return list
  }
}
