// The «Settings» tab: Blizzard's settings window drawn with Ordaen's controls. On the left the client's groups and
// their pages in the client's order; on the right the page picked, each setting a row of the settings window's kind
// (label left with its tooltip, control right). The search finds a setting by its name or tooltip on every page: the
// list keeps the pages that hold one, the page shows the settings that match. A line only Blizzard draws (a button, a
// section of its own, an addon's own frame) opens Blizzard's window at that page.
import Client from "$client"
import Game from "$game"
import { Align, Edges, Track } from "$ltml"
import { Checkbox, Choice, Component, Dropdown, Ground, ListTab, NumberInput, PushButton, ScrolledList, Section, SettingRow, Toolbar } from "Ordaen"
import Locale from "@/locales"
import { LineKind, PageGroup, SettingLine, SettingsPage, SystemSettings, lineMatches } from "@/settings"
import Style from "@/style"

// The list as wide as its pages' names, each on one line.
const COLUMNS: array<Track> = ["max-content", { fr: 1 }]
// The room the page leaves, which each list scrolls in: never its content's whole height.
const FILL: array<Track> = [{ fr: 1, min: 0ui }]
const PAD: Edges = { left: 3sp, right: 3sp }
const INDENT: Edges = { left: 5.5sp }
const BUTTON = 234.375dp

// A dropdown's choice from the client's option.
function choiceOf(option: Client::SettingsOption): Choice<boolean | number | string> {
  return { value: option.value, label: option.label }
}

public class SettingsTab implements Component {
  // Blizzard's window asked for at a page: what only Blizzard draws. Its owner lets it through (`GamePass`).
  public blizzard: Event<integer> = new Event()
  state search = ""
  derived query: string = self.search.lower()
  // The groups the list shows: the picked one, or every one while searching.
  derived listed: array<PageGroup> = self.query != "" ? self.settings.groups : self.pickedGroup()
  derived found: map<integer, boolean> = self.settings.matching(self.query)
  derived shownLines: array<SettingLine> = self.settings.lines.filter(line => lineMatches(line, self.query))
  // The page's lines by its headings, each a section: what stands before the first heading is under the page's name.
  derived sections: array<LineSection> = sectionsOf(self.shownLines, self.titleOf())
  derived searching: boolean = self.query != ""
  derived canvas: boolean = self.pageOf()?.canvas == true

  const settings: mut SystemSettings
  // The group picked, by its place among the settings' groups.
  group: Signal<integer>
  constructor(settings: mut SystemSettings, group: Signal<integer> = 1) {
    self.settings = settings
    self.group = group
    // A group picked opens its first page, unless the page shown is one of its own.
    watch (picked of self.group) {
      const pages = (peek self.settings.groups)[picked]?.pages ?? []
      const page = peek self.settings.page
      if (pages.length > 0 && !pages.any(each => each.id == page)) { self.settings.open(pages[1]?.id ?? 0) }
    }
  }

  pickedGroup(): array<PageGroup> {
    const group = self.settings.groups[self.group]
    return group == nil ? [] : [group]
  }

  pageOf(): SettingsPage | nil {
    for (group of self.settings.groups) {
      const page = group.pages.find(candidate => candidate.id == self.settings.page)
      if (page != nil) { return page }
    }
    return nil
  }

  titleOf(): string { return self.pageOf()?.name ?? "" }

  mut onPick(id: integer) { self.settings.open(id) }
  onBlizzard() { self.blizzard.emit(self.settings.page) }

  public render(): Template {
    return $ltml {
      <box rows={["max-content", { fr: 1 }]} gap={3sp}>
        <Toolbar search={mut self.search} placeholder={Locale::SETTINGS_SEARCH} />
        <box columns={COLUMNS} rows={FILL} gap={6sp}>
          <ScrolledList>
            <PageGroupList $for={group of self.listed} group={group} captioned={self.searching} picked={self.settings.page}
                           query={self.query} found={self.found} @pick={self.onPick} />
          </ScrolledList>
          <box rows={FILL}>
            <box $if={self.canvas} rows={["max-content", "max-content"]} gap={3sp}>
              <text value={Locale::SETTINGS_ADDON_PAGE} textColor={Style::DIM} />
              <PushButton label={Locale::SETTINGS_OPEN_BLIZZARD} width={BUTTON} @click={self.onBlizzard} />
            </box>
            <ScrolledList $else ground={Ground::Wood} gap={8sp}>
              <Section $for={section of self.sections} $key={section.title} title={section.title}>
                <LineRow $for={line of section.lines} $key={`${line.variable}|${line.name}`} line={line} settings={mut self.settings}
                         @blizzard={self.onBlizzard} />
              </Section>
            </ScrolledList>
          </box>
        </box>
      </box>
    }
  }
}

// A section of a page: a heading's lines.
struct LineSection {
  title: string
  lines: array<SettingLine>
}

// A page's lines cut at its headings: a section each, the lines before the first heading under `first`.
function sectionsOf(lines: array<SettingLine>, first: string): array<LineSection> {
  const list: array<LineSection> = []
  let title = first
  let held: array<SettingLine> = []
  for (line of lines) {
    if (line.kind == .Header) {
      if (held.length > 0) { list.push({ title: title, lines: held }) }
      title = line.name
      held = []
    } else {
      held.push(line)
    }
  }
  if (held.length > 0) { list.push({ title: title, lines: held }) }
  return list
}

// A group's pages; while searching, only the pages the search finds (a group with none is left out), each group under
// its caption (the tabs name the group otherwise).
class PageGroupList implements Component {
  public pick: Event<integer> = new Event()
  derived pages: array<SettingsPage> = self.query == "" ? self.group.pages : self.group.pages.filter(page => self.found[page.id] == true)
  derived any: boolean = self.pages.length > 0

  group: Signal<PageGroup>
  picked: Signal<integer>
  query: Signal<string>
  found: Signal<map<integer, boolean>>
  captioned: Signal<boolean>
  constructor(
    group: Signal<PageGroup>, picked: Signal<integer>, query: Signal<string>, found: Signal<map<integer, boolean>>,
    captioned: Signal<boolean> = false
  ) {
    self.captioned = captioned
    self.group = group
    self.picked = picked
    self.query = query
    self.found = found
  }

  onPick(id: integer) { self.pick.emit(id) }

  public render(): Template {
    return $ltml {
      <box $if={self.any} gap={1sp}>
        <box $if={self.captioned} padding={PAD}>
          <text value={self.group.name} textColor={Style::DIM} wrap={.None} />
        </box>
        <PageEntry $for={page of self.pages} page={page} picked={self.picked} @pick={self.onPick} />
      </box>
    }
  }
}

class PageEntry implements Component {
  public pick: Event<integer> = new Event()
  derived selected: boolean = self.page.id == self.picked
  derived padding: Edges = self.page.child ? INDENT : {}

  page: Signal<SettingsPage>
  picked: Signal<integer>
  constructor(page: Signal<SettingsPage>, picked: Signal<integer>) {
    self.page = page
    self.picked = picked
  }

  onPick() { self.pick.emit(self.page.id) }

  public render(): Template {
    return $ltml {
      <box padding={self.padding}>
        <ListTab label={self.page.name} selected={self.selected} oneLine={true} @pick={self.onPick} />
      </box>
    }
  }
}

// One line of a page: a section's header, a setting with its control, or what only Blizzard draws. The control shows
// the client's value, and writes it as it is changed, out of a fight (the client holds some of them in one).
class LineRow implements Component {
  public blizzard: Event<nil> = new Event()
  state checked = false
  state number: number = 0
  state chosen: boolean | number | string = ""
  derived choices: array<Choice<boolean | number | string>> = self.line.kind == .Choice ?
    self.settings.choicesOf(self.settings.page, self.line.variable).map(option => choiceOf(option)) : []
  derived fighting: boolean = Game::situation.combat
  derived locked: boolean = self.line.writing == .None || self.fighting
  // A line under a checkbox that is off: hidden, as Blizzard's is.
  derived hidden: boolean = self.settings.values[self.line.under] == false
  derived tip: string = self.settings.tipOf(self.line)
  derived inset: Edges = self.line.under == "" ? {} : INDENT

  line: Signal<SettingLine>
  const settings: mut SystemSettings
  constructor(line: Signal<SettingLine>, settings: mut SystemSettings) {
    self.line = line
    self.settings = settings
    watch {
      const value = self.settings.values[self.line.variable]
      if (value is boolean) { self.checked = value }
      if (value is number) { self.number = value }
      if (value != nil) { self.chosen = value }
    }
    // Each control speaks for its own kind of line alone: the others hold their first values, never the setting's.
    watch (checked of self.checked) {
      if ((peek self.line).kind == .Check) { self.changed(checked) }
    }
    watch (number of self.number) {
      if ((peek self.line).kind == .Slider) { self.changed(number) }
    }
    watch (chosen of self.chosen) {
      if ((peek self.line).kind == .Choice) { self.changed(chosen) }
    }
  }

  // A control's value that isn't the client's: the player changed it, and the variable is written.
  mut changed(value: boolean | number | string) {
    const variable = peek self.line.variable
    const now = (peek self.settings.values)[variable]
    if (now == nil || now == value || peek self.locked) { return }
    self.settings.write(peek self.line, value)
  }

  onBlizzard() { self.blizzard.emit() }

  public render(): Template {
    return $ltml {
      <box $if={!self.hidden} padding={self.inset}>
        <Checkbox $if={self.line.kind == LineKind::Check} label={self.line.name} value={mut self.checked}
                  hint={self.tip} disabled={self.locked} />
        <NumberInput $elseif={self.line.kind == LineKind::Slider} label={self.line.name} value={mut self.number}
                     least={peek self.line.least} most={peek self.line.most} step={peek self.line.step} format={peek self.line.format} hint={self.tip} disabled={self.locked} />
        <Dropdown $elseif={self.line.kind == LineKind::Choice} label={self.line.name} value={mut self.chosen}
                  choices={peek self.choices} hint={self.tip} disabled={self.locked} />
        <SettingRow $else label={self.line.name} hint={self.tip}>
          <box xAlign={Align::Start}>
            <PushButton label={Locale::SETTINGS_OPEN_BLIZZARD} width={BUTTON} disabled={self.fighting} @click={self.onBlizzard} />
          </box>
        </SettingRow>
      </box>
    }
  }
}
