// The AddOns window: one tab, «AddOns» (the client's `ADDONS`), its line how many are on. The header (the search,
// how many show, for whom, the filter, the sort, the view), the columns' headings, the list (by category, an addon's
// group under it, or one table), the strip of the last step's extras with «Undo»; the picked addon's card at the
// right; on the footer row «Reset», «Disable all» and «Sets» at the left, what waits for a reload and «Reload» at
// the right.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Action, Align, Edges, Track } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { ARTWORK, ButtonPlate, Choice, Component, Dialog, FooterBand, KeptWindow, Menu, MenuEntry, ModuleMemory, Placing, PushButton, SECONDARY_TEXT, ScrolledList, Tabs, TextField, Tip, TipRow, TipText, ToolPick, Toolbar, WINDOW_ROOM, Window, WindowSide, WindowTabSpec } from "Ordaen"
import { Card } from "@/card"
import { AddOn, Catalog, Status, plain } from "@/catalog"
import { Age, FilterPick, Heat, Loading, Standing, Written } from "@/filter"
import { Bindings } from "@/keys"
import { KeysPage } from "@/keysPage"
import Locale from "@/locales"
import { Profiler, percent } from "@/perf"
import { COLUMNS, Hot, Line, LineRow, TABLE_COLUMNS } from "@/rows"
import { MOST, Sets } from "@/sets"
import { SystemSettings } from "@/settings"
import { SettingsTab } from "@/settingsPage"
import Style from "@/style"

public enum Order implements Plain { Name = "name", Now = "now", Peak = "peak", Memory = "memory" }
public enum View implements Plain { Categories = "categories", Table = "table" }

// How the player left the list, the profile's (`ModuleMemory`): whose addons it shows, the filter (a
// choice in each kind, `@/filter`), the order and which way (the heaviest first for a number's column, reversed by a
// second click on a table's heading), the view, and the addon whose card stands beside it. The search isn't kept: a
// list cut short by an old search at the next opening says nothing of why.
public struct ListView implements Plain {
  everyone: Boolean = true
  heat: Heat = Heat.All
  standing: Standing = Standing.All
  age: Age = Age.All
  loading: Loading = Loading.All
  written: Written = Written.All
  order: Order = Order.Name
  descending: Boolean = false
  view: View = View.Categories
  picked: String = ""
}
const LIST_VIEW: ListView = {}

// The categories and the groups' parents the player folded, the profile's as the list's view is, in the order folded:
// kept so the list opens after a reload as the player left it. A memory of its own, so a long category's name can
// never take the filters past a memory's bound with it; at most `FOLDED_MOST` names of each, the earliest folded let
// go first, and a category or a parent no addon has any more let go as the window opens.
public struct Folded implements Plain {
  categories: Array<String> = []
  parents: Array<String> = []
}
const FOLDED: Folded = {}
public const FOLDED_MOST = 8

const ORDERS: Array<Choice<Order>> = [
  { value: Order.Name, label: Locale.SORT_NAME },
  { value: Order.Now, label: Locale.SORT_NOW },
  { value: Order.Peak, label: Locale.SORT_PEAK },
  { value: Order.Memory, label: Locale.SORT_MEMORY }
]
const VIEWS: Array<Choice<View>> = [
  { value: View.Categories, label: Locale.VIEW_CATEGORIES, icon: ARTWORK.ctl.tool.categories },
  { value: View.Table, label: Locale.VIEW_TABLE, icon: ARTWORK.ctl.tool.table }
]
// The memory column's refresh: a toolbar glyph's 16 px cell, drawn 1:1.
const REFRESH = 18.75dp
const BODY: Array<Track> = ["max-content", "max-content", { fr: 1 }, "max-content", "max-content"]
const FOOT: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
const GROUP: Array<Track> = ["max-content", "max-content"]
// «Reset», «Disable all» and «Sets».
const LEFT_GROUP: Array<Track> = ["max-content", "max-content", "max-content"]
const STRIP: Array<Track> = [{ fr: 1 }, "max-content"]
// The list runs to the window's frame and footer; the toolbar, the headings and the lines under the list keep the
// window's room, as the rows' text does.
const HEADING: Edges = { left: WINDOW_ROOM, right: WINDOW_ROOM }
const TOOLS: Edges = { top: 6sp, left: WINDOW_ROOM, right: WINDOW_ROOM }
const EDGE_TO_EDGE: Edges = { top: 0sp, right: 0sp, bottom: 0sp, left: 0sp }
const HALF: Number<Spacing> = 3sp / 2
// «Reload»: the client does it from the player's click (Forever refuses `ReloadUI` from addon code).
const RELOAD: Action = Action.RunMacro { macro: "/reload" }
const RELOAD_TIP: TipText = { title: Locale.RELOAD, text: Locale.IN_COMBAT, rows: [] }
const CONFIRM_WIDTH = 539.0625dp
// The set's dialog: room for its name's row, the label and the field.
const SET_WIDTH = 820.3125dp
const BUTTON = 140.625dp
// The window's tabs, by their place: the game's options, and its mods (the AddOns list).
public const SETTINGS_TAB = 1
public const ADDONS_TAB = 2
// The options' own small tab of key bindings, second after the game's first group (as Blizzard lists them).
const KEYS_SECTION = 2
const OPTIONS_ROWS: Array<Track> = ["max-content", { fr: 1, min: 0ui }]
const FILL: Array<Track> = [{ fr: 1, min: 0ui }]
// Under the options' tabs, which run edge to edge: the window's room round the page.
const OPTIONS_PAGE: Edges = { top: 4sp, right: WINDOW_ROOM, bottom: 5sp, left: WINDOW_ROOM }

// An addon of a parent's group (`## Group`), the parent itself aside.
function isUnder(addon: AddOn, parent: String): Boolean { return addon.group == parent && addon.name != parent }

// A fold's names with `name` folded, or opened where it was folded; past `FOLDED_MOST`, the earliest folded opens.
function flipped(kept: Array<String>, name: String): Array<String> {
  const next = kept.filter(held => held != name)
  if (next.length == kept.length) { next.push(name) }
  const capped: Array<String> = []
  for (index, held of next) {
    if (index > next.length - FOLDED_MOST) { capped.push(held) }
  }
  return capped
}

// The value of the column `order` sorts by.
function weightOf(order: Order, name: String, profiler: Profiler): Number {
  return match (order) {
    .Name => 0
    .Now => (peek profiler.loads)[name]?.now ?? -1
    .Peak => (peek profiler.loads)[name]?.peak ?? -1
    .Memory => (peek profiler.memory)[name] ?? -1
  }
}

// From which value a column is lit: its heaviest third, of the values above nought.
function thirdOf(values: Array<Number>): Number {
  const list: Array<Number> = []
  for (value of values) {
    if (value > 0) { list.push(value) }
  }
  if (list.length == 0) { return Number.huge }
  list.sort((a, b) => a > b)
  return list[(list.length / 3).ceil()] ?? Number.huge
}

// Where the window opens until the player moves it.
public const WINDOW: Placing = { x: 0ui, y: 0ui, width: Style.WIDTH, height: Style.HEIGHT }

public class AddOnsWindow implements Component {
  public close: Event<nil> = new Event()
  // Blizzard's settings window asked for at a page.
  public blizzard: Event<Integer> = new Event()

  state tab = 1
  // The window as the root declares it (`System.window`); one of its own where it is made alone (a test's).
  declared: mut KeptWindow
  state search = ""
  public list: mut ModuleMemory<ListView> = new ModuleMemory<ListView>(LIST_VIEW, .Profile, "addons")
  public folds: mut ModuleMemory<Folded> = new ModuleMemory<Folded>(FOLDED, .Profile, "addons:folded")
  // What is to be switched off once the player answers, with the question's title.
  public state asking: Array<String> = []
  // The sets' menu, and the set being saved (-1) or looked at (its place); 0: none.
  state setsOpen = false
  state editing = 0
  state setName = ""
  state setNote = ""
  state waitHovered = false

  derived visible: Array<AddOn> = self.visibleOf()
  derived lines: Array<Line> = self.linesOf()
  derived hot: Hot = self.hotOf()
  derived countText: String = self.visible.length == self.catalog.addons.length ? "%d".format(self.visible.length) :
    Locale.COUNT_OF.format(self.visible.length, self.catalog.addons.length)
  derived tabs: Array<WindowTabSpec> = [
    { title: Client.SETTINGS_TITLE, desc: "", icon: "Interface/Icons/INV_Misc_Gear_01", padding: EDGE_TO_EDGE },
    { title: Client.ADDONS, desc: self.onText(), icon: "Interface/Icons/INV_Misc_Wrench_01", padding: EDGE_TO_EDGE }
  ]
  // The options' small tab picked: the game's groups in the client's order, its key bindings second.
  state section = 1
  derived sections: Array<String> = self.sectionsOf()
  derived onOptions: Boolean = self.tab == SETTINGS_TAB
  derived onKeys: Boolean = self.onOptions && self.section == KEYS_SECTION
  derived onGameSettings: Boolean = self.onOptions && !self.onKeys
  // The group of the settings shown, by its place among the client's groups.
  derived group: Integer = self.section < KEYS_SECTION ? self.section : self.section - 1
  derived onAddOns: Boolean = self.tab == ADDONS_TAB
  derived side: WindowSide | nil = self.onAddOns && self.list.values.picked != "" && self.catalog.byName[self.list.values.picked] != nil ?
    { width: Style.CARD, content: self.card } : nil
  // Asked before every key goes back to the client's defaults.
  state resetAsked = false
  // Asked before the page's settings go back to their defaults.
  state defaultsAsked = false
  // Nothing of the settings waits for Apply, or a fight holds them.
  derived nothingWaits: Boolean = self.settings.waiting.length == 0 || self.fighting
  derived pickedModule: Boolean = self.catalog.byName[self.list.values.picked]?.group == self.framework
  derived tabled: Boolean = self.list.values.view == .Table
  derived columns: Array<Track> = self.tabled ? TABLE_COLUMNS : COLUMNS
  derived overall: String = self.profiler.measuring ? Locale.ALL_ADDONS.format(percent(self.profiler.overall)) : ""
  derived notMeasuring: Boolean = !self.profiler.measuring
  derived also: String = Locale.ALSO.format((self.catalog.step?.also ?? []).join(", "))
  derived stepShown: Boolean = self.catalog.step != nil
  derived question: String = Locale.DISABLE_ASK.format(self.dependentsText())
  derived questionTitle: String = Locale.DISABLE_TITLE.format(self.catalog.titleOf(self.asking[1] ?? ""))
  derived setEntries: Array<MenuEntry> = self.setEntriesOf()
  derived setTitle: String = self.editing < 0 ? Locale.SET_NEW :
    Locale.SET_TITLE.format(self.sets.list[self.editing]?.name ?? "")
  derived waitText: String = self.catalog.waiting > 0 ? Locale.RELOAD_NEEDED.format(self.catalog.waiting) : ""
  derived waitRows: Array<TipRow> = self.waitRowsOf()
  derived fighting: Boolean = Game.situation.combat
  // In a fight «Reload» says why it waits, under the cursor.
  derived reloadTip: TipText | nil = self.fighting ? RELOAD_TIP : nil
  derived waitTip: Boolean = self.waitHovered && self.waitText != ""

  const card: Template = $ltml {
    <Card name={self.list.values.picked} catalog={mut self.catalog} profiler={self.profiler} module={self.pickedModule}
          @pick={self.onPick} @toggle={self.onCardToggle} @settings={self.onSettings} />
  }
  // The open tab's footer: none for the settings, the keys' (every key back to the client's defaults, after asking), or the addons'.
  const footer: Template = $ltml {
    <FooterBand $if={self.onGameSettings}>
      <box columns={FOOT} gap={6sp} yAlign={Align.Center}>
        <PushButton label={Client.SETTINGS_DEFAULTS} width={BUTTON} disabled={self.fighting} @click={self.onDefaultsAsk} />
        <box />
        <PushButton label={Client.APPLY} width={BUTTON} plate={ButtonPlate.Accent} disabled={self.nothingWaits}
                    @click={self.onApply} />
      </box>
    </FooterBand>
    <FooterBand $elseif={self.onKeys}>
      <box columns={FOOT} gap={6sp} yAlign={Align.Center}>
        <PushButton label={Locale.KEYS_RESET_ALL} width={BUTTON} disabled={self.fighting} @click={self.onResetAsk} />
        <box />
        <box />
      </box>
    </FooterBand>
    <FooterBand $else>
      <box columns={FOOT} gap={6sp} yAlign={Align.Center}>
        <box columns={LEFT_GROUP} gap={3sp} yAlign={Align.Center}>
          <PushButton label={Locale.RESET} width={BUTTON} @click={self.onReset} />
          <PushButton label={Locale.DISABLE_ALL} width={BUTTON} @click={self.onDisableAll} />
          <box>
            <PushButton label={Locale.SETS} width={BUTTON} @click={self.onSets} />
            <Menu $if={self.setsOpen} entries={self.setEntries} @pick={self.onSet} @close={self.closeSets} />
          </box>
        </box>
        <box />
        <box columns={GROUP} gap={3sp} yAlign={Align.Center}>
          <box @pointerEnter={self.onWaitEnter} @pointerLeave={self.onWaitLeave}>
            <text value={self.waitText} textColor={Style.GOLD} textSize={SECONDARY_TEXT} wrap={.None} />
            <Tip $if={self.waitTip} title={self.waitText} text={""} rows={self.waitRows} />
          </box>
          <PushButton label={Locale.RELOAD} width={187.5dp} plate={ButtonPlate.Accent} disabled={self.fighting} action={RELOAD}
                      tip={self.reloadTip} />
        </box>
      </box>
    </FooterBand>
  }

  // Closed, it stays drawn: it opens again at the cost of a surface shown.
  shown: Signal<Boolean>
  const bindings: mut Bindings = new Bindings()
  const settings: mut SystemSettings = new SystemSettings()
  const catalog: mut Catalog = new Catalog()
  const profiler: mut Profiler = new Profiler()
  const sets: mut Sets = new Sets()
  // Ordaen's folder: the addon its modules stand under.
  const framework: String
  const whom: Array<Choice<Boolean>>
  constructor(framework: String, shown: Signal<Boolean> = true, declared: mut KeptWindow | nil = nil) {
    self.declared = declared ?? new KeptWindow("addons", Client.ADDONS, WINDOW)
    self.shown = shown
    self.framework = framework
    self.whom = [{ value: true, label: Locale.WHO_ALL }, { value: false, label: Game.player.name }]
    watch (open of self.shown) { self.follow(open) }
    watch { self.catalog.setEveryone(self.list.values.everyone) }
    // The keys are read as their tab shows, and again whenever the client's change (Forever's preset page, an addon
    // loaded later, another window), while it shows.
    watch {
      if (self.shown && self.onKeys) {
        self.bindings.read()
        Events.UPDATE_BINDINGS.listen(self.onBindings)
      }
    }
    // Blizzard's settings are read as their tab shows, and the page's values again whenever a console variable
    // changes, while it shows.
    watch {
      if (self.shown && self.onOptions) {
        self.settings.read()
        Events.CVAR_UPDATE.listen(self.onSetting)
      }
    }
  }

  onBindings(mut self) { self.bindings.read() }
  onSetting(mut self, name: String, value: String) { self.settings.refresh() }
  // The options' small tabs: each group's name, the key bindings' second.
  sectionsOf(self): Array<String> {
    const names = self.settings.groups.map(group => group.name)
    const keys = Runtime.text("SETTINGS_KEYBINDINGS_LABEL") ?? Client.KEY_BINDINGS
    const list: Array<String> = []
    for (index, name of names) {
      if (index == KEYS_SECTION) { list.push(keys) }
      list.push(name)
    }
    if (names.length < KEYS_SECTION) { list.push(keys) }
    return list
  }
  onResetAsk(mut self) { self.resetAsked = true }
  onDefaultsAsk(mut self) { self.defaultsAsked = true }
  cancelDefaults(mut self) { self.defaultsAsked = false }
  confirmDefaults(mut self) {
    self.defaultsAsked = false
    self.settings.defaults()
  }
  onApply(mut self) { self.settings.apply() }
  cancelReset(mut self) { self.resetAsked = false }
  confirmReset(mut self) {
    self.resetAsked = false
    _ = self.bindings.resetAll()
  }

  // Each open reads the list in one pass and samples once a second, hearing `ADDON_LOADED` while it shows; a close
  // stops both.
  follow(mut self, open: Boolean) {
    if (!open) {
      self.profiler.stop()
      return
    }
    self.catalog.read()
    self.dropGone()
    const loaded: Array<String> = []
    for (addon of peek self.catalog.addons) {
      if ((peek self.catalog.statuses)[addon.name]?.loaded == true) { loaded.push(addon.name) }
    }
    self.profiler.start(loaded)
    Events.ADDON_LOADED.listen(self.onLoaded)
  }

  onLoaded(mut self, name: String, fromUser: Boolean) { self.catalog.refresh() }

  onText(self): String {
    let on = 0
    for (addon of self.catalog.addons) {
      if (self.catalog.statuses[addon.name]?.enabled != .Off) { on += 1 }
    }
    return Locale.COUNT_OF.format(on, self.catalog.addons.length)
  }

  // Whether an addon shows with the search and the filter as they are: it matches every kind.
  matches(self, addon: AddOn, status: Status | nil): Boolean {
    const query = self.search.lower()
    if (query != "" && !addon.words.contains(query)) { return false }
    const hot = match (self.list.values.heat) {
      .All => true
      .Heavy => self.profiler.heavy[addon.name] == true
    }
    const standing = match (self.list.values.standing) {
      .All => true
      .On => status != nil && status.enabled != .Off
      .Off => status == nil || status.enabled == .Off
      .Failed => status != nil && status.reason != nil && status.reason != "DISABLED" && status.enabled != .Off
    }
    const age = match (self.list.values.age) {
      .All => true
      .Outdated => addon.outdated
      .Current => !addon.outdated
    }
    const loading = match (self.list.values.loading) {
      .All => true
      .Demand => addon.demand
      .Login => !addon.demand
    }
    const written = match (self.list.values.written) {
      .All => true
      .LunaType => addon.lunatype
      .Other => !addon.lunatype
    }
    return hot && standing && age && loading && written
  }

  // The addons that show, in the order the sort says.
  visibleOf(self): Array<AddOn> {
    const list: Array<AddOn> = []
    for (addon of self.catalog.addons) {
      if (self.matches(addon, self.catalog.statuses[addon.name])) { list.push(addon) }
    }
    const order = self.list.values.order
    const down = self.list.values.descending
    const profiler = self.profiler
    // Read so the list follows the numbers it sorts by.
    _ = self.profiler.loads
    _ = self.profiler.memory
    list.sort((a, b) => {
      if (order != .Name) {
        const x = weightOf(order, a.name, profiler)
        const y = weightOf(order, b.name, profiler)
        if (x != y) { return down ? x < y : x > y }
      }
      return down && order == .Name ? a.key > b.key : a.key < b.key
    })
    return list
  }

  // The lines: in a table, every addon shown; by category, a caption for each category (by its exact text, «Other»
  // last) and its addons, each group's members right under their parent, indented.
  linesOf(self): Array<Line> {
    const list: Array<Line> = []
    if (self.list.values.view == .Table) {
      for (addon of self.visible) {
        list.push({
          caption: false, name: addon.name, count: 0, folded: false, child: false, parent: false, names: [], tabled: true
        })
      }
      return list
    }
    // Each group whole, whatever the search and the filter show of it: what its caption's switch switches.
    const groups: Map<String, mut Array<String>> = {}
    for (addon of self.catalog.addons) {
      if (addon.group != self.framework || addon.name == self.framework) {
        const held = groups[addon.category]
        if (held == nil) {
          groups[addon.category] = [addon.name]
        } else {
          held.push(addon.name)
        }
      }
    }
    const byCategory: Map<String, mut Array<AddOn>> = {}
    const categories: Array<String> = []
    for (addon of self.visible) {
      const held = byCategory[addon.category]
      if (held == nil) {
        categories.push(addon.category)
        byCategory[addon.category] = [addon]
      } else {
        held.push(addon)
      }
    }
    categories.sort((a, b) => a == "" ? false : b == "" ? true : a < b)
    for (category of categories) {
      const members = byCategory[category] ?? []
      const folded = self.folds.values.categories.any(name => name == category)
      list.push({
        caption: true, name: category, count: members.length, folded: folded, child: false, parent: false,
        names: groups[category] ?? [], tabled: false
      })
      if (!folded) {
        const here: Map<String, Boolean> = {}
        for (addon of members) { here[addon.name] = true }
        for (addon of members) {
          if (addon.group == "" || addon.group == addon.name || here[addon.group] != true) {
            const under = members.filter(member => isUnder(member, addon.name))
            const shut = under.length > 0 && self.folds.values.parents.any(name => name == addon.name)
            list.push({
              caption: false, name: addon.name, count: 0, folded: shut, child: false, parent: under.length > 0, names: [],
              tabled: false
            })
            if (!shut) {
              for (member of under) {
                list.push({
                  caption: false, name: member.name, count: 0, folded: false, child: true, parent: false, names: [],
                  tabled: false
                })
              }
            }
          }
        }
      }
    }
    return list
  }

  hotOf(self): Hot {
    const now: Array<Number> = []
    const peak: Array<Number> = []
    for (_, load of self.profiler.loads) {
      now.push(load.now)
      peak.push(load.peak)
    }
    const weights: Array<Number> = []
    for (_, kb of self.profiler.memory) { weights.push(kb) }
    return { now: thirdOf(now), peak: thirdOf(peak), memory: thirdOf(weights) }
  }

  dependentsText(self): String {
    const names: Array<String> = []
    for (name of self.catalog.dependentsOf(self.asking)) { names.push(self.catalog.titleOf(name)) }
    return names.join(", ")
  }

  setEntriesOf(self): Array<MenuEntry> {
    const list: Array<MenuEntry> = [{ label: Locale.SET_SAVE }]
    for (index, kept of self.sets.list) { list.push({ label: kept.name, group: index == 1 }) }
    return list
  }

  waitRowsOf(self): Array<TipRow> {
    const list: Array<TipRow> = []
    for (addon of self.catalog.addons) {
      const status = self.catalog.statuses[addon.name]
      if (status != nil) {
        if (status.mine && !status.loaded && !addon.demand && status.reason == nil) {
          list.push({ label: plain(addon.title), value: Locale.STATE_WAITS })
        } else if (!status.mine && status.loaded) {
          list.push({ label: plain(addon.title), value: Locale.STATE_UNTIL })
        }
      }
    }
    return list
  }

  onPick(mut self, name: String) { self.list.values.picked = name }

  // A caption clicked: folded, or opened where it was folded; past `FOLDED_MOST`, the earliest folded opens.
  onFold(mut self, category: String) {
    self.folds.values.categories = flipped((peek self.folds.values).categories, category)
  }

  // A group's parent's mark clicked: its members folded under it, or shown again; as captions are, at most
  // `FOLDED_MOST`.
  onFoldGroup(mut self, parent: String) {
    self.folds.values.parents = flipped((peek self.folds.values).parents, parent)
  }

  // The folded categories and parents no addon has any more (each addon of one taken out of the folder) are let go.
  dropGone(mut self) {
    const categories: Map<String, Boolean> = {}
    const names: Map<String, Boolean> = {}
    for (addon of peek self.catalog.addons) {
      categories[addon.category] = true
      names[addon.name] = true
    }
    const kept = peek self.folds.values
    if (!kept.categories.all(name => categories[name] == true)) {
      self.folds.values.categories = kept.categories.filter(name => categories[name] == true)
    }
    if (!kept.parents.all(name => names[name] == true)) {
      self.folds.values.parents = kept.parents.filter(name => names[name] == true)
    }
  }

  onSettings(self, name: String) { Ordaen.toggleNamed(name) }

  // The checkbox: on with what it needs; off alone, after asking where others need it. With Ctrl on a group's
  // parent, the parent and every addon of its group to the parent's new state together.
  public onToggle(mut self, name: String, control: Boolean) {
    const names: Array<String> = [name]
    if (control) {
      for (member of (peek self.catalog.members)[name] ?? []) { names.push(member) }
    }
    if (!self.catalog.isOn(name)) {
      self.catalog.switchOn(names)
      return
    }
    self.switchOff(names)
  }

  // A caption's switch: its whole group on for all where any of it isn't, else off, after asking where others need it.
  onToggleGroup(mut self, names: Array<String>) {
    if (names.length == 0) { return }
    const statuses = peek self.catalog.statuses
    if (!names.all(name => statuses[name]?.enabled == .On)) {
      self.catalog.switchOn(names)
      return
    }
    self.switchOff(names)
  }

  // Off alone, or after asking where others that stay on need what goes.
  switchOff(mut self, names: Array<String>) {
    if (self.catalog.dependentsOf(names).length == 0) {
      self.catalog.switchOff(names)
    } else {
      self.asking = names
    }
  }

  onCardToggle(mut self, name: String) { self.onToggle(name, false) }

  // «Load» from a row's menu: the addon loads now, its card opens to say how it went (the client's reason, where it
  // refused, is its row's and its card's state).
  onLoadNow(mut self, name: String) {
    self.list.values.picked = name
    _ = self.catalog.load(name)
  }

  cancelAsk(mut self) { self.asking = [] }

  confirmAsk(mut self) {
    const names = peek self.asking
    self.asking = []
    self.catalog.switchOff(names)
  }

  onUndo(mut self) { self.catalog.undo() }
  onReset(mut self) { self.catalog.reset() }
  // This addon and what it needs stay on: the page is there after the reload to switch the rest on again.
  onDisableAll(mut self) { self.catalog.disableAll(Runtime.Addon.of(self)?.name ?? "") }
  onRefresh(mut self) { self.profiler.weigh() }
  onSets(mut self) { self.setsOpen = !self.setsOpen }
  closeSets(mut self) { self.setsOpen = false }

  onSet(mut self, index: Integer) {
    self.setsOpen = false
    self.setNote = ""
    if (index == 1) {
      self.editing = -1
      self.setName = ""
    } else {
      self.editing = index - 1
      const kept = (peek self.sets.list)[index - 1]
      self.setName = kept?.name ?? ""
      // What «Apply» will skip is said before it: «Apply» reloads at once.
      const skipped = self.catalog.missing(kept?.addons ?? [])
      if (skipped.length > 0) { self.setNote = Locale.SET_SKIPPED.format(skipped.join(", ")) }
    }
  }

  closeSet(mut self) { self.editing = 0 }

  saveSet(mut self) {
    const name = peek self.setName
    if (name == "") { return }
    if (self.sets.save(name, self.catalog.onNames())) {
      self.editing = 0
    } else {
      self.setNote = Locale.SETS_FULL.format(MOST)
    }
  }

  // From the click on «Apply», a secure box: the client reloads the interface right after it (`RELOAD`).
  applySet(mut self) {
    const kept = (peek self.sets.list)[peek self.editing]
    if (kept == nil) { return }
    self.catalog.apply(kept.addons)
    self.editing = 0
  }

  renameSet(mut self) {
    self.sets.rename(peek self.editing, peek self.setName)
    self.editing = 0
  }

  deleteSet(mut self) {
    self.sets.remove(peek self.editing)
    self.editing = 0
  }

  // A heading of a table sorts by its column, again the other way.
  sortBy(mut self, order: Order) {
    if (self.list.values.view != .Table) { return }
    if (self.list.values.order == order) {
      self.list.values.descending = !self.list.values.descending
    } else {
      self.list.values.order = order
      self.list.values.descending = false
    }
  }

  onHeadName(mut self) { self.sortBy(.Name) }
  onHeadNow(mut self) { self.sortBy(.Now) }
  onHeadPeak(mut self) { self.sortBy(.Peak) }
  onHeadMemory(mut self) { self.sortBy(.Memory) }
  onWaitEnter(mut self) { self.waitHovered = true }
  onWaitLeave(mut self) { self.waitHovered = false }
  onClose(mut self) { self.close.emit() }
  onBlizzard(self, page: Integer) { self.blizzard.emit(page) }

  public render(self): Template {
    return $ltml {
      <Window tabs={self.tabs} selected={mut self.tab} declared={mut self.declared} shown={self.shown}
              footer={self.footer} side={self.side} @close={self.onClose}>
        <box $if={self.onOptions} rows={OPTIONS_ROWS}>
          <Tabs tabs={self.sections} selected={mut self.section} />
          <box padding={OPTIONS_PAGE} rows={FILL}>
            <KeysPage $if={self.onKeys} bindings={mut self.bindings} fighting={self.fighting} />
            <SettingsTab $else settings={mut self.settings} group={self.group} @blizzard={self.onBlizzard} />
          </box>
        </box>
        <box $else rows={BODY} gap={3sp}>
          <box padding={TOOLS}>
            <Toolbar search={mut self.search} placeholder={Locale.SEARCH}>
              <box padding={HEADING}>
                <text value={self.countText} textColor={Style.DIM} textFont={.Numbers} wrap={.None} />
              </box>
              <ToolPick value={mut self.list.values.everyone} choices={self.whom} icon={ARTWORK.ctl.tool.whom} title={Locale.WHO} />
              <FilterPick heat={mut self.list.values.heat} standing={mut self.list.values.standing} age={mut self.list.values.age} loading={mut self.list.values.loading}
                          written={mut self.list.values.written} />
              <ToolPick $if={!self.tabled} value={mut self.list.values.order} choices={ORDERS} icon={Ordaen.art.ctl.tool.sort}
                        title={Locale.SORT} />
              <ToolPick value={mut self.list.values.view} choices={VIEWS} icon={Ordaen.art.ctl.tool.categories}
                        title={Locale.VIEW} />
            </Toolbar>
          </box>
          <box columns={self.columns} gap={3sp} padding={HEADING} yAlign={Align.Center}>
            <box @pointerPress={self.onHeadName} @keyPress(.Enter)={self.onHeadName} @keyPress(.Space)={self.onHeadName}>
              <text value={Locale.COL_ADDON} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.None} />
            </box>
            <box xAlign={Align.End}>
              <text value={self.overall} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.None} />
            </box>
            <text $if={self.tabled} value={Locale.COL_CATEGORY} textColor={Style.DIM} textSize={SECONDARY_TEXT}
                  wrap={.None} />
            <box xAlign={Align.End} @pointerPress={self.onHeadNow} @keyPress(.Enter)={self.onHeadNow} @keyPress(.Space)={self.onHeadNow}>
              <text value={Locale.COL_NOW} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.None} />
            </box>
            <box xAlign={Align.End} @pointerPress={self.onHeadPeak} @keyPress(.Enter)={self.onHeadPeak} @keyPress(.Space)={self.onHeadPeak}>
              <text value={Locale.COL_PEAK} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.None} />
            </box>
            <box columns={GROUP} gap={HALF} xAlign={Align.End}>
              <box @pointerPress={self.onHeadMemory} @keyPress(.Enter)={self.onHeadMemory} @keyPress(.Space)={self.onHeadMemory}>
                <text value={Locale.COL_MEMORY} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.None} />
              </box>
              <box width={REFRESH} height={REFRESH} background={ARTWORK.ctl.tool.refresh} tint={Style.GOLD}
                   @pointerPress={self.onRefresh} @keyPress(.Enter)={self.onRefresh} @keyPress(.Space)={self.onRefresh} />
            </box>
            <box />
          </box>
          <ScrolledList virtual={true}>
            <LineRow $for={line of self.lines} line={line} catalog={self.catalog} profiler={self.profiler}
                     hot={self.hot} picked={self.list.values.picked} framework={self.framework} @pick={self.onPick}
                     @toggle={self.onToggle} @toggleGroup={self.onToggleGroup} @fold={self.onFold} @foldGroup={self.onFoldGroup}
                     @settings={self.onSettings} @loadNow={self.onLoadNow} />
          </ScrolledList>
          <box $if={self.stepShown} columns={STRIP} gap={3sp} yAlign={Align.Center} padding={HEADING}>
            <box xAlign={Align.End}>
              <text value={self.also} textColor={Style.INK} textSize={SECONDARY_TEXT} />
            </box>
            <PushButton label={Locale.UNDO} width={BUTTON} @click={self.onUndo} />
          </box>
          <box $else />
          <box $if={self.notMeasuring} padding={HEADING}>
            <text value={Locale.NOT_MEASURING} textColor={Style.DIM} textSize={SECONDARY_TEXT} />
          </box>
        </box>
        <Dialog $if={self.asking.length > 0} title={self.questionTitle} width={CONFIRM_WIDTH}>
          <text value={self.question} textColor={Style.INK} />
          <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.cancelAsk} />
          <PushButton #buttons label={Locale.DISABLE} width={BUTTON} @click={self.confirmAsk} />
        </Dialog>
        <Dialog $if={self.editing != 0} title={self.setTitle} width={SET_WIDTH}>
          <TextField label={Locale.SET_NAME} value={mut self.setName} maxLength={40} />
          <text $if={self.setNote != ""} value={self.setNote} textColor={Style.RED} textSize={SECONDARY_TEXT} />
          <box $if={self.editing > 0} xAlign={Align.Start}>
            <PushButton label={Locale.DELETE} width={BUTTON} @click={self.deleteSet} />
          </box>
          <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.closeSet} />
          <PushButton #buttons $if={self.editing < 0} label={Locale.SAVE} width={BUTTON} @click={self.saveSet} />
          <PushButton #buttons $if={self.editing > 0} label={Locale.RENAME} width={BUTTON} @click={self.renameSet} />
          <PushButton #buttons $if={self.editing > 0} label={Locale.APPLY} width={BUTTON} disabled={self.fighting}
                      action={RELOAD} @click={self.applySet} />
        </Dialog>
        <Dialog $if={self.resetAsked} title={Client.KEY_BINDINGS} width={CONFIRM_WIDTH}>
          <text value={Client.CONFIRM_RESET_KEYBINDINGS} textColor={Style.INK} />
          <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.cancelReset} />
          <PushButton #buttons label={Locale.KEYS_RESET_ALL} width={BUTTON} disabled={self.fighting} @click={self.confirmReset} />
        </Dialog>
        <Dialog $if={self.defaultsAsked} title={Client.SETTINGS_DEFAULTS} width={CONFIRM_WIDTH}>
          <text value={Locale.SETTINGS_DEFAULTS_ASK} textColor={Style.INK} />
          <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.cancelDefaults} />
          <PushButton #buttons label={Client.SETTINGS_DEFAULTS} width={BUTTON} disabled={self.fighting} @click={self.confirmDefaults} />
        </Dialog>
      </Window>
    }
  }
}
