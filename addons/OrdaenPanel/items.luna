// The panel's items that are rows of cells or of text: the game's menu, friends and guild, the money, the bags. Each
// is drawn in its zone of the panel, or standing free where the player put it.
import Game from "$game"
import { Align, Shadow, Track } from "$ltml"
import { Component } from "Ordaen"
import { Cell, CellGroup } from "@/group"

const INK: Color = Color.hex("#e8dcc4")
const TEXT = 12
// Down a side of the screen: one under another.
const DOWN: Array<Track> = ["auto"]
const PAIR: Array<Track> = ["auto", "auto"]

// The game's menu's buttons before its last.
function menuOf(faced: Boolean, social: Boolean): Array<Cell> {
  let cells: Array<Cell> = []
  if (faced) { cells.push(Cell.Face) }
  cells.push(Cell.Menu { icon: "@/assets/micro-professions.tga", frame: Game.frames.ProfessionMicroButton, friends: false })
  cells.push(Cell.Menu { icon: "@/assets/micro-spellbookabilities.tga", frame: Game.frames.SpellbookMicroButton, friends: false })
  cells.push(Cell.Menu { icon: "@/assets/micro-spectalents.tga", frame: Game.frames.TalentMicroButton, friends: false })
  cells.push(Cell.Menu { icon: "@/assets/micro-legacy.tga", frame: Game.frames.LegacyMicroButton, friends: false })
  cells.push(Cell.Menu { icon: "@/assets/micro-questlog.tga", frame: Game.frames.QuestLogMicroButton, friends: false })
  cells.push(Cell.Menu { icon: "@/assets/micro-groupfinder.tga", frame: Game.frames.LFDMicroButton, friends: false })
  cells.push(Cell.Menu { icon: "@/assets/micro-collections.tga", frame: Game.frames.CollectionsMicroButton, friends: false })
  if (social) { pushSocial(mut cells) }
  // The game menu's button is the menu's last, whatever stands before it.
  cells.push(Cell.Menu { icon: "@/assets/micro-gamemenu.tga", frame: Game.frames.MainMenuMicroButton, friends: false })
  return cells
}

// Friends, with how many are online, and the guild.
function pushSocial(cells: mut Array<Cell>) {
  cells.push(Cell.Menu { icon: "@/assets/micro-social.tga", frame: Game.frames.QuickJoinToastButton, friends: true })
  cells.push(Cell.Menu { icon: "@/assets/micro-guildcommunities.tga", frame: Game.frames.GuildMicroButton, friends: false })
}

// The game's menu, left to right, the game menu's button last. The character's button is its first cell, with the
// player's face, unless the portrait in the screen's corner stands for it; friends and guild stand in it, before the
// game menu's button, where they sit with it.
public class MicroLine implements Component {
  derived cells: Array<Cell> = menuOf(self.faced, self.social)

  gold: Signal<Boolean>
  vertical: Signal<Boolean>
  faced: Signal<Boolean>
  social: Signal<Boolean>
  constructor(
    gold: Signal<Boolean>,
    vertical: Signal<Boolean> = false,
    faced: Signal<Boolean> = true,
    // Friends and guild are in the menu.
    social: Signal<Boolean> = false,
  ) {
    self.gold = gold
    self.vertical = vertical
    self.faced = faced
    self.social = social
  }

  public render(self): Template {
    return $ltml { <CellGroup cells={self.cells} gold={self.gold} vertical={self.vertical} /> }
  }
}

// Friends and guild on their own: the friends' cell with how many are online.
public class SocialLine implements Component {
  derived cells: Array<Cell> = socialOf()

  gold: Signal<Boolean>
  vertical: Signal<Boolean>
  constructor(gold: Signal<Boolean>, vertical: Signal<Boolean> = false) {
    self.gold = gold
    self.vertical = vertical
  }

  public render(self): Template {
    return $ltml { <CellGroup cells={self.cells} gold={self.gold} vertical={self.vertical} /> }
  }
}

function socialOf(): Array<Cell> {
  let cells: Array<Cell> = []
  pushSocial(mut cells)
  return cells
}

// The money, and the currency the player follows beside it.
public class MoneyLine implements Component {
  derived money: String = Game.money.format(Game.money.amount)
  derived tracks: Boolean = Game.money.tracked != ""
  // Down a side of the screen the two stand one under the other, in the panel's middle.
  derived columns: Array<Track> = self.vertical ? DOWN : PAIR
  derived gap: Number = self.vertical ? 4 / 1.2 : 12 / 1.2
  derived across: Align = self.vertical ? Align.Center : Align.Stretch

  outline: Signal<Integer>
  shadow: Signal<Shadow>
  vertical: Signal<Boolean>
  constructor(
    // The panel's text: the line round it and the shadow under it.
    outline: Signal<Integer>,
    shadow: Signal<Shadow>,
    vertical: Signal<Boolean> = false,
  ) {
    self.outline = outline
    self.shadow = shadow
    self.vertical = vertical
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} gap={self.gap} xAlign={self.across} yAlign={Align.Center}>
        <text value={self.money} textColor={INK} textSize={TEXT} textOutline={self.outline}
              textShadow={self.shadow} wrap={false} />
        <text $if={self.tracks} value={Game.money.tracked} textColor={INK} textSize={TEXT}
              textOutline={self.outline} textShadow={self.shadow} wrap={false} />
      </box>
    }
  }
}

// Every bag button the game has, in its order: the backpack with the free slots of every bag, the bags, the reagent
// bag, the keyring.
public class BagLine implements Component {
  derived cells: Array<Cell> = Game.bags.buttons.map(button => Cell.Bag { button: button })

  vertical: Signal<Boolean>
  constructor(vertical: Signal<Boolean> = false) {
    self.vertical = vertical
  }

  public render(self): Template {
    return $ltml { <CellGroup cells={self.cells} vertical={self.vertical} /> }
  }
}
