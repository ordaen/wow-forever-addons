// The panel's items that are rows of cells or of text: the game's menu, friends and guild, the money, the bags. Each
// is drawn in its zone of the panel, or standing free where the player put it.
import Game from "$game"
import { Align, Shadow, Track } from "$ltml"
import { Component } from "Ordaen"
import { BagCell, FaceCell, MenuCell } from "@/cells"

const INK: Color = Color.hex("#e8dcc4")
const TEXT = 12
// An item's cells: side by side along a panel that runs across the screen, one under another down a side of it.
const DOWN: Array<Track> = ["auto"]
const MICRO: Array<Track> = ["auto", "auto", "auto", "auto", "auto", "auto", "auto", "auto"]
const MICRO_FACED: Array<Track> = ["auto", "auto", "auto", "auto", "auto", "auto", "auto", "auto", "auto"]
const PAIR: Array<Track> = ["auto", "auto"]
const BAGS: Array<Track> = ["auto", "auto", "auto", "auto", "auto"]

// The game's menu, left to right, the game menu's button last. The character's button is its first cell, with the
// player's face, unless the portrait in the screen's corner stands for it.
public class MicroLine implements Component {
  derived columns: Array<Track> = self.vertical ? DOWN : (self.faced ? MICRO_FACED : MICRO)

  gold: Signal<Boolean>
  vertical: Signal<Boolean>
  faced: Signal<Boolean>
  constructor(
    gold: Signal<Boolean>,
    vertical: Signal<Boolean> = false,
    faced: Signal<Boolean> = true,
  ) {
    self.gold = gold
    self.vertical = vertical
    self.faced = faced
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns}>
        <FaceCell $if={self.faced} />
        <MenuCell icon={"@/assets/micro-professions.tga"} frame={Game.frames.ProfessionMicroButton}
                  gold={self.gold} />
        <MenuCell icon={"@/assets/micro-spellbookabilities.tga"} frame={Game.frames.SpellbookMicroButton}
                  gold={self.gold} />
        <MenuCell icon={"@/assets/micro-spectalents.tga"} frame={Game.frames.TalentMicroButton}
                  gold={self.gold} />
        <MenuCell icon={"@/assets/micro-legacy.tga"} frame={Game.frames.LegacyMicroButton}
                  gold={self.gold} />
        <MenuCell icon={"@/assets/micro-questlog.tga"} frame={Game.frames.QuestLogMicroButton}
                  gold={self.gold} />
        <MenuCell icon={"@/assets/micro-groupfinder.tga"} frame={Game.frames.LFDMicroButton}
                  gold={self.gold} />
        <MenuCell icon={"@/assets/micro-collections.tga"} frame={Game.frames.CollectionsMicroButton}
                  gold={self.gold} />
        <MenuCell icon={"@/assets/micro-gamemenu.tga"} frame={Game.frames.MainMenuMicroButton}
                  gold={self.gold} />
      </box>
    }
  }
}

// Friends and guild: the friends' cell with how many are online.
public class SocialLine implements Component {
  derived columns: Array<Track> = self.vertical ? DOWN : PAIR

  gold: Signal<Boolean>
  vertical: Signal<Boolean>
  constructor(gold: Signal<Boolean>, vertical: Signal<Boolean> = false) {
    self.gold = gold
    self.vertical = vertical
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns}>
        <MenuCell icon={"@/assets/micro-social.tga"} frame={Game.frames.QuickJoinToastButton}
                  gold={self.gold} count={Game.friends.online} />
        <MenuCell icon={"@/assets/micro-guildcommunities.tga"} frame={Game.frames.GuildMicroButton}
                  gold={self.gold} />
      </box>
    }
  }
}

// The money, and the currency the player follows beside it.
public class MoneyLine implements Component {
  derived money: String = Game.money.format(Game.money.amount)
  derived tracks: Boolean = Game.money.tracked != ""
  // Down a side of the screen the two stand one under the other, in the panel's middle.
  derived columns: Array<Track> = self.vertical ? DOWN : PAIR
  derived gap: Number = self.vertical ? 4 / 1.2 : 12 / 1.2
  derived across: Align = self.vertical ? Align.Center : Align.Stretch

  outline: Signal<Integer>
  shadow: Signal<Shadow>
  vertical: Signal<Boolean>
  constructor(
    // The panel's text: the line round it and the shadow under it.
    outline: Signal<Integer>,
    shadow: Signal<Shadow>,
    vertical: Signal<Boolean> = false,
  ) {
    self.outline = outline
    self.shadow = shadow
    self.vertical = vertical
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} gap={self.gap} xAlign={self.across} yAlign={Align.Center}>
        <text value={self.money} textColor={INK} textSize={TEXT} textOutline={self.outline}
              textShadow={self.shadow} wrap={false} />
        <text $if={self.tracks} value={Game.money.tracked} textColor={INK} textSize={TEXT}
              textOutline={self.outline} textShadow={self.shadow} wrap={false} />
      </box>
    }
  }
}

// The backpack with the free slots of every bag, then the four bags.
public class BagLine implements Component {
  derived columns: Array<Track> = self.vertical ? DOWN : BAGS

  vertical: Signal<Boolean>
  constructor(vertical: Signal<Boolean> = false) {
    self.vertical = vertical
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns}>
        <BagCell frame={Game.frames.MainMenuBarBackpackButton} free={Game.bags.free} />
        <BagCell frame={Game.frames.CharacterBag0Slot} />
        <BagCell frame={Game.frames.CharacterBag1Slot} />
        <BagCell frame={Game.frames.CharacterBag2Slot} />
        <BagCell frame={Game.frames.CharacterBag3Slot} />
      </box>
    }
  }
}
