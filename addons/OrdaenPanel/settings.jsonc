// Ordaen Panel's settings (docs/reference/settings.md). Behaviour only: its look follows the theme.
{
  "db": "OrdaenPanelDB",
  "title": "SETTINGS_TITLE",
  "sections": [
    {
      "header": "HEADER_PANEL",
      "settings": {
        "edge": {
          "type": "choice",
          "choices": [
            { "id": "bottom", "label": "EDGE_BOTTOM" },
            { "id": "top", "label": "EDGE_TOP" },
            { "id": "left", "label": "EDGE_LEFT" },
            { "id": "right", "label": "EDGE_RIGHT" }
          ],
          "default": "bottom",
          "label": "EDGE"
        },
        "fit": {
          "type": "choice",
          "choices": [
            { "id": "full", "label": "FIT_FULL" },
            { "id": "center", "label": "FIT_CENTER" }
          ],
          "default": "full",
          "label": "FIT",
          "tooltip": "FIT_TOOLTIP"
        },
        "height": {
          "type": "number", "min": 24, "max": 96, "step": 1, "format": "px", "default": 60,
          "label": "PANEL_HEIGHT", "tooltip": "PANEL_HEIGHT_TOOLTIP"
        },
        // the experience bar's fill (a look setting: it follows the theme unless the player picks one)
        "xpFill": {
          "type": "asset", "of": "xpFill", "default": { "theme": "bar.xpFill" },
          "label": "XP_TEXTURE"
        }
      }
    },
    {
      // Where each item sits: a zone of the panel, or off. In a zone, items keep this order.
      "header": "HEADER_GROUPS",
      "settings": {
        "micromenu": {
          "type": "choice",
          "choices": [
            { "id": "left", "label": "PLACE_LEFT" },
            { "id": "center", "label": "PLACE_CENTER" },
            { "id": "right", "label": "PLACE_RIGHT" },
            { "id": "off", "label": "PLACE_OFF" }
          ],
          "default": "left",
          "label": "MICROMENU",
          "tooltip": "MICROMENU_TOOLTIP"
        },
        "social": {
          "type": "choice",
          "choices": [
            { "id": "left", "label": "PLACE_LEFT" },
            { "id": "center", "label": "PLACE_CENTER" },
            { "id": "right", "label": "PLACE_RIGHT" },
            { "id": "off", "label": "PLACE_OFF" }
          ],
          "default": "left",
          "label": "SOCIAL",
          "tooltip": "SOCIAL_TOOLTIP"
        },
        "experience": {
          "type": "choice",
          "choices": [
            { "id": "left", "label": "PLACE_LEFT" },
            { "id": "center", "label": "PLACE_CENTER" },
            { "id": "right", "label": "PLACE_RIGHT" },
            { "id": "off", "label": "PLACE_OFF" }
          ],
          "default": "center",
          "label": "EXPERIENCE",
          "tooltip": "EXPERIENCE_TOOLTIP"
        },
        "zone": {
          "type": "choice",
          "choices": [
            { "id": "left", "label": "PLACE_LEFT" },
            { "id": "center", "label": "PLACE_CENTER" },
            { "id": "right", "label": "PLACE_RIGHT" },
            { "id": "off", "label": "PLACE_OFF" }
          ],
          "default": "off",
          "label": "ZONE_NAME",
          "tooltip": "ZONE_NAME_TOOLTIP"
        },
        "clock": {
          "type": "choice",
          "choices": [
            { "id": "left", "label": "PLACE_LEFT" },
            { "id": "center", "label": "PLACE_CENTER" },
            { "id": "right", "label": "PLACE_RIGHT" },
            { "id": "off", "label": "PLACE_OFF" }
          ],
          "default": "off",
          "label": "CLOCK",
          "tooltip": "CLOCK_TOOLTIP"
        },
        "currencies": {
          "type": "choice",
          "choices": [
            { "id": "left", "label": "PLACE_LEFT" },
            { "id": "center", "label": "PLACE_CENTER" },
            { "id": "right", "label": "PLACE_RIGHT" },
            { "id": "off", "label": "PLACE_OFF" }
          ],
          "default": "right",
          "label": "CURRENCIES",
          "tooltip": "CURRENCIES_TOOLTIP"
        },
        "bags": {
          "type": "choice",
          "choices": [
            { "id": "left", "label": "PLACE_LEFT" },
            { "id": "center", "label": "PLACE_CENTER" },
            { "id": "right", "label": "PLACE_RIGHT" },
            { "id": "off", "label": "PLACE_OFF" }
          ],
          "default": "right",
          "label": "BAGS",
          "tooltip": "BAGS_TOOLTIP"
        }
      }
    },
    {
      "header": "HEADER_VISIBILITY",
      "settings": {
        "visibility.show": {
          "type": "choice",
          "choices": [
            { "id": "always", "label": "SHOW_ALWAYS" },
            { "id": "mouseover", "label": "SHOW_MOUSEOVER" },
            { "id": "never", "label": "SHOW_NEVER" }
          ],
          "default": "always",
          "label": "SHOW"
        },
        "visibility.combat": {
          "type": "choice",
          "choices": [
            { "id": "any", "label": "COMBAT_ANY" },
            { "id": "hide", "label": "COMBAT_HIDE" },
            { "id": "only", "label": "COMBAT_ONLY" }
          ],
          "default": "any",
          "label": "COMBAT"
        },
        "visibility.vehicle": { "type": "boolean", "default": true, "label": "HIDE_VEHICLE" },
        "visibility.petBattle": { "type": "boolean", "default": true, "label": "HIDE_PET_BATTLE" },
        "visibility.resting": { "type": "boolean", "default": false, "label": "HIDE_RESTING" },
        "visibility.fadedAlpha": {
          "type": "number", "min": 0, "max": 1, "step": 0.05, "format": "percent", "default": 0,
          "label": "FADED_ALPHA", "tooltip": "FADED_ALPHA_TOOLTIP"
        },
        "visibility.condition": {
          "type": "text", "default": "", "maxLength": 200,
          "label": "CONDITION", "tooltip": "CONDITION_TOOLTIP"
        }
      }
    },
    {
      "settings": {
        "hiddenMicro": { "type": "map", "of": "boolean", "default": {}, "page": false }
      }
    }
  ]
}
