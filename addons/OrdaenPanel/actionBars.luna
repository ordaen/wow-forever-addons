// The panel's action bars: the game's eight, the pet's and the stances', each a free bar the player places, drawn in
// place of the game's own, with the game's keys.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import root Ordaen from "Ordaen"
import { Component, OwnerKeys } from "Ordaen"
import { BETWEEN, Bar, buttonName, heightOf, shortKey } from "@/bar"
import { BarChoice, BarKind, BarSpec, BarsChoices, SPECS, defaultChoice } from "@/barChoices"
import Locale from "@/locales"
import { promote } from "@/ranks"

// The game's pages Панель 1 shows: the one the player turned to (Shift and the wheel, or the page arrows), then a
// form's (a bonus bar's: 7 to 10), else the first.
const TURNED = "[actionbar:2] 2; [actionbar:3] 3; [actionbar:4] 4; [actionbar:5] 5; [actionbar:6] 6; "

// A frame never shown: what is put in it draws nothing, whatever shows it.
function hiddenFrame(): any Client::Frame {
  const made = Client::CreateFrame("Frame", nil, Client::UIParent, nil)
  made.Hide()
  return made
}

// Bartender4 is loaded: both would fight over the slots, the keys and the game's bars, so the panel's bars stay off.
public function bartenderLoaded(): boolean {
  let (loaded, _) = Client::C_AddOns::IsAddOnLoaded("Bartender4")
  return loaded
}

// Each bar's settings before the player changes them: on as the character's own Blizzard settings have it (the pet's
// bar on, the stances' on for a class with forms).
public function barDefaults(): map<string, BarChoice> {
  let (bottomLeft, bottomRight, right, left, six, seven, eight) = Client::GetActionBarToggles()
  const on = [true, bottomLeft, bottomRight, right, left, six, seven, eight, true, Client::GetNumShapeshiftForms() > 0]
  const defaults: map<string, BarChoice> = {}
  for (index, spec of SPECS) { defaults[spec.id] = defaultChoice(spec, on[index] == true) }
  return defaults
}

// A bar drawn: its spec, and how high the bars under it in the default stack stand, with the room above each.
public struct Shown {
  spec: BarSpec
  below: number<Length>
}

public class ActionBars implements Component, OwnerKeys {
  // The choices that apply: the settings', taken out of a fight alone (the bars' buttons are protected).
  state applied: BarsChoices
  // The player's forms: the stances' bar shows a button for each.
  state forms: integer = 0
  // The bars are made once the player is out of a fight: the panel turned on in one waits for its end.
  public state ready = false

  // The bars drawn, the action bars in Blizzard's order from the bottom, then the pet's and the stances'.
  public derived bars: array<Shown> = self.barsOf()
  derived paging: string = self.pagingOf()
  // The game's bars drawn in their place, kept unseen while the bars run: their slots stay as they are.
  derived hidden: array<any Client::Frame> = self.hiddenBars()
  // Where the game's bars are kept while the bars run: a frame never shown. A bar hidden by itself doesn't stay so:
  // the client shows it again (entering the world, its toggles, a vehicle), so it is put in this one instead, and
  // whatever shows it, it draws nothing.
  const hider: any Client::Frame = hiddenFrame()
  // Each bar put in the hider, by the parent the game gave it: given back as the bars end.
  parents: mut map<any Client::Frame, any Client::Frame> = {}
  // Each binding's key as its button shows it, by the binding's name: read again when the player binds a key.
  state bound: map<string, string> = {}
  // The same keys by the name of the button they click: what its tooltip says it is pressed by.
  state named: map<string, string> = {}
  // The keys of the game's bindings, bound to our buttons over the game's own: the frame that owns those overrides.
  const owner: any Client::Frame = Client::CreateFrame("Frame", nil, Client::UIParent, nil)

  values: Signal<BarsChoices>
  defaults: Signal<map<string, BarChoice>>
  constructor(
    // The bars' settings, as saved.
    values: Signal<BarsChoices>,
    // Each bar's settings before the player changed them, by its id.
    defaults: Signal<map<string, BarChoice>>
  ) {
    self.values = values
    self.defaults = defaults
    self.applied = (peek values).clone()
    Ordaen.afterCombat(() => self.start())
    Ordaen.hotkeys.add(self)
  }

  // Out of a fight: the bars are made, the game's put away, the keys bound; from then on each change waits for a
  // fight's end.
  mut start() {
    self.forms = Client::GetNumShapeshiftForms()
    self.applied = (peek self.values).clone()
    self.ready = true
    self.bind()
    Events::UPDATE_BINDINGS.listen(self.rebind)
    Events::UPDATE_SHAPESHIFT_FORMS.listen(self.reform)
    Events::LEARNED_SPELL_IN_SKILL_LINE.listen(self.learned)
    watch (values of self.values) { Ordaen.afterCombat(() => self.apply(values)) }
    watch (games of self.hidden) { Ordaen.afterCombat(() => self.putAway(games)) }
  }

  // A button's tooltip: the key that presses it, as the button shows it («1: use»).
  public keys(owner: string): array<string> {
    const key = self.named[owner]
    return key == nil ? [] : [Locale::KEY_USE.format(key)]
  }

  destructor() {
    const owner = self.owner
    const parents = self.parents
    Ordaen.afterCombat(() => ActionBars::giveBack(owner, parents))
  }

  // A copy: the settings' values change in place, and in a fight the bars keep what applied before it.
  mut apply(values: BarsChoices) {
    self.applied = values.clone()
    self.bind()
  }

  mut rebind() { Ordaen.afterCombat(() => self.bind()) }

  mut reform() { Ordaen.afterCombat(() => self.countForms()) }

  mut countForms() { self.forms = Client::GetNumShapeshiftForms() }

  // A spell learned: a new rank takes its previous rank's slots.
  learned(spell: number, _line: integer, _perk: boolean) { promote(spell.floor()) }

  // Each of the game's bars goes into the hider, its own parent kept to give back.
  mut putAway(games: array<any Client::Frame>) {
    for (frame of games) {
      if (self.parents[frame] == nil) {
        const parent = frame.GetParent()
        if (parent != nil) { self.parents[frame] = parent }
        frame.SetParent(self.hider)
      }
    }
  }

  // A bar's settings that apply.
  choiceOf(spec: BarSpec): BarChoice {
    return self.applied.bars[spec.id] ?? self.defaults[spec.id] ?? defaultChoice(spec, false)
  }

  // How many buttons a bar shows: as many as chosen, and for the stances' bar no more than the player's forms.
  countOf(spec: BarSpec, choice: BarChoice): integer {
    return spec.kind == BarKind::Stance ? choice.buttons.min(self.forms) : choice.buttons
  }

  // The bars on, each standing over those under it by their rows' height: none overlaps another.
  barsOf(): array<Shown> {
    const bars: array<Shown> = []
    if (!self.ready) { return bars }
    let below: number<Length> = 0ui
    for (spec of SPECS) {
      const choice = self.choiceOf(spec)
      if (choice.on) {
        bars.push({ spec: spec, below: below })
        const tall = heightOf(self.countOf(spec, choice), choice.perRow, choice.size, choice.spacing)
        if (tall > 0ui) { below = below + tall + BETWEEN }
      }
    }
    return bars
  }

  // Панель 1's paging: the page turned to, then each form's whose page the player keeps.
  pagingOf(): string {
    let options = TURNED
    for (bonusbar of 1..4) {
      if (self.applied.unpaged[string::of(bonusbar)] != true) { options = `${options}[bonusbar:${bonusbar}] ${bonusbar + 6}; ` }
    }
    return `${options}1`
  }

  // Each key of the game's bindings of the bars drawn clicks our button in its place, and its text is kept. Out of a
  // fight alone: the client takes no binding in one.
  mut bind() {
    Client::ClearOverrideBindings(self.owner)
    const keys: map<string, string> = {}
    const named: map<string, string> = {}
    for (bar of peek self.bars) {
      for (index of 1..self.choiceOf(bar.spec).buttons) {
        const command = `${bar.spec.command}${index}`
        const name = buttonName(bar.spec.id, index)
        let (first, second) = Client::GetBindingKey(command)
        if (first != nil) {
          keys[command] = shortKey(first)
          named[name] = keys[command]
          Client::SetOverrideBindingClick(self.owner, false, first, name, "LeftButton")
        }
        if (second != nil) { Client::SetOverrideBindingClick(self.owner, false, second, name, "LeftButton") }
      }
    }
    self.bound = keys
    self.named = named
  }

  hiddenBars(): array<any Client::Frame> {
    const parts: array<any Client::Frame> = []
    for (bar of self.bars) {
      const frame = ActionBars::gameBar(bar.spec)
      if (frame != nil) { parts.push(frame) }
    }
    return parts
  }

  public render(): Template {
    return $ltml {
      <Bar $for={bar of self.bars} $key={bar.spec.id} spec={(peek bar).spec} below={bar.below}
           choices={self.applied.bars} defaults={self.defaults}
           keys={self.bound} paging={self.paging} forms={self.forms} />
    }
  }
} static {
  // The game's keys and bars go back as they were.
  giveBack(owner: any Client::Frame, parents: map<any Client::Frame, any Client::Frame>) {
    Client::ClearOverrideBindings(owner)
    for (frame, parent of parents) { frame.SetParent(parent) }
  }

  // The game's own bar in a bar's place.
  gameBar(spec: BarSpec): any Client::Frame | nil {
    return match (spec.kind) {
      BarKind::Pet => Game::frames.PetActionBar
      BarKind::Stance => Game::frames.StanceBar
      BarKind::Action => ActionBars::actionBar(spec.number)
    }
  }

  actionBar(number: integer): any Client::Frame | nil {
    return match (number) {
      1 => Game::frames.MainActionBar
      2 => Game::frames.MultiBarBottomLeft
      3 => Game::frames.MultiBarBottomRight
      4 => Game::frames.MultiBarRight
      5 => Game::frames.MultiBarLeft
      6 => Game::frames.MultiBar5
      7 => Game::frames.MultiBar6
      else => Game::frames.MultiBar7
    }
  }
}
