  Game::player.xpMax = 10000
  Game::player.xp = 6000
  Game::reputation.name = "Stormwind"
  Game::reputation.standing = "Honored"
  Game::reputation.min = 9000
  Game::reputation.max = 21000
  Game::reputation.value = 13800
  alone()
  Test::mount(new Bars(), PAGE)
  Test::expect(Test::page().texts().join(" | ") == shown("6~000 / 10~000 | (60%) | Honored 4~800 / 12~000"))
}

test "over the faction's tube a tooltip says where the reputation is and what is left to the next standing" {
  Game::player.xpMax = 10000
  Game::reputation.name = "Stormwind"
  Game::reputation.standing = "Honored"
  Game::reputation.next = "Revered"
  Game::reputation.min = 9000
  Game::reputation.max = 21000
  Game::reputation.value = 13800
  alone()
  Test::mount(new Bars(), PAGE)
  Test::page().text(shown("Honored 4~800 / 12~000")).hover()
  Test::expect(tip("Stormwind") == shown("Stormwind | Current | 4~800 (40%) / 12~000 | To | Revered | 7~200 (60%)"))
}

test "the next standing is named in its own colour" {
  Game::player.xpMax = 10000
  Game::reputation.name = "Stormwind"
  Game::reputation.standing = "Honored"
  Game::reputation.next = "Revered"
  Game::reputation.nextColor = #00991a
  Game::reputation.min = 9000
  Game::reputation.max = 21000
  Game::reputation.value = 13800
  alone()
  Test::mount(new Bars(), PAGE)
  Test::page().text(shown("Honored 4~800 / 12~000")).hover()
  Test::expect(Test::page().window("Stormwind").text("Revered").textColor().equal(#00991a))
}

test "the faction's fill takes its standing's colour" {
  Game::player.xpMax = 10000
  Game::reputation.name = "Stormwind"
  Game::reputation.standing = "Hostile"
  Game::reputation.color = #cc4d38
  Game::reputation.min = 0
  Game::reputation.max = 3000
  Game::reputation.value = 1500
  alone()
  Test::mount(new Bars(), PAGE)
  Test::expect(Test::page().box(Ordaen.art.panel.xpSteel).paintedWith(#cc4d38))
  Game::reputation.color = #00991a
  Test::expect(Test::page().box(Ordaen.art.panel.xpSteel).paintedWith(#00991a))
}

test "the experience and the faction stand side by side, half the bars each, and one alone takes them whole" {
  Game::player.xpMax = 10000
  Game::player.xp = 6000
  Game::reputation.name = "Stormwind"
  Game::reputation.standing = "Honored"
  Game::reputation.min = 9000
  Game::reputation.max = 21000
  Game::reputation.value = 13800
  alone()
  Test::mount(new Bars(), PAGE)
  const brushed = xpFillArt(XpFill::Brushed)
  const xp = Test::page().box(brushed).rect()
  const faction = Test::page().box(Ordaen.art.panel.xpSteel).rect()
  // On one line, as wide as each other: each fill is its share of its tube (60% and 40%).
  const xpTube = (xp.right - xp.left) / 0.6
  const factionTube = (faction.right - faction.left) / 0.4
  Test::expect((xp.top - faction.top).abs() < 0.5 && xp.right < faction.left)
  Test::expect((xpTube - factionTube).abs() < 2)
  // The faction gone: the experience takes the whole width.
  Game::reputation.name = ""
  const whole = Test::page().box(brushed).rect()
  Test::expect((whole.right - whole.left) / 0.6 > xpTube * 1.8)
}

test "at the level's cap the watched faction's tube is alone" {
  Game::reputation.name = "Stormwind"
  Game::reputation.standing = "Exalted"
  Game::reputation.min = 42000
  Game::reputation.max = 42999
  Game::reputation.value = 42500
  alone()
  Test::mount(new Bars(), PAGE)
  Test::expect(Test::page().texts().join(" | ") == "Exalted 500 / 999")
}

test "exalted, the faction's tooltip says where the reputation is, and no standing after it" {
  Game::reputation.name = "Stormwind"
  Game::reputation.standing = "Exalted"
  Game::reputation.min = 42000
  Game::reputation.max = 42999
  Game::reputation.value = 42500
  alone()
  Test::mount(new Bars(), PAGE)
  Test::page().text("Exalted 500 / 999").hover()
  Test::expect(tip("Stormwind") == "Stormwind | Current | 500 (50%) / 999")
}

test "at the cap with no faction watched the bars show nothing" {
  alone()
  Test::mount(new Bars(), PAGE)
  Test::expect(Test::page().texts().length == 0 && !Test::page().box(Ordaen.art.panel.xpTrough).shown())
}

test "a tube's label stands over it, and the tube is 20 high, its ring 3 wide" {
  Game::player.xpMax = 10000
  Game::player.xp = 6000
  Game::reputation.name = ""
  alone()
  Test::mount(new Bars(), PAGE)
  const tube = Test::page().box(Ordaen.art.panel.xpTrough).rect()
  const label = Test::page().text(shown("6~000 / 10~000")).rect()
  Test::expect(label.bottom <= tube.top + 0.5)
  Test::expect((tube.bottom - tube.top - 20).abs() < 0.5)
}
