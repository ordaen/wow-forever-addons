// The status bars: glass tubes with margins on the wood, back to front the trough, the fill, engraved marks every
// tenth, the glass shine, the bronze ring, and the values in the middle. Experience: the rested part in pale blue past
// the player's fill; reputation: the watched faction in steel. Both tracked, the faction's tube stands under the
// experience's where the room holds two; else experience alone, and at the level's cap the faction alone (nothing when
// none is watched). Each tube explains itself in our Tip while the cursor is on it, the rested part on its own: where
// the value is, what is left to the next level or standing, and the rested bonus, each with its part of the level's
// (or the standing's) whole.
import Game from "$game"
import { Align, Art, Bounds, Edges, Event, Line, Position, Shadow, Side, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, Tip, TipRow, XpFill, number, xpFillArt } from "Ordaen"
import { XpView } from "@/choices"
import { XpLook, XpPart } from "@/extend"
import Locale from "@/locales"

// The experience's fill as it starts.
const BRUSHED: Art = xpFillArt(XpFill::Brushed)

// A tube's height and its label's size: both tubes stand side by side, each half the bars' width, each label over its
// tube. The tube's ring is 10 of its art's 64 high, so at 20 the ring is 3 wide.
const TUBE_HEIGHT: number<Length> = 20ui
const LABEL_TEXT = 1.1rem
// The label over the tube, and the room between them.
const LABELLED: array<Track> = ["max-content", { fr: 1 }]
const LABEL_ROOM = 1sp
const GAP = 3sp
// Room enough for anything: a bar standing by itself.
const UNBOUNDED = 1000ui
// The shortest the bars are, with their margins: on a panel as long as its items, and the least the panel's middle gives
// way to on a short screen; two side by side take more.
const LEAST: Bounds = { min: 240ui, max: nil }
const LEAST_PAIR: Bounds = { min: 420ui, max: nil }
const ONE: array<Track> = [{ fr: 1 }]
// Half each, whatever their words: a track takes no more for its longer label.
const TWO: array<Track> = [{ fr: 1, min: 0ui }, { fr: 1, min: 0ui }]
const MARGINS: Edges = { right: 11.5sp, left: 11.5sp }
const RESTED: Color = Color::hex("#6e96d129")
const LABEL: Color = Color::hex("#f3e7cc")
const LABEL_SHADOW: Shadow = { color: Color::hex("#000000"), x: 1ui, y: -1ui }
const LABEL_PARTS: array<Track> = ["max-content", "max-content"]
const LABEL_GAP = 1.5sp
// The bars' carved edge: a dark line round the tube, where the bezel's ring would stand.
const GROOVE: Line = { width: 2ui, color: Color::hex("#0a0603d9"), sides: [Side::Top, Side::Right, Side::Bottom, Side::Left] }
const FILL: array<Track> = [{ fr: 1 }]
// Ten equal cells over the inside, each but the last with a 1 px dark right edge.
const CELLS: array<integer> = [1, 2, 3, 4, 5, 6, 7, 8, 9]
const MARK: Line = { width: 1ui, color: Color::hex("#00000080"), sides: [Side::Right] }
// Rested experience grows to a level and a half at most (the client's rule).
const RESTED_MOST = 1.5
// Under this many percent a part keeps a decimal, so a small one still reads: 264 of 29 000 is 0.9%, not 0%.
const FINE_PERCENT = 10

// Where the cursor is on a tube: off it, on it, or on a part past its fill.
enum Over { Off = "off", Bar = "bar", Part = "part" }

// The tube's tracks, in hundredths of it: the fill, each part past it in turn (none past the tube's end), the rest.
function tracksOf(value: integer, least: integer, most: integer, parts: array<XpPart>): array<Track> {
  const tracks: array<Track> = []
  let reached = share(value, least, most)
  let past = value
  tracks.push({ fr: reached })
  for (part of parts) {
    past = past + part.amount
    const next = share(past, least, most).max(reached)
    tracks.push({ fr: next - reached })
    reached = next
  }
  tracks.push({ fr: 100 - reached })
  return tracks
}

// One part past a tube's fill as its look says: the tube's fill art made grey and tinted the part's colour, or the
// colour alone.
class PartFill implements Component {
  derived filled: boolean = self.part.look == XpLook::Fill

  part: Signal<XpPart>
  fill: Signal<Art>
  constructor(part: Signal<XpPart>, fill: Signal<Art>) {
    self.part = part
    self.fill = fill
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.filled} background={self.fill} tint={self.part.color} desaturate={true} />
      <box $else background={self.part.color} />
    }
  }
}

// The cursor's place on one part past a tube's fill: its tooltip while the cursor is on it, and the tube told, so the
// tube's own stays shut meanwhile.
class PartSpot implements Component {
  public entered: Event<nil> = new Event()
  public left: Event<nil> = new Event()

  state hovered = false

  part: Signal<XpPart>
  constructor(part: Signal<XpPart>) {
    self.part = part
  }

  onEnter(mut self) {
    self.hovered = true
    self.entered.emit()
  }

  onLeave(mut self) {
    self.hovered = false
    self.left.emit()
  }

  public render(self): Template {
    return $ltml {
      // Inside the tube: the cursor that leaves it is on the tube still, which hears no new enter.
      <box @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <Tip $if={self.hovered} title={self.part.title} text={self.part.text} rows={self.part.rows} />
      </box>
    }
  }
}

// A value between its least and its most, as the start and the end of the bar.
function share(value: integer, least: integer, most: integer): number {
  let span = most - least
  if (span <= 0) { return 100 }
  return 100 * (0).max((value - least).min(span)) / span
}

// A percentage as it is shown: whole from FINE_PERCENT up, with one decimal under it, cut, never rounded up.
function shownPercent(percent: number): number {
  return percent >= FINE_PERCENT ? percent.floor() : (percent * 10).floor() / 10
}

// A part of the whole in percent of the whole, as it is shown: never of what is left of it.
function shownShare(part: integer, whole: integer): number {
  return shownPercent(whole > 0 ? 100 * (0).max(part) / whole : 0)
}

function percentText(percent: number): string {
  return number(shownPercent(percent)) + "%"
}

public function partOf(part: integer, whole: integer): string {
  return number(shownShare(part, whole)) + "%"
}

// What is left of the whole, in percent: the whole less the part done as it is shown, so the two read 100% together.
public function leftOf(left: integer, whole: integer): string {
  return number(100 - shownShare(whole - left, whole)) + "%"
}

// The values of a tube as its view says them: what it says first, and what it says after, dimmed in brackets ("" for
// none). With words before them (the standing), the words take the dimmed part's room, so the longest standing's name
// with its values still fits a tube at its least (the rest stays in the tooltip).
function valuesOf(view: XpView, value: integer, least: integer, most: integer, words: string): (string, string) {
  const numbers = "%s / %s".format(number(value - least), number(most - least))
  const percent = percentText(share(value, least, most))
  let first = ""
  let after = ""
  match (view) {
    XpView::Numbers => {
      first = numbers
      after = "(" + percent + ")"
    }
    XpView::Percent => {
      first = percent
      after = "(" + numbers + ")"
    }
    XpView::NumbersOnly => { first = numbers }
    XpView::PercentOnly => { first = percent + " / 100%" }
  }
  if (words != "") { return words + " " + first, "" }
  return first, after
}

// A count and its part of the whole: «900 (90%)».
function countOf(part: integer, whole: integer): string {
  return "%s (%s)".format(number(part), partOf(part, whole))
}

// What is left to the whole and its part: «900 (90%)», with the part done reading 100% together.
function leftCount(left: integer, whole: integer): string {
  return "%s (%s)".format(number(left), leftOf(left, whole))
}

// Where a value is in its whole: «100 (10%) / 1 000».
function currentOf(part: integer, whole: integer): string {
  return "%s / %s".format(countOf(part, whole), number(whole))
}

// One tube: a value between its least and its most, required as a count's bounds are, so every bar says its values
// the same way; the parts past the value (quests done, the rested bonus), each its colour and its tooltip; a tooltip
// over the bar.
public class Tube implements Component {
  state over: Over = Over::Off
  derived inset: number<Length> = self.height * 10 / 64
  // How far the value has got, in hundredths of the tube; the tube in columns that share it: the fill, each part, the
  // rest (the fill's alone in the fill's layer).
  derived filled: number = share(self.value, self.least, self.most)
  derived fillParts: array<Track> = [{ fr: self.filled }, { fr: 100 - self.filled }]
  derived tracks: array<Track> = tracksOf(self.value, self.least, self.most, self.parts)
  derived label: string = self.labelOf(1)
  derived dimmed: string = self.labelOf(2)
  derived hasDimmed: boolean = self.dimmed != ""
  derived overBar: boolean = self.over == Over::Bar
  derived tinted: boolean = self.tint != nil

  // Ordaen's art: its root is there before this module loads.
  fill: Signal<Art>
  bezel: Signal<boolean>
  view: Signal<XpView>
  value: Signal<integer>
  least: Signal<integer>
  most: Signal<integer>
  words: Signal<string>
  parts: Signal<array<XpPart>>
  height: Signal<number<Length>>
  tint: Signal<Color | nil>
  title: Signal<string>
  rows: Signal<array<TipRow>>
  constructor(
    fill: Signal<Art>,
    // The bronze ring round the tube; else a groove carved round it.
    bezel: Signal<boolean>,
    view: Signal<XpView>,
    value: Signal<integer>,
    least: Signal<integer>,
    most: Signal<integer>,
    // The tooltip over the bar.
    title: Signal<string>,
    rows: Signal<array<TipRow>>,
    // What the bar says before its values: the standing.
    words: Signal<string> = "",
    // The parts past the fill, in turn: quests done, the rested bonus.
    parts: Signal<array<XpPart>> = [],
    height: Signal<number<Length>> = TUBE_HEIGHT,
    // A colour the fill takes, its art made grey under it: the standing's.
    tint: Signal<Color | nil> = nil
  ) {
    self.tint = tint
    self.fill = fill
    self.bezel = bezel
    self.view = view
    self.value = value
    self.least = least
    self.most = most
    self.title = title
    self.rows = rows
    self.words = words
    self.parts = parts
    self.height = height
  }

  // The label's first part, or its dimmed one.
  labelOf(self, part: integer): string {
    const first, after = valuesOf(self.view, self.value, self.least, self.most, self.words)
    return part == 1 ? first : after
  }

  onBar(mut self) { self.over = Over::Bar }
  onPart(mut self) { self.over = Over::Part }
  onOff(mut self) { self.over = Over::Off }

  public render(self): Template {
    return $ltml {
      <box rows={LABELLED} gap={LABEL_ROOM} xAlign={Align::Stretch} @pointerEnter={self.onBar} @pointerLeave={self.onOff}>
        <box columns={LABEL_PARTS} gap={LABEL_GAP} xAlign={Align::Center} yAlign={Align::Center}>
          <text value={self.label} textSize={LABEL_TEXT} textColor={LABEL} textOutline={1}
                textShadow={LABEL_SHADOW} wrap={.None} textFont={.Numbers} textWeight={.Bold} />
          <text $if={self.hasDimmed} value={self.dimmed} textSize={LABEL_TEXT} textColor={LABEL}
                textOutline={1} textShadow={LABEL_SHADOW} wrap={.None} textFont={.Numbers} />
        </box>
        <box height={self.height}>
          <box position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               background={Ordaen.art.panel.xpTrough} />
          // Over one another by their levels, each over all that is in the one under it: the trough, the fills (the
          // parts past the experience, the experience, the marks), the shine, the glass, the label. At one level the
          // client draws either on top.
          <box position={Position::Absolute} left={self.inset} top={self.inset} right={self.inset} bottom={self.inset}
               zLevel={1}>
            <box position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} columns={self.tracks}
                 rows={FILL}>
              <box />
              <PartFill $for={part of self.parts} part={part} fill={self.fill} />
              <box />
            </box>
            <box position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} columns={self.fillParts}
                 rows={FILL} zLevel={1}>
              <box background={self.fill} tint={self.tint} desaturate={self.tinted} />
              <box />
            </box>
            <box position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} columns={10} rows={FILL}
                 zLevel={2}>
              <box $for={cell of CELLS} border={MARK} />
              <box />
            </box>
          </box>
          <box position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               background={Ordaen.art.panel.xpShine} zLevel={5} />
          <box $if={self.bezel} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               background={Ordaen.art.panel.xpTube} zLevel={6} />
          <box $else position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} border={GROOVE} zLevel={6} />
          <box position={Position::Absolute} left={self.inset} top={self.inset} right={self.inset} bottom={self.inset}
               columns={self.tracks} rows={FILL}>
            <box />
            <PartSpot $for={part of self.parts} part={part} @entered={self.onPart} @left={self.onBar} />
            <box />
          </box>
        </box>
        <Tip $if={self.overBar} title={self.title} text={""} rows={self.rows} />
      </box>
    }
  }
}

public class XpBar implements Component {
  // Ordaen's art and the look's fonts: its root is there before this module loads.
  // Below the level's cap there is experience to gain.
  derived leveling: boolean = Game::player.xpMax > 0
  derived watched: boolean = Game::reputation.name != ""
  // Both shown, they share the line, half each; one alone takes it whole.
  derived paired: boolean = self.leveling && self.watched
  derived columns: array<Track> = self.paired ? TWO : ONE
  derived width: Bounds = self.paired ? LEAST_PAIR : LEAST
  derived tubeHeight: number<Length> = TUBE_HEIGHT.min(self.room)
  derived toLevel: integer = Game::player.xpMax - Game::player.xp
  derived toNext: integer = Game::reputation.max - Game::reputation.value
  derived restedMost: integer = (Game::player.xpMax * RESTED_MOST).floor()
  derived xpTitle: string = Locale::XP_TIP_TITLE.format(Game::player.level)
  derived xpRows: array<TipRow> = self.experienceRows()
  derived restedRows: array<TipRow> = self.restRows()
  // Past the fill: what other modules know the player will get (quests done), then the rested bonus.
  derived xpParts: array<XpPart> = self.partsOf()
  derived reputationRows: array<TipRow> = self.standingRows()
  // The faction's fill takes its standing's colour, as the client's reputation bar does.
  derived standingTint: Color | nil = Game::reputation.color

  // The faction's fill, its standing's colour over it.
  const steel: Art = Ordaen.art.panel.xpSteel

  // How high the bar may be: the panel's inside.
  room: Signal<number<Length>>
  fill: Signal<Art>
  bezel: Signal<boolean>
  view: Signal<XpView>
  sources: Signal<array<XpPart>>
  constructor(
    room: Signal<number<Length>> = UNBOUNDED,
    // What fills the experience's tube.
    fill: Signal<Art> = BRUSHED,
    // The bronze ring round each tube; else a carved groove.
    bezel: Signal<boolean> = true,
    view: Signal<XpView> = XpView::Numbers,
    // The parts other modules give (`Panel.xpSources`).
    sources: Signal<array<XpPart>> = []
  ) {
    self.room = room
    self.fill = fill
    self.bezel = bezel
    self.view = view
    self.sources = sources
  }

  partsOf(self): array<XpPart> {
    const parts = self.sources.map(part => part)
    if (Game::player.rested > 0) {
      parts.push({
        amount: Game::player.rested, color: RESTED, title: Locale::RESTED_TIP_TITLE, text: Locale::RESTED_TIP,
        rows: self.restedRows, look: XpLook::Wash
      })
    }
    return parts
  }

  // The rested bonus and its part of the level's whole.
  restedRow(self): TipRow {
    return { label: Locale::XP_TIP_RESTED, value: countOf(Game::player.rested, Game::player.xpMax) }
  }

  // Where the experience is, what is left to the next level, each other module's part (quests done), and the rested
  // bonus where there is one: each with its part of the level's whole.
  experienceRows(self): array<TipRow> {
    let whole = Game::player.xpMax
    let rows: array<TipRow> = [
      { label: Locale::TIP_CURRENT, value: currentOf(Game::player.xp, whole) },
      { label: Locale::XP_TIP_TO_LEVEL.format(Game::player.level + 1), value: leftCount(self.toLevel, whole) }
    ]
    for (part of self.sources) { rows.push({ label: part.title, value: countOf(part.amount, whole) }) }
    if (Game::player.rested > 0) {
      rows.push(self.restedRow())
    }
    return rows
  }

  restRows(self): array<TipRow> {
    return [
      self.restedRow(),
      { label: Locale::RESTED_TIP_RESTING, value: Game::situation.resting ? Locale::YES : Locale::NO },
      { label: Locale::RESTED_TIP_ROOM, value: number((0).max(self.restedMost - Game::player.rested)) }
    ]
  }

  // Where the reputation is in its standing and what is left to the next, named in its colour as the bar is drawn:
  // each with its part of the standing's whole.
  standingRows(self): array<TipRow> {
    let whole = Game::reputation.max - Game::reputation.min
    let rows: array<TipRow> = [
      { label: Locale::TIP_CURRENT, value: currentOf(Game::reputation.value - Game::reputation.min, whole) }
    ]
    if (Game::reputation.next != "") {
      rows.push({
        label: Locale::REPUTATION_TIP_TO,
        mark: { text: Game::reputation.next, color: Game::reputation.nextColor },
        value: leftCount(self.toNext, whole)
      })
    }
    return rows
  }

  public render(self): Template {
    return $ltml {
      <box width={self.width} padding={MARGINS} columns={self.columns} yAlign={Align::Center} gap={GAP}>
        <Tube $if={self.leveling} fill={self.fill} bezel={self.bezel} view={self.view} value={Game::player.xp} least={0}
              most={Game::player.xpMax} parts={self.xpParts} height={self.tubeHeight} title={self.xpTitle}
              rows={self.xpRows} />
        <Tube $if={self.watched} fill={self.steel} bezel={self.bezel} view={self.view}
              value={Game::reputation.value}
              least={Game::reputation.min} most={Game::reputation.max} words={Game::reputation.standing}
              height={self.tubeHeight} title={Game::reputation.name} rows={self.reputationRows}
              tint={self.standingTint} />
      </box>
    }
  }
}
