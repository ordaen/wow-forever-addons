// What the player chooses on the panel's «Action bars» page: each bar's own settings, and which forms page Панель 1.
import { ALWAYS, Visibility } from "Ordaen"

// The kinds of bars: an action bar of the game's (Панель 1 to 8), the pet's and the stances'.
public enum BarKind implements Plain { Action = "action", Pet = "pet", Stance = "stance" }

// One bar as the panel draws it: what tells it from the others (`"1"` to `"8"`, `"pet"`, `"stance"`), its kind, its
// number among the action bars (0 for the others), its first slot (an action bar's page of the game's; the pet's
// and stances' buttons are told by their place), how many buttons it can have, the game's name of its buttons'
// bindings (`ACTIONBUTTON` and a button's number) and the client's template of its buttons.
public struct BarSpec {
  public mut id: string
  public mut kind: BarKind
  public mut number: integer
  public mut first: integer
  public mut most: integer
  public mut command: string
  public mut template: string
}

// The game's eight bars in Blizzard's own slots and bindings (without the panel, the game's bars show the same
// actions in the same places, and the game's Key Bindings window names their keys), then the pet's and the
// stances'.
public const SPECS: array<BarSpec> = [
  { id: "1", kind: BarKind::Action, number: 1, first: 1, most: 12, command: "ACTIONBUTTON", template: ACTION },
  { id: "2", kind: BarKind::Action, number: 2, first: 61, most: 12, command: "MULTIACTIONBAR1BUTTON", template: ACTION },
  { id: "3", kind: BarKind::Action, number: 3, first: 49, most: 12, command: "MULTIACTIONBAR2BUTTON", template: ACTION },
  { id: "4", kind: BarKind::Action, number: 4, first: 25, most: 12, command: "MULTIACTIONBAR3BUTTON", template: ACTION },
  { id: "5", kind: BarKind::Action, number: 5, first: 37, most: 12, command: "MULTIACTIONBAR4BUTTON", template: ACTION },
  { id: "6", kind: BarKind::Action, number: 6, first: 145, most: 12, command: "MULTIACTIONBAR5BUTTON", template: ACTION },
  { id: "7", kind: BarKind::Action, number: 7, first: 157, most: 12, command: "MULTIACTIONBAR6BUTTON", template: ACTION },
  { id: "8", kind: BarKind::Action, number: 8, first: 169, most: 12, command: "MULTIACTIONBAR7BUTTON", template: ACTION },
  { id: "pet", kind: BarKind::Pet, number: 0, first: 0, most: 10, command: "BONUSACTIONBUTTON", template: PET },
  { id: "stance", kind: BarKind::Stance, number: 0, first: 0, most: 10, command: "SHAPESHIFTBUTTON", template: STANCE }
]

const ACTION = "ActionBarButtonTemplate"
const PET = "PetActionButtonTemplate"
// A stance's button does its form's spell by its attributes: the client's stance template does the game's stance
// bar's work on a click (`StanceBar:Select`), so the secure action button's is named after it, and its click is the
// one the button does.
const STANCE = "StanceButtonTemplate, SecureActionButtonTemplate"

// One bar's settings. Its size is the buttons' side in UI units (the client's own is 45), its spacing the room
// between them.
public struct BarChoice implements Plain {
  public mut on: boolean
  public mut buttons: integer
  public mut perRow: integer
  public mut size: number
  public mut spacing: number
  public mut keys: boolean
  public mut visibility: Visibility
  // Its empty buttons unseen, but while something is dragged that could go on one.
  public mut hideEmpty: boolean = true
}

public struct BarsChoices implements Plain {
  // Each bar's settings the player changed, by its id; a bar not here has its defaults (`defaultChoice`).
  public mut bars: mut map<string, BarChoice>
  // The forms that don't page Панель 1, by their bonus bar (`"1"` to `"4"`): in them it stays as it is.
  public mut unpaged: mut map<string, boolean>
}

public const BARS_DEFAULTS: BarsChoices = { bars: {}, unpaged: {} }

// A bar's settings before the player changes them: on as the character's Blizzard settings have it.
public function defaultChoice(spec: BarSpec, on: boolean): BarChoice {
  return { on: on, buttons: spec.most, perRow: spec.most, size: 45, spacing: 4, keys: true, visibility: ALWAYS, hideEmpty: true }
}

// Another bar's settings copied into a bar: every one but its switch, which is the bar's own, held to what the bar
// can take (its buttons to its most, per row to its buttons). Its place isn't a setting, nor are Панель 1's forms.
public function copied(from: BarChoice, into: BarChoice, spec: BarSpec): BarChoice {
  const choice = from.clone()
  choice.on = into.on
  choice.buttons = from.buttons.min(spec.most)
  choice.perRow = from.perRow.min(choice.buttons)
  return choice
}

// A bar's settings back to its defaults, its switch kept.
public function reset(choice: BarChoice, defaults: BarChoice): BarChoice {
  const back = defaults.clone()
  back.on = choice.on
  return back
}
