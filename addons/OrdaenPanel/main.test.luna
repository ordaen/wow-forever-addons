test "the panel turned off in the game's list of addons leaves the game's menu and bags to the game" {
  const menu = frame("MicroMenuContainer")
  Game::frames.MicroMenuContainer = menu
  const bags = frame("BagsBar")
  Game::frames.BagsBar = bags
  Test::mount(nil, SCREEN)
  (Runtime::Addon::of(Panel) ?? panic("the panel is installed")).disable()
  Test::expect(Test::blank() && !Test::page().text(MONEY).shown())
  Test::expect(menu.GetAlpha() == 1 && bags.IsShown())
}

// The move mode

test "the move mode shows a panel set never to show, and hides it again as it ends" {
  Test::mount(nil, SCREEN)
  const settings = visibility()
  pick(settings, "Show", 1, "Hide")
  settings.button(SETTINGS).click()
  Test::expect(panel().text(MOVER).shown())
  settings.button(SETTINGS).click()
  Test::expect(!panel().shown())
}

test "the panel dragged in the move mode to the screen's left runs down it from then, kept at once" {
  Game::player.level = 42
  Game::player.xp = 2500
  Game::player.xpMax = 10000
  Test::mount(nil, SCREEN)
  const settings = visibility()
  const steps = Ordaen.keeper.steps
  settings.button(SETTINGS).click()
  // Carried over the portrait's badge, then let go over the portrait, in the screen's lower left corner: the left side
  // is nearest.
  const portrait = Test::page().window("42")
  drag(panel().text(MOVER), [portrait.text("42"), portrait.text(MOVER)])
  settings.button(SETTINGS).click()
  // Down the side, with no experience bar: the drag is one step of the settings' history.
  Test::expect(panel().shown() && !Test::page().text(XP).shown() && Ordaen.keeper.steps == steps + 1)
  Test::expect(settings.button("Left").shown())
}

test "the panel right-clicked in the move mode goes back to the bottom" {
  Game::player.level = 42
  Test::mount(nil, SCREEN)
  const settings = tab("Bottom panel")
  choose(settings, "Bottom", "Top", "Top")
  settings.button(SETTINGS).click()
  panel().text(MOVER).rightClick()
  settings.button(SETTINGS).click()
  Test::expect(Test::page().text("42").shown() && settings.button("Bottom").shown())
}

test "the panel dragged to a side and then right-clicked goes back to the bottom" {
  Game::player.level = 42
  Test::mount(nil, SCREEN)
  const settings = tab("Bottom panel")
  settings.button(SETTINGS).click()
  const portrait = Test::page().window("42")
  drag(panel().text(MOVER), [portrait.text("42"), portrait.text(MOVER)])
  Test::expect(!Test::page().text("42").shown())
  panel().text(MOVER).rightClick()
  Test::expect(Test::page().text("42").shown())
}

test "the action bars' tab fits the settings window at its size: the list, the picked bar and its rows" {
  Test::mount(nil, SCREEN)
  const settings = tab("Action bars")
  Test::flush()
  Test::expect(settings.button("Pet Bar").shown())
  Test::expect(settings.text("Buttons per row").shown())
}

test "a cell's slot is square, from the panel's metal down, the cut after it its own" {
  Game::bags.buttons = bagButtons(frame)
  Test::mount(nil, SCREEN)
  const ground = panel().box(CELL).nth(2).rect()
  const cut = firstCut()
  Test::expect((ground.right - ground.left - (ground.bottom - ground.top)).abs() < 0.5)
  Test::expect((ground.top - cut.top).abs() < 0.5 && (ground.bottom - cut.bottom).abs() < 0.5)
  // Panel 2's second cell: after the first cut, and over the second, which its light and its clicks take.
  const next = panel().box(CUT_LIP).nth(2).rect()
  Test::expect((ground.left - cut.right).abs() < 0.5 && (ground.right - next.right).abs() < 0.5)
}

test "the menu's first cell starts where the portrait ends, no gap between them" {
  Game::player.level = 42
  Game::bags.buttons = bagButtons(frame)
  Test::mount(nil, SCREEN)
  const portrait = Test::page().window("42").rect()
  const cell = panel().box(CELL).nth(1).rect()
  Test::expect((cell.left - portrait.right).abs() < 0.5)
}

test "the level's badge stands over the frame's top right corner, centred where its lines meet the face" {
  Game::player.level = 42
  Test::mount(nil, SCREEN)
  const portrait = Test::page().window("42").rect()
  const badge = Test::page().window("42").box(Ordaen.art.panel.badge).nth(1).rect()
  // The frame's room on the portrait's top and right: the windows' metal, a third heavier.
  const metal = Ordaen.art.frame.window
  const weight = 6 / 4.5
  const right = metal.reach.right * metal.scale * weight
  const top = metal.reach.top * metal.scale * weight
  Test::expect(((badge.left + badge.right) / 2 - (portrait.right - right)).abs() < 0.5)
  Test::expect(((badge.top + badge.bottom) / 2 - (portrait.top + top)).abs() < 0.5)
}
