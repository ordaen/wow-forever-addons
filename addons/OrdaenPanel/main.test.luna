}

test "the menu's icons chosen in gold are gold off the panel too" {
  Test::mount(nil, SCREEN)
  const settings = tab("Micro menu")
  choose(settings, "Normal", "Gold", "Gold")
  settings.button("General").nth(2).click()
  settings.button(Ordaen.art.ctl.switchOn).nth(4).click()
