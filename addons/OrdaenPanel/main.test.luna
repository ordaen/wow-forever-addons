// The panel with a stand-in game: its zones and what sits in them, the game's own buttons in its cells, and when it
// shows.
import Client from "$client"
import Game from "$game"
import { MouseButton } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { Preset, preset } from "Ordaen"
import { CharButton, Combat, Edge, Fit, Item, MicroIcons, Outline, Show, Zone } from "@/choices"
import Runtime from "$runtime"
import root Panel from "OrdaenPanel"

// The screen Ordaen draws its modules on: the panel's root, made as its addon loaded.
const PAGE: Test.Page = { left: 20, top: 20, width: 200, height: 100, screen: true }

// One of the game's own frames the panel stands its cells round, hides, or leaves unseen: the `nth` of them.
function blizzard(name: String, nth: Integer): any Client.Frame {
  let ui = Client.C_UI.GetUIParent()
  let frame = Client.CreateFrame("Button", name, ui, nil)
  frame.SetSize(32, 40)
  frame.SetPoint("TOPLEFT", ui, "TOPLEFT", 1000 + nth * 4, -300)
  return frame
}

function show(title: String, menu: any Client.Frame, button: any Client.Frame, bags: any Client.Frame) {
  Test.shot(title)
  let home = button.GetParent() == Client.C_UI.GetUIParent() ? "the game's" : "ours"
  Test.note(`the game's menu: opacity ${menu.GetAlpha()}, its bag bar shown: ${bags.IsShown()}, a menu button's parent: ${home}`)
  Test.note("")
}

// Where an item sits: the settings keep every item's place in one map.
function placed(now: Map<Item, Zone>, item: Item, zone: Zone): Map<Item, Zone> {
  let places: Map<Item, Zone> = {}
  for (key, value of now) { places[key] = value }
  places[item] = zone
  return places
}

// Along the panel: across the screen at its bottom or top, down it at a side.
function along(frame: any Client.Frame, vertical: Boolean): Number {
  let at = Test.centre(frame)
  return vertical ? at.y : at.x
}

// The panel on a screen of this size, drawn: `Test.shot` holds everything drawn, the panel too, to the screen. How
// long its start, its middle and its end are, from the middle of the first cell to the middle of the menu's last (the
// guild's), to the backpack's, to the last bag's.
function measured(
  cells: Array<any Client.Frame>,
  named: String,
  vertical: Boolean,
  width: Number,
  height: Number,
): Array<Number> {
  Test.screen(width, height)
  Test.shot(`${named}, the screen ${width}x${height}`)
  let at: Array<Number> = []
  for (cell of cells) { at.push(along(cell, vertical)) }
  let first = at[1] ?? 0
  let guild = at[2] ?? 0
  let backpack = at[3] ?? 0
  let last = at[4] ?? 0
  Test.note(`from the first cell to the guild's ${guild - first}, from there to the backpack ${backpack - guild}, from there to the last bag ${last - backpack}`)
  Test.note("")
  return [guild - first, backpack - guild, last - backpack]
}

test "the panel fits the screen on each side: its middle gives way, its ends keep their length" {
  Game.frames.MicroMenuContainer = blizzard("MicroMenuContainer", 1)
  Game.frames.CharacterMicroButton = blizzard("CharacterMicroButton", 2)
  let first = blizzard("ProfessionMicroButton", 3)
  Game.frames.ProfessionMicroButton = first
  Game.frames.SpellbookMicroButton = blizzard("SpellbookMicroButton", 4)
  Game.frames.TalentMicroButton = blizzard("TalentMicroButton", 5)
  Game.frames.LegacyMicroButton = blizzard("LegacyMicroButton", 6)
  Game.frames.QuestLogMicroButton = blizzard("QuestLogMicroButton", 7)
  Game.frames.LFDMicroButton = blizzard("LFDMicroButton", 8)
  Game.frames.CollectionsMicroButton = blizzard("CollectionsMicroButton", 9)
  Game.frames.MainMenuMicroButton = blizzard("MainMenuMicroButton", 10)
  let guild = blizzard("GuildMicroButton", 11)
  Game.frames.GuildMicroButton = guild
  Game.frames.StoreMicroButton = blizzard("StoreMicroButton", 12)
  Game.frames.HelpMicroButton = blizzard("HelpMicroButton", 13)
  Game.frames.QuickJoinToastButton = blizzard("QuickJoinToastButton", 14)
  Game.frames.BagsBar = blizzard("BagsBar", 15)
  let backpack = blizzard("MainMenuBarBackpackButton", 16)
  Game.frames.MainMenuBarBackpackButton = backpack
  Game.frames.BackpackFreeSlots = blizzard("BackpackFreeSlots", 17)
  Game.frames.CharacterBag0Slot = blizzard("CharacterBag0Slot", 18)
  Game.frames.CharacterBag1Slot = blizzard("CharacterBag1Slot", 19)
  Game.frames.CharacterBag2Slot = blizzard("CharacterBag2Slot", 20)
  let lastBag = blizzard("CharacterBag3Slot", 21)
  Game.frames.CharacterBag3Slot = lastBag
  Game.money.amount = 1234567
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  let cells = [first, guild, backpack, lastBag]
  Test.mount(nil, PAGE)
  // As wide as the money's text down a side.
  Panel.settings.draft.height = 72
  Ordaen.keeper.saveAll()
  for (fit of [Fit.Full, Fit.Center]) {
    Panel.settings.draft.fit = fit
    Ordaen.keeper.saveAll()
    for (edge of [Edge.Bottom, Edge.Top, Edge.Left, Edge.Right]) {
      Panel.settings.draft.edge = edge
      Ordaen.keeper.saveAll()
      let vertical = edge == Edge.Left || edge == Edge.Right
      let named = `docked ${String.of(edge)}, ${String.of(fit)}`
      // A screen at a UI scale of 1 is 768 high; a large one, 1200.
      let large = measured(cells, named, vertical, 1920, 1200)
      let small = measured(cells, named, vertical, 1366, 768)
      Test.expect(((large[1] ?? 0) - (small[1] ?? 1)).abs() < 0.01 && ((large[3] ?? 0) - (small[3] ?? 1)).abs() < 0.01)
      // Across the whole edge the middle is what gives way.
      Test.expect(fit == Fit.Center || (small[2] ?? 0) < (large[2] ?? 0))
    }
  }
}

test "the panel: its zones and items, the game's buttons in its cells, when it shows, its parts placed" {
  let menu = blizzard("MicroMenuContainer", 1)
  Game.frames.MicroMenuContainer = menu
  Game.frames.CharacterMicroButton = blizzard("CharacterMicroButton", 2)
  let button = blizzard("ProfessionMicroButton", 3)
  Game.frames.ProfessionMicroButton = button
  Game.frames.SpellbookMicroButton = blizzard("SpellbookMicroButton", 4)
  Game.frames.TalentMicroButton = blizzard("TalentMicroButton", 5)
  Game.frames.LegacyMicroButton = blizzard("LegacyMicroButton", 6)
  Game.frames.QuestLogMicroButton = blizzard("QuestLogMicroButton", 7)
  Game.frames.LFDMicroButton = blizzard("LFDMicroButton", 8)
  Game.frames.CollectionsMicroButton = blizzard("CollectionsMicroButton", 9)
  Game.frames.MainMenuMicroButton = blizzard("MainMenuMicroButton", 10)
  Game.frames.GuildMicroButton = blizzard("GuildMicroButton", 11)
  Game.frames.StoreMicroButton = blizzard("StoreMicroButton", 12)
  Game.frames.HelpMicroButton = blizzard("HelpMicroButton", 13)
  Game.frames.QuickJoinToastButton = blizzard("QuickJoinToastButton", 14)
  let bags = blizzard("BagsBar", 15)
  Game.frames.BagsBar = bags
  Game.frames.MainMenuBarBackpackButton = blizzard("MainMenuBarBackpackButton", 16)
  Game.frames.BackpackFreeSlots = blizzard("BackpackFreeSlots", 17)
  Game.frames.CharacterBag0Slot = blizzard("CharacterBag0Slot", 18)
  Game.frames.CharacterBag1Slot = blizzard("CharacterBag1Slot", 19)
  Game.frames.CharacterBag2Slot = blizzard("CharacterBag2Slot", 20)
  Game.frames.CharacterBag3Slot = blizzard("CharacterBag3Slot", 21)
  Game.money.amount = 1234567
  Game.bags.free = 23
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Game.player.rested = 1500
  let shown = (title: String) => show(title, menu, button, bags)

  Test.mount(nil, PAGE)
  shown("drawn along the bottom: the menu with friends and guild at its start, the money and the bags at its end")
  // The mouse over the panel: each cell's own, the game's button in it never at one level with ours.
  let mouse = Test.mouse()
  let contested = mouse.contestedFirst
  let covered = mouse.coveredFirst
  Test.note(`points where two frames would both take the mouse: ${mouse.contested}${contested != nil ? ` (${contested})` : ""}`)
  Test.note(`boxes that take the mouse: ${mouse.boxes > 0 ? "some" : "none"}; with part of their face under another frame: ${mouse.covered}${covered != nil ? ` (${covered})` : ""}`)
  Test.note("")

  // The look chosen: the level on the badge is its accent, Blizzard's gold here; rolled back, Ordaen's bronze.
  const ordaen = Ordaen
  ordaen.look.choose(preset(Preset.Blizzard))
  Ordaen.keeper.saveAll()
  shown("Blizzard's look saved: the level in its accent")
  Ordaen.keeper.rollbackAll()

  Game.friends.online = 3
  Game.money.tracked = "12 Marks"
  shown("three friends online and a currency followed: the count on the friends' cell, the currency by the money")

  Game.friends.online = 12
  Panel.settings.draft.charButton = CharButton.Button
  Ordaen.keeper.saveAll()
  shown("the character's button as a cell: the face, round, first in the menu; no portrait in the corner")

  Test.face("player", "player in a helm")
  Panel.settings.draft.charButton = CharButton.Portrait
  Ordaen.keeper.saveAll()
  shown("the portrait again, the player's look another")

  Panel.settings.draft.microIcons = MicroIcons.Gold
  Ordaen.keeper.saveAll()
  Panel.settings.draft.outline = Outline.Thick
  Ordaen.keeper.saveAll()
  shown("twelve friends: the pill grows; the icons in one gold; the text outlined thick")

  Game.player.xp = 9400
  Game.reputation.name = "Stormwind"
  Game.reputation.standing = "Honored"
  Game.reputation.min = 9000
  Game.reputation.max = 21000
  Game.reputation.value = 13800
  shown("more experience, a faction watched: the fill grows, the rested part stops at the level's end; one tube in the panel")

  Game.player.xpMax = 0
  shown("at the level's cap: the watched faction's tube in its place")

  Game.reputation.name = ""
  shown("no faction watched at the cap: no tube")

  Game.player.xpMax = 10000
  Panel.settings.draft.places = placed(Panel.settings.draft.places, Item.Zone, Zone.Center)
  Ordaen.keeper.saveAll()
  Panel.settings.draft.places = placed(Panel.settings.draft.places, Item.Clock, Zone.Center)
  Ordaen.keeper.saveAll()
  Panel.settings.draft.places = placed(Panel.settings.draft.places, Item.Social, Zone.Right)
  Ordaen.keeper.saveAll()
  Game.clock.invites = 1
  shown("the zone's name and the time in the middle, the time orange with an invite waiting; friends and guild at the end")

  Panel.settings.draft.fit = Fit.Center
  Ordaen.keeper.saveAll()
  shown("as long as its items, in the edge's middle")

  Panel.settings.draft.edge = Edge.Top
  Ordaen.keeper.saveAll()
  Panel.settings.draft.fit = Fit.Full
  Ordaen.keeper.saveAll()
  Panel.settings.draft.height = 72
  Ordaen.keeper.saveAll()
  shown("along the top, 72 high")

  // Down a side the zone's name is wider than the panel, and the menu longer than a third of this screen: the
  // panel is as long as its items there.
  Panel.settings.draft.places = placed(Panel.settings.draft.places, Item.Zone, Zone.Off)
  Ordaen.keeper.saveAll()
  Panel.settings.draft.fit = Fit.Center
  Ordaen.keeper.saveAll()
  Panel.settings.draft.edge = Edge.Left
  Ordaen.keeper.saveAll()
  shown("down the left side, as long as its items: the zones one under another, each item's cells too, no experience bar")

  Panel.settings.draft.edge = Edge.Right
  Ordaen.keeper.saveAll()
  shown("down the right side")

  Panel.settings.draft.edge = Edge.Top
  Ordaen.keeper.saveAll()
  Panel.settings.draft.fit = Fit.Full
  Ordaen.keeper.saveAll()
  Panel.settings.draft.places = placed(Panel.settings.draft.places, Item.Zone, Zone.Center)
  Ordaen.keeper.saveAll()
  Panel.settings.draft.show = Show.Mouseover
  Ordaen.keeper.saveAll()
  shown("shown on mouseover, the cursor away: all but unseen, and still there for the cursor")

  Test.moveTo({ x: 800, y: 10 })
  shown("the cursor on it: shown")

  Test.moveTo({ x: 800, y: 400 })
  Panel.settings.draft.show = Show.Always
  Ordaen.keeper.saveAll()
  Panel.settings.draft.combat = Combat.Hide
  Ordaen.keeper.saveAll()
  Game.situation.combat = true
  shown("hidden in combat with nothing left to see: not drawn, the game's buttons back where the game keeps them")

  Panel.settings.draft.fadedAlpha = 0.3
  Ordaen.keeper.saveAll()
  shown("hidden in combat at 30%: drawn faint")

  Game.situation.combat = false
  Panel.settings.draft.edge = Edge.Bottom
  Ordaen.keeper.saveAll()
  Panel.settings.draft.height = 60
  Ordaen.keeper.saveAll()
  Panel.settings.draft.places = placed(Panel.settings.draft.places, Item.Bags, Zone.Off)
  Ordaen.keeper.saveAll()
  Panel.settings.draft.places = placed(Panel.settings.draft.places, Item.Experience, Zone.Off)
  Ordaen.keeper.saveAll()
  shown("the bags and the experience bar off the panel: each a part of its own above the screen's bottom, where its module says")

  Ordaen.togglePlacing()
  shown("the placing mode: each part outlined with its name over it")

  // The bags' part: taken by its middle and let go 200 to the left and 100 up.
  let at = Test.surfaceHolding("Bags")
  Test.moveTo(at)
  Test.press(nil)
  Test.moveTo({ x: at.x - 1, y: at.y })
  Test.pass(0.05)
  Test.moveTo({ x: at.x - 201, y: at.y - 100 })
  Test.pass(0.05)
  shown("the bags' part dragged: it follows the cursor")
  Test.release(nil)
  shown("let go: it stays where it was put")

  Ordaen.togglePlacing()
  shown("the placing mode off: no outlines, the part where the player put it")

  Ordaen.togglePlacing()
  Test.moveTo(Test.surfaceHolding("Bags"))
  Test.press(MouseButton.Right)
  Test.release(MouseButton.Right)
  Ordaen.togglePlacing()
  shown("right-clicked in the placing mode: back where its module says")

  Panel.settings.draft.bottomOn = false
  Ordaen.keeper.saveAll()
  shown("the panel off: every item of it a part of its own")

  Panel.settings.draft.bottomOn = true
  Ordaen.keeper.saveAll()
  Panel.settings.draft.places = placed(Panel.settings.draft.places, Item.Bags, Zone.Right)
  Ordaen.keeper.saveAll()
  Panel.settings.draft.places = placed(Panel.settings.draft.places, Item.Experience, Zone.Center)
  Ordaen.keeper.saveAll()
  Panel.settings.draft.microOn = false
  Ordaen.keeper.saveAll()
  shown("the menu off: its cells gone, the game's own menu seen again")

  (Runtime.Addon.of(Panel) ?? panic("the panel is installed")).disable()
  Test.expect(Test.blank())
  Test.note("-- turned off: its root ended, what it drew gone")
  Test.note(`the game's menu: opacity ${menu.GetAlpha()}, its bag bar shown: ${bags.IsShown()}`)
}
