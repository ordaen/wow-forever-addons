// The panel as the player meets it: along the bottom of the screen at first, the game's menu and friends and guild at
// its start, the experience bar in its middle, the money and the bags at its end, the portrait in the corner. What it
// holds and when it shows are chosen on its page of Ordaen's settings (`/ordaen`, «Panel»), each control used as the
// player uses it; the game's own menu, bags and status bars are frames the test gives the fake game.
import Client from "$client"
import Game from "$game"
import { Art } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Panel from "OrdaenPanel"
import { CharButton, Choices, Combat, DEFAULTS, Edge, Fit, MicroIcons, Outline, Show } from "@/choices"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
// What the panel always shows: the player's money, none at first.
const MONEY = "0g 0s 0c"
// The experience bar's values, of 2 500 of 10 000, its thousands parted by a space that never breaks.
const XP = "2 500 / 10 000 (25%)"
// A text the settings window always shows.
const SETTINGS = "Move mode"
// Where an item is let go to stand «Not on the panel»: an item that is there at first (the pool's name stands outside
// it).
const POOL = "Time"
// The panel's name over it in the move mode.
const MOVER = "Bottom panel"
// The menu's icons, in its order.
const PROFESSIONS: Asset = "@/assets/micro-professions.tga"
const SPELLBOOK: Asset = "@/assets/micro-spellbookabilities.tga"
const TALENTS: Asset = "@/assets/micro-spectalents.tga"
const LEGACY: Asset = "@/assets/micro-legacy.tga"
const QUESTS: Asset = "@/assets/micro-questlog.tga"
const GROUPS: Asset = "@/assets/micro-groupfinder.tga"
const COLLECTIONS: Asset = "@/assets/micro-collections.tga"
const FRIENDS: Asset = "@/assets/micro-social.tga"
const GUILD: Asset = "@/assets/micro-guildcommunities.tga"
const GAME_MENU: Asset = "@/assets/micro-gamemenu.tga"
// The icons the game shows on its bag buttons.
const BACKPACK: FileId = 130716
const BAG: FileId = 133633
const REAGENT: FileId = 136511
const KEYRING: FileId = 130980
// Every cell's ground while the cursor is away: what counts the cells in the order drawn.
const CELL: Color = Color.hex("#00000000")
// The groove between two cells.
const DIVIDER: Color = Color.hex("#0a0603d9")
// The menu's icons as they are, and in one gold.
const WHITE: Color = Color.hex("#ffffff")
const GOLD: Color = Color.hex("#ffb847")
// The panel's text, and the time while invites wait.
const INK: Color = Color.hex("#e8dcc4")
const PENDING: Color = Color.hex("#ff9933")
// The reputation's tube of a faction watched, honored.
const HONORED = "Honored 4 800 / 12 000"

// One of the game's own frames the panel stands in for, hides or leaves unseen.
function frame(name: String): any Client.Frame {
  const made = Client.CreateFrame("Button", name, Client.C_UI.GetUIParent(), nil)
  made.SetSize(32, 40)
  return made
}

// One of the client's own frames, by its name.
function client(name: String): any Client.Frame {
  const found = Runtime.frame(name) ?? panic("the client has the frame")
  const held: any Client.Frame = found
  return held
}

// The game's bag buttons, every one its constants say it has (the stand-in's are Forever's): the backpack, a slot for
// each bag, one for each reagent bag, the keyring's; each of `make`'s frame of that name.
function bagButtons(make: (name: String) => any Client.Frame): Array<Game.BagButton> {
  let bags: Array<Game.BagButton> = [{ kind: .Backpack, frame: make("MainMenuBarBackpackButton"), icon: BACKPACK }]
  for (slot of 0..=Client.NUM_BAG_SLOTS - 1) {
    bags.push({ kind: .Bag, frame: make(`CharacterBag${slot}Slot`), icon: BAG })
  }
  for (slot of 0..=Client.NUM_REAGENTBAG_SLOTS - 1) {
    bags.push({ kind: .Reagent, frame: make(`CharacterReagentBag${slot}Slot`), icon: REAGENT })
  }
  bags.push({ kind: .Keyring, frame: make("KeyRingButton"), icon: KEYRING })
  return bags
}

// The panel: the surface that shows the money.
function panel(): Test.Part {
  return Test.page().window(MONEY)
}

// The panel's page of the settings, at one of its tabs: `/ordaen`, «Panel» in the list of modules, the tab.
function tab(title: String): Test.Part {
  Test.open("/ordaen")
  const settings = Test.page().window(SETTINGS)
  settings.button("Panel").click()
  // «General» is Ordaen's own page too: the panel's tab is the second.
  const tabs = settings.button(title)
  if (tabs.count() > 1) {
    tabs.nth(2).click()
  } else {
    tabs.click()
  }
  return settings
}

// «Bottom panel»'s tab, scrolled down to its «Visibility»: what shows the panel when.
function visibility(): Test.Part {
  const settings = tab("Bottom panel")
  settings.text("Screen edge").wheel(-10)
  return settings
}

// One of «Visibility»'s dropdowns' choices, saved.
function hide(face: String, among: String, choice: String) {
  const settings = visibility()
  choose(settings, face, among, choice)
  settings.button("Save").click()
}

// One of «Visibility»'s checkboxes, the `nth`, clicked and saved.
function tick(nth: Integer) {
  const settings = visibility()
  settings.button(Ordaen.art.ctl.check).nth(nth).click()
  settings.button("Save").click()
}

// A dropdown's choice: its face, which shows the choice made, clicked, then the choice in its list (a popup that holds
// `among`, a choice no other surface shows).
function choose(settings: Test.Part, face: String, among: String, choice: String) {
  settings.button(face).click()
  Test.page().window(among).button(choice).click()
}

// A part taken with the left button, carried over each part of `path` in turn (a frame each) and let go over the last.
function drag(from: Test.Part, path: Array<Test.Part>) {
  from.hover()
  Test.press(nil)
  for (over of path) {
    over.hover()
    Test.pass(0.05)
  }
  Test.release(nil)
  Test.pass(0.05)
}

// An item of the panel dragged on «Bottom panel»'s tab into a zone, let go over the zone's name, and saved.
function place(item: String, zone: String) {
  const settings = tab("Bottom panel")
  drag(settings.text(item), [settings.text(zone)])
  settings.button("Save").click()
}

// One of «Bottom panel»'s dropdowns' choices, saved.
function bottom(face: String, among: String, choice: String) {
  const settings = tab("Bottom panel")
  choose(settings, face, among, choice)
  settings.button("Save").click()
}

// One of the tab's switches, the `nth` (on «General»: the panel's own, then the menu's, the bars', the panel's),
// clicked and saved.
function flip(title: String, art: Art, nth: Integer) {
  const settings = tab(title)
  settings.button(art).nth(nth).click()
  settings.button("Save").click()
}

// What the panel holds

test "the panel shows the player's money, in ink" {
  Game.money.amount = 1234567
  Test.mount(nil, SCREEN)
  Test.expect(Test.page().window("123g 45s 67c").text("123g 45s 67c").textColor().equal(INK))
}

test "the money follows what the player has" {
  Test.mount(nil, SCREEN)
  Test.expect(panel().shown())
  Game.money.amount = 5
  Test.expect(Test.page().window("0g 0s 5c").shown() && !panel().shown())
}

test "a currency the player follows stands beside the money" {
  Test.mount(nil, SCREEN)
  Game.money.tracked = "12 Marks"
  Test.expect(panel().texts().join(" | ") == "0g 0s 0c | 12 Marks")
}

test "the experience bar on the panel says the player's experience" {
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Test.mount(nil, SCREEN)
  Test.expect(panel().text(XP).shown())
}

test "every button of the game's menu has its cell on the panel, with its icon, friends and guild before the game menu's" {
  Test.mount(nil, SCREEN)
  const window = panel()
  const icons = [PROFESSIONS, SPELLBOOK, TALENTS, LEGACY, QUESTS, GROUPS, COLLECTIONS, FRIENDS, GUILD, GAME_MENU]
  Test.expect(window.box(CELL).count() == icons.length)
  for (at, icon of icons) { Test.expect(window.box(CELL).nth(at).paintedWith(icon)) }
  // Each once: none stands free of the panel as well.
  Test.expect(Test.page().box(FRIENDS).count() == 1 && Test.page().box(PROFESSIONS).count() == 1)
}

test "every bag button the game has stands in a cell after the menu, in its order, with its icon" {
  Game.bags.buttons = bagButtons(frame)
  Test.mount(nil, SCREEN)
  const window = panel()
  let icons: Array<FileId> = [BACKPACK]
  for (slot of 1..=Client.NUM_BAG_SLOTS) { icons.push(BAG) }
  for (slot of 1..=Client.NUM_REAGENTBAG_SLOTS) { icons.push(REAGENT) }
  icons.push(KEYRING)
  Test.expect(window.box(CELL).count() == 10 + icons.length)
  for (at, icon of icons) { Test.expect(window.box(CELL).nth(10 + at).paintedWith(icon)) }
}

test "one groove parts each two cells of a group, none before its first" {
  Game.bags.buttons = bagButtons(frame)
  Test.mount(nil, SCREEN)
  const window = panel()
  Test.expect(!window.box(PROFESSIONS).item().paintedWith(DIVIDER))
  Test.expect(window.box(SPELLBOOK).item().paintedWith(DIVIDER) && window.box(GAME_MENU).item().paintedWith(DIVIDER))
  Test.expect(!window.box(BACKPACK).item().paintedWith(DIVIDER) && window.box(KEYRING).item().paintedWith(DIVIDER))
}

test "a click on a cell of the menu or of the bags is the game's own button's in it" {
  let clicked: Array<String> = []
  const professions = frame("ProfessionMicroButton")
  professions.SetScript("OnClick", () => { clicked.push("professions") })
  Game.frames.ProfessionMicroButton = professions
  const bags = bagButtons(frame)
  Game.bags.buttons = bags
  const backpack = client("MainMenuBarBackpackButton")
  backpack.SetScript("OnClick", () => { clicked.push("backpack") })
  Test.mount(nil, SCREEN)
  panel().box(PROFESSIONS).click()
  panel().box(BACKPACK).click()
  Test.expect(clicked.join(", ") == "professions, backpack")
}

test "the bag buttons and the menu's buttons of the game's are the panel's while it shows them" {
  const professions = frame("ProfessionMicroButton")
  Game.frames.ProfessionMicroButton = professions
  const bags = bagButtons(frame)
  Game.bags.buttons = bags
  Test.mount(nil, SCREEN)
  Test.expect(panel().shown())
  const ui = Client.C_UI.GetUIParent()
  Test.expect(professions.GetParent() != ui && client("MainMenuBarBackpackButton").GetParent() != ui)
}

test "the game's own menu is unseen and its bag bar and status bars hidden while the panel stands in for them" {
  const menu = frame("MicroMenuContainer")
  Game.frames.MicroMenuContainer = menu
  const store = frame("StoreMicroButton")
  Game.frames.StoreMicroButton = store
  const help = frame("HelpMicroButton")
  Game.frames.HelpMicroButton = help
  const bags = frame("BagsBar")
  Game.frames.BagsBar = bags
  const free = frame("BackpackFreeSlots")
  Game.frames.BackpackFreeSlots = free
  const main = frame("MainStatusTrackingBarContainer")
  Game.frames.MainStatusTrackingBarContainer = main
  const secondary = frame("SecondaryStatusTrackingBarContainer")
  Game.frames.SecondaryStatusTrackingBarContainer = secondary
  Test.mount(nil, SCREEN)
  Test.expect(panel().shown())
  Test.expect(menu.GetAlpha() == 0 && store.GetAlpha() == 0 && help.GetAlpha() == 0)
  Test.expect(!bags.IsShown() && !free.IsShown() && !main.IsShown() && !secondary.IsShown())
}

test "the game's menu, bag bar and status bars made anew while the panel shows are kept out of sight too" {
  Test.mount(nil, SCREEN)
  Test.expect(panel().shown())
  const menu = frame("MicroMenuContainer")
  Game.frames.MicroMenuContainer = menu
  const bags = frame("BagsBar")
  Game.frames.BagsBar = bags
  const free = frame("BackpackFreeSlots")
  Game.frames.BackpackFreeSlots = free
  const main = frame("MainStatusTrackingBarContainer")
  Game.frames.MainStatusTrackingBarContainer = main
  const secondary = frame("SecondaryStatusTrackingBarContainer")
  Game.frames.SecondaryStatusTrackingBarContainer = secondary
  Test.expect(panel().shown() && menu.GetAlpha() == 0)
  Test.expect(!bags.IsShown() && !free.IsShown() && !main.IsShown() && !secondary.IsShown())
}

test "the panel's length is chosen on its tab: the whole edge, or as long as its items" {
  Test.mount(nil, SCREEN)
  const settings = tab("Bottom panel")
  choose(settings, "Whole edge", "Fit the buttons", "Fit the buttons")
  settings.button("Save").click()
  Test.expect(panel().shown() && settings.button("Fit the buttons").shown())
}

test "the friends online are counted on the friends' cell" {
  Test.mount(nil, SCREEN)
  Game.friends.online = 3
  Test.expect(panel().box(FRIENDS).item().texts().join(" | ") == "3")
  Game.friends.online = 12
  Test.expect(panel().box(FRIENDS).item().texts().join(" | ") == "12")
  // No other cell counts them.
  for (icon of [PROFESSIONS, SPELLBOOK, TALENTS, LEGACY, QUESTS, GROUPS, COLLECTIONS, GUILD, GAME_MENU]) {
    Test.expect(panel().box(icon).item().texts().length == 0)
  }
}

test "the cell under the cursor is lit, and shaded while it is pressed" {
  Test.mount(nil, SCREEN)
  Test.expect(!panel().box(PROFESSIONS).item().paintedWith(Color.hex("#ffd9a01f")))
  panel().box(PROFESSIONS).hover()
  Test.expect(panel().box(PROFESSIONS).item().paintedWith(Color.hex("#ffd9a01f")))
  Test.press(nil)
  Test.expect(panel().box(PROFESSIONS).item().paintedWith(Color.hex("#00000040")))
  Test.release(nil)
}

test "with no friend online the friends' cell counts none" {
  Test.mount(nil, SCREEN)
  Test.expect(panel().box(FRIENDS).item().texts().length == 0)
}

test "the backpack's cell counts the free slots of every bag, and no other cell does" {
  Game.bags.buttons = bagButtons(frame)
  Test.mount(nil, SCREEN)
  Game.bags.free = 23
  Test.expect(panel().box(BACKPACK).item().texts().join(" | ") == "23")
  Test.expect(panel().box(KEYRING).item().texts().length == 0)
  Game.bags.free = 0
  Test.expect(panel().box(BACKPACK).item().texts().length == 0)
}

test "the bags opened, each bag button of the game's stays unseen in its cell" {
  Test.clientFrames()
  const bags = bagButtons(client)
  Game.bags.buttons = bags
  Test.mount(nil, SCREEN)
  // The client's item buttons fade their icon alone through their own `SetAlpha`: the button itself, the slot's
  // frame, the light the open lights on it and the backpack's free slots are the frame's to hide.
  Client.ToggleAllBags()
  Test.expect(panel().box(KEYRING).shown())
  for (bag of bags) {
    const held: any Client.Frame = bag.frame
    Test.expect(held.GetParent() != Client.C_UI.GetUIParent() && held.GetAlpha() == 0)
  }
}

// The portrait

test "the portrait in the corner shows the player's level on its badge" {
  Game.player.level = 42
  Test.mount(nil, SCREEN)
  Test.expect(Test.page().window("42").shown())
  Game.player.level = 43
  Test.expect(Test.page().window("43").shown() && !Test.page().text("42").shown())
}

test "the level on the portrait's badge is in the look's accent" {
  Game.player.level = 42
  Test.mount(nil, SCREEN)
  Test.expect(Test.page().text("42").textColor().equal(Ordaen.look.values.accent))
}

test "the character's button chosen as a cell: the menu's first cell, and no portrait" {
  Game.player.level = 42
  Test.mount(nil, SCREEN)
  const settings = tab("Micro menu")
  choose(settings, "Portrait", "Button", "Button")
  settings.button("Save").click()
  Test.expect(!Test.page().text("42").shown())
  Test.expect(panel().box(CELL).count() == 11 && panel().box(CELL).nth(2).paintedWith(PROFESSIONS))
}

test "the portrait goes with the panel to another edge" {
  Game.player.level = 42
  Test.mount(nil, SCREEN)
  bottom("Bottom", "Top", "Top")
  Test.expect(panel().shown() && !Test.page().text("42").shown())
}

test "the portrait goes with the menu to the panel's middle" {
  Game.player.level = 42
  Test.mount(nil, SCREEN)
  place("Game menu buttons", "Centre")
  Test.expect(panel().box(PROFESSIONS).shown() && !Test.page().text("42").shown())
}

// The menu's look and the zones

test "the menu's icons chosen in gold are painted gold" {
  Test.mount(nil, SCREEN)
  Test.expect(panel().box(PROFESSIONS).paintedWith(WHITE))
  const settings = tab("Micro menu")
  choose(settings, "Normal", "Gold", "Gold")
  settings.button("Save").click()
  Test.expect(panel().box(PROFESSIONS).paintedWith(GOLD) && panel().box(GAME_MENU).paintedWith(GOLD))
}

test "friends and guild at the panel's end stand on their own, the game menu's button still the menu's last" {
  Test.mount(nil, SCREEN)
  Test.expect(panel().box(FRIENDS).item().paintedWith(DIVIDER))
  place("Friends and guild", "Right")
  const window = panel()
  // First of their own group: no groove before the friends' cell.
  Test.expect(!window.box(FRIENDS).item().paintedWith(DIVIDER) && window.box(GUILD).item().paintedWith(DIVIDER))
  Test.expect(window.box(CELL).nth(8).paintedWith(GAME_MENU) && window.box(CELL).nth(9).paintedWith(FRIENDS))
}

test "the time placed on the panel shows the game's time, in ink" {
  Test.mount(nil, SCREEN)
  Test.expect(!Test.page().text("12:30").shown())
  place("Time", "Centre")
  Test.expect(panel().text("12:30").textColor().equal(INK))
}

test "the time turns orange while calendar invites wait" {
  Test.mount(nil, SCREEN)
  place("Time", "Centre")
  Game.clock.invites = 1
  Test.expect(panel().text("12:30").textColor().equal(PENDING))
}

test "a click on the time opens the calendar" {
  Test.mount(nil, SCREEN)
  place("Time", "Centre")
  _ = Test.requests()
  panel().text("12:30").click()
  Test.expect(Test.requests().any(r => r == "Clock.toggleCalendar"))
}

test "the zone's name placed on the panel shows the zone the player is in" {
  Test.mount(nil, SCREEN)
  Test.expect(!Test.page().text("Elwynn Forest").shown())
  place("Zone name", "Left")
  Test.expect(panel().text("Elwynn Forest").shown())
}

test "the experience bar off the panel stands on its own" {
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Test.mount(nil, SCREEN)
  place("Experience bar", POOL)
  Test.expect(!panel().text(XP).shown() && Test.page().window(XP).shown())
}

test "the bags off the panel stand on their own" {
  Game.bags.buttons = bagButtons(frame)
  Test.mount(nil, SCREEN)
  place("Bags", POOL)
  Test.expect(!panel().box(BACKPACK).shown() && Test.page().box(BACKPACK).count() == 1)
}

test "the money off the panel stands on its own" {
  Test.mount(nil, SCREEN)
  place("Gold and currencies", POOL)
  Test.expect(panel().texts().join(" | ") == MONEY && !panel().box(PROFESSIONS).shown())
}

test "the menu off the panel stands on its own, and the portrait goes" {
  Game.player.level = 42
  Test.mount(nil, SCREEN)
  place("Game menu buttons", POOL)
  Test.expect(!panel().box(PROFESSIONS).shown() && Test.page().box(PROFESSIONS).count() == 1)
  Test.expect(!Test.page().text("42").shown())
}

test "friends and guild off the panel stand on their own" {
  Test.mount(nil, SCREEN)
  place("Friends and guild", POOL)
  Test.expect(!panel().box(FRIENDS).shown() && Test.page().box(FRIENDS).count() == 1 && Test.page().box(GUILD).count() == 1)
}

// Where the panel runs

test "down the left side of the screen the panel has no experience bar" {
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Test.mount(nil, SCREEN)
  bottom("Bottom", "Top", "Left")
  Test.expect(panel().shown() && !Test.page().text(XP).shown())
}

test "down the right side of the screen the panel has no experience bar" {
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Test.mount(nil, SCREEN)
  bottom("Bottom", "Top", "Right")
  Test.expect(panel().shown() && !Test.page().text(XP).shown())
}

test "along the top the panel keeps its experience bar" {
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Test.mount(nil, SCREEN)
  bottom("Bottom", "Top", "Top")
  Test.expect(panel().text(XP).shown())
}

test "a watched faction's tube stands under the experience's on the panel" {
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Game.reputation.name = "Stormwind"
  Game.reputation.standing = "Honored"
  Game.reputation.min = 9000
  Game.reputation.max = 21000
  Game.reputation.value = 13800
  Test.mount(nil, SCREEN)
  Test.expect(panel().text(HONORED).shown())
  Test.expect(panel().text(XP).shown())
}

// When the panel shows

test "a panel set never to show is not drawn, and the game's buttons go back to the game" {
  const professions = frame("ProfessionMicroButton")
  Game.frames.ProfessionMicroButton = professions
  Test.mount(nil, SCREEN)
  hide("Always", "Never", "Never")
  Test.expect(!panel().shown() && professions.GetParent() == Client.C_UI.GetUIParent())
}

test "a panel shown on mouseover is all but unseen while the cursor is away, and shows under it" {
  Test.mount(nil, SCREEN)
  hide("Always", "Never", "On mouseover")
  Test.page().window(SETTINGS).text(SETTINGS).hover()
  Test.expect(panel().opacity() > 0 && panel().opacity() < 0.01)
  panel().text(MONEY).hover()
  Test.expect(panel().opacity() == 1)
  Test.page().window(SETTINGS).text(SETTINGS).hover()
  Test.expect(panel().opacity() < 0.01)
}

test "a panel hidden in combat is not drawn in combat, and drawn out of it" {
  Test.mount(nil, SCREEN)
  hide("Show", "Only in combat", "Hide")
  Test.expect(panel().shown())
  Game.situation.combat = true
  Test.expect(!panel().shown())
  Game.situation.combat = false
  Test.expect(panel().shown())
}

test "a panel shown only in combat is not drawn out of it" {
  Test.mount(nil, SCREEN)
  hide("Show", "Only in combat", "Only in combat")
  Test.expect(!panel().shown())
  Game.situation.combat = true
  Test.expect(panel().shown())
}

test "a hidden panel is drawn as faint as its opacity says" {
  Test.mount(nil, SCREEN)
  const settings = visibility()
  choose(settings, "Show", "Only in combat", "Hide")
  // The hidden panel's opacity: the tab's second slider, clicked in its middle: half.
  settings.button(Ordaen.art.ctl.groove).nth(2).click()
  settings.button("Save").click()
  Game.situation.combat = true
  Test.expect((panel().opacity() - 0.5).abs() < 0.01)
}

test "the panel hides in a vehicle, and shows there once the player unticks it" {
  Test.mount(nil, SCREEN)
  Game.situation.vehicle = true
  Test.expect(!panel().shown())
  tick(1)
  Test.expect(panel().shown())
}

test "the panel hides in a pet battle, and shows there once the player unticks it" {
  Test.mount(nil, SCREEN)
  Game.situation.petBattle = true
  Test.expect(!panel().shown())
  tick(2)
  Test.expect(panel().shown())
}

test "the panel hides while resting once the player ticks it" {
  Test.mount(nil, SCREEN)
  Game.situation.resting = true
  Test.expect(panel().shown())
  tick(3)
  Test.expect(!panel().shown())
}

// The parts switched on and off

test "the menu switched off: its cells gone, the game's own menu seen again" {
  const menu = frame("MicroMenuContainer")
  Game.frames.MicroMenuContainer = menu
  Test.mount(nil, SCREEN)
  Test.expect(panel().shown() && menu.GetAlpha() == 0)
  flip("General", Ordaen.art.ctl.switchOn, 2)
  Test.expect(!Test.page().box(PROFESSIONS).shown() && !Test.page().box(FRIENDS).shown() && menu.GetAlpha() == 1)
}

test "the bars switched off: no experience bar, the game's own status bars shown again" {
  const main = frame("MainStatusTrackingBarContainer")
  Game.frames.MainStatusTrackingBarContainer = main
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Test.mount(nil, SCREEN)
  flip("General", Ordaen.art.ctl.switchOn, 3)
  Test.expect(!Test.page().text(XP).shown() && main.IsShown())
}

test "the panel switched off: each of its items a part of its own, and no portrait" {
  Game.player.level = 42
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Game.bags.buttons = bagButtons(frame)
  Test.mount(nil, SCREEN)
  flip("General", Ordaen.art.ctl.switchOn, 4)
  Test.expect(!Test.page().text("42").shown() && panel().texts().join(" | ") == MONEY)
  Test.expect(Test.page().window(XP).shown() && Test.page().box(BACKPACK).shown() && Test.page().box(GAME_MENU).shown())
  // Friends and guild on their own, and not in the menu too.
  Test.expect(Test.page().box(FRIENDS).count() == 1 && Test.page().box(GUILD).count() == 1)
}

test "the menu's icons chosen in gold are gold off the panel too" {
  Test.mount(nil, SCREEN)
  const settings = tab("Micro menu")
  choose(settings, "Normal", "Gold", "Gold")
  settings.button("General").nth(2).click()
  settings.button(Ordaen.art.ctl.switchOn).nth(4).click()
  settings.button("Save").click()
  Test.expect(Test.page().box(PROFESSIONS).paintedWith(GOLD) && Test.page().box(FRIENDS).paintedWith(GOLD))
}

test "the panel's height reaches from 60, where its cells still fit, to 96 on its slider" {
  Test.mount(nil, SCREEN)
  const settings = tab("Bottom panel")
  Test.expect(settings.text("60 px").shown())
  // The knob dragged past the slider's start, over its name; then past its end, over the value it shows.
  drag(settings.box(Ordaen.art.ctl.sliderKnob).nth(1), [settings.text("Height")])
  Test.expect(settings.text("60 px").shown())
  drag(settings.box(Ordaen.art.ctl.sliderKnob).nth(1), [settings.text("60 px")])
  Test.expect(settings.text("96 px").shown())
}

test "a height kept lower than the cells fit, from before the slider stopped at 60, is read as 60" {
  const low: Choices = {
    microOn: true, statusOn: true, bottomOn: true, microIcons: MicroIcons.Upscaled, charButton: CharButton.Portrait,
    outline: Outline.None, shadow: true, edge: Edge.Bottom, fit: Fit.Full, height: 24, places: DEFAULTS.places,
    show: Show.Always, combat: Combat.Any, vehicle: true, petBattle: true, resting: false, fadedAlpha: 0
  }
  // Ordaen's profiles as the game keeps them: the default profile, the panel's section packed in it.
  const sections: Map<String, String> = {}
  sections["OrdaenPanel"] = Game.encoding.serialize(low)
  const profile: Map<String, Map<String, String>> = {}
  profile["sections"] = sections
  const profiles: Map<String, Map<String, Map<String, String>>> = {}
  profiles["Default"] = profile
  const kept: Map<String, Map<String, Map<String, Map<String, String>>>> = {}
  kept["profiles"] = profiles
  Game.saved.store(.Account, "profiles", kept)
  Test.reload()
  Test.mount(nil, SCREEN)
  // The menu's cells, of their one height, stand whole on the screen.
  const cell = panel().box(PROFESSIONS).rect()
  Test.expect(cell.bottom <= SCREEN.height)
}

test "the panel's text outline is chosen on the bars' tab: none, thin or thick" {
  Test.mount(nil, SCREEN)
  const settings = tab("Bars")
  choose(settings, "None", "Thick", "Thick")
  Test.expect(settings.button("Thick").shown())
  choose(settings, "Thick", "Thin", "Thin")
  Test.expect(settings.button("Thin").shown())
}

test "with the menu off, its tab's choices take no click" {
  Test.mount(nil, SCREEN)
  const settings = tab("General")
  settings.button(Ordaen.art.ctl.switchOn).nth(2).click()
  settings.button("Micro menu").click()
  settings.button("Normal").click()
  Test.expect(!Test.page().window("Gold").shown())
}

test "with the panel off, its tab's choices take no click" {
  Test.mount(nil, SCREEN)
  const settings = tab("General")
  settings.button(Ordaen.art.ctl.switchOn).nth(4).click()
  settings.button("Bottom panel").click()
  settings.button("Bottom").click()
  Test.expect(!Test.page().window("Top").shown())
}

test "the panel turned off in the game's list of addons leaves the game's menu and bags to the game" {
  const menu = frame("MicroMenuContainer")
  Game.frames.MicroMenuContainer = menu
  const bags = frame("BagsBar")
  Game.frames.BagsBar = bags
  Test.mount(nil, SCREEN)
  (Runtime.Addon.of(Panel) ?? panic("the panel is installed")).disable()
  Test.expect(Test.blank() && !Test.page().text(MONEY).shown())
  Test.expect(menu.GetAlpha() == 1 && bags.IsShown())
}

// The move mode

test "the move mode shows a panel set never to show, and hides it again as it ends" {
  Test.mount(nil, SCREEN)
  const settings = visibility()
  choose(settings, "Always", "Never", "Never")
  settings.button("Save").click()
  settings.button(SETTINGS).click()
  Test.expect(panel().text(MOVER).shown())
  settings.button(SETTINGS).click()
  Test.expect(!panel().shown())
}

test "the panel dragged in the move mode to the screen's left runs down it from then, kept at once" {
  Game.player.level = 42
  Game.player.xp = 2500
  Game.player.xpMax = 10000
  Test.mount(nil, SCREEN)
  const settings = visibility()
  // A change not saved: the drag leaves it waiting.
  choose(settings, "Always", "Never", "Never")
  settings.button(SETTINGS).click()
  // Carried over the portrait's badge, then let go over the portrait, in the screen's lower left corner: the left side
  // is nearest.
  const portrait = Test.page().window("42")
  drag(panel().text(MOVER), [portrait.text("42"), portrait.text(MOVER)])
  settings.button(SETTINGS).click()
  // Down the side, with no experience bar; «Never» still waits to be saved.
  Test.expect(panel().shown() && !Test.page().text(XP).shown() && settings.button("Never").shown())
  Test.expect(settings.button("Left").shown())
}

test "the panel right-clicked in the move mode goes back to the bottom" {
  Game.player.level = 42
  Test.mount(nil, SCREEN)
  const settings = tab("Bottom panel")
  choose(settings, "Bottom", "Top", "Top")
  settings.button("Save").click()
  settings.button(SETTINGS).click()
  panel().text(MOVER).rightClick()
  settings.button(SETTINGS).click()
  Test.expect(Test.page().text("42").shown() && settings.button("Bottom").shown())
}

test "the panel dragged to a side and then right-clicked goes back to the bottom" {
  Game.player.level = 42
  Test.mount(nil, SCREEN)
  const settings = tab("Bottom panel")
  settings.button(SETTINGS).click()
  const portrait = Test.page().window("42")
  drag(panel().text(MOVER), [portrait.text("42"), portrait.text(MOVER)])
  Test.expect(!Test.page().text("42").shown())
  panel().text(MOVER).rightClick()
  Test.expect(Test.page().text("42").shown())
}
