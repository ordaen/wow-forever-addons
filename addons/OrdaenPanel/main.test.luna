test "the panel's height reaches from 60, where its cells still fit, to 96 on its slider" {
  Test::mount(nil, SCREEN)
  const settings = tab("Bottom panel")
  Test::expect(settings.text("60 px").shown())
  // The knob dragged past the slider's start, over its name; then past its end, over the value it shows.
  drag(settings.box(Ordaen.art.ctl.sliderKnob).nth(1), [settings.text("Height")])
  Test::expect(settings.text("60 px").shown())
  drag(settings.box(Ordaen.art.ctl.sliderKnob).nth(1), [settings.text("60 px")])
  Test::expect(settings.text("96 px").shown())
}

test "a height kept lower than the cells fit, from before the slider stopped at 60, is read as 60" {
  const low: Choices = { height: 24, ..DEFAULTS }
  // Ordaen's profiles as the game keeps them: the default profile, the panel's section packed in it.
  const sections: map<string, string> = mut {}
  sections["OrdaenPanel"] = Game::encoding.serialize(low)
  const profile: map<string, map<string, string>> = mut {}
  profile["sections"] = sections
  const profiles: map<string, map<string, map<string, string>>> = mut {}
  profiles["Default"] = profile
  const kept: map<string, map<string, map<string, map<string, string>>>> = mut {}
  kept["profiles"] = profiles
  Game::saved.store(.Account, "profiles", kept)
  Test::reload()
  Test::mount(nil, SCREEN)
  // The menu's cells, of their one height, stand whole on the screen.
  const cell = panel().box(PROFESSIONS).rect()
  Test::expect(cell.bottom <= SCREEN.height)
  // Its slider says so too, before its knob is moved.
  Test::expect(tab("Bottom panel").text("60 px").shown())
}

test "the action bars' tab opened changes nothing: no step of the settings' history" {
  Test::mount(nil, SCREEN)
  const steps = Ordaen.keeper.steps
  const settings = tab("Action bars")
  Test::flush()
  Test::expect(settings.button("Action bars").shown() && Ordaen.keeper.steps == steps)
}

test "the panel's text outline is chosen on the bars' tab: none, thin or thick" {
