// When the panel shows

test "a panel set never to show is not drawn, and the game's buttons go back to the game" {
  const professions = frame("ProfessionMicroButton")
  Game::frames.ProfessionMicroButton = professions
  Test::mount(nil, SCREEN)
  hide("Show", 1, "Hide")
  Test::expect(!panel().shown() && professions.GetParent() == Client::C_UI::GetUIParent())
}

test "a panel shown on mouseover is all but unseen while the cursor is away, and shows under it" {
  Test::mount(nil, SCREEN)
  hide("Show", 1, "On mouseover")
  Test::page().window(SETTINGS).text(SETTINGS).hover()
  Test::expect(panel().opacity() > 0 && panel().opacity() < 0.01)
  panel().text(MONEY).hover()
  Test::expect(panel().opacity() == 1)
  Test::page().window(SETTINGS).text(SETTINGS).hover()
  Test::expect(panel().opacity() < 0.01)
}

test "a panel hidden in combat is not drawn in combat, and drawn out of it" {
  Test::mount(nil, SCREEN)
  hide("Show", 2, "Hide")
  Test::expect(panel().shown())
  Game::situation.combat = true
  Test::expect(!panel().shown())
  Game::situation.combat = false
  Test::expect(panel().shown())
}

test "a panel hidden out of combat is drawn in combat alone" {
  Test::mount(nil, SCREEN)
  hide("Show", 1, "Hide")
  Test::expect(!panel().shown())
  Game::situation.combat = true
  Test::expect(panel().shown())
}

test "a hidden panel is drawn as faint as its opacity says" {
  Test::mount(nil, SCREEN)
  const settings = visibility()
  pick(settings, "Show", 2, "Hide")
  // The hidden panel's opacity: the tab's second slider, clicked in its middle: half.
  settings.button(Ordaen.art.ctl.groove).nth(2).click()
  Game::situation.combat = true
  Test::expect((panel().opacity() - 0.5).abs() < 0.01)
}

test "a hidden panel's every part is as faint as it: the portrait, its badge and the game's buttons in its cells" {
  Game::player.level = 42
  const professions = frame("ProfessionMicroButton")
  Game::frames.ProfessionMicroButton = professions
  const character = frame("CharacterMicroButton")
  Game::frames.CharacterMicroButton = character
  Game::bags.buttons = bagButtons(frame)
  Test::mount(nil, SCREEN)
  const settings = visibility()
  pick(settings, "Show", 2, "Hide")
  settings.button(Ordaen.art.ctl.groove).nth(2).click()
  Game::situation.combat = true
  Test::expect((panel().opacity() - 0.5).abs() < 0.01)
  const portrait = Test::page().window("42")
  Test::expect(portrait.opacity() <= 0.51 && Test::page().text("42").opacity() <= 0.51)
  Test::expect(Test::page().box(Ordaen.art.panel.badge).opacity() <= 0.51)
  for (game of [professions, character, client("MainMenuBarBackpackButton")]) {
    Test::expect(game.GetEffectiveAlpha() <= 0.51)
  }
}

test "a panel shown on mouseover shows with its portrait under the cursor, and the portrait with it" {
  Game::player.level = 42
  Test::mount(nil, SCREEN)
  hide("Show", 1, "On mouseover")
  Test::page().window(SETTINGS).text(SETTINGS).hover()
  Test::expect(Test::page().text("42").opacity() < 0.01)
  Test::page().text("42").hover()
  Test::expect(panel().opacity() == 1 && Test::page().text("42").opacity() == 1)
  panel().text(MONEY).hover()
  Test::expect(panel().opacity() == 1 && Test::page().text("42").opacity() == 1)
  Test::page().window(SETTINGS).text(SETTINGS).hover()
  Test::expect(panel().opacity() < 0.01 && Test::page().text("42").opacity() < 0.01)
}

test "the panel shows on transport, and hides there once the player sets it to hide" {
  Test::mount(nil, SCREEN)
  Game::situation.vehicle = true
  Test::expect(panel().shown())
  Game::situation.vehicle = false
  Game::situation.taxi = true
  Test::expect(panel().shown())
  hide("Show", 3, "Hide")
  Test::expect(!panel().shown())
  Game::situation.taxi = false
  Test::expect(panel().shown())
}

test "a state set to show has no opacity to choose; hidden or on mouseover, it has" {
  Test::mount(nil, SCREEN)
  const settings = visibility()
  // The height's slider alone: every state shows.
  Test::expect(settings.box(Ordaen.art.ctl.sliderKnob).count() == 1)
  pick(settings, "Show", 1, "On mouseover")
  Test::expect(settings.box(Ordaen.art.ctl.sliderKnob).count() == 2)
  pick(settings, "On mouseover", 1, "Show")
  Test::expect(settings.box(Ordaen.art.ctl.sliderKnob).count() == 1)
}

test "the portrait stands over the panel shown again on mouseover" {
  Game::player.level = 42
  Test::mount(nil, SCREEN)
  hide("Show", 1, "On mouseover")
  Test::page().window(SETTINGS).text(SETTINGS).hover()
  panel().text(MONEY).hover()
  // The portrait's badge, where it lies over the panel's wood, is the portrait's to the mouse.
  Test::page().box(Ordaen.art.panel.badge).hover()
  const order = Test::surfaces().map(s => s.texts.join(" "))
  const portrait = order.find(t => t.contains("42"))
  Test::expect(portrait != nil)
  let panelAt = 0
  let portraitAt = 0
  for (index, texts of order) {
    if (texts.contains(MONEY)) { panelAt = index }
    if (texts.contains("42")) { portraitAt = index }
  }
  Test::expect(portraitAt > panelAt)
}

