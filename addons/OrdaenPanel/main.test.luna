test "friends and guild at the panel's end stand on their own, the game menu's button still the menu's last" {
  Test::mount(nil, SCREEN)
  Test::expect(panel().box(FRIENDS).item().paintedWith(divider()))
  place("Left", 2, "Right")
  const window = panel()
  // First of their own group: no groove before the friends' cell.
  Test::expect(!window.box(FRIENDS).item().paintedWith(divider()) && window.box(GUILD).item().paintedWith(divider()))
  Test::expect(window.box(CELL).nth(8).paintedWith(GAME_MENU) && window.box(CELL).nth(9).paintedWith(FRIENDS))
}

