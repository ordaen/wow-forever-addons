// What the player chooses on the panel's settings page.
import { ALWAYS, Visibility } from "Ordaen"

// The character button: the portrait in the screen's corner with the level, or a micro menu cell with the face.
public enum CharButton { Portrait = "portrait", Button = "button" }
// What the character button shows: the player's face, or the class's icon.
public enum CharView { Face = "face", ClassIcon = "classIcon" }
// The micro menu's icons: as they are, or the same in one gold.
public enum MicroIcons { Upscaled = "upscaled", Gold = "gold" }
// What the panel holds.
public enum Item {
  Micromenu = "micromenu", Social = "social", Experience = "experience", Zone = "zone", Clock = "clock"
  Currencies = "currencies", Bags = "bags"
}
// Where an item sits: one of the panel's zones, or not on the panel.
public enum Zone { Left = "left", Center = "center", Right = "right", Off = "off" }
public enum Edge { Bottom = "bottom", Top = "top", Left = "left", Right = "right" }
// The panel's length: the whole edge, or as long as its items, in the edge's middle.
public enum Fit { Full = "full", Center = "center" }
public enum Outline { None = "none", Thin = "thin", Thick = "thick" }
// What the experience bar is filled with: the look's bar texture, or one of the experience fills.
public enum XpTexture {
  Theme = "theme", Deep = "deep", Grain = "grain", Brushed = "brushed", Potion = "potion", Clouds = "clouds"
  Steel = "steel"
}
// The experience bar's edge: the look's, or one of the bars' edges.
public enum XpBorder { Theme = "theme", Bezel = "bezel", Groove = "groove" }
// What the experience and reputation bars say: the numbers or the percent first, the other dimmed in brackets; or
// the numbers alone, or the percent alone (the whole as 100%).
public enum XpView { Numbers = "numbers", Percent = "percent", NumbersOnly = "numbersOnly", PercentOnly = "percentOnly" }

// The zone each item sits in: one each, so no item stands in two.
public struct Places {
  public mut micromenu: Zone
  public mut social: Zone
  public mut experience: Zone
  public mut zone: Zone
  public mut clock: Zone
  public mut currencies: Zone
  public mut bags: Zone
}

public struct Choices {
  // The parts, each on or off.
  public mut microOn: boolean
  public mut statusOn: boolean
  public mut bottomOn: boolean
  public mut microIcons: MicroIcons
  public mut charButton: CharButton
  public mut charView: CharView
  // The panel's text.
  public mut outline: Outline
  public mut shadow: boolean
  // The experience bar.
  public mut xpTexture: XpTexture
  public mut xpBorder: XpBorder
  public mut xpView: XpView
  // The panel: where, how long, how high, what sits in which zone, when it shows.
  public mut edge: Edge
  public mut fit: Fit
  public mut height: number
  public mut places: Places
  public mut visibility: Visibility
}

public const DEFAULTS: Choices = {
  microOn: true, statusOn: true, bottomOn: true, microIcons: MicroIcons::Upscaled, charButton: CharButton::Portrait,
  charView: CharView::Face, outline: Outline::None, shadow: true, xpTexture: XpTexture::Brushed, xpBorder: XpBorder::Theme,
  xpView: XpView::Numbers, edge: Edge::Bottom, fit: Fit::Full, height: 60,
  places: {
    micromenu: Zone::Left, social: Zone::Left, experience: Zone::Center, zone: Zone::Off, clock: Zone::Off,
    currencies: Zone::Right, bags: Zone::Right
  },
  // Shown in every state: on transport too, where the game's own bars are put away as anywhere.
  visibility: ALWAYS
}
