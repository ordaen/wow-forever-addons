// A group of the panel's cells side by side: the game's menu, friends and guild, the bags. It alone parts its cells:
// one divider between two neighbours (the windows' deep cut in the wood, Ordaen's `Groove`), none at its ends, where what holds it (the panel's wood, a free part's frame)
// has its own edge. A cell draws no edge of its own, so no two dividers ever stand together.
import Game from "$game"
import { Align, Art, Frame, Position, Track } from "$ltml"
import { CUT, Component, Groove, SHORT_CUT, ShortCut } from "Ordaen"
import { BagCell, CELL_HEIGHT, CellSize, FaceCell, MenuCell, cellSize } from "@/cells"

// One track down a side of the screen; along it, the divider and the cell.
const DOWN: array<Track> = ["max-content"]
const PAIR: array<Track> = ["max-content", "max-content"]

// What a cell of a group is: the character's face, a button of the game's menu with our icon (the friends' with how
// many are online), a bag button of the game's.
public enum Cell {
  Face
  Menu { icon: Art, frame: any Frame | nil, friends: boolean }
  Bag { button: Game::BagButton }
}

// The group: its cells in their order, across the screen or down a side of it, each as high as the group is.
public class CellGroup implements Component {
  derived columns: array<Track> = self.vertical ? DOWN : self.across()
  derived size: CellSize = cellSize(self.height, self.vertical ? 0ui : self.rise)

  cells: Signal<array<Cell>>
  gold: Signal<boolean>
  vertical: Signal<boolean>
  height: Signal<number<Length>>
  face: Signal<string | nil>
  icon: Signal<Art | nil>
  rise: Signal<number<Length>>
  leading: Signal<boolean>
  constructor(
    cells: Signal<array<Cell>>,
    // The menu's icons in one gold.
    gold: Signal<boolean> = false,
    vertical: Signal<boolean> = false,
    // How high each cell is: the panel's inside.
    height: Signal<number<Length>> = CELL_HEIGHT,
    // The character's cell: the unit whose face it shows, or the class's icon.
    face: Signal<string | nil> = "player",
    icon: Signal<Art | nil> = nil,
    // How far the dividers reach up past the cells, to meet what holds them (the panel's metal over its room).
    rise: Signal<number<Length>> = 0ui,
    // A cut before its first cell too: what stands before the group has no edge of its own (the money before the bags).
    leading: Signal<boolean> = false
  ) {
    self.cells = cells
    self.gold = gold
    self.vertical = vertical
    self.height = height
    self.face = face
    self.icon = icon
    self.rise = rise
    self.leading = leading
  }

  across(): array<Track> {
    return self.cells.map((cell: Cell): Track => "max-content")
  }

  // A cell told anew (another icon on a bag) is another cell: it is drawn anew.
  public render(): Template {
    return $ltml {
      <box columns={self.columns}>
        <GroupCell $for={index, cell of self.cells} $key={cell} cell={peek cell} first={index == 1 && !(peek self.leading)}
                   last={index == self.cells.length}
                   gold={self.gold} vertical={self.vertical} size={self.size} face={self.face} icon={self.icon}
                   rise={self.rise} />
      </box>
    }
  }
}

// A cell of the group, with the divider before it unless it is the group's first.
class GroupCell implements Component {
  derived columns: array<Track> = self.vertical ? DOWN : PAIR
  derived rows: array<Track> | nil = self.vertical ? PAIR : nil
  // The divider: the cut down the cell's whole height between cells across the screen, along its whole width
  // between cells down a side.
  derived dividerWidth: number<Length> = self.vertical ? self.size.width : SHORT_CUT
  derived dividerHeight: number<Length> = self.vertical ? CUT : self.size.height
  derived upright: boolean = !self.vertical
  // The cut after a cell across the screen is lit with it under the cursor and takes its clicks: the cell reaches over
  // it, but the group's last, after which none stands.
  derived after: number<Length> = self.upright && !self.last ? SHORT_CUT : 0ui

  const cell: Cell
  const first: boolean
  // The cells come and go: whether it is the last follows them.
  last: Signal<boolean>
  gold: Signal<boolean>
  vertical: Signal<boolean>
  size: Signal<CellSize>
  face: Signal<string | nil>
  icon: Signal<Art | nil>
  rise: Signal<number<Length>>
  constructor(
    cell: Cell,
    first: boolean,
    last: Signal<boolean>,
    gold: Signal<boolean>,
    vertical: Signal<boolean>,
    size: Signal<CellSize>,
    face: Signal<string | nil>,
    icon: Signal<Art | nil>,
    rise: Signal<number<Length>>
  ) {
    self.cell = cell
    self.first = first
    self.last = last
    self.gold = gold
    self.vertical = vertical
    self.size = size
    self.face = face
    self.icon = icon
    self.rise = rise
  }

  public render(): Template {
    return $ltml {
      <box columns={self.columns} rows={self.rows} xAlign={Align::Center} yAlign={Align::Center}>
        <box $if={!self.first} width={self.dividerWidth} height={self.dividerHeight}>
          <box position={Position::Absolute} left={0ui} top={-self.rise} right={0ui} bottom={0ui} rows={[{ fr: 1 }]}
               yAlign={Align::Stretch}>
            <ShortCut $if={self.upright} />
            <Groove $else />
          </box>
        </box>
        <CellOf cell={self.cell} gold={self.gold} size={self.size} face={self.face} icon={self.icon} after={self.after} />
      </box>
    }
  }
}

// The cell itself, as what it is.
class CellOf implements Component {
  const cell: Cell
  gold: Signal<boolean>
  size: Signal<CellSize>
  face: Signal<string | nil>
  icon: Signal<Art | nil>
  after: Signal<number<Length>>
  constructor(
    cell: Cell,
    gold: Signal<boolean>,
    size: Signal<CellSize>,
    face: Signal<string | nil>,
    icon: Signal<Art | nil>,
    after: Signal<number<Length>>
  ) {
    self.cell = cell
    self.gold = gold
    self.size = size
    self.face = face
    self.icon = icon
    self.after = after
  }

  // What a template draws reads `self`: the cell is told by its own field.
  public render(): Template {
    match (self.cell) {
      .Face => return $ltml { <FaceCell size={self.size} face={self.face} icon={self.icon} after={self.after} /> }
      .Menu => {
        if (self.cell.friends) {
          return $ltml {
            <MenuCell icon={self.cell.icon} frame={self.cell.frame} gold={self.gold} size={self.size}
                      count={Game::friends.online} after={self.after} />
          }
        }
        return $ltml { <MenuCell icon={self.cell.icon} frame={self.cell.frame} gold={self.gold} size={self.size} after={self.after} /> }
      }
      .Bag => return $ltml { <BagCell button={self.cell.button} size={self.size} after={self.after} /> }
    }
  }
}
