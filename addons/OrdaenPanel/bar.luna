// A bar: the client's own buttons (its action, pet or stance button template) in a Placed part, laid out as the
// player chose, each with its key's text.
import Client from "$client"
import Events from "$events"
import { Align, Anchored, Art, Point, Position, Shadow } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, Placed, SECONDARY_TEXT, Visibility, opacityNow, space } from "Ordaen"
import { BarChoice, BarKind, BarSpec, defaultChoice } from "@/barChoices"
import Locale from "@/locales"

// The lowest bar's room above what keeps the screen's bottom edge (the bottom panel, or the edge itself), and the
// room between a bar and the one above it in the default stack.
const ABOVE: Number<Length> = space(.Item)
public const BETWEEN: Number<Length> = space(.Line)
const INK: Color = Color.hex("#ffffff")
const KEY_SHADOW: Shadow = { color: Color.hex("#000000"), x: 1ui, y: -1ui }

// The pet's buttons show while the player has a pet with its bar: the client's own condition, read in a fight too.
const WITH_PET = "[pet] show; hide"

// One button of a bar: the client's own, by its name, its binding's name, and whether the client shows it (it hides
// an action button with nothing on it, the pet's without a pet): what is drawn on it shows with it.
public class Slot {
  public const frame: any Client.ActionButton
  public const name: String
  public const command: String
  public state shown: Boolean = false
  // Whether the slot is still there: the client's hooks stay on its frame after it ends, and hear nothing then.
  const life: mut Life = { on: true }

  constructor(frame: any Client.ActionButton, name: String, command: String) {
    self.frame = frame
    self.name = name
    self.command = command
    self.shown = frame.IsShown()
    const life = self.life
    _ = frame.HookScript("OnShow", (): nil => {
      if (life.on) { self.shown = true }
    })
    _ = frame.HookScript("OnHide", (): nil => {
      if (life.on) { self.shown = false }
    })
  }

  destructor() { self.life.on = false }
}

struct Life {
  on: Boolean
}

// A bar's height in the default stack: its rows of buttons and the room between them.
public function heightOf(count: Integer, perRow: Integer, size: Number, spacing: Number): Number<Length> {
  const rows = (count / perRow).ceil()
  if (rows == 0) { return 0ui }
  return (rows * size + (rows - 1) * spacing) * 1ui
}

// A key as a button shows it: the modifiers by their first letter (`SHIFT-1` is `S1`).
public function shortKey(key: String): String {
  return key.replace("SHIFT%-", "S").replace("CTRL%-", "C").replace("ALT%-", "A")
}

// The name of a bar's button, a global of the client's: what a binding's click names.
public function buttonName(id: String, index: Integer): String { return `OrdaenPanelBar${id}Button${index}` }

// What a stance's or the pet's button shows of its own: its icon, drawn under the client's button (the client's
// template draws none: the game's own stance and pet bars set it), and whether it is on (the form the player is in,
// the pet's stance or command), lit in the look's accent over it.
public struct Face {
  icon: Art | nil
  lit: Boolean
  // Whether it can be done now: dimmed where it can't, as the client's own buttons are.
  usable: Boolean
}

const BLANK: Face = { icon: nil, lit: false, usable: true }
// How faint the icon of what can't be done now is.
const DIMMED = 0.4

// A pet's command names its icon by one of the client's globals (`isToken`).
function commandIcon(token: String): Art | nil {
  const path: String | nil = match (token) {
    "PET_ATTACK_TEXTURE" => Client.PET_ATTACK_TEXTURE
    "PET_FOLLOW_TEXTURE" => Client.PET_FOLLOW_TEXTURE
    "PET_MOVE_TO_TEXTURE" => Client.PET_MOVE_TO_TEXTURE
    "PET_WAIT_TEXTURE" => Client.PET_WAIT_TEXTURE
    "PET_ASSIST_TEXTURE" => Client.PET_ASSIST_TEXTURE
    "PET_DEFENSIVE_TEXTURE" => Client.PET_DEFENSIVE_TEXTURE
    "PET_DEFENSIVEASSIST_TEXTURE" => Client.PET_DEFENSIVEASSIST_TEXTURE
    "PET_AGGRESSIVE_TEXTURE" => Client.PET_AGGRESSIVE_TEXTURE
    "PET_PASSIVE_TEXTURE" => Client.PET_PASSIVE_TEXTURE
    "PET_DISMISS_TEXTURE" => Client.PET_DISMISS_TEXTURE
    else => nil
  }
  return path is Asset ? path : nil
}

// One button: the client's own, and its key's text in its top right corner while the client shows it; a stance's or
// the pet's its face. A stance's and the pet's button of the client's is unseen over its face: the client's small
// template draws its art at its own size (30, its frame 35) whatever size it is given, so it would stand out of the
// button and apart from the next; it still takes the click and the cursor.
public class Button implements Component {
  derived key: String = self.showKeys && self.slot.shown ? self.keys[self.slot.command] ?? "" : ""

  const slot: Slot
  // Whether the button has a face of ours (a stance's, the pet's), and the client's is unseen.
  const faced: Boolean
  keys: Signal<Map<String, String>>
  size: Signal<Number<Length>>
  showKeys: Signal<Boolean>
  face: Signal<Face>
  constructor(slot: Slot, faced: Boolean, keys: Signal<Map<String, String>>, size: Signal<Number<Length>>,
    showKeys: Signal<Boolean>, face: Signal<Face>) {
    self.slot = slot
    self.faced = faced
    self.keys = keys
    self.size = size
    self.showKeys = showKeys
    self.face = face
  }

  public render(self): Template {
    return $ltml {
      <box width={self.size} height={self.size}>
        <box $if={self.face.icon != nil && self.slot.shown} position={Position.Absolute} left={0ui} top={0ui}
             width={self.size} height={self.size} background={self.face.icon}
             opacity={self.face.usable ? 1 : DIMMED} />
        // The client's own cooldown sweep of the button, over its face: the client's button is unseen.
        <embed $if={self.faced} frame={self.slot.frame.cooldown} position={Position.Absolute} left={0ui} top={0ui}
               width={self.size} height={self.size} />
        <embed frame={self.slot.frame} position={Position.Absolute} left={0ui} top={0ui} width={self.size}
               height={self.size} opacity={self.faced ? 0 : nil} />
        <box $if={self.face.lit && self.slot.shown} position={Position.Absolute} left={0ui} top={0ui}
             width={self.size} height={self.size} background={Ordaen.art.ctl.qualityRim}
             tint={Ordaen.look.values.accent} zLevel={2} />
        <box position={Position.Absolute} left={0ui} top={0ui} right={0ui} xAlign={Align.End} padding={2ui} zLevel={2}>
          <text value={self.key} textColor={INK} textSize={SECONDARY_TEXT} textShadow={KEY_SHADOW} wrap={false} />
        </box>
      </box>
    }
  }
}

// A bar of the client's own buttons, each on its slot (an action bar's) or its place (the pet's, the stances'): the
// client's template draws the action's icon, cooldown, charges and count and the range and usable tints, and casts or
// uses it on the player's click, in a fight too. Панель 1's buttons page as the client's main bar does, by a secure
// driver of their `actionpage`: in a form whose page the player keeps, Панель 1 shows that form's page, in a fight too.
// It stands above what keeps the screen's bottom edge and the bars under it in the stack until the player moves it, and shows as its visibility says (by
// its opacity alone: its buttons are protected, and a fight keeps them where they are). Its choice changes out of a
// fight alone: its module hands it the choice that applies.
public class Bar implements Component {
  slots: Array<Slot> = []
  state hovered = false
  derived home: Anchored = { point: Point.Bottom, y: -(Ordaen.bottomTaken + ABOVE + self.below) }
  derived choice: BarChoice = self.choices[self.spec.id] ?? self.defaults[self.spec.id] ?? defaultChoice(self.spec, false)
  derived visibility: Visibility = self.choice.visibility
  derived opacity: Number = opacityNow(self.visibility, self.hovered)
  // How many of its buttons show: as many as chosen, and for the stances' bar no more than the player's forms.
  derived count: Integer = self.spec.kind == BarKind.Stance ? self.choice.buttons.min(self.forms) : self.choice.buttons
  derived drawn: Array<Slot> = self.drawnOf(true)
  // The buttons past its count: kept unseen while it is drawn (the renderer shows an embedded frame let go again).
  derived unseen: Array<Slot> = self.drawnOf(false)
  derived size: Number<Length> = self.choice.size * 1ui
  derived spacing: Number<Length> = self.choice.spacing * 1ui
  derived showKeys: Boolean = self.choice.keys
  // As many columns as buttons in a row, and no more than it has buttons: an empty column would take the cursor.
  derived columns: Integer = self.choice.perRow.min(self.count).max(1)
  // Each button's face on the stances' and the pet's bars, by its place: read again as the player learns or takes a
  // form, and as the pet comes, goes or changes its bar.
  state faces: Array<Face> = []
  // Whether the bar is still there: the client's hooks on its Quick Keybind mode stay after it ends.
  const life: mut Life = { on: true }

  // What tells it from every other part in the placing mode, and its name there.
  id: String
  title: String

  const spec: BarSpec
  // How high the bars under it in the default stack stand, with the room above each.
  below: Signal<Number<Length>>
  choices: Signal<Map<String, BarChoice>>
  defaults: Signal<Map<String, BarChoice>>
  keys: Signal<Map<String, String>>
  paging: Signal<String>
  forms: Signal<Integer>
  constructor(
    spec: BarSpec,
    below: Signal<Number<Length>>,
    // Each bar's settings that apply, by its id, and this bar's before the player changed them.
    choices: Signal<Map<String, BarChoice>>,
    defaults: Signal<Map<String, BarChoice>>,
    keys: Signal<Map<String, String>>,
    // Панель 1's paging: the client's macro options its buttons' `actionpage` follows.
    paging: Signal<String>,
    // The player's forms, which the stances' bar shows.
    forms: Signal<Integer>
  ) {
    self.spec = spec
    self.below = below
    self.choices = choices
    self.defaults = defaults
    self.keys = keys
    self.paging = paging
    self.forms = forms
    self.id = `OrdaenPanel.bar${spec.id}`
    self.title = Bar.titleOf(spec)
    const buttons: Array<Slot> = []
    for (index of 1..spec.most) {
      const name = buttonName(spec.id, index)
      const frame = Client.CreateFrame("CheckButton", name, Client.UIParent, spec.template)
      if (!(frame is Client.ActionButton)) { panic("the client's action button templates make check buttons") }
      const command = `${spec.command}${index}`
      // The binding the client's Quick Keybind mode binds while the cursor is on the button, as the game's bars give
      // their buttons theirs.
      frame.commandName = command
      if (spec.kind == BarKind.Action && spec.number != 1) {
        frame.SetAttribute("type", "action")
        frame.SetAttribute("action", spec.first + index - 1)
      } else {
        // Панель 1's, the pet's and the stances' buttons are told by their place, as the game's own are.
        frame.SetID(index)
      }
      if (spec.kind == BarKind.Stance) {
        // A form is taken by its spell (`armForms`); its tooltip asks the client by its place.
        frame.SetAttribute("type", "spell")
        frame.index = index
      }
      buttons.push(new Slot(frame, name, command))
    }
    self.slots = buttons
    // The client's Quick Keybind mode shows its highlight on the game's own buttons alone: ours are told as it opens
    // and closes.
    const life = self.life
    _ = Client.QuickKeybindFrame.HookScript("OnShow", (): nil => {
      if (life.on) { self.keybinding(true) }
    })
    _ = Client.QuickKeybindFrame.HookScript("OnHide", (): nil => {
      if (life.on) { self.keybinding(false) }
    })
    if (spec.kind == BarKind.Action && spec.number == 1) {
      watch (options of self.paging) {
        for (slot of peek self.slots) { Client.RegisterAttributeDriver(slot.frame, "actionpage", options) }
      }
    }
    watch (count of self.count) { self.showFirst(count) }
    if (spec.kind == BarKind.Stance) {
      watch (count of self.forms) {
        self.readForms(count)
        self.armForms(count)
        self.readCooldowns()
      }
      Events.UPDATE_SHAPESHIFT_FORM.listen(self.reform)
      Events.UPDATE_SHAPESHIFT_USABLE.listen(self.reform)
      Events.UPDATE_SHAPESHIFT_COOLDOWN.listen(self.readCooldowns)
    } else if (spec.kind == BarKind.Pet) {
      self.readPet()
      Events.PET_BAR_UPDATE.listen(self.readPet)
      Events.UNIT_PET.listen(self.petOf)
    }
  }

  reform(mut self) { self.readForms(peek self.forms) }

  // The stances' faces, each form's by its button's place: whether the player is in it, whether it can be taken.
  readForms(mut self, count: Integer) {
    const faces: Array<Face> = []
    for (index of 1..self.spec.most) {
      let icon, active, castable, _ = Client.GetShapeshiftFormInfo(index)
      faces.push(index <= count ? { icon: icon, lit: active, usable: castable } : BLANK)
    }
    self.faces = faces
  }

  // Each form's button does its spell. Out of a fight alone, as the forms are counted: a button's attributes are
  // protected in one.
  armForms(self, count: Integer) {
    for (index, slot of peek self.slots) {
      let _, _, _, spell = Client.GetShapeshiftFormInfo(index)
      slot.frame.SetAttribute("spell", index <= count ? spell : nil)
    }
  }

  // Each form's cooldown, on its button's sweep.
  readCooldowns(self) {
    for (index, slot of peek self.slots) {
      let start, duration, _ = Client.GetShapeshiftFormCooldown(index)
      slot.frame.cooldown.SetCooldown(start, duration)
    }
  }

  // The client's Quick Keybind mode opens (`true`) or closes: each button shows the mode's highlight while it runs.
  keybinding(self, on: Boolean) {
    for (slot of peek self.slots) { slot.frame.DoModeChange(on) }
  }

  petOf(mut self, unit: String) {
    if (unit == "player") { self.readPet() }
  }

  // The pet's faces, each place's of its bar: a command's icon is named by a global of the client's.
  readPet(mut self) {
    const faces: Array<Face> = []
    for (index of 1..self.spec.most) {
      let _, texture, token, active, _, _, _ = Client.GetPetActionInfo(index)
      const icon: Art | nil = texture is String ? (token ? commandIcon(texture) : texture is Asset ? texture : nil) : texture
      faces.push({ icon: icon, lit: active, usable: true })
    }
    self.faces = faces
  }

  // The client's frames can't be destroyed: hidden, they take no click and draw nothing. In a fight the client hides
  // no protected frame: they fade at once and are hidden as it ends.
  destructor() {
    self.life.on = false
    // The frames outlive their slots, which end with the bar.
    const frames = self.slots.map(slot => slot.frame)
    const pet = self.spec.kind == BarKind.Pet
    for (frame of frames) { frame.SetAlpha(0) }
    Ordaen.afterCombat(() => Bar.putAway(frames, pet))
  }

  putAway(frames: Array<any Client.Frame>, pet: Boolean) {
    for (frame of frames) {
      if (pet) { Client.UnregisterStateDriver(frame, "visibility") }
      frame.Hide()
      frame.SetAlpha(1)
    }
  }

  // Its name in the placing mode and on the module's page.
  public titleOf(spec: BarSpec): String {
    return match (spec.kind) {
      BarKind.Action => Locale.BAR_TITLE.format(spec.number)
      BarKind.Pet => Locale.BAR_PET
      BarKind.Stance => Locale.BAR_STANCE
    }
  }

  // The buttons within its count (`within`), or those past it.
  drawnOf(self, within: Boolean): Array<Slot> {
    const drawn: Array<Slot> = []
    for (index, slot of self.slots) {
      if ((index <= self.count) == within) { drawn.push(slot) }
    }
    return drawn
  }

  // The pet's buttons within the count show while there is a pet; those past it have no driver, and stay unseen.
  showFirst(self, count: Integer) {
    if (self.spec.kind != BarKind.Pet) { return }
    for (index, slot of peek self.slots) {
      if (index <= count) {
        Client.RegisterStateDriver(slot.frame, "visibility", WITH_PET)
      } else {
        Client.UnregisterStateDriver(slot.frame, "visibility")
      }
    }
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <frame $for={slot of self.unseen} of={slot.frame} shown={false} />
      <Placed id={self.id} title={self.title} home={self.home}>
        <box columns={self.columns} gap={self.spacing} opacity={self.opacity} hoverWithin={true}
             @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
          <Button $for={index, slot of self.drawn} slot={peek slot} faced={self.spec.kind != BarKind.Action} keys={self.keys} size={self.size}
                  showKeys={self.showKeys} face={self.faces[index] ?? BLANK} />
        </box>
      </Placed>
    }
  }
}
