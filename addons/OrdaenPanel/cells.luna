// The panel's cells: a button of the game's menu or a bag, each a cell of the panel with the game's own button in
// it, so its click, its menus and its alerts stay the game's. A cell draws no edge of its own: the group it stands
// in parts it from its neighbours (`group.luna`). A cell fills the panel's inside from edge to edge, as high as it
// is; everything on it keeps its proportions to the cell's least size.
import Game from "$game"
import { Art, ByInteractionState, Frame, Position } from "$ltml"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, Component, CountBadge, SECONDARY_TEXT } from "Ordaen"

// The least a cell is high, and where it is drawn at that: the panel with the whole menu, seven bag buttons and the
// money still fits a 1366 x 768 screen at a UI scale of 1. A cell is square.
public const CELL_HEIGHT = 53ui
public const CELL_WIDTH: Number<Length> = CELL_HEIGHT
// The face on the character's cell.
const FACE = 46.875dp
const ICON = 35ui
const GOLD: Color = Color.hex("#ffb847")
// The cell under the cursor: a warm light over the wood; pushed, a shade.
const LIT: ByInteractionState<Color> = { default: Color.hex("#00000000"), hover: Color.hex("#ffd9a01f"), pressed: Color.hex("#00000040"), focus: Color.hex("#ffd9a01f") }
// The keyring's button draws a sheet of two states: its cell shows the key ring's own icon.
const KEYRING_ICON: Asset = "Interface/Icons/INV_Misc_Key_03"
// An icon as its file draws it.
const UNTINTED: Color = Color.hex("#ffffff")

// A cell's measures at its height: its width in the least cell's proportion, its icon's size and place.
public struct CellSize {
  width: Number<Length>
  height: Number<Length>
  icon: Number<Length>
  iconLeft: Number<Length>
  // One place, pressed or not: the game's button over the icon takes the press, and an icon that followed the cursor
  // would take the mouse from that button.
  iconTop: Number<Length>
  face: Number<Length>
}

public function cellSize(height: Number<Length>): CellSize {
  const scale = height / CELL_HEIGHT
  const width = CELL_WIDTH * scale
  const icon = ICON * scale
  return {
    width: width, height: height, icon: icon, iconLeft: (width - icon) / 2,
    iconTop: (height - icon) / 2, face: FACE * scale
  }
}

// A button of the game's menu: our icon on the cell, the game's button unseen over it.
public class MenuCell implements Component {
  // Ordaen's art and the look's fonts: its root is there before this module loads.
  derived tint: Color = self.gold ? GOLD : UNTINTED
  derived counted: Boolean = self.count > 0
  derived badgeRight: Number<Length> = self.size.width * 0.12
  derived badgeBottom: Number<Length> = self.size.height * 0.14

  const icon: Art
  frame: Signal<any Frame | nil>
  gold: Signal<Boolean>
  count: Signal<Integer>
  size: Signal<CellSize>
  constructor(
    icon: Art,
    frame: Signal<any Frame | nil>,
    // The icon in one gold.
    gold: Signal<Boolean>,
    size: Signal<CellSize>,
    // A number on the cell while it isn't 0: the friends online.
    count: Signal<Integer> = 0
  ) {
    self.icon = icon
    self.frame = frame
    self.gold = gold
    self.size = size
    self.count = count
  }

  public render(self): Template {
    return $ltml {
      <box width={self.size.width} height={self.size.height} background={LIT}>
        <box position={Position.Absolute} left={self.size.iconLeft} top={self.size.iconTop} width={self.size.icon}
             height={self.size.icon} background={self.icon} desaturate={self.gold} tint={self.tint}
        />
        <box $if={self.counted} position={Position.Absolute} right={self.badgeRight} bottom={self.badgeBottom}
             zLevel={1}>
          <CountBadge count={self.count} />
        </box>
        <embed frame={self.frame} position={Position.Absolute} left={0ui} top={0ui} width={self.size.width}
               height={self.size.height} opacity={0} />
      </box>
    }
  }
}

// The character's button as a cell: the player's face (or the class's icon), round, with the game's button unseen
// over the cell like the others.
public class FaceCell implements Component {
  // Ordaen's art: its root is there before this module loads.
  derived faceLeft: Number<Length> = (self.size.width - self.size.face) / 2
  derived faceTop: Number<Length> = (self.size.height - self.size.face) / 2

  size: Signal<CellSize>
  face: Signal<String | nil>
  icon: Signal<Art | nil>
  constructor(
    size: Signal<CellSize>,
    // The unit whose face it shows, or nil for the class's icon.
    face: Signal<String | nil>,
    icon: Signal<Art | nil>
  ) {
    self.size = size
    self.face = face
    self.icon = icon
  }

  public render(self): Template {
    return $ltml {
      <box width={self.size.width} height={self.size.height} background={LIT}>
        <box position={Position.Absolute} left={self.faceLeft} top={self.faceTop} width={self.size.face}
             height={self.size.face} portrait={self.face} icon={self.icon} mask={Ordaen.art.panel.faceRound} />
        <embed frame={Game.frames.CharacterMicroButton} position={Position.Absolute} left={0ui} top={0ui}
               width={self.size.width} height={self.size.height} opacity={0} />
      </box>
    }
  }
}

// A bag button of the game's: the icon the game shows on it, on the cell as the menu's icons stand, and the game's
// button unseen over the cell: its click opens the bag, a drag picks it up, its tooltip names it. The backpack's has
// the free slots of every bag in its lower right.
public class BagCell implements Component {
  // Ordaen's art and the look's fonts: its root is there before this module loads.
  derived counted: Boolean = self.button.kind == Game.BagKind.Backpack && Game.bags.free > 0
  derived countInset: Number<Length> = self.size.iconLeft - 3.515625dp
  derived countBottom: Number<Length> = self.size.iconLeft - 7.03125dp
  derived icon: Art | nil = self.button.kind == Game.BagKind.Keyring ? KEYRING_ICON : self.button.icon

  const button: Game.BagButton
  size: Signal<CellSize>
  constructor(button: Game.BagButton, size: Signal<CellSize>) {
    self.button = button
    self.size = size
  }

  public render(self): Template {
    return $ltml {
      <box width={self.size.width} height={self.size.height} background={LIT}>
        <box position={Position.Absolute} left={self.size.iconLeft} top={self.size.iconTop} width={self.size.icon}
             height={self.size.icon} icon={self.icon} />
        <box $if={self.counted} position={Position.Absolute} right={self.countInset} bottom={self.countBottom}
             zLevel={1}>
          <text value={"%d"} arguments={[Game.bags.free]} textSize={SECONDARY_TEXT} textColor={BRIGHT_TEXT}
                textFont={.Numbers} textOutline={1} wrap={.None} />
        </box>
        <embed frame={self.button.frame} position={Position.Absolute} left={0ui} top={0ui} width={self.size.width}
               height={self.size.height} opacity={0} />
      </box>
    }
  }
}
