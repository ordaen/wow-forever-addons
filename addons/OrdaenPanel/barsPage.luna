// The panel's «Action bars» page in the settings window: the bars in a list on its left, each with its switch; the
// bar picked there beside it, its name with its «…» menu (another bar's settings copied in, its own reset, its place
// back where the panel puts it) over its own settings, one section under another, and for Панель 1 the forms that
// page it. Each control writes the settings' draft.
import Game from "$game"
import { Align, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Checkbox, Component, InputNumber, ListTab, Memory, Menu, MenuEntry, SECONDARY_TEXT, Section, Settings, Shown, ShownToggle, Switch, TITLE_TEXT, Unit, VisibilityRows, space } from "Ordaen"
import { Bar } from "@/bar"
import { BarChoice, BarKind, BarSpec, BarsChoices, SPECS, copied, defaultChoice, reset } from "@/barChoices"
import Locale from "@/locales"

// A form of the player's class that pages Панель 1: its bonus bar and its name.
public struct Form {
  bonusbar: Integer
  name: String
}

// The forms that page Панель 1, by the client's own tables (`SpellShapeshiftForm.BonusActionBar`): a warrior's three
// stances, a druid's cat, prowl and bear, a rogue's stealth. Other classes have none.
public function formsOf(classTag: String): Array<Form> {
  return match (classTag) {
    "WARRIOR" => [
      { bonusbar: 1, name: Locale.FORM_BATTLE },
      { bonusbar: 2, name: Locale.FORM_DEFENSIVE },
      { bonusbar: 3, name: Locale.FORM_BERSERKER }
    ]
    "DRUID" => [
      { bonusbar: 1, name: Locale.FORM_CAT },
      { bonusbar: 2, name: Locale.FORM_PROWL },
      { bonusbar: 3, name: Locale.FORM_BEAR }
    ]
    "ROGUE" => [{ bonusbar: 1, name: Locale.FORM_STEALTH }]
    else => []
  }
}

// One form's switch: on, Панель 1 shows the form's page in it.
class FormRow implements Component {
  state on: Boolean

  const form: Form
  settings: mut Settings<BarsChoices>
  constructor(form: Form, settings: mut Settings<BarsChoices>) {
    self.form = form
    self.settings = settings
    self.on = (peek self.settings.draft).unpaged[String.of(form.bonusbar)] != true
    watch (on of self.on) {
      const unpaged = (peek self.settings.draft).unpaged.clone()
      unpaged[String.of(self.form.bonusbar)] = !on
      self.settings.draft.unpaged = unpaged
    }
  }

  public render(self): Template {
    return $ltml { <Switch label={self.form.name} hint={Locale.FORM_TIP} value={mut self.on} /> }
  }
}

// A bar's settings in the draft, or its defaults where the player never changed them.
function choiceIn(values: BarsChoices, defaults: Map<String, BarChoice>, spec: BarSpec): BarChoice {
  return values.bars[spec.id] ?? defaults[spec.id] ?? defaultChoice(spec, false)
}

// A bar's settings written into the draft: one change.
function put(settings: mut Settings<BarsChoices>, spec: BarSpec, choice: BarChoice) {
  const bars = (peek settings.draft).bars.clone()
  bars[spec.id] = choice
  settings.draft.bars = bars
}

// A bar in the page's list: its name, picked by a click, and its switch.
class BarTab implements Component {
  public pick: Event<BarSpec> = new Event()
  public flip: Event<BarSpec> = new Event()

  derived on: Boolean = choiceIn(self.settings.draft, self.defaults, self.spec).on
  derived shown: Shown = self.on ? .On : .Off
  derived selected: Boolean = self.picked == self.spec.id
  derived off: Boolean = !self.on

  const spec: BarSpec
  const title: String
  picked: Signal<String>
  defaults: Signal<Map<String, BarChoice>>
  settings: Settings<BarsChoices>
  constructor(spec: BarSpec, picked: Signal<String>, defaults: Signal<Map<String, BarChoice>>, settings: Settings<BarsChoices>) {
    self.spec = spec
    self.title = Bar.titleOf(spec)
    self.picked = picked
    self.defaults = defaults
    self.settings = settings
  }

  onPick(self) { self.pick.emit(self.spec) }
  onFlip(self) { self.flip.emit(self.spec) }

  public render(self): Template {
    return $ltml {
      <ListTab label={self.title} selected={self.selected} off={self.off} @pick={self.onPick}>
        <ShownToggle state={self.shown} @flip={self.onFlip} />
      </ListTab>
    }
  }
}

// The picked bar's settings: a copy of its choice the controls change, written into the draft as they do, and
// taken again from the draft where something else writes it there (the «…» menu, a profile).
class BarEditor implements Component {
  state choice: mut BarChoice
  derived paged: Boolean = self.spec.kind == BarKind.Action && self.spec.number == 1 && self.forms.length > 0

  const spec: BarSpec
  const forms: Array<Form>
  settings: mut Settings<BarsChoices>
  defaults: Signal<Map<String, BarChoice>>
  constructor(spec: BarSpec, settings: mut Settings<BarsChoices>, defaults: Signal<Map<String, BarChoice>>) {
    self.spec = spec
    self.settings = settings
    self.defaults = defaults
    self.forms = formsOf(peek Game.player.classTag)
    self.choice = choiceIn(peek self.settings.draft, peek self.defaults, spec).clone()
    watch (choice of self.choice) {
      if (!choiceIn(peek self.settings.draft, peek self.defaults, self.spec).equal(choice)) {
        put(mut self.settings, self.spec, choice)
      }
    }
    watch (draft of self.settings.draft) {
      const drafted = choiceIn(draft, peek self.defaults, self.spec)
      if (!drafted.equal(peek self.choice)) { self.choice = drafted.clone() }
    }
  }

  public render(self): Template {
    return $ltml {
      <Section title={Locale.SECTION_BUTTONS}>
        <InputNumber label={Locale.BUTTONS} hint={Locale.BUTTONS_TIP} value={mut self.choice.buttons} least={1}
                     most={self.spec.most} />
        <InputNumber label={Locale.PER_ROW} hint={Locale.PER_ROW_TIP} value={mut self.choice.perRow} least={1}
                     most={self.spec.most} />
      </Section>
      <Section title={Locale.SECTION_LOOK}>
        <InputNumber label={Locale.SIZE} hint={Locale.SIZE_TIP} value={mut self.choice.size} least={24} most={64}
                     unit={Unit.Px} />
        <InputNumber label={Locale.SPACING} hint={Locale.SPACING_TIP} value={mut self.choice.spacing} least={0}
                     most={16} unit={Unit.Px} />
        <Checkbox label={Locale.KEYS} hint={Locale.KEYS_TIP} value={mut self.choice.keys} />
      </Section>
      <VisibilityRows value={mut self.choice.visibility} />
      <Section $if={self.paged} title={Locale.SECTION_FORMS}>
        <FormRow $for={form of self.forms} form={peek form} settings={mut self.settings} />
      </Section>
    }
  }
}

// What the page remembers: the bar last picked, which it opens on.
struct PageMemory implements Plain {
  picked: String
}

const LIST_WIDTH = 234.375dp
const PAGE: Array<Track> = [LIST_WIDTH, { fr: 1 }]
const HEAD: Array<Track> = [{ fr: 1 }, "max-content"]
const MORE = 39.84375dp
// The «…» glyph on the head's icon button.
const MORE_GLYPH = "…"
const INK: Color = Color.hex("#e8dcc4")
const DIM: Color = Color.hex("#a3977f")
// The «…» menu's entries by their place: the copy's submenu first, then these.
const RESET_ENTRY = 2
const PLACE_ENTRY = 3

public class BarsPage implements Component {
  const memory: mut Memory<PageMemory> = new Memory<PageMemory>({ picked: "1" }, .Profile, "barsPage")
  derived picked: String = self.spec.id
  derived spec: BarSpec = SPECS.find(spec => spec.id == self.memory.values.picked) ?? SPECS[1]
  derived title: String = Bar.titleOf(self.spec)
  // The «…» menu: copying another bar's settings in (a submenu of every other bar, an off one marked), resetting
  // them, the bar back where the panel puts it.
  state menuOpen = false
  derived others: Array<BarSpec> = SPECS.filter(spec => spec.id != self.spec.id)
  derived entries: Array<MenuEntry> = [
    { label: Locale.COPY_FROM, more: self.others.map(spec => ({ label: self.nameOf(spec) })) },
    { label: Locale.RESET_BAR },
    { label: Locale.DEFAULT_PLACE }
  ]
  // The bar whose settings were copied into the picked one, until another is picked.
  state copiedFrom: String | nil = nil
  derived fromShown: Boolean = self.copiedFrom != nil

  settings: mut Settings<BarsChoices>
  // Each bar's settings before the player changes them, by its id.
  defaults: Signal<Map<String, BarChoice>>
  // Bartender4 is loaded: the bars stay off, and the page says why.
  conflict: Signal<Boolean>
  constructor(settings: mut Settings<BarsChoices>, defaults: Signal<Map<String, BarChoice>>, conflict: Signal<Boolean>) {
    self.settings = settings
    self.defaults = defaults
    self.conflict = conflict
  }

  // A bar's name in the copy's submenu: an off one says so.
  nameOf(self, spec: BarSpec): String {
    const title = Bar.titleOf(spec)
    return choiceIn(self.settings.draft, self.defaults, spec).on ? title : Locale.BAR_OFF.format(title)
  }

  onPick(mut self, spec: BarSpec) {
    self.memory.write({ picked: spec.id })
    self.copiedFrom = nil
  }

  onFlip(mut self, spec: BarSpec) {
    const choice = choiceIn(peek self.settings.draft, peek self.defaults, spec).clone()
    choice.on = !choice.on
    put(mut self.settings, spec, choice)
  }

  toggleMenu(mut self) { self.menuOpen = !self.menuOpen }
  closeMenu(mut self) { self.menuOpen = false }

  onMenu(mut self, index: Integer) {
    const spec = peek self.spec
    if (index == RESET_ENTRY) {
      const now = choiceIn(peek self.settings.draft, peek self.defaults, spec)
      put(mut self.settings, spec, reset(now, (peek self.defaults)[spec.id] ?? defaultChoice(spec, now.on)))
      self.copiedFrom = nil
    } else if (index == PLACE_ENTRY) {
      Ordaen.putAt(Bar.idOf(spec), nil)
    }
    self.menuOpen = false
  }

  // Another bar's settings copied into the picked one, at once.
  onCopy(mut self, entry: Integer, at: Integer) {
    const spec = peek self.spec
    const from = (peek self.others)[at] ?? panic("the submenu lists the other bars")
    const draft = peek self.settings.draft
    const defaults = peek self.defaults
    put(mut self.settings, spec, copied(choiceIn(draft, defaults, from), choiceIn(draft, defaults, spec), spec))
    self.copiedFrom = Bar.titleOf(from)
    self.menuOpen = false
  }

  public render(self): Template {
    return $ltml {
      <text $if={self.conflict} value={Locale.CONFLICT} />
      <text $if={Game.situation.combat} value={Locale.AFTER_COMBAT} />
      <box columns={PAGE} gap={space(.Group)}>
        <box columns={1}>
          <BarTab $for={spec of SPECS} $key={spec.id} spec={peek spec} picked={self.picked} defaults={self.defaults}
                  settings={self.settings} @pick={self.onPick} @flip={self.onFlip} />
        </box>
        <box columns={1} gap={space(.Item)}>
          <box columns={HEAD} gap={space(.Item)} yAlign={Align.Center}>
            <text value={self.title} textFont={.Title} textSize={TITLE_TEXT} textColor={INK} />
            <box width={MORE} height={MORE} xAlign={Align.Center} yAlign={Align.Center} background={Ordaen.art.ctl.button}
                 @pointerPress={self.toggleMenu} @keyPress(.Enter)={self.toggleMenu} @keyPress(.Space)={self.toggleMenu}>
              <text value={MORE_GLYPH} textColor={INK} />
              <Menu $if={self.menuOpen} title={self.title} entries={self.entries} @pick={self.onMenu}
                    @pickMore={self.onCopy} @close={self.closeMenu} />
            </box>
          </box>
          <text $if={self.fromShown} value={Locale.COPIED_FROM.format(self.copiedFrom ?? "")} textColor={DIM}
                textSize={SECONDARY_TEXT} />
          <BarEditor $for={spec of [self.spec]} $key={spec.id} spec={peek spec} settings={mut self.settings}
                     defaults={self.defaults} />
        </box>
      </box>
    }
  }
}
