// Ordaen Panel: one panel along an edge of the screen (the bottom at first), in three zones: at its start, in its
// middle and at its end. Each item (the game's menu, friends and guild, the zone's name, the time, the money, the
// bags) sits in the zone its setting names, or not on the panel. The menu's buttons and the bags are the game's own,
// standing in the panel's cells, so their clicks, menus and alerts stay the game's.
import Events from "$events"
import Game from "$game"
import { Align, Anchored, Art, Docked, Edges, Event, Frame, Layer, Overflow, Place, Point, Position, Shadow, Side, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, BarFrame, Callout, CalloutLook, CalloutSide, Component, Module, Mover, Placed, SECONDARY_TEXT, Settings, SettingsPage, XpFill, opacityNow, reachAcross, reachDown, sideNear, timeText, xpFillArt } from "Ordaen"
import { ActionBars, barDefaults, bartenderLoaded } from "@/actionBars"
import { BARS_DEFAULTS, BarChoice, BarsChoices } from "@/barChoices"
import { BarsPage } from "@/barsPage"
import { CELL_HEIGHT } from "@/cells"
import {
  CharButton, CharView, Choices, DEFAULTS, Edge, Fit, Item, MicroIcons, Outline, XpBorder, XpTexture, XpView, Zone
} from "@/choices"
import { BagLine, MicroLine, MoneyLine, SocialLine } from "@/items"
import Locale from "@/locales"
import { BottomPage, GeneralPage, MicroPage, StatusPage } from "@/settings"
import { XpBar } from "@/xpBar"

const INK: Color = Color.hex("#e8dcc4")
// The time while calendar invites wait.
const PENDING: Color = Color.hex("#ff9933")
const TEXT_SHADOW: Shadow = { color: Color.hex("#000000"), x: 1ui, y: -1ui }
const NO_SHADOW: Shadow = { color: Color.hex("#00000000"), x: 0ui, y: 0ui }
// Under the metal along its inner side the content starts 4 further in.
const EDGE_ROOM_TOP = 4ui
// The metal's width along the inner side (Ordaen's `panel.edge`).
const METAL = 3ui
// The least the panel is high: a cell, a fixed size, under the metal and the room along it. A height saved lower is
// read as this.
const LEAST_HEIGHT: Number<Length> = CELL_HEIGHT + METAL + EDGE_ROOM_TOP
// Where the free parts stand until the player moves them: above the bottom of the screen.
const MICRO_HOME: Anchored = { point: Point.BottomLeft, x: 140ui, y: -10ui }
const SOCIAL_HOME: Anchored = { point: Point.BottomLeft, x: 660ui, y: -10ui }
const EXPERIENCE_HOME: Anchored = { point: Point.Bottom, x: 0ui, y: -20ui }
const MONEY_HOME: Anchored = { point: Point.BottomRight, x: -330ui, y: -20ui }
const BAGS_HOME: Anchored = { point: Point.BottomRight, x: -10ui, y: -10ui }
// The zones along the panel. Across the whole edge, thirds; as long as its items, each zone as long as they are.
// Either way an end never gives way past its items' length, and the middle is a share that does, down to its own
// items' least (the experience bar's): on a screen too short for that the panel scrolls down a side.
const THIRDS: Array<Track> = [{ fr: 1 }, { fr: 1 }, { fr: 1 }]
const FITTED: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
// The portrait in the screen's corner, over the panel's start; the menu keeps that much room for it.
const PORTRAIT_WIDTH = 128ui
const PORTRAIT_HEIGHT = 124ui
const PORTRAIT_ROOM: Array<Track> = [PORTRAIT_WIDTH, "max-content"]
const CORNER: Anchored = { point: Point.BottomLeft }
// The talent points to spend, on a round badge (the level's, smaller) centred on the portrait's rim down its right side
// (the rim's art runs from about 112 to 128 there, its middle at 120), under the level's badge.
const TALENTS_SIZE = 20ui
const TALENTS_LEFT = 110ui
const TALENTS_TOP = 50ui
// Ordaen Spells' title, as its module gives it.
const SPELLS = "Ordaen Spells"
// Ordaen Social's title, as its module gives it.
const SOCIAL = "Ordaen Social"
// Ordaen Social's folder, by which it tells Ordaen how many whispers wait unread.
const SOCIAL_FOLDER = "OrdaenSocial"

// The whispers' bubble: a plain round dot of Ordaen's violet, in the tone of the game's whisper pink.
const WHISPERS_LOOK: CalloutLook = CalloutLook.Speech { tone: Color.hex("#8a4fd0") }
// The friends' button the whispers' bubble points at, while it shows.
function bubbleBy(shown: Boolean, button: any Frame | nil): Array<any Frame> {
  return !shown || button == nil ? [] : [button]
}
// Down a side of the screen: one column, the zones one under another.
const DOWN: Array<Track> = [{ fr: 1 }]

// The class's icon, by the class's tag as the game names it.
function classIconOf(tag: String): Art {
  match (tag) {
    "WARRIOR" => return "Interface/Icons/ClassIcon_Warrior"
    "PALADIN" => return "Interface/Icons/ClassIcon_Paladin"
    "HUNTER" => return "Interface/Icons/ClassIcon_Hunter"
    "ROGUE" => return "Interface/Icons/ClassIcon_Rogue"
    "PRIEST" => return "Interface/Icons/ClassIcon_Priest"
    "SHAMAN" => return "Interface/Icons/ClassIcon_Shaman"
    "MAGE" => return "Interface/Icons/ClassIcon_Mage"
    "WARLOCK" => return "Interface/Icons/ClassIcon_Warlock"
    else => return "Interface/Icons/ClassIcon_Druid"
  }
}

// The side of the screen an edge setting names, and the setting that names a side.
function sideOf(edge: Edge): Side {
  return match (edge) { Edge.Bottom => Side.Bottom, Edge.Top => Side.Top, Edge.Left => Side.Left, Edge.Right => Side.Right }
}

function edgeOf(side: Side): Edge {
  return match (side) { Side.Bottom => Edge.Bottom, Side.Top => Edge.Top, Side.Left => Edge.Left, Side.Right => Edge.Right }
}

// One zone of the panel: its items in their order, from the zone's start, in its middle or to its end.
public class ZoneBox implements Component {
  // Ordaen's art: its root is there before this module loads.
  derived align: Align = self.alignOf()
  derived micro: Boolean = self.panel.microIn(self.zone)
  // Friends and guild with the menu in one zone stand in the menu, before its game menu's button; elsewhere, on
  // their own.
  derived social: Boolean = self.panel.socialIn(self.zone)
  derived socialAlone: Boolean = self.social && !self.micro
  // The experience bar lies along a panel that runs across the screen: down a side there is no room for it.
  derived experience: Boolean = self.panel.experienceIn(self.zone) && !self.panel.vertical
  derived zoneName: Boolean = self.panel.zoneIn(self.zone)
  derived clock: Boolean = self.panel.clockIn(self.zone)
  derived money: Boolean = self.panel.moneyIn(self.zone)
  derived bags: Boolean = self.panel.bagsIn(self.zone)
  // One track as long as each item that sits here: columns across the screen, rows down a side of it.
  derived columns: Array<Track> = self.panel.vertical ? DOWN : self.tracks()
  derived rows: Array<Track> | nil = self.panel.vertical ? self.tracks() : nil
  derived along: Align = self.panel.vertical ? Align.Center : self.align
  derived across: Align = self.panel.vertical ? self.align : Align.Center

  const zone: Zone
  panel: Panel
  constructor(
    zone: Zone,
    panel: Panel
  ) {
    self.zone = zone
    self.panel = panel
  }

  alignOf(self): Align {
    // With the experience bar in it nothing is aligned: an aligned item keeps its content's size, and the bar
    // takes the room the others leave.
    if (self.experience) { return Align.Stretch }
    match (self.zone) {
      Zone.Left => return Align.Start
      Zone.Center => return Align.Center
      else => return Align.End
    }
  }

  tracks(self): Array<Track> {
    let list: Array<Track> = []
    for (here of [self.micro, self.socialAlone]) {
      if (here) { list.push("max-content") }
    }
    // The experience bar takes what the others leave.
    if (self.experience) { list.push({ fr: 1 }) }
    for (here of [self.zoneName, self.clock, self.money, self.bags]) {
      if (here) { list.push("max-content") }
    }
    return list
  }

  onClock(mut self) { Game.clock.toggleCalendar() }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} rows={self.rows} gap={3sp} xAlign={self.along}
           yAlign={self.across}>
        <$if={self.micro}>
          <box $if={self.panel.portraitShown} columns={PORTRAIT_ROOM} gap={3sp}
               yAlign={Align.Center}>
            <box width={PORTRAIT_WIDTH} height={1ui} />
            <MicroLine gold={self.panel.goldIcons} faced={false} social={self.social}
                       merged={self.panel.spellsMerged} guildMerged={self.panel.guildMerged} height={self.panel.inside}
                       rise={self.panel.rise} />
          </box>
          <MicroLine $else gold={self.panel.goldIcons} vertical={self.panel.vertical} social={self.social}
                     merged={self.panel.spellsMerged} guildMerged={self.panel.guildMerged} height={self.panel.inside} face={self.panel.face}
                     icon={self.panel.classIcon} rise={self.panel.rise} />
        </>
        <SocialLine $if={self.socialAlone} gold={self.panel.goldIcons} guildMerged={self.panel.guildMerged} vertical={self.panel.vertical}
                    height={self.panel.inside} rise={self.panel.rise} />
        <XpBar $if={self.experience} room={self.panel.inside} fill={self.panel.xpFill} bezel={self.panel.xpBezel}
               view={self.panel.xpView} />
        <text $if={self.zoneName} value={Game.location.zone} textColor={INK}
              textOutline={self.panel.outline} textShadow={self.panel.shadow} wrap={.None} />
        <box $if={self.clock} @pointerPress={self.onClock} @keyPress(.Enter)={self.onClock} @keyPress(.Space)={self.onClock}>
          <text value={timeText(Game.clock.now)} textColor={self.panel.clockColor}
                textOutline={self.panel.outline} textShadow={self.panel.shadow} wrap={.None} />
        </box>
        <MoneyLine $if={self.money} outline={self.panel.outline} shadow={self.panel.shadow}
                   vertical={self.panel.vertical} />
        <BagLine $if={self.bags} vertical={self.panel.vertical} height={self.panel.inside} rise={self.panel.rise} />
      </box>
    }
  }
}

// The panel's addon folder: what tells its room along the bottom edge from another part's.
const FOLDER = "OrdaenPanel"

public class Panel implements Module, App {
  public const title: String = "Ordaen Panel"

  // Ordaen's art, look and fonts: its root is there before this module loads.

  settings: mut Settings<Choices> = new Settings<Choices>(DEFAULTS)
  // The action bars' own settings, kept apart from the panel's (`OrdaenPanel:bars`).
  bars: mut Settings<BarsChoices> = new Settings<BarsChoices>(BARS_DEFAULTS, "bars")
  // Each bar's settings before the player changes them, as the character's Blizzard settings have its bars.
  const barsDefaults: Map<String, BarChoice> = barDefaults()
  // Bartender4 is loaded: the action bars stay off, and their page says why.
  const barsConflict: Boolean = bartenderLoaded()
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
    { title: Locale.TAB_MICROMENU, content: $ltml { <MicroPage settings={mut self.settings} /> } },
    { title: Locale.TAB_STATUS, content: $ltml { <StatusPage settings={mut self.settings} /> } },
    { title: Locale.TAB_BOTTOM, content: $ltml { <BottomPage settings={mut self.settings} least={LEAST_HEIGHT / 1ui} /> } },
    {
      title: Locale.TAB_BARS,
      content: $ltml { <BarsPage settings={mut self.bars} defaults={self.barsDefaults} conflict={self.barsConflict} /> }
    }
  ]

  // The cursor on the panel, on its portrait: each a surface of its own, heard apart.
  state hovered = false
  state portraitHovered = false
  // The talent points the player has to spend in the active spec: a badge on the portrait's rim while there are any.
  public state unspentTalents = 0
  derived talentsShown: Boolean = self.unspentTalents > 0

  constructor() {
    Ordaen.modules.add(self)
    // The room it keeps along the screen's bottom edge, told to Ordaen: its height and its top edge's metal, which
    // reaches over it, while it is on and stands there.
    watch {
      const taken: Number<Length> = self.settings.values.bottomOn && self.side == Side.Bottom ? self.drawnTall : 0ui
      Ordaen.keepBottom(FOLDER, taken)
    }
    // The talent points to spend: read at the start and each time the game says they changed.
    self.readTalents()
    Events.CHARACTER_POINTS_CHANGED.listen(self.onPoints)
    Events.PLAYER_TALENT_UPDATE.listen(self.readTalents)
    Events.TRAIT_CONFIG_UPDATED.listen(self.onPoints)
    Events.ACTIVE_TALENT_GROUP_CHANGED.listen(self.onGroup)
  }

  destructor() {
    Ordaen.keepBottom(FOLDER, 0ui)
  }

  // What the zones read.
  public derived goldIcons: Boolean = self.settings.values.microIcons == MicroIcons.Gold
  // The player's portrait stands in the screen's corner: asked for, with the menu at the start of a panel
  // along the bottom. The character's button is then the portrait, and the menu has no cell for it.
  public derived portraitShown: Boolean = self.settings.values.charButton == CharButton.Portrait && self.settings.values.microOn && self.settings.values.bottomOn &&
    self.side == Side.Bottom && self.at(Item.Micromenu) == Zone.Left
  // The side it stands along: its edge, or, while the player drags it in the placing mode, the side nearest the cursor.
  derived side: Side = self.docking ?? sideOf(self.settings.values.edge)
  state docking: Side | nil = nil
  // The panel runs down a side of the screen: its zones one under another, each item's cells too.
  public derived vertical: Boolean = self.side == Side.Left || self.side == Side.Right
  public derived outline: Integer = self.outlineOf()
  public derived shadow: Shadow = self.settings.values.shadow ? TEXT_SHADOW : NO_SHADOW
  public derived clockColor: Color = Game.clock.invites > 0 ? PENDING : INK

  // The items off the panel, or all of them while the panel is off: each a free part of its own, which the
  // player places in Ordaen's placing mode. (The zone's name and the time aren't: off the panel they are the
  // minimap's.)
  derived freeMicro: Boolean = self.settings.values.microOn && self.isFree(Item.Micromenu)
  derived freeSocial: Boolean = self.settings.values.microOn && self.isFree(Item.Social)
  derived freeExperience: Boolean = self.settings.values.statusOn && self.isFree(Item.Experience)
  derived freeMoney: Boolean = self.isFree(Item.Currencies)
  derived freeBags: Boolean = self.isFree(Item.Bags)

  // Hidden with nothing to see and nothing for the cursor to find: not drawn at all (shown on mouseover, it never
  // fades to nothing).
  derived drawn: Boolean = self.settings.values.bottomOn && self.opacity > 0
  derived opacity: Number = self.opacityOf()
  // The portrait shows with the panel, standing in it: over it, however often the panel shows again.
  public derived face: String | nil = self.settings.values.charView == CharView.Face ? "player" : nil
  public derived classIcon: Art | nil = self.settings.values.charView == CharView.ClassIcon ? classIconOf(Game.player.classTag) : nil
  public derived xpView: XpView = self.settings.values.xpView
  // The experience bar's fill and edge: its own choice, or the look's bar texture and frame.
  public derived xpFill: Art = self.xpFillOf()
  public derived xpBezel: Boolean = self.settings.values.xpBorder == XpBorder.Bezel ||
    self.settings.values.xpBorder == XpBorder.Theme && Ordaen.look.values.barFrame == BarFrame.Bezel
  // With Ordaen Spells on, its window holds the spellbook and the talents: one button opens it. Told among Ordaen's
  // modules by its title: a module needs no other module, so the panel doesn't import it.
  public derived spellsMerged: Boolean = Ordaen.modules.any(module => module.title == SPELLS)
  // With Ordaen Social on, its window holds the friends and the guild: the friends' button alone opens it, the guild's
  // goes (and comes back as the module is turned off).
  public derived guildMerged: Boolean = Ordaen.modules.any(module => module.title == SOCIAL)
  // The whispers Ordaen Social says wait unread: a plain violet bubble with how many, pointing at the friends' button
  // from over it (under it on a panel along the top), while any wait.
  derived unread: Integer = Ordaen.noticeOf(SOCIAL_FOLDER)
  derived whispersBy: Array<any Frame> = bubbleBy(self.settings.values.microOn && self.unread > 0,
    Game.frames.QuickJoinToastButton)
  derived whispersCount: String = "%d".format(self.unread)
  derived whispersSide: CalloutSide = self.side == Side.Top ? CalloutSide.Below : CalloutSide.Above
  derived place: Place = self.placeOf()
  // The zones: three columns across the screen, three rows down a side of it; thirds of the whole edge, or each
  // as long as its items.
  derived thirds: Array<Track> = self.settings.values.fit == Fit.Full ? THIRDS : FITTED
  derived columns: Array<Track> = self.vertical ? DOWN : self.thirds
  derived rows: Array<Track> | nil = self.vertical ? self.thirds : nil
  // How far it reaches in from its edge, and how high its inside is across the screen: under the metal and the room
  // along it.
  derived tall: Number<Length> = (self.settings.values.height * 1ui).max(LEAST_HEIGHT)
  public derived inside: Number<Length> = self.tall - METAL - EDGE_ROOM_TOP
  // The room under the metal, a measure of the art, as a padding takes it.
  derived edgeRoom: Edges = { top: Ordaen.spacingOf(EDGE_ROOM_TOP) }
  // How far its dividers reach up past its cells to meet the metal: across that room; down a side, the room is at its
  // inner edge, along the dividers, and they reach nothing.
  public derived rise: Number<Length> = self.vertical ? 0ui : EDGE_ROOM_TOP
  // How far it reaches in from its edge as drawn: its top edge's metal stands past its line, inside the box's size.
  derived drawnTall: Number<Length> = self.tall + reachDown(Ordaen.art.panel.edge)
  // The experience bar on its own: 600 at its frame's line, the art past the line on either side.
  derived freeXpWidth: Number<Length> = 600ui + reachAcross(Ordaen.art.frame.small)
  derived width: Number<Length> | nil = self.vertical ? self.tall : nil
  derived height: Number<Length> | nil = self.vertical ? nil : self.drawnTall
  derived along: Align = self.vertical ? Align.Center : Align.Stretch
  derived across: Align = self.vertical ? Align.Stretch : Align.Center
  // Down a side whose items are longer than the screen even with the middle given way: the wheel scrolls it.
  derived overflow: Overflow | nil = self.vertical ? Overflow.Scroll : nil

  outlineOf(self): Integer {
    match (self.settings.values.outline) {
      Outline.None => return 0
      Outline.Thin => return 1
      Outline.Thick => return 2
    }
  }

  xpFillOf(self): Art {
    match (self.settings.values.xpTexture) {
      XpTexture.Theme => return Ordaen.lookArt.bar
      XpTexture.Deep => return xpFillArt(XpFill.Deep)
      XpTexture.Grain => return xpFillArt(XpFill.Grain)
      XpTexture.Brushed => return xpFillArt(XpFill.Brushed)
      XpTexture.Potion => return xpFillArt(XpFill.Potion)
      XpTexture.Clouds => return xpFillArt(XpFill.Clouds)
      XpTexture.Steel => return xpFillArt(XpFill.Steel)
    }
  }

  // Where an item sits.
  at(self, item: Item): Zone {
    const places = self.settings.values.places
    match (item) {
      Item.Micromenu => return places.micromenu
      Item.Social => return places.social
      Item.Experience => return places.experience
      Item.Zone => return places.zone
      Item.Clock => return places.clock
      Item.Currencies => return places.currencies
      Item.Bags => return places.bags
    }
  }

  isFree(self, item: Item): Boolean { return !self.settings.values.bottomOn || self.at(item) == Zone.Off }

  // Whether an item sits in a zone of the panel.
  public microIn(self, zone: Zone): Boolean { return self.settings.values.microOn && self.at(Item.Micromenu) == zone }
  public socialIn(self, zone: Zone): Boolean { return self.settings.values.microOn && self.at(Item.Social) == zone }
  public experienceIn(self, zone: Zone): Boolean { return self.settings.values.statusOn && self.at(Item.Experience) == zone }
  public zoneIn(self, zone: Zone): Boolean { return self.at(Item.Zone) == zone }
  public clockIn(self, zone: Zone): Boolean { return self.at(Item.Clock) == zone }
  public moneyIn(self, zone: Zone): Boolean { return self.at(Item.Currencies) == zone }
  public bagsIn(self, zone: Zone): Boolean { return self.at(Item.Bags) == zone }

  // How visible it is now, by its visibility in the state the player is in, the cursor on it or on its portrait. In
  // the placing mode it shows, to be taken to another side.
  opacityOf(self): Number {
    if (Ordaen.placing) { return 1 }
    return opacityNow(self.settings.values.visibility, self.hovered || self.portraitHovered)
  }

  placeOf(self): Docked {
    return { side: self.side, whole: self.settings.values.fit == Fit.Full }
  }

  // Dragged in the placing mode, it stands along the side nearest the cursor; let go, that side is its edge from
  // then, as if chosen on its page. Right-clicked, it goes back to the edge it starts at.
  onDock(mut self, drag: Event.Drag) { self.docking = sideNear(drag) }

  onDocked(mut self) {
    const side = peek self.docking
    self.docking = nil
    if (side != nil) { self.putOn(edgeOf(side)) }
  }

  onUndock(mut self) { self.putOn(self.settings.defaults.edge) }

  putOn(mut self, edge: Edge) {
    self.settings.change((values: mut Choices) => { values.edge = edge })
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }
  readTalents(mut self) { self.unspentTalents = Game.talentTrees.unspent(Game.talentTrees.activeGroup()) }
  onPoints(mut self, changed: Number) { self.readTalents() }
  onGroup(mut self, now: Number, before: Number) { self.readTalents() }

  onPortraitEnter(mut self) { self.portraitHovered = true }
  onPortraitLeave(mut self) { self.portraitHovered = false }

  public render(self): Template {
    return $ltml {
      // What the panel takes the place of, for as long as it runs. The menu's box is unseen, not hidden: the game
      // lays its buttons out by their places, which a hidden box doesn't have.
      <$if={self.settings.values.microOn}>
        <frame of={Game.frames.MicroMenuContainer} opacity={0} />
        <box width={0ui} height={0ui}>
          <embed frame={Game.frames.StoreMicroButton} width={0ui} height={0ui} opacity={0} />
          <embed frame={Game.frames.HelpMicroButton} width={0ui} height={0ui} opacity={0} />
        </box>
      </>
      <$if={self.settings.values.statusOn}>
        <frame of={Game.frames.MainStatusTrackingBarContainer} shown={false} />
        <frame of={Game.frames.SecondaryStatusTrackingBarContainer} shown={false} />
      </>
      <ActionBars $if={!self.barsConflict} values={self.bars.values} defaults={self.barsDefaults} />
      <frame of={Game.frames.BagsBar} shown={false} />
      <frame of={Game.frames.BackpackFreeSlots} shown={false} />

      <surface leading={.Row} $if={self.drawn} layer={Layer.Screen} place={self.place} width={self.width} height={self.height}
               background={Ordaen.art.panel.wood} border={Ordaen.art.panel.edge} padding={self.edgeRoom}
               columns={self.columns} rows={self.rows} xAlign={self.along} yAlign={self.across}
               opacity={self.opacity} overflow={self.overflow}
               @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <ZoneBox zone={Zone.Left} panel={self} />
        <ZoneBox zone={Zone.Center} panel={self} />
        <ZoneBox zone={Zone.Right} panel={self} />
        <Mover id={"OrdaenPanel.panel"} title={Locale.TAB_BOTTOM} @drag={self.onDock} @drop={self.onDocked}
               @reset={self.onUndock} />
        // The portrait: the player's face (or the class's icon) in the corner's shape, the level on a badge on its
        // rim, and the character's button of the game's unseen over all of it. Part of the panel: as faint as it, and
        // standing in it, so it comes over the panel each time the panel shows again.
        <surface leading={.Row} $if={self.portraitShown} layer={Layer.Screen} place={CORNER} width={PORTRAIT_WIDTH}
                 height={PORTRAIT_HEIGHT} portrait={self.face} icon={self.classIcon} mask={Ordaen.art.panel.corner}
                 opacity={self.opacity} @pointerEnter={self.onPortraitEnter} @pointerLeave={self.onPortraitLeave}>
          <embed frame={Game.frames.CharacterMicroButton} position={Position.Absolute} left={0ui} top={0ui}
                 width={PORTRAIT_WIDTH} height={PORTRAIT_HEIGHT} opacity={0} />
          // The rim along the top and down the right, over the face: drawn over the box its shape is cut to.
          <box position={Position.Absolute} left={0ui} top={0ui} width={PORTRAIT_WIDTH} height={PORTRAIT_HEIGHT}
               background={Ordaen.art.panel.cornerRim} />
          <box position={Position.Absolute} left={86.7ui} top={5.3ui} width={36ui} height={36ui}
               background={Ordaen.art.panel.badge} xAlign={Align.Center} yAlign={Align.Center} zLevel={1}>
            <text value={"%d"} arguments={[Game.player.level]} textColor={Ordaen.look.values.accent}
                  wrap={.None} />
          </box>
          <box $if={self.talentsShown} position={Position.Absolute} left={TALENTS_LEFT} top={TALENTS_TOP}
               width={TALENTS_SIZE} height={TALENTS_SIZE} background={Ordaen.art.panel.badge} xAlign={Align.Center}
               yAlign={Align.Center} zLevel={1}>
            <text value={"%d"} arguments={[self.unspentTalents]} textSize={SECONDARY_TEXT} textColor={BRIGHT_TEXT}
                  textFont={.Numbers} wrap={.None} />
          </box>
          // The panel's corner: in the placing mode it takes the panel to another side too. It shows only while the
          // panel is at the bottom, where a right click would put it: it hears none.
          <Mover id={"OrdaenPanel.panel"} title={Locale.TAB_BOTTOM} @drag={self.onDock} @drop={self.onDocked} />
        </surface>
      </surface>

      <Callout $for={by of self.whispersBy} by={by} title={self.whispersCount} side={self.whispersSide}
               look={WHISPERS_LOOK} pulse={true} />
      <Placed $if={self.freeMicro} id={"OrdaenPanel.micromenu"} title={Locale.PANEL_MICROMENU} home={MICRO_HOME}>
        <box background={Ordaen.art.window.wood} border={Ordaen.art.frame.small} padding={3sp}>
          <MicroLine gold={self.goldIcons} merged={self.spellsMerged} guildMerged={self.guildMerged} face={self.face} icon={self.classIcon} />
        </box>
      </Placed>
      <Placed $if={self.freeSocial} id={"OrdaenPanel.social"} title={Locale.PANEL_SOCIAL} home={SOCIAL_HOME}>
        <box background={Ordaen.art.window.wood} border={Ordaen.art.frame.small} padding={3sp}>
          <SocialLine gold={self.goldIcons} guildMerged={self.guildMerged} />
        </box>
      </Placed>
      <Placed $if={self.freeExperience} id={"OrdaenPanel.experience"} title={Locale.PANEL_EXPERIENCE}
              home={EXPERIENCE_HOME}>
        <box width={self.freeXpWidth} background={Ordaen.art.window.wood} border={Ordaen.art.frame.small}
             padding={3sp}>
          <XpBar fill={self.xpFill} bezel={self.xpBezel} view={self.xpView} />
        </box>
      </Placed>
      <Placed $if={self.freeMoney} id={"OrdaenPanel.currencies"} title={Locale.PANEL_CURRENCIES}
              home={MONEY_HOME}>
        <box background={Ordaen.art.window.wood} border={Ordaen.art.frame.small} padding={3sp}>
          <MoneyLine outline={self.outline} shadow={self.shadow} />
        </box>
      </Placed>
      <Placed $if={self.freeBags} id={"OrdaenPanel.bags"} title={Locale.PANEL_BAGS} home={BAGS_HOME}>
        <box background={Ordaen.art.window.wood} border={Ordaen.art.frame.small} padding={3sp}>
          <BagLine />
        </box>
      </Placed>
    }
  }
}
