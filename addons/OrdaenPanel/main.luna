// Ordaen Panel: one panel along an edge of the screen (the bottom at first), in three zones: at its start, in its
// middle and at its end. Each item (the game's menu, friends and guild, the zone's name, the time, the money, the
// bags) sits in the zone its setting names, or not on the panel. The menu's buttons and the bags are the game's own,
// standing in the panel's cells, so their clicks, menus and alerts stay the game's.
import Game from "$game"
import { Align, Anchored, Docked, Edges, Layer, Place, Point, Position, Shadow, Side, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, Module, Placed, Settings, SettingsPage } from "Ordaen"
import Locale from "@/locales"
import { BagLine, MicroLine, MoneyLine, SocialLine } from "@/items"
import { CharButton, Choices, Combat, DEFAULTS, Edge, Fit, Item, MicroIcons, Outline, Show, Zone } from "@/choices"
import { BottomPage, GeneralPage, MicroPage, StatusPage } from "@/settings"
import { XpBar } from "@/xpBar"

const INK: Color = Color.hex("#e8dcc4")
// The time while calendar invites wait.
const PENDING: Color = Color.hex("#ff9933")
const TEXT_SHADOW: Shadow = { color: Color.hex("#000000"), x: 1, y: -1 }
const NO_SHADOW: Shadow = { color: Color.hex("#00000000"), x: 0, y: 0 }
// Under the metal along its inner side the content starts 4 further in.
const EDGE_ROOM: Edges = { top: 4 }
// A panel shown on mouseover, hidden: unseen, yet under the cursor.
const MOUSEOVER_LEAST = 1 / 255
// Where the free parts stand until the player moves them: above the bottom of the screen.
const MICRO_HOME: Anchored = { point: Point.BottomLeft, x: 140, y: -10 }
const SOCIAL_HOME: Anchored = { point: Point.BottomLeft, x: 660, y: -10 }
const EXPERIENCE_HOME: Anchored = { point: Point.Bottom, x: 0, y: -20 }
const MONEY_HOME: Anchored = { point: Point.BottomRight, x: -330, y: -20 }
const BAGS_HOME: Anchored = { point: Point.BottomRight, x: -10, y: -10 }
const THIRDS: Array<Track> = [{ fr: 1 }, { fr: 1 }, { fr: 1 }]
const FITTED: Array<Track> = ["auto", "auto", "auto"]
// The portrait in the screen's corner, over the panel's start; the menu keeps that much room for it.
const PORTRAIT_WIDTH = 128
const PORTRAIT_HEIGHT = 124
const PORTRAIT_ROOM: Array<Track> = [PORTRAIT_WIDTH, "auto"]
const CORNER: Anchored = { point: Point.BottomLeft }
// Down a side of the screen: one column, the zones one under another.
const DOWN: Array<Track> = [{ fr: 1 }]

// One zone of the panel: its items in their order, from the zone's start, in its middle or to its end.
public class ZoneBox implements Component {
  // Ordaen's art: its root is there before this module loads.
  derived align: Align = self.alignOf()
  derived micro: Boolean = self.panel.microIn(self.zone)
  derived social: Boolean = self.panel.socialIn(self.zone)
  // The experience bar lies along a panel that runs across the screen: down a side there is no room for it.
  derived experience: Boolean = self.panel.experienceIn(self.zone) && !self.panel.vertical
  derived zoneName: Boolean = self.panel.zoneIn(self.zone)
  derived clock: Boolean = self.panel.clockIn(self.zone)
  derived money: Boolean = self.panel.moneyIn(self.zone)
  derived bags: Boolean = self.panel.bagsIn(self.zone)
  // One track as long as each item that sits here: columns across the screen, rows down a side of it.
  derived columns: Array<Track> = self.panel.vertical ? DOWN : self.tracks()
  derived rows: Array<Track> | nil = self.panel.vertical ? self.tracks() : nil
  derived along: Align = self.panel.vertical ? Align.Center : self.align
  derived across: Align = self.panel.vertical ? self.align : Align.Center

  const zone: Zone
  panel: Panel
  constructor(
    zone: Zone,
    panel: Panel,
  ) {
    self.zone = zone
    self.panel = panel
  }

  alignOf(self): Align {
    // With the experience bar in it nothing is aligned: an aligned item keeps its content's size, and the bar
    // takes the room the others leave.
    if (self.experience) { return Align.Stretch }
    match (self.zone) {
      Zone.Left => return Align.Start,
      Zone.Center => return Align.Center,
      else => return Align.End,
    }
  }

  tracks(self): Array<Track> {
    let list: Array<Track> = []
    for (here of [self.micro, self.social]) {
      if (here) { list.push("auto") }
    }
    // The experience bar takes what the others leave.
    if (self.experience) { list.push({ fr: 1 }) }
    for (here of [self.zoneName, self.clock, self.money, self.bags]) {
      if (here) { list.push("auto") }
    }
    return list
  }

  onClock(mut self) { Game.clock.toggleCalendar() }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} rows={self.rows} gap={Ordaen.art.spacing.md} xAlign={self.along}
           yAlign={self.across}>
        <$if={self.micro}>
          <box $if={self.panel.portraitShown} columns={PORTRAIT_ROOM} gap={Ordaen.art.spacing.md}
               yAlign={Align.Center}>
            <box width={PORTRAIT_WIDTH} height={1} />
            <MicroLine gold={self.panel.goldIcons} faced={false} />
          </box>
          <MicroLine $else gold={self.panel.goldIcons} vertical={self.panel.vertical} />
        </>
        <SocialLine $if={self.social} gold={self.panel.goldIcons} vertical={self.panel.vertical} />
        <XpBar $if={self.experience} />
        <text $if={self.zoneName} value={Game.location.zone} textColor={INK}
              textOutline={self.panel.outline} textShadow={self.panel.shadow} wrap={false} />
        <box $if={self.clock} @click={self.onClock}>
          <text value={Game.clock.text} textColor={self.panel.clockColor}
                textOutline={self.panel.outline} textShadow={self.panel.shadow} wrap={false} />
        </box>
        <MoneyLine $if={self.money} outline={self.panel.outline} shadow={self.panel.shadow}
                   vertical={self.panel.vertical} />
        <BagLine $if={self.bags} vertical={self.panel.vertical} />
      </box>
    }
  }
}

public class Panel implements Module, App {
  public const title: String = "Ordaen Panel"

  // Ordaen's art, look and fonts: its root is there before this module loads.

  settings: mut Settings<Choices> = new Settings<Choices>(DEFAULTS)
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
    { title: Locale.TAB_MICROMENU, content: $ltml { <MicroPage settings={mut self.settings} /> } },
    { title: Locale.TAB_STATUS, content: $ltml { <StatusPage settings={mut self.settings} /> } },
    { title: Locale.TAB_BOTTOM, content: $ltml { <BottomPage settings={mut self.settings} /> } },
  ]

  state hovered = false

  constructor() {
    Ordaen.modules.add(self)
  }

  // What the zones read.
  public derived goldIcons: Boolean = self.settings.values.microIcons == MicroIcons.Gold
  // The player's portrait stands in the screen's corner: asked for, with the menu at the start of a panel
  // along the bottom. The character's button is then the portrait, and the menu has no cell for it.
  public derived portraitShown: Boolean = self.settings.values.charButton == CharButton.Portrait && self.settings.values.microOn && self.settings.values.bottomOn
    && self.settings.values.edge == Edge.Bottom && self.at(Item.Micromenu) == Zone.Left
  // The panel runs down a side of the screen: its zones one under another, each item's cells too.
  public derived vertical: Boolean = self.settings.values.edge == Edge.Left || self.settings.values.edge == Edge.Right
  public derived outline: Integer = self.outlineOf()
  public derived shadow: Shadow = self.settings.values.shadow ? TEXT_SHADOW : NO_SHADOW
  public derived clockColor: Color = Game.clock.invites > 0 ? PENDING : INK

  // The items off the panel, or all of them while the panel is off: each a free part of its own, which the
  // player places in Ordaen's placing mode. (The zone's name and the time aren't: off the panel they are the
  // minimap's.)
  derived freeMicro: Boolean = self.settings.values.microOn && self.isFree(Item.Micromenu)
  derived freeSocial: Boolean = self.settings.values.microOn && self.isFree(Item.Social)
  derived freeExperience: Boolean = self.settings.values.statusOn && self.isFree(Item.Experience)
  derived freeMoney: Boolean = self.isFree(Item.Currencies)
  derived freeBags: Boolean = self.isFree(Item.Bags)

  derived hidden: Boolean = self.hiddenNow()
  // The portrait shows with the panel.
  derived cornered: Boolean = self.portraitShown && self.drawn
  // Hidden with nothing to see and nothing for the cursor to find: not drawn at all.
  derived drawn: Boolean = self.settings.values.bottomOn && !(self.hidden && self.settings.values.fadedAlpha <= 0 && self.settings.values.show != Show.Mouseover)
  derived opacity: Number = self.opacityOf()
  derived place: Place = self.placeOf()
  // The zones: three columns across the screen, three rows down a side of it; thirds of the whole edge, or each
  // as long as its items.
  derived thirds: Array<Track> = self.settings.values.fit == Fit.Full ? THIRDS : FITTED
  derived columns: Array<Track> = self.vertical ? DOWN : self.thirds
  derived rows: Array<Track> | nil = self.vertical ? self.thirds : nil
  // How far it reaches in from its edge.
  derived width: Number | nil = self.vertical ? self.settings.values.height : nil
  derived height: Number | nil = self.vertical ? nil : self.settings.values.height
  derived along: Align = self.vertical ? Align.Center : Align.Stretch
  derived across: Align = self.vertical ? Align.Stretch : Align.Center

  outlineOf(self): Integer {
    match (self.settings.values.outline) {
      Outline.None => return 0,
      Outline.Thin => return 1,
      Outline.Thick => return 2,
    }
  }

  // Where an item sits.
  at(self, item: Item): Zone { return self.settings.values.places[item] ?? Zone.Off }

  isFree(self, item: Item): Boolean { return !self.settings.values.bottomOn || self.at(item) == Zone.Off }

  // Whether an item sits in a zone of the panel.
  public microIn(self, zone: Zone): Boolean { return self.settings.values.microOn && self.at(Item.Micromenu) == zone }
  public socialIn(self, zone: Zone): Boolean { return self.settings.values.microOn && self.at(Item.Social) == zone }
  public experienceIn(self, zone: Zone): Boolean { return self.settings.values.statusOn && self.at(Item.Experience) == zone }
  public zoneIn(self, zone: Zone): Boolean { return self.at(Item.Zone) == zone }
  public clockIn(self, zone: Zone): Boolean { return self.at(Item.Clock) == zone }
  public moneyIn(self, zone: Zone): Boolean { return self.at(Item.Currencies) == zone }
  public bagsIn(self, zone: Zone): Boolean { return self.at(Item.Bags) == zone }

  // Whether the panel is hidden now: never shown, or only while the cursor is on it, or by combat, a vehicle, a
  // pet battle or resting.
  hiddenNow(self): Boolean {
    if (self.settings.values.show == Show.Never) { return true }
    let fighting = Game.situation.combat
    if (self.settings.values.combat == Combat.Hide && fighting) { return true }
    if (self.settings.values.combat == Combat.Only && !fighting) { return true }
    if (self.settings.values.vehicle && Game.situation.vehicle) { return true }
    if (self.settings.values.petBattle && Game.situation.petBattle) { return true }
    if (self.settings.values.resting && Game.situation.resting) { return true }
    return self.settings.values.show == Show.Mouseover && !self.hovered
  }

  // Hidden, it is faded to its opacity. Shown on mouseover, a hidden panel stays drawn at the least opacity the
  // cursor still finds.
  opacityOf(self): Number {
    if (!self.hidden) { return 1 }
    if (self.settings.values.show == Show.Mouseover) { return self.settings.values.fadedAlpha.max(MOUSEOVER_LEAST) }
    return self.settings.values.fadedAlpha
  }

  placeOf(self): Docked {
    let whole = self.settings.values.fit == Fit.Full
    match (self.settings.values.edge) {
      Edge.Bottom => return { side: Side.Bottom, whole: whole },
      Edge.Top => return { side: Side.Top, whole: whole },
      Edge.Left => return { side: Side.Left, whole: whole },
      Edge.Right => return { side: Side.Right, whole: whole },
    }
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      // What the panel takes the place of, for as long as it runs. The menu's box is unseen, not hidden: the game
      // lays its buttons out by their places, which a hidden box doesn't have.
      <$if={self.settings.values.microOn}>
        <frame of={Game.frames.MicroMenuContainer} opacity={0} />
        <box width={0} height={0}>
          <embed frame={Game.frames.StoreMicroButton} width={0} height={0} opacity={0} />
          <embed frame={Game.frames.HelpMicroButton} width={0} height={0} opacity={0} />
        </box>
      </>
      <$if={self.settings.values.statusOn}>
        <frame of={Game.frames.MainStatusTrackingBarContainer} shown={false} />
        <frame of={Game.frames.SecondaryStatusTrackingBarContainer} shown={false} />
      </>
      <frame of={Game.frames.BagsBar} shown={false} />
      <frame of={Game.frames.BackpackFreeSlots} shown={false} />

      <surface $if={self.drawn} layer={Layer.Screen} place={self.place} width={self.width} height={self.height}
               background={Ordaen.art.panel.wood} border={Ordaen.art.panel.edge} padding={EDGE_ROOM}
               columns={self.columns} rows={self.rows} xAlign={self.along} yAlign={self.across}
               opacity={self.opacity} hoverWithin={true} textFamily={Ordaen.lookArt.font}
               @enter={self.onEnter} @leave={self.onLeave}>
        <ZoneBox zone={Zone.Left} panel={self} />
        <ZoneBox zone={Zone.Center} panel={self} />
        <ZoneBox zone={Zone.Right} panel={self} />
      </surface>
      // The portrait: the player's face in the corner's shape, the level on a badge on its rim, and the
      // character's button of the game's unseen over all of it.
      <surface $if={self.cornered} layer={Layer.Screen} place={CORNER} width={PORTRAIT_WIDTH}
               height={PORTRAIT_HEIGHT} portrait={"player"} mask={Ordaen.art.panel.corner}
               textFamily={Ordaen.lookArt.font}>
        <embed frame={Game.frames.CharacterMicroButton} position={Position.Absolute} left={0} top={0}
               width={PORTRAIT_WIDTH} height={PORTRAIT_HEIGHT} opacity={0} />
        <box position={Position.Absolute} left={86.7} top={5.3} width={36} height={36}
             background={Ordaen.art.panel.badge} xAlign={Align.Center} yAlign={Align.Center}>
          <text value={"%d"} arguments={[Game.player.level]} textColor={Ordaen.look.values.accent}
                wrap={false} />
        </box>
      </surface>

      <Placed $if={self.freeMicro} id={"OrdaenPanel.micromenu"} title={Locale.PANEL_MICROMENU} home={MICRO_HOME}>
        <box background={Ordaen.art.window.wood} border={Ordaen.art.frame.small} padding={Ordaen.art.spacing.sm}>
          <MicroLine gold={self.goldIcons} />
        </box>
      </Placed>
      <Placed $if={self.freeSocial} id={"OrdaenPanel.social"} title={Locale.PANEL_SOCIAL} home={SOCIAL_HOME}>
        <box background={Ordaen.art.window.wood} border={Ordaen.art.frame.small} padding={Ordaen.art.spacing.sm}>
          <SocialLine gold={self.goldIcons} />
        </box>
      </Placed>
      <Placed $if={self.freeExperience} id={"OrdaenPanel.experience"} title={Locale.PANEL_EXPERIENCE}
              home={EXPERIENCE_HOME}>
        <box width={600} background={Ordaen.art.window.wood} border={Ordaen.art.frame.small}
             padding={Ordaen.art.spacing.sm}>
          <XpBar both={true} />
        </box>
      </Placed>
      <Placed $if={self.freeMoney} id={"OrdaenPanel.currencies"} title={Locale.PANEL_CURRENCIES}
              home={MONEY_HOME}>
        <box background={Ordaen.art.window.wood} border={Ordaen.art.frame.small} padding={Ordaen.art.spacing.sm}>
          <MoneyLine outline={self.outline} shadow={self.shadow} />
        </box>
      </Placed>
      <Placed $if={self.freeBags} id={"OrdaenPanel.bags"} title={Locale.PANEL_BAGS} home={BAGS_HOME}>
        <box background={Ordaen.art.window.wood} border={Ordaen.art.frame.small} padding={Ordaen.art.spacing.sm}>
          <BagLine />
        </box>
      </Placed>
    }
  }
}
