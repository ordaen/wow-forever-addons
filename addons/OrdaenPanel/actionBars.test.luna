import Client from "$client"
import Events from "$events"
import Game from "$game"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import { ALWAYS, BRIGHT_TEXT, Settings, Visibility, Visible } from "Ordaen"
import { ActionBars, Shown, barDefaults } from "@/actionBars"
import { Bar, buttonName } from "@/bar"
import { BARS_DEFAULTS, BarChoice, BarsChoices, SPECS, defaultChoice } from "@/barChoices"

const SCREEN: Test.Page = { left: 0, top: 0, width: 1600, height: 900 }
// The stand-in's icon of the player's first form.
const FIRST_FORM: FileId = 130001
const SECOND_FORM: FileId = 130002
// The stand-in's icon of the pet's spell, fourth on its bar.
const PET_SPELL: FileId = 131004

// Whether a part stands where the client's button does.
function near(part: Test.Part, frame: any Client.Frame): Boolean {
  const rect = part.rect()
  const at = Test.centre(frame)
  return ((rect.left + rect.right) / 2 - at.x).abs() < 0.001 && ((rect.top + rect.bottom) / 2 - at.y).abs() < 0.001
}

// Whether the button is the one lit.
function lit(frame: any Client.Frame): Boolean {
  return near(Test.page().box(Ordaen.art.ctl.qualityRim), frame)
}

// What the bars are handed by the panel: their settings (a test's own, kept nowhere) and their defaults as the
// character's settings have them now; and what a bar alone is handed.
class Holder {
  public settings: mut Settings<BarsChoices> = new Settings<BarsChoices>(BARS_DEFAULTS)
  public state defaults: Map<String, BarChoice> = barDefaults()
  public state keys: Map<String, String> = {}
  public state choices: Map<String, BarChoice> = {}
  public state paging: String = "1"
  public state forms: Integer = 0
  public state below: Number<Length> = 0ui
}

// Shown out of a fight, hidden in one.
const PEACEFUL: Visibility = { combat: { visible: Visible.Hide, opacity: 0 }, ..ALWAYS }

// One of the game's bars, shown or hidden.
function gameBar(name: String, shown: Boolean): any Client.Frame {
  const made = Client.CreateFrame("Frame", name, Client.UIParent, nil)
  if (!shown) { made.Hide() }
  return made
}

// The client's frame of that name made last, from `at` on.
function lastNamed(name: String, at: any Client.Frame | nil, found: any Client.Frame | nil): any Client.Frame | nil {
  if (at == nil) { return found }
  return lastNamed(name, Client.EnumerateFrames(at), at.GetName() == name ? at : found)
}

// The client's button of a bar, by its name.
function button(id: String, index: Integer): any Client.Frame {
  const name = buttonName(id, index)
  return lastNamed(name, Client.EnumerateFrames(nil), nil) ?? panic(`the panel made ${name}`)
}

// The panel Ordaen started at login is turned off: the test's own bars are the only ones, made after what the test
// set.
function alone() {
  const running = (peek Ordaen.modules).find(module => module.title == "Ordaen Panel")
  if (running != nil) {
    const addon = Runtime.Addon.of(running) ?? panic("Ordaen's module is an addon's root")
    Ordaen.turn(addon, false)
    Test.flush()
  }
}

// The ids of the bars drawn, in their order.
function drawn(bars: Array<Shown>): String {
  return bars.map(shown => shown.spec.id).join(",")
}

// A bar's settings with one change.
function changed(values: BarsChoices, id: String, change: (choice: mut BarChoice) => nil): BarChoice {
  const spec = SPECS.find(spec => spec.id == id) ?? panic("a bar of the panel's")
  const choice = (values.bars[id] ?? defaultChoice(spec, true)).clone()
  change(mut choice)
  return choice
}

test "the bars drawn are Панель 1, those the character's settings show and the pet's, and the game's are put away" {
  alone()
  const holder = new Holder()
  const main = gameBar("MainActionBar", true)
  const bottomLeft = gameBar("MultiBarBottomLeft", true)
  Game.frames.MainActionBar = main
  Game.frames.MultiBarBottomLeft = bottomLeft
  const bars = new ActionBars(holder.settings.values, holder.defaults)
  Test.mount(bars, SCREEN)
  Test.flush()
  // The stand-in's new character shows the two bottom bars, and has no forms.
  Test.expect(drawn(bars.bars) == "1,2,3,pet")
  Test.expect(!main.IsVisible())
  // The client shows its bars again (entering the world, their toggles): they stay unseen.
  bottomLeft.Show()
  Test.flush()
  Test.expect(!bottomLeft.IsVisible())
}

test "made in a fight, the bars are drawn as the fight ends" {
  alone()
  const holder = new Holder()
  Test.combat(true)
  const bars = new ActionBars(holder.settings.values, holder.defaults)
  Test.mount(bars, SCREEN)
  Test.flush()
  Test.expect(drawn(bars.bars) == "")
  Test.combat(false)
  Test.flush()
  Test.expect(bars.ready)
  Test.expect(drawn(bars.bars) == "1,2,3,pet")
}

test "a key of the game's bindings presses our button in its place, and the button shows its key" {
  alone()
  const holder = new Holder()
  _ = Client.SetBinding("SHIFT-2", "MULTIACTIONBAR1BUTTON2", nil)
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  Test.expect(Test.page().text("S2").shown())
  // Each bar's buttons stand on its own slots: Панель 2's second is slot 62.
  Test.expect(Test.keyBound("SHIFT-2"))
  Test.expect(Test.performed().join(", ") == "action 62")
  // The player binds another key: the buttons follow.
  _ = Client.SetBinding("Q", "MULTIACTIONBAR1BUTTON3", nil)
  Events.UPDATE_BINDINGS.emit()
  Test.expect(Test.keyBound("Q"))
  Test.expect(Test.page().text("Q").shown())
  Test.expect(Test.performed().join(", ") == "action 63")
}

test "an item the cursor holds goes onto the bar's button it is let go on, or clicked on, as on the game's bars" {
  alone()
  const holder = new Holder()
  Client.C_Container.GetContainerItemInfo = (bag: Integer, slot: Integer): Client.ContainerItemInfo | nil => bag == 0 ?
    Client.ContainerItemInfo {
      iconFileID: 134829, stackCount: 5, isLocked: false, quality: .Common, isReadable: false, hasLoot: false,
      hyperlink: `item:${117 + slot}`, isFiltered: false, hasNoValue: false, itemID: 117 + slot, isBound: false,
      itemName: "Minor Healing Potion"
    } :
    nil
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  // A slot of a bag dragged: the item on the cursor, let go on Панель 2's first button (slot 61).
  const bag = Client.CreateFrame("Button", nil, Client.UIParent, nil)
  bag.SetSize(40, 40)
  bag.SetPoint("TOPLEFT", Client.UIParent, "TOPLEFT", 20, -20)
  bag.RegisterForDrag("LeftButton")
  _ = bag.HookScript("OnDragStart", (): nil => Client.C_Container.PickupContainerItem(0, 1))
  Test.moveTo(Test.centre(bag))
  Test.press(nil)
  Test.moveTo(Test.centre(button("2", 1)))
  Test.release(nil)
  const kind, id, _ = Client.GetActionInfo(61)
  Test.expect(kind == "item" && id == 118 && !Client.CursorHasItem())
  // Picked up by a click and clicked onto the second button: no action done, the item placed.
  Client.C_Container.PickupContainerItem(0, 2)
  _ = Test.performed()
  Test.click(Test.centre(button("2", 2)), nil)
  const secondKind, second, _ = Client.GetActionInfo(62)
  Test.expect(secondKind == "item" && second == 119 && !Client.CursorHasItem() && Test.performed().length == 0)
}

test "an action out of range has its icon darkened and its key in red" {
  alone()
  const holder = new Holder()
  _ = Client.SetBinding("SHIFT-2", "MULTIACTIONBAR1BUTTON2", nil)
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  Test.expect(Test.page().text("S2").textColor().equal(BRIGHT_TEXT))
  // Panel 2's second button shows slot 62: it goes out of range, and comes back.
  Test.event("ACTION_RANGE_CHECK_UPDATE", 62, false, true)
  Test.flush()
  Test.expect(Test.page().text("S2").textColor().equal(Color.hex("#ff2020")))
  Test.expect(Test.page().box(Color.hex("#000000")).opacity() == 0.6)
  Test.event("ACTION_RANGE_CHECK_UPDATE", 62, true, true)
  Test.flush()
  Test.expect(Test.page().text("S2").textColor().equal(BRIGHT_TEXT))
  Test.expect(!Test.page().box(Color.hex("#000000")).shown())
}

test "a button's tooltip is given its key as the button shows it, among the tooltips' hotkeys" {
  alone()
  const holder = new Holder()
  _ = Client.SetBinding("SHIFT-2", "MULTIACTIONBAR1BUTTON2", nil)
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  const given: Array<String> = []
  for (row of Ordaen.hotkeys) {
    for (key of row.keys(buttonName("2", 2))) { given.push(key) }
  }
  Test.expect(given.join(" | ") == "S2: use")
}

test "a button the client hides has its key hidden with it, and shown again with it" {
  alone()
  const holder = new Holder()
  _ = Client.SetBinding("F9", "ACTIONBUTTON3", nil)
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  const third = button("1", 3)
  Test.expect(Test.page().text("F9").shown())
  third.Hide()
  Test.flush()
  Test.expect(!Test.page().text("F9").shown())
  third.Show()
  Test.flush()
  Test.expect(Test.page().text("F9").shown())
}

test "a stance's button draws its form's icon, and no more buttons than the player's forms" {
  Test.forms(2)
  alone()
  const holder = new Holder()
  const bars = new ActionBars(holder.settings.values, holder.defaults)
  Test.mount(bars, SCREEN)
  Test.flush()
  Test.expect(drawn(bars.bars) == "1,2,3,pet,stance")
  const icon = Test.page().box(FIRST_FORM)
  Test.expect(icon.shown())
  const at = Test.centre(button("stance", 1))
  const rect = icon.rect()
  Test.expect((rect.left + rect.right) / 2 == at.x && (rect.top + rect.bottom) / 2 == at.y)
  Test.expect(button("stance", 2).IsVisible() && !button("stance", 3).IsVisible())
  Test.forms(0)
}

test "the client's stance and pet buttons are unseen under ours, which stand as close as the gap says; an action's seen" {
  Test.forms(2)
  alone()
  const holder = new Holder()
  holder.settings.change((values: mut BarsChoices): nil => {
    values.bars["stance"] = changed(values, "stance", (choice: mut BarChoice): nil => {
      choice.spacing = 0
      choice.size = 35
    })
  })
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.pet(true)
  Events.PET_BAR_UPDATE.emit()
  Test.flush()
  Test.expect(button("stance", 1).GetAlpha() == 0 && button("stance", 2).GetAlpha() == 0)
  Test.expect(button("pet", 1).GetAlpha() == 0)
  Test.expect(button("1", 1).GetAlpha() == 1)
  // Gap 0: the second form's icon begins where the first's ends.
  const first = Test.page().box(FIRST_FORM).rect()
  const second = Test.page().box(SECOND_FORM).rect()
  Test.expect(second.left - first.right == 0 && first.right - first.left == 35)
  Test.pet(false)
  Test.forms(0)
}

// The client's button of a bar as an action button: what the client's own code keeps on it.
function actionButton(id: String, index: Integer): any Client.ActionButton {
  const frame = button(id, index)
  return frame is Client.ActionButton ? frame : panic("a bar's button is an action button")
}

test "a stance's button takes its form by its spell, clicked and by the game's stance key" {
  Test.forms(2)
  alone()
  _ = Client.SetBinding("F1", "SHAPESHIFTBUTTON2", nil)
  const holder = new Holder()
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  _ = Test.performed()
  // Clicked as a key does, on the press's down half: the client's default (ActionButtonUseKeyDown).
  actionButton("stance", 1).Click("LeftButton", true)
  // The stand-in's form at a place casts the spell of that number.
  Test.expect(Test.performed().join(", ") == "spell 1")
  Test.expect(Test.keyBound("F1"))
  Test.expect(Test.performed().join(", ") == "spell 2")
  Test.expect(Test.page().text("F1").shown())
  Test.forms(0)
}

test "a form's cooldown sweeps over its button, and a form that can't be taken is dimmed" {
  Test.forms(2)
  alone()
  const holder = new Holder()
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  Test.formCooldown(1, 10, 30)
  Events.UPDATE_SHAPESHIFT_COOLDOWN.emit()
  Test.flush()
  const first = actionButton("stance", 1)
  let start, duration = first.cooldown.GetCooldownTimes()
  Test.expect(start == 10000 && duration == 30000)
  // Seen: drawn over the face, not in the client's unseen button.
  Test.expect(first.cooldown.GetParent() != first && first.cooldown.IsVisible())
  Test.expect(Test.page().box(SECOND_FORM).opacity() == 1)
  Test.formCastable(2, false)
  Events.UPDATE_SHAPESHIFT_USABLE.emit()
  Test.flush()
  Test.expect(Test.page().box(SECOND_FORM).opacity() < 1)
  Test.formCastable(2, true)
  Test.formCooldown(1, 0, 0)
  Test.forms(0)
}

test "the client's Quick Keybind mode binds our buttons' commands, and lights them while it runs" {
  Test.forms(2)
  alone()
  const holder = new Holder()
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  const stance = actionButton("stance", 1)
  const action = actionButton("1", 3)
  const second = actionButton("2", 1)
  Test.expect(stance.commandName == "SHAPESHIFTBUTTON1" && stance.index == 1)
  Test.expect(action.commandName == "ACTIONBUTTON3" && second.commandName == "MULTIACTIONBAR1BUTTON1")
  Test.expect(!action.QuickKeybindHighlightTexture.IsShown())
  Client.QuickKeybindFrame.Show()
  Test.expect(action.QuickKeybindHighlightTexture.IsShown() && stance.QuickKeybindHighlightTexture.IsShown())
  Client.QuickKeybindFrame.Hide()
  Test.expect(!action.QuickKeybindHighlightTexture.IsShown())
  Test.forms(0)
}

test "the form the player is in is lit on its stance's button, and no other" {
  Test.forms(2)
  alone()
  const holder = new Holder()
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  Test.expect(!Test.page().box(Ordaen.art.ctl.qualityRim).shown())
  Test.stance(2)
  Events.UPDATE_SHAPESHIFT_FORM.emit()
  Test.flush()
  Test.expect(Test.page().box(Ordaen.art.ctl.qualityRim).count() == 1 && lit(button("stance", 2)))
  Test.stance(1)
  Events.UPDATE_SHAPESHIFT_FORM.emit()
  Test.flush()
  Test.expect(Test.page().box(Ordaen.art.ctl.qualityRim).count() == 1 && lit(button("stance", 1)))
  Test.stance(0)
  Events.UPDATE_SHAPESHIFT_FORM.emit()
  Test.flush()
  Test.expect(!Test.page().box(Ordaen.art.ctl.qualityRim).shown())
  Test.forms(0)
}

test "the pet's buttons draw their icons, its commands' by the client's globals, and its stance lit" {
  alone()
  const holder = new Holder()
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  // The client's word as the pet comes: the stand-in's events reach no listener of a test's.
  Test.pet(true)
  Events.PET_BAR_UPDATE.emit()
  Test.flush()
  const path = Client.PET_ATTACK_TEXTURE
  const attack = Test.page().box(path is Asset ? path : panic("the command's icon is a file's path"))
  Test.expect(attack.shown() && near(attack, button("pet", 1)))
  Test.expect(near(Test.page().box(PET_SPELL), button("pet", 4)))
  // Defensive, the stance the pet is in.
  Test.expect(Test.page().box(Ordaen.art.ctl.qualityRim).count() == 1 && lit(button("pet", 9)))
  Test.pet(false)
  Events.PET_BAR_UPDATE.emit()
  Test.flush()
  Test.expect(!Test.page().box(PET_SPELL).shown())
}

test "a bar of two rows stands under the next one: no bar's buttons overlap another's" {
  alone()
  const holder = new Holder()
  holder.settings.change((values: mut BarsChoices): nil => {
    values.bars["1"] = changed(values, "1", (choice: mut BarChoice): nil => {
      choice.perRow = 6
    })
  })
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  // Панель 1's top row, and Панель 2 over it.
  const top = Test.centre(button("1", 1)).y
  const over = Test.centre(button("2", 1)).y
  Test.expect(Test.centre(button("1", 7)).y > top)
  Test.expect(top - over >= 45)
}

test "Панель 1 shows a form's page while the player is in it, in a fight too, unless the player keeps it as it is" {
  alone()
  const holder = new Holder()
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  const first = button("1", 1)
  Test.expect(first.GetAttribute("actionpage") == "1")
  Test.stance(1)
  Test.expect(first.GetAttribute("actionpage") == "7")
  Test.combat(true)
  Test.stance(3)
  Test.expect(first.GetAttribute("actionpage") == "9")
  Test.combat(false)
  holder.settings.change((values: mut BarsChoices): nil => {
    values.unpaged["3"] = true
  })
  Test.flush()
  Test.expect(first.GetAttribute("actionpage") == "1")
  Test.stance(0)
}

test "the pet's buttons show while there is a pet, in a fight too" {
  alone()
  const holder = new Holder()
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  const first = button("pet", 1)
  Test.expect(!first.IsShown())
  Test.combat(true)
  Test.pet(true)
  Test.expect(first.IsShown())
  Test.combat(false)
}

test "a bar's buttons, rows and look change as chosen, and in a fight only as it ends" {
  alone()
  const holder = new Holder()
  _ = Client.SetBinding("F6", "MULTIACTIONBAR1BUTTON6", nil)
  const bars = new ActionBars(holder.settings.values, holder.defaults)
  Test.mount(bars, SCREEN)
  Test.flush()
  Test.combat(true)
  holder.settings.change((values: mut BarsChoices): nil => {
    values.bars["2"] = changed(values, "2", (choice: mut BarChoice): nil => {
      choice.buttons = 5
    })
  })
  Test.flush()
  Test.expect(button("2", 6).IsShown())
  Test.combat(false)
  Test.flush()
  Test.expect(!button("2", 6).IsShown())
  Test.expect(!Test.page().text("F6").shown())
  holder.settings.change((values: mut BarsChoices): nil => {
    values.bars["2"] = changed(values, "2", (choice: mut BarChoice): nil => {
      choice.on = false
    })
  })
  Test.flush()
  Test.expect(drawn(bars.bars) == "1,3,pet")
}

test "a bar the player never moved stands above what keeps the bottom edge, the highest of them" {
  alone()
  const holder = new Holder()
  const bar = new Bar(SPECS[1], holder.below, holder.choices, holder.defaults, holder.keys, holder.paging, holder.forms)
  // Higher than the bottom panel, whatever it keeps: the highest decides.
  Ordaen.keepBottom("Ledge", 1000ui)
  const above = bar.home.y ?? 0ui
  Ordaen.keepBottom("Shelf", 1100ui)
  Test.expect(((bar.home.y ?? 0ui) - (above - 100ui)).abs() < 0.001ui)
  Ordaen.keepBottom("Shelf", 0ui)
  Ordaen.keepBottom("Ledge", 0ui)
  Test.expect((bar.home.y ?? 0ui) > above + 900ui)
}

test "a bar fades as its visibility says: hidden in a fight, its buttons keep their keys" {
  alone()
  const holder = new Holder()
  _ = Client.SetBinding("F7", "ACTIONBUTTON1", nil)
  Test.mount(new ActionBars(holder.settings.values, holder.defaults), SCREEN)
  Test.flush()
  holder.settings.change((values: mut BarsChoices): nil => {
    values.bars["1"] = changed(values, "1", (choice: mut BarChoice): nil => {
      choice.visibility = PEACEFUL
    })
  })
  Test.flush()
  Test.expect(Test.page().text("F7").opacity() == 1)
  Test.combat(true)
  Test.expect(Test.page().text("F7").opacity() == 0)
  Test.expect(Test.keyBound("F7"))
  Test.combat(false)
  Test.expect(Test.page().text("F7").opacity() == 1)
}

test "ended in a fight, the buttons fade at once, and are put away with the keys as it ends" {
  alone()
  const holder = new Holder()
  _ = Client.SetBinding("F8", "ACTIONBUTTON2", nil)
  const bars = new ActionBars(holder.settings.values, holder.defaults)
  Test.mount(bars, SCREEN)
  Test.flush()
  const second = button("1", 2)
  Test.combat(true)
  destroy bars
  Test.flush()
  Test.expect(second.GetAlpha() == 0 && second.IsShown())
  Test.combat(false)
  Test.flush()
  Test.expect(!second.IsShown())
  Test.expect(Client.GetBindingAction("F8", true) == "ACTIONBUTTON2")
}
