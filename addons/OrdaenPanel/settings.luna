// The panel's tabs in the settings window. «General» switches each part on or off; each part has a tab of its own.
// Each control writes one entry of the settings' draft.
import { Checkbox, Choice, Component, Dropdown, InputNumber, Section, Settings, Switch, Unit, VisibilityRows } from "Ordaen"
import { CharButton, CharView, Choices, Edge, Fit, MicroIcons, Outline, Places, XpBorder, XpTexture, XpView, Zone } from "@/choices"
import Locale from "@/locales"

const ICONS: Array<Choice<MicroIcons>> = [
  { value: MicroIcons.Upscaled, label: Locale.PANEL_MICROICONS_UPSCALED },
  { value: MicroIcons.Gold, label: Locale.PANEL_MICROICONS_GOLD }
]
const CHAR_BUTTONS: Array<Choice<CharButton>> = [
  { value: CharButton.Portrait, label: Locale.PANEL_CHARBUTTON_PORTRAIT },
  { value: CharButton.Button, label: Locale.PANEL_CHARBUTTON_BUTTON }
]
const CHAR_VIEWS: Array<Choice<CharView>> = [
  { value: CharView.Face, label: Locale.PANEL_CHARVIEW_FACE },
  { value: CharView.ClassIcon, label: Locale.PANEL_CHARVIEW_CLASS }
]
const OUTLINES: Array<Choice<Outline>> = [
  { value: Outline.None, label: Locale.PANEL_OUTLINE_NONE },
  { value: Outline.Thin, label: Locale.PANEL_OUTLINE_THIN },
  { value: Outline.Thick, label: Locale.PANEL_OUTLINE_THICK }
]
const XP_TEXTURES: Array<Choice<XpTexture>> = [
  { value: XpTexture.Theme, label: Locale.PANEL_AS_THEME },
  { value: XpTexture.Deep, label: Locale.PANEL_XPFILL_DEEP },
  { value: XpTexture.Grain, label: Locale.PANEL_XPFILL_GRAIN },
  { value: XpTexture.Brushed, label: Locale.PANEL_XPFILL_BRUSHED },
  { value: XpTexture.Potion, label: Locale.PANEL_XPFILL_POTION },
  { value: XpTexture.Clouds, label: Locale.PANEL_XPFILL_CLOUDS },
  { value: XpTexture.Steel, label: Locale.PANEL_XPFILL_STEEL }
]
const XP_BORDERS: Array<Choice<XpBorder>> = [
  { value: XpBorder.Theme, label: Locale.PANEL_AS_THEME },
  { value: XpBorder.Bezel, label: Locale.PANEL_XPBORDER_BEZEL },
  { value: XpBorder.Groove, label: Locale.PANEL_XPBORDER_GROOVE }
]
const XP_VIEWS: Array<Choice<XpView>> = [
  { value: XpView.Numbers, label: Locale.PANEL_XPVIEW_NUMBERS },
  { value: XpView.Percent, label: Locale.PANEL_XPVIEW_PERCENT },
  { value: XpView.NumbersOnly, label: Locale.PANEL_XPVIEW_NUMBERS_ONLY },
  { value: XpView.PercentOnly, label: Locale.PANEL_XPVIEW_PERCENT_ONLY }
]
const EDGES: Array<Choice<Edge>> = [
  { value: Edge.Bottom, label: Locale.PANEL_EDGE_BOTTOM },
  { value: Edge.Top, label: Locale.PANEL_EDGE_TOP },
  { value: Edge.Left, label: Locale.PANEL_EDGE_LEFT },
  { value: Edge.Right, label: Locale.PANEL_EDGE_RIGHT }
]
const FITS: Array<Choice<Fit>> = [
  { value: Fit.Full, label: Locale.PANEL_FIT_FULL },
  { value: Fit.Center, label: Locale.PANEL_FIT_CENTER }
]
// Where an item sits: one zone, or none. An item is in one place at a time by its one choice.
const ZONES: Array<Choice<Zone>> = [
  { value: Zone.Left, label: Locale.SECTION_ITEMS_LEFT },
  { value: Zone.Center, label: Locale.SECTION_ITEMS_CENTER },
  { value: Zone.Right, label: Locale.SECTION_ITEMS_RIGHT },
  { value: Zone.Off, label: Locale.SECTION_ITEMS_OFF }
]

public class GeneralPage implements Component {
  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Section title={Locale.SECTION_MICROMENU}>
        <Switch label={Locale.PANEL_MICROON} hint={Locale.PANEL_MICROON_TIP}
                value={mut self.settings.draft.microOn} />
      </Section>
      <Section title={Locale.SECTION_STATUS}>
        <Switch label={Locale.PANEL_STATUSON} hint={Locale.PANEL_STATUSON_TIP}
                value={mut self.settings.draft.statusOn} />
      </Section>
      <Section title={Locale.SECTION_BOTTOM}>
        <Switch label={Locale.PANEL_BOTTOMON} hint={Locale.PANEL_BOTTOMON_TIP}
                value={mut self.settings.draft.bottomOn} />
      </Section>
    }
  }
}

public class MicroPage implements Component {
  derived off: Boolean = !self.settings.draft.microOn

  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Dropdown label={Locale.PANEL_MICROICONS} hint={Locale.PANEL_MICROICONS_TIP}
                value={mut self.settings.draft.microIcons} choices={ICONS} disabled={self.off} />
      <Section title={Locale.SECTION_CHARACTER}>
        <Dropdown label={Locale.PANEL_CHARBUTTON} hint={Locale.PANEL_CHARBUTTON_TIP}
                  value={mut self.settings.draft.charButton} choices={CHAR_BUTTONS} disabled={self.off} />
        <Dropdown label={Locale.PANEL_CHARVIEW} hint={Locale.PANEL_CHARVIEW_TIP}
                  value={mut self.settings.draft.charView} choices={CHAR_VIEWS} disabled={self.off} />
      </Section>
    }
  }
}

public class StatusPage implements Component {
  derived off: Boolean = !self.settings.draft.statusOn

  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(self): Template {
    return $ltml {
      <Dropdown label={Locale.PANEL_OUTLINE} hint={Locale.PANEL_OUTLINE_TIP}
                value={mut self.settings.draft.outline} choices={OUTLINES} />
      <Checkbox label={Locale.PANEL_SHADOW} hint={Locale.PANEL_SHADOW_TIP}
                value={mut self.settings.draft.shadow} />
      <Section title={Locale.SECTION_XPBAR}>
        <Dropdown label={Locale.PANEL_XPVIEW} hint={Locale.PANEL_XPVIEW_TIP}
                  value={mut self.settings.draft.xpView} choices={XP_VIEWS} disabled={self.off} />
        <Dropdown label={Locale.PANEL_XPTEXTURE} hint={Locale.PANEL_XPTEXTURE_TIP}
                  value={mut self.settings.draft.xpTexture} choices={XP_TEXTURES} disabled={self.off} />
        <Dropdown label={Locale.PANEL_XPBORDER} hint={Locale.PANEL_XPBORDER_TIP}
                  value={mut self.settings.draft.xpBorder} choices={XP_BORDERS} disabled={self.off} />
      </Section>
    }
  }
}

// The zone of each item, in a section.
class PlacesRows implements Component {
  value: mut Signal<Places>
  disabled: Signal<Boolean>
  constructor(value: mut Signal<Places>, disabled: Signal<Boolean>) {
    self.value = value
    self.disabled = disabled
  }

  public render(self): Template {
    return $ltml {
      <Section title={Locale.SECTION_ITEMS}>
        <Dropdown label={Locale.PANEL_MICROMENU} hint={Locale.PANEL_MICROMENU_TIP} value={mut self.value.micromenu}
                  choices={ZONES} disabled={self.disabled} />
        <Dropdown label={Locale.PANEL_SOCIAL} hint={Locale.PANEL_SOCIAL_TIP} value={mut self.value.social}
                  choices={ZONES} disabled={self.disabled} />
        <Dropdown label={Locale.PANEL_EXPERIENCE} hint={Locale.PANEL_EXPERIENCE_TIP}
                  value={mut self.value.experience} choices={ZONES} disabled={self.disabled} />
        <Dropdown label={Locale.PANEL_ZONE} hint={Locale.PANEL_ZONE_TIP} value={mut self.value.zone}
                  choices={ZONES} disabled={self.disabled} />
        <Dropdown label={Locale.PANEL_CLOCK} hint={Locale.PANEL_CLOCK_TIP} value={mut self.value.clock}
                  choices={ZONES} disabled={self.disabled} />
        <Dropdown label={Locale.PANEL_CURRENCIES} hint={Locale.PANEL_CURRENCIES_TIP}
                  value={mut self.value.currencies} choices={ZONES} disabled={self.disabled} />
        <Dropdown label={Locale.PANEL_BAGS} hint={Locale.PANEL_BAGS_TIP} value={mut self.value.bags}
                  choices={ZONES} disabled={self.disabled} />
      </Section>
    }
  }
}

public class BottomPage implements Component {
  derived off: Boolean = !self.settings.draft.bottomOn

  settings: mut Settings<Choices>
  const least: Number
  constructor(
    settings: mut Settings<Choices>,
    // The least the panel is high: its cells keep their size.
    least: Number
  ) {
    self.settings = settings
    self.least = least
  }

  public render(self): Template {
    return $ltml {
      <Dropdown label={Locale.PANEL_EDGE} hint={Locale.PANEL_EDGE_TIP} value={mut self.settings.draft.edge}
                choices={EDGES} disabled={self.off} />
      <Dropdown label={Locale.PANEL_FIT} hint={Locale.PANEL_FIT_TIP} value={mut self.settings.draft.fit}
                choices={FITS} disabled={self.off} />
      <InputNumber label={Locale.PANEL_HEIGHT} hint={Locale.PANEL_HEIGHT_TIP} value={mut self.settings.draft.height}
                   least={self.least} most={96} unit={Unit.Px} disabled={self.off} />
      <PlacesRows value={mut self.settings.draft.places} disabled={self.off} />
      <VisibilityRows value={mut self.settings.draft.visibility} disabled={self.off} />
    }
  }
}
