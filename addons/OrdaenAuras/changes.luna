// What an aura changes in the character's stats: its spell's effects, read from the client's own spell data
// (`effects.luna`, generated from Forever's SpellEffect table), each with its amount now.
import Effects from "@/effects"

// What an effect changes, one member a kind of the generator's.
public enum Kind {
  Stat
  StatPercent
  Armor
  Resist
  ResistPercent
  Health
  Power
  Regen
  AttackPower
  RangedPower
  AttackPowerPercent
  SpellDamage
  Healing
  Hit
  SpellHit
  Crit
  SpellCrit
  Dodge
  Parry
  Block
  BlockValue
  Rating
  Expertise
  Penetration
  AttackSpeed
  RangedSpeed
  AttackRangedSpeed
  CastSpeed
  Haste
  RunSpeed
}

// The generator's name of each kind (`lunatype generate auras`), the one place it is written.
const KIND_OF: map<string, Kind> = {
  ["stat"]: .Stat,
  ["statPercent"]: .StatPercent,
  ["armor"]: .Armor,
  ["resist"]: .Resist,
  ["resistPercent"]: .ResistPercent,
  ["health"]: .Health,
  ["power"]: .Power,
  ["regen"]: .Regen,
  ["attackPower"]: .AttackPower,
  ["rangedPower"]: .RangedPower,
  ["attackPowerPercent"]: .AttackPowerPercent,
  ["spellDamage"]: .SpellDamage,
  ["healing"]: .Healing,
  ["hit"]: .Hit,
  ["spellHit"]: .SpellHit,
  ["crit"]: .Crit,
  ["spellCrit"]: .SpellCrit,
  ["dodge"]: .Dodge,
  ["parry"]: .Parry,
  ["block"]: .Block,
  ["blockValue"]: .BlockValue,
  ["rating"]: .Rating,
  ["expertise"]: .Expertise,
  ["penetration"]: .Penetration,
  ["attackSpeed"]: .AttackSpeed,
  ["rangedSpeed"]: .RangedSpeed,
  ["attackRangedSpeed"]: .AttackRangedSpeed,
  ["castSpeed"]: .CastSpeed,
  ["haste"]: .Haste,
  ["runSpeed"]: .RunSpeed
}

// The table's spells stand in blocks of this many, one text each (`effects.luna`).
const BLOCK = 1000

// One change an aura makes: its kind; the stat (0 strength to 4 spirit, -1 all), the schools (a mask: 1 physical,
// 2 holy ... 64 arcane), the power or the ratings it changes, by the kind; and how much, its stacks counted in (a
// percentage for a kind that is one).
public struct Change {
  const kind: Kind
  const misc: integer
  const amount: number
}

// An aura on the character and what it changes; none for an aura that changes no stat the table knows.
public struct Active {
  const spell: integer
  const harmful: boolean
  const stacks: integer
  const changes: array<Change>
}

// An effect of the table: its place among its spell's effects (from 0), its kind, its misc value, its points and
// what they grow by a level.
struct Effect {
  const index: integer
  const kind: Kind
  const misc: integer
  const points: number
  const growth: number
}

function effectsOf(spell: integer): array<Effect> {
  const effects: array<Effect> = []
  const block = Effects::blocks[(spell / BLOCK).floor()]
  if (block == nil) { return effects }
  let own: string | nil = nil
  for (entry of block.split(";")) {
    const (id, rest) = entry.match("^(%d+):(.*)$")
    if (id?.toNumber() == spell) {
      own = rest
      break
    }
  }
  if (own == nil) { return effects }
  for (entry of own.split("/")) {
    const (index, name, misc, points, growth) = entry.match("^(%d+),(%a+),(%-?%d+),([%-%d%.e]+),([%-%d%.e]+)$")
    const kind = name == nil ? nil : KIND_OF[name]
    const place = index?.toNumber()
    const value = misc?.toNumber()
    const base = points?.toNumber()
    const step = growth?.toNumber()
    if (kind != nil && place != nil && value != nil && base != nil && step != nil) {
      effects.push({ index: place.floor(), kind: kind, misc: value.floor(), points: base, growth: step })
    }
  }
  return effects
}

// What an aura changes now: each effect the table knows, its amount the client's own points for that effect where it
// gives them (talents and ranks counted in), else the table's points grown to the character's level; times its stacks.
public function changesOf(spell: integer, stacks: integer, points: array<number>, level: integer): array<Change> {
  const times = stacks.max(1)
  return effectsOf(spell).map((effect: Effect): Change => {
    const live = points[effect.index + 1]
    const amount = live ?? effect.points + effect.growth * level
    return Change { kind: effect.kind, misc: effect.misc, amount: amount * times }
  })
}
