// The character's auras and what each changes, as other modules read them: the client's points where it gives them,
// the spell data's otherwise, the stacks counted in, an aura that changes no stat left out.
import Game from "$game"
import Test from "$test"
import root Auras from "OrdaenAuras"
import { Kind } from "@/changes"

// Battle Shout, Blessing of Kings, Health II (spell data: 9 attack power and 0.3 a level, all stats 10%, 27 health),
// and Renew, a heal over time that changes no stat.
const SHOUT = 6673
const KINGS = 20217
const HEALTH = 2378
const RENEW = 139

test "each aura's changes are the client's points for its effect, times its stacks" {
  Game::auras.player = (): array<Game::PlayerAura> => [
    { spell: SHOUT, stacks: 0, harmful: false, points: [55] },
    { spell: HEALTH, stacks: 2, harmful: false, points: [120] }
  ]
  Auras.refresh()
  const shout = Auras.active[1] ?? throw Error { message: "the shout" }
  const health = Auras.active[2] ?? throw Error { message: "the health" }
  Test::expect(shout.spell == SHOUT && shout.changes.length == 1)
  Test::expect(shout.changes[1]?.kind == Kind::AttackPower && shout.changes[1]?.amount == 55)
  Test::expect(health.changes[1]?.kind == Kind::Health && health.changes[1]?.amount == 240)
}

test "without the client's points, an aura's change is the spell data's, grown to the character's level" {
  Game::player.level = 10
  Game::auras.player = (): array<Game::PlayerAura> => [{ spell: SHOUT, stacks: 0, harmful: false, points: [] }]
  Auras.refresh()
  const shout = Auras.active[1] ?? throw Error { message: "the shout" }
  Test::expect(shout.changes[1]?.amount == 12)
}

test "a percentage of every stat keeps its misc value, all of them; an aura that changes no stat isn't listed" {
  Game::auras.player = (): array<Game::PlayerAura> => [
    { spell: RENEW, stacks: 0, harmful: false, points: [9] },
    { spell: KINGS, stacks: 0, harmful: false, points: [10] }
  ]
  Auras.refresh()
  Test::expect(Auras.active.length == 1)
  const kings = (Auras.active[1] ?? throw Error { message: "kings" }).changes[1] ?? throw Error { message: "its change" }
  Test::expect(kings.kind == Kind::StatPercent && kings.misc == -1 && kings.amount == 10)
}

test "the auras are read again when the client says they changed" {
  Game::auras.player = (): array<Game::PlayerAura> => []
  Auras.refresh()
  Test::expect(Auras.active.length == 0)
  Game::auras.player = (): array<Game::PlayerAura> => [{ spell: SHOUT, stacks: 0, harmful: false, points: [55] }]
  Game::auras.changed.emit()
  Test::expect(Auras.active.length == 1)
}
