// The library's Table: a heading click sorts by its column and again reverses it, a column that isn't sortable does
// nothing, the rows follow their own cells, and a body given a height builds only the rows in view: a row handed
// another item follows its cell.
import { Align, Frame, MouseButton, Track } from "$ltml"
import Test from "$test"
import Wow from "LunaTypeRenderer"
import { Age } from "@/age"
import { Money } from "@/money"
import { Ground } from "@/scrolledList"
import { Column, Table, TableCell, TableRow, tracksOf } from "@/table"

public struct Sale {
  name: String
  price: Integer
  seen: Number
}

const COLUMNS: Array<Column> = [
  { title: "Item", width: { fr: 1 }, sortable: true },
  { title: "Price", width: 110ui, align: Align.End, sortable: true },
  { title: "Age", width: 50ui, align: Align.End, sortable: true },
  { title: "Note", width: 60ui }
]
const TRACKS: Array<Track> = tracksOf(COLUMNS)

class Sales {
  public state sales: Array<Sale> = [
    { name: "Copper Bar", price: 150, seen: 3 * 86400 },
    { name: "Bronze Axe", price: 12345, seen: 86400 },
    { name: "Arcane Dust", price: 40, seen: 9 * 86400 }
  ]
  public state sorted = 0
  public state descending = false
  public state picked = ""
  public state clicks = 0
  public state height: Number<Length> | nil = nil
  public derived ordered: Array<Sale> = self.order()

  order(self): Array<Sale> {
    let list: Array<Sale> = []
    for (sale of self.sales) { list.push(sale) }
    const column = self.sorted
    const down = self.descending
    if (column == 0) { return list }
    list.sort((a, b) => {
      if (column == 1) { return down ? a.name > b.name : a.name < b.name }
      if (column == 2) { return down ? a.price > b.price : a.price < b.price }
      return down ? a.seen > b.seen : a.seen < b.seen
    })
    return list
  }

  onPick(mut self, button: MouseButton) {
    self.picked = button == MouseButton.Right ? "right" : "row"
    self.clicks += 1
  }

  public render(self): Template {
    return $ltml {
      <Table columns={COLUMNS} sorted={mut self.sorted} descending={mut self.descending} height={self.height}>
        <TableRow $for={sale of self.ordered} $key={sale} tracks={TRACKS} @pick={self.onPick}>
          <text value={sale.name} />
          <box xAlign={Align.End}>
            <Money amount={sale.price} />
          </box>
          <box xAlign={Align.End}>
            <Age seconds={sale.seen} />
          </box>
          <box />
        </TableRow>
      </Table>
    }
  }
}

function names(page: Sales): String {
  return page.ordered.map((sale: Sale): String => sale.name).join(", ")
}

test "a heading click sorts by its column and again reverses it, the rows' own cells follow, every row is drawn" {
  let page = new Sales()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 300 })
  Test.shot("unsorted: the rows as given, no heading marked")
  Test.expect(names(page) == "Copper Bar, Bronze Axe, Arcane Dust")

  Test.click(Test.holding("Price", nil), nil)
  Test.expect(page.sorted == 2 && !page.descending)
  Test.expect(names(page) == "Arcane Dust, Copper Bar, Bronze Axe")
  Test.shot("Price clicked: ordered by it, the cheapest first, its heading gold with the up mark and a light under it")

  Test.click(Test.holding("Price", nil), nil)
  Test.expect(page.descending)
  Test.expect(names(page) == "Bronze Axe, Copper Bar, Arcane Dust")
  Test.shot("Price clicked again: reversed, the down mark")

  Test.click(Test.holding("Item", nil), nil)
  Test.expect(page.sorted == 1 && !page.descending)
  Test.expect(names(page) == "Arcane Dust, Bronze Axe, Copper Bar")
  Test.shot("Item clicked: by name, ascending again, the light moved")

  Test.click(Test.holding("Age", nil), nil)
  Test.expect(names(page) == "Bronze Axe, Copper Bar, Arcane Dust")
  Test.shot("Age clicked: the youngest first")

  Test.click(Test.holding("Note", nil), nil)
  Test.expect(page.sorted == 3)
  Test.shot("Note clicked: it isn't sortable, nothing changes")

  page.sales = [
    { name: "Copper Bar", price: 150, seen: 3 * 86400 },
    { name: "Bronze Axe", price: 99, seen: 2 * 86400 },
    { name: "Arcane Dust", price: 40, seen: 9 * 86400 },
    { name: "Tin Bar", price: 70, seen: 600 }
  ]
  Test.expect(names(page) == "Tin Bar, Bronze Axe, Copper Bar, Arcane Dust")
  Test.shot("the sales replaced while sorted by Age: four rows, the new one first, nothing was asked to sort")

  Test.click(Test.holding("Bronze Axe", nil), nil)
  Test.expect(page.picked == "row")

  Test.click(Test.holding("Copper Bar", nil), MouseButton.Right)
  Test.expect(page.picked == "right")
  Test.expect(page.clicks == 2)

  destroy page
  Test.expect(Test.blank())
}

const PAGE: Array<Track> = ["max-content", { fr: 1 }, "max-content"]

function many(count: Integer): Array<Sale> {
  let list: Array<Sale> = []
  for (i of 1..count) { list.push({ name: `Ware ${i}`, price: i * 37, seen: i * 600 }) }
  return list
}

// A table in a row that shares what is left of a page 200 high, between a head and a foot: six hundred sales.
class Long {
  public state sales: Array<Sale> = many(600)
  public state sorted = 0
  public state descending = false

  public render(self): Template {
    return $ltml {
      <box height={200ui} rows={PAGE}>
        <text value={"head"} />
        <Table columns={COLUMNS} sorted={mut self.sorted} descending={mut self.descending}>
          <TableRow $for={sale of self.sales} $key={sale} tracks={TRACKS}>
            <text value={sale.name} />
            <box xAlign={Align.End}>
              <Money amount={sale.price} />
            </box>
            <box xAlign={Align.End}>
              <Age seconds={sale.seen} />
            </box>
            <box />
          </TableRow>
        </Table>
        <text value={"foot"} />
      </box>
    }
  }
}

test "a table in a row that shares takes what is left, its body scrolls, and of six hundred rows builds those in view" {
  const before = Wow.made()
  let page = new Long()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 300 })
  const built = Wow.made() - before
  // Each row is a handful of boxes: those in view and a few past them, never six hundred rows' worth.
  Test.expect(built < 200)
  Test.shot("the headings, the body in the rest of the 200 down to the foot, its first rows built")
  Test.moveTo(Test.holding("Ware 2", nil))
  for (i of 1..50) { Test.wheel(-1) }
  Test.expect(Wow.made() - before == built)
  Test.shot("fifty notches down: the same boxes hold the wares now in view")
  destroy page
  Test.expect(Test.blank())
}

test "a table given a height scrolls its rows past it, the headings stay" {
  let page = new Sales()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 300 })
  page.height = 80ui
  Test.shot("the table 80 high: the headings, the first row and part of the next under them")

  Test.moveTo(Test.holding("Copper Bar", nil))
  Test.wheel(-3)
  Test.shot("the wheel turned down over the rows: they have moved up under the headings")

  destroy page
  Test.expect(Test.blank())
}

const SHARED: Array<Column> = [
  { title: "Name", width: { fr: 1 } },
  { title: "Zone", width: { fr: 1 } },
  { title: "Note", width: { fr: 1 } }
]
const SHARED_TRACKS: Array<Track> = tracksOf(SHARED)

// Three columns that share the width, a row whose zone runs far past its column.
class Shared {
  public state sorted = 0
  public state descending = false

  public render(self): Template {
    return $ltml {
      <Table columns={SHARED} sorted={mut self.sorted} descending={mut self.descending}>
        <TableRow tracks={SHARED_TRACKS}>
          <TableCell>
            <text value={"Ingrid"} wrap={.None} />
          </TableCell>
          <TableCell>
            <text value={"Stormwind"} wrap={.None} />
          </TableCell>
          <TableCell>
            <text value={"main"} wrap={.None} />
          </TableCell>
        </TableRow>
        <TableRow tracks={SHARED_TRACKS}>
          <TableCell>
            <text value={"Bo"} wrap={.None} />
          </TableCell>
          <TableCell>
            <text value={"The Temple of Atal'Hakkar, deep in the Swamp of Sorrows"} wrap={.Cut} />
          </TableCell>
          <TableCell>
            <text value={"alt"} wrap={.None} />
          </TableCell>
        </TableRow>
      </Table>
    }
  }
}

test "a long text in a cell is cut at its column, and every row's columns stand under the headings" {
  let page = new Shared()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 300 })
  Test.shot("three shared columns: the long zone cut at its edge, «alt» under «Note» as «main» is")
  destroy page
  Test.expect(Test.blank())
}

const GROUPED: Array<Column> = [
  { title: "Item", width: { fr: 1 }, sortable: true },
  { title: "House", width: 80ui, align: Align.End, sortable: true, group: "Cost" },
  { title: "Vendor", width: 80ui, align: Align.End, sortable: true, group: "Cost" },
  { title: "House", width: 80ui, align: Align.End, group: "Price" },
  { title: "Vendor", width: 80ui, align: Align.End, group: "Price" },
  { title: "Profit", width: 80ui, align: Align.End }
]
const GROUPED_TRACKS: Array<Track> = tracksOf(GROUPED)
const WARES: Array<String> = ["Copper Bar", "Bronze Axe"]

// Two groups of two columns between two columns in none, on the wood.
class Grouped {
  public state sorted = 0
  public state descending = false
  // The row the cursor last came onto.
  public row: any Frame | nil = nil

  onRow(mut self, frame: any Frame) { self.row = frame }

  public render(self): Template {
    return $ltml {
      <Table columns={GROUPED} sorted={mut self.sorted} descending={mut self.descending} ground={Ground.Wood}>
        <TableRow $for={ware of WARES} tracks={GROUPED_TRACKS} ground={Ground.Wood} @enter={self.onRow}>
          <text value={ware} />
          <text value={"1"} />
          <text value={"2"} />
          <text value={"3"} />
          <text value={"4"} />
          <text value={"5"} />
        </TableRow>
      </Table>
    }
  }
}

test "neighbouring columns of one group share a heading over theirs; a table on the wood has no well, its rows ruled" {
  let page = new Grouped()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 200 })
  const cost = Test.page().text("Cost").rect()
  const price = Test.page().text("Price").rect()
  const house = Test.page().text("House").nth(1).rect()
  const vendor = Test.page().text("Vendor").nth(1).rect()
  // «Cost» over its two columns' headings, within their outer edges; «Price» past them, over its own.
  Test.expect(cost.bottom <= house.top && cost.left >= house.left - 80 && cost.right <= vendor.right)
  Test.expect(price.left > vendor.right && price.bottom <= house.top)
  // A column in no group has its heading over both rows, its title in their middle.
  const item = Test.page().text("Item").rect()
  Test.expect(item.top > cost.top && item.bottom < house.bottom)
  Test.click(Test.holding("Vendor", nil), nil)
  Test.expect(page.sorted == 3)
  Test.shot("grouped headings on the wood: «Cost» and «Price» over their pairs, no well, a rule under each row")
  destroy page
  Test.expect(Test.blank())
}

// How many lines down what the client describes: a texture of the border's layer narrower than 2 and higher than 5.
function upright(described: String): Integer {
  let count = 0
  for (line of described.split("\n")) {
    const words = line.split(" ").filter(word => word != "")
    if (words[1] == "Texture" && words[2] == "BORDER") {
      const size = (words[4] ?? "").split("x")
      const wide = (size[1] ?? "").toNumber() ?? 0
      const high = (size[2] ?? "").toNumber() ?? 0
      if (wide < 2 && high > 5) { count += 1 }
    }
  }
  return count
}

test "a table on the wood rules its columns apart: a line down each gap of a row" {
  let page = new Grouped()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 200 })
  Test.page().text("Copper Bar").hover()
  const row = page.row ?? panic("the row hands its frame as the cursor comes onto it")
  // Six columns: a rule in each of the five gaps.
  Test.expect(upright(Test.dump(row)) == 5)
  destroy page
  Test.expect(Test.blank())
}
