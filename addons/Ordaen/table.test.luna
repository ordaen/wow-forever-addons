// The library's Table: a heading click adds its column to the sorts and again reverses it, a right click takes it
// away, a dim line over the table says the order, a column that isn't sortable does nothing, the rows follow their own
// cells, and a body given a height builds only the rows in view: a row handed another item follows its cell.
import { Align, Frame, MouseButton, Track } from "$ltml"
import Test from "$test"
import Wow from "LunaTypeRenderer"
import { Age } from "@/age"
import { Money } from "@/money"
import { Ground } from "@/scrolledList"
import { Column, Table, TableCell, TableRow, sortedBefore } from "@/table"

public struct Sale {
  name: String
  price: Integer
  seen: Number
}

const COLUMNS: Array<Column> = [
  { title: "Item", width: { fr: 1 }, sortable: true },
  { title: "Price", width: 110ui, align: Align.End, sortable: true },
  { title: "Age", width: 50ui, align: Align.End, sortable: true },
  { title: "Note", width: 60ui }
]

class Sales {
  public state sales: Array<Sale> = [
    { name: "Copper Bar", price: 150, seen: 3 * 86400 },
    { name: "Bronze Axe", price: 12345, seen: 86400 },
    { name: "Arcane Dust", price: 40, seen: 9 * 86400 }
  ]
  public state sorts: Array<Integer> = []
  public state picked = ""
  public state clicks = 0
  public state height: Number<Length> | nil = nil
  public derived ordered: Array<Sale> = self.order()

  order(self): Array<Sale> {
    let list: Array<Sale> = []
    for (sale of self.sales) { list.push(sale) }
    const sorts = self.sorts
    if (sorts.length > 0) { list.sort((a, b) => sortedBefore(a, b, sorts, saleBefore)) }
    return list
  }

  onPick(mut self, button: MouseButton) {
    self.picked = button == MouseButton.Right ? "right" : "row"
    self.clicks += 1
  }

  public render(self): Template {
    return $ltml {
      <Table columns={COLUMNS} sorts={mut self.sorts} height={self.height}>
        <TableRow $for={sale of self.ordered} $key={sale} @pick={self.onPick}>
          <TableCell> <text value={sale.name} /> </TableCell>
          <TableCell align={Align.End}> <Money amount={sale.price} /> </TableCell>
          <TableCell align={Align.End}> <Age seconds={sale.seen} /> </TableCell>
          <TableCell />
        </TableRow>
      </Table>
    }
  }
}

function names(page: Sales): String {
  return page.ordered.map((sale: Sale): String => sale.name).join(", ")
}

test "a heading click sorts by its column and again reverses it, the rows' own cells follow, every row is drawn" {
  let page = new Sales()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 300 })
  Test.shot("unsorted: the rows as given, no heading marked")
  Test.expect(names(page) == "Copper Bar, Bronze Axe, Arcane Dust")

  Test.page().button("Price").click()
  Test.expect(page.sorts.equal([2]))
  Test.expect(names(page) == "Arcane Dust, Copper Bar, Bronze Axe")
  Test.shot("Price clicked: ordered by it, the cheapest first, its heading gold with the up mark and a light under it")

  Test.page().button("Price").click()
  Test.expect(page.sorts.equal([-2]))
  Test.expect(names(page) == "Bronze Axe, Copper Bar, Arcane Dust")
  Test.shot("Price clicked again: reversed, the down mark")

  Test.page().button("Price").rightClick()
  Test.page().button("Item").click()
  Test.expect(page.sorts.equal([1]))
  Test.expect(names(page) == "Arcane Dust, Bronze Axe, Copper Bar")
  Test.shot("Price taken away, Item clicked: by name, ascending again, the light moved")

  Test.page().button("Item").rightClick()
  Test.page().button("Age").click()
  Test.expect(names(page) == "Bronze Axe, Copper Bar, Arcane Dust")
  Test.shot("Item taken away, Age clicked: the youngest first")

  Test.page().button("Note").click()
  Test.page().button("Note").rightClick()
  Test.expect(page.sorts.equal([3]))
  Test.shot("Note clicked: it isn't sortable, nothing changes")

  page.sales = [
    { name: "Copper Bar", price: 150, seen: 3 * 86400 },
    { name: "Bronze Axe", price: 99, seen: 2 * 86400 },
    { name: "Arcane Dust", price: 40, seen: 9 * 86400 },
    { name: "Tin Bar", price: 70, seen: 600 }
  ]
  Test.expect(names(page) == "Tin Bar, Bronze Axe, Copper Bar, Arcane Dust")
  Test.shot("the sales replaced while sorted by Age: four rows, the new one first, nothing was asked to sort")

  Test.click(Test.holding("Bronze Axe", nil), nil)
  Test.expect(page.picked == "row")

  Test.click(Test.holding("Copper Bar", nil), MouseButton.Right)
  Test.expect(page.picked == "right")
  Test.expect(page.clicks == 2)

  destroy page
  Test.expect(Test.blank())
}

const PAGE: Array<Track> = ["max-content", { fr: 1 }, "max-content"]

function many(count: Integer): Array<Sale> {
  let list: Array<Sale> = []
  for (i of 1..count) { list.push({ name: `Ware ${i}`, price: i * 37, seen: i * 600 }) }
  return list
}

// A table in a row that shares what is left of a page 200 high, between a head and a foot: six hundred sales.
class Long {
  public state sales: Array<Sale> = many(600)
  public state sorts: Array<Integer> = []

  public render(self): Template {
    return $ltml {
      <box height={200ui} rows={PAGE}>
        <text value={"head"} />
        <Table columns={COLUMNS} sorts={mut self.sorts}>
          <TableRow $for={sale of self.sales} $key={sale}>
            <TableCell> <text value={sale.name} /> </TableCell>
            <TableCell align={Align.End}> <Money amount={sale.price} /> </TableCell>
            <TableCell align={Align.End}> <Age seconds={sale.seen} /> </TableCell>
            <TableCell />
          </TableRow>
        </Table>
        <text value={"foot"} />
      </box>
    }
  }
}

test "a table in a row that shares takes what is left, its body scrolls, and of six hundred rows builds those in view" {
  const before = Wow.made()
  let page = new Long()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 300 })
  const built = Wow.made() - before
  // Each row is a handful of boxes: those in view and a few past them, never six hundred rows' worth.
  Test.expect(built < 200)
  Test.shot("the headings, the body in the rest of the 200 down to the foot, its first rows built")
  Test.moveTo(Test.holding("Ware 2", nil))
  for (i of 1..50) { Test.wheel(-1) }
  Test.expect(Wow.made() - before == built)
  Test.shot("fifty notches down: the same boxes hold the wares now in view")
  destroy page
  Test.expect(Test.blank())
}

test "a table given a height scrolls its rows past it, the headings stay" {
  let page = new Sales()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 300 })
  page.height = 80ui
  Test.shot("the table 80 high: the headings, the first row and part of the next under them")

  Test.moveTo(Test.holding("Copper Bar", nil))
  Test.wheel(-3)
  Test.shot("the wheel turned down over the rows: they have moved up under the headings")

  destroy page
  Test.expect(Test.blank())
}

const SHARED: Array<Column> = [
  { title: "Name", width: { fr: 1 } },
  { title: "Zone", width: { fr: 1 } },
  { title: "Note", width: { fr: 1 } }
]

// Three columns that share the width, a row whose zone runs far past its column.
class Shared {
  public state sorts: Array<Integer> = []

  public render(self): Template {
    return $ltml {
      <Table columns={SHARED} sorts={mut self.sorts}>
        <TableRow>
          <TableCell>
            <text value={"Ingrid"} wrap={.None} />
          </TableCell>
          <TableCell>
            <text value={"Stormwind"} wrap={.None} />
          </TableCell>
          <TableCell>
            <text value={"main"} wrap={.None} />
          </TableCell>
        </TableRow>
        <TableRow>
          <TableCell>
            <text value={"Bo"} wrap={.None} />
          </TableCell>
          <TableCell>
            <text value={"The Temple of Atal'Hakkar, deep in the Swamp of Sorrows"} wrap={.Cut} />
          </TableCell>
          <TableCell>
            <text value={"alt"} wrap={.None} />
          </TableCell>
        </TableRow>
      </Table>
    }
  }
}

test "a long text in a cell is cut at its column, and every row's columns stand under the headings" {
  let page = new Shared()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 300 })
  Test.shot("three shared columns: the long zone cut at its edge, «alt» under «Note» as «main» is")
  destroy page
  Test.expect(Test.blank())
}

const GROUPED: Array<Column> = [
  { title: "Item", width: { fr: 1 }, sortable: true },
  { title: "House", width: 80ui, align: Align.End, sortable: true, group: ["Cost"] },
  { title: "Vendor", width: 80ui, align: Align.End, sortable: true, group: ["Cost"] },
  { title: "House", width: 80ui, align: Align.End, group: ["Price"] },
  { title: "Vendor", width: 80ui, align: Align.End, group: ["Price"] },
  { title: "Profit", width: 80ui, align: Align.End }
]
const WARES: Array<String> = ["Copper Bar", "Bronze Axe"]

// Two groups of two columns between two columns in none, on the wood.
class Grouped {
  public state sorts: Array<Integer> = []
  // The row the cursor last came onto.
  public row: any Frame | nil = nil

  onRow(mut self, frame: any Frame) { self.row = frame }

  public render(self): Template {
    return $ltml {
      <Table columns={GROUPED} sorts={mut self.sorts} ground={Ground.Wood}>
        <TableRow $for={ware of WARES} ground={Ground.Wood} @enter={self.onRow}>
          <TableCell> <text value={ware} /> </TableCell>
          <TableCell align={Align.End}> <text value={"1"} /> </TableCell>
          <TableCell align={Align.End}> <text value={"2"} /> </TableCell>
          <TableCell align={Align.End}> <text value={"3"} /> </TableCell>
          <TableCell align={Align.End}> <text value={"4"} /> </TableCell>
          <TableCell align={Align.End}> <text value={"5"} /> </TableCell>
        </TableRow>
      </Table>
    }
  }
}

test "neighbouring columns of one group share a heading over theirs; a table on the wood has no well, its rows ruled" {
  let page = new Grouped()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 200 })
  const cost = Test.page().text("Cost").rect()
  const price = Test.page().text("Price").rect()
  const house = Test.page().text("House").nth(1).rect()
  const vendor = Test.page().text("Vendor").nth(1).rect()
  // «Cost» over its two columns' headings, within their outer edges; «Price» past them, over its own.
  Test.expect(cost.bottom <= house.top && cost.left >= house.left - 80 && cost.right <= vendor.right)
  Test.expect(price.left > vendor.right && price.bottom <= house.top)
  // A column in no group has its heading over both rows, its title in their middle.
  const item = Test.page().text("Item").rect()
  Test.expect(item.top > cost.top && item.bottom < house.bottom)
  Test.page().button("Vendor").nth(1).click()
  Test.expect(page.sorts.equal([3]))
  // The order's line names a column in a group by the group's title and its own.
  Test.expect(Test.page().text("Cost - Vendor").shown())
  Test.shot("grouped headings on the wood: «Cost» and «Price» over their pairs, no well, a rule under each row")
  destroy page
  Test.expect(Test.blank())
}

// How many lines down what the client describes: a texture of the border's layer narrower than 2 and higher than 5.
function upright(described: String): Integer {
  let count = 0
  for (line of described.split("\n")) {
    const words = line.split(" ").filter(word => word != "")
    if (words[1] == "Texture" && words[2] == "BORDER") {
      const size = (words[4] ?? "").split("x")
      const wide = (size[1] ?? "").toNumber() ?? 0
      const high = (size[2] ?? "").toNumber() ?? 0
      if (wide < 2 && high > 5) { count += 1 }
    }
  }
  return count
}

test "a table on the wood rules its columns apart: a line down each gap of a row" {
  let page = new Grouped()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 200 })
  Test.page().text("Copper Bar").hover()
  const row = page.row ?? panic("the row hands its frame as the cursor comes onto it")
  // Six columns: a rule in each of the five gaps.
  Test.expect(upright(Test.dump(row)) == 5)
  destroy page
  Test.expect(Test.blank())
}

const NESTED: Array<Column> = [
  { title: "Item", width: { fr: 1 } },
  { title: "Buy", width: 70ui, group: ["Price", "House"] },
  { title: "Bid", width: 70ui, group: ["Price", "House"] },
  { title: "Vendor", width: 70ui, group: ["Price"] }
]

// A group in a group: «House» under «Price», over two columns, beside a column of «Price» in no further group.
class Nested {
  public state sorts: Array<Integer> = []
  public row: any Frame | nil = nil

  onRow(mut self, frame: any Frame) { self.row = frame }

  public render(self): Template {
    return $ltml {
      <Table columns={NESTED} sorts={mut self.sorts} ground={Ground.Wood}>
        <TableRow ground={Ground.Wood} @enter={self.onRow}>
          <TableCell> <text value={"Ore"} /> </TableCell>
          <TableCell> <text value={"one"} /> </TableCell>
          <TableCell> <text value={"two"} /> </TableCell>
          <TableCell> <text value={"three"} /> </TableCell>
        </TableRow>
      </Table>
    }
  }
}

test "a group in a group has its title under its group's, over its own columns; every cell stands where its heading does" {
  let page = new Nested()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 200 })
  const price = Test.page().text("Price").rect()
  const house = Test.page().text("House").rect()
  const buy = Test.page().text("Buy").rect()
  const bid = Test.page().text("Bid").rect()
  const vendor = Test.page().text("Vendor").rect()
  Test.expect(price.bottom <= house.top && house.bottom <= buy.top && near(buy.top, bid.top))
  // «Vendor», beside «House» under «Price», takes both of its rows, its title in their middle.
  Test.expect(vendor.top > house.top && vendor.bottom < buy.bottom)
  // Each cell's text starts where its heading's does: one room in the head and the rows.
  Test.expect(near(Test.page().text("one").rect().left, buy.left) && near(Test.page().text("two").rect().left, bid.left))
  Test.expect(near(Test.page().text("three").rect().left, vendor.left))
  destroy page
  Test.expect(Test.blank())
}

test "a row on the wood is ruled under, the last too" {
  let page = new Nested()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 200 })
  Test.page().text("Ore").hover()
  const row = page.row ?? panic("the row hands its frame as the cursor comes onto it")
  const box = Test.page().text("Ore").rect()
  let under = false
  for (line of Test.dump(row).split("\n")) {
    const words = line.split(" ").filter(word => word != "")
    if (words[1] == "Texture" && words[2] == "BORDER") {
      const place = (words[3] ?? "").split(",")
      const size = (words[4] ?? "").split("x")
      const wide = (size[1] ?? "").toNumber() ?? 0
      const top = (place[2] ?? "").toNumber() ?? 0
      if (wide > 400 && top > box.bottom) { under = true }
    }
  }
  Test.expect(under)
  destroy page
  Test.expect(Test.blank())
}

function near(a: Number, b: Number): Boolean {
  return (a - b).abs() < 0.02
}

// A column's own order, ascending: what `sortedBefore` is handed.
function saleBefore(a: Sale, b: Sale, column: Integer): Boolean {
  if (column == 1) { return a.name < b.name }
  if (column == 2) { return a.price < b.price }
  return a.seen < b.seen
}

// A table sorted by several: two sales of one price, told apart by the next sort.
class Ties {
  public state sales: Array<Sale> = [
    { name: "Copper Bar", price: 150, seen: 3 },
    { name: "Arcane Dust", price: 40, seen: 9 },
    { name: "Bronze Bar", price: 150, seen: 1 }
  ]
  public state sorts: Array<Integer> = []
  public derived ordered: Array<Sale> = self.order()

  order(self): Array<Sale> {
    let list: Array<Sale> = self.sales.map(sale => sale)
    const sorts = self.sorts
    if (sorts.length > 0) { list.sort((a, b) => sortedBefore(a, b, sorts, saleBefore)) }
    return list
  }

  public render(self): Template {
    return $ltml {
      <Table columns={COLUMNS} sorts={mut self.sorts}>
        <TableRow $for={sale of self.ordered} $key={sale}>
          <TableCell> <text value={sale.name} /> </TableCell>
          <TableCell align={Align.End}> <Money amount={sale.price} /> </TableCell>
          <TableCell align={Align.End}> <text value={"%d"} arguments={[sale.seen.floor()]} /> </TableCell>
          <TableCell />
        </TableRow>
      </Table>
    }
  }
}

function tied(page: Ties): String {
  return page.ordered.map(sale => sale.name).join(", ")
}

test "a click on another heading sorts the rows the first leaves level by it, again reverses it; a right click takes a sort away" {
  let page = new Ties()
  Test.mount(page, { left: 0, top: 0, width: 500, height: 300 })
  Test.page().button("Price").click()
  Test.expect(page.sorts.equal([2]) && Test.page().text("Price").count() == 2)
  Test.page().button("Item").click()
  Test.expect(page.sorts.equal([2, 1]) && tied(page) == "Arcane Dust, Bronze Bar, Copper Bar")
  Test.expect(Test.page().text("Price > Item").shown())
  Test.page().button("Item").click()
  Test.expect(page.sorts.equal([2, -1]) && tied(page) == "Arcane Dust, Copper Bar, Bronze Bar")
  Test.expect(Test.page().text("Price > desc Item").shown())
  Test.shot("sorted by Price, then by Item down: the order over the table, Item's mark at half")
  Test.page().button("Price").rightClick()
  Test.expect(page.sorts.equal([-1]) && tied(page) == "Copper Bar, Bronze Bar, Arcane Dust")
  Test.expect(Test.page().text("desc Item").shown())
  // A right click on a heading that sorts nothing does nothing.
  Test.page().button("Age").rightClick()
  Test.expect(page.sorts.equal([-1]))
  Test.page().button("Item").rightClick()
  Test.expect(page.sorts.length == 0 && !Test.page().text("desc Item").shown())
  destroy page
  Test.expect(Test.blank())
}

// A sale whose price isn't known: what `missing` says of the price's column.
function unpriced(sale: Sale, column: Integer): Boolean {
  return column == 2 && sale.price == 0
}

test "sortedBefore orders by each sort in turn, a negative one down, and a missing cell last either way" {
  const ash: Sale = { name: "Ash", price: 10, seen: 1 }
  const birch: Sale = { name: "Birch", price: 10, seen: 1 }
  const cedar: Sale = { name: "Cedar", price: 10, seen: 2 }
  const dust: Sale = { name: "Dust", price: 5, seen: 9 }
  const list: Array<Sale> = [ash, birch, cedar, dust]
  list.sort((a, b) => sortedBefore(a, b, [2, -3, -1], saleBefore))
  Test.expect(list.map(sale => sale.name).join(", ") == "Dust, Cedar, Birch, Ash")
  Test.expect(!sortedBefore(ash, ash, [1, 2, 3], saleBefore) && !sortedBefore(ash, birch, [], saleBefore))
  const elm: Sale = { name: "Elm", price: 0, seen: 4 }
  const priced: Array<Sale> = [elm, cedar, dust]
  priced.sort((a, b) => sortedBefore(a, b, [2], saleBefore, unpriced))
  Test.expect(priced.map(sale => sale.name).join(", ") == "Dust, Cedar, Elm")
  priced.sort((a, b) => sortedBefore(a, b, [-2], saleBefore, unpriced))
  Test.expect(priced.map(sale => sale.name).join(", ") == "Cedar, Dust, Elm")
}
