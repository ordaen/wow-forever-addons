// CountBadge: a count on its pill (the art's `countBadge`): bright digits in the numbers' font, with room round them,
// round for one digit, as wide as more need. The pill takes a tone of what it counts where one is given (a whisper's
// pink): the art made grey and tinted. What holds it places it, out of the flow, over a corner or an edge of what it
// counts.
import { Align, Bounds, Edges, TextWeight } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { BRIGHT_TEXT, SECONDARY_TEXT } from "@/units"

// Never narrower than the pill is high: round for one digit.
const WIDE: Bounds = { min: 25.78125dp, max: nil }
const PAD: Edges = { top: 1sp, right: 2sp, bottom: 1sp, left: 2sp }

public class CountBadge implements Component {
  derived toned: boolean = self.tone != nil

  count: Signal<integer>
  tone: Signal<Color | nil>
  constructor(
    count: Signal<integer>,
    // The pill's colour, the tone of what it counts; none: the art's own.
    tone: Signal<Color | nil> = nil
  ) {
    self.count = count
    self.tone = tone
  }

  public render(): Template {
    return $ltml {
      <box width={WIDE} padding={PAD} xAlign={Align::Center} yAlign={Align::Center}
           background={Ordaen.art.panel.countBadge} desaturate={self.toned} tint={self.tone}>
        <text value={"%d"} arguments={[self.count]} textSize={SECONDARY_TEXT} textColor={BRIGHT_TEXT} textFont={.Numbers}
              textWeight={TextWeight::Bold} leading={.Tight} wrap={.None} />
      </box>
    }
  }
}
