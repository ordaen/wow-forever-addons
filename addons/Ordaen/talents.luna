// A talent tree as the client lays it out (`Game.TalentTree`): its name and the points spent in it over its nodes, each
// drawn where the client puts it (its grid, from the tree's top left) with its rank, and the arrows from a node to
// those it leads to, gold where the one led to has a rank. A node clicked says so (Left: spend, Right: take back); what
// it may do is the client's to say (`canSpend`, `canRefund`), and a tree only shown (another player's) is not listened
// to. A search dims the nodes whose names don't hold it.
import Game from "$game"
import { Align, Event, MouseButton, Position } from "$ltml"
import { Component } from "@/module"
import { SECONDARY_TEXT } from "@/units"

// A node's size, and the room one step of the client's grid takes on the screen.
const SIZE = 46.875dp
const UNIT: Number<Length> = 0.087890625dp
const MARGIN = 9.375dp
// The thickness of an arrow's line.
const LINE = 3.515625dp
const GOLD: Color = Color.hex("#ffd100")
const GREEN: Color = Color.hex("#40d060")
const DIM: Color = Color.hex("#a3977f")
const EDGE: Color = Color.hex("#4a3a24")

// Where a tree's nodes begin: the smallest x or y.
function leastOf(nodes: Array<Game.TalentNode>, vertical: Boolean): Number {
  let least = Number.huge
  for (node of nodes) { least = least.min(vertical ? node.y : node.x) }
  return nodes.length == 0 ? 0 : least
}

// How far a tree reaches on the screen: its width or its height.
public function extentOf(nodes: Array<Game.TalentNode>, vertical: Boolean): Number<Length> {
  const first = leastOf(nodes, vertical)
  let most = first
  for (node of nodes) { most = most.max(vertical ? node.y : node.x) }
  return (most - first) * UNIT + SIZE + 2 * MARGIN
}

// A straight piece of an arrow, where it lies in its tree's box.
public struct ArrowPiece {
  left: Number<Length>
  top: Number<Length>
  width: Number<Length>
  height: Number<Length>
  // Gold where the node it leads to has a rank.
  color: Color
  // The frame level it is drawn at: the across piece under the down piece, which meet at the elbow.
  level: Integer
}

// The arrows of a tree: from the middle of a node, across and then down to the one it leads to.
public function arrowsOf(nodes: Array<Game.TalentNode>, leastX: Number, leastY: Number): Array<ArrowPiece> {
  const list: Array<ArrowPiece> = []
  for (node of nodes) {
    for (edge of node.edges) {
      for (target of nodes) {
        if (target.id == edge) {
          const fromX = (node.x - leastX) * UNIT + MARGIN + SIZE / 2
          const fromY = (node.y - leastY) * UNIT + MARGIN + SIZE / 2
          const toX = (target.x - leastX) * UNIT + MARGIN + SIZE / 2
          const toY = (target.y - leastY) * UNIT + MARGIN + SIZE / 2
          const color = target.rank > 0 ? GOLD : EDGE
          if ((toX - fromX).abs() >= 1ui) {
            list.push({ left: fromX.min(toX), top: fromY - LINE / 2, width: (toX - fromX).abs(), height: LINE, color: color, level: 0 })
          }
          if ((toY - fromY).abs() >= 1ui) {
            list.push({ left: toX - LINE / 2, top: fromY.min(toY), width: LINE, height: (toY - fromY).abs(), color: color, level: 1 })
          }
        }
      }
    }
  }
  return list
}

// The points spent in a tree.
public function spentIn(tree: Game.TalentTree): Integer {
  let sum = 0
  for (node of tree.nodes) { sum += node.rank }
  return sum
}

class TalentNodeView implements Component {
  public spend: Event<Integer> = new Event()
  public refund: Event<Integer> = new Event()

  derived lit: Boolean = self.search == "" || self.node.name.lower().contains(self.search.lower())
  derived opacity: Number = !self.lit ? 0.3 : self.node.rank == 0 && !self.node.canSpend ? 0.55 : 1
  derived rank: String = "%d/%d".format(self.node.rank, self.node.ranks)
  derived rankColor: Color = self.node.rank == self.node.ranks ? GOLD : self.node.canSpend ? GREEN : DIM
  derived left: Number<Length> = (self.node.x - self.leastX) * UNIT + MARGIN
  derived top: Number<Length> = (self.node.y - self.leastY) * UNIT + MARGIN

  node: Signal<Game.TalentNode>
  search: Signal<String>
  leastX: Signal<Number>
  leastY: Signal<Number>
  constructor(node: Signal<Game.TalentNode>, search: Signal<String>, leastX: Signal<Number>, leastY: Signal<Number>) {
    self.node = node
    self.search = search
    self.leastX = leastX
    self.leastY = leastY
  }

  onClick(mut self, click: Event.Press) {
    if (click.button == MouseButton.Right) {
      self.refund.emit(self.node.id)
    } else {
      self.spend.emit(self.node.id)
    }
  }

  public render(self): Template {
    return $ltml {
      <box position={Position.Absolute} left={self.left} top={self.top} width={SIZE} height={SIZE}
           border={{ width: 1.171875dp, color: EDGE }} icon={self.node.icon} opacity={self.opacity}
           xAlign={Align.End} yAlign={Align.End} @pointerPress={self.onClick}>
        <text value={self.rank} textSize={SECONDARY_TEXT} textColor={self.rankColor} wrap={.None} />
      </box>
    }
  }
}

public class TalentTreeView implements Component {
  public spend: Event<Integer> = new Event()
  public refund: Event<Integer> = new Event()

  derived title: String = `${self.tree.name}: ${spentIn(self.tree)}`
  derived leastX: Number = leastOf(self.tree.nodes, false)
  derived leastY: Number = leastOf(self.tree.nodes, true)
  derived width: Number<Length> = extentOf(self.tree.nodes, false)
  derived height: Number<Length> = extentOf(self.tree.nodes, true)
  derived arrows: Array<ArrowPiece> = arrowsOf(self.tree.nodes, self.leastX, self.leastY)

  tree: Signal<Game.TalentTree>
  search: Signal<String>
  constructor(tree: Signal<Game.TalentTree>, search: Signal<String> = "") {
    self.tree = tree
    self.search = search
  }

  onSpend(mut self, id: Integer) { self.spend.emit(id) }
  onRefund(mut self, id: Integer) { self.refund.emit(id) }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={2sp} xAlign={Align.Center}>
        <text value={self.title} textColor={GOLD} wrap={.None} />
        <box width={self.width} height={self.height}>
          <box $for={index, piece of self.arrows} $key={index} position={Position.Absolute} left={piece.left}
               top={piece.top} width={piece.width} height={piece.height} background={piece.color} zLevel={piece.level} />
          <TalentNodeView $for={node of self.tree.nodes} $key={node.id} node={node} search={self.search}
                          leastX={self.leastX} leastY={self.leastY} @spend={self.onSpend} @refund={self.onRefund} />
        </box>
      </box>
    }
  }
}
