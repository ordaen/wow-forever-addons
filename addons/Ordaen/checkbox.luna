// Checkbox: a boolean setting's row (SettingRow: its label, its hint, greyed while disabled) with a dark well with
// a bronze edge, a gold tick while on. Left-click toggles it; disabled, it takes no click.
import { Position } from "$ltml"
import { ARTWORK } from "@/art"
import { Component } from "@/module"
import { PX } from "@/units"
import { SettingRow } from "@/settingRow"

const SIZE = 22 * PX

public class Checkbox implements Component {
  label: Signal<String>
  value: mut Signal<Boolean>
  hint: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    label: Signal<String>,
    // The setting it shows and changes.
    value: mut Signal<Boolean>,
    hint: Signal<String> = "",
    disabled: Signal<Boolean> = false,
  ) {
    self.label = label
    self.value = value
    self.hint = hint
    self.disabled = disabled
  }

  toggle(mut self) {
    if (!self.disabled) { self.value = !self.value }
  }

  public render(self): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <box width={SIZE} height={SIZE} background={ARTWORK.ctl.check} @click={self.toggle}>
          <box $if={self.value} position={Position.Absolute} left={0} top={0} width={SIZE} height={SIZE}
               background={ARTWORK.ctl.tick} />
        </box>
      </SettingRow>
    }
  }
}
