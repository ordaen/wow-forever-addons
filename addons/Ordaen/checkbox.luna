// Checkbox: a boolean setting's row (SettingRow: its label, its hint, greyed while disabled) with a dark well with
// a bronze edge, a gold tick while on. Left-click toggles it; disabled, it takes no click.
import { Position } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { PX } from "@/units"
import { SettingRow } from "@/settingRow"
import { knobShown } from "@/switch"

const SIZE = 22 * PX

// Tick: the bare box of a checkbox, a dark well with a bronze edge and a gold tick while on: for a list's rows, where a
// settings row's label has no room. Left-click toggles it; disabled, it takes no click.
public class Tick implements Component {
  // The tick is always drawn, at no opacity while off: on and off differ in their colours alone.
  derived tick: Number = knobShown(self.value)

  value: mut Signal<Boolean>
  disabled: Signal<Boolean>
  constructor(value: mut Signal<Boolean>, disabled: Signal<Boolean> = false) {
    self.value = value
    self.disabled = disabled
  }

  toggle(mut self) {
    self.value = !self.value
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.disabled} width={SIZE} height={SIZE} background={Ordaen.art.ctl.check} opacity={0.45}>
        <box position={Position.Absolute} left={0} top={0} width={SIZE} height={SIZE}
             background={Ordaen.art.ctl.tick} opacity={self.tick} />
      </box>
      <box $else width={SIZE} height={SIZE} background={Ordaen.art.ctl.check} @click={self.toggle}>
        <box position={Position.Absolute} left={0} top={0} width={SIZE} height={SIZE}
             background={Ordaen.art.ctl.tick} opacity={self.tick} />
      </box>
    }
  }
}

public class Checkbox implements Component {
  // The tick is always drawn, at no opacity while off: on and off differ in their colours alone.
  derived tick: Number = knobShown(self.value)

  label: Signal<String>
  value: mut Signal<Boolean>
  hint: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    label: Signal<String>,
    // The setting it shows and changes.
    value: mut Signal<Boolean>,
    hint: Signal<String> = "",
    disabled: Signal<Boolean> = false,
  ) {
    self.label = label
    self.value = value
    self.hint = hint
    self.disabled = disabled
  }

  toggle(mut self) {
    if (!self.disabled) { self.value = !self.value }
  }

  public render(self): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <box width={SIZE} height={SIZE} background={Ordaen.art.ctl.check} @click={self.toggle}>
          <box position={Position.Absolute} left={0} top={0} width={SIZE} height={SIZE}
               background={Ordaen.art.ctl.tick} opacity={self.tick} />
        </box>
      </SettingRow>
    }
  }
}
