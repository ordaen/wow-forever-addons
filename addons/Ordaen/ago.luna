// How long ago a moment was, as a list or a card says it: «5 min ago» (never under one minute), «3 h ago», «2 d ago».
// `agoText` reads a moment of the realm's clock (`Game.clock.server`, seconds since 1970), `hoursAgoText` a number of
// hours the client gives (a guild member's last time online).
import Game from "$game"
import Locale from "@/locales"

const MINUTE = 60
const HOUR = 3600
const DAY = 86400

public function agoText(moment: Number): String {
  const passed = (Game::clock.server - moment).max(0)
  if (passed < HOUR) { return Locale::AGO_MINUTES.format((passed / MINUTE).floor().max(1)) }
  if (passed < DAY) { return Locale::AGO_HOURS.format((passed / HOUR).floor()) }
  return Locale::AGO_DAYS.format((passed / DAY).floor())
}

public function hoursAgoText(hours: Integer): String {
  if (hours < 24) { return Locale::AGO_HOURS.format(hours) }
  return Locale::AGO_DAYS.format((hours / 24).floor())
}
