// A word by its number, in the game's language: a locale writes three forms of a key (`_ONE`, `_FEW`, `_MANY`) and
// this picks one. Russian has three: one (1, 21, 101), a few (2-4, 22-24) and many (the rest, 11-14 among them);
// English two, one for 1 and the many form for any other number (its few form is the many form written again).
import Game from "$game"

// The form's place for `n` in a language: 1 one, 2 a few, 3 many.
public function formIn(locale: String, n: Integer): Integer {
  if (locale != "ruRU") { return n == 1 ? 1 : 3 }
  const ones = n % 10
  const tens = n % 100
  if (ones == 1 && tens != 11) { return 1 }
  if (ones >= 2 && ones <= 4 && (tens < 12 || tens > 14)) { return 2 }
  return 3
}

// The form of the three for `n`, in the game's language.
public function plural(n: Integer, one: String, few: String, many: String): String {
  return match (formIn(Game.client.locale, n)) {
    1 => one,
    2 => few,
    else => many,
  }
}
