// Ordaen Settings: the one settings window. Ordaen's own page (General: the settings every module follows) and
// every module in the list on the left with its switch, the chosen one's page beside it: its tabs, and the picked
// tab's rows, which are the module's own. Every change applies at once: the foot's «Точка» makes
// a savepoint, and «Откатить» goes back to the step before the last change, to the session's start or to a savepoint.
// Closing asks nothing.
import { Align, Edges, Overflow, Position, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Dialog } from "@/dialog"
import { BehaviourPage, NumbersPage, ScalePage } from "@/general"
import { POINTS_MOST, changeText, modulesText } from "@/keeper"
import { ListTab } from "@/listTab"
import Locale from "@/locales"
import { LookPage } from "@/lookPage"
import { Menu, MenuEntry } from "@/menu"
import { Component, Entry, SettingsPage } from "@/module"
import { ModuleEntry, ModuleRow } from "@/moduleRow"
import { MAX_NAME, named } from "@/profiles"
import { ProfilesPage } from "@/profilesPage"
import { PushButton } from "@/pushButton"
import { Tabs } from "@/tabs"
import { TextField } from "@/textField"
import { TipText } from "@/tip"
import { SECONDARY_TEXT } from "@/units"
import { FOOTER_ROOM, KeptWindow, Window, WindowTabSpec } from "@/window"
import { WindowsPage } from "@/windowsPage"

// The window's body at first, and the smallest it resizes to: the list, a row and the foot fit, and no narrower than
// the widest page needs (the action bars' page: its list of bars beside the picked bar's rows), so no page squeezes.
const WIDTH = 1378.125dp + 16.5ui
const HEIGHT = 820.3125dp
const MIN_WIDTH = WIDTH
const MIN_HEIGHT = 562.5dp
// The pages that aren't a module's: Ordaen's own, its look and its profiles.
const GENERAL = ""
const LOOK = "look"
const PROFILES = "profiles"

// The question of a savepoint's profile name: as wide as its field, the room round it and its frame.
const ASK_WIDTH = 567.1875dp
// The history's menu: «Начало сессии · 12 настроек, Панель, Подсказки, Ordaen» on one line.
const MENU_WIDTH = 515.625dp
const FULL_TIP: TipText = { title: Locale::HISTORY_POINT, text: Locale::HISTORY_POINT_FULL.format(POINTS_MOST), rows: [] }

const DIM: Color = Color::hex("#a3977f")
const INK: Color = Color::hex("#e8dcc4")
const PAGE_BACK: Color = Color::hex("#00000040")
const FILL: array<Track> = [{ fr: 1 }]
const BODY: array<Track> = ["max-content", { fr: 1 }]
// The list's heading over the modules: a panel's step from the list's sides and the rows above, an item's to the
// modules under it.
const HEADING: Edges = { top: 5sp, right: 5sp, bottom: 3sp, left: 5sp }
// The footer: the placing mode at its left, a hint, «Точка» and «Откатить» at its right.
const FOOT: array<Track> = ["max-content", { fr: 1 }, "max-content"]
const BACK_ROW: array<Track> = ["max-content", "max-content"]

public class SettingsWindow implements Component {
  // The window, declared: where it stands and what the player does with it, kept in the profile.
  public window: mut KeptWindow = new KeptWindow("settings", Locale::WINDOW_SETTINGS, { x: 0ui, y: 0ui, width: WIDTH, height: HEIGHT })
  public const windows: mut array<mut KeptWindow> = [self.window]
  // Ordaen's own page: the settings every module follows, and its window's.
  public const pages: array<SettingsPage> = [
    { title: Locale::GLOBAL_TAB_SCALE, content: $ltml { <ScalePage globals={mut Ordaen.globals} /> } },
    { title: Locale::GLOBAL_TAB_NUMBERS, content: $ltml { <NumbersPage globals={mut Ordaen.globals} /> } },
    { title: Locale::GLOBAL_TAB_BEHAVIOR, content: $ltml { <BehaviourPage globals={mut Ordaen.globals} /> } },
    { title: Locale::WINDOWS_TAB, content: $ltml { <WindowsPage windows={mut self.windows} /> } }
  ]

  state open = false
  // The page shown: Ordaen's own, its look, or a module's folder; and its tab.
  state page = GENERAL
  state tab = 1
  state titles: array<WindowTabSpec> = [{ title: Ordaen.title }]
  state titleTab = 1
  // «Откатить»'s menu: open, its entries, and the savepoint whose entries it shows (0: its own).
  state menuOpen = false
  state menuEntries: array<MenuEntry> = []
  state pointShown = 0
  // The savepoint a profile is being made of (0: none), the name typed for it and what was wrong with it.
  state naming = 0
  state profileName = ""
  state nameFault = ""

  const nothing: Template = $ltml {}
  const footer: Template = $ltml {
    <box padding={FOOTER_ROOM} columns={FOOT} yAlign={Align::Center} gap={6sp}>
      <PushButton label={Locale::PLACING} width={234.375dp} @click={self.placingMode} />
      <box>
        <text value={self.hint} textColor={DIM} textSize={SECONDARY_TEXT} />
      </box>
      <box columns={BACK_ROW} gap={3sp}>
        <PushButton label={Locale::HISTORY_POINT} width={152.34375dp} disabled={self.pointsFull} tip={self.pointTip}
                    @click={self.mark} />
        <box>
          <PushButton label={Locale::ROLLBACK} width={164.0625dp} disabled={self.nothingBack} @click={self.openMenu} />
          <Menu $if={self.menuOpen} entries={self.menuEntries} width={MENU_WIDTH} @pick={self.onMenuPick}
                @close={self.closeMenu} />
        </box>
      </box>
    </box>
  }
  derived hint: string = Ordaen.keeper.steps == 0 ? Locale::HISTORY_APPLY : Locale::HISTORY_COUNT.format(Ordaen.keeper.steps)
  derived nothingBack: boolean = Ordaen.keeper.steps == 0 && Ordaen.keeper.points == 0
  derived pointsFull: boolean = Ordaen.keeper.points >= POINTS_MOST
  derived pointTip: TipText | nil = self.pointsFull ? FULL_TIP : nil
  derived asksName: boolean = self.naming > 0
  derived hasNameFault: boolean = self.nameFault != ""
  derived heading: string = Locale::LIST_MODULES.upper()
  derived onGeneral: boolean = self.page == GENERAL
  derived onLook: boolean = self.page == LOOK
  derived onProfiles: boolean = self.page == PROFILES
  // The module whose page is shown, where it is a module's.
  derived entry: any Entry | nil = self.entryOf()
  derived isOff: boolean = self.offNow()
  derived shown: array<SettingsPage> = self.pagesOf()
  derived names: array<string> = self.namesOf()
  derived hasTabs: boolean = self.names.length > 1
  derived content: Template = self.contentOf()

  // Every module the player has, on or off: each addon that needs Ordaen, as the client lists them.
  const entries: array<ModuleEntry>

  entryOf(): any Entry | nil {
    for (entry of self.entries) {
      if (entry.folder == self.page) { return entry }
    }
    return nil
  }

  offNow(): boolean {
    let entry = self.entry
    if (entry == nil) { return false }
    return !entry.on
  }

  pagesOf(): array<SettingsPage> {
    let entry = self.entry
    if (entry == nil) { return self.pages }
    return entry.pages
  }

  namesOf(): array<string> {
    let list: array<string> = []
    for (page of self.shown) { list.push(page.title) }
    return list
  }

  contentOf(): Template {
    let page = self.shown[self.tab]
    if (page == nil) { return self.nothing }
    return page.content
  }

  constructor() {
    self.entries = Ordaen.moduleAddons().map(addon => new ModuleEntry(addon))
    // The placing mode started from the window ends as it closes: its button is the mode's only way out, and the
    // places are kept as each part is let go.
    watch (open of self.open) {
      if (!open && peek Ordaen.placing) { Ordaen.togglePlacing() }
    }
  }

  // `page` is Ordaen's own page (`""` or its name), or a module's folder; one that is neither (the player's
  // `/ordaen` with a name no module has) is Ordaen's own, so the list always marks the page shown.
  public mut toggle(asked: string) {
    const page = self.known(asked) ? asked : GENERAL
    if (self.open && self.page == page) {
      self.onClose()
      return
    }
    self.show(page)
    self.open = true
  }

  known(page: string): boolean {
    if (page == GENERAL || page == LOOK || page == PROFILES) { return true }
    for (entry of self.entries) {
      if (entry.folder == page) { return true }
    }
    return false
  }

  mut show(page: string) {
    Ordaen.keeper.finishInput()
    if (self.page != page) {
      self.page = page
      self.tab = 1
    }
  }

  mut pickGeneral() { self.show(GENERAL) }
  mut pickLook() { self.show(LOOK) }
  mut pickProfiles() { self.show(PROFILES) }
  mut onPick(folder: string) { self.show(folder) }

  // Every change is kept as it is made: closing asks nothing.
  mut onClose() {
    Ordaen.keeper.finishInput()
    self.menuOpen = false
    self.open = false
  }

  mut placingMode() { Ordaen.togglePlacing() }

  // «Точка»: every setting as it is now.
  mut mark() { _ = Ordaen.keeper.mark() }

  // The menu's entries are worked out as it opens: what each place back would change now.
  mut openMenu() {
    self.pointShown = 0
    self.menuEntries = self.backEntries()
    self.menuOpen = true
  }

  mut closeMenu() {
    self.menuOpen = false
    self.pointShown = 0
  }

  // «Последнее изменение», «Начало сессии», then a row per savepoint.
  mut backEntries(): array<MenuEntry> {
    const list: array<MenuEntry> = []
    const last = Ordaen.keeper.lastModules()
    if (last.length == 0) {
      list.push({ label: Locale::HISTORY_LAST_NONE, on: nil, disabled: true, group: nil })
    } else {
      list.push({ label: Locale::HISTORY_LAST.format(modulesText(last)), on: nil, disabled: nil, group: nil })
    }
    const start = Ordaen.keeper.startChange()
    if (start.count == 0) {
      list.push({ label: Locale::HISTORY_START_NONE, on: nil, disabled: true, group: nil })
    } else {
      list.push({ label: Locale::HISTORY_START.format(changeText(start)), on: nil, disabled: nil, group: nil })
    }
    const points = Ordaen.keeper.pointList()
    if (points.length == 0) {
      list.push({ label: Locale::HISTORY_POINTS_NONE, on: nil, disabled: true, group: true })
    }
    for (index, point of points) {
      const change = Ordaen.keeper.changeTo(point.sections)
      const changes = change.count == 0 ? Locale::HISTORY_UNCHANGED : changeText(change)
      const name = Locale::HISTORY_POINT_NAME.format(point.number)
      list.push({ label: Locale::HISTORY_POINT_ROW.format(name, point.at, changes), on: nil, disabled: nil, group: index == 1 })
    }
    return list
  }

  // A savepoint's own entries: back to it (greyed where it changes nothing), a profile of it, let it go.
  mut pointEntries(index: integer): array<MenuEntry> {
    const point = Ordaen.keeper.pointList()[index]
    const same = point == nil || Ordaen.keeper.changeTo(point.sections).count == 0
    return [
      { label: Locale::HISTORY_TO_POINT, on: nil, disabled: same, group: nil },
      { label: Locale::HISTORY_SAVE_PROFILE, on: nil, disabled: nil, group: nil },
      { label: Locale::HISTORY_DELETE_POINT, on: nil, disabled: nil, group: nil }
    ]
  }

  mut onMenuPick(index: integer) {
    const point = self.pointShown
    if (point > 0) {
      self.closeMenu()
      if (index == 1) {
        Ordaen.keeper.toPoint(point)
      } else if (index == 2) {
        self.naming = point
        self.profileName = ""
        self.nameFault = ""
      } else {
        Ordaen.keeper.unmark(point)
      }
      return
    }
    if (index == 1) {
      self.closeMenu()
      Ordaen.keeper.undo()
    } else if (index == 2) {
      self.closeMenu()
      Ordaen.keeper.toStart()
    } else {
      // A savepoint's row opens its own entries in the menu's place.
      self.pointShown = index - 2
      self.menuEntries = self.pointEntries(index - 2)
    }
  }

  mut stopNaming() { self.naming = 0 }

  // The savepoint made a profile under the name typed: refused where it is empty, too long or taken.
  mut saveProfile() {
    const name = named(self.profileName)
    if (name == nil) {
      self.nameFault = self.profileName == "" ? Locale::PROFILES_ERR_NAME_EMPTY : Locale::PROFILES_ERR_NAME_LONG.format(MAX_NAME)
      return
    }
    const point = Ordaen.keeper.pointList()[self.naming]
    if (point == nil) {
      self.naming = 0
      return
    }
    if (!Ordaen.keeper.profiles.makeOf(name, point.sections)) {
      self.nameFault = Locale::PROFILES_ERR_NAME_TAKEN.format(name)
      return
    }
    self.naming = 0
  }

  public render(): Template {
    return $ltml {
      <Window shown={self.open} tabs={self.titles} selected={mut self.titleTab} declared={mut self.window}
              minWidth={MIN_WIDTH} minHeight={MIN_HEIGHT} footer={self.footer} @close={self.onClose}>
        <box columns={BODY} rows={FILL} gap={6sp}>
          <box columns={1}>
            <ListTab label={Locale::LIST_GLOBAL} icon={Ordaen.icon} selected={self.onGeneral}
                     @pick={self.pickGeneral} />
            <ListTab label={Locale::LIST_THEMES} icon={Ordaen.icon} selected={self.onLook}
                     @pick={self.pickLook} />
            <ListTab label={Locale::LIST_PROFILES} icon={Ordaen.icon} selected={self.onProfiles}
                     @pick={self.pickProfiles} />
            <box padding={HEADING}>
              <text value={self.heading} textColor={DIM} textSize={SECONDARY_TEXT} textFont={.Numbers} />
            </box>
            <box columns={1}>
              <ModuleRow $for={entry of self.entries} entry={peek entry} shown={self.page} @pick={self.onPick} />
            </box>
          </box>
          <box background={PAGE_BACK}>
            <box position={Position::Absolute} left={0ui} right={0ui} top={0ui} bottom={0ui}
                 padding={5sp} columns={1} gap={6sp} overflow={Overflow::Scroll}>
              <LookPage $if={self.onLook} look={mut Ordaen.look} />
              <ProfilesPage $elseif={self.onProfiles} />
              <text $elseif={self.isOff} value={Locale::MODULE_OFF} textColor={DIM} />
              <$else>
                <Tabs $if={self.hasTabs} tabs={self.names} selected={mut self.tab} />
                <box columns={1} gap={6sp}>
                  {self.content}
                </box>
              </>
            </box>
          </box>
        </box>
      </Window>
      <Dialog $if={self.asksName} title={Locale::HISTORY_PROFILE_TITLE} width={ASK_WIDTH}>
        <TextField label={Locale::PROFILES_NAME} value={mut self.profileName} maxLength={MAX_NAME} />
        <text $if={self.hasNameFault} value={self.nameFault} textColor={Ordaen.look.values.redText} />
        <PushButton #buttons label={Locale::CANCEL} width={140.625dp} @click={self.stopNaming} />
        <PushButton #buttons label={Locale::SAVE} width={164.0625dp} @click={self.saveProfile} />
      </Dialog>
    }
  }
}
