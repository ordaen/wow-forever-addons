-- «Bags» selected, without a colour: the gold fill and edge; no rule over the first
box 0,0 300x79
  box 0,0 300x25.78 #d6a56b3d clipped @keyPress @pointerPress
    box 0,0 1.67x25.78 absolute #f0c860
    text 14.22,5.69 244.44x14.4 "Bags" #ffffff
    text 265.78,5.69 20x14.4 "[2]" #ffffff
  box 0,25.78 300x26.61 #00000000 clipped @keyPress @pointerPress
    text 14.22,32.3 271.56x14.4 "Linen Cloak" #ffffff
  box 0,52.39 300x26.61 #00000000 clipped @keyPress @pointerPress
    text 14.22,58.91 271.56x14.4 "Brown Linen Vest" #ffffff

