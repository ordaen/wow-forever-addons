-- «Bags» selected, without a colour: the gold fill and edge; no rule over the first
box 0,0 300x86.2
  box 0,0 300x28.18 #d6a56b3d clipped @keyPress @pointerPress
    box 0,0 1.67x28.18 absolute #f0c860
    text 14.22,5.69 241.11x16.8 "Bags" #ffffff
    text 262.44,5.69 23.33x16.8 "[2]" #ffffff
  box 0,28.18 300x29.01 #00000000 clipped @keyPress @pointerPress
    text 14.22,34.7 271.56x16.8 "Linen Cloak" #ffffff
  box 0,57.19 300x29.01 #00000000 clipped @keyPress @pointerPress
    text 14.22,63.71 271.56x16.8 "Brown Linen Vest" #ffffff

