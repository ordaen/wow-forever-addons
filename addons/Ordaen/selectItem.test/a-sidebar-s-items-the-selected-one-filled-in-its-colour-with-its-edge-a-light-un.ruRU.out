-- «Bags» selected, without a colour: the gold fill and edge; no rule over the first
box 0,0 300x82.6
  box 0,0 300x26.98 #d6a56b3d clipped @keyPress @pointerPress
    box 0,0 1.67x26.98 absolute #f0c860
    text 14.22,5.69 242.22x15.6 "Bags" #ffffff
    text 263.56,5.69 22.22x15.6 "[2]" #ffffff
  box 0,26.98 300x27.81 #00000000 clipped @keyPress @pointerPress
    text 14.22,33.5 271.56x15.6 "Linen Cloak" #ffffff
  box 0,54.79 300x27.81 #00000000 clipped @keyPress @pointerPress
    text 14.22,61.31 271.56x15.6 "Brown Linen Vest" #ffffff

