// PushButton: our push button, the bronze plate three-sliced from its art, or the red one (`plate`: `.Accent` for a
// button that matters, `.Danger` for one that can't be undone, which Enter never presses: the keyboard's Space
// does, and the mouse); the art's hover glow over it under the cursor, its pushed row while pressed. The label in gold, white
// under the cursor, with a dark drop; disabled, the grey plate and a grey label, and no click. With an `action` it
// is a secure box: the client does the action from the player's click (a spell, an item, a macro). With a `tip`, a Tip
// says it while the cursor is on it. With an `icon`, a picture of the game's stands before the label, or alone where the
// label is `""` (a square button, which its `tip` names); disabled, the picture greys with the label. With a `key`, the
// key that presses it sits in its own segment at the plate's left end, cut off by a groove.
import { Action, Align, Art, ByInteractionState, Columns, Event, Line, MouseButton, Shadow, Side, Size } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { Tip, TipText } from "@/tip"
import { BRIGHT_TEXT, SECONDARY_TEXT } from "@/units"

const HEIGHT = 39.84375dp
// The plate's rim, part of its art: button.tga's rows are 64 px high and its caps drawn at the button's height (cap 32,
// capHeight 0.5), so a px is HEIGHT / 64; the carved line round the face stands 14 px in from each end, the face from
// 15. The plate's columns keep the rim clear; inside it the label keeps a gap more, at the spacing setting's measure. A
// label longer than the width it was given widens the button.
const RIM: Number<Length> = HEIGHT * 15 / 64
const PLATE: Columns = [RIM, { fr: 1 }, RIM]
// A glyph's button (one sign, or an icon alone) holds it centred, clear of the rim already, at the width it was given:
// the rim takes no column of it and nothing in it widens it.
const GLYPH_PLATE: Columns = [{ fr: 1 }]
// The gap between the rim, the key's segment and the label, at the spacing setting's measure.
const GAP: Number<Spacing> = 1.25sp
const LABEL: ByInteractionState<Color> = { default: Color.hex("#ffd100"), hover: BRIGHT_TEXT, focus: BRIGHT_TEXT }
const GREY: Color = Color.hex("#808080")
// The picture: inside the plate's carved line, as the label is.
const ICON: Number<Length> = HEIGHT / 2
const ICON_GAP: Number<Spacing> = 1.25sp
const ICON_ROW: Columns = { each: "max-content" }
const SHADOW: Shadow = { color: Color.hex("#000000"), x: 1.171875dp, y: -1.171875dp }
const NO_TIP: TipText = { title: "", text: "", rows: [] }
// The key's segment: at the plate's left end past its rim, a groove (a dark line) at its right; the label
// stands in the plate's other column, past it, so the two can't meet at any spacing.
const KEY_WIDTH = 53.90625dp
const KEY_HEIGHT = HEIGHT * 3 / 4
const KEYED_PLATE: Columns = [RIM, KEY_WIDTH, { fr: 1 }, RIM]
const KEY_SHADE: Color = Color.hex("#00000038")
const KEY_TEXT: Color = Color.hex("#c9a76a")
const GROOVE: Line = { width: 1.171875dp, color: Color.hex("#000000cc"), sides: [Side.Right] }
// The space bar's mark «⎵», drawn as its three strokes (no texture of it: general/art-needed).
const SPACE_WIDTH = 18.75dp
const SPACE_HEIGHT = 5.859375dp
const SPACE_STROKES: Line = { width: 1.7578125dp, color: KEY_TEXT, sides: [Side.Left, Side.Bottom, Side.Right] }

// The plate: bronze, or red for a button that matters or one that can't be undone.
public enum ButtonPlate { Bronze, Accent, Danger }

// The key that presses a button, drawn in its segment: by its name («Esc»), or the space bar by its mark «⎵» (its
// name is wider than the segment in many languages); none for none.
public enum ButtonKey {
  Named { name: String }
  Space
  None
}

public class PushButton implements Component {
  public click: Event<nil> = new Event()

  derived art: Art = self.disabled ? Ordaen.art.ctl.buttonDisabled : self.plate == .Bronze ? Ordaen.art.ctl.button : Ordaen.art.ctl.buttonAccent
  derived color: Color | ByInteractionState<Color> = self.disabled ? GREY : LABEL
  // Disabled, it does nothing.
  derived doing: Action | nil = self.disabled ? nil : self.action
  derived repeating: Boolean = self.repeats && !self.disabled
  state hovered = false
  derived tipShown: Boolean = self.hovered && self.tip != nil
  derived tipText: TipText = self.tip ?? NO_TIP
  derived labelled: Boolean = self.label != ""
  derived iconed: Boolean = self.icon != nil
  derived iconTint: Color = self.disabled ? GREY : BRIGHT_TEXT
  derived keyed: Boolean = self.key != ButtonKey.None
  derived keyName: String = self.nameOfKey()
  derived spaceMarked: Boolean = self.key == ButtonKey.Space
  derived keyOpacity: Number = self.disabled ? 0.5 : 1
  derived glyphed: Boolean = self.glyph || self.iconed && !self.labelled
  derived columns: Columns = self.glyphed ? GLYPH_PLATE : self.keyed ? KEYED_PLATE : PLATE
  derived size: Size = self.glyphed ? self.width : { min: self.width }
  derived rimmed: Boolean = !self.glyphed

  label: Signal<String>
  width: Signal<Number<Length>>
  plate: Signal<ButtonPlate>
  disabled: Signal<Boolean>
  action: Signal<Action | nil>
  repeats: Signal<Boolean>
  tip: Signal<TipText | nil>
  icon: Signal<Art | nil>
  key: Signal<ButtonKey>
  glyph: Signal<Boolean>
  constructor(
    label: Signal<String>,
    width: Signal<Number<Length>>,
    plate: Signal<ButtonPlate> = ButtonPlate.Bronze,
    disabled: Signal<Boolean> = false,
    action: Signal<Action | nil> = nil,
    // Held down, its click comes again until it is let go or disabled (a stepper's − and +).
    repeats: Signal<Boolean> = false,
    // What a Tip says of it under the cursor (its keys); none for none.
    tip: Signal<TipText | nil> = nil,
    // A picture before the label, or alone where the label is `""`.
    icon: Signal<Art | nil> = nil,
    // The key that presses it, in its own segment at the plate's left end, cut off by a groove.
    key: Signal<ButtonKey> = ButtonKey.None,
    // Its label one sign (a stepper's − and +): held at the width it was given, as a button with an icon alone is.
    glyph: Signal<Boolean> = false
  ) {
    self.icon = icon
    self.key = key
    self.glyph = glyph
    self.label = label
    self.width = width
    self.plate = plate
    self.disabled = disabled
    self.action = action
    self.repeats = repeats
    self.tip = tip
  }

  // One that repeats is clicked as the button goes down and again while it is held; another as it is let go.
  onClick(mut self) {
    if (!self.disabled && !self.repeats) { self.click.emit() }
  }

  // Enter presses any but a danger button.
  onEnterKey(mut self) {
    if (self.plate != .Danger) { self.onClick() }
  }

  // The left button with any modifier: Shift and Ctrl make the step larger (`stride`).
  onHeld(mut self, pointer: Event.Press) {
    if (self.repeating && pointer.button == MouseButton.Left) { self.click.emit() }
  }

  nameOfKey(self): String {
    const key = self.key
    return key is ButtonKey.Named ? key.name : ""
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box width={self.size} height={HEIGHT} columns={self.columns} gap={GAP} xAlign={Align.Center}
           yAlign={Align.Center}
           background={self.art} action={self.doing} @pointerPress={self.onClick} @keyPress(.Enter)={self.onEnterKey} @keyPress(.Space)={self.onClick} @pointerDown.repeat={self.onHeld}
           @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <Tip $if={self.tipShown} title={self.tipText.title} text={self.tipText.text} rows={self.tipText.rows} />
        <box $if={self.rimmed} />
        <box $if={self.keyed} width={KEY_WIDTH} height={KEY_HEIGHT} background={KEY_SHADE} border={GROOVE} opacity={self.keyOpacity} xAlign={Align.Center}
             yAlign={Align.Center}>
          <box $if={self.spaceMarked} width={SPACE_WIDTH} height={SPACE_HEIGHT} border={SPACE_STROKES} />
          <text $else value={self.keyName} textColor={KEY_TEXT} textSize={SECONDARY_TEXT} wrap={.None} />
        </box>
        <box $if={self.iconed} columns={ICON_ROW} gap={ICON_GAP} yAlign={Align.Center}>
          <box width={ICON} height={ICON} icon={self.icon} tint={self.iconTint} />
          <text $if={self.labelled} value={self.label} textColor={self.color} textShadow={SHADOW} wrap={.None} />
        </box>
        <text $else value={self.label} textColor={self.color} textShadow={SHADOW} wrap={.None} />
        <box $if={self.rimmed} />
      </box>
    }
  }
}
