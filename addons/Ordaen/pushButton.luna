// PushButton: our push button, the bronze plate three-sliced from its art, or the red one (`plate`: `.Accent` for a
// button that matters, `.Danger` for one that can't be undone, which Enter never presses: the keyboard's Space
// does, and the mouse); the art's hover glow over it under the cursor, its pushed row while pressed. The label in gold, white
// under the cursor, with a dark drop; disabled, the grey plate and a grey label, and no click. With an `action` it
// is a secure box: the client does the action from the player's click (a spell, an item, a macro). With a `tip`, a Tip
// says it while the cursor is on it. With an `icon`, a picture of the game's stands before the label, or alone where the
// label is `""` (a square button, which its `tip` names); disabled, the picture greys with the label.
import { Action, Align, Art, ByInteractionState, Columns, Edges, Event, MouseButton, Shadow } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { Tip, TipText } from "@/tip"

const HEIGHT = 39.84375dp
// The label keeps inside the carved line round the plate's face (in the art, 14 of the 64 px a row is high in from
// each end, the face from 15): a quarter of the height off each end, about 10dp. A label longer than the width it
// was given widens the button.
const CAPS: Edges = { left: 2.5sp, right: 2.5sp }
const LABEL: ByInteractionState<Color> = { default: Color.hex("#ffd100"), hover: Color.hex("#ffffff"), focus: Color.hex("#ffffff") }
const GREY: Color = Color.hex("#808080")
const WHITE: Color = Color.hex("#ffffff")
// The picture: inside the plate's carved line, as the label is.
const ICON: Number<Length> = HEIGHT / 2
const ICON_GAP: Number<Spacing> = 1.25sp
const ICON_ROW: Columns = { each: "max-content" }
const SHADOW: Shadow = { color: Color.hex("#000000"), x: 1.171875dp, y: -1.171875dp }
const NO_TIP: TipText = { title: "", text: "", rows: [] }

// The plate: bronze, or red for a button that matters or one that can't be undone.
public enum ButtonPlate { Bronze, Accent, Danger }

public class PushButton implements Component {
  public click: Event<nil> = new Event()

  derived art: Art = self.disabled ? Ordaen.art.ctl.buttonDisabled : self.plate == .Bronze ? Ordaen.art.ctl.button : Ordaen.art.ctl.buttonAccent
  derived color: Color | ByInteractionState<Color> = self.disabled ? GREY : LABEL
  // Disabled, it does nothing.
  derived doing: Action | nil = self.disabled ? nil : self.action
  derived repeating: Boolean = self.repeats && !self.disabled
  state hovered = false
  derived tipShown: Boolean = self.hovered && self.tip != nil
  derived tipText: TipText = self.tip ?? NO_TIP
  derived labelled: Boolean = self.label != ""
  derived iconed: Boolean = self.icon != nil
  derived iconTint: Color = self.disabled ? GREY : WHITE

  label: Signal<String>
  width: Signal<Number<Length>>
  plate: Signal<ButtonPlate>
  disabled: Signal<Boolean>
  action: Signal<Action | nil>
  repeats: Signal<Boolean>
  tip: Signal<TipText | nil>
  icon: Signal<Art | nil>
  constructor(
    label: Signal<String>,
    width: Signal<Number<Length>>,
    plate: Signal<ButtonPlate> = ButtonPlate.Bronze,
    disabled: Signal<Boolean> = false,
    action: Signal<Action | nil> = nil,
    // Held down, its click comes again until it is let go or disabled (a stepper's − and +).
    repeats: Signal<Boolean> = false,
    // What a Tip says of it under the cursor (its keys); none for none.
    tip: Signal<TipText | nil> = nil,
    // A picture before the label, or alone where the label is `""`.
    icon: Signal<Art | nil> = nil
  ) {
    self.icon = icon
    self.label = label
    self.width = width
    self.plate = plate
    self.disabled = disabled
    self.action = action
    self.repeats = repeats
    self.tip = tip
  }

  // One that repeats is clicked as the button goes down and again while it is held; another as it is let go.
  onClick(mut self) {
    if (!self.disabled && !self.repeats) { self.click.emit() }
  }

  // Enter presses any but a danger button.
  onEnterKey(mut self) {
    if (self.plate != .Danger) { self.onClick() }
  }

  // The left button with any modifier: Shift and Ctrl make the step larger (`stride`).
  onHeld(mut self, pointer: Event.Press) {
    if (self.repeating && pointer.button == MouseButton.Left) { self.click.emit() }
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box width={{ min: self.width }} height={HEIGHT} padding={CAPS} xAlign={Align.Center} yAlign={Align.Center}
           background={self.art} action={self.doing} @pointerPress={self.onClick} @keyPress(.Enter)={self.onEnterKey} @keyPress(.Space)={self.onClick} @pointerDown.repeat={self.onHeld}
           @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <Tip $if={self.tipShown} title={self.tipText.title} text={self.tipText.text} rows={self.tipText.rows} />
        <box $if={self.iconed} columns={ICON_ROW} gap={ICON_GAP} yAlign={Align.Center}>
          <box width={ICON} height={ICON} icon={self.icon} tint={self.iconTint} />
          <text $if={self.labelled} value={self.label} textColor={self.color} textShadow={SHADOW} wrap={false} />
        </box>
        <text $else value={self.label} textColor={self.color} textShadow={SHADOW} wrap={false} />
      </box>
    }
  }
}
