// The settings window on a client in Russian: its list's names, its pages' labels and hints are longer than in
// English, and the window holds them whole, as the check of every shot says (nothing stands past its box).
import { Key } from "$ltml"
import Test from "$test"
import { Move } from "$test"
import root Ordaen from "Ordaen"

test "the settings window's list and its pages hold their Russian words whole" {
  Test.mount(nil, { left: 0, top: 0, width: 1600, height: 900, screen: true })
  Test.open("Ordaen")
  Test.expect(Ordaen.window?.open == true)
  Test.shot("opened: the list and the general page")
  Test.key(Move.Next)
  Test.key(Key.Enter)
  Test.shot("the themes")
  Test.key(Move.Next)
  Test.key(Key.Enter)
  Test.shot("the profiles")
}
