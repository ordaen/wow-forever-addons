// One way every Ordaen addon writes into the chat: its mark (its name, in its colour) and the line, printed as the
// chat prints any line, so Ordaen Chat's window and the game's show it alike.
import Game from "$game"
import { BRIGHT_TEXT } from "@/units"

// What an addon's lines begin with: its name and its colour.
public struct ChatMark {
  public name: string
  public color: color
}

// A colour as the chat's codes write it (`ffe8c35a`).
function codeOf(color: color): string {
  return "ff%02x%02x%02x".format((color.r * 255).round(), (color.g * 255).round(), (color.b * 255).round())
}

// The line in the chat after the addon's mark: `Inventory: [Rabbit's Foot]: not junk.`
public function say(mark: ChatMark, line: string) {
  Game::chat.print(`|c${codeOf(mark.color)}${mark.name}:|r ${line}`, BRIGHT_TEXT)
}
