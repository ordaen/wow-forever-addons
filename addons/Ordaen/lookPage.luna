// The settings window's page of Ordaen's look: the presets, each a whole look chosen at once, then every entry of
// the look (fonts, bars, animation, the accent and the palette, the class colours). Every row writes one entry of
// the look and a preset all of them, each at once and one step of the history.
import { Align, Track } from "$ltml"
import { ColorPicker } from "@/colorPicker"
import { Choice, Dropdown } from "@/dropdown"
import Locale from "@/locales"
import Looks from "@/look"
import { Animation, BarFrame, BarTexture, Font, Hue, Look, NumbersFont, PRESETS, Preset, presetOf } from "@/look"
import { Component } from "@/module"
import { ButtonPlate, PushButton } from "@/pushButton"
import { Section } from "@/section"
import { Settings } from "@/settings"
import { SECONDARY_TEXT } from "@/units"

const WHITE: Color = Color.hex("#ffffff")
const DIM: Color = Color.hex("#a3977f")
const IN_USE: Color = Color.hex("#a6e39a")
const PRESET_ROW: Array<Track> = [{ fr: 1 }, 175.78125dp]

const FONTS: Array<Choice<Font>> = [
  { value: Font.FiraSans, label: Locale.THEME_FONT_FIRASANS },
  { value: Font.AlegreyaSans, label: Locale.THEME_FONT_ALEGREYASANS },
  { value: Font.PtSans, label: Locale.THEME_FONT_PTSANS },
  { value: Font.Philosopher, label: Locale.THEME_FONT_PHILOSOPHER },
  { value: Font.AlegreyaSC, label: Locale.THEME_FONT_ALEGREYASC },
  { value: Font.Forum, label: Locale.THEME_FONT_FORUM },
  { value: Font.CormorantSC, label: Locale.THEME_FONT_CORMORANTSC },
  { value: Font.FiraCondensed, label: Locale.THEME_FONT_FIRACONDENSED },
  { value: Font.PtSansNarrow, label: Locale.THEME_FONT_PTSANSNARROW },
  { value: Font.Friz, label: Locale.THEME_FONT_FRIZ },
  { value: Font.ArialNarrow, label: Locale.THEME_FONT_ARIALNARROW }
]
const NUMBERS_FONTS: Array<Choice<NumbersFont>> = [
  { value: NumbersFont.PtSans, label: Locale.THEME_FONT_PTSANS },
  { value: NumbersFont.PtSansNarrow, label: Locale.THEME_FONT_PTSANSNARROW },
  { value: NumbersFont.ArialNarrow, label: Locale.THEME_FONT_ARIALNARROW }
]
const BARS: Array<Choice<BarTexture>> = [
  { value: BarTexture.Flat, label: Locale.THEME_BAR_FLAT },
  { value: BarTexture.Blizzard, label: Locale.THEME_BAR_BLIZZARD }
]
const FRAMES: Array<Choice<BarFrame>> = [
  { value: BarFrame.Bezel, label: Locale.THEME_BARFRAME_BEZEL },
  { value: BarFrame.Groove, label: Locale.THEME_BARFRAME_GROOVE }
]
const ANIMATIONS: Array<Choice<Animation>> = [
  { value: Animation.Smooth, label: Locale.THEME_ANIM_SMOOTH },
  { value: Animation.Fast, label: Locale.THEME_ANIM_FAST },
  { value: Animation.Off, label: Locale.THEME_ANIM_OFF }
]
const HUES: Array<Choice<Hue>> = [
  { value: Hue.Red, label: Locale.THEME_PALETTECOLOR_RED },
  { value: Hue.Orange, label: Locale.THEME_PALETTECOLOR_ORANGE },
  { value: Hue.Yellow, label: Locale.THEME_PALETTECOLOR_YELLOW },
  { value: Hue.Green, label: Locale.THEME_PALETTECOLOR_GREEN },
  { value: Hue.Cyan, label: Locale.THEME_PALETTECOLOR_CYAN },
  { value: Hue.Blue, label: Locale.THEME_PALETTECOLOR_BLUE },
  { value: Hue.Violet, label: Locale.THEME_PALETTECOLOR_VIOLET },
  { value: Hue.Pink, label: Locale.THEME_PALETTECOLOR_PINK },
  { value: Hue.Tan, label: Locale.THEME_PALETTECOLOR_TAN },
  { value: Hue.White, label: Locale.THEME_PALETTECOLOR_WHITE },
  { value: Hue.Grey, label: Locale.THEME_PALETTECOLOR_GREY }
]

function nameOf(named: Preset): String {
  match (named) {
    Preset.Ordaen => return Locale.THEME_NAME_ORDAEN
    Preset.Minimal => return Locale.THEME_NAME_MINIMAL
  }
}

function aboutOf(named: Preset): String {
  match (named) {
    Preset.Ordaen => return Locale.THEME_ABOUT_ORDAEN
    Preset.Minimal => return Locale.THEME_ABOUT_MINIMAL
  }
}

// A preset: its name and what it is, and «Use», which writes the whole of it into the look; «In use» where the
// look is that preset as it stands.
public class PresetRow implements Component {
  derived inUse: Boolean = presetOf(self.look.values) == self.preset
  derived name: String = nameOf(self.preset)
  derived about: String = aboutOf(self.preset)

  preset: Signal<Preset>
  look: mut Settings<Look>
  constructor(preset: Signal<Preset>, look: mut Settings<Look>) {
    self.preset = preset
    self.look = look
  }

  use(mut self) { self.look.choose(Looks.preset(self.preset)) }

  public render(self): Template {
    return $ltml {
      <box columns={PRESET_ROW} gap={3.5sp} yAlign={Align.Center}>
        <box columns={1} gap={0.5sp}>
          <text value={self.name} textColor={WHITE} wrap={.None} />
          <text value={self.about} textColor={DIM} textSize={SECONDARY_TEXT} />
        </box>
        <text $if={self.inUse} value={Locale.THEMES_IN_USE} textColor={IN_USE} textSize={SECONDARY_TEXT} wrap={.None} />
        <PushButton $else label={Locale.THEMES_USE} width={175.78125dp} plate={ButtonPlate.Accent} @click={self.use} />
      </box>
    }
  }
}

public class LookPage implements Component {
  look: mut Settings<Look>
  constructor(look: mut Settings<Look>) {
    self.look = look
  }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={5.5sp}>
        <Section title={Locale.LIST_THEMES}>
          <PresetRow $for={each of PRESETS} $key={each} preset={each} look={mut self.look} />
        </Section>
        <Section title={Locale.THEMES_FONTS}>
          <Dropdown label={Locale.THEME_FONT} value={mut self.look.values.font} choices={FONTS} />
          <Dropdown label={Locale.THEME_FONTHEADER} value={mut self.look.values.fontHeader} choices={FONTS} />
          <Dropdown label={Locale.THEME_FONTNUMBERS} value={mut self.look.values.fontNumbers} choices={NUMBERS_FONTS} />
        </Section>
        <Section title={Locale.THEMES_TEXTURES}>
          <Dropdown label={Locale.THEME_BARTEXTURE} hint={Locale.THEME_BARTEXTURE_TIP}
                    value={mut self.look.values.barTexture} choices={BARS} />
          <Dropdown label={Locale.THEME_BARFRAME} value={mut self.look.values.barFrame} choices={FRAMES} />
        </Section>
        <Section title={Locale.THEMES_ANIMATION}>
          <Dropdown label={Locale.THEME_ANIM} hint={Locale.THEME_ANIM_TIP} value={mut self.look.values.animation}
                    choices={ANIMATIONS} />
        </Section>
        <Section title={Locale.THEMES_COLORS}>
          <ColorPicker label={Locale.THEME_ACCENT} hint={Locale.THEME_ACCENT_TIP} value={mut self.look.values.accent} />
          <ColorPicker label={Locale.THEME_PALETTE_RED} value={mut self.look.values.red} />
          <ColorPicker label={Locale.THEME_PALETTE_REDTEXT} value={mut self.look.values.redText} />
          <ColorPicker label={Locale.THEME_PALETTE_ORANGE} value={mut self.look.values.orange} />
          <ColorPicker label={Locale.THEME_PALETTE_ORANGETEXT} value={mut self.look.values.orangeText} />
          <ColorPicker label={Locale.THEME_PALETTE_YELLOW} value={mut self.look.values.yellow} />
          <ColorPicker label={Locale.THEME_PALETTE_YELLOWTEXT} value={mut self.look.values.yellowText} />
          <ColorPicker label={Locale.THEME_PALETTE_GREEN} value={mut self.look.values.green} />
          <ColorPicker label={Locale.THEME_PALETTE_GREENTEXT} value={mut self.look.values.greenText} />
          <ColorPicker label={Locale.THEME_PALETTE_CYAN} value={mut self.look.values.cyan} />
          <ColorPicker label={Locale.THEME_PALETTE_CYANTEXT} value={mut self.look.values.cyanText} />
          <ColorPicker label={Locale.THEME_PALETTE_BLUE} value={mut self.look.values.blue} />
          <ColorPicker label={Locale.THEME_PALETTE_BLUETEXT} value={mut self.look.values.blueText} />
          <ColorPicker label={Locale.THEME_PALETTE_VIOLET} value={mut self.look.values.violet} />
          <ColorPicker label={Locale.THEME_PALETTE_VIOLETTEXT} value={mut self.look.values.violetText} />
          <ColorPicker label={Locale.THEME_PALETTE_PINK} value={mut self.look.values.pink} />
          <ColorPicker label={Locale.THEME_PALETTE_PINKTEXT} value={mut self.look.values.pinkText} />
          <ColorPicker label={Locale.THEME_PALETTE_TAN} value={mut self.look.values.tan} />
          <ColorPicker label={Locale.THEME_PALETTE_TANTEXT} value={mut self.look.values.tanText} />
          <ColorPicker label={Locale.THEME_PALETTE_WHITE} value={mut self.look.values.white} />
          <ColorPicker label={Locale.THEME_PALETTE_WHITETEXT} value={mut self.look.values.whiteText} />
          <ColorPicker label={Locale.THEME_PALETTE_GREY} value={mut self.look.values.grey} />
          <ColorPicker label={Locale.THEME_PALETTE_GREYTEXT} value={mut self.look.values.greyText} />
        </Section>
        <Section title={Locale.THEMES_CLASS_COLORS}>
          <Dropdown label={Locale.THEME_CLASS_WARRIOR} value={mut self.look.values.warrior} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_PALADIN} value={mut self.look.values.paladin} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_HUNTER} value={mut self.look.values.hunter} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_ROGUE} value={mut self.look.values.rogue} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_PRIEST} value={mut self.look.values.priest} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_SHAMAN} value={mut self.look.values.shaman} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_MAGE} value={mut self.look.values.mage} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_WARLOCK} value={mut self.look.values.warlock} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_DRUID} value={mut self.look.values.druid} choices={HUES} />
        </Section>
      </box>
    }
  }
}
