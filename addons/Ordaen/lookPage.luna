// The settings window's page of Ordaen's look: the presets, each a whole look chosen at once, then every entry of
// the look (fonts, bars, animation, the accent and the palette, the class colours). Every row writes one entry of
// the look's draft and a preset all of them, so «Save», leaving unsaved and «Roll back» treat both alike.
import { Align, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Animation, BarFrame, BarTexture, Font, Hue, Look, Preset, PRESETS, presetOf, XpFill } from "@/look"
import Looks from "@/look"
import { Component } from "@/module"
import { Settings } from "@/settings"
import { Choice, Dropdown } from "@/dropdown"
import { ColorPicker } from "@/colorPicker"
import { PushButton } from "@/pushButton"
import { PX } from "@/units"
import { Section } from "@/section"
import Locale from "@/locales"

const WHITE: Color = Color.hex("#ffffff")
const DIM: Color = Color.hex("#a3977f")
const IN_USE: Color = Color.hex("#a6e39a")
const PRESET_ROW: Array<Track> = [{ fr: 1 }, 150 * PX]

const FONTS: Array<Choice<Font>> = [
  { value: Font.FiraSans, label: Locale.THEME_FONT_FIRASANS },
  { value: Font.AlegreyaSans, label: Locale.THEME_FONT_ALEGREYASANS },
  { value: Font.PtSans, label: Locale.THEME_FONT_PTSANS },
  { value: Font.Philosopher, label: Locale.THEME_FONT_PHILOSOPHER },
  { value: Font.AlegreyaSC, label: Locale.THEME_FONT_ALEGREYASC },
  { value: Font.Forum, label: Locale.THEME_FONT_FORUM },
  { value: Font.CormorantSC, label: Locale.THEME_FONT_CORMORANTSC },
  { value: Font.FiraCondensed, label: Locale.THEME_FONT_FIRACONDENSED },
  { value: Font.PtSansNarrow, label: Locale.THEME_FONT_PTSANSNARROW },
  { value: Font.Friz, label: Locale.THEME_FONT_FRIZ },
  { value: Font.ArialNarrow, label: Locale.THEME_FONT_ARIALNARROW },
]
const BARS: Array<Choice<BarTexture>> = [
  { value: BarTexture.Flat, label: Locale.THEME_BAR_FLAT },
  { value: BarTexture.Blizzard, label: Locale.THEME_BAR_BLIZZARD },
]
const FILLS: Array<Choice<XpFill>> = [
  { value: XpFill.Deep, label: Locale.THEME_XPFILL_DEEP },
  { value: XpFill.Grain, label: Locale.THEME_XPFILL_GRAIN },
  { value: XpFill.Brushed, label: Locale.THEME_XPFILL_BRUSHED },
  { value: XpFill.Potion, label: Locale.THEME_XPFILL_POTION },
  { value: XpFill.Clouds, label: Locale.THEME_XPFILL_CLOUDS },
  { value: XpFill.Steel, label: Locale.THEME_XPFILL_STEEL },
]
const FRAMES: Array<Choice<BarFrame>> = [
  { value: BarFrame.Bezel, label: Locale.THEME_BARFRAME_BEZEL },
  { value: BarFrame.Groove, label: Locale.THEME_BARFRAME_GROOVE },
]
const ANIMATIONS: Array<Choice<Animation>> = [
  { value: Animation.Smooth, label: Locale.THEME_ANIM_SMOOTH },
  { value: Animation.Fast, label: Locale.THEME_ANIM_FAST },
  { value: Animation.Off, label: Locale.THEME_ANIM_OFF },
]
const HUES: Array<Choice<Hue>> = [
  { value: Hue.Red, label: Locale.THEME_PALETTECOLOR_RED },
  { value: Hue.Orange, label: Locale.THEME_PALETTECOLOR_ORANGE },
  { value: Hue.Yellow, label: Locale.THEME_PALETTECOLOR_YELLOW },
  { value: Hue.Green, label: Locale.THEME_PALETTECOLOR_GREEN },
  { value: Hue.Cyan, label: Locale.THEME_PALETTECOLOR_CYAN },
  { value: Hue.Blue, label: Locale.THEME_PALETTECOLOR_BLUE },
  { value: Hue.Violet, label: Locale.THEME_PALETTECOLOR_VIOLET },
  { value: Hue.Pink, label: Locale.THEME_PALETTECOLOR_PINK },
  { value: Hue.Tan, label: Locale.THEME_PALETTECOLOR_TAN },
  { value: Hue.White, label: Locale.THEME_PALETTECOLOR_WHITE },
  { value: Hue.Grey, label: Locale.THEME_PALETTECOLOR_GREY },
]

function nameOf(named: Preset): String {
  match (named) {
    Preset.Ordaen => return Locale.THEME_NAME_ORDAEN,
    Preset.Blizzard => return Locale.THEME_NAME_BLIZZARD,
    Preset.Minimal => return Locale.THEME_NAME_MINIMAL,
  }
}

function aboutOf(named: Preset): String {
  match (named) {
    Preset.Ordaen => return Locale.THEME_ABOUT_ORDAEN,
    Preset.Blizzard => return Locale.THEME_ABOUT_BLIZZARD,
    Preset.Minimal => return Locale.THEME_ABOUT_MINIMAL,
  }
}

// A preset: its name and what it is, and «Use», which writes the whole of it into the draft; «In use» where the
// draft is that preset as it stands.
public class PresetRow implements Component {
  derived inUse: Boolean = presetOf(self.look.draft) == self.preset
  const name: String
  const about: String

  const preset: Preset
  look: mut Settings<Look>
  constructor(preset: Preset, look: mut Settings<Look>) {
    self.preset = preset
    self.look = look
    self.name = nameOf(preset)
    self.about = aboutOf(preset)
  }

  use(mut self) { self.look.choose(Looks.preset(self.preset)) }

  public render(self): Template {
    return $ltml {
      <box columns={PRESET_ROW} gap={12 * PX} yAlign={Align.Center}>
        <box columns={1} gap={2 * PX}>
          <text value={self.name} textColor={WHITE} textSize={15 * PX} wrap={false} />
          <text value={self.about} textColor={DIM} textSize={13 * PX} />
        </box>
        <text $if={self.inUse} value={Locale.THEMES_IN_USE} textColor={IN_USE} textSize={13 * PX} wrap={false} />
        <PushButton $else label={Locale.THEMES_USE} width={150 * PX} accent={true} @click={self.use} />
      </box>
    }
  }
}

public class LookPage implements Component {
  look: mut Settings<Look>
  constructor(look: mut Settings<Look>) {
    self.look = look
  }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={18 * PX}>
        <Section title={Locale.LIST_THEMES}>
          <PresetRow $for={each of PRESETS} $key={each} preset={each} look={mut self.look} />
        </Section>
        <Section title={Locale.THEMES_FONTS}>
          <Dropdown label={Locale.THEME_FONT} value={mut self.look.draft.font} choices={FONTS} />
          <Dropdown label={Locale.THEME_FONTHEADER} value={mut self.look.draft.fontHeader} choices={FONTS} />
          <Dropdown label={Locale.THEME_FONTNUMBERS} value={mut self.look.draft.fontNumbers} choices={FONTS} />
        </Section>
        <Section title={Locale.THEMES_TEXTURES}>
          <Dropdown label={Locale.THEME_BARTEXTURE} hint={Locale.THEME_BARTEXTURE_TIP}
                    value={mut self.look.draft.barTexture} choices={BARS} />
          <Dropdown label={Locale.THEME_XPFILL} value={mut self.look.draft.xpFill} choices={FILLS} />
          <Dropdown label={Locale.THEME_BARFRAME} value={mut self.look.draft.barFrame} choices={FRAMES} />
        </Section>
        <Section title={Locale.THEMES_ANIMATION}>
          <Dropdown label={Locale.THEME_ANIM} hint={Locale.THEME_ANIM_TIP} value={mut self.look.draft.animation}
                    choices={ANIMATIONS} />
        </Section>
        <Section title={Locale.THEMES_COLORS}>
          <ColorPicker label={Locale.THEME_ACCENT} hint={Locale.THEME_ACCENT_TIP} value={mut self.look.draft.accent} />
          <ColorPicker label={Locale.THEME_PALETTE_RED} value={mut self.look.draft.red} />
          <ColorPicker label={Locale.THEME_PALETTE_REDTEXT} value={mut self.look.draft.redText} />
          <ColorPicker label={Locale.THEME_PALETTE_ORANGE} value={mut self.look.draft.orange} />
          <ColorPicker label={Locale.THEME_PALETTE_ORANGETEXT} value={mut self.look.draft.orangeText} />
          <ColorPicker label={Locale.THEME_PALETTE_YELLOW} value={mut self.look.draft.yellow} />
          <ColorPicker label={Locale.THEME_PALETTE_YELLOWTEXT} value={mut self.look.draft.yellowText} />
          <ColorPicker label={Locale.THEME_PALETTE_GREEN} value={mut self.look.draft.green} />
          <ColorPicker label={Locale.THEME_PALETTE_GREENTEXT} value={mut self.look.draft.greenText} />
          <ColorPicker label={Locale.THEME_PALETTE_CYAN} value={mut self.look.draft.cyan} />
          <ColorPicker label={Locale.THEME_PALETTE_CYANTEXT} value={mut self.look.draft.cyanText} />
          <ColorPicker label={Locale.THEME_PALETTE_BLUE} value={mut self.look.draft.blue} />
          <ColorPicker label={Locale.THEME_PALETTE_BLUETEXT} value={mut self.look.draft.blueText} />
          <ColorPicker label={Locale.THEME_PALETTE_VIOLET} value={mut self.look.draft.violet} />
          <ColorPicker label={Locale.THEME_PALETTE_VIOLETTEXT} value={mut self.look.draft.violetText} />
          <ColorPicker label={Locale.THEME_PALETTE_PINK} value={mut self.look.draft.pink} />
          <ColorPicker label={Locale.THEME_PALETTE_PINKTEXT} value={mut self.look.draft.pinkText} />
          <ColorPicker label={Locale.THEME_PALETTE_TAN} value={mut self.look.draft.tan} />
          <ColorPicker label={Locale.THEME_PALETTE_TANTEXT} value={mut self.look.draft.tanText} />
          <ColorPicker label={Locale.THEME_PALETTE_WHITE} value={mut self.look.draft.white} />
          <ColorPicker label={Locale.THEME_PALETTE_WHITETEXT} value={mut self.look.draft.whiteText} />
          <ColorPicker label={Locale.THEME_PALETTE_GREY} value={mut self.look.draft.grey} />
          <ColorPicker label={Locale.THEME_PALETTE_GREYTEXT} value={mut self.look.draft.greyText} />
        </Section>
        <Section title={Locale.THEMES_CLASS_COLORS}>
          <Dropdown label={Locale.THEME_CLASS_WARRIOR} value={mut self.look.draft.warrior} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_PALADIN} value={mut self.look.draft.paladin} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_HUNTER} value={mut self.look.draft.hunter} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_ROGUE} value={mut self.look.draft.rogue} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_PRIEST} value={mut self.look.draft.priest} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_SHAMAN} value={mut self.look.draft.shaman} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_MAGE} value={mut self.look.draft.mage} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_WARLOCK} value={mut self.look.draft.warlock} choices={HUES} />
          <Dropdown label={Locale.THEME_CLASS_DRUID} value={mut self.look.draft.druid} choices={HUES} />
        </Section>
      </box>
    }
  }
}
