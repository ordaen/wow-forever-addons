// TextField: a text setting's row (SettingRow: its label, its hint, greyed while disabled) with a text field sunk into
// the page: dark, with a fine bronze edge. Typing writes the setting; Enter or Escape leaves the field. Disabled, it
// takes no typing.
import { Edges, Line } from "$ltml"
import { Component } from "@/module"
import { SettingRow } from "@/settingRow"

const INK: color = #e8dcc4
const FILL: color = #0d0a08
const EDGE: Line = { width: 1.171875dp, color: #4a3a24 }
const PADDING: Edges = { right: 3sp, left: 3sp }

public class TextField implements Component {
  label: Signal<string>
  value: mut Signal<string>
  const maxLength: integer | nil
  hint: Signal<string>
  disabled: Signal<boolean>
  constructor(
    label: Signal<string>,
    value: mut Signal<string>,
    // The most characters it takes; any number when left out.
    maxLength: integer | nil = nil,
    hint: Signal<string> = "",
    disabled: Signal<boolean> = false
  ) {
    self.label = label
    self.value = value
    self.maxLength = maxLength
    self.hint = hint
    self.disabled = disabled
  }

  public render(): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <input value={mut self.value} width={351.5625dp} height={35.15625dp} padding={PADDING} background={FILL}
               border={EDGE} textColor={INK} maxLength={self.maxLength}
               disabled={self.disabled} />
      </SettingRow>
    }
  }
}
