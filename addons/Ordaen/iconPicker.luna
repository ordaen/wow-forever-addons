// IconPicker: a dialog that picks one of the client's icons, the macro window's set (the player's spells' first, then
// the spells', the items' and the client's loose icon files), in rows of ten that scroll; a search over the spells'
// names and the icons' own narrows them. Its first cell, where its owner wants one: «no icon» (`nil`) or «the game
// picks» (a macro's question mark). «Pick» says the one picked (`picked`), «Cancel» says nothing was (`cancelled`);
// its owner shuts it either way.
import Client from "$client"
import { Align, Line, Track } from "$ltml"
import { Dialog } from "@/dialog"
import Locale from "@/locales"
import { Component } from "@/module"
import { ButtonPlate, PushButton } from "@/pushButton"
import { ScrolledList } from "@/scrolledList"
import { Toolbar } from "@/toolbar"

// The picker's first cell, before the icons: none, «no icon», or the macro's question mark, which the game turns into
// the icon of what the macro does.
public enum IconPickerFirst { Nothing, NoIcon, GameChooses }

// An icon as the client names it: a file's number, or a file's path; none for «no icon».
public type IconChoice = FileId | Asset | nil

// The question mark a macro shows while the game picks its icon.
const QUESTION_MARK: FileId = 134400
const PER_ROW = 10
const CELL = 37.5dp
const SHOWN_ROWS = 7
const WIDTH = 468.75dp
const BUTTON_WIDTH = 140.625dp
const RIM: Line = { width: 1.171875dp, color: Color::hex("#4a3a24") }
const PICKED_RIM: Line = { width: 2.34375dp, color: Color::hex("#ffd100") }
const NONE_FILL: Color = Color::hex("#0d0a08")
// «No icon»: a dark cell with a short bar across its middle, which reads in every language.
public const NO_ICON_MARK: Color = Color::hex("#a89878")
const MARK_WIDTH = 14.0625dp
const MARK_HEIGHT = 2.34375dp
const ONE: array<Track> = [{ fr: 1 }]

// An icon offered, and the words a search finds it by: the spell's name that wears it, or its own file's name.
struct Offered {
  const icon: IconChoice
  const words: string
}

// The client's icon lists in the macro window's order, each a file's number or a name under Interface/Icons/.
function clientIcons(): array<Offered> {
  const raw: array<FileId | string> = mut []
  Client::GetLooseMacroIcons(raw)
  Client::GetMacroIcons(raw)
  Client::GetLooseMacroItemIcons(raw)
  Client::GetMacroItemIcons(raw)
  const offered: array<Offered> = mut []
  for (each of raw) {
    if (each is FileId) {
      offered.push({ icon: each, words: "" })
    } else {
      const path = `Interface/Icons/${each}`
      if (path is Asset) { offered.push({ icon: path, words: each.lower() }) }
    }
  }
  return offered
}

// The player's spells, each by its name: what a search by a spell's name finds.
function spellIcons(): array<Offered> {
  const offered: array<Offered> = mut []
  const lines = Client::C_SpellBook::GetNumSpellBookSkillLines().floor()
  for (line of 1..lines) {
    const info = Client::C_SpellBook::GetSpellBookSkillLineInfo(line)
    if (info != nil) {
      const first = info.itemIndexOffset.floor() + 1
      for (slot of first..(first - 1 + info.numSpellBookItems.floor())) {
        const item = Client::C_SpellBook::GetSpellBookItemInfo(slot, Client::SpellBookSpellBank::Player)
        if (item != nil) { offered.push({ icon: item.iconID, words: item.name.lower() }) }
      }
    }
  }
  return offered
}

// The icons in rows of ten.
function rowsOf(offered: array<Offered>): array<array<Offered>> {
  const rows: array<array<Offered>> = mut []
  let row: array<Offered> = mut []
  for (each of offered) {
    row.push(each)
    if (row.length == PER_ROW) {
      rows.push(row)
      row = mut []
    }
  }
  if (row.length > 0) { rows.push(row) }
  return rows
}

// One cell: its icon (a dark well for «no icon», with the word), the picked one's rim gold.
class IconCell implements Component {
  public pick: Event<IconChoice> = new Event()

  derived none: boolean = self.offered.icon == nil
  derived rim: Line = self.offered.icon == self.chosen ? PICKED_RIM : RIM

  offered: Signal<Offered>
  chosen: Signal<IconChoice>
  constructor(offered: Signal<Offered>, chosen: Signal<IconChoice>) {
    self.offered = offered
    self.chosen = chosen
  }

  onPick() { self.pick.emit((peek self.offered).icon) }

  public render(): Template {
    return $ltml {
      <box width={CELL} height={CELL} border={self.rim} columns={ONE} rows={ONE} @pointerPress={self.onPick}
           @keyPress(.Enter)={self.onPick} @keyPress(.Space)={self.onPick}>
        <box $if={self.none} background={NONE_FILL} xAlign={Align::Center} yAlign={Align::Center}>
          <box width={MARK_WIDTH} height={MARK_HEIGHT} background={NO_ICON_MARK} />
        </box>
        <box $else icon={self.offered.icon} />
      </box>
    }
  }
}

// A row of ten cells.
class IconRow implements Component {
  public pick: Event<IconChoice> = new Event()

  icons: Signal<array<Offered>>
  chosen: Signal<IconChoice>
  constructor(icons: Signal<array<Offered>>, chosen: Signal<IconChoice>) {
    self.icons = icons
    self.chosen = chosen
  }

  onPick(icon: IconChoice) { self.pick.emit(icon) }

  public render(): Template {
    return $ltml {
      <box columns={PER_ROW} gap={1sp}>
        <IconCell $for={offered of self.icons} offered={offered} chosen={self.chosen} @pick={self.onPick} />
      </box>
    }
  }
}

public class IconPicker implements Component {
  public picked: Event<IconChoice> = new Event()
  public cancelled: Event<nil> = new Event()

  state chosen: IconChoice
  state search = ""
  // The icons offered, read once as it opens: the client's lists are long and never change while it is open.
  const all: array<Offered>
  derived shown: array<Offered> = self.shownOf()
  derived rows: array<array<Offered>> = rowsOf(self.shown)

  title: Signal<string>
  const first: IconPickerFirst
  constructor(value: Signal<IconChoice>, title: Signal<string>, first: IconPickerFirst = IconPickerFirst::Nothing) {
    self.title = title
    self.first = first
    self.chosen = peek value
    const all: array<Offered> = mut []
    if (first == IconPickerFirst::NoIcon) { all.push({ icon: nil, words: "" }) }
    if (first == IconPickerFirst::GameChooses) { all.push({ icon: QUESTION_MARK, words: "" }) }
    for (each of spellIcons()) { all.push(each) }
    for (each of clientIcons()) { all.push(each) }
    self.all = all
  }

  // Those whose words hold the search, every one while it is empty.
  shownOf(): array<Offered> {
    const needle = self.search.lower()
    if (needle == "") { return self.all }
    return self.all.filter(each => each.words.contains(needle))
  }

  mut onPick(icon: IconChoice) { self.chosen = icon }
  onDone() { self.picked.emit(peek self.chosen) }
  onCancel() { self.cancelled.emit() }

  public render(): Template {
    return $ltml {
      <Dialog width={WIDTH} title={self.title}>
        <Toolbar search={mut self.search} placeholder={Locale::ICON_SEARCH} />
        <ScrolledList virtual={true} height={CELL * SHOWN_ROWS + 30dp}>
          <IconRow $for={row of self.rows} icons={row} chosen={self.chosen} @pick={self.onPick} />
        </ScrolledList>
        <PushButton #buttons label={Locale::CANCEL} width={BUTTON_WIDTH} @click={self.onCancel} />
        <PushButton #buttons label={Locale::ICON_PICK} width={BUTTON_WIDTH} plate={ButtonPlate::Accent} @click={self.onDone} />
      </Dialog>
    }
  }
}
