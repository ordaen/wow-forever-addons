// A count on its pill: round for one digit with room round it, wider for more, and in the tone of what it counts
// where one is given.
import Test from "$test"
import root Ordaen from "Ordaen"
import { CountBadge } from "@/countBadge"

const WHISPER: color = #ff80ff

class Badges {
  public state count = 3

  public render(): Template {
    return $ltml {
      <box columns={["max-content", "max-content"]} gap={6sp} padding={3sp}>
        <CountBadge count={self.count} />
        <CountBadge count={12} tone={WHISPER} />
      </box>
    }
  }
}

test "one digit stands round on its pill with room round it, more widen it, and a tone tints it" {
  const page = new Badges()
  Test::mount(page, { left: 0, top: 0, width: 300, height: 100 })
  const pill = Test::edges(Ordaen.art.panel.countBadge, 0)
  const digit = Test::page().text("3").rect()
  Test::expect((pill.right - pill.left) - (pill.bottom - pill.top) < 1)
  Test::expect(digit.left - pill.left >= 3 && pill.right - digit.right >= 3)
  const toned = Test::drawn().filter(d => d.desaturated)
  Test::expect(toned.length == 1)
  destroy page
}
