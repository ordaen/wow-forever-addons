// The look's page: a preset chosen writes every entry of the draft, a colour changed after it is a draft that
// differs, and «Save» and «Roll back» treat them as any other setting.
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import { Look, presetOf } from "@/look"
import { LookPage } from "@/lookPage"

// The middle of the accent's swatch.
const ACCENT: Test.Point = { x: 266.67, y: 559.83 }

function presetNow(look: Look): String {
  let preset = presetOf(look)
  if (preset == nil) { return "none" }
  return `${preset}`
}

function state(): String {
  Test.flush()
  let file = Ordaen.lookArt.fonts.numbers
  let font = file != nil ? file : "the client's own text font"
  return `unsaved ${Ordaen.keeper.unsaved}; the draft's preset ${presetNow(Ordaen.look.draft)}, the values' ${presetNow(Ordaen.look.values)}; numbers drawn with ${font}`
}

test "a preset is chosen whole, a colour changed after it, saved and rolled back" {
  let page = new LookPage(mut Ordaen.look)
  Test.mount(page, { left: 0, top: 0, width: 800, height: 2600 })
  Test.note(state())
  Test.shot("Ordaen's preset in use")

  // The one «Use» is Minimal's: the presets are listed Ordaen, Minimal.
  Test.click(Test.holding("Use", nil), nil)
  Test.note(state())

  // The colour the accent already has, picked again: nothing differs.
  Test.click(ACCENT, nil)
  Game.colorPicker.picked.emit(1, { r: 0.62, g: 0.62, b: 0.62, a: 1 })
  Test.note(state())

  Test.click(ACCENT, nil)
  Game.colorPicker.picked.emit(2, { r: 0, g: 0.5, b: 1, a: 1 })
  Test.note(state())
  Test.shot("Minimal chosen, then its accent changed: no preset is the draft")

  Ordaen.keeper.saveAll()
  Test.note(state())

  Ordaen.keeper.rollbackAll()
  Test.note(state())
  Test.shot("rolled back: Ordaen's again")

  destroy page
  Test.expect(Test.blank())
}
