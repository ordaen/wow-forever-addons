// SecureWheel: a wheel's choice and its action, as the client allows them in a fight. The client lets no addon code
// show a protected frame or change a secure button while the player fights, so both are the client's restricted code:
// a key bound to one secure button, its press opening the wheel (the button stands on the cursor, so the choice is the
// way the mouse goes from there, wherever the art is drawn) and its release closing it, doing nothing. While open, the
// button takes the mouse: a left click reads the cursor's direction, by `SLOT_LUA`, and has the client click it as the
// chosen item, which does the item's action (none in the middle); a right click goes back a level or closes; Escape
// closes; the mouse wheel over a submenu or a slot of several steps through its items, and a left click then does the
// one stepped to. A submenu replaces the ring in place; so does a slot of several, whose child used becomes its current
// (cycling after each use where it cycles, kept where it remembers, the first again where it starts over). Where the
// wheel remembers, a click in the middle of a submenu does the item last used there. What the art shows (`Wheel`)
// follows the button by `slotAt`, the same formula, from the scripts hooked on its click, which the client runs in a
// fight too; an item that is ours (`WheelAction.Ours`, a window of ours) is done there, as the client does nothing for
// it. What is set up (the items, the keys, the size) is written out of a fight; a change made in one waits for its
// end. The client drops a held key's release once the mouse presses a frame: out of a fight the wheel sees its key up
// (`IsKeyDown`) and closes; in one nothing can (the restricted code has no `IsKeyDown` nor a timer, and addon code may
// not hide the button), so there Escape or a right click closes it. A release the game missed for losing focus is
// mended the same way, or by the next press. Nothing runs while it is closed: the cursor is followed by a script set as
// it opens and taken away as it closes.
import Client from "$client"
import root Ordaen from "Ordaen"
import { DEAD_ZONE, SLOT_LUA } from "@/wheel"

// What an item does. The client does the first four on the click, in a fight too.
public enum WheelAction implements Plain {
  // A spell by its name: its highest rank, a mount, a profession's window.
  Spell { spell: String }
  // An item of the bags or worn, by its number.
  Item { item: Integer }
  // A macro of the player's, by its name.
  Macro { macro: String }
  // A line of a macro: an emote (`/wave`), a ping (`/ping attack`), a mark (`/tm 8`), a window of the game's
  // (`/click CharacterMicroButton`), a spell on a condition (`/cast [form:1] Maul`).
  MacroText { text: String }
  // It opens its own ring in place.
  Menu
  // A slot of several: its children stand under its place, as a submenu's do; it does the current one.
  Slot { mode: SlotMode }
  // Ours: the owner does it (`picked`).
  Ours
}

// Which child a slot of several does: the one last chosen, the next after each use, or always the first.
public enum SlotMode implements Plain { Remember = "remember", Cycle = "cycle", First = "first" }

// A modifier an item is done with alone: the client reads its action only while it is held.
public enum WheelModifier implements Plain { Shift = "shift", Ctrl = "ctrl", Alt = "alt" }

// One item of a wheel by its place: `r_3` the root ring's third, `r_3_2` the second of that one's submenu.
public struct WheelEntry {
  path: String
  action: WheelAction
  // The client refuses it in a fight (a window it won't open then): dimmed, and nothing done.
  refusesInFight: Boolean
  // Done only with this held.
  modifier: WheelModifier | nil
}

// How many items a ring holds, by its place (`r`, `r_3`).
public struct WheelRing {
  path: String
  count: Integer
}

// How a wheel is laid out: where it opens, how large it is, whether its submenus remember, whether its aim's middle
// trails the cursor.
public struct WheelSetup {
  // It is drawn at the screen's middle and not at the cursor. Either way it aims from where the cursor was as it
  // opened: the mouse moves from where the hand is, never to the wheel first.
  centred: Boolean
  scale: Number
  remember: Boolean
  // The aim's middle follows the cursor once it goes further than `REACH` from it, so turning to another item is a
  // short move whichever way the cursor went first; else it stays where the cursor was as the wheel opened.
  trailing: Boolean
}

// The place of the root ring, and of an item or a ring inside one.
public const ROOT = "r"
public function placeIn(ring: String, index: Integer): String { return `${ring}_${index}` }

// How long the wheel takes to open, and how often an open wheel reads its items' state again.
const OPENING_TIME = 0.2
const STATE_EVERY = 0.2
// How far the cursor goes from the aim's middle before the middle trails it (at a scale of 1): half the side of a
// square round the middle. It trails to a little inside that, so the cursor stands in the square again and its next way
// out is heard.
const REACH = 60dp
const TRAIL = 0.9
// The bands round that square: the cursor going out of the square comes into one of them, by its own motion, which is
// what the client runs a wrapped enter's body on (`Wrapped_OnEnter`); a frame that comes under a cursor standing still
// runs none. Each by the point of its side that touches the square, which way that side is from the middle, and
// whether it runs across the screen (over or under the square) or beside the square, as tall as it. Together they
// cover everything round the square, each reaching twice the screen away.
struct Band {
  point: String
  x: Number
  y: Number
  across: Boolean
}
const BANDS: Array<Band> = [
  { point: "BOTTOM", x: 0, y: 1, across: true },
  { point: "TOP", x: 0, y: -1, across: true },
  { point: "RIGHT", x: -1, y: 0, across: false },
  { point: "LEFT", x: 1, y: 0, across: false }
]
// The client's restricted code that reads which item of the ring shown (`level`) the cursor went towards: it sets
// `slot`, 0 in the middle.
const AIM: String = [
  "local count = owner:GetAttribute('count-' .. level) or 0",
  "local dead = owner:GetAttribute('dead') or 0",
  "local x, y = self:GetMousePosition()",
  "local dx, dy = 0, 0",
  "if x then dx, dy = (x - 0.5) * self:GetWidth(), (y - 0.5) * self:GetHeight() end",
  SLOT_LUA
].join("\n")
// The client's restricted code round the button's click: `self` the button, `owner` the header, `button` how it was
// clicked (`Key` the bound key, `LeftButton`, `RightButton`, `Escape`), `down` whether it went down. The key held opens
// the wheel and its release closes it, doing nothing; a left click does the item the cursor went towards (opens a
// submenu or a slot's children, or does the item of them the mouse wheel stepped to), none in the middle (a submenu that
// remembers: its last); a right click goes back a ring, closing the wheel from the first; Escape closes it.
const CHOICE: String = [
  "if button == 'Key' and down then",
  "  owner:SetAttribute('level', 'r')",
  "  self:ClearAllPoints()",
  "  self:SetPoint('CENTER', '$cursor')",
  "  self:Show()",
  "  self:SetBindingClick(true, 'ESCAPE', self, 'Escape')",
  "  return false",
  "end",
  "if not self:IsShown() then return false end",
  "if button == 'Key' or button == 'Escape' then",
  "  self:Hide() self:ClearBindings() owner:SetAttribute('level', 'r')",
  "  return false",
  "end",
  "if down then return false end",
  "local level = owner:GetAttribute('level') or 'r'",
  "if button == 'RightButton' then",
  "  if level == 'r' then",
  "    self:Hide() self:ClearBindings()",
  "  else",
  "    owner:SetAttribute('level', owner:GetAttribute('up-' .. level))",
  "  end",
  "  return false",
  "end",
  "if button ~= 'LeftButton' then return false end",
  AIM,
  "if slot == 0 and level ~= 'r' and owner:GetAttribute('remember') then slot = owner:GetAttribute('last-' .. level) or 0 end",
  "if slot == 0 then return false end",
  "local name = level .. '_' .. slot",
  "if owner:GetAttribute('menu-' .. name) or owner:GetAttribute('slot-' .. name) then",
  "  local step = owner:GetAttribute('step-' .. name) or 0",
  "  if step == 0 then owner:SetAttribute('level', name) return false end",
  "  level, slot = name, step",
  "  name = level .. '_' .. slot",
  "  if owner:GetAttribute('menu-' .. name) or owner:GetAttribute('slot-' .. name) then",
  "    owner:SetAttribute('level', name)",
  "    return false",
  "  end",
  "end",
  "if level ~= 'r' then owner:SetAttribute('last-' .. level, slot) end",
  "if owner:GetAttribute('slot-' .. level) then",
  "  local mode = owner:GetAttribute('mode-' .. level)",
  "  if mode == 'cycle' then",
  "    local several = owner:GetAttribute('slot-' .. level)",
  "    owner:SetAttribute('current-' .. level, slot % several + 1)",
  "  elseif mode ~= 'first' then",
  "    owner:SetAttribute('current-' .. level, slot)",
  "  end",
  "end",
  "self:Hide() self:ClearBindings() owner:SetAttribute('level', 'r')",
  "if owner:GetAttribute('fighting') == 'yes' and owner:GetAttribute('fightoff-' .. name) then return false end",
  "owner:SetAttribute('chosen', name)",
  "owner:SetAttribute('picks', (owner:GetAttribute('picks') or 0) + 1)",
  "return name"
].join("\n")

// The client's restricted code round the button's mouse wheel (`offset` 1 up, -1 down): over a submenu or a slot of
// several, the item it steps to goes on to the next (down) or back (up), through nought, the ring itself.
const STEP: String = [
  "local level = owner:GetAttribute('level') or 'r'",
  AIM,
  "if slot == 0 then return end",
  "local name = level .. '_' .. slot",
  "if not owner:GetAttribute('menu-' .. name) and not owner:GetAttribute('slot-' .. name) then return end",
  "local several = math.min(owner:GetAttribute('count-' .. name) or 0, 8)",
  "if several == 0 then return end",
  "local step = owner:GetAttribute('step-' .. name) or 0",
  "owner:SetAttribute('step-' .. name, (step + (offset < 0 and 1 or several)) % (several + 1))"
].join("\n")

// The client's restricted code round a band's `OnEnter` (`self` the band, which hears the cursor and takes no
// click): the cursor went out of the square round the aim's middle, so the wheel's button, whose middle the aim is
// measured from, stands again between where the cursor was and where it is, `trail` from it, and the bands with it.
const LEASH: String = [
  "if not owner:GetAttribute('trailing') then return end",
  "local b = owner:GetFrameRef('button')",
  "if not b:IsShown() then return end",
  "local x, y = b:GetMousePosition()",
  "if not x then return end",
  "local dx, dy = (x - 0.5) * b:GetWidth(), (y - 0.5) * b:GetHeight()",
  "local far = math.sqrt(dx * dx + dy * dy)",
  "if far == 0 then return end",
  "local trail = owner:GetAttribute('trail') or 0",
  "b:ClearAllPoints()",
  "b:SetPoint('CENTER', '$cursor', 'CENTER', -dx / far * trail, -dy / far * trail)"
].join("\n")

// The attributes an item's action sets on the button, by its place: read only while its modifier is held, where it
// has one (`shift-type-r_3`).
function actionAttributes(entry: WheelEntry): Array<[String, String]> {
  const at = entry.path
  const held = entry.modifier
  const before = held == nil ? "" : `${held == WheelModifier.Shift ? "shift" : held == WheelModifier.Ctrl ? "ctrl" : "alt"}-`
  return match (entry.action) {
    .Spell => [[`${before}type-${at}`, "spell"], [`${before}spell-${at}`, entry.action.spell]]
    .Item => [[`${before}type-${at}`, "item"], [`${before}item-${at}`, `item:${entry.action.item}`]]
    .Macro => [[`${before}type-${at}`, "macro"], [`${before}macro-${at}`, entry.action.macro]]
    .MacroText => [[`${before}type-${at}`, "macro"], [`${before}macrotext-${at}`, entry.action.text]]
    .Menu, .Slot, .Ours => []
  }
}

public class SecureWheel {
  // Whether the wheel is up, and the ring it shows (`r`, `r_3`).
  public state open = false
  public state level: String = ROOT
  // The cursor from where it was as the wheel opened, right and up, in the screen's units: what the art aims by, as the
  // restricted code does (its button stands centred on that point).
  public state aimX: Number = 0
  public state aimY: Number = 0
  // Where the wheel's middle stands, from the screen's bottom left, in its units: where the art is drawn (the screen's
  // middle for a centred wheel, else where the cursor was as it opened).
  public state middleX: Number = 0
  public state middleY: Number = 0
  // How far it has opened, 0 to 1, over `OPENING_TIME`; and a count that moves while it is up, every `STATE_EVERY`
  // seconds: what an item's state (its cooldown, its range) is read again by.
  public state opening: Number = 1
  public state tick = 0
  // A count that moves as the mouse wheel steps a band: what the art reads the steps again by.
  public state steps = 0
  // An item used, by its place, after the client did its action: an item of ours is done by whoever hears it.
  public const picked: Event<String> = new Event()

  // The client's restricted code runs in the header's environment; the button is what the key and the mouse click.
  const header: any Client.Frame
  const button: any Client.Button
  // Follows the cursor while the wheel is up: its script is set as it opens and taken away as it closes.
  const follower: any Client.Frame
  // The bands round the square of the aim's middle (`BANDS`): each hears the cursor come into it (`LEASH`), and lets
  // every click through.
  const bands: Array<any Client.Frame>
  // The attributes written for the items last, unwritten before others are.
  written: mut Array<String> = []
  writtenOnHeader: mut Array<String> = []
  picks: Integer = 0
  // The keys that hold it, without their modifiers (`"Q"` of `"CTRL-Q"`): what the client says is down.
  held: mut Array<String> = []
  openedAt: Number = 0
  readAt: Number = 0
  centred: Boolean = false

  constructor(
    // The button's global name: what the client's binding clicks.
    name: String
  ) {
    self.header = Client.CreateFrame("Frame", nil, Client.UIParent, "SecureHandlerBaseTemplate")
    const made = Client.CreateFrame("Button", name, Client.UIParent, "SecureActionButtonTemplate")
    self.button = made is Client.Button ? made : panic("the client makes a Button")
    self.follower = Client.CreateFrame("Frame", nil, Client.UIParent, nil)
    self.bands = BANDS.map(band => Client.CreateFrame("Frame", nil, self.button, "SecureHandlerBaseTemplate"))
    Ordaen.afterCombat(() => self.setUp())
  }

  // The button laid out and its click wrapped in the client's restricted code, then heard: the wrap sets the click's
  // script anew (`SetScript`), which drops every hook told before it, so the hook comes after.
  setUp(mut self) {
    const header = self.header
    const button = self.button
    button.Hide()
    button.SetFrameStrata("FULLSCREEN_DIALOG")
    button.RegisterForClicks("AnyDown", "AnyUp")
    // The click's release does the item (`CHOICE`): a secure action button acts on the press where the player's
    // «use on key down» is on (SecureActionButton_OnClick), so the button says it acts on the release.
    button.SetAttribute("useOnKeyDown", false)
    Client.SecureHandlerSetFrameRef(header, "button", button)
    for (band of self.bands) {
      band.SetMouseMotionEnabled(true)
      band.SetMouseClickEnabled(false)
      Client.SecureHandlerWrapScript(band, "OnEnter", header, LEASH, nil)
    }
    button.EnableMouse(true)
    button.EnableMouseWheel(true)
    const high = Client.UIParent.GetHeight() * 2
    const wide = Client.UIParent.GetWidth() * 2
    button.SetSize(wide, high)
    header.SetAttribute("level", ROOT)
    header.SetAttribute("dead", DEAD_ZONE / 1ui)
    Client.RegisterAttributeDriver(header, "fighting", "[combat] yes; no")
    Client.SecureHandlerWrapScript(button, "OnClick", header, CHOICE, nil)
    _ = button.HookScript("OnClick", (frame: Unknown, how: Unknown, down: Unknown): nil => self.heard())
    Client.SecureHandlerWrapScript(button, "OnMouseWheel", header, STEP, nil)
    _ = button.HookScript("OnMouseWheel", (frame: Unknown, offset: Unknown): nil => { self.steps += 1 })
  }

  // The rings and their items and how the wheel is laid out, written out of a fight (in one, at its end).
  public apply(mut self, rings: Array<WheelRing>, entries: Array<WheelEntry>, setup: WheelSetup) {
    Ordaen.afterCombat(() => self.write(rings, entries, setup))
  }

  write(mut self, rings: Array<WheelRing>, entries: Array<WheelEntry>, setup: WheelSetup) {
    for (name of self.written) { self.button.SetAttribute(name, nil) }
    for (name of self.writtenOnHeader) { self.header.SetAttribute(name, nil) }
    self.written.clear()
    self.writtenOnHeader.clear()
    self.centred = setup.centred
    self.header.SetAttribute("remember", setup.remember)
    self.header.SetAttribute("dead", DEAD_ZONE / 1ui * setup.scale)
    self.header.SetAttribute("trailing", setup.trailing)
    const reach = REACH / 1ui * setup.scale
    self.header.SetAttribute("trail", reach * TRAIL)
    self.placeBands(reach)
    for (ring of rings) {
      self.onHeader(`count-${ring.path}`, ring.count)
      self.header.SetAttribute(`step-${ring.path}`, nil)
      const cut = ring.path.match("^(.+)_%d+$")
      if (cut != nil) { self.onHeader(`up-${ring.path}`, cut) }
    }
    for (entry of entries) {
      const action = entry.action
      if (action == WheelAction.Menu) { self.onHeader(`menu-${entry.path}`, true) }
      if (action is WheelAction.Slot) {
        const children = rings.find(ring => ring.path == entry.path)
        self.onHeader(`slot-${entry.path}`, children?.count ?? 0)
        self.onHeader(`mode-${entry.path}`, String.of(action.mode))
      }
      if (entry.refusesInFight) { self.onHeader(`fightoff-${entry.path}`, true) }
      for (pair of actionAttributes(entry)) {
        self.button.SetAttribute(pair[1], pair[2])
        self.written.push(pair[1])
      }
    }
  }

  onHeader(mut self, name: String, value: String | Integer | Boolean) {
    self.header.SetAttribute(name, value)
    self.writtenOnHeader.push(name)
  }

  // The item of a submenu or a slot of several the mouse wheel stepped to, by its place: 0 for none, the ring itself.
  public step(self, path: String): Integer {
    const kept = self.header.GetAttribute(`step-${path}`)
    return kept is Integer ? kept : 0
  }

  // The child a slot of several does now, by the slot's place: the client's restricted code keeps it.
  public current(self, path: String): Integer {
    const kept = self.header.GetAttribute(`current-${path}`)
    return kept is Integer ? kept : 1
  }

  // The keys that hold the wheel, by the client's names (`"CTRL-Q"`), bound over the player's own out of a fight.
  public bind(mut self, keys: Array<String>) {
    self.held.clear()
    for (key of keys) { self.held.push(key.match("^.+%-(.+)$") ?? key) }
    const header = self.header
    const name = self.button.GetName() ?? panic("the button is named")
    Ordaen.afterCombat(() => {
      Client.ClearOverrideBindings(header)
      for (key of keys) { Client.SetOverrideBindingClick(header, true, key, name, "Key") }
    })
  }

  // After each click the client did: an item used, told while the wheel still reads as up (its owner knows which
  // ring it was), then the wheel's state as its restricted code left it.
  heard(mut self) {
    const picks = self.header.GetAttribute("picks")
    if (picks is Integer && picks != self.picks) {
      self.picks = picks
      const chosen = self.header.GetAttribute("chosen")
      if (chosen is String) { self.picked.emit(chosen) }
    }
    const shown = self.button.IsShown()
    const level = self.header.GetAttribute("level")
    self.level = level is String ? level : ROOT
    if (shown != self.open) {
      self.open = shown
      self.follow(shown)
    }
  }

  // Closed as its restricted code closes it: out of a fight alone, as the button is protected.
  close(mut self) {
    self.button.Hide()
    Client.ClearOverrideBindings(self.button)
    self.header.SetAttribute("level", ROOT)
    self.heard()
  }

  // The bands round the square of the aim's middle, `reach` from it each way.
  placeBands(self, reach: Number) {
    const far = Client.UIParent.GetWidth().max(Client.UIParent.GetHeight()) * 2
    for (i of 1..BANDS.length) {
      const band = BANDS[i] ?? panic("a band for each frame")
      const frame = self.bands[i] ?? panic("a frame for each band")
      frame.ClearAllPoints()
      frame.SetPoint(band.point, self.button, "CENTER", band.x * reach, band.y * reach)
      frame.SetSize(band.across ? 2 * far : far, band.across ? far : 2 * reach)
    }
  }

  // The cursor followed while the wheel is up, and not at all once it closes; it opens over `OPENING_TIME`.
  follow(mut self, on: Boolean) {
    if (!on) {
      self.follower.SetScript("OnUpdate", nil)
      return
    }
    self.openedAt = Client.GetTime()
    self.readAt = self.openedAt
    self.opening = 0
    self.aim()
    self.follower.SetScript("OnUpdate", (): nil => self.aim())
  }

  // While it is up: its key let go closes it, a release the client dropped (a mouse press on a frame while a bound
  // key is held loses that key's release) as well as one it told. Out of a fight alone: in one the restricted code
  // has no `IsKeyDown` and addon code may not hide the button, so there Escape or a right click closes it.
  aim(mut self) {
    if (!self.held.any(key => Client.IsKeyDown(key) == true) && !Client.InCombatLockdown()) {
      self.close()
      return
    }
    const now = Client.GetTime()
    if (self.opening < 1) { self.opening = ((now - self.openedAt) / OPENING_TIME).min(1) }
    if (now - self.readAt >= STATE_EVERY) {
      self.readAt = now
      self.tick += 1
    }
    const scale = Client.UIParent.GetEffectiveScale()
    const cursorX, cursorY = Client.GetCursorPosition()
    const fromX, fromY = self.button.GetCenter()
    if (fromX == nil || fromY == nil) { return }
    const screenX, screenY = Client.UIParent.GetCenter()
    const middleX = self.centred ? screenX ?? fromX : fromX
    const middleY = self.centred ? screenY ?? fromY : fromY
    if (middleX != self.middleX || middleY != self.middleY) {
      self.middleX = middleX
      self.middleY = middleY
    }
    const x = cursorX / scale - fromX
    const y = cursorY / scale - fromY
    if ((x - self.aimX).abs() < 0.5 && (y - self.aimY).abs() < 0.5) { return }
    self.aimX = x
    self.aimY = y
  }
}
