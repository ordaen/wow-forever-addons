import Client from "$client"
import Test from "$test"
import { GearWorth, Places, SPEC_WEIGHTS, classCanUse, defaultBuildOf, placesFor, scoreWith, specOf, specsOf, upgradeText } from "Ordaen"

test "a class weighs by the build picked, else the tree with the most points" {
  Test::expect(specOf("WARRIOR", 3, nil, nil)?.key == "protection")
  Test::expect(specOf("PALADIN", 3, "shockadin", nil)?.key == "shockadin")
  Test::expect(specOf("PALADIN", 1, "no such build", nil)?.key == "holy")
  Test::expect(specOf("DRUID", 3, nil, nil)?.key == "bear" && specsOf("MAGE").length == 6)
  Test::expect(specOf("NOT A CLASS", 1, nil, nil) == nil)
}

test "before its first talent point a class weighs by the build the profile prefers, else by its default" {
  Test::expect(specOf("PALADIN", nil, nil, nil)?.key == "retribution")
  Test::expect(specOf("WARRIOR", nil, nil, nil)?.key == "arms")
  Test::expect(specOf("PALADIN", nil, nil, "holy")?.key == "holy")
  Test::expect(specOf("PALADIN", 2, nil, "holy")?.key == "protection")
  Test::expect(SPEC_WEIGHTS.all(spec => defaultBuildOf(spec.classTag) != "" &&
      specsOf(spec.classTag).any(build => build.key == defaultBuildOf(spec.classTag))))
}

test "an item's worth is each stat by its weight, a rating by the percentage it gives, a weapon's damage by where it fires" {
  Client::GetCombatRatingBonusForCombatRatingValue = (rating: integer, value: number): number | nil => value / 14
  const arms = SPEC_WEIGHTS.find(spec => spec.key == "arms") ?? throw Error { message: "arms" }
  const w = arms.leveling
  let stats: map<string, number> = mut {}
  stats["ITEM_MOD_STRENGTH_SHORT"] = 10
  stats["ITEM_MOD_CRIT_RATING_SHORT"] = 14
  stats["ITEM_MOD_DAMAGE_PER_SECOND_SHORT"] = 5
  stats["ITEM_MOD_NOT_A_STAT"] = 99
  const melee = scoreWith(w, stats, false)
  Test::expect((melee - (10 * w.strength + w.critRating + 5 * w.meleeDps)).abs() < 0.0001)
  const far = scoreWith(w, stats, true)
  Test::expect((far - (10 * w.strength + w.critRating + 5 * w.rangedDps)).abs() < 0.0001)
}

test "an upgrade reads «+n%», and none for nothing or for less" {
  Test::expect(upgradeText(0.153) == "+15%" && upgradeText(0) == "" && upgradeText(-0.2) == "" && upgradeText(nil) == "")
}

test "a class weighs only what it can ever use: a Paladin a shield and a two-hander, never a dagger, cloth for a Priest" {
  Test::expect(classCanUse("PALADIN", 4, 6) && classCanUse("PALADIN", 2, 1) && !classCanUse("PALADIN", 2, 15))
  Test::expect(classCanUse("PRIEST", 4, 1) && !classCanUse("PRIEST", 4, 2) && classCanUse("PRIEST", 4, 0))
  Test::expect(classCanUse("MAGE", 2, 20) && classCanUse("ROGUE", 0, 0))
}

test "a one-hander for one who can't wield two takes the main hand alone; an off-hand item, under a two-hander, both" {
  Test::expect(slotsOf(placesFor("INVTYPE_WEAPON", false, false)) == "16")
  Test::expect(slotsOf(placesFor("INVTYPE_WEAPON", true, false)) == "16,17")
  const shield = placesFor("INVTYPE_SHIELD", false, true)
  Test::expect(slotsOf(shield) == "16,17" && shield?.both == true)
  Test::expect(placesFor("INVTYPE_SHIELD", false, false)?.both == false)
}

function slotsOf(places: Places | nil): string {
  return (places ?? throw Error { message: "the item is worn" }).slots.map(slot => string::of(slot)).join(",")
}

// An upgrade's answer as a window holds it: worked out once, and again only as what it reads changes.
class Held {
  derived up: number | nil = self.worth.upgradeOf("item:new")
  const worth: GearWorth
  constructor(worth: GearWorth) { self.worth = worth }
}

test "an upgrade's answer follows the gear: a piece put on is what the next is weighed against" {
  Client::C_Item::GetItemInfoInstant = (item: string | integer): (number | nil, string | nil, string | nil, string | nil, FileId | nil, number | nil, number | nil) => {
    return (1201, "Weapon", "Mace", "INVTYPE_WEAPON", nil, 2, 4)
  }
  Client::C_Item::GetItemStats = (link: string): unknown => {
    const stats: map<string, number> = { ["ITEM_MOD_INTELLECT_SHORT"]: link == "item:new" ? 10 : 8 }
    return stats
  }
  Client::CanDualWield = (): boolean => false
  let wearing = false
  Client::GetInventoryItemLink = (unit: string, slot: number): string | nil => wearing && slot == 16 ? "item:old" : nil
  const held = new Held(new GearWorth())
  Test::expect(held.up == 1)
  wearing = true
  Test::event("PLAYER_EQUIPMENT_CHANGED", 16, true)
  Test::expect(held.up != nil && ((held.up ?? 0) - 0.25).abs() < 0.0001)
}
