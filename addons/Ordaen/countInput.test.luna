// The library's CountInput: a whole number the player sets, never outside its least and its most, which may move.
import { Align } from "$ltml"
import Test from "$test"
import { CountInput, held } from "@/countInput"

// A count between bounds the test moves.
class Pair {
  state count = 3
  state least = 1
  state most = 5

  public render(self): Template {
    return $ltml {
      <box xAlign={Align.Start}>
        <CountInput value={mut self.count} least={self.least} most={self.most} />
      </box>
    }
  }
}

function click(text: String) {
  Test.click(Test.holding(text, nil), nil)
  Test.flush()
}

test "a value is held between its bounds: the least where the most is under it" {
  Test.expect(held(3, 1, 5) == 3)
  Test.expect(held(9, 1, 5) == 5)
  Test.expect(held(-2, 1, 5) == 1)
  Test.expect(held(4, 1, 0) == 1)
}

test "− and + stop at the bounds, and a bound moved past the value takes it along" {
  let page = new Pair()
  Test.mount(page, { left: 0, top: 0, width: 300, height: 100 })
  Test.shot("3 of 1 to 5")

  for (step of 1..4) { click("+") }
  Test.expect(page.count == 5)
  Test.shot("+ four times: 5, the most, + disabled")

  for (step of 1..6) { click("-") }
  Test.expect(page.count == 1)
  Test.shot("- six times: 1, the least, - disabled")
  page.count = 5

  // The bags emptied while the window is open: the most falls under the value, which follows it.
  page.most = 2
  Test.flush()
  Test.expect(page.count == 2)
  Test.shot("the most falls to 2: the value with it")

  page.least = 0
  page.most = 0
  Test.flush()
  Test.expect(page.count == 0)
  page.least = 1
  Test.flush()
  Test.expect(page.count == 1)
  click("+")
  Test.expect(page.count == 1)
  Test.shot("the most under the least: the least, everything disabled")

  page.most = 9
  page.count = 20
  Test.flush()
  Test.expect(page.count == 9)
  Test.shot("another writes 20 where the most is 9: 9")

  destroy page
  Test.expect(Test.blank())
}

test "Shift steps by 10 and Ctrl by 100, held to the bounds" {
  let page = new Pair()
  page.most = 150
  Test.mount(page, { left: 0, top: 0, width: 300, height: 100 })
  Test.hold([.Shift])
  click("+")
  Test.expect(page.count == 13)
  click("-")
  click("-")
  Test.expect(page.count == 1)
  Test.hold([.Ctrl])
  click("+")
  Test.expect(page.count == 101)
  click("+")
  Test.expect(page.count == 150)
  click("-")
  Test.expect(page.count == 50)
  Test.note(`Shift: 3 + 10, then twice − to the least; Ctrl: + 100, + to the most, − 100: ${page.count}`)
  destroy page
}

test "− and + step as they go down, again after a wait, then at a pace, until let go or at the bound" {
  let page = new Pair()
  page.count = 1
  page.most = 12
  Test.mount(page, { left: 0, top: 0, width: 300, height: 100 })
  Test.moveTo(Test.holding("+", nil))
  Test.press(nil)
  Test.flush()
  Test.expect(page.count == 2)
  Test.pass(0.3)
  Test.expect(page.count == 2)
  Test.pass(0.12)
  const first = page.count
  Test.pass(0.1)
  const later = page.count
  Test.release(nil)
  Test.flush()
  const released = page.count
  Test.note(`down: 2; held 0.3 s: 2; at 0.42 s: ${first}; at 0.52 s: ${later}; let go: ${released}`)
  Test.expect(first == 3 && later == 5 && released == later)
  Test.pass(1)
  Test.expect(page.count == released)

  // Held to the bound: the steps stop there, and nothing is waited for once it is let go.
  Test.press(nil)
  Test.pass(2)
  Test.expect(page.count == 12)
  Test.release(nil)
  Test.pass(1)
  Test.expect(page.count == 12)
  Test.shot("held to 12, the most: + disabled, let go")

  // A short press is one step, as it goes down.
  Test.moveTo(Test.holding("-", nil))
  Test.press(nil)
  Test.pass(0.1)
  Test.release(nil)
  Test.flush()
  Test.expect(page.count == 11)
  destroy page
}

test "− and + under the cursor name their keys: a click, Shift, Ctrl, and holding" {
  Test.englishOnly()
  let page = new Pair()
  Test.mount(page, { left: 0, top: 0, width: 300, height: 100 })
  Test.moveTo(Test.holding("+", nil))
  Test.flush()
  Test.shot("the cursor on +: its Tip, each key and how far it steps")
  Test.expect(Test.surfaceHolding("More").x > 0)
  Test.expect(Test.surfaceHolding("Shift+Left-click").x > 0)
  Test.expect(Test.surfaceHolding("+100").x > 0)
  Test.expect(Test.surfaceHolding("Hold to keep stepping, up to the limit.").x > 0)
  Test.moveTo(Test.holding("-", nil))
  Test.flush()
  Test.expect(Test.surfaceHolding("Fewer").x > 0)
  Test.expect(Test.surfaceHolding("-10").x > 0)
  Test.moveTo({ x: -10, y: -10 })
  Test.flush()
  Test.shot("the cursor away: no Tip")
  destroy page
}

// Steps alone, near the most a count takes in three digits.
class Steps {
  state count = 98
  state most = 999

  public render(self): Template {
    return $ltml {
      <box xAlign={Align.Start}>
        <CountInput value={mut self.count} least={1} most={self.most} />
      </box>
    }
  }
}

test "three digits stand inside the number's room between − and +" {
  let page = new Steps()
  Test.mount(page, { left: 0, top: 0, width: 300, height: 100 })
  Test.page().button("+").click()
  Test.page().button("+").click()
  Test.expect(Test.page().text("100").shown())
  page.count = 998
  Test.page().button("+").click()
  Test.expect(Test.page().text("999").shown() && page.count == 999)
}
