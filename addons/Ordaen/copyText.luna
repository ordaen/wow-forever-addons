// CopyText: a text the player reads, and selects and copies (Ctrl+C), and never changes: a guild's message of the
// day, its information, a code to hand on. It reads as body text (no field's well); a click puts the cursor in it and
// the mouse or Shift and the arrows mark a part of it. Its lines wrap at its width; what doesn't fit its height is cut
// at its bottom.
import { Overflow } from "$ltml"
import { Component } from "@/module"

const INK: Color = Color.hex("#e8dcc4")

public class CopyText implements Component {
  value: Signal<String>
  height: Signal<Number<Length>>
  constructor(
    value: Signal<String>,
    // As high as this; as wide as where it stands.
    height: Signal<Number<Length>>
  ) {
    self.value = value
    self.height = height
  }

  public render(self): Template {
    return $ltml {
      <input value={self.value} readOnly={true} height={self.height} textColor={INK} overflow={Overflow.Hidden}
             multiline={true} />
    }
  }
}
