// A module loaded on demand: off at login and turned on later, on at login, turned off. `OrdaenMinimap` is the module
// (its `addon.json` says `"loadOnDemand": true`). Waits for the `loadOnDemand` key on the modules: see `next/move.md`,
// «Blocked» (a root that enables its dependents as it is made runs before the files only the index imports).
import Game from "$game"
import Runtime from "$runtime"
import Test from "$test"
import root Minimap from "OrdaenMinimap"
import root Ordaen from "Ordaen"

function minimapAddon(): Runtime.Addon {
  const ordaen = Runtime.Addon.of(Ordaen) ?? panic("Ordaen is installed")
  for (addon of ordaen.dependents()) {
    if (addon.name == "OrdaenMinimap") { return addon }
  }
  panic("OrdaenMinimap needs Ordaen")
}

test "a module off at login, turned on, is loaded without a reload" {
  Game.saved.store(.Account, "choices", { OrdaenMinimap: false })
  Test.reload()
  Test.expect(Minimap == nil)
  Ordaen?.turn(minimapAddon(), true)
  Test.expect(Minimap != nil)
  Test.expect(Ordaen?.modules.length == 1)
}

test "a module on at login is loaded with Ordaen" {
  Game.saved.store(.Account, "choices", {})
  Test.reload()
  Test.expect(Minimap != nil)
  Test.expect(Ordaen?.modules.length == 1)
}

test "a module turned off ends its root and is off at the next login" {
  Game.saved.store(.Account, "choices", {})
  Test.reload()
  Ordaen?.turn(minimapAddon(), false)
  Test.expect(Minimap == nil)
  Test.expect(Ordaen?.modules.length == 0)
  Test.reload()
  Test.expect(Minimap == nil)
  Test.expect(!minimapAddon().isEnabled())
}
