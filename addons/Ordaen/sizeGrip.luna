// SizeGrip: the corner a part is resized by, the client's own grabber (lit under the cursor, pressed while held),
// turned to point at the corner it stands in. What holds it places it there and sizes itself as it is dragged.
import { Art, ByInteractionState, Event } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"

// The corner the grip stands in: the one the part grows towards.
public enum GripCorner { BottomRight, TopRight }

const SIZE = 18.75dp

public class SizeGrip implements Component {
  public grab: Event<Event.Drag> = new Event()
  public drag: Event<Event.Drag> = new Event()
  public drop: Event<nil> = new Event()

  derived art: ByInteractionState<Art> = { default: Ordaen.art.ctl.grip, hover: Ordaen.art.ctl.gripHover, pressed: Ordaen.art.ctl.gripDown }
  // The client's grabber points at the bottom right.
  derived turn: Number<Angle> = self.corner == GripCorner.TopRight ? -90deg : 0deg

  corner: Signal<GripCorner>
  constructor(corner: Signal<GripCorner> = GripCorner.BottomRight) {
    self.corner = corner
  }

  onGrab(mut self, drag: Event.Drag) { self.grab.emit(drag) }
  onDrag(mut self, drag: Event.Drag) { self.drag.emit(drag) }
  onDrop(mut self) { self.drop.emit() }

  public render(self): Template {
    return $ltml {
      <box width={SIZE} height={SIZE} background={self.art} rotation={self.turn} @dragStart={self.onGrab} @drag={self.onDrag}
           @dragStop={self.onDrop} />
    }
  }
}
