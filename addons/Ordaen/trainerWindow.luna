// TrainerWindow: the window at a trainer, in place of the game's, for whichever module owns the trainer's kind (Ordaen
// Spells a class trainer, Ordaen Professions a profession's). A profession trainer's skill bar on top; what the trainer
// teaches (each skill or recipe, its rank, the level and the skill it is learned at, its price) as a table or as a list
// under the trainer's categories (folded by a click); the search, and on the toolbar's right the sort, the filter (what
// can be learned now, what can't yet, what is known, what is ignored) and the view; the picked service's
// card in the right column with «Learn» (a new profession asked first, greyed with no free slot); the game's tooltip of
// a service while the cursor is anywhere on its row. A double press learns a service, a right-click opens its menu
// (learn, ignore it or stop ignoring it, its link in the chat). The footer counts what can be learned (green), what
// can't yet (red) and what is known (blue), each a dot and its number whose tip says what it counts, and shows the
// player's money. The services are the game's (`Game.trainer`); a service the player can't learn yet is red, a known
// one dim, one ignored grey. The marks are the character's, kept by the owning module
// (`TrainerIgnored`), every rank of a spell under its name.
import Client from "$client"
import Game from "$game"
import { Align, Columns, Event, Frame, MouseButton, Overflow, Position, TextFont, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { ARTWORK } from "@/art"
import { Dialog } from "@/dialog"
import { Choice } from "@/dropdown"
import { FilterButton, FilterGroup, switched } from "@/filter"
import { FoldCaption } from "@/foldCaption"
import Locale from "@/locales"
import { Menu, MenuEntry } from "@/menu"
import { Component } from "@/module"
import { Money } from "@/money"
import { ButtonPlate, PushButton } from "@/pushButton"
import { ModuleMemory } from "@/settings"
import { SkillBar } from "@/skillBar"
import { Column, Table, TableRow } from "@/table"
import { Tip, TipText } from "@/tip"
import { ToolPick, ToolSort, Toolbar, sortChoices } from "@/toolbar"
import { SECONDARY_TEXT, TIGHT_LINE, TITLE_TEXT } from "@/units"
import { FOOTER_ROOM, KeptWindow, Window, WindowSide, WindowTabSpec } from "@/window"

// What the filter's switches keep: what can be learned now, what can't yet, what is known, what is marked never to
// learn.
public enum TrainerShow implements Plain {
  Available = "available"
  Unavailable = "unavailable"
  Known = "known"
  Ignored = "ignored"
}
public enum TrainerView implements Plain { Table = "table", List = "list" }

// The filter as the window starts: every service shown but what is known.
const FILTER_START: Map<TrainerShow, Boolean> = switched(switched({}, [TrainerShow.Available, TrainerShow.Unavailable, TrainerShow.Ignored], true), [TrainerShow.Known], false)

// The services the player ignored, by their name (every rank of a spell): the character's, kept by the
// module that owns the trainer's kind.
public struct TrainerIgnored implements Plain {
  names: Map<String, Boolean> = {}
}

// What a service's menu does, in its order.
enum MenuAct { Learn, Ignore, Link }

// How the player left a trainer's window, the owning module's profile's: what the filter shows, the view, the column or
// sort it is ordered by (0: the trainer's order) and its way. The search isn't kept. Each kind opens in its own view
// (`TrainerList { view: .List }` for a class trainer's categories).
public struct TrainerList implements Plain {
  shows: Map<TrainerShow, Boolean> = FILTER_START
  view: TrainerView = TrainerView.Table
  sorted: Integer = 0
  descending: Boolean = false
}

// What a sort orders by; a trainer's kind lays its columns out as one of these each.
enum Key { Name, Rank, Level, Skill, Cost, Status }

const INK: Color = Color.hex("#e8dcc4")
const DIM: Color = Color.hex("#a3977f")
const GOLD: Color = Color.hex("#ffd100")
const RED: Color = Color.hex("#ff4040")
const CLEAR: Color = Color.hex("#00000000")
const GREEN: Color = Color.hex("#40d060")
const BLUE: Color = Color.hex("#4a9eff")
// A service ignored: its icon greyed, and its row under an opaque plate.
const GREY: Color = Color.hex("#7a7a7a")
// An ignored row's plate: the row under it barely seen.
const PLATE: Color = Color.hex("#16110cd9")
const WHITE: Color = Color.hex("#ffffff")
// A footer count's dot.
const DOT = 9.375dp
// A picked line, as a picked table row is shaded.
const PICKED: Color = Color.hex("#00000040")
const ICON = 28.125dp
const CARD_WIDTH = 281.25dp
const TRAIN_WIDTH = 140.625dp
const FILL: Array<Track> = [{ fr: 1 }]
const BODY: Array<Track> = ["max-content", "max-content", { fr: 1 }]
const NAMED: Array<Track> = [ICON, { fr: 1 }]
const LINE: Array<Track> = [ICON, { fr: 1 }, "max-content"]
const PAIR: Array<Track> = [{ fr: 1 }, "max-content"]
const CARD: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
const FOOT: Columns = { each: "max-content" }
const SPREAD: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
const DIALOG = 375dp
const FILTERS: Array<FilterGroup<TrainerShow>> = [
  {
    label: nil,
    options: [
      { key: TrainerShow.Available, label: Locale.TRAINER_AVAILABLE }, { key: TrainerShow.Unavailable, label: Locale.TRAINER_UNAVAILABLE },
      { key: TrainerShow.Known, label: Locale.TRAINER_KNOWN }, { key: TrainerShow.Ignored, label: Locale.TRAINER_IGNORED }
    ]
  }
]
// The trainer's views, as its view button and an owner's settings page offer them.
public const TRAINER_VIEWS: Array<Choice<TrainerView>> = [
  { value: TrainerView.Table, label: Locale.TRAINER_VIEW_TABLE, icon: ARTWORK.ctl.tool.table },
  { value: TrainerView.List, label: Locale.TRAINER_VIEW_LIST, icon: ARTWORK.ctl.tool.list }
]
// A sort no column shows: what can be learned now first, then what can't yet, then what is known.
const MORE_SORTS: Array<String> = [Locale.TRAINER_AVAILABLE_FIRST]
// The columns after the service's own: a class trainer's rank and level, a profession trainer's level and skill; the
// price last.
const CLASS_KEYS: Array<Key> = [Key.Name, Key.Rank, Key.Level, Key.Cost, Key.Status]
const TRADE_KEYS: Array<Key> = [Key.Name, Key.Level, Key.Skill, Key.Cost, Key.Status]
const NARROW = 70.3125dp
const PRICE = 117.1875dp
const TRACKS: Array<Track> = [{ fr: 1 }, NARROW, NARROW, PRICE]

// The sorts a kind of trainer's window offers, as its sort button and an owner's settings page list them: its trainer's
// order (0), each column, «available first».
public function trainerSorts(noun: String, trade: Boolean): Array<Choice<Integer>> {
  const list: Array<Choice<Integer>> = [{ value: 0, label: Locale.TRAINER_ORDER }]
  for (choice of sortChoices(columnsOf(noun, trade), MORE_SORTS)) { list.push(choice) }
  return list
}

function columnsOf(noun: String, trade: Boolean): Array<Column> {
  return [
    { title: noun, width: { fr: 1 }, sortable: true },
    { title: trade ? Locale.TRAINER_COLUMN_LEVEL : Locale.TRAINER_COLUMN_RANK, width: NARROW, align: Align.End, sortable: true },
    { title: trade ? Locale.TRAINER_COLUMN_SKILL : Locale.TRAINER_COLUMN_LEVEL, width: NARROW, align: Align.End, sortable: true },
    { title: Locale.TRAINER_COLUMN_COST, width: PRICE, align: Align.End, sortable: true }
  ]
}

// Whether the player ignores the service: a known one never is.
function isIgnored(service: Game.TrainerService, ignored: Map<String, Boolean>): Boolean {
  return service.status != Game.ServiceStatus.Learned && ignored[service.name] == true
}

function showOf(service: Game.TrainerService, ignored: Map<String, Boolean>): TrainerShow {
  if (isIgnored(service, ignored)) { return .Ignored }
  return match (service.status) {
    .Available => .Available
    .Unavailable => .Unavailable
    .Learned => .Known
  }
}

// A switch the kept filter doesn't name yet (one added since it was kept) shows its services.
function passes(service: Game.TrainerService, filter: Map<TrainerShow, Boolean>, query: String, ignored: Map<String, Boolean>): Boolean {
  if (query != "" && !service.name.lower().contains(query)) { return false }
  return filter[showOf(service, ignored)] != false
}

// Whether the player can learn the service now: one the trainer offers, not ignored, paid for, and a
// new profession with a slot free.
function learnable(service: Game.TrainerService, ignored: Map<String, Boolean>): Boolean {
  return service.status == Game.ServiceStatus.Available && !isIgnored(service, ignored) && service.cost <= Game.money.amount &&
    !(service.profession && !slotFree())
}

// The service's link, as the trainer gives it: a spell's, or the item a recipe makes.
function linkOf(service: Game.TrainerService): String | nil {
  return Client.GetTrainerServiceItemLink(service.index)
}

// The order of a sort, the trainer's where two are alike or none is picked.
function before(a: Game.TrainerService, b: Game.TrainerService, key: Key | nil, descending: Boolean): Boolean {
  const ka = key == nil ? "" : keyOf(a, key)
  const kb = key == nil ? "" : keyOf(b, key)
  if (ka != kb) { return descending ? kb < ka : ka < kb }
  return a.index < b.index
}

function statusRank(status: Game.ServiceStatus): Integer {
  return match (status) {
    .Available => 1
    .Unavailable => 2
    .Learned => 3
  }
}

function keyOf(service: Game.TrainerService, key: Key): String {
  return match (key) {
    Key.Name => service.name.lower()
    Key.Rank => service.rank.lower()
    Key.Level => "%08d".format(service.level)
    Key.Skill => "%08d".format(service.skill ?? 0)
    Key.Cost => "%012d".format(service.cost)
    Key.Status => String.of(statusRank(service.status))
  }
}

// A name is never red: a learned service's is dim, any other's in ink.
function inkOf(service: Game.TrainerService): Color {
  return service.status == Game.ServiceStatus.Learned ? DIM : INK
}

// What the service asks for is red while it isn't met.
function needsInkOf(service: Game.TrainerService): Color {
  return service.status == Game.ServiceStatus.Unavailable ? RED : DIM
}

// The level a service needs, red while the player hasn't reached it.
function levelInkOf(service: Game.TrainerService): Color {
  return service.status != Game.ServiceStatus.Learned && service.level > Game.player.level ? RED : INK
}

// The skill a recipe needs, red while it can't be learned and the level isn't what holds it back.
function skillInkOf(service: Game.TrainerService): Color {
  return service.status == Game.ServiceStatus.Unavailable && service.level <= Game.player.level ? RED : INK
}

function titleOf(service: Game.TrainerService): String {
  return service.rank == "" ? service.name : "%s (%s)".format(service.name, service.rank)
}

// What the service asks for, as its line under the name says it.
function needsOf(service: Game.TrainerService): String {
  if (service.status == Game.ServiceStatus.Learned) { return Locale.TRAINER_KNOWN }
  const skill = service.skill
  const level = service.level > 1 ? Locale.TRAINER_NEEDS_LEVEL.format(service.level) : ""
  if (skill == nil) { return level }
  const skilled = Locale.TRAINER_NEEDS_SKILL.format(skill)
  return level == "" ? skilled : `${level} · ${skilled}`
}

// An icon of a service that can't be learned yet is tinted red, as the game's is.
function tintOf(service: Game.TrainerService): Color {
  return service.status == Game.ServiceStatus.Unavailable ? RED : WHITE
}

// One service as a row of the table: a class trainer's rank and level, a profession trainer's level and skill.
// What every row of the window reads (the picked service, the one whose menu is open and its entries, the names ignored
// to learn) and what each tells it, by the service's place in the trainer's list: a pick, a double press, its menu
// asked for, an entry of the menu chosen, the menu left.
class Rows {
  public pick: Event<Integer> = new Event()
  public double: Event<Integer> = new Event()
  public menu: Event<Integer> = new Event()
  public chose: Event<Integer> = new Event()
  public closed: Event<nil> = new Event()

  public picked: Signal<Integer>
  public menuAt: Signal<Integer>
  public entries: Signal<Array<MenuEntry>>
  public ignored: Signal<Map<String, Boolean>>
  constructor(picked: Signal<Integer>, menuAt: Signal<Integer>, entries: Signal<Array<MenuEntry>>, ignored: Signal<Map<String, Boolean>>) {
    self.picked = picked
    self.menuAt = menuAt
    self.entries = entries
    self.ignored = ignored
  }

  // A press on a service's row: the left picks it, the right asks for its menu.
  public press(self, index: Integer, button: MouseButton) {
    if (button == MouseButton.Left) {
      self.pick.emit(index)
    } else if (button == MouseButton.Right) {
      self.menu.emit(index)
    }
  }
}

// An ignored service's plate: over its whole row, opaque, its status in its middle. Its row still takes the cursor,
// so its menu stops ignoring it.
class IgnoredPlate implements Component {
  public render(self): Template {
    return $ltml {
      <box position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} background={PLATE} zLevel={2}
           xAlign={Align.Center} yAlign={Align.Center}>
        <text value={Locale.TRAINER_IGNORED} textColor={DIM} wrap={.None} />
      </box>
    }
  }
}

// What the price's cell says where there is no price: a known service, one given free.
function noPriceOf(service: Game.TrainerService): String {
  if (service.status == Game.ServiceStatus.Learned) { return Locale.TRAINER_KNOWN }
  return "—"
}

class ServiceTableRow implements Component {
  derived ignored: Boolean = isIgnored(self.service, self.rows.ignored)
  derived ink: Color = inkOf(self.service)
  derived tint: Color = tintOf(self.service)
  derived title: String = self.trade ? titleOf(self.service) : self.service.name
  derived second: String = self.trade ? String.of(self.service.level) : self.service.rank
  derived third: String = self.trade ? (self.service.skill == nil ? "—" : String.of(self.service.skill)) : String.of(self.service.level)
  // The level's cell red while unmet (a class trainer's third column, a profession trainer's second); the skill's too.
  derived secondInk: Color = self.trade ? levelInkOf(self.service) : INK
  derived thirdInk: Color = self.trade ? skillInkOf(self.service) : levelInkOf(self.service)
  derived priced: Boolean = self.service.cost > 0 && self.service.status != Game.ServiceStatus.Learned
  derived costInk: Color = self.service.cost > Game.money.amount ? RED : INK
  derived noPrice: String = noPriceOf(self.service)
  derived selected: Boolean = self.rows.picked == self.service.index
  derived menuShown: Boolean = self.rows.menuAt == self.service.index

  service: Signal<Game.TrainerService>
  trade: Signal<Boolean>
  const rows: Rows
  constructor(service: Signal<Game.TrainerService>, trade: Signal<Boolean>, rows: Rows) {
    self.service = service
    self.trade = trade
    self.rows = rows
  }

  onPick(self, button: MouseButton) { self.rows.press(self.service.index, button) }
  onDouble(self) { self.rows.double.emit(self.service.index) }
  onChose(self, place: Integer) { self.rows.chose.emit(place) }
  onClosed(self) { self.rows.closed.emit() }

  // The game's tooltip of the service, as its own trainer window shows it, while the cursor is anywhere on the row.
  onEnter(self, frame: any Frame) { Game.items.showService(frame, self.service.index) }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={TRACKS} selected={self.selected} @pick={self.onPick} @double={self.onDouble} @enter={self.onEnter}>
        <box columns={NAMED} gap={3sp} yAlign={Align.Center}>
          <box width={ICON} height={ICON} icon={self.service.icon} tint={self.tint} />
          <text value={self.title} textColor={self.ink} wrap={.Cut} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.second} textColor={self.secondInk} textFont={TextFont.Numbers} wrap={.None} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.third} textColor={self.thirdInk} textFont={TextFont.Numbers} wrap={.None} />
        </box>
        <box xAlign={Align.End}>
          <Money $if={self.priced} amount={self.service.cost} color={self.costInk} />
          <text $else value={self.noPrice} textColor={DIM} wrap={.None} />
        </box>
        <IgnoredPlate $if={self.ignored} />
        <Menu $if={self.menuShown} entries={self.rows.entries} title={self.service.name} @pick={self.onChose}
              @close={self.onClosed} />
      </TableRow>
    }
  }
}

// One service as a line of the list: its icon, its name, what it asks for, its price.
class ServiceLine implements Component {
  derived ignored: Boolean = isIgnored(self.service, self.rows.ignored)
  derived ink: Color = inkOf(self.service)
  derived tint: Color = tintOf(self.service)
  derived title: String = titleOf(self.service)
  derived needs: String = needsOf(self.service)
  derived needsInk: Color = needsInkOf(self.service)
  derived priced: Boolean = self.service.cost > 0 && self.service.status != Game.ServiceStatus.Learned
  derived costInk: Color = self.service.cost > Game.money.amount ? RED : INK
  derived background: Color = self.rows.picked == self.service.index ? PICKED : CLEAR
  derived menuShown: Boolean = self.rows.menuAt == self.service.index

  service: Signal<Game.TrainerService>
  const rows: Rows
  constructor(service: Signal<Game.TrainerService>, rows: Rows) {
    self.service = service
    self.rows = rows
  }

  onPress(self, press: Event.Press) { self.rows.press(self.service.index, press.button) }
  onKey(self) { self.rows.pick.emit(self.service.index) }
  onDouble(self) { self.rows.double.emit(self.service.index) }
  onChose(self, place: Integer) { self.rows.chose.emit(place) }
  onClosed(self) { self.rows.closed.emit() }
  onEnter(self, frame: any Frame) { Game.items.showService(frame, self.service.index) }

  public render(self): Template {
    return $ltml {
      <box columns={LINE} gap={3sp} yAlign={Align.Center} background={self.background}
           padding={{ top: 2sp, bottom: 2sp, left: 3sp, right: 3sp }}
           @pointerPress={self.onPress} @pointerPress.double={self.onDouble} @pointerEnter={self.onEnter}
           @keyPress(.Enter)={self.onKey} @keyPress(.Space)={self.onKey}>
        <box width={ICON} height={ICON} icon={self.service.icon} tint={self.tint} />
        <box columns={1}>
          <text value={self.title} textColor={self.ink} wrap={.Cut} />
          <text value={self.needs} textColor={self.needsInk} textSize={SECONDARY_TEXT} wrap={.Cut} />
        </box>
        <Money $if={self.priced} amount={self.service.cost} color={self.costInk} />
        <IgnoredPlate $if={self.ignored} />
        <Menu $if={self.menuShown} entries={self.rows.entries} title={self.service.name} @pick={self.onChose}
              @close={self.onClosed} />
      </box>
    }
  }
}

// What every service that can be learned now and isn't ignored costs together.
function availableCost(services: Array<Game.TrainerService>, ignored: Map<String, Boolean>): Integer {
  let total = 0
  for (service of services) {
    if (service.status == Game.ServiceStatus.Available && !isIgnored(service, ignored)) { total += service.cost }
  }
  return total
}

// One count of the footer: the colour its services are known by, how many there are, and what its tip says.
struct StatusCount {
  color: Color
  value: Integer
  title: String
  text: String
}

// A count in the footer: a dot of its colour and its number, no label; under the cursor its tip says what it counts.
class StatusDot implements Component {
  state hovered = false
  derived number: String = String.of(self.count.value)

  count: Signal<StatusCount>
  constructor(count: Signal<StatusCount>) {
    self.count = count
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box columns={FOOT} gap={2sp} yAlign={Align.Center} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <box width={DOT} height={DOT} background={self.count.color} mask={Ordaen.art.panel.faceRound} />
        <text value={self.number} textSize={SECONDARY_TEXT} textFont={TextFont.Numbers} textColor={INK} wrap={.None} />
        <Tip $if={self.hovered} title={self.count.title} text={self.count.text} />
      </box>
    }
  }
}

// The game's facts of the service's spell: its tooltip's lines after its name, the line of what it does left out (the
// card says that itself), each as «left   right».
function factsOf(service: Game.TrainerService | nil): Array<String> {
  const list: Array<String> = []
  const spell = service?.spell
  if (service == nil || spell == nil) { return list }
  const tip = Game.spells.tooltip(spell)
  if (tip == nil) { return list }
  for (at, line of tip.lines) {
    const left = line.left ?? ""
    const right = line.right ?? ""
    if (at > 1 && left != service.description && (left != "" || right != "")) {
      list.push(right == "" ? left : `${left}   ${right}`)
    }
  }
  return list
}

// The numbers of a text, in order, and the text with each number taken out: two ranks of one spell read the same
// but for their numbers.
function numbersOf(text: String): (Array<String>, String) {
  const numbers: Array<String> = []
  const rest = text.replace("(%d+%.?%d*)", (number: String): String => {
    numbers.push(number)
    return "#"
  })
  return numbers, rest
}

// A number of the spell that changes: the player's rank's, and the service's.
struct Change {
  yours: String
  next: String
}

// What changes from the rank of the spell the player has to the service's: each of its numbers that differs, «yours →
// the new one»; nothing where the player has no rank of it, or where the two don't read alike but for their numbers
// (never a guess).
function changesOf(service: Game.TrainerService | nil): Array<Change> {
  const list: Array<Change> = []
  const spell = service?.spell
  if (service == nil || spell == nil) { return list }
  const had = rankHad(service.name, spell)
  if (had == nil) { return list }
  const was = Game.spells.description(had)
  const next = Game.spells.description(spell)
  if (was == nil || next == nil) { return list }
  const old, oldRest = numbersOf(was)
  const now, nowRest = numbersOf(next)
  if (oldRest != nowRest || old.length != now.length) { return list }
  for (at, number of now) {
    const yours = old[at] ?? number
    if (yours != number) { list.push({ yours: yours, next: number }) }
  }
  return list
}

// The spell of the highest rank the player has of a spell by its name, another than the one taught.
function rankHad(name: String, taught: Integer): Integer | nil {
  let best = 0
  let level = -1
  for (entry of Game.spellbook.entries()) {
    if (entry.name == name && entry.learned && entry.id != taught && entry.level > level) {
      best = entry.id
      level = entry.level
    }
  }
  return level < 0 ? nil : best
}

// Whether the player has a profession slot free: two main professions known fill both.
function slotFree(): Boolean {
  const _, second, _, _, _, _ = Client.GetProfessions()
  return second == nil
}

// A category's caption in the list view: its name and how many of its services show; a click folds it.
class CategoryCaption implements Component {
  public toggled: Event<String> = new Event()
  derived title: String = "%s (%d)".format(self.category, self.count)

  const category: String
  count: Signal<Integer>
  folded: Signal<Boolean>
  constructor(category: String, count: Signal<Integer>, folded: Signal<Boolean>) {
    self.category = category
    self.count = count
    self.folded = folded
  }

  onToggle(self) { self.toggled.emit(self.category) }

  public render(self): Template {
    return $ltml {
      <FoldCaption title={self.title} folded={self.folded} @toggled={self.onToggle} />
    }
  }
}

public class TrainerWindow implements Component {
  // The ⚙ in the window's corner: the owning module's settings.
  public settings: Event<nil> = new Event()

  state tab = 1
  state search = ""
  state picked = 0
  state folded: Map<String, Boolean> = {}
  // A new profession's «Learn», waiting for the player's word.
  state confirming = false
  // The service whose menu is open, by its place in the trainer's list; 0: none.
  state menuAt = 0

  derived ignoredNames: Map<String, Boolean> = self.ignored.values.names
  derived menuService: Game.TrainerService | nil = self.services.find(service => service.index == self.menuAt)
  derived menuActs: Array<MenuAct> = self.actsOf(self.menuService)
  derived menuEntries: Array<MenuEntry> = self.entriesOf(self.menuActs, self.menuService)
  derived tabs: Array<WindowTabSpec> = [self.tabSpec]
  derived query: String = self.search.lower()
  // The trainer's skill, read again as its services change: a profession trainer's.
  derived skill: Game.TrainerSkill | nil = self.skillOf()
  derived skilled: Boolean = self.skill != nil
  derived rank: Integer = self.skill?.rank ?? 0
  derived most: Integer = self.skill?.most ?? 0
  derived shown: Array<Game.TrainerService> = self.shownOf()
  derived tabled: Boolean = self.list.values.view == TrainerView.Table
  derived empty: Boolean = self.shown.length == 0
  // The trainer's categories with a service shown, in the trainer's order; none where the trainer has none.
  derived categories: Array<String> = self.categoriesOf()
  derived grouped: Boolean = self.categories.length > 0
  derived current: Game.TrainerService | nil = self.services.find(service => service.index == self.picked)
  derived has: Boolean = self.current != nil
  derived learned: Boolean = self.current?.status == Game.ServiceStatus.Learned
  derived name: String = self.current == nil ? "" : titleOf(self.current ?? panic("current"))
  derived text: String = self.current?.description ?? ""
  derived currentIgnored: Boolean = self.current != nil && isIgnored(self.current ?? panic("current"), self.ignoredNames)
  // The card says an ignored service is ignored, where its row's plate does.
  derived needs: String = self.current == nil ? "" : self.currentIgnored ? Locale.TRAINER_IGNORED : needsOf(self.current ?? panic("current"))
  derived price: Integer = self.current?.cost ?? 0
  derived dear: Boolean = self.price > Game.money.amount
  derived priceInk: Color = self.dear ? RED : INK
  // A new profession needs a free slot, as the game's window greys «Learn» without one.
  derived noSlot: Boolean = self.current?.profession == true && self.current?.status == Game.ServiceStatus.Available && !slotFree()
  derived canTrain: Boolean = self.current != nil && learnable(self.current ?? panic("current"), self.ignoredNames)
  derived confirmText: String = Locale.TRAINER_CONFIRM_PROFESSION.format(self.current?.name ?? "")
  // The footer's counts: what can be learned now (one ignored left out), what can't yet, what is known; and
  // what is ignored, where anything is.
  derived counts: Array<StatusCount> = self.countsOf()
  derived side: WindowSide | nil = { width: CARD_WIDTH, content: self.card }
  // Nothing picked: the trainer's card, its greeting, and what all that can be learned now costs together (the footer
  // counts them).
  derived greeting: String = self.greetingOf()
  derived together: Integer = availableCost(self.services, self.ignoredNames)
  // The picked service's facts, the game's (cast time, cooldown, cost, range: its spell's tooltip lines between its name
  // and what it does), and what changes against the rank the player has.
  derived facts: Array<String> = factsOf(self.current)
  derived changes: Array<Change> = changesOf(self.current)
  derived changed: Boolean = self.changes.length > 0
  // Why «Learn» can't be pressed, on its Tip.
  derived reason: TipText | nil = self.reasonOf()

  services: Signal<Array<Game.TrainerService>>
  declared: mut KeptWindow
  list: mut ModuleMemory<TrainerList>
  // What the player ignored: the character's.
  ignored: mut ModuleMemory<TrainerIgnored>
  const rows: Rows
  // The window's tab: the trainer, as every window is titled by its tab.
  tabSpec: Signal<WindowTabSpec>
  // The card's words while no service is picked.
  pickText: Signal<String>
  // A profession trainer's (its columns the level and the skill), or a class trainer's (the rank and the level).
  const trade: Boolean
  const columns: Array<Column>
  const keys: Array<Key>
  constructor(
    services: Signal<Array<Game.TrainerService>>,
    declared: mut KeptWindow,
    list: mut ModuleMemory<TrainerList>,
    ignored: mut ModuleMemory<TrainerIgnored>,
    tabSpec: Signal<WindowTabSpec>,
    // What the first column names a service: «Skill», «Recipe».
    noun: String,
    pickText: Signal<String>,
    trade: Boolean
  ) {
    self.services = services
    self.declared = declared
    self.list = list
    self.ignored = ignored
    self.tabSpec = tabSpec
    self.pickText = pickText
    self.trade = trade
    self.columns = columnsOf(noun, trade)
    self.keys = trade ? TRADE_KEYS : CLASS_KEYS
    self.rows = new Rows(self.picked, self.menuAt, self.menuEntries, self.ignoredNames)
    self.rows.pick.listen(self.onPick)
    self.rows.double.listen(self.onDouble)
    self.rows.menu.listen(self.onMenu)
    self.rows.chose.listen(self.onChose)
    self.rows.closed.listen(self.onMenuClosed)
  }

  // How many services the footer counts as this: what the filter would show of them.
  count(self, show: TrainerShow): Integer { return self.services.count(service => showOf(service, self.ignoredNames) == show) }

  countsOf(self): Array<StatusCount> {
    const counts: Array<StatusCount> = [
      { color: GREEN, value: self.count(.Available), title: Locale.TRAINER_AVAILABLE, text: Locale.TRAINER_AVAILABLE_TIP },
      { color: RED, value: self.count(.Unavailable), title: Locale.TRAINER_UNAVAILABLE, text: Locale.TRAINER_UNAVAILABLE_TIP },
      { color: BLUE, value: self.count(.Known), title: Locale.TRAINER_KNOWN, text: Locale.TRAINER_KNOWN_TIP }
    ]
    const ignored = self.count(.Ignored)
    if (ignored > 0) { counts.push({ color: GREY, value: ignored, title: Locale.TRAINER_IGNORED, text: Locale.TRAINER_IGNORED_TIP }) }
    return counts
  }

  // What a service's menu offers, each only where it can be done: learn it (where it can be learned now), ignore it or
  // stop ignoring it (where it isn't known), its link in the chat (where it has one).
  actsOf(self, service: Game.TrainerService | nil): Array<MenuAct> {
    const acts: Array<MenuAct> = []
    if (service == nil) { return acts }
    if (learnable(service, self.ignoredNames)) { acts.push(.Learn) }
    if (service.status != Game.ServiceStatus.Learned) { acts.push(.Ignore) }
    if (linkOf(service) != nil) { acts.push(.Link) }
    return acts
  }

  // The menu's lines, a rule above each after the first.
  entriesOf(self, acts: Array<MenuAct>, service: Game.TrainerService | nil): Array<MenuEntry> {
    const entries: Array<MenuEntry> = []
    if (service == nil) { return entries }
    for (at, act of acts) { entries.push({ label: self.labelOf(act, service), group: at > 1 }) }
    return entries
  }

  labelOf(self, act: MenuAct, service: Game.TrainerService): String {
    return match (act) {
      .Learn => Locale.TRAINER_TRAIN
      .Ignore => isIgnored(service, self.ignoredNames) ? Locale.TRAINER_UNIGNORE : Locale.TRAINER_IGNORE
      .Link => Locale.TRAINER_LINK
    }
  }

  greetingOf(self): String {
    _ = self.services.length
    return Game.trainer.greeting()
  }

  // The reason on «Learn»'s Tip while it can't be pressed; none while it can.
  reasonOf(self): TipText | nil {
    if (self.canTrain) { return nil }
    return { title: Locale.TRAINER_TRAIN, text: self.reasonText(), rows: [] }
  }

  reasonText(self): String {
    const current = self.current
    if (current == nil) { return Locale.TRAINER_PICK_FIRST }
    if (current.status == Game.ServiceStatus.Learned) { return Locale.TRAINER_KNOWN }
    if (self.currentIgnored) { return Locale.TRAINER_IGNORED_TIP }
    if (current.level > Game.player.level) { return Locale.TRAINER_NEEDS_LEVEL_SHORT.format(current.level) }
    if (self.dear) { return Locale.TRAINER_TOO_DEAR }
    if (self.noSlot) { return Locale.TRAINER_NO_SLOT }
    return Locale.TRAINER_UNAVAILABLE
  }

  shownOf(self): Array<Game.TrainerService> {
    const view = self.list.values
    const key = self.keys[view.sorted]
    const ignored = self.ignoredNames
    let services = self.services.filter(service => passes(service, view.shows, self.query, ignored))
    services.sort((a, b) => before(a, b, key, view.descending))
    return services
  }

  categoriesOf(self): Array<String> {
    let categories: Array<String> = []
    for (service of self.shown) {
      const category = service.category
      if (category != "" && !categories.any(each => each == category)) { categories.push(category) }
    }
    return categories
  }

  skillOf(self): Game.TrainerSkill | nil {
    _ = self.services.length
    return Game.trainer.skill()
  }

  // The services of a category as the list shows them: none while it is folded.
  inCategory(self, category: String): Array<Game.TrainerService> {
    if (self.folded[category] == true) { return [] }
    return self.shown.filter(service => service.category == category)
  }

  countIn(self, category: String): Integer { return self.shown.count(service => service.category == category) }

  onToggle(mut self, category: String) {
    let folded: Map<String, Boolean> = {}
    for (each, shut of peek self.folded) { folded[each] = shut }
    folded[category] = folded[category] == true ? nil : true
    self.folded = folded
  }

  // A click on the picked service lets it go: the card is the trainer's again.
  onPick(mut self, index: Integer) { self.picked = (peek self.picked) == index ? 0 : index }

  // A service learned, in the player's click: the client buys it where it can be learned now; a new profession is
  // picked and asked first.
  learn(mut self, service: Game.TrainerService) {
    if (!learnable(service, peek self.ignoredNames)) { return }
    if (service.profession) {
      self.picked = service.index
      self.confirming = true
      return
    }
    Client.BuyTrainerService(service.index)
  }

  // «Learn»: the picked service.
  onTrain(mut self) {
    const current = peek self.current
    if (current != nil) { self.learn(current) }
  }

  // A double press on a service: it stays picked, and is learned.
  onDouble(mut self, index: Integer) {
    self.picked = index
    const service = (peek self.services).find(each => each.index == index)
    if (service != nil) { self.learn(service) }
  }

  onMenu(mut self, index: Integer) { self.menuAt = index }
  onMenuClosed(mut self) { self.menuAt = 0 }

  // An entry of a service's menu chosen: the menu closes, and the entry acts on its service.
  onChose(mut self, place: Integer) {
    const service = peek self.menuService
    const act = (peek self.menuActs)[place]
    self.menuAt = 0
    if (service == nil || act == nil) { return }
    match (act) {
      .Learn => self.learn(service)
      .Ignore => self.flipIgnored(service.name)
      .Link => {
        const spell = service.spell
        const item = linkOf(service)?.match("item:(%d+)")?.toNumber()?.floor()
        if (spell != nil) {
          Game.chat.linkSpell(spell)
        } else if (item != nil) {
          Game.chat.link(item)
        }
      }
    }
  }

  // A service ignored, or no longer: every rank of it, kept for the character.
  flipIgnored(mut self, name: String) {
    let names: Map<String, Boolean> = {}
    for (each, on of peek self.ignoredNames) { names[each] = on }
    names[name] = names[name] == true ? nil : true
    self.ignored.write({ names: names })
  }

  onConfirmed(mut self) {
    self.confirming = false
    const current = peek self.current
    if (current != nil && learnable(current, peek self.ignoredNames)) { Client.BuyTrainerService(current.index) }
  }

  onConfirmCancel(mut self) { self.confirming = false }

  // The window's close leaves the trainer, as the game's does.
  onClose(self) { Client.CloseTrainer() }
  onSettings(self) { self.settings.emit() }

  // The picked service's card: its name and what it is, what it asks for, its price and «Learn».
  const card: Template = $ltml {
    <box rows={CARD} gap={3sp}>
      <box $if={self.has} columns={1} gap={2sp}>
        // A name on two lines or more keeps its font's own line.
        <text value={self.name} textSize={TITLE_TEXT} lineHeight={TIGHT_LINE} textColor={GOLD} />
        <text $if={!self.learned} value={self.needs} textColor={DIM} textSize={SECONDARY_TEXT} />
        <text $if={self.noSlot} value={Locale.TRAINER_NO_SLOT} textColor={RED} textSize={SECONDARY_TEXT} />
        <text value={self.text} textColor={INK} />
        <text $if={self.changed} value={Locale.TRAINER_CHANGES} textColor={GOLD} />
        // The numbers in the numbers font, the arrow in the text's: a numbers font carries digits, not every sign.
        <box $for={change of self.changes} columns={{ each: "max-content" }} gap={1sp}>
          <text value={change.yours} textColor={GREEN} textFont={TextFont.Numbers} />
          <text value={"→"} textColor={GREEN} />
          <text value={change.next} textColor={GREEN} textFont={TextFont.Numbers} />
        </box>
        <text $for={fact of self.facts} value={fact} textColor={DIM} textSize={SECONDARY_TEXT} />
      </box>
      <box $else columns={1} gap={2sp}>
        <text $if={self.greeting != ""} value={self.greeting} textColor={INK} />
        <text value={self.pickText} textColor={DIM} />
        <box columns={PAIR} gap={3sp} yAlign={Align.Center}>
          <text value={Locale.TRAINER_TOGETHER} textColor={DIM} textSize={SECONDARY_TEXT} />
          <Money amount={self.together} />
        </box>
      </box>
      <box />
      // A known service: the word in place of its price and «Learn».
      <box $if={self.learned} xAlign={Align.End}>
        <text value={Locale.TRAINER_KNOWN} textColor={BLUE} />
      </box>
      <box $else columns={PAIR} gap={3sp} yAlign={Align.Center}>
        <box>
          <Money $if={self.has} amount={self.price} color={self.priceInk} />
        </box>
        <PushButton label={Locale.TRAINER_TRAIN} width={TRAIN_WIDTH} plate={ButtonPlate.Accent} disabled={!self.canTrain} tip={self.reason}
                    @click={self.onTrain} />
      </box>
    </box>
  }

  // The counts at the footer's left, the player's money at its right.
  const footer: Template = $ltml {
    <box padding={FOOTER_ROOM} columns={SPREAD} gap={6sp} yAlign={Align.Center}>
      <box columns={FOOT} gap={6sp} yAlign={Align.Center}>
        <StatusDot $for={count of self.counts} count={count} />
      </box>
      <box />
      <box columns={FOOT} gap={3sp} yAlign={Align.Center}>
        <text value={Locale.TRAINER_YOUR_MONEY} textColor={DIM} textSize={SECONDARY_TEXT} wrap={.None} />
        <Money amount={Game.money.amount} />
      </box>
    </box>
  }

  public render(self): Template {
    return $ltml {
      <Window tabs={self.tabs} selected={mut self.tab} declared={mut self.declared} side={self.side} footer={self.footer}
              withSettings={true} @close={self.onClose} @settings={self.onSettings}>
        <box rows={BODY} gap={6sp}>
          <SkillBar $if={self.skilled} rank={self.rank} most={self.most} />
          <box $else />
          <Toolbar search={mut self.search} placeholder={Locale.TRAINER_SEARCH}>
            <ToolSort sorted={mut self.list.values.sorted} columns={self.columns} title={Locale.TRAINER_SORT} more={MORE_SORTS} />
            <FilterButton values={mut self.list.values.shows} start={FILTER_START} groups={FILTERS} />
            <ToolPick value={mut self.list.values.view} choices={TRAINER_VIEWS} icon={ARTWORK.ctl.tool.table} title={Locale.TRAINER_VIEW} />
          </Toolbar>
          <box $if={self.empty} xAlign={Align.Center} yAlign={Align.Center}>
            <text value={Locale.TRAINER_NOTHING} textColor={DIM} />
          </box>
          <box $elseif={self.tabled} rows={FILL}>
            <Table columns={self.columns} sorted={mut self.list.values.sorted} descending={mut self.list.values.descending}>
              <ServiceTableRow $for={service of self.shown} $key={service.index} service={service} trade={self.trade}
                               rows={self.rows} />
            </Table>
          </box>
          <box $elseif={self.grouped} columns={1} overflow={Overflow.Scroll}>
            <$for={category of self.categories}>
              <CategoryCaption category={peek category} count={self.countIn(category)} folded={self.folded[category] == true}
                               @toggled={self.onToggle} />
              <ServiceLine $for={service of self.inCategory(category)} $key={service.index} service={service}
                           rows={self.rows} />
            </>
          </box>
          <box $else columns={1} overflow={Overflow.Scroll}>
            <ServiceLine $for={service of self.shown} $key={service.index} service={service} rows={self.rows} />
          </box>
        </box>
      </Window>
      <Dialog $if={self.confirming} width={DIALOG} title={self.tabSpec.title}>
        <text value={self.confirmText} textColor={INK} />
        <PushButton #buttons label={Locale.CANCEL} width={TRAIN_WIDTH} @click={self.onConfirmCancel} />
        <PushButton #buttons label={Locale.TRAINER_TRAIN} width={TRAIN_WIDTH} plate={ButtonPlate.Accent} @click={self.onConfirmed} />
      </Dialog>
    }
  }
}
