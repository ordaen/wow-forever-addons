// The question Ordaen asks where a module of it and another author's addon draw the same thing (the module's
// `conflicts` in its `addon.json`, `Runtime.Addon.conflicts()`): keep Ordaen's, or the other's. Two of each is never
// shown. «Ordaen» turns the other addon off for this character, then offers the reload (the client's own, from the
// player's click); «the other» turns off the modules that name it, as their switches in the settings window would.
// The answer is kept by Ordaen's root; the question is asked again only once the other addon was off and comes back.
import Client from "$client"
import { Action } from "$ltml"
import Runtime from "$runtime"
import { Dialog } from "@/dialog"
import Locale from "@/locales"
import { Component } from "@/module"
import { ButtonPlate, PushButton } from "@/pushButton"

// The reload: the client does it from the player's click (Forever refuses `ReloadUI` from addon code).
const RELOAD: Action = Action.RunMacro { macro: "/reload" }
const WIDTH = 539.0625dp
const BUTTON = 187.5dp

// Where the question stands: asked, answered «Ordaen» and the reload offered, or done.
public enum ConflictStep { Ask, Reload, Done }

// One other addon and the modules of Ordaen that draw what it draws, each on now.
public struct Conflict {
  other: Runtime::Addon
  modules: Array<Runtime::Addon>
}

// The modules' titles in one text, as a sentence names them.
function titlesOf(modules: Array<Runtime::Addon>): String {
  return modules.map(module => module.title).join(", ")
}

public class ConflictQuestion implements Component {
  public state step: ConflictStep = .Ask
  derived asking: Boolean = self.step == .Ask
  derived reloading: Boolean = self.step == .Reload
  const conflict: Conflict
  // Told the player's answer: true where Ordaen is kept.
  const answered: (kept: Boolean) => nil
  const asked: String
  const ordaenHint: String
  const otherHint: String
  const reloadText: String

  constructor(conflict: Conflict, answered: (kept: Boolean) => nil) {
    self.conflict = conflict
    self.answered = answered
    const other = conflict.other.title
    const modules = titlesOf(conflict.modules)
    self.asked = Locale::CONFLICT_ASK.format(other, modules)
    self.ordaenHint = Locale::CONFLICT_ORDAEN.format(other)
    self.otherHint = Locale::CONFLICT_OTHER.format(other, modules)
    self.reloadText = Locale::CONFLICT_RELOAD.format(other)
  }

  // «Ordaen»: the other addon is off for this character (named by its GUID, as the client names one) from the next
  // reload, which is offered now.
  keepOrdaen(mut self) {
    Client::C_AddOns::DisableAddOn(self.conflict.other.name, Client::UnitGUID("player"))
    Client::C_AddOns::SaveAddOns()
    self.answered(true)
    self.step = .Reload
  }

  // The other addon: the modules that name it are turned off.
  keepOther(mut self) {
    self.answered(false)
    self.step = .Done
  }

  later(mut self) { self.step = .Done }

  public render(self): Template {
    return $ltml {
      <Dialog $if={self.asking} width={WIDTH} title={Locale::CONFLICT_TITLE}>
        <box columns={1} gap={2sp}>
          <text value={self.asked} wrap={.Words} />
          <text value={self.ordaenHint} wrap={.Words} />
          <text value={self.otherHint} wrap={.Words} />
        </box>
        <PushButton #buttons label={"Ordaen"} width={BUTTON} plate={ButtonPlate::Accent} @click={self.keepOrdaen} />
        <PushButton #buttons label={self.conflict.other.title} width={BUTTON} @click={self.keepOther} />
      </Dialog>
      <Dialog $if={self.reloading} width={WIDTH} title={Locale::CONFLICT_TITLE}>
        <text value={self.reloadText} wrap={.Words} />
        <PushButton #buttons label={Locale::CONFLICT_RELOAD_NOW} width={BUTTON} plate={ButtonPlate::Accent} action={RELOAD} />
        <PushButton #buttons label={Locale::CONFLICT_LATER} width={BUTTON} @click={self.later} />
      </Dialog>
    }
  }
}
