// CopyBox: a text handed to the player to copy, over everything: a dialog with its title, the text selectable
// (`CopyText`: a click, then Ctrl+C, as the game can't write to the clipboard) and «Close». The owner shows it while
// it has a text to hand, and hears `close`.
import { CopyText } from "@/copyText"
import { Dialog } from "@/dialog"
import Locale from "@/locales"
import { Component } from "@/module"
import { PushButton } from "@/pushButton"

const WIDTH = 360dp
const BUTTON = 90dp

public class CopyBox implements Component {
  public close: Event<nil> = new Event()

  title: Signal<String>
  value: Signal<String>
  constructor(title: Signal<String>, value: Signal<String>) {
    self.title = title
    self.value = value
  }

  onClose(mut self) { self.close.emit() }

  public render(self): Template {
    return $ltml {
      <Dialog width={WIDTH} title={self.title}>
        <CopyText value={self.value} />
        <PushButton #buttons label={Locale.CLOSE} width={BUTTON} @click={self.onClose} />
      </Dialog>
    }
  }
}
