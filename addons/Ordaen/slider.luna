// Slider: a number setting's row (SettingRow) between its least and its most. A dark groove, the bronze fill up to the value, a bronze
// knob; the value beside it in its unit (70%, 48 px, 3). A click or a drag anywhere along it sets the value, in its
// steps. Disabled, it takes no input.
import { Align, Click, Drag, Position, Shadow } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { PX } from "@/units"
import { SettingRow } from "@/settingRow"

public enum Unit { None = "none", Percent = "percent", Px = "px", Sec = "sec" }

const LENGTH = 240 * PX
// The knob's height: the band that takes the mouse, the groove centred in it.
const BAND = 20 * PX
const GROOVE = 8 * PX
const EDGE = 1 * PX
const GROOVE_TOP = (BAND - GROOVE) / 2
const KNOB_W = 16 * PX
const KNOB_H = 32 * PX
const KNOB_SHADOW: Shadow = { color: Color.hex("#0000008c"), x: 0, y: 2 * PX, size: 3 * PX }
const WHITE: Color = Color.hex("#ffffff")

public class Slider implements Component {
  // Where the value sits along the range, from 0 to 1.
  derived fraction: Number = self.most > self.least ? (self.value - self.least) / (self.most - self.least) : 0
  derived fillWidth: Number = self.fraction * (LENGTH - 2 * EDGE)
  derived knobLeft: Number = self.fraction * LENGTH - KNOB_W / 2
  derived shown: String = self.format()

  label: Signal<String>
  value: mut Signal<Number>
  const least: Number
  const most: Number
  const step: Number
  const unit: Unit
  hint: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    label: Signal<String>,
    value: mut Signal<Number>,
    least: Number,
    most: Number,
    step: Number = 1,
    unit: Unit = Unit.None,
    hint: Signal<String> = "",
    disabled: Signal<Boolean> = false,
  ) {
    self.label = label
    self.value = value
    self.least = least
    self.most = most
    self.step = step
    self.unit = unit
    self.hint = hint
    self.disabled = disabled
  }

  // The value as the slider shows it, in its unit.
  format(self): String {
    match (self.unit) {
      Unit.Percent => return "%d%%".format((self.value * 100).round()),
      Unit.Px => return "%d px".format(self.value.floor()),
      Unit.Sec => return "%s s".format(String.of(self.value)),
      Unit.None => return String.of(self.value),
    }
  }

  // The value at `x` UI units along the groove, held to the range and its steps.
  setAt(mut self, x: Number) {
    if (self.disabled) { return }
    let t = (0).max((1).min(x / LENGTH))
    let steps = (t * (self.most - self.least) / self.step).round()
    self.value = self.most.min(self.least + steps * self.step)
  }

  onClick(mut self, click: Click) { self.setAt(click.x) }
  onDrag(mut self, drag: Drag) { self.setAt(drag.x) }

  public render(self): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <box columns={[LENGTH, "auto"]} gap={12 * PX} yAlign={Align.Center}>
          <box width={LENGTH} height={BAND} @click={self.onClick} @dragStart={self.onDrag} @drag={self.onDrag}>
            <box position={Position.Absolute} left={0} top={GROOVE_TOP} width={LENGTH} height={GROOVE}
                 background={Ordaen.art.ctl.groove} />
            <box position={Position.Absolute} left={EDGE} top={GROOVE_TOP + EDGE} height={GROOVE - 2 * EDGE}
                 width={self.fillWidth} background={Ordaen.art.ctl.sliderFill} />
            <box position={Position.Absolute} left={self.knobLeft} top={-2 * PX} width={KNOB_W} height={KNOB_H}
                 background={Ordaen.art.ctl.sliderKnob} shadow={KNOB_SHADOW} />
          </box>
          <text value={self.shown} textColor={WHITE} />
        </box>
      </SettingRow>
    }
  }
}
