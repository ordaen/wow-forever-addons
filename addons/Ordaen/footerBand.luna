// FooterBand: a window's footer drawn as a band of its own across the main section, to its edges (Window places a
// footer flush with them): the game's dark marble under it, a thin rule along its top. What it holds keeps the footer's room at the sides, and a little over and under it: the band is a
// line of the window, not a section. Its top is the thin rule a window's inside is ruled with; only an upright
// divider inside a window (between a list and a card) is the frame's textured line.
import { Edges, Line, Side } from "$ltml"
import { ARTWORK } from "@/art"
import { Component } from "@/module"
import { RULE_COLOR, RULE_WIDTH } from "@/units"
import { FOOTER_ROOM } from "@/window"

const LINE: Line = { width: RULE_WIDTH, color: RULE_COLOR, sides: [Side::Top] }
const ROOM: Edges = { ...FOOTER_ROOM, top: 2sp, bottom: 2sp }

public class FooterBand implements Component {
  public render(): Template {
    return $ltml {
      <box border={LINE} background={ARTWORK.window.marble} padding={ROOM}>
        <slot />
      </box>
    }
  }
}
