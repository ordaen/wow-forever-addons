// What the player chooses, kept: a module's settings and the draft its settings page writes.
import Game from "$game"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { Keeper, Sectioned } from "@/keeper"
import { ProfileName } from "@/profiles"

// What a `Settings` or a `Memory` is kept under: the addon of the root that owns it (`OrdaenPanel`), and the part
// of it where it has more than one (`Ordaen:look`); nothing for one no root owns (a test's own), which isn't kept.
function keyOf(addon: Runtime.Addon | nil, part: String): String | nil {
  if (addon == nil) { return nil }
  return part == "" ? addon.name : addon.name + ":" + part
}

// A module's settings: a struct `S` of what the player chooses, with the defaults it starts from.
//
// The module reads `values` (`settings.values.scale`, followed). The settings page writes `draft`, an entry at a
// time (`value={mut settings.draft.scale}`), and nothing the module reads changes until the draft is saved: every
// page's changes wait for «Save» together. The values are kept in the active profile (`Profiles`), as a section
// under the module's name (`keyOf`), and follow a switch to another profile.
public class Settings<S: Plain> implements Sectioned {
  public const defaults: S
  public state values: S
  public state draft: mut S
  // How many entries of the draft differ from the values.
  public derived changed: Integer = self.draft.changes(self.values)
  // What the values were before the last save that changed them.
  before: S | nil = nil
  // What they were before the save that is running, where it changed them.
  replaced: S | nil = nil
  key: String | nil = nil
  const keeper: mut Keeper
  const id: Integer

  // `part` tells a module's second `Settings` from its first; `keeper` is Ordaen's root's own, handed in by the root
  // as it makes its own settings, and Ordaen's `keeper` otherwise.
  constructor(defaults: S, part: String = "", keeper: mut Keeper | nil = nil) {
    self.defaults = defaults
    self.values = defaults.clone()
    self.draft = defaults.clone()
    self.keeper = keeper ?? Ordaen.keeper
    self.id = self.keeper.join()
    const key = keyOf(Runtime.Addon.of(self), part)
    self.key = key
    if (key != nil) {
      // The active profile's section: read now, and again when the character switches to another profile.
      watch (name of self.keeper.profiles.active) { self.take(name, key) }
    }
    self.keeper.saving.listen(self.save)
    self.keeper.saved.listen(self.settle)
    self.keeper.discarding.listen(self.discard)
    self.keeper.rollingBack.listen(self.rollback)
    watch { self.tell() }
    if (key != nil) { self.keeper.enrol(key, self.id, mut self) }
  }

  destructor() {
    const key = self.key
    if (key != nil) { self.keeper.withdraw(key, self.id) }
    self.keeper.leave(self.id)
  }

  // How many settings a section would change in the values.
  public differs(self, raw: Unknown): Integer {
    return S.decode(raw, self.defaults).changes(self.values)
  }

  // A section becomes the draft: it waits for «Save», as a preset's entries do.
  public draftFrom(mut self, raw: Unknown) {
    self.draft = S.decode(raw, self.defaults)
  }

  tell(mut self) {
    self.keeper.count(self.id, self.changed)
  }

  // A profile's section becomes the values, and the draft with them: what follows the values draws again.
  take(mut self, profile: ProfileName, key: String) {
    const values = S.decode(self.keeper.profiles.section(profile, key), self.defaults)
    self.draft = values.clone()
    self.values = values
  }

  keep(mut self) {
    const key = self.key
    if (key != nil) { self.keeper.profiles.write(key, peek self.values) }
  }

  save(mut self) {
    self.replaced = nil
    if (peek self.changed == 0) { return }
    self.replaced = (peek self.values).clone()
    self.values = (peek self.draft).clone()
    self.keep()
    self.keeper.changed()
  }

  // A save changed something somewhere: what a roll back returns to is what this save replaced here, or nothing.
  settle(mut self) {
    self.before = self.replaced
    self.replaced = nil
  }

  discard(mut self) {
    self.draft = (peek self.values).clone()
  }

  rollback(mut self) {
    const was = self.before
    if (was == nil) { return }
    self.values = was.clone()
    self.draft = was.clone()
    self.before = nil
    self.keep()
  }

  // Every entry of the draft at once (a preset): it waits for «Save» as any other change does.
  public choose(mut self, values: S) {
    self.draft = values.clone()
  }

  // Every value back to its default, the draft with them.
  public reset(mut self) {
    self.values = self.defaults.clone()
    self.draft = self.defaults.clone()
    self.keep()
  }
}

// What a module remembers between sessions that the player doesn't choose on a settings page: the profession last
// open, a list's sort. The module reads and writes `values`, and what it writes is kept at once, the account's or
// this character's, under the module's name and `:memory`.
public class Memory<S: Plain> {
  public state values: S
  const scope: Game.Scope
  key: String | nil = nil

  constructor(defaults: S, scope: Game.Scope) {
    self.scope = scope
    self.values = defaults.clone()
    const key = keyOf(Runtime.Addon.of(self), "memory")
    self.key = key
    if (key != nil) { self.values = load(scope, key, defaults) }
    watch { self.keep() }
  }

  // What the module remembers now, every entry at once: kept at once. The module's own way to write it, as
  // another addon's field is never assigned.
  public write(mut self, values: S) {
    self.values = values.clone()
  }

  // Every entry is read, so a change to any of them keeps the whole.
  keep(self) {
    const values = self.values
    const key = self.key
    if (key != nil) { Game.saved.store(self.scope, key, values) }
  }
}
