// The player's choices, named: a profile holds every module's settings, and each character uses one, found by its
// picks. Profiles are the account's, kept by Ordaen (`profiles` in the game's saved data). A section is one
// `Settings`' values as the client packs them (CBOR, `Game.encoding`): Ordaen knows no module's type, and a module
// decodes its own (`S.decode`). Which modules are on, what a module remembers (`Memory`) and data aren't in one.
import Game from "$game"

public type ProfileName = brand String

// The profile every account has, made from what was kept before profiles were.
public const DEFAULT_PROFILE: ProfileName = "Default"

public struct Profile implements Plain {
  // Each `Settings`' values, packed, by what the `Settings` is kept under (`OrdaenPanel`, `Ordaen:look`).
  sections: mut Map<String, String> = {}
}

public struct Picks implements Plain {
  account: ProfileName = DEFAULT_PROFILE
  // By the class's tag (`MAGE`).
  byClass: mut Map<String, ProfileName> = {}
  // By the character's GUID.
  byCharacter: mut Map<String, ProfileName> = {}
  // By the character's GUID, then the specialisation's index.
  bySpec: mut Map<String, mut Map<Integer, ProfileName>> = {}

  // The profile under another name, in every pick that names it.
  public renamed(mut self, from: String, to: String) {
    if (self.account == from) { self.account = to }
    for (tag, name of self.byClass) {
      if (name == from) { self.byClass[tag] = to }
    }
    for (guid, name of self.byCharacter) {
      if (name == from) { self.byCharacter[guid] = to }
    }
    for (_, specs of self.bySpec) {
      for (index, name of specs) {
        if (name == from) { specs[index] = to }
      }
    }
  }

  // Every pick of the profile is dropped: the next rule answers where it was. The account's stays: it always names one.
  public without(mut self, gone: String) {
    for (tag, name of self.byClass) {
      if (name == gone) { self.byClass[tag] = nil }
    }
    for (guid, name of self.byCharacter) {
      if (name == gone) { self.byCharacter[guid] = nil }
    }
    for (_, specs of self.bySpec) {
      for (index, name of specs) {
        if (name == gone) { specs[index] = nil }
      }
    }
  }

  // The account's default: every character with no pick of its own uses it.
  public setAccount(mut self, name: String) {
    self.account = name
  }

  // The pick for a character, a class or a specialisation of a character, or none (`nil`).
  public forCharacter(mut self, guid: String, name: String | nil) {
    if (name == nil) {
      self.byCharacter[guid] = nil
    } else {
      self.byCharacter[guid] = name
    }
  }

  public forClass(mut self, tag: String, name: String | nil) {
    if (name == nil) {
      self.byClass[tag] = nil
    } else {
      self.byClass[tag] = name
    }
  }

  public forSpec(mut self, guid: String, index: Integer, name: String | nil) {
    if (self.bySpec[guid] == nil) { self.bySpec[guid] = {} }
    const specs = self.bySpec[guid]
    if (specs == nil) { return }
    if (name == nil) {
      specs[index] = nil
    } else {
      specs[index] = name
    }
  }
}

public struct Kept implements Plain {
  profiles: mut Map<String, mut Profile> = {}
  picks: mut Picks = Picks {}

  // The profile under another name, in its picks too.
  public renamed(mut self, from: String, to: String) {
    const profile = self.profiles[from]
    if (profile == nil) { return }
    self.profiles[from] = nil
    self.profiles[to] = profile
    self.picks.renamed(from, to)
  }

  // The profile with no section: every module reads its defaults.
  public cleared(mut self, name: String) {
    self.profiles[name] = Profile {}
  }

  // The profile gone, and every pick of it.
  public without(mut self, gone: String) {
    self.profiles[gone] = nil
    self.picks.without(gone)
  }
}

// Who the character is, as far as the picks ask: its GUID and specialisation where the game says them.
public struct Who {
  character: String | nil
  spec: Integer | nil
  classTag: String
}

// Which rule named the profile a character uses, in the order they win.
public enum Why { Spec = "spec", Character = "character", Class = "class", Account = "account" }

public struct Pick {
  name: ProfileName
  why: Why
}

// The profile a character uses and the rule that names it: the one picked for its specialisation, for it, for its
// class, or the account's.
public function pickOf(picks: Picks, who: Who): Pick {
  const character = who.character
  if (character != nil) {
    const spec = who.spec
    const bySpec = picks.bySpec[character]
    if (spec != nil && bySpec != nil) {
      const forSpec = bySpec[spec]
      if (forSpec != nil) { return { name: forSpec, why: Why.Spec } }
    }
    const own = picks.byCharacter[character]
    if (own != nil) { return { name: own, why: Why.Character } }
  }
  const forClass = picks.byClass[who.classTag]
  if (forClass != nil) { return { name: forClass, why: Why.Class } }
  return { name: picks.account, why: Why.Account }
}

public function picked(picks: Picks, who: Who): ProfileName {
  return pickOf(picks, who).name
}

// A profile's name as the player typed it: nil where it is empty or too long to be read in a list.
public const MAX_NAME = 40

public function named(text: String): ProfileName | nil {
  if (text == "" || text.length > MAX_NAME) { return nil }
  return text
}

public class Profiles {
  public state kept: Kept
  // The profile this character uses now: a `Settings` follows it, and takes its section anew when it changes.
  public derived active: ProfileName = picked(self.kept.picks, self.who())
  // The rule that names it, for the page to say why.
  public derived why: Why = pickOf(self.kept.picks, self.who()).why
  // Every profile, by name: the ones kept and the account's, which is there before anything is kept in it.
  public derived names: Array<String> = self.namesOf()

  constructor() {
    self.kept = load(.Account, "profiles", Kept {})
  }

  // Who the character is as the picks ask: its GUID, its specialisation's place where it has one, its class.
  public who(self): Who {
    return { character: Game.player.guid, spec: Game.player.spec?.index, classTag: Game.player.classTag }
  }

  namesOf(self): Array<String> {
    const kept = self.kept
    const list: Array<String> = []
    for (name, _ of kept.profiles) { list.push(name) }
    if (kept.profiles[kept.picks.account] == nil) { list.push(kept.picks.account) }
    list.sort((a, b) => a < b)
    return list
  }

  // The kept profiles and picks as a copy to change and hand to `apply`.
  public edit(self): mut Kept {
    return (peek self.kept).clone()
  }

  // Whether keeping `next` would make this character use another profile than it does.
  public switches(self, next: Kept): Boolean {
    return picked(next.picks, self.who()) != peek self.active
  }

  // What the player chose, kept: a `Settings` follows a change of the active profile.
  public apply(mut self, next: Kept) {
    self.kept = next
    Game.saved.store(.Account, "profiles", next)
  }

  // A `Settings`' section in a profile, unpacked for its `decode`; nil where the profile has none. A `Settings` kept
  // before profiles were (`Game.saved` under its key) is moved into «Default» as it is first read.
  public section(mut self, name: ProfileName, key: String): Unknown {
    const before = Game.saved.stored(.Account, key)
    if (before != nil) {
      const packed = Game.encoding.serialize(before)
      // A client that can't pack it: it is read as it was kept, and stays there.
      if (packed == nil) { return before }
      self.put(DEFAULT_PROFILE, key, packed)
      Game.saved.forget(.Account, key)
    }
    const profile = (peek self.kept).profiles[name]
    if (profile == nil) { return nil }
    const raw = profile.sections[key]
    if (raw == nil) { return nil }
    return Game.encoding.deserialize(raw)
  }

  // A `Settings`' values kept in the active profile.
  public write(mut self, key: String, values: Unknown) {
    const packed = Game.encoding.serialize(values)
    if (packed != nil) { self.put(peek self.active, key, packed) }
  }

  put(mut self, name: ProfileName, key: String, packed: String) {
    const next = self.edit()
    const profile = next.profiles[name] ?? Profile {}
    profile.sections[key] = packed
    next.profiles[name] = profile
    self.apply(next)
  }

  // A new profile, a copy of the profile `from` or, where that is nil, with no section (every module's defaults):
  // false where the name is empty or taken.
  public make(mut self, name: ProfileName, from: String | nil): Boolean {
    const kept = peek self.kept
    const taken = self.namesOf().any(known => known == name)
    if (name == "" || taken) { return false }
    const next = kept.clone()
    const source = from == nil ? nil : kept.profiles[from]
    next.profiles[name] = source == nil ? Profile {} : source.clone()
    self.apply(next)
    return true
  }

  // The account's default pick: every character that has no pick of its own switches to it at once.
  public use(mut self, name: ProfileName) {
    const next = self.edit()
    next.picks.account = name
    self.apply(next)
  }
}
