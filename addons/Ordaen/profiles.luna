// The player's choices, named: a profile holds every module's settings, and each character uses one, found by its
// picks. Profiles are the account's, kept by Ordaen (`profiles` in the game's saved data). A section is one
// `Settings`' values as the client packs them (CBOR, `Game.encoding`): Ordaen knows no module's type, and a module
// decodes its own (`S.decode`). A profile also holds where the player left the windows (a `ModuleMemory` of the
// profile's, packed the same way). Which modules are on, what a character remembers and data aren't in one.
import Debug from "$debug"
import Events from "$events"
import Game from "$game"

public type ProfileName = brand string

// The profile every account has, made from what was kept before profiles were.
public const DEFAULT_PROFILE: ProfileName = "Default"

public struct Profile implements Plain {
  // Each `Settings`' values, packed, by what the `Settings` is kept under (`OrdaenPanel`, `Ordaen:look`).
  sections: mut map<string, string> = {}
  // Each profile's `ModuleMemory`'s values, packed, by its key (`OrdaenTrading:window:main`): where the player left a
  // window or a list. Never in an export.
  memory: mut map<string, string> = {}
}

// How long a memory kept in a profile may be, packed: a struct of a few numbers, flags and enum members is a tenth
// of it. One that grew past it is a module's mistake, and isn't kept.
public const MEMORY_BOUND = 512

public struct ProfilePicks implements Plain {
  account: ProfileName = DEFAULT_PROFILE
  // By the class's tag (`MAGE`).
  byClass: mut map<string, ProfileName> = {}
  // By the character's GUID.
  byCharacter: mut map<string, ProfileName> = {}
  // By the character's GUID, then the specialisation's index.
  bySpec: mut map<string, mut map<integer, ProfileName>> = {}
}

implement ProfilePicks {
  // The profile under another name, in every pick that names it.
  public mut renamed(from: string, to: string) {
    if (self.account == from) { self.account = to }
    for (tag, name of self.byClass) {
      if (name == from) { self.byClass[tag] = to }
    }
    for (guid, name of self.byCharacter) {
      if (name == from) { self.byCharacter[guid] = to }
    }
    for (_, specs of self.bySpec) {
      for (index, name of specs) {
        if (name == from) { specs[index] = to }
      }
    }
  }

  // Every pick of the profile is dropped: the next rule answers where it was. The account's stays: it always names one.
  public mut without(gone: string) {
    for (tag, name of self.byClass) {
      if (name == gone) { self.byClass[tag] = nil }
    }
    for (guid, name of self.byCharacter) {
      if (name == gone) { self.byCharacter[guid] = nil }
    }
    for (_, specs of self.bySpec) {
      for (index, name of specs) {
        if (name == gone) { specs[index] = nil }
      }
    }
  }

  // The account's default: every character with no pick of its own uses it.
  public mut setAccount(name: string) {
    self.account = name
  }

  // The pick for a character, a class or a specialisation of a character, or none (`nil`).
  public mut forCharacter(guid: string, name: string | nil) {
    if (name == nil) {
      self.byCharacter[guid] = nil
    } else {
      self.byCharacter[guid] = name
    }
  }

  public mut forClass(tag: string, name: string | nil) {
    if (name == nil) {
      self.byClass[tag] = nil
    } else {
      self.byClass[tag] = name
    }
  }

  public mut forSpec(guid: string, index: integer, name: string | nil) {
    if (self.bySpec[guid] == nil) { self.bySpec[guid] = mut {} }
    const specs = self.bySpec[guid]
    if (specs == nil) { return }
    if (name == nil) {
      specs[index] = nil
    } else {
      specs[index] = name
    }
  }
}

public struct SavedProfiles implements Plain {
  profiles: mut map<string, mut Profile> = {}
  picks: mut ProfilePicks = ProfilePicks {}
}

implement SavedProfiles {
  // The profile under another name, in its picks too.
  public mut renamed(from: string, to: string) {
    // The account's default is there before anything is kept in it.
    if (self.profiles[from] == nil) { self.profiles[from] = mut Profile {} }
    const profile = self.profiles[from]
    if (profile == nil) { return }
    self.profiles[from] = nil
    self.profiles[to] = profile
    self.picks.renamed(from, to)
  }

  // The profile with no section: every module reads its defaults.
  public mut cleared(name: string) {
    self.profiles[name] = mut Profile {}
  }

  // The profile gone, and every pick of it.
  public mut without(gone: string) {
    self.profiles[gone] = nil
    self.picks.without(gone)
  }

  // A module's sections and memory under its former name moved to its current one, in every profile.
  public mut moved(former: string, current: string) {
    for (_, profile of self.profiles) {
      movedKeys(profile.sections, former, current)
      movedKeys(profile.memory, former, current)
    }
  }
}

// A module renamed: its former name to its current one. What was kept under the former moves once at login, where
// the current has nothing yet: the account's and the character's saved keys, and each profile's sections and memory.
public const RENAMED: map<string, string> = { ["OrdaenAuction"]: "OrdaenTrading", ["OrdaenBags"]: "OrdaenInventory" }

// The key `former` and every `former:…` moved to `current` and `current:…`, where nothing stands there yet.
function movedKeys(keys: mut map<string, string>, former: string, current: string) {
  let moving: array<string> = mut []
  for (key, _ of keys) {
    if (key == former || key.sub(1, former.length + 1) == `${former}:`) { moving.push(key) }
  }
  for (key of moving) {
    const next = `${current}${key.sub(former.length + 1)}`
    if (keys[next] == nil) { keys[next] = keys[key] }
    keys[key] = nil
  }
}

// The profile a character uses and the rule that names it: the one picked for its specialisation, for it, for its
// class, or the account's.
public function pickOf(picks: ProfilePicks, who: Profiles::Player): Profiles::Pick {
  const character = who.character
  if (character != nil) {
    const spec = who.spec
    const bySpec = picks.bySpec[character]
    if (spec != nil && bySpec != nil) {
      const forSpec = bySpec[spec]
      if (forSpec != nil) { return { name: forSpec, why: Profiles::Reason::Spec } }
    }
    const own = picks.byCharacter[character]
    if (own != nil) { return { name: own, why: Profiles::Reason::Character } }
  }
  const forClass = picks.byClass[who.classTag]
  if (forClass != nil) { return { name: forClass, why: Profiles::Reason::Class } }
  return { name: picks.account, why: Profiles::Reason::Account }
}

public function picked(picks: ProfilePicks, who: Profiles::Player): ProfileName {
  return pickOf(picks, who).name
}

// A profile's name as the player typed it: nil where it is empty or too long to be read in a list.
public const MAX_NAME = 40

public function named(text: string): ProfileName | nil {
  if (text == "" || text.length > MAX_NAME) { return nil }
  return text
}

public class Profiles {
  // Who the character is, as far as the picks ask: its GUID and specialisation where the game says them.
  public struct Player {
    character: string | nil
    spec: integer | nil
    classTag: string
  }

  // Which rule named the profile a character uses, in the order they win.
  public enum Reason { Spec = "spec", Character = "character", Class = "class", Account = "account" }

  // The profile a character uses, and the rule that names it.
  public struct Pick {
    name: ProfileName
    why: Reason
  }

  public state kept: SavedProfiles
  // The profile this character uses now: a `Settings` follows it, and takes its section anew when it changes.
  public derived active: ProfileName = picked(self.kept.picks, self.who())
  // The rule that names it, for the page to say why.
  public derived why: Profiles::Reason = pickOf(self.kept.picks, self.who()).why
  // Every profile, by name: the ones kept and the account's, which is there before anything is kept in it.
  public derived names: array<string> = self.namesOf()
  // Each `Settings` packs its values into its profile where they changed: as the game saves (`PLAYER_LOGOUT` comes
  // before every save, a `/reload` too), before what is kept is edited (a switch of profile, a copy) and before an
  // export. A change itself is never packed. Each listener is its own call: one module's error keeps no other's.
  public const packing: Event<nil> = new Event()
  // Before it: the input under way writes what it holds (`Keeper.finishInput`), so nothing pending is left out.
  public const finishing: Event<nil> = new Event()

  constructor() {
    for (former, current of RENAMED) {
      Game::saved.renamed(.Account, former, current)
      Game::saved.renamed(.Character, former, current)
    }
    let kept = load(.Account, "profiles", SavedProfiles {})
    for (former, current of RENAMED) { kept.moved(former, current) }
    self.kept = kept
    Events::PLAYER_LOGOUT.listen(self.pack)
  }

  // Every `Settings`' values packed into their profile.
  public mut pack() {
    self.finishing.emit()
    self.packing.emit()
  }

  // Who the character is as the picks ask: its GUID, its specialisation's place where it has one, its class.
  public who(): Profiles::Player {
    return { character: Game::player.guid, spec: Game::player.spec?.index, classTag: Game::player.classTag }
  }

  namesOf(): array<string> {
    const kept = self.kept
    const list: array<string> = mut []
    for (name, _ of kept.profiles) { list.push(name) }
    if (kept.profiles[kept.picks.account] == nil) { list.push(kept.picks.account) }
    list.sort((a, b) => a < b)
    return list
  }

  // The kept profiles and picks as a copy to change and hand to `apply`, every `Settings`' values packed first.
  public mut edit(): mut SavedProfiles {
    self.pack()
    return self.copy()
  }

  copy(): mut SavedProfiles {
    return (peek self.kept).clone()
  }

  // Whether keeping `next` would make this character use another profile than it does.
  public switches(next: SavedProfiles): boolean {
    return picked(next.picks, self.who()) != peek self.active
  }

  // What the player chose, kept: a `Settings` follows a change of the active profile.
  public mut apply(next: SavedProfiles) {
    self.kept = next
    Game::saved.store(.Account, "profiles", next)
  }

  // A `Settings`' section in a profile, unpacked for its `decode`; nil where the profile has none. A `Settings` kept
  // before profiles were (`Game.saved` under its key) is moved into «Default» as it is first read.
  public mut section(name: ProfileName, key: string): unknown {
    const before = Game::saved.stored(.Account, key)
    if (before != nil) {
      const packed = Game::encoding.serialize(before)
      // A client that can't pack it: it is read as it was kept, and stays there.
      if (packed == nil) { return before }
      // «Default» as it is named now: the account's default pick, which the player may have renamed.
      self.put((peek self.kept).picks.account, key, packed)
      Game::saved.forget(.Account, key)
    }
    const profile = (peek self.kept).profiles[name]
    if (profile == nil) { return nil }
    const raw = profile.sections[key]
    if (raw == nil) { return nil }
    return Game::encoding.deserialize(raw)
  }

  // A `Settings`' values kept in a profile.
  public mut write(name: ProfileName, key: string, values: unknown) {
    const packed = Game::encoding.serialize(values)
    if (packed != nil) { self.put(name, key, packed) }
  }

  // What was kept on the account under `old` before profiles held it (`values`, read as its section's shape) is moved
  // into «Default», where that has no section of the key yet, as it is first read.
  public mut adopt(old: string, key: string, values: unknown) {
    const packed = Game::encoding.serialize(values)
    // A client that can't pack it: it stays where it was, read again at the next start.
    if (packed == nil) { return }
    const into = (peek self.kept).picks.account
    const profile = (peek self.kept).profiles[into]
    if (profile == nil || profile.sections[key] == nil) { self.put(into, key, packed) }
    Game::saved.forget(.Account, old)
  }

  // A `ModuleMemory`'s values in a profile, unpacked for its `decode`; nil where the profile keeps none under the key.
  public recalled(name: ProfileName, key: string): unknown {
    const profile = (peek self.kept).profiles[name]
    if (profile == nil) { return nil }
    const raw = profile.memory[key]
    if (raw == nil) { return nil }
    return Game::encoding.deserialize(raw)
  }

  // A `ModuleMemory`'s values kept in the active profile; nil (its defaults) lets its entry go. Past the bound, nothing
  // changes.
  public mut remember(key: string, values: unknown | nil) {
    const packed = values == nil ? nil : Game::encoding.serialize(values)
    if (values != nil && packed == nil) { return }
    if (packed != nil && packed.length > MEMORY_BOUND) {
      Debug::log("memory %s: %d bytes packed, past the bound of %d: not kept", key, packed.length, MEMORY_BOUND)
      return
    }
    const name = peek self.active
    const was = (peek self.kept).profiles[name]
    if (packed == nil && (was == nil || was.memory[key] == nil)) { return }
    const next = self.copy()
    const profile = next.profiles[name] ?? Profile {}
    profile.memory[key] = packed
    next.profiles[name] = profile
    self.apply(next)
  }

  mut put(name: ProfileName, key: string, packed: string) {
    const next = self.copy()
    const profile = next.profiles[name] ?? Profile {}
    profile.sections[key] = packed
    next.profiles[name] = profile
    self.apply(next)
  }

  // A new profile, a copy of the profile `from` or, where that is nil, with no section (every module's defaults):
  // false where the name is empty or taken.
  public mut make(name: ProfileName, from: string | nil): boolean {
    if (!self.free(name)) { return false }
    const next = self.edit()
    const source = from == nil ? nil : next.profiles[from]
    next.profiles[name] = source == nil ? mut Profile {} : source.clone()
    self.apply(next)
    return true
  }

  // A new profile of a savepoint's sections (each a snapshot of a module's values): false where the name is empty or
  // taken, or a section can't be packed.
  public mut makeOf(name: ProfileName, sections: map<string, unknown>): boolean {
    if (!self.free(name)) { return false }
    const profile = mut Profile {}
    for (key, values of sections) {
      const packed = Game::encoding.serialize(values)
      if (packed == nil) { return false }
      profile.sections[key] = packed
    }
    const next = self.edit()
    next.profiles[name] = profile
    self.apply(next)
    return true
  }

  free(name: ProfileName): boolean {
    return name != "" && !self.namesOf().any(known => known == name)
  }

  // The account's default pick: every character that has no pick of its own switches to it at once.
  public mut use(name: ProfileName) {
    const next = self.edit()
    next.picks.account = name
    self.apply(next)
  }
}
