// What each stat is worth to each spec of every class, an item's worth the sum of its stats by them: Pawn Forever's
// weights (turlockmike, MIT licence, its Weights.lua), written here by a script; edit the weights there, not here.
// Rating stats (crit, hit, haste, expertise, dodge, parry, block) are weighed per 1%, the rest per point. Below the
// level's cap a spec weighs by `leveling`, at it by `max`.

// A spec's weights, per point of each stat (per 1% of a rating): nought for one it doesn't weigh.
public struct Weights {
  agility: Number = 0
  allResist: Number = 0
  ap: Number = 0
  arcaneResist: Number = 0
  arcaneSpellDamage: Number = 0
  armor: Number = 0
  blockRating: Number = 0
  blockValue: Number = 0
  critRating: Number = 0
  defenseRating: Number = 0
  dodgeRating: Number = 0
  expertiseRating: Number = 0
  feralAp: Number = 0
  fireResist: Number = 0
  fireSpellDamage: Number = 0
  frostResist: Number = 0
  frostSpellDamage: Number = 0
  hasteRating: Number = 0
  healing: Number = 0
  health: Number = 0
  hitRating: Number = 0
  holySpellDamage: Number = 0
  hp5: Number = 0
  intellect: Number = 0
  mana: Number = 0
  meleeDps: Number = 0
  mp5: Number = 0
  natureResist: Number = 0
  natureSpellDamage: Number = 0
  parryRating: Number = 0
  rangedDps: Number = 0
  rap: Number = 0
  shadowResist: Number = 0
  shadowSpellDamage: Number = 0
  spellDamage: Number = 0
  spirit: Number = 0
  stamina: Number = 0
  strength: Number = 0
}

// A spec of a class: the client's class (`WARRIOR`), the spec's place among the class's specialisations (none for a
// build Forever plays within one, chosen in the settings: a Shockadin), its own key and English name, and its weights.
public struct SpecWeights {
  classTag: String
  key: String
  spec: Integer | nil
  label: String
  leveling: Weights
  max: Weights
}

