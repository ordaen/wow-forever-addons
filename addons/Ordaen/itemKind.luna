// What an item is, as every window that groups items names it (the bags' tabs, a merchant's goods): a quest item, a
// consumable, equipment, a trade good, a recipe, a key, or the rest. An item is of one kind alone (`kindOf`).
import Locale from "@/locales"

public enum ItemKind implements Plain {
  Quest = "quest"
  Consumables = "consumables"
  Equipment = "equipment"
  Trade = "trade"
  Recipes = "recipes"
  Keys = "keys"
  Other = "other"
}

// The kinds in their fixed order: quest items and consumables first, then equipment, trade goods, recipes, the rest.
public const ITEM_KINDS: array<ItemKind> = [.Quest, .Consumables, .Equipment, .Trade, .Recipes, .Keys, .Other]

// The client's classes of items (`Enum.ItemClass`) the kinds are made of.
const CONSUMABLE = 0
const WEAPON = 2
const GEM = 3
const ARMOR = 4
const REAGENT = 5
const TRADE = 7
const RECIPE = 9
const QUEST = 12
const KEY = 13

// An item's kind by the client's class of it (`itemClass`): a trade good where crafting takes it, as the client marks
// it (`reagent`), whatever its class (a feather is the client's miscellany).
public function kindOf(itemClass: integer, reagent: boolean): ItemKind {
  if (reagent) { return .Trade }
  return match (itemClass) {
    QUEST => .Quest
    CONSUMABLE => .Consumables
    WEAPON, ARMOR => .Equipment
    TRADE, REAGENT, GEM => .Trade
    RECIPE => .Recipes
    KEY => .Keys
    else => .Other
  }
}

public function kindName(kind: ItemKind): string {
  return match (kind) {
    .Quest => Locale::KIND_QUEST
    .Consumables => Locale::KIND_CONSUMABLES
    .Equipment => Locale::KIND_EQUIPMENT
    .Trade => Locale::KIND_TRADE
    .Recipes => Locale::KIND_RECIPES
    .Keys => Locale::KIND_KEYS
    .Other => Locale::KIND_OTHER
  }
}
