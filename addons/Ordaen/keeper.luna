// Every `Settings`' draft together, as the settings window sees them: Ordaen's root keeps one (`Ordaen.keeper`), a
// `Settings` joins it as it is made, and hears when the drafts are saved, dropped or taken back. It keeps the profiles
// the values are kept in.
import { Profiles } from "@/profiles"

// What the profiles' page asks of a `Settings` it knows only by the key it is kept under: Ordaen knows no module's type,
// and a section is read as its type by the `Settings` that owns it.
public trait Sectioned {
  // How many of its settings a section (CBOR read to plain data) would change in its values.
  public differs(self, raw: Unknown): Integer
  // A section becomes its draft: it waits for «Save».
  public draftFrom(mut self, raw: Unknown)
  // Every value back to its default, the draft with them.
  public reset(mut self)
}

public class Keeper {
  // Every `Settings`' values, by profile: a `Settings` reads the active profile's section and follows a switch.
  public const profiles: mut Profiles = new Profiles()
  // How many entries wait to be saved, over every module.
  public derived unsaved: Integer = self.sum()
  // Whether there is a save to take back.
  public state rollbackable = false
  // A save: each `Settings` whose draft differs takes it and says so (`changed`); where one did, `saved` follows,
  // and what the values were before is what a roll back returns to.
  public const saving: Event<nil> = new Event()
  public const saved: Event<nil> = new Event()
  public const discarding: Event<nil> = new Event()
  public const rollingBack: Event<nil> = new Event()
  // Whether a `Settings` took its draft in the save that is running.
  any = false
  // How many entries of each `Settings` wait, by what it joined as.
  state counts: mut Map<Integer, Integer> = {}
  last = 0
  // Every `Settings` that is kept, by its key, and who joined as it.
  sections: mut Map<String, mut any Sectioned> = {}
  owners: mut Map<String, Integer> = {}

  // A `Settings` that is kept is known by its key until it is gone.
  public enrol(mut self, key: String, id: Integer, section: mut any Sectioned) {
    self.sections[key] = section
    self.owners[key] = id
  }

  public withdraw(mut self, key: String, id: Integer) {
    if (self.owners[key] == id) {
      self.sections[key] = nil
      self.owners[key] = nil
    }
  }

  // Whether a `Settings` is made for the key: its module is loaded.
  public loaded(self, key: String): Boolean {
    return self.sections[key] != nil
  }

  // How many settings a section would change; nil where no `Settings` is made for the key.
  public differs(self, key: String, raw: Unknown): Integer | nil {
    const section = self.sections[key]
    if (section == nil) { return nil }
    return section.differs(raw)
  }

  // A section made the draft of its `Settings`: false where none is made for the key.
  public draft(mut self, key: String, raw: Unknown): Boolean {
    const section = self.sections[key]
    if (section == nil) { return false }
    section.draftFrom(raw)
    return true
  }

  // Every `Settings` back to its defaults, in the active profile.
  public resetAll(mut self) {
    for (_, section of self.sections) { section.reset() }
  }

  sum(self): Integer {
    let total = 0
    for (_, waiting of self.counts) { total += waiting }
    return total
  }

  // A `Settings` is made: what it is counted by. It says how many of its entries wait, and that it is gone.
  public join(mut self): Integer {
    self.last += 1
    return self.last
  }

  public count(mut self, id: Integer, waiting: Integer) { self.counts[id] = waiting }
  public leave(mut self, id: Integer) { self.counts[id] = 0 }

  public changed(mut self) { self.any = true }

  // The drafts become the values.
  public saveAll(mut self) {
    self.any = false
    self.saving.emit()
    if (!self.any) { return }
    self.saved.emit()
    self.rollbackable = true
  }

  // The drafts go back to the values.
  public discardAll(mut self) { self.discarding.emit() }

  // The values go back to what they were before the last save, and the drafts with them.
  public rollbackAll(mut self) {
    if (!peek self.rollbackable) { return }
    self.rollingBack.emit()
    self.rollbackable = false
  }
}
