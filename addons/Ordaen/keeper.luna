// Every `Settings`' draft together: what drafts.d.luna declares.
import Drafts from "@/drafts"

public class Keeper {
  public derived unsaved: Integer = self.sum()
  public state rollbackable: Boolean = false
  public saving: Event<nil> = new Event()
  public saved: Event<nil> = new Event()
  // Whether a `Settings` took its draft in the save that is running.
  any = false
  public discarding: Event<nil> = new Event()
  public rollingBack: Event<nil> = new Event()
  // How many entries of each `Settings` wait, by what it joined as.
  state counts: mut Map<Integer, Integer> = {}
  last = 0
  name: String | nil = "Ordaen"

  constructor() {
    $provide(Drafts, self)
  }

  sum(self): Integer {
    let total = 0
    for (id, waiting of self.counts) { total += waiting }
    return total
  }

  public join(mut self): Integer {
    self.last += 1
    return self.last
  }

  public count(mut self, id: Integer, waiting: Integer) { self.counts[id] = waiting }
  public leave(mut self, id: Integer) { self.counts[id] = 0 }
  public naming(mut self, name: String | nil) { self.name = name }
  public nameNow(self): String | nil { return self.name }

  public changed(mut self) { self.any = true }

  public saveAll(mut self) {
    self.any = false
    self.saving.emit()
    if (!self.any) { return }
    self.saved.emit()
    self.rollbackable = true
  }

  public discardAll(mut self) { self.discarding.emit() }

  public rollbackAll(mut self) {
    if (!peek self.rollbackable) { return }
    self.rollingBack.emit()
    self.rollbackable = false
  }
}
