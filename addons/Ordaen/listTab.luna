// ListTab: an entry in a list of pages (the settings window's modules, a module page's bars): its icon, its name,
// and what its slot holds at its right (a switch). The shade under the cursor; selected, a darker shade, the name
// white and a 3 px light along its left; off, name and icon dimmed. Left-click reports `pick`.
import { Align, Art, Edges, Position, Stated, Track } from "$ltml"
import { Component } from "@/module"
import { PX } from "@/units"

const INK: Color = Color.hex("#e8dcc4")
const WHITE: Color = Color.hex("#ffffff")
const OFF: Color = Color.hex("#7a705f")
const CLEAR: Color = Color.hex("#00000000")
const SHADE: Stated<Color> = { default: CLEAR, hover: Color.hex("#00000059") }
const SELECTED: Color = Color.hex("#00000040")
// An icon that is off: darker.
const DIM: Color = Color.hex("#999999")
const LIGHT: Color = Color.hex("#d6a56b")
const PADDING: Edges = { top: 7 * PX, right: 12 * PX, bottom: 7 * PX, left: 16 * PX }
const WITH_ICON: Array<Track> = [22 * PX, { fr: 1 }, "auto"]
// An entry without an icon: its name from the left.
const NO_ICON: Array<Track> = [{ fr: 1 }, "auto"]

public class ListTab implements Component {
  public pick: Event<nil> = new Event()

  derived hasIcon: Boolean = self.icon != nil
  derived columns: Array<Track> = self.hasIcon ? WITH_ICON : NO_ICON
  derived background: Color | Stated<Color> = self.selected ? SELECTED : SHADE
  derived color: Color = self.selected ? WHITE : self.off ? OFF : INK
  derived tint: Color = self.off ? DIM : WHITE
  // The light along the left: on every entry, clear on the others, so only colours tell the selected one.
  derived light: Color = self.selected ? LIGHT : CLEAR

  label: Signal<String>
  selected: Signal<Boolean>
  icon: Signal<Art | nil>
  off: Signal<Boolean>
  constructor(
    label: Signal<String>,
    selected: Signal<Boolean>,
    // None for an entry without a picture.
    icon: Signal<Art | nil> = nil,
    off: Signal<Boolean> = false,
  ) {
    self.label = label
    self.selected = selected
    self.icon = icon
    self.off = off
  }

  onClick(mut self) { self.pick.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} gap={10 * PX} padding={PADDING} yAlign={Align.Center}
           background={self.background} @click={self.onClick}>
        <box position={Position.Absolute} left={0} top={0} bottom={0} width={3 * PX} background={self.light} />
        <box $if={self.hasIcon} width={22 * PX} height={22 * PX} icon={self.icon} tint={self.tint} />
        <text value={self.label} textColor={self.color} textSize={15 * PX} wrap={false} />
        <box>
          <slot />
        </box>
      </box>
    }
  }
}
