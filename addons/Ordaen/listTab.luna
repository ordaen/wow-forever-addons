// ListTab: an entry in a list of pages (the settings window's modules, a module page's bars): its icon, its name,
// and what its slot holds at its right (a switch). A name longer than its column wraps there: a text that doesn't wrap
// keeps its whole line and would push its count past the column (a locale's longer names). The shade under the cursor; selected, a darker shade, the name
// white and a 3 px light along its left; off, name and icon dimmed. Framed (an entry that stands on a frame of its
// own, a folder's tab), it has neither shade nor light: the frame shows which is selected. Left-click (Enter, Space)
// reports `pick`; the right button is left to what holds it.
import { Align, Art, ByInteractionState, Edges, Event, Position, TextWrap, Track } from "$ltml"
import { Component } from "@/module"
import { BRIGHT_TEXT } from "@/units"

const INK: Color = Color::hex("#e8dcc4")
const OFF: Color = Color::hex("#7a705f")
const CLEAR: Color = Color::hex("#00000000")
const SHADE: ByInteractionState<Color> = { default: CLEAR, hover: Color::hex("#00000059"), focus: Color::hex("#00000059") }
const SELECTED: Color = Color::hex("#00000040")
// An icon that is off: darker.
const DIM: Color = Color::hex("#999999")
const LIGHT: Color = Color::hex("#d6a56b")
const PADDING: Edges = { top: 2sp, right: 3.5sp, bottom: 2sp, left: 4.5sp }
// An entry of one line (`oneLine`): set closer, its name kept whole.
const LINE_PADDING: Edges = { top: 1sp, right: 3.5sp, bottom: 1sp, left: 4.5sp }
const WITH_ICON: array<Track> = [25.78125dp, { fr: 1 }, "max-content"]
// An entry without an icon: its name from the left.
const NO_ICON: array<Track> = [{ fr: 1 }, "max-content"]

public class ListTab implements Component {
  public pick: Event<nil> = new Event()

  derived hasIcon: boolean = self.icon != nil
  derived columns: array<Track> = self.hasIcon ? WITH_ICON : NO_ICON
  derived background: Color | ByInteractionState<Color> = self.framed ? CLEAR : self.selected ? SELECTED : SHADE
  derived color: Color = self.selected ? BRIGHT_TEXT : self.off ? OFF : INK
  derived tint: Color = self.off ? DIM : BRIGHT_TEXT
  // The light along the left: on every entry, clear on the others, so only colours tell the selected one.
  derived light: Color = self.selected && !self.framed ? LIGHT : CLEAR
  derived padding: Edges = self.oneLine ? LINE_PADDING : PADDING
  derived wrap: TextWrap = self.oneLine ? .None : .Words

  label: Signal<string>
  selected: Signal<boolean>
  icon: Signal<Art | nil>
  off: Signal<boolean>
  framed: Signal<boolean>
  oneLine: Signal<boolean>
  constructor(
    label: Signal<string>,
    selected: Signal<boolean>,
    // None for an entry without a picture.
    icon: Signal<Art | nil> = nil,
    off: Signal<boolean> = false,
    framed: Signal<boolean> = false,
    // An entry of a list as wide as its names: each kept on one line, the entries set closer.
    oneLine: Signal<boolean> = false
  ) {
    self.label = label
    self.selected = selected
    self.icon = icon
    self.off = off
    self.framed = framed
    self.oneLine = oneLine
  }

  mut onClick() { self.pick.emit() }

  // The left button picks, as a tab of the game's own takes its left button alone: the right is its owner's (the
  // chat's tab menu).
  mut onPress(press: Event::Press) {
    if (press.button == .Left) { self.onClick() }
  }

  public render(): Template {
    return $ltml {
      <box columns={self.columns} gap={3sp} padding={self.padding} yAlign={Align::Center}
           background={self.background} @pointerPress={self.onPress} @keyPress(.Enter)={self.onClick} @keyPress(.Space)={self.onClick}>
        <box position={Position::Absolute} left={0ui} top={0ui} bottom={0ui} width={3.515625dp} background={self.light} />
        <box $if={self.hasIcon} width={25.78125dp} height={25.78125dp} icon={self.icon} tint={self.tint} />
        <text value={self.label} textColor={self.color} wrap={self.wrap} />
        <box>
          <slot />
        </box>
      </box>
    }
  }
}
