// A quest's difficulty against the player's level, and its colour, as the client's `GetQuestDifficultyColor` gives
// it: the quest log's and the tracker's levels.
import root Ordaen from "Ordaen"

// A quest's level in its difficulty's colour, or in `plain` while the player has the game's colours off
// (`Ordaen.questColors`), as the game's own log and tracker draw it.
public function questLevelColor(quest: integer, player: integer, plain: color): color {
  return Ordaen.questColors ? colorOf(difficultyOf(quest, player)) : plain
}

// The client's five colours.
public enum Difficulty { Trivial, Easy, Even, Hard, Impossible }

// The levels below the player's at which a quest is still green, as the client counts them.
function greenRange(level: integer): integer {
  if (level <= 5) { return 5 }
  if (level <= 39) { return (level / 10).floor() + 5 }
  if (level <= 59) { return (level / 5).floor() + 1 }
  return 12
}

public function difficultyOf(quest: integer, player: integer): Difficulty {
  const above = quest - player
  if (above >= 5) { return .Impossible }
  if (above >= 3) { return .Hard }
  if (above >= -2) { return .Even }
  if (-above <= greenRange(player)) { return .Easy }
  return .Trivial
}

public function colorOf(difficulty: Difficulty): color {
  return match (difficulty) {
    .Trivial => #808080
    .Easy => #40c040
    .Even => #ffff00
    .Hard => #ff8040
    .Impossible => #ff2020
  }
}
