// Hotkeys: what the mouse and the keys do on what a tooltip explains, one «Press: what it does» line each («C:
// open», «Shift+Left-click: send to chat»). Every tooltip draws them the same way: last, under their own rule, in
// the footer's quiet colour and size.
import { Line, Side } from "$ltml"
import { Component } from "@/module"
import { SECONDARY_TEXT } from "@/units"

const QUIET: color = #857a66
const RULE: Line = { width: 1.171875dp, color: #d6a56b2e, sides: [Side::Top] }

// The hotkeys of a frame of the game's that another module draws or binds (a button of the action bars), by the
// frame's name: what a tooltip shown for that frame adds to its own. None where the frame isn't the module's.
public trait OwnerKeys {
  public keys(owner: string): array<string>
}

// The hotkeys' section of a tooltip: drawn only with a line in it.
public class Hotkeys implements Component {
  derived any: boolean = self.keys.length > 0

  keys: Signal<array<string>>
  constructor(keys: Signal<array<string>>) { self.keys = keys }

  public render(): Template {
    return $ltml {
      <box $if={self.any} gap={2sp} padding={{ top: 3sp }} border={RULE}>
        <text $for={key of self.keys} value={key} textColor={QUIET} textSize={SECONDARY_TEXT} wrap={.None} />
      </box>
    }
  }
}
