// Dropdown: a setting that is one of several choices, as the bronze plate showing the picked choice in gold with an
// arrow. Left-click opens the menu under it, each choice with its mark (the picked one's gold), the light under the
// cursor. Left-click on a choice picks it and closes the menu; a click anywhere else closes it. Disabled, it doesn't
// open. A choice not built yet (`soon`) is listed dimmed, with «in development» after its name, and takes no click.
import Game from "$game"
import { Align, Art, Beside, Bounds, ByInteractionState, Edges, Layer, Line, Overflow, Position, Shadow, TextWeight, TextWrap } from "$ltml"
import root Ordaen from "Ordaen"
import Locale from "@/locales"
import { Component } from "@/module"
import { SettingRow } from "@/settingRow"
import { BRIGHT_TEXT } from "@/units"

// One of a dropdown's choices: the value the setting takes, and what the player reads; on a toolbar's ToolPick, the
// glyph its button shows while it is picked (a view's).
public struct Choice<T: unknown> {
  public mut value: T
  public mut label: string
  public mut soon: boolean | nil
  public mut icon: Art | nil
}

const WIDTH = 281.25dp
const HEIGHT = 39.84375dp
const GOLD: color = #f0c860
const DIM: color = #ffffff73
const FACE_PAD: Edges = { right: 3.5sp, left: 5.5sp }
const COMPACT_FACE_PAD: Edges = { right: 2.5sp, left: 3.5sp }
const ARROW_SHADOW: Shadow = { color: #14141fcc, x: 1.171875dp, y: 1.171875dp }
const MENU_BACK: color = #0a0806f7
const MENU_EDGE: Line = { width: 1.171875dp, color: #6c5535 }
const MENU_PAD: Edges = { top: 2sp, bottom: 2sp }
const ITEM_PAD: Edges = { top: 1.5sp, right: 4sp, bottom: 1.5sp, left: 9sp }
const CLEAR: color = #00000000
const LIGHT: ByInteractionState<color> = { default: CLEAR, hover: #d6a56b2e, focus: #d6a56b2e }
// What the open menu takes of the screen's height besides its choices: its padding and edges, and a margin.
const SCREEN_MARGIN = 32dp

// The open menu's choices: as high as they are, at most the screen's height, scrolling past it; the menu itself is
// held on the screen (`clamp`).
function listRoom(): Bounds {
  return { max: Game::screen.height - SCREEN_MARGIN }
}

// One choice in the open menu.
public class DropdownItem<T: unknown> implements Component {
  public pick: Event<T> = new Event()

  derived mark: Art = self.value == self.choice.value ? Ordaen.art.ctl.radioOn : Ordaen.art.ctl.radio
  derived text: string = self.choice.soon == true ? self.choice.label + " — " + Locale::SOON : self.choice.label
  derived color: color = self.choice.soon == true ? DIM : BRIGHT_TEXT
  derived light: color | ByInteractionState<color> = self.choice.soon == true ? CLEAR : LIGHT
  derived wrap: TextWrap = self.compact ? TextWrap::None : TextWrap::Words

  choice: Signal<Choice<T>>
  value: Signal<T>
  const compact: boolean
  constructor(
    choice: Signal<Choice<T>>,
    value: Signal<T>,
    // As a `CompactDropdown`'s: the text on one line.
    compact: boolean = false
  ) {
    self.choice = choice
    self.value = value
    self.compact = compact
  }

  mut onClick() {
    if (self.choice.soon != true) { self.pick.emit(self.choice.value) }
  }

  public render(): Template {
    return $ltml {
      <box padding={ITEM_PAD} background={self.light} @pointerPress={self.onClick} @keyPress(.Enter)={self.onClick} @keyPress(.Space)={self.onClick}>
        <box position={Position::Absolute} left={11.71875dp} top={10.546875dp} width={12.890625dp} height={12.890625dp}
             background={self.mark} />
        <text value={self.text} textColor={self.color} wrap={self.wrap} />
      </box>
    }
  }
}

// The label of the choice a value is: none when it is none of them.
function labelOf<T: unknown>(choices: array<Choice<T>>, value: T): string {
  for (choice of choices) {
    if (choice.value == value) { return choice.label }
  }
  return ""
}

public class Dropdown<T: unknown> implements Component {
  state open = false
  derived shown: string = labelOf(self.choices, self.value)

  label: Signal<string>
  value: mut Signal<T>
  const choices: array<Choice<T>>
  hint: Signal<string>
  disabled: Signal<boolean>
  constructor(
    label: Signal<string>,
    value: mut Signal<T>,
    choices: array<Choice<T>>,
    hint: Signal<string> = "",
    disabled: Signal<boolean> = false
  ) {
    self.label = label
    self.value = value
    self.choices = choices
    self.hint = hint
    self.disabled = disabled
  }

  mut toggle() {
    if (!self.disabled) { self.open = !self.open }
  }

  mut close() { self.open = false }

  mut onPick(value: T) {
    self.value = value
    self.open = false
  }

  public render(): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <box width={WIDTH} height={HEIGHT}>
          <box position={Position::Absolute} left={0ui} top={0ui} width={WIDTH} height={HEIGHT} padding={FACE_PAD}
               columns={[{ fr: 1 }, 18.75dp]} gap={3sp} yAlign={Align::Center}
               background={Ordaen.art.ctl.button} disabled={self.disabled} @pointerPress={self.toggle} @keyPress(.Enter)={self.toggle} @keyPress(.Space)={self.toggle}>
            <text value={self.shown} textColor={GOLD} textWeight={TextWeight::Bold} wrap={.None} />
            <box width={18.75dp} height={18.75dp} background={Ordaen.art.ctl.dropdownArrow} shadow={ARROW_SHADOW} />
          </box>
          <surface leading={.Row} $if={self.open} layer={Layer::Tooltip} place={Beside { beside: "parent" }} width={WIDTH + 23.4375dp}
                   background={MENU_BACK} border={MENU_EDGE} padding={MENU_PAD} columns={1} clamp={true}
                   @pointerPressOutside={self.close}>
            <box columns={1} height={listRoom()} overflow={Overflow::Scroll}>
              <DropdownItem $for={choice of self.choices} choice={choice} value={self.value} @pick={self.onPick} />
            </box>
          </surface>
        </box>
      </SettingRow>
    }
  }
}

// CompactDropdown: the bronze plate alone, as wide as it is told and with no label of a setting's row, for a tool row
// (a sort, a view). It shows the picked choice in gold with an arrow; left-click opens the list under it, a click on a
// choice picks it and closes the list, a click anywhere else closes it.
public class CompactDropdown<T: unknown> implements Component {
  // A choice picked, heard in the player's click itself: what the client takes from a click alone (a status) is
  // done here, never by a watch on `value`, which runs a frame later.
  public pick: Event<T> = new Event()
  state open = false
  derived shown: string = labelOf(self.choices, self.value)
  derived listBounds: Bounds = { min: self.width + 46.875dp, max: nil }

  value: mut Signal<T>
  const choices: array<Choice<T>>
  width: Signal<number<Length>>
  disabled: Signal<boolean>
  constructor(
    value: mut Signal<T>,
    choices: array<Choice<T>>,
    width: Signal<number<Length>>,
    // Shown dimmed, and opens no list.
    disabled: Signal<boolean> = false
  ) {
    self.value = value
    self.choices = choices
    self.width = width
    self.disabled = disabled
    watch {
      if (self.disabled) { self.open = false }
    }
  }

  mut toggle() {
    if (!self.disabled) { self.open = !self.open }
  }
  mut close() { self.open = false }

  mut onPick(value: T) {
    self.value = value
    self.open = false
    self.pick.emit(value)
  }

  public render(): Template {
    return $ltml {
      <box width={self.width} height={HEIGHT}>
        <box position={Position::Absolute} left={0ui} top={0ui} width={self.width} height={HEIGHT}
             padding={COMPACT_FACE_PAD} columns={[{ fr: 1 }, 18.75dp]} gap={2sp} yAlign={Align::Center}
             background={Ordaen.art.ctl.button} @pointerPress={self.toggle} @keyPress(.Enter)={self.toggle} @keyPress(.Space)={self.toggle}>
          <text value={self.shown} textColor={GOLD} wrap={.Cut} />
          <box width={18.75dp} height={18.75dp} background={Ordaen.art.ctl.dropdownArrow} shadow={ARROW_SHADOW} />
        </box>
        <surface leading={.Row} $if={self.open} layer={Layer::Tooltip} place={Beside { beside: "parent" }} width={self.listBounds}
                 background={MENU_BACK} border={MENU_EDGE} padding={MENU_PAD} columns={1} clamp={true} @pointerPressOutside={self.close}>
          <box columns={1} height={listRoom()} overflow={Overflow::Scroll}>
            <DropdownItem $for={choice of self.choices} choice={choice} value={self.value} compact={true}
                          @pick={self.onPick} />
          </box>
        </surface>
      </box>
    }
  }
}

// One choice in a `ManyDropdown`'s open menu: its tick, gold while it is picked.
class ManyItem<T: unknown> implements Component {
  public flip: Event<T> = new Event()

  derived picked: boolean = self.value.any((each: T) => each == self.choice.value)
  derived tick: number = self.picked ? 1 : 0

  choice: Signal<Choice<T>>
  value: Signal<array<T>>
  constructor(choice: Signal<Choice<T>>, value: Signal<array<T>>) {
    self.choice = choice
    self.value = value
  }

  mut onClick() { self.flip.emit(self.choice.value) }

  public render(): Template {
    return $ltml {
      <box padding={ITEM_PAD} background={LIGHT} @pointerPress={self.onClick} @keyPress(.Enter)={self.onClick} @keyPress(.Space)={self.onClick}>
        <box position={Position::Absolute} left={9.375dp} top={8.203125dp} width={TICK} height={TICK}
             background={Ordaen.art.ctl.check}>
          <box position={Position::Absolute} left={0ui} top={0ui} width={TICK} height={TICK}
               background={Ordaen.art.ctl.tick} opacity={self.tick} />
        </box>
        <text value={self.choice.label} textColor={BRIGHT_TEXT} />
      </box>
    }
  }
}

const TICK = 18.75dp

// The labels of the choices a list holds, in the choices' order, joined; none when it holds none.
function labelsOf<T: unknown>(choices: array<Choice<T>>, value: array<T>): string {
  const labels: array<string> = mut []
  for (choice of choices) {
    if (value.any((each: T) => each == choice.value)) { labels.push(choice.label) }
  }
  return labels.join(", ")
}

// ManyDropdown: a setting that is any number of several choices, as a `Dropdown` is one: the plate shows the picked
// ones' names, or, where none is picked, `none` dimmed. Left-click on a choice in the open menu picks it or lets it go
// and leaves the menu open; a click anywhere else closes it.
public class ManyDropdown<T: unknown> implements Component {
  state open = false
  derived picked: string = labelsOf(self.choices, self.value)
  derived empty: boolean = self.picked == ""
  derived shown: string = self.empty ? self.none : self.picked
  derived color: color = self.empty ? DIM : GOLD

  label: Signal<string>
  value: mut Signal<array<T>>
  const choices: array<Choice<T>>
  none: Signal<string>
  hint: Signal<string>
  disabled: Signal<boolean>
  constructor(
    label: Signal<string>,
    value: mut Signal<array<T>>,
    choices: array<Choice<T>>,
    // What the plate says while nothing is picked.
    none: Signal<string>,
    hint: Signal<string> = "",
    disabled: Signal<boolean> = false
  ) {
    self.label = label
    self.value = value
    self.choices = choices
    self.none = none
    self.hint = hint
    self.disabled = disabled
  }

  mut toggle() {
    if (!self.disabled) { self.open = !self.open }
  }

  mut close() { self.open = false }

  // The choice flipped: the list keeps the choices' order.
  mut onFlip(flipped: T) {
    const was = peek self.value
    const next: array<T> = mut []
    for (choice of self.choices) {
      const held = was.any((each: T) => each == choice.value)
      if (held != (choice.value == flipped)) { next.push(choice.value) }
    }
    self.value = next
  }

  public render(): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <box width={WIDTH} height={HEIGHT}>
          <box position={Position::Absolute} left={0ui} top={0ui} width={WIDTH} height={HEIGHT} padding={FACE_PAD}
               columns={[{ fr: 1 }, 18.75dp]} gap={3sp} yAlign={Align::Center}
               background={Ordaen.art.ctl.button} @pointerPress={self.toggle} @keyPress(.Enter)={self.toggle} @keyPress(.Space)={self.toggle}>
            <text value={self.shown} textColor={self.color} wrap={.None} />
            <box width={18.75dp} height={18.75dp} background={Ordaen.art.ctl.dropdownArrow} shadow={ARROW_SHADOW} />
          </box>
          <surface leading={.Row} $if={self.open} layer={Layer::Tooltip} place={Beside { beside: "parent" }} width={WIDTH + 23.4375dp}
                   background={MENU_BACK} border={MENU_EDGE} padding={MENU_PAD} columns={1} clamp={true}
                   @pointerPressOutside={self.close}>
            <box columns={1} height={listRoom()} overflow={Overflow::Scroll}>
              <ManyItem $for={choice of self.choices} choice={choice} value={self.value} @flip={self.onFlip} />
            </box>
          </surface>
        </box>
      </SettingRow>
    }
  }
}
