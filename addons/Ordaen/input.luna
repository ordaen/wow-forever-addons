// Input: a text setting's row (SettingRow: its label, its hint, greyed while disabled) with a text field sunk into
// the page: dark, with a fine bronze edge. Typing writes the setting; Enter or Escape leaves the field. Disabled, it
// takes no typing.
import { Edges, Line } from "$ltml"
import { Component } from "@/module"
import { PX } from "@/units"
import { SettingRow } from "@/settingRow"

const INK: Color = Color.hex("#e8dcc4")
const FILL: Color = Color.hex("#0d0a08")
const EDGE: Line = { width: 1 * PX, color: Color.hex("#4a3a24") }
const PADDING: Edges = { right: 10 * PX, left: 10 * PX }

public class Input implements Component {
  label: Signal<String>
  value: mut Signal<String>
  const maxLength: Integer | nil
  hint: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    label: Signal<String>,
    value: mut Signal<String>,
    // The most characters it takes; any number when left out.
    maxLength: Integer | nil = nil,
    hint: Signal<String> = "",
    disabled: Signal<Boolean> = false,
  ) {
    self.label = label
    self.value = value
    self.maxLength = maxLength
    self.hint = hint
    self.disabled = disabled
  }

  public render(self): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <input value={mut self.value} width={300 * PX} height={30 * PX} padding={PADDING} background={FILL}
               border={EDGE} textColor={INK} maxLength={self.maxLength}
               disabled={self.disabled} />
      </SettingRow>
    }
  }
}
