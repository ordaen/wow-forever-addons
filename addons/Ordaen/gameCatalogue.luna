// The game's own settings, as its settings window (`SettingsPanel`) offers them on Forever, page by page: what each
// control shows and which of the client's settings (CVars) it writes. Read from Blizzard's settings definitions of
// the build (`Blizzard_SettingsDefinitions_Frame`, `_Shared`, with Forever's overrides), and kept in their order.
// A label, a hint and a choice's name are the client's own texts by their names (`CONTROLS_LABEL`), read as the page
// draws; a name the client hasn't is shown as it is written (a sample time, «32x32»).
//
// A control writes CVars and nothing else, so a profile keeps a page whole by keeping those CVars: a choice that
// writes several (status text: `statusTextDisplay` and `statusText`) is one option of several writes, and a slider
// that moves another with it (mouse look speed: the pitch at half the yaw) names it with its ratio.

// One of the client's settings set to a value, as `SetCVar` takes it.
public struct CVarWrite {
  const cvar: String
  const value: String
}

// One option of a choice: its name, and what picking it writes.
public struct GameOption {
  const label: String
  const writes: Array<CVarWrite>
}

// A CVar a slider moves with its own: at its value times `ratio`.
public struct Follower {
  const cvar: String
  const ratio: Number
}

// One row of a page of the game's settings.
public enum GameRow {
  Heading { label: String }
  // A checkbox: `on` while the CVar holds that value, `off` written when unticked.
  Toggle { label: String, tip: String, cvar: String, on: String, off: String }
  // A dropdown: the option whose writes the client holds is shown.
  Choice { label: String, tip: String, options: Array<GameOption> }
  Slider { label: String, tip: String, cvar: String, least: Number, most: Number, step: Number, followers: Array<Follower> }
  // One of the game's key bindings, by its action, where a page names it (the interact key).
  Key { action: String }
}

// A page of the game's settings: its name (the client's) and its rows.
public struct GamePage {
  const label: String
  const rows: Array<GameRow>
}

const function heading(label: String): GameRow { return .Heading { label: label } }

const function check(cvar: String, label: String, tip: String): GameRow {
  return .Toggle { label: label, tip: tip, cvar: cvar, on: "1", off: "0" }
}

// A checkbox ticked while its CVar is off (sticky targeting: `deselectOnClick` 0).
const function negated(cvar: String, label: String, tip: String): GameRow {
  return .Toggle { label: label, tip: tip, cvar: cvar, on: "0", off: "1" }
}

// A checkbox over a CVar of more than two values: `on` and `off` are what it writes.
const function flagged(cvar: String, label: String, tip: String, on: String, off: String): GameRow {
  return .Toggle { label: label, tip: tip, cvar: cvar, on: on, off: off }
}

// A dropdown over one CVar: each option its value and its name.
const function pick(cvar: String, label: String, tip: String, options: Array<[String, String]>): GameRow {
  const list: Array<GameOption> = []
  for (given of options) {
    list.push({ label: given[2], writes: [{ cvar: cvar, value: given[1] }] })
  }
  return .Choice { label: label, tip: tip, options: list }
}

// A dropdown whose options write several CVars.
const function choice(label: String, tip: String, options: Array<GameOption>): GameRow {
  return .Choice { label: label, tip: tip, options: options }
}

const function option(label: String, writes: Array<CVarWrite>): GameOption {
  return { label: label, writes: writes }
}

const function write(cvar: String, value: String): CVarWrite { return { cvar: cvar, value: value } }

const function slider(cvar: String, label: String, tip: String, least: Number, most: Number, step: Number): GameRow {
  return .Slider { label: label, tip: tip, cvar: cvar, least: least, most: most, step: step, followers: [] }
}

const function linked(cvar: String, label: String, tip: String, least: Number, most: Number, step: Number, follower: String, ratio: Number): GameRow {
  return .Slider { label: label, tip: tip, cvar: cvar, least: least, most: most, step: step, followers: [{ cvar: follower, ratio: ratio }] }
}

const function key(action: String): GameRow { return .Key { action: action } }

// The camera's following styles, offered for click-to-move and for the camera.
const FOLLOWING: Array<[String, String]> = [["1", "CAMERA_SMART"], ["4", "CAMERA_SMARTER"], ["2", "CAMERA_ALWAYS"], ["0", "CAMERA_NEVER"]]
