// Every page, in the game's order: the game's settings, then the system's.
public const GAME_PAGES: Array<GamePage> = [CONTROLS, INTERFACE, ACTION_BARS, COMBAT, SOCIAL, NAMEPLATES, ACCESSIBILITY, PRESET, GRAPHICS, AUDIO, NETWORK]

// Every CVar a page writes, once each, in the order the pages name them: what a profile keeps and applies, in that
// order (the graphics' overall quality before the qualities it sets).
public const function cvarsOf(pages: Array<GamePage>): Array<String> {
  const list: Array<String> = []
  const seen: Map<String, Boolean> = {}
  for (page of pages) {
    for (row of page.rows) {
      for (name of namesOf(row)) {
        if (seen[name] == nil) {
          seen[name] = true
          list.push(name)
        }
      }
    }
  }
  return list
}

const function namesOf(row: GameRow): Array<String> {
  const list: Array<String> = []
  if (row is GameRow.Toggle) {
    list.push(row.cvar)
  } else if (row is GameRow.Slider) {
    list.push(row.cvar)
    for (follower of row.followers) { list.push(follower.cvar) }
  } else if (row is GameRow.Choice) {
    for (offered of row.options) {
      for (written of offered.writes) {
        if (!list.any(n => n == written.cvar)) { list.push(written.cvar) }
      }
    }
  }
  return list
}

public const GAME_CVARS: Array<String> = cvarsOf(GAME_PAGES)
