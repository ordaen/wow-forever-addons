// PickRow: one row of a list the player picks from (a friend, an ally, a quest): what it holds laid out in its
// `columns`, a shade under the cursor and the keyboard's focus, a gold one while it is the picked row. A left click,
// Enter or Space reports `pick`; a left click with Shift or Ctrl held reports `modified` with the key, not `pick`; what
// is picked is the owner's, which says so through `picked`.
import Game from "$game"
import { Align, ByInteractionState, Edges, Frame, Modifier, Track } from "$ltml"
import { Component } from "@/module"

const CLEAR: Color = Color::hex("#00000000")
// A light shade: the rows stand on dark wood, where a dark one barely shows.
public const ROW_HOVER: Color = Color::hex("#ffffff24")
const SHADE: ByInteractionState<Color> = { default: CLEAR, hover: ROW_HOVER, focus: ROW_HOVER }
// The picked row's gold.
public const PICKED_ROW: Color = Color::hex("#ffd10026")
const PADDING: Edges = { top: 2sp, right: 2sp, bottom: 2sp, left: 2sp }

// A pickable row's background, for a row that hears more than a pick and draws its own box (a quest's, which Shift
// tracks and the right button opens a menu of): the gold while picked, else the shade under the cursor and the focus.
public function rowShade(picked: Boolean): Color | ByInteractionState<Color> { return picked ? PICKED_ROW : SHADE }

public class PickRow implements Component {
  public pick: Event<nil> = new Event()
  // A left click with Shift or Ctrl held: which.
  public modified: Event<Modifier> = new Event()
  // The cursor came onto the row: its frame, what a tooltip of the row stands by.
  public entered: Event<any Frame> = new Event()

  derived background: Color | ByInteractionState<Color> = rowShade(self.picked)

  columns: Signal<Array<Track>>
  picked: Signal<Boolean>
  padding: Signal<Edges>
  tabStop: Signal<Boolean | nil>
  constructor(
    // Its columns: one track for each thing it holds.
    columns: Signal<Array<Track>>,
    picked: Signal<Boolean> = false,
    padding: Signal<Edges> = PADDING,
    // `false`: no stop of the keyboard's focus, where what holds the rows is one (a list's column); clicked still.
    tabStop: Signal<Boolean | nil> = nil
  ) {
    self.columns = columns
    self.picked = picked
    self.padding = padding
    self.tabStop = tabStop
  }

  onPick(mut self) { self.pick.emit() }
  onShift(mut self) { self.modified.emit(.Shift) }
  onCtrl(mut self) { self.modified.emit(.Ctrl) }
  // A list's row: the tooltips of what it holds stand beside it, never over the rows round it.
  onEnter(self, frame: any Frame) {
    Game::tooltip.rowAt(frame)
    self.entered.emit(frame)
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} gap={2sp} yAlign={Align::Center} padding={self.padding}
           background={self.background} tabStop={self.tabStop} @pointerPress(.Left)={self.onPick} @keyPress(.Enter)={self.onPick}
           @pointerPress([.Shift, .Left])={self.onShift} @pointerPress([.Ctrl, .Left])={self.onCtrl}
           @keyPress(.Space)={self.onPick} @pointerEnter={self.onEnter}>
        <slot />
      </box>
    }
  }
}
