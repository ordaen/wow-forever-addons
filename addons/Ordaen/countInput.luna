// CountInput: a whole number the player sets, held between its least and its most. Both bounds are required and may
// be cells another moves (the reagents in the bags, the stacks of an item): the value never stands outside them, and
// where a bound moves past it the value is written back to that bound. Where the most is under the least there is
// nothing to choose: the value is the least and the control is disabled. Two looks: `Steps`, − and + either side of
// the number (each disabled at its bound; a click steps 1, 10 with Shift held, 100 with Alt, held to the bounds; held
// down, a button steps again after 0.4 s and then every 0.05 s until it is let go or reaches its bound; under the
// cursor, a Tip names those keys), and `Field`, the number typed in, which fills the box it stands in (a
// number past a bound is written as that bound; a text that isn't a number leaves the value and turns the edge red).
import Game from "$game"
import { Align, Edges, Line, Track } from "$ltml"
import { Component } from "@/module"
import Locale from "@/locales"
import { PushButton } from "@/pushButton"
import { TipText } from "@/tip"
import { PX } from "@/units"

public enum CountLook { Steps = "steps", Field = "field" }

const WHITE: Color = Color.hex("#ffffff")
const INK: Color = Color.hex("#e8dcc4")
const FILL: Color = Color.hex("#00000080")
const EDGE: Line = { width: 1 * PX, color: Color.hex("#3e2f1d") }
const BAD: Line = { width: 1 * PX, color: Color.hex("#c0463c") }
const PADDING: Edges = { right: 10 * PX, left: 10 * PX }
// The −, the number in the room of three digits, the +.
const STEPS: Array<Track> = ["auto", 22 * PX, "auto"]
const DIGITS = 6

// `value` held between `least` and `most`; the least where the most is under it.
public function held(value: Integer, least: Integer, most: Integer): Integer {
  return least.max(value.min(most))
}

// How far − or + steps, by the keys held at the click: 100 with Alt, 10 with Shift, else 1. Their Tips say these.
const ONE = 1
const SHIFTED = 10
const ALTERED = 100

function stride(): Integer {
  if (Game.input.altDown()) { return ALTERED }
  if (Game.input.shiftDown()) { return SHIFTED }
  return ONE
}

// What − or + says under the cursor: each key and how far it steps, and holding.
function tipOf(title: String, sign: String): TipText {
  return {
    title: title,
    text: Locale.COUNT_HOLD,
    rows: [
      { label: Locale.COUNT_CLICK, value: sign + String.of(ONE) },
      { label: Locale.COUNT_SHIFT, value: sign + String.of(SHIFTED) },
      { label: Locale.COUNT_ALT, value: sign + String.of(ALTERED) },
    ],
  }
}

const FEWER_TIP: TipText = tipOf(Locale.COUNT_FEWER, "-")
const MORE_TIP: TipText = tipOf(Locale.COUNT_MORE, "+")

// The whole number a text is, or nothing. A minus sign is read only where the least is under nought (a place from the screen's centre); a count has none.
function countOf(text: String, signed: Boolean): Integer | nil {
  const digits = signed ? text.match("^%s*(%-?%d+)%s*$") : text.match("^%s*(%d+)%s*$")
  if (digits == nil) { return nil }
  return (digits.toNumber() ?? 0).floor()
}

public class CountInput implements Component {
  derived off: Boolean = self.disabled || self.most < self.least
  derived fewer: Boolean = !self.off && self.value > self.least
  derived more: Boolean = !self.off && self.value < self.most
  derived stepped: Boolean = self.look == CountLook.Steps
  public state text: String
  public derived bad: Boolean = countOf(self.text, self.least < 0) == nil
  derived edge: Line = self.bad ? BAD : EDGE

  value: mut Signal<Integer>
  least: Signal<Integer>
  most: Signal<Integer>
  const look: CountLook
  // The width of − and +.
  const step: Number
  disabled: Signal<Boolean>
  constructor(
    value: mut Signal<Integer>,
    least: Signal<Integer>,
    most: Signal<Integer>,
    look: CountLook = CountLook.Steps,
    step: Number = 28 * PX,
    disabled: Signal<Boolean> = false,
  ) {
    self.value = value
    self.least = least
    self.most = most
    self.look = look
    self.step = step
    self.disabled = disabled
    self.text = String.of(peek self.value)
    watch { self.hold(self.value, self.least, self.most) }
    watch (typed of self.text) { self.take(typed) }
    watch (count of self.value) { self.show(count) }
  }

  // A bound moved past the value, or another wrote one outside them: the value is the bound.
  hold(mut self, value: Integer, least: Integer, most: Integer) {
    const kept = held(value, least, most)
    if (kept != value) { self.value = kept }
  }

  // What was typed is a number: the value is it, held to the bounds.
  take(mut self, typed: String) {
    const count = countOf(typed, peek self.least < 0)
    if (count == nil) { return }
    const kept = held(count, peek self.least, peek self.most)
    if (kept != peek self.value) {
      self.value = kept
    } else if (kept != count) {
      self.text = String.of(kept)
    }
  }

  // The value changed: the text says it, unless it already does.
  show(mut self, count: Integer) {
    if (countOf(peek self.text, peek self.least < 0) != count) { self.text = String.of(count) }
  }

  less(mut self) {
    if (self.fewer) { self.value = held(self.value - stride(), self.least, self.most) }
  }

  raise(mut self) {
    if (self.more) { self.value = held(self.value + stride(), self.least, self.most) }
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.stepped} columns={STEPS} gap={6 * PX} yAlign={Align.Center}>
        <PushButton label={"-"} width={self.step} disabled={!self.fewer} repeats={true} tip={FEWER_TIP}
                    @click={self.less} />
        <box xAlign={Align.Center}>
          <text value={"%d"} arguments={[self.value]} textColor={WHITE}
                textFont={.Numbers} wrap={false} />
        </box>
        <PushButton label={"+"} width={self.step} disabled={!self.more} repeats={true} tip={MORE_TIP}
                    @click={self.raise} />
      </box>
      <input $else value={mut self.text} padding={PADDING} textColor={INK} background={FILL}
             border={self.edge} maxLength={DIGITS} disabled={self.off} />
    }
  }
}
