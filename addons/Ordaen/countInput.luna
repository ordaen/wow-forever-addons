// CountInput: a whole number the player counts out (how many to buy, to make), held between its least and its most.
// Both bounds are required and may be cells another moves (the reagents in the bags, the stacks of an item): the
// value never stands outside them, and where a bound moves past it the value is written back to that bound. Where the
// most is under the least there is nothing to choose: the value is the least and the control is disabled. − and +
// stand either side of the number, each disabled at its bound. A setting's number is an InputNumber, which steps as
// this does: the stepping below is both's.
//
// Stepping: a click steps 1, 10 with Shift held, 100 with Ctrl, held to the bounds; held down, a button steps again
// after 0.4 s and then every 0.05 s until it is let go or reaches its bound; under the cursor, a Tip names those keys.
import Game from "$game"
import { Align, Bounds, Modifier, Track } from "$ltml"
import Locale from "@/locales"
import { Component } from "@/module"
import { PushButton } from "@/pushButton"
import { TipText } from "@/tip"

const WHITE: Color = Color.hex("#ffffff")
// The −, the number, the +. The number's room is as wide as its digits as the font draws them, two at least: it
// widens past them for a third.
const STEPS: Array<Track> = ["max-content", "max-content", "max-content"]
const NUMBER_BOUNDS: Bounds = { min: 25.78125dp, max: nil }
// The width of − and +.
public const STEP_WIDTH = 32.8125dp

// `value` held between `least` and `most`; the least where the most is under it.
public function held(value: Integer, least: Integer, most: Integer): Integer {
  return least.max(value.min(most))
}

// How many steps − or + takes, by the keys held at the click: 100 with Ctrl, 10 with Shift, else 1. Their Tips say
// these.
const ONE = 1
const SHIFTED = 10
const CONTROLLED = 100

public function stride(): Integer {
  const held = Game.keyboard.activeModifiers
  if (held.any(m => m == Modifier.Ctrl)) { return CONTROLLED }
  if (held.any(m => m == Modifier.Shift)) { return SHIFTED }
  return ONE
}

// What − or + says under the cursor: each key and how far it steps (`said` writes a stride of steps, signed), and
// holding.
public function stepTip(title: String, said: (steps: Integer) => String): TipText {
  return {
    title: title,
    text: Locale.COUNT_HOLD,
    rows: [
      { label: Locale.COUNT_CLICK, value: said(ONE) },
      { label: Locale.COUNT_SHIFT, value: said(SHIFTED) },
      { label: Locale.COUNT_CTRL, value: said(CONTROLLED) }
    ]
  }
}

const FEWER_TIP: TipText = stepTip(Locale.COUNT_FEWER, steps => "-" + String.of(steps))
const MORE_TIP: TipText = stepTip(Locale.COUNT_MORE, steps => "+" + String.of(steps))

public class CountInput implements Component {
  derived off: Boolean = self.disabled || self.most < self.least
  derived fewer: Boolean = !self.off && self.value > self.least
  derived more: Boolean = !self.off && self.value < self.most

  value: mut Signal<Integer>
  least: Signal<Integer>
  most: Signal<Integer>
  // The width of − and +.
  const step: Number<Length>
  disabled: Signal<Boolean>
  constructor(
    value: mut Signal<Integer>,
    least: Signal<Integer>,
    most: Signal<Integer>,
    step: Number<Length> = STEP_WIDTH,
    disabled: Signal<Boolean> = false
  ) {
    self.value = value
    self.least = least
    self.most = most
    self.step = step
    self.disabled = disabled
    watch { self.hold(self.value, self.least, self.most) }
  }

  // A bound moved past the value, or another wrote one outside them: the value is the bound.
  hold(mut self, value: Integer, least: Integer, most: Integer) {
    const kept = held(value, least, most)
    if (kept != value) { self.value = kept }
  }

  less(mut self) {
    if (self.fewer) { self.value = held(self.value - stride(), self.least, self.most) }
  }

  raise(mut self) {
    if (self.more) { self.value = held(self.value + stride(), self.least, self.most) }
  }

  public render(self): Template {
    return $ltml {
      <box columns={STEPS} gap={7.03125dp} yAlign={Align.Center}>
        <PushButton label={"-"} width={self.step} disabled={!self.fewer} repeats={true} tip={FEWER_TIP}
                    @click={self.less} />
        <box xAlign={Align.Center} width={NUMBER_BOUNDS}>
          <text value={"%d"} arguments={[self.value]} textColor={WHITE}
                textFont={.Numbers} wrap={false} />
        </box>
        <PushButton label={"+"} width={self.step} disabled={!self.more} repeats={true} tip={MORE_TIP}
                    @click={self.raise} />
      </box>
    }
  }
}
