// Switch: an on/off switch for a part's own "on" row (an ordinary on/off row is a Checkbox). A bronze-edged pill,
// its knob left and grey while off, right, gold and glowing while on. Left-click flips it; disabled, it takes no
// click. `Switch` is the setting's row with the switch in it; `Toggle` the switch alone, beside an entry in a list.
import { Art, Position } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { PX } from "@/units"
import { SettingRow } from "@/settingRow"

public const SWITCH_WIDTH: Number = 38 * PX
public const SWITCH_HEIGHT: Number = 20 * PX
// The knob's art is a 26 px square, the 14 px knob 6 px in from each side (room for the glow of the one that is
// on). The knob sits 3 px in from the track's left while off, 21 px while on, and 3 px down.
public const SWITCH_KNOB: Number = 26 * PX
public const KNOB_TOP: Number = (3 - 6) * PX
public const KNOB_OFF: Number = (3 - 6) * PX
public const KNOB_ON: Number = (21 - 6) * PX

// The knob of a switch on and the knob of one off are both drawn, each where it stands, the one that isn't the
// state at no opacity: a switch on and one off differ in their colours alone.
public const function knobShown(shown: Boolean): Number {
  return shown ? 1 : 0
}

public class Toggle implements Component {
  derived track: Art = self.value ? Ordaen.art.ctl.switchOn : Ordaen.art.ctl.switchOff
  derived onOpacity: Number = knobShown(self.value)
  derived offOpacity: Number = knobShown(!self.value)

  value: mut Signal<Boolean>
  disabled: Signal<Boolean>
  constructor(
    value: mut Signal<Boolean>,
    disabled: Signal<Boolean> = false,
  ) {
    self.value = value
    self.disabled = disabled
  }

  flip(mut self) {
    if (!self.disabled) { self.value = !self.value }
  }

  public render(self): Template {
    return $ltml {
      <box width={SWITCH_WIDTH} height={SWITCH_HEIGHT} background={self.track} @click={self.flip}>
        <box position={Position.Absolute} left={KNOB_OFF} top={KNOB_TOP} width={SWITCH_KNOB} height={SWITCH_KNOB}
             background={Ordaen.art.ctl.knobOff} opacity={self.offOpacity} />
        <box position={Position.Absolute} left={KNOB_ON} top={KNOB_TOP} width={SWITCH_KNOB} height={SWITCH_KNOB}
             background={Ordaen.art.ctl.knobOn} opacity={self.onOpacity} />
      </box>
    }
  }
}

public class Switch implements Component {
  label: Signal<String>
  value: mut Signal<Boolean>
  hint: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    label: Signal<String>,
    value: mut Signal<Boolean>,
    hint: Signal<String> = "",
    disabled: Signal<Boolean> = false,
  ) {
    self.label = label
    self.value = value
    self.hint = hint
    self.disabled = disabled
  }

  public render(self): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <Toggle value={mut self.value} disabled={self.disabled} />
      </SettingRow>
    }
  }
}
