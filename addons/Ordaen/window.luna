// Window: a window whose open tab is its title. The small metal frame round its body, the windows' wood, its tabs
// standing on the body's top line from its left, the open one over the body and the closed ones behind it. Centred
// on the screen at first; dragging a tab moves it, Escape closes it, the grip in its bottom right corner
// resizes it with its top left corner staying where it is. At the tab row's right end, standing on the body's
// top line as the tabs do: one group of plates, settings where the window is made `withSettings` (its `settings`
// event), full screen (and back) and close; the window is never narrower than its tabs and that group. Its unnamed slot takes the body's content, which fills the body. Its `footer`, where
// it is given one, is the footer row: the window's action groups, its secondary actions and what isn't important
// (counts, how long ago, in small dim text) standing on the body's bottom line under the content; the template lays
// its groups out with the ladder's steps. Its `side`, where it is given one, is a section of its own at the body's
// right, the full height beside the main one. A window made `full` opens full screen; full screen, it keeps `room`
// clear at the screen's right side, where the windows docked there stand. A window made `docked` stands along that
// side of the screen from its top to its bottom, as wide as its placing says: it isn't moved or resized, and its
// full-screen toggle still covers the screen.
import Game from "$game"
import { Align, Art, Bounds, ByInteractionState, Docked, Edges, Event, Layer, Overflow, Place, Point, Position, Shadow, Side, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { reachAcross } from "@/art"
import { Component } from "@/module"
import { Hold, kept } from "@/onScreen"
import { ModuleMemory } from "@/settings"
import { BODY_LINE, SECONDARY_TEXT, WINDOW_ROOM } from "@/units"

// One of a window's tabs: its name, a second line under it, a picture at its left end: art, or a unit's face as the
// game names the unit (`npc`), which follows the unit.
public struct WindowTabSpec {
  title: String
  desc: String | nil
  icon: Art | nil
  portrait: String | nil
}

// Where a window is: its centre from the screen's (y down), and its body's size. Its owner holds it, and the window
// keeps it in its memory.
public struct Placing implements Plain {
  x: Number<Length>
  y: Number<Length>
  width: Number<Length>
  height: Number<Length>
}

// What the player is in the middle of that hides a window, and after which it shows again: a fight; travel (riding a
// mount, in a vehicle, on a flight); moving.
public enum Occasion implements Plain { Combat = "combat", Travel = "travel", Moving = "moving" }

// What the player did with a window, kept in the active profile (`ModuleMemory`): its place and its
// body's size, full screen or not, the tab last open, and the width the side section was dragged to (0: the width
// the side is given); and what the player chose on its settings page («Окна»): whether any of that is kept
// (`remember`; off, the window opens as it is declared), the tab it opens on (`openOn`: 0, the one last open), what
// hides it (`hideDuring`) and, of that, after which it shows again (`showAfter`; a window hidden by anything else is
// closed). The defaults are the window's declaration's (`KeptWindow`): hidden in a fight, never shown again by itself.
public struct WindowView implements Plain {
  x: Number<Length> = 0ui
  y: Number<Length> = 0ui
  width: Number<Length> = 0ui
  height: Number<Length> = 0ui
  full: Boolean = false
  tab: Integer = 1
  side: Number<Length> = 0ui
  remember: Boolean = true
  openOn: Integer = 0
  hideDuring: Array<Occasion> = [Occasion.Combat]
  showAfter: Array<Occasion> = []
}

// One of a module's windows, declared once in its root: its name (what it is kept under), its title on the
// settings' «Окна» page, and where it opens and whether full screen until the player changes it. What the player
// does with it is its `memory`, the profile's; `placing` is where it stands now. The `Window` drawn for it and its
// settings page (`WindowsPage`) both read and write this one: they can't disagree.
public class KeptWindow {
  public const title: String
  public const defaults: WindowView
  public memory: mut ModuleMemory<WindowView>
  public state placing: mut Placing
  // The window's tabs' titles, as it last drew them: the settings page offers each as the tab to open on.
  public state tabs: Array<String> = []
  // The tab its owner asks for (the game's own window opened on a page), until the window turns to it: it opens on
  // that one, over the one kept and the one fixed on its settings page, and keeps it as the one last open.
  public state asked: Integer | nil = nil

  constructor(name: String, title: String, placing: Placing, full: Boolean = false) {
    self.title = title
    self.placing = placing.clone()
    self.defaults = {
      x: placing.x, y: placing.y, width: placing.width, height: placing.height, full: full, tab: 1, side: 0ui,
      remember: true, openOn: 0, hideDuring: [Occasion.Combat], showAfter: []
    }
    self.memory = new ModuleMemory<WindowView>(self.defaults, .Profile, "window:" + name)
  }

  // What the window is to be: the kept view, or, where nothing is to be kept, the declaration's with the page's
  // choices.
  public used(self, view: WindowView): WindowView {
    if (view.remember) { return view }
    const declared = self.defaults.clone()
    declared.remember = false
    declared.openOn = view.openOn
    declared.hideDuring = view.hideDuring.clone()
    declared.showAfter = view.showAfter.clone()
    return declared
  }

  // Its owner asks for a tab: the window turns to it now, or opens on it.
  public ask(mut self, tab: Integer) { self.asked = tab }
}

// While a shown window asks for it, the player's situation follows what it doesn't follow otherwise (a mount,
// moving): heeded as it is made, let go as it ends (`Game.situation.heed`).
class Heeding {
  const what: Game.Heeded
  constructor(what: Game.Heeded) {
    self.what = what
    Game.situation.heed(what)
  }
  destructor() { Game.situation.unheed(self.what) }
}

// Whether a list of occasions holds one.
function holds(list: Array<Occasion>, occasion: Occasion): Boolean {
  return list.any((each: Occasion) => each == occasion)
}
// How far the side section's line is dragged: from two thirds of the width it is given to twice it.
const SIDE_LEAST = 2 / 3
const SIDE_MOST = 2
// How wide the side's line takes the cursor to drag it.
const SIDE_HANDLE = 9.375dp

// The tab row above the body: taller when a tab has a second line.
const TAB = 42.1875dp
const TAB_DESC = 58.59375dp
const TITLE_OPEN: Color = Color.hex("#ffd100")
// A closed tab's title: the look's dim ink.
const TITLE_CLOSED: Color = Color.hex("#a3977f")
const DESC: Color = Color.hex("#8f8470")
// A closed tab's wood and picture: half as bright.
const SHADE: Color = Color.hex("#808080")
const WHITE: Color = Color.hex("#ffffff")
const SHADOW: Shadow = { color: Color.hex("#000000cc"), x: 1.171875dp, y: -1.171875dp }
const LABEL_PAD = 3sp
// The least a tab is wide at its line: its art reaches past that on both sides.
const TAB_LEAST = 140.625dp
// The body's wood inside the metal, and the room each of its sections keeps: `WINDOW_ROOM` from the line on every
// side, more than any gap inside; with a footer, the footer stands on the bottom line, 5sp above it, and keeps 6sp
// from the content over it.
const INSET = 1sp
const PADDING: Edges = { top: WINDOW_ROOM, right: WINDOW_ROOM, bottom: WINDOW_ROOM, left: WINDOW_ROOM }
const PADDING_FOOTED: Edges = { top: 8sp, right: 8sp, bottom: 5sp, left: 8sp }
const FOOTER_PAD: Edges = { top: 6sp }
// The control group at the tab row's right end (the design's `CTRLS`): its controls from its left, each one kind of
// plate with its glyph; how high it is with its rim.
public enum CornerControl { Settings = "settings", Full = "full", Close = "close" }
const CORNER_HEIGHT = 37.5dp
// How far below the body's top the group's foot stands: the middle of the frame's line.
const CORNER_FOOT = 3.515625dp
// A plate's width; the group's rim on its left, top and right, with its shadow beside it (the first's left, the
// last's right) and above it: a plate stands that far below the group's top.
const PLATE = 35.15625dp
const RIM = 3.515625dp
const ABOVE = 5.859375dp
// A plate's art and its glyph's cell: the glyph stands where the design centres it on the plate (one after
// another has its divider in its width, so its glyph stands half a pixel further right).
const PLATE_ART = 75dp
const GLYPH = 18.75dp
const GLYPH_TOP: Number<Length> = ABOVE + 7.6171875dp
const GLYPH_LEFT_FIRST: Number<Length> = RIM + 8.203125dp
const GLYPH_LEFT = 8.7890625dp
// The controls of a window's group, from its left.
public const function cornerControls(withSettings: Boolean): Array<CornerControl> {
  return withSettings ? [.Settings, .Full, .Close] : [.Full, .Close]
}
// The width of the `index`th of `count` plates: the first and the last with the group's rim.
const function plateWidth(index: Integer, count: Integer): Number<Length> {
  const left: Number<Length> = index == 1 ? RIM : 0ui
  const right: Number<Length> = index == count ? RIM : 0ui
  return left + PLATE + right
}
// How far the `index`th plate stands from the group's left.
const function plateLeft(index: Integer, count: Integer): Number<Length> {
  let left: Number<Length> = 0ui
  for (i of 1..index - 1) { left += plateWidth(i, count) }
  return left
}
// The main section's content takes what its footer's row leaves; the body's one row is as high as the body.
const MAIN_ROWS: Array<Track> = [{ fr: 1 }, "max-content"]
const BODY_ROWS: Array<Track> = [{ fr: 1 }]
const ONE: Array<Track> = [{ fr: 1 }]
// The tab row: the tabs, and the control group at its right end.
const ROW: Array<Track> = [{ fr: 1 }, "max-content"]

// A window's side section: a column at the body's right, running from its top line to its bottom one, the frame's
// line between it and the main section (as the trainer's card beside its list). It shares neither the main section's
// head nor its footer: it lays out its own top and bottom.
public struct WindowSide {
  // How wide its content is: the section adds its room on both sides and the frame's line.
  width: Number<Length>
  content: Template
}
// The smallest body unless the window names one: room for the tab row and a few lines.
const MIN_W = 375dp
const MIN_H = 234.375dp
// The body stands over the tabs' feet.
const BODY_LEVEL = 5

// One of a window's tabs, framed with the body's own metal, its top corners rounded, its foot behind the body's top
// line. Open or closed, a tab is drawn the same but for its colours: a closed one darker, its title dim.
public class WindowTab implements Component {
  public grab: Event<nil> = new Event()
  public move: Event<Event.Drag> = new Event()
  public drop: Event<nil> = new Event()
  // The tab was clicked: its place among the tabs. Heard in the click's own call, where the client takes what
  // it takes from nothing but a click (opening a profession).
  public picked: Event<Integer> = new Event()

  derived open: Boolean = self.selected == self.index
  // The frame's measures at its scale: its art above its line, how far its foot stands behind the body's line,
  // where its line starts.
  derived reachTop: Number<Length> = Ordaen.art.frame.tab.reach.top * Ordaen.art.frame.tab.scale * 1ui
  derived flare: Number<Length> = Ordaen.art.frame.tab.curves.flare * Ordaen.art.frame.tab.scale * 1ui
  derived lineStart: Number<Length> = Ordaen.art.frame.tab.lineStart * Ordaen.art.frame.tab.scale * 1ui
  // How high the tab is below its line, where what it places by offsets starts.
  derived given: Number<Length> = self.height - self.reachTop
  // Its width: never under the least at its line, with the art past the line on both sides (a border's room is in the
  // box's size).
  derived bounds: Bounds = { min: TAB_LEAST + reachAcross(Ordaen.art.frame.tab), max: nil }
  // Open or closed only its colours differ: its wood and picture lighter, its title gold.
  derived tint: Color = self.open ? WHITE : SHADE
  derived titleColor: Color = self.open ? TITLE_OPEN : TITLE_CLOSED
  derived hasIcon: Boolean = self.tab.icon != nil || self.tab.portrait != nil
  derived hasDesc: Boolean = self.tab.desc != nil
  derived icon: Art | nil = self.tab.icon
  derived portrait: String | nil = self.tab.portrait
  derived desc: String = self.tab.desc ?? ""

  // The picture is a square at the tab's left end, as tall as what shows of the tab: from the tab's own line
  // down to the body's line, which the tab stands behind. Everything here is measured from the tab's line, where
  // what a framed box places by offsets starts. Its line stands at its right.
  derived side: Number<Length> = self.height - self.flare
  derived lineLeft: Number<Length> = self.side - self.lineStart
  derived lineWidth: Number<Length> = self.flare + 1ui
  // The label's room: past the picture's line where there is a picture.
  derived padding: Edges = self.paddingOf()

  tab: Signal<WindowTabSpec>
  const index: Integer
  selected: Signal<Integer>
  height: Signal<Number<Length>>
  constructor(
    tab: Signal<WindowTabSpec>,
    index: Integer,
    selected: Signal<Integer>,
    // The tab's height: from the window's top to the inner side of the body's top line.
    height: Signal<Number<Length>>
  ) {
    self.tab = tab
    self.index = index
    self.selected = selected
    self.height = height
  }

  // The tab's foot stands behind the body's line: its label keeps to what shows of it.
  paddingOf(self): Edges {
    let foot = Ordaen.spacingOf(self.flare - self.reachTop)
    if (!self.hasIcon) { return { left: LABEL_PAD, right: LABEL_PAD, bottom: foot } }
    let line = Ordaen.art.frame.tabIconLine
    let frame = Ordaen.art.frame.tab
    let lineEnd = (line.width + line.reach.left * line.scale) * 1ui
    let frameEnd = (frame.width + frame.reach.left * frame.scale) * 1ui
    let left = Ordaen.spacingOf(self.side + lineEnd - frameEnd) + LABEL_PAD
    return { left: left, right: LABEL_PAD, bottom: foot }
  }

  pick(mut self) {
    self.picked.emit(self.index)
  }
  onGrab(mut self) { self.grab.emit() }
  onMove(mut self, drag: Event.Drag) { self.move.emit(drag) }
  onDrop(mut self) { self.drop.emit() }

  public render(self): Template {
    return $ltml {
      <box width={self.bounds} height={self.height} border={Ordaen.art.frame.tab} background={Ordaen.art.window.wood}
           tint={self.tint} padding={self.padding} rows={BODY_ROWS} @pointerPress={self.pick} @keyPress(.Enter)={self.pick} @keyPress(.Space)={self.pick}
           @dragStart={self.onGrab} @drag={self.onMove} @dragStop={self.onDrop}>
        <$if={self.hasIcon}>
          <box position={Position.Absolute} left={0ui} top={0ui} width={self.side} height={self.side}
               icon={self.icon} portrait={self.portrait} tint={self.tint} border={Ordaen.art.frame.tabIconClip} />
          <box position={Position.Absolute} left={self.lineLeft} top={0ui} width={self.lineWidth}
               height={self.given} border={Ordaen.art.frame.tabIconLine} />
        </>
        <box xAlign={Align.Center} yAlign={Align.Center} gap={0.5sp}>
          <text value={self.tab.title} wrap={false} textColor={self.titleColor}
                textShadow={SHADOW} />
          <text $if={self.hasDesc} value={self.desc} textSize={SECONDARY_TEXT} wrap={false} textColor={DESC}
                textShadow={SHADOW} />
        </box>
      </box>
    }
  }
}

// One control of the window's group: a plate (close's red, the others' bronze: the first of the group, one after
// another or the last), with its glyph on it. It takes the mouse over its own part of the group and no further: its
// art is wider than its box, and two boxes that take the mouse never overlap.
class CornerPlate implements Component {
  // The plate was clicked: heard in the click's own call.
  public pressed: Event<CornerControl> = new Event()

  derived plate: Art = self.plateOf()
  derived glyph: Art = self.glyphOf()

  control: Signal<CornerControl>
  const index: Integer
  const count: Integer
  const left: Number<Length>
  const width: Number<Length>
  const glyphLeft: Number<Length>
  full: Signal<Boolean>
  constructor(control: Signal<CornerControl>, index: Integer, count: Integer, full: Signal<Boolean>) {
    self.control = control
    self.index = index
    self.count = count
    self.full = full
    self.left = plateLeft(index, count)
    self.width = plateWidth(index, count)
    self.glyphLeft = index == 1 ? GLYPH_LEFT_FIRST : GLYPH_LEFT
  }

  plateOf(self): Art {
    const plates = Ordaen.art.ctl.corner
    if (self.control == .Close) { return plates.red }
    if (self.index == 1) { return plates.bronze.first }
    return self.index == self.count ? plates.bronze.last : plates.bronze.next
  }

  glyphOf(self): Art {
    return match (self.control) {
      .Settings => Ordaen.art.ctl.corner.gear
      .Full => self.full ? Ordaen.art.ctl.corner.contract : Ordaen.art.ctl.corner.expand
      .Close => Ordaen.art.ctl.corner.close
    }
  }

  press(mut self) { self.pressed.emit(self.control) }

  public render(self): Template {
    return $ltml {
      <box position={Position.Absolute} left={self.left} top={0ui} width={self.width} height={CORNER_HEIGHT}
           overflow={Overflow.Hidden} @pointerPress={self.press} @keyPress(.Enter)={self.press} @keyPress(.Space)={self.press}>
        // The plate and its glyph show the control's interaction state: the plate's art is wider than the control.
        <box position={Position.Absolute} left={0ui} top={0ui} width={PLATE_ART} height={CORNER_HEIGHT}
             background={self.plate} interactionState={self.$interactionState} />
        // Over the plate by a level: at one level the client draws either on top, and a frame the renderer's pool
        // gives back may come under the plate.
        <box position={Position.Absolute} left={self.glyphLeft} top={GLYPH_TOP} width={GLYPH} height={GLYPH}
             background={self.glyph} zLevel={1} interactionState={self.$interactionState} />
      </box>
    }
  }
}

public class Window implements Component {
  // The close button, and Escape.
  public close: Event<nil> = new Event()
  // The settings button was clicked (a window made `withSettings`): the owner opens its settings.
  public settings: Event<nil> = new Event()
  // A tab was clicked: its place among the tabs, in the click's own call.
  public picked: Event<Integer> = new Event()

  state full: Boolean
  // Where the window and its body were when a drag began.
  x0: Number<Length> = 0ui
  y0: Number<Length> = 0ui
  w0: Number<Length> = 0ui
  h0: Number<Length> = 0ui
  // The least body the content leaves room for, as the grip's drag began: the grip stops there.
  leastW: Number<Length> = 0ui
  leastH: Number<Length> = 0ui

  // The tab row's height: the design's, from a tab's own line down to the body, and the tab's art above its line.
  derived tabHeight: Number<Length> = self.tabHeightOf() + Ordaen.art.frame.tab.reach.top * Ordaen.art.frame.tab.scale * 1ui
  // A tab's height: down to the inner side of the body's top line, which stands over its foot.
  derived lineTop: Number<Length> = Ordaen.art.frame.tab.curves.flare * Ordaen.art.frame.tab.scale * 1ui
  derived tabWhole: Number<Length> = self.tabHeight + self.lineTop
  derived columns: Array<Track> = self.tabColumns()
  derived place: Place = self.placeOf()
  // The main section keeps the width the player gave it: a side section widens the window by its own column.
  derived width: Number<Length> | nil = self.full ? nil : self.declared.placing.width + self.sideWide
  derived bounds: Bounds = { min: self.width, max: nil }
  derived sideWide: Number<Length> = self.sideWideOf()
  derived height: Number<Length> | nil = self.full || self.docked != nil ? nil : self.tabHeight + self.declared.placing.height
  // Moved by a tab and resized by its grip: neither full screen nor docked.
  derived free: Boolean = !self.full && self.docked == nil
  // The screen's right side kept clear while full screen.
  derived inset: Number<Length> = self.full ? self.room : 0ui
  // The tab row ends where the body does: short of that side while full screen.
  derived rowPad: Edges = { right: Ordaen.spacingOf(self.inset) }
  // The control group's foot stands on the top of the body's line, as the tabs' sides meet it. The body is placed
  // by its art's top: its line stands the art's reach below that, and the line's metal starts the frame's inset
  // outside it. The group is drawn over the body: the frame's art above its line, its dark edge and shadow, would
  // otherwise cover the plates' foot.
  derived cornerFoot: Edges = {
    bottom: Ordaen.spacingOf(self.lineTop - (self.bodyReach + Ordaen.art.frame.small.inset) * 1ui)
  }
  derived bodyReach: Number = Ordaen.art.frame.small.reach.top * Ordaen.art.frame.small.scale
  derived grip: ByInteractionState<Art> = self.gripOf()

  tabs: Signal<Array<WindowTabSpec>>
  selected: mut Signal<Integer>
  minWidth: Signal<Number<Length>>
  const minHeight: Number<Length>
  const maxWidth: Number<Length> | nil
  const maxHeight: Number<Length> | nil
  // The corner group's controls from its left, and its width.
  const controls: Array<CornerControl>
  const cornerWidth: Number<Length>
  shown: Signal<Boolean>
  // The footer row, and the body's room with it or without.
  const footer: Template
  const footed: Boolean
  const padding: Edges
  // The side section while there is one (it may come and go: a row picked), and the body's columns with it or without.
  side: Signal<WindowSide | nil>
  derived sided: Boolean = self.side != nil
  derived sideContent: Template = self.side?.content ?? self.nothing
  // The side's content's width: the one the player dragged it to, or the one it is given.
  derived sideWidth: Number<Length> = self.sideWidthOf()
  derived bodyColumns: Array<Track> = self.columnsOf()
  const nothing: Template = $ltml {}
  const docked: Side | nil
  const asks: Boolean
  room: Signal<Number<Length>>
  // Its declaration: where it stands, and what the player did with it, kept in the active profile.
  declared: mut KeptWindow
  // What this window kept last: a change of the memory that is not its own (a switch of profile, its settings
  // page) is taken whole, the tab with it.
  written: WindowView | nil = nil
  // Whether what is kept was taken once: the first time, as the window is made.
  made = false
  // The side's width as a drag of its line began, and while it is dragged (0 otherwise): kept as the drag ends.
  side0: Number<Length> = 0ui
  state sideDrag: Number<Length> = 0ui
  // What hid the window while it is shown, each to show it again as it ends (none: it shows); what the player is in
  // the middle of now, while it is shown; and what it was at the last change.
  state away: Array<Occasion> = []
  derived occasions: Array<Occasion> = self.occasionsOf()
  derived seen: Boolean = self.shown && self.away.length == 0
  was: Array<Occasion> = []
  opened = false
  // Turned to a tab its owner asked for, since it was last shown: what is kept and fixed is let be.
  wasAsked = false
  constructor(
    tabs: Signal<Array<WindowTabSpec>>,
    selected: mut Signal<Integer>,
    // The window as its module declares it (`KeptWindow`): where it stands and what is kept of it.
    declared: mut KeptWindow,
    // Follows what it is given: a least width worked out from `sp` changes with the density.
    minWidth: Signal<Number<Length>> = MIN_W,
    minHeight: Number<Length> = MIN_H,
    maxWidth: Number<Length> | nil = nil,
    maxHeight: Number<Length> | nil = nil,
    // A settings plate first in the corner's group, before full screen and close.
    withSettings: Boolean = false,
    // Hidden, it stays drawn: a window opened often is shown again at the cost of a surface shown, not of being
    // drawn anew (`$if` on it builds it at each open).
    shown: Signal<Boolean> = true,
    // Stands along this side of the screen, its whole length.
    docked: Side | nil = nil,
    // The width kept clear at the screen's right side while full screen: the windows docked there.
    room: Signal<Number<Length>> = 0ui,
    // The footer row's groups on the body's bottom line: none where it is left out.
    footer: Template | nil = nil,
    // The side section at the body's right, the full height beside the main one: none where it is left out.
    side: Signal<WindowSide | nil> = nil,
    // A tab's click only asks (`@picked`): the picked tab is what `selected` says, which follows what the window
    // shows (the profession the game has open), and the click doesn't write it.
    asks: Boolean = false
  ) {
    self.asks = asks
    self.footer = footer ?? $ltml {}
    self.footed = footer != nil
    self.padding = footer != nil ? PADDING_FOOTED : PADDING
    self.side = side
    self.full = declared.defaults.full
    self.docked = docked
    self.room = room
    self.controls = cornerControls(withSettings)
    self.cornerWidth = plateLeft(self.controls.length + 1, self.controls.length)
    self.shown = shown
    self.tabs = tabs
    self.selected = selected
    self.declared = declared
    self.minWidth = minWidth
    self.minHeight = minHeight
    self.maxWidth = maxWidth
    self.maxHeight = maxHeight
    // Its tabs' titles, for its settings page.
    watch (list of self.tabs) { self.declared.tabs = list.map((tab: WindowTabSpec) => tab.title) }
    // What is kept becomes the window's, as it is made, at a switch of profile and as its settings page changes it.
    watch (view of self.declared.memory.values) { self.recall(view) }
    // A tab its owner asks for is turned to, as the window is made or while it is up; it holds over the one fixed on
    // the settings page until the window is hidden.
    watch (tab of self.declared.asked) {
      if (tab == nil) { return }
      self.declared.asked = nil
      if (tab < 1 || tab > (peek self.tabs).length) { return }
      self.wasAsked = true
      self.selected = tab
    }
    // Shown, it opens on the tab asked for, else the tab the player fixed, where there is one; otherwise on the one
    // its owner holds (the last one open this session).
    watch (open of self.shown) {
      if (open) {
        self.openTab(true, false)
      } else {
        self.wasAsked = false
      }
    }
    // A tab picked is kept; a window that only asks shows the game's tab, which isn't the player's to keep.
    if (!asks) {
      watch (tab of self.selected) { self.remember((view: mut WindowView) => { view.tab = tab }) }
    }
    // Shown, it follows what it is to hide for, and what may show it again: a mount and moving are heard only then.
    watch {
      if (!self.shown) { return }
      const view = self.declared.used(self.declared.memory.values)
      const asked = self.away.length > 0 ? view.showAfter : view.hideDuring
      if (holds(asked, .Travel)) { self.heed(new Heeding(.Mount)) }
      if (holds(asked, .Moving)) { self.heed(new Heeding(.Moving)) }
    }
    watch { self.follow(self.occasions, self.shown) }
  }

  // What a watch's run made is the run's: it ends before the next run, and with the window.
  heed(self, heeding: Heeding) {}

  // What the player is in the middle of, of what can hide a window: read while the window is shown alone.
  occasionsOf(self): Array<Occasion> {
    const list: Array<Occasion> = []
    if (!self.shown) { return list }
    const situation = Game.situation
    if (situation.combat) { list.push(.Combat) }
    if (situation.taxi || situation.vehicle || situation.mounted) { list.push(.Travel) }
    if (situation.moving) { list.push(.Moving) }
    return list
  }

  // What began hides the window where the player chose so: until it ends, where it is to show again after it;
  // closed otherwise, as the player closes it. What ended shows it again, once nothing else holds it hidden. A window
  // the player opens in the middle of something stays: what goes on as it opens hides it not.
  follow(mut self, now: Array<Occasion>, shown: Boolean) {
    const was = self.was
    self.was = now
    if (!shown) {
      self.opened = false
      if ((peek self.away).length > 0) { self.away = [] }
      return
    }
    if (!self.opened) {
      self.opened = true
      return
    }
    const view = self.declared.used(peek self.declared.memory.values)
    const away = (peek self.away).filter((each: Occasion) => holds(now, each))
    for (occasion of now) {
      if (!holds(was, occasion) && holds(view.hideDuring, occasion)) {
        if (!holds(view.showAfter, occasion)) {
          self.away = []
          self.close.emit()
          return
        }
        if (!holds(away, occasion)) { away.push(occasion) }
      }
    }
    if (!away.equal(peek self.away)) { self.away = away }
  }

  // The tab it opens on: the one fixed on its settings page, or (as it is made, or its memory is changed from
  // elsewhere) the one last open.
  openTab(mut self, showing: Boolean, first: Boolean) {
    if (self.asks || self.wasAsked) { return }
    const view = self.declared.used(peek self.declared.memory.values)
    if (showing && view.openOn == 0) { return }
    // Made with no tab ever picked, it leaves the one its owner holds (an action may have asked for another before
    // the window was made).
    if (first && view.openOn == 0 && view.tab == self.declared.defaults.tab) { return }
    const tab = view.openOn > 0 ? view.openOn : view.tab
    if (tab >= 1 && tab <= (peek self.tabs).length) { self.selected = tab }
  }

  // What is kept becomes the window's: a size outside the window's own bounds (kept on a larger screen, or before
  // they changed) is held to them, its top left corner where it was; below what its content needs the renderer
  // raises it (`Room`'s least size), and the grip starts from there.
  recall(mut self, view: WindowView) {
    const written = self.written
    const own = written != nil && written.equal(view)
    const used = self.declared.used(view)
    let width = self.minWidth.max(used.width)
    let height = self.minHeight.max(used.height)
    if (self.maxWidth != nil) { width = self.maxWidth.min(width) }
    if (self.maxHeight != nil) { height = self.maxHeight.min(height) }
    self.declared.placing = {
      x: used.x + (width - used.width) / 2, y: used.y + (height - used.height) / 2, width: width, height: height
    }
    self.full = used.full
    if (!own) { self.openTab(false, !self.made) }
    self.made = true
  }

  // A change to what is kept, every entry at once; nothing is kept while the player chose so on its settings page.
  remember(mut self, change: (view: mut WindowView) => nil) {
    const view = (peek self.declared.memory.values).clone()
    if (!view.remember) { return }
    change(mut view)
    self.written = view.clone()
    self.declared.memory.write(view)
  }

  // Where the window is now, kept: a drag of a tab or of the grip ended.
  onSettle(mut self) {
    const at = peek self.declared.placing
    self.remember((view: mut WindowView) => {
      view.x = at.x
      view.y = at.y
      view.width = at.width
      view.height = at.height
    })
  }

  sideWidthOf(self): Number<Length> {
    const side = self.side
    if (side == nil) { return 0ui }
    const dragged = self.sideDrag > 0ui ? self.sideDrag : self.declared.used(self.declared.memory.values).side
    if (dragged <= 0ui) { return side.width }
    return (side.width * SIDE_LEAST).max((side.width * SIDE_MOST).min(dragged))
  }

  columnsOf(self): Array<Track> {
    if (self.side == nil) { return ONE }
    return [{ fr: 1 }, self.sideWide]
  }

  // The side section's column: its content, its room on both sides and the frame's line; none without one.
  sideWideOf(self): Number<Length> {
    const side = self.side
    if (side == nil) { return 0ui }
    const line = Ordaen.art.frame.tabIconLine
    return self.sideWidth + Ordaen.lengthOf(2 * WINDOW_ROOM) + (line.width + line.reach.left * line.scale) * 1ui
  }

  tabHeightOf(self): Number<Length> {
    for (tab of self.tabs) {
      if (tab.desc != nil) { return TAB_DESC }
    }
    return TAB
  }

  tabColumns(self): Array<Track> {
    let list: Array<Track> = []
    for (tab of self.tabs) { list.push("max-content") }
    return list
  }

  // Placed by its top left corner from the screen's centre: a resize moves the centre by half the change, so the
  // corner stays exactly where it is.
  placeOf(self): Place {
    if (self.full) { return "fill" }
    const side = self.docked
    if (side != nil) { return Docked { side: side, whole: true } }
    return {
      point: Point.TopLeft, to: Point.Center,
      x: self.declared.placing.x - self.declared.placing.width / 2,
      y: self.declared.placing.y - (self.tabHeight + self.declared.placing.height) / 2
    }
  }

  gripOf(self): ByInteractionState<Art> {
    return { default: Ordaen.art.ctl.grip, hover: Ordaen.art.ctl.gripHover, pressed: Ordaen.art.ctl.gripDown }
  }

  toggleFull(mut self) {
    const full = !self.full
    self.full = full
    self.remember((view: mut WindowView) => { view.full = full })
  }
  onPicked(mut self, index: Integer) {
    if (!self.asks) { self.selected = index }
    self.picked.emit(index)
  }
  onClose(mut self) { self.close.emit() }
  onCorner(mut self, control: CornerControl) {
    match (control) {
      .Settings => self.settings.emit()
      .Full => self.toggleFull()
      .Close => self.close.emit()
    }
  }

  onGrab(mut self) {
    self.x0 = (peek self.declared.placing).x
    self.y0 = (peek self.declared.placing).y
    self.w0 = (peek self.declared.placing).width
    self.h0 = (peek self.declared.placing).height
  }

  // A tab dragged moves the window, as far as it stays on the screen. The tab row takes the mouse on its tabs alone:
  // the room right of them passes a click on to what shows there.
  onMove(mut self, drag: Event.Drag) {
    if (self.full || self.docked != nil) { return }
    const dx, dy = kept(drag, Hold.Move)
    self.declared.placing.x = self.x0 + dx
    self.declared.placing.y = self.y0 + dy
  }

  // The grip taken: the body is never sized below what its content needs (the surface's least size, its tab row
  // over the body taken off). A body kept smaller (from an older save, a larger screen) is drawn at that least, and
  // the drag starts from it, its top left corner where it is.
  onGrabSize(mut self, drag: Event.Drag) {
    self.onGrab()
    self.leastW = drag.room.leastWidth - peek self.sideWide
    self.leastH = drag.room.leastHeight - peek self.tabHeight
    if (self.w0 < self.leastW) {
      self.x0 += (self.leastW - self.w0) / 2
      self.w0 = self.leastW
    }
    if (self.h0 < self.leastH) {
      self.y0 += (self.leastH - self.h0) / 2
      self.h0 = self.leastH
    }
  }

  // The grip follows the cursor up to the screen's edges, and down to the content's least size. The window is placed
  // by its centre, so the centre moves half as far.
  onSize(mut self, drag: Event.Drag) {
    const dx, dy = kept(drag, Hold.Size)
    let width = self.minWidth.max(self.leastW).max(self.w0 + dx)
    let height = self.minHeight.max(self.leastH).max(self.h0 + dy)
    if (self.maxWidth != nil) { width = self.maxWidth.min(width) }
    if (self.maxHeight != nil) { height = self.maxHeight.min(height) }
    self.declared.placing.width = width
    self.declared.placing.height = height
    self.declared.placing.x = self.x0 + (width - self.w0) / 2
    self.declared.placing.y = self.y0 + (height - self.h0) / 2
  }

  // The side's line dragged left widens the side, right narrows it, within its bounds (`sideWidthOf`).
  // The main section keeps its width: the window's left side goes out as far as the side widens, so the line
  // follows the cursor; the window's place and the side's width are kept as the drag ends.
  onSideGrab(mut self) {
    self.side0 = peek self.sideWidth
    self.x0 = (peek self.declared.placing).x
  }
  onSide(mut self, drag: Event.Drag) {
    self.sideDrag = (self.side0 - drag.dx).max(1ui)
    self.declared.placing.x = self.x0 - (peek self.sideWidth - self.side0)
  }
  onSideSettle(mut self) {
    const width = peek self.sideWidth
    const x = (peek self.declared.placing).x
    self.sideDrag = 0ui
    self.remember((view: mut WindowView) => {
      view.side = width
      view.x = x
    })
  }

  public render(self): Template {
    return $ltml {
      // As wide as the player made it, and never narrower than its tab row (its tabs and its control group): the
      // row is the one thing in its grid, and the width it keeps is its least.
      <surface lineHeight={BODY_LINE} shown={self.seen} layer={Layer.Dialog} place={self.place} width={self.bounds} height={self.height} clamp={true}
               raise={true}
               @keyPress.parentScope(.Escape)={self.onClose}>
        <box position={Position.Absolute} left={0ui} right={self.inset} top={self.tabHeight} bottom={0ui}
             border={Ordaen.art.frame.small} background={Ordaen.art.window.wood} padding={INSET}
             columns={self.bodyColumns} rows={BODY_ROWS} zLevel={BODY_LEVEL}>
          <box rows={MAIN_ROWS} padding={self.padding}>
            <slot />
            <box $if={self.footed} padding={FOOTER_PAD}>
              {self.footer}
            </box>
          </box>
          <box $if={self.sided} border={Ordaen.art.frame.tabIconLine} rows={ONE} padding={self.padding}>
            {self.sideContent}
            <box position={Position.Absolute} left={0ui} top={0ui} bottom={0ui} width={SIDE_HANDLE}
                 @dragStart={self.onSideGrab} @drag={self.onSide} @dragStop={self.onSideSettle} />
          </box>
          <box $if={self.free} position={Position.Absolute} right={2.34375dp} bottom={2.34375dp} width={18.75dp}
               height={18.75dp} background={self.grip} @dragStart={self.onGrabSize} @drag={self.onSize}
               @dragStop={self.onSettle} />
        </box>
        // The tab row: the tabs from the left, the control group at the right, standing on the body's top line as the
        // tabs do. The row is the surface's least width: the window is never narrower than its tabs and its controls.
        <box columns={ROW} gap={3sp} padding={self.rowPad} yAlign={Align.End}>
          <box columns={self.columns} gap={3.5sp} yAlign={Align.End}>
            <WindowTab $for={index, tab of self.tabs} tab={tab} index={index} selected={self.selected}
                       height={self.tabWhole} @grab={self.onGrab} @move={self.onMove} @drop={self.onSettle}
                       @picked={self.onPicked} />
          </box>
          <box padding={self.cornerFoot} zLevel={BODY_LEVEL + 1}>
            <box width={self.cornerWidth} height={CORNER_HEIGHT} overflow={Overflow.Hidden}>
              <CornerPlate $for={index, control of self.controls} control={control} index={index}
                           count={self.controls.length} full={self.full} @pressed={self.onCorner} />
            </box>
          </box>
        </box>
      </surface>
    }
  }
}
