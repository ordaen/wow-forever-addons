// Window: a window whose open tab is its title. The small metal frame round its body, the windows' wood, its tabs
// standing on the body's top line from its left, the open one over the body and the closed ones behind it. Centred
// on the screen at first; dragging a tab moves it, Escape closes it, the grip in its bottom right corner
// resizes it with its top left corner staying where it is. In the body's top right corner, while the cursor is over
// the window: one group of plates, settings where the window is made `withSettings` (its `settings` event), full
// screen (and back) and close. Its unnamed slot takes the body's content, which fills the body. Its `footer`, where
// it is given one, is the footer row: the window's action groups, its secondary actions and what isn't important
// (counts, how long ago, in small dim text) standing on the body's bottom line under the content; the template lays
// its groups out with the ladder's steps. Its `side`, where it is given one, is a section of its own at the body's
// right, the full height beside the main one. A window made `full` opens full screen; full screen, it keeps `room`
// clear at the screen's right side, where the windows docked there stand. A window made `docked` stands along that
// side of the screen from its top to its bottom, as wide as its placing says: it isn't moved or resized, and its
// full-screen toggle still covers the screen.
import { Align, Art, Docked, Drag, Edges, Layer, Line, Overflow, Place, Point, Position, Shadow, Side, Stated, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { Hold, kept } from "@/onScreen"
import { Memory } from "@/settings"
import { PX, space } from "@/units"

// One of a window's tabs: its name, a second line under it, a picture at its left end.
public struct WindowTabSpec {
  title: String
  desc: String | nil
  icon: Art | nil
}

// Where a window is: its centre from the screen's (y down), and its body's size. Its owner holds it, and the window
// keeps it in its memory.
public struct Placing implements Plain {
  x: Number
  y: Number
  width: Number
  height: Number
}

// What the player did with a window, kept in the active profile (`Memory`, `redesign/kept.md`): its place and its
// body's size, full screen or not, the tab last open, and the width the side section was dragged to (0: the width
// the side is given); and what the player chose on its settings page («Окна»): whether any of that is kept
// (`remember`; off, the window opens as it is declared), and the tab it opens on (`openOn`: 0, the one last open).
// The defaults are the window's declaration's (`KeptWindow`).
public struct WindowView implements Plain {
  x: Number = 0
  y: Number = 0
  width: Number = 0
  height: Number = 0
  full: Boolean = false
  tab: Integer = 1
  side: Number = 0
  remember: Boolean = true
  openOn: Integer = 0
}

// One of a module's windows, declared once in its root: its name (what it is kept under), its title on the
// settings' «Окна» page, and where it opens and whether full screen until the player changes it. What the player
// does with it is its `memory`, the profile's; `placing` is where it stands now. The `Window` drawn for it and its
// settings page (`WindowsPage`) both read and write this one: they can't disagree.
public class KeptWindow {
  public const title: String
  public const defaults: WindowView
  public memory: mut Memory<WindowView>
  public state placing: mut Placing
  // The window's tabs' titles, as it last drew them: the settings page offers each as the tab to open on.
  public state tabs: Array<String> = []

  constructor(name: String, title: String, placing: Placing, full: Boolean = false) {
    self.title = title
    self.placing = placing.clone()
    self.defaults = {
      x: placing.x, y: placing.y, width: placing.width, height: placing.height, full: full, tab: 1, side: 0,
      remember: true, openOn: 0,
    }
    self.memory = new Memory<WindowView>(self.defaults, .Profile, "window:" + name)
  }

  // What the window is to be: the kept view, or, where nothing is to be kept, the declaration's with the page's
  // choices.
  public used(self, view: WindowView): WindowView {
    if (view.remember) { return view }
    const declared = self.defaults.clone()
    declared.remember = false
    declared.openOn = view.openOn
    return declared
  }
}
// How far the side section's line is dragged: from two thirds of the width it is given to twice it.
const SIDE_LEAST = 2 / 3
const SIDE_MOST = 2
// How wide the side's line takes the cursor to drag it.
const SIDE_HANDLE = 8 * PX

// The tab row above the body: taller when a tab has a second line.
const TAB = 36 * PX
const TAB_DESC = 50 * PX
const TITLE_OPEN: Color = Color.hex("#ffd100")
const TITLE_CLOSED: Color = Color.hex("#b3a690")
const DESC: Color = Color.hex("#8f8470")
// A closed tab's wood and picture, darker.
const SHADE: Color = Color.hex("#999999")
const WHITE: Color = Color.hex("#ffffff")
const SHADOW: Shadow = { color: Color.hex("#000000cc"), x: 1 * PX, y: -1 * PX }
const LABEL_PAD = 10 * PX
const MIN_TAB = 120 * PX
// The body's wood inside the metal, and the room each of its sections keeps: the ladder's `Window` step from the line
// on every side; with a footer, the footer stands on the bottom line, the ladder's `Panel` step above it, and keeps a
// `Group` step from the content over it.
const INSET = 3 * PX
const ROOM: Number = space(.Window) + INSET
const PADDING: Edges = { top: space(.Window), right: space(.Window), bottom: space(.Window), left: space(.Window) }
const PADDING_FOOTED: Edges = { top: space(.Window), right: space(.Window), bottom: space(.Panel), left: space(.Window) }
const FOOTER_PAD: Edges = { top: space(.Group) }
// The corner's group in the body's top right (the design's `CTRLS`): its controls from its left, each one kind of
// plate with its glyph. How far from the body's line the group stands, and how high it is with its rim.
public enum CornerControl { Settings = "settings", Full = "full", Close = "close" }
const CORNER_TOP = 5.5 * PX
const CORNER_RIGHT = 5 * PX
const CORNER_HEIGHT = 32 * PX
// A plate's width; the first's rim and its shadow, left of its plate; the last is the design's 2 px wider, and the
// frame's line covers its right end, which the group's box leaves out.
const PLATE = 30 * PX
const RIM = 5 * PX
const LAST = (32 - 4) * PX
// A plate's art and its glyph's cell: the glyph stands where the design centres it on the plate (one after
// another has its divider in its width, so its glyph stands half a pixel further right).
const PLATE_ART = 64 * PX
const GLYPH = 16 * PX
const GLYPH_TOP = 6.5 * PX
const GLYPH_LEFT_FIRST = RIM + 7 * PX
const GLYPH_LEFT = 7.5 * PX
// The controls of a window's group, from its left.
public const function cornerControls(withSettings: Boolean): Array<CornerControl> {
  return withSettings ? [.Settings, .Full, .Close] : [.Full, .Close]
}
// The width of the `index`th of `count` plates: the first with the group's rim, the last as the frame leaves it.
const function plateWidth(index: Integer, count: Integer): Number {
  const plate = index == count ? LAST : PLATE
  return index == 1 ? RIM + plate : plate
}
// How far the `index`th plate stands from the group's left.
const function plateLeft(index: Integer, count: Integer): Number {
  let left: Number = 0
  for (i of 1..=index - 1) { left += plateWidth(i, count) }
  return left
}
// How much of the content's first row the corner's group takes, from its right end: what stands in that row at
// the right (a bar across the window) ends this much short, and the group never lies over it.
public const function cornerRoom(withSettings: Boolean): Number {
  const count = cornerControls(withSettings).length
  return CORNER_RIGHT + plateLeft(count + 1, count) + space(.Item) - ROOM
}
// The main section's content takes what its footer's row leaves; the body's one row is as high as the body.
const MAIN_ROWS: Array<Track> = [{ fr: 1 }, "auto"]
const BODY_ROWS: Array<Track> = [{ fr: 1 }]
const ONE: Array<Track> = [{ fr: 1 }]

// A window's side section: a column at the body's right, running from its top line to its bottom one, the frame's
// line between it and the main section (as the trainer's card beside its list). It shares neither the main section's
// head nor its footer: it lays out its own top and bottom.
public struct WindowSide {
  // How wide its content is: the section adds its room on both sides and the frame's line.
  width: Number
  content: Template
}
// The smallest body unless the window names one: room for the tab row and a few lines.
const MIN_W = 320 * PX
const MIN_H = 200 * PX
// The body stands over the tabs' feet.
const BODY_LEVEL = 5

// One of a window's tabs, framed with the body's own metal, its top corners rounded, its foot behind the body's top
// line. Open or closed, a tab is drawn the same but for its colours: a closed one darker, its title dim.
public class WindowTab implements Component {
  public grab: Event<nil> = new Event()
  public move: Event<Drag> = new Event()
  public drop: Event<nil> = new Event()
  // The tab was clicked: its place among the tabs. Heard in the click's own call, where the client takes what
  // it takes from nothing but a click (opening a profession).
  public picked: Event<Integer> = new Event()

  derived open: Boolean = self.selected == self.index
  // The frame's measures at its scale: its art above its line, how far its foot stands behind the body's line,
  // where its line starts.
  derived reachTop: Number = Ordaen.art.frame.tab.reach.top * Ordaen.art.frame.tab.scale
  derived flare: Number = Ordaen.art.frame.tab.curves.flare * Ordaen.art.frame.tab.scale
  derived lineStart: Number = Ordaen.art.frame.tab.lineStart * Ordaen.art.frame.tab.scale
  // The height the tab is given: a framed box grows by its art's reach.
  derived given: Number = self.height - self.reachTop
  // Open or closed only its colours differ: its wood and picture lighter, its title gold.
  derived tint: Color = self.open ? WHITE : SHADE
  derived titleColor: Color = self.open ? TITLE_OPEN : TITLE_CLOSED
  derived hasIcon: Boolean = self.tab.icon != nil
  derived hasDesc: Boolean = self.tab.desc != nil
  derived icon: Art | nil = self.tab.icon
  derived desc: String = self.tab.desc ?? ""

  // The picture is a square at the tab's left end, as tall as what shows of the tab: from the tab's own line
  // down to the body's line, which the tab stands behind. Everything here is measured from the tab's line, where
  // what a framed box places by offsets starts. Its line stands at its right.
  derived side: Number = self.height - self.flare
  derived lineLeft: Number = self.side - self.lineStart
  derived lineWidth: Number = self.flare - Ordaen.art.frame.tabIconLine.reach.left * Ordaen.art.frame.tabIconLine.scale + 1
  // The label's room: past the picture's line where there is a picture.
  derived padding: Edges = self.paddingOf()

  tab: Signal<WindowTabSpec>
  const index: Integer
  selected: Signal<Integer>
  height: Signal<Number>
  constructor(
    tab: Signal<WindowTabSpec>,
    index: Integer,
    selected: Signal<Integer>,
    // The tab's height: from the window's top to the inner side of the body's top line.
    height: Signal<Number>,
  ) {
    self.tab = tab
    self.index = index
    self.selected = selected
    self.height = height
  }

  // The tab's foot stands behind the body's line: its label keeps to what shows of it.
  paddingOf(self): Edges {
    let foot = self.flare - self.reachTop
    if (!self.hasIcon) { return { left: LABEL_PAD, right: LABEL_PAD, bottom: foot } }
    let line = Ordaen.art.frame.tabIconLine
    let frame = Ordaen.art.frame.tab
    let lineEnd = line.width + line.reach.left * line.scale
    let frameEnd = frame.width + frame.reach.left * frame.scale
    let left = self.side + lineEnd - frameEnd + LABEL_PAD
    return { left: left, right: LABEL_PAD, bottom: foot }
  }

  pick(mut self) {
    self.picked.emit(self.index)
  }
  onGrab(mut self) { self.grab.emit() }
  onMove(mut self, drag: Drag) { self.move.emit(drag) }
  onDrop(mut self) { self.drop.emit() }

  public render(self): Template {
    return $ltml {
      <box minWidth={MIN_TAB} height={self.given} border={Ordaen.art.frame.tab} background={Ordaen.art.window.wood}
           tint={self.tint} padding={self.padding} rows={BODY_ROWS} @click={self.pick}
           @dragStart={self.onGrab} @drag={self.onMove} @dragStop={self.onDrop}>
        <$if={self.hasIcon}>
          <box position={Position.Absolute} left={0} top={0} width={self.side} height={self.side}
               icon={self.icon} tint={self.tint} border={Ordaen.art.frame.tabIconClip} />
          <box position={Position.Absolute} left={self.lineLeft} top={0} width={self.lineWidth}
               height={self.given} border={Ordaen.art.frame.tabIconLine} />
        </>
        <box xAlign={Align.Center} yAlign={Align.Center} gap={1 * PX}>
          <text value={self.tab.title} wrap={false} textColor={self.titleColor}
                textShadow={SHADOW} />
          <text $if={self.hasDesc} value={self.desc} textSize={.Secondary} wrap={false} textColor={DESC}
                textShadow={SHADOW} />
        </box>
      </box>
    }
  }
}

// One control of the corner's group: a plate of its tone (close's red, the others' bronze), the first of the group
// or one after another, with its glyph on it. It takes the mouse over its own part of the group and no further:
// its art is wider than its box, and two boxes that take the mouse never overlap.
class CornerPlate implements Component {
  // The plate was clicked: heard in the click's own call.
  public pressed: Event<CornerControl> = new Event()

  derived plates = self.control == .Close ? Ordaen.art.ctl.corner.red : Ordaen.art.ctl.corner.bronze
  derived plate: Art = self.index == 1 ? self.plates.first : self.plates.next
  derived glyph: Art = self.glyphOf()

  control: Signal<CornerControl>
  const index: Integer
  const left: Number
  const width: Number
  const glyphLeft: Number
  full: Signal<Boolean>
  constructor(control: Signal<CornerControl>, index: Integer, count: Integer, full: Signal<Boolean>) {
    self.control = control
    self.index = index
    self.full = full
    self.left = plateLeft(index, count)
    self.width = plateWidth(index, count)
    self.glyphLeft = index == 1 ? GLYPH_LEFT_FIRST : GLYPH_LEFT
  }

  glyphOf(self): Art {
    return match (self.control) {
      .Settings => Ordaen.art.ctl.corner.gear,
      .Full => self.full ? Ordaen.art.ctl.corner.contract : Ordaen.art.ctl.corner.expand,
      .Close => Ordaen.art.ctl.corner.close,
    }
  }

  press(mut self) { self.pressed.emit(self.control) }

  public render(self): Template {
    return $ltml {
      <box position={Position.Absolute} left={self.left} top={0} width={self.width} height={CORNER_HEIGHT}
           overflow={Overflow.Hidden} @click={self.press}>
        <box position={Position.Absolute} left={0} top={0} width={PLATE_ART} height={CORNER_HEIGHT}
             background={self.plate} stateFromParent={true} />
        // Over the plate by a level: at one level the client draws either on top, and a frame the renderer's pool
        // gives back may come under the plate.
        <box position={Position.Absolute} left={self.glyphLeft} top={GLYPH_TOP} width={GLYPH} height={GLYPH}
             background={self.glyph} stateFromParent={true} zLevel={1} />
      </box>
    }
  }
}

public class Window implements Component {
  // The close button, and Escape.
  public close: Event<nil> = new Event()
  // The settings button was clicked (a window made `withSettings`): the owner opens its settings.
  public settings: Event<nil> = new Event()
  // A tab was clicked: its place among the tabs, in the click's own call.
  public picked: Event<Integer> = new Event()

  state full: Boolean
  state hovered = false
  // Where the window and its body were when a drag began.
  x0: Number = 0
  y0: Number = 0
  w0: Number = 0
  h0: Number = 0
  // The least body the content leaves room for, as the grip's drag began: the grip stops there.
  leastW: Number = 0
  leastH: Number = 0

  // The tab row's height: the design's, from a tab's own line down to the body, and the tab's art above its line.
  derived tabHeight: Number = self.tabHeightOf() + Ordaen.art.frame.tab.reach.top * Ordaen.art.frame.tab.scale
  // A tab's height: down to the inner side of the body's top line, which stands over its foot.
  derived lineTop: Number = Ordaen.art.frame.tab.curves.flare * Ordaen.art.frame.tab.scale
  derived tabWhole: Number = self.tabHeight + self.lineTop
  derived columns: Array<Track> = self.tabColumns()
  derived place: Place = self.placeOf()
  derived width: Number | nil = self.full ? nil : self.declared.placing.width
  derived height: Number | nil = self.full || self.docked != nil ? nil : self.tabHeight + self.declared.placing.height
  // Moved by a tab and resized by its grip: neither full screen nor docked.
  derived free: Boolean = !self.full && self.docked == nil
  // The screen's right side kept clear while full screen.
  derived inset: Number = self.full ? self.room : 0
  derived grip: Stated<Art> = self.gripOf()
  // The ring round the control the keyboard has focused: the look's accent.
  derived focusLine: Line = { width: 1 * PX, color: Ordaen.look.values.accent, sides: nil }

  tabs: Signal<Array<WindowTabSpec>>
  selected: mut Signal<Integer>
  const minWidth: Number
  const minHeight: Number
  const maxWidth: Number | nil
  const maxHeight: Number | nil
  // The corner group's controls from its left, and its width.
  const controls: Array<CornerControl>
  const cornerWidth: Number
  shown: Signal<Boolean>
  // The footer row, and the body's room with it or without.
  const footer: Template
  const footed: Boolean
  const padding: Edges
  // The side section while there is one (it may come and go: a row picked), and the body's columns with it or without.
  side: Signal<WindowSide | nil>
  derived sided: Boolean = self.side != nil
  derived sideContent: Template = self.side?.content ?? self.nothing
  // The side's content's width: the one the player dragged it to, or the one it is given.
  derived sideWidth: Number = self.sideWidthOf()
  derived bodyColumns: Array<Track> = self.columnsOf()
  const nothing: Template = $ltml {}
  const docked: Side | nil
  const asks: Boolean
  room: Signal<Number>
  // Its declaration: where it stands, and what the player did with it, kept in the active profile.
  declared: mut KeptWindow
  // What this window kept last: a change of the memory that is not its own (a switch of profile, its settings
  // page) is taken whole, the tab with it.
  written: WindowView | nil = nil
  // Whether what is kept was taken once: the first time, as the window is made.
  made = false
  // The side's width as a drag of its line began, and while it is dragged (0 otherwise): kept as the drag ends.
  side0: Number = 0
  state sideDrag: Number = 0
  constructor(
    tabs: Signal<Array<WindowTabSpec>>,
    selected: mut Signal<Integer>,
    // The window as its module declares it (`KeptWindow`): where it stands and what is kept of it.
    declared: mut KeptWindow,
    minWidth: Number = MIN_W,
    minHeight: Number = MIN_H,
    maxWidth: Number | nil = nil,
    maxHeight: Number | nil = nil,
    // A settings plate first in the corner's group, before full screen and close.
    withSettings: Boolean = false,
    // Hidden, it stays drawn: a window opened often is shown again at the cost of a surface shown, not of being
    // drawn anew (`$if` on it builds it at each open).
    shown: Signal<Boolean> = true,
    // Stands along this side of the screen, its whole length.
    docked: Side | nil = nil,
    // The width kept clear at the screen's right side while full screen: the windows docked there.
    room: Signal<Number> = 0,
    // The footer row's groups on the body's bottom line: none where it is left out.
    footer: Template | nil = nil,
    // The side section at the body's right, the full height beside the main one: none where it is left out.
    side: Signal<WindowSide | nil> = nil,
    // A tab's click only asks (`@picked`): the picked tab is what `selected` says, which follows what the window
    // shows (the profession the game has open), and the click doesn't write it.
    asks: Boolean = false,
  ) {
    self.asks = asks
    self.footer = footer ?? $ltml {}
    self.footed = footer != nil
    self.padding = footer != nil ? PADDING_FOOTED : PADDING
    self.side = side
    self.full = declared.defaults.full
    self.docked = docked
    self.room = room
    self.controls = cornerControls(withSettings)
    self.cornerWidth = plateLeft(self.controls.length + 1, self.controls.length)
    self.shown = shown
    self.tabs = tabs
    self.selected = selected
    self.declared = declared
    self.minWidth = minWidth
    self.minHeight = minHeight
    self.maxWidth = maxWidth
    self.maxHeight = maxHeight
    // Its tabs' titles, for its settings page.
    watch (list of self.tabs) { self.declared.tabs = list.map((tab: WindowTabSpec) => tab.title) }
    // What is kept becomes the window's, as it is made, at a switch of profile and as its settings page changes it.
    watch (view of self.declared.memory.values) { self.recall(view) }
    // Shown, it opens on the tab the player fixed, where there is one; otherwise on the one its owner says (the
    // last one open this session, or the one an action asks for).
    watch (open of self.shown) {
      if (open) { self.openTab(true, false) }
    }
    // A tab picked is kept; a window that only asks shows the game's tab, which isn't the player's to keep.
    if (!asks) {
      watch (tab of self.selected) { self.remember((view: mut WindowView) => { view.tab = tab }) }
    }
  }

  // The tab it opens on: the one fixed on its settings page, or (as it is made, or its memory is changed from
  // elsewhere) the one last open.
  openTab(mut self, showing: Boolean, first: Boolean) {
    if (self.asks) { return }
    const view = self.declared.used(peek self.declared.memory.values)
    if (showing && view.openOn == 0) { return }
    // Made with no tab ever picked, it leaves the one its owner holds (an action may have asked for another before
    // the window was made).
    if (first && view.openOn == 0 && view.tab == self.declared.defaults.tab) { return }
    const tab = view.openOn > 0 ? view.openOn : view.tab
    if (tab >= 1 && tab <= (peek self.tabs).length) { self.selected = tab }
  }

  // What is kept becomes the window's: a size outside the window's own bounds (kept on a larger screen, or before
  // they changed) is held to them, its top left corner where it was; below what its content needs the renderer
  // raises it (`Room`'s least size), and the grip starts from there.
  recall(mut self, view: WindowView) {
    const written = self.written
    const own = written != nil && written.equal(view)
    const used = self.declared.used(view)
    let width = self.minWidth.max(used.width)
    let height = self.minHeight.max(used.height)
    if (self.maxWidth != nil) { width = self.maxWidth.min(width) }
    if (self.maxHeight != nil) { height = self.maxHeight.min(height) }
    self.declared.placing = {
      x: used.x + (width - used.width) / 2, y: used.y + (height - used.height) / 2, width: width, height: height,
    }
    self.full = used.full
    if (!own) { self.openTab(false, !self.made) }
    self.made = true
  }

  // A change to what is kept, every entry at once; nothing is kept while the player chose so on its settings page.
  remember(mut self, change: (view: mut WindowView) => nil) {
    const view = (peek self.declared.memory.values).clone()
    if (!view.remember) { return }
    change(mut view)
    self.written = view.clone()
    self.declared.memory.write(view)
  }

  // Where the window is now, kept: a drag of a tab or of the grip ended.
  onSettle(mut self) {
    const at = peek self.declared.placing
    self.remember((view: mut WindowView) => {
      view.x = at.x
      view.y = at.y
      view.width = at.width
      view.height = at.height
    })
  }

  sideWidthOf(self): Number {
    const side = self.side
    if (side == nil) { return 0 }
    const dragged = self.sideDrag > 0 ? self.sideDrag : self.declared.used(self.declared.memory.values).side
    if (dragged <= 0) { return side.width }
    return (side.width * SIDE_LEAST).max((side.width * SIDE_MOST).min(dragged))
  }

  columnsOf(self): Array<Track> {
    if (self.side == nil) { return ONE }
    const line = Ordaen.art.frame.tabIconLine
    return [{ fr: 1 }, self.sideWidth + 2 * space(.Window) + line.width + line.reach.left * line.scale]
  }

  tabHeightOf(self): Number {
    for (tab of self.tabs) {
      if (tab.desc != nil) { return TAB_DESC }
    }
    return TAB
  }

  tabColumns(self): Array<Track> {
    let list: Array<Track> = []
    for (tab of self.tabs) { list.push("auto") }
    return list
  }

  // Placed by its top left corner from the screen's centre: a resize moves the centre by half the change, so the
  // corner stays exactly where it is.
  placeOf(self): Place {
    if (self.full) { return "fill" }
    const side = self.docked
    if (side != nil) { return Docked { side: side, whole: true } }
    return {
      point: Point.TopLeft, to: Point.Center,
      x: self.declared.placing.x - self.declared.placing.width / 2,
      y: self.declared.placing.y - (self.tabHeight + self.declared.placing.height) / 2,
    }
  }

  gripOf(self): Stated<Art> {
    return { default: Ordaen.art.ctl.grip, hover: Ordaen.art.ctl.gripHover, pressed: Ordaen.art.ctl.gripDown }
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }
  toggleFull(mut self) {
    const full = !self.full
    self.full = full
    self.remember((view: mut WindowView) => { view.full = full })
  }
  onPicked(mut self, index: Integer) {
    if (!self.asks) { self.selected = index }
    self.picked.emit(index)
  }
  onClose(mut self) { self.close.emit() }
  onCorner(mut self, control: CornerControl) {
    match (control) {
      .Settings => self.settings.emit(),
      .Full => self.toggleFull(),
      .Close => self.close.emit(),
    }
  }

  onGrab(mut self) {
    self.x0 = (peek self.declared.placing).x
    self.y0 = (peek self.declared.placing).y
    self.w0 = (peek self.declared.placing).width
    self.h0 = (peek self.declared.placing).height
  }

  // A tab dragged moves the window, as far as it stays on the screen. The tab row takes the mouse on its tabs alone:
  // the room right of them passes a click on to what shows there.
  onMove(mut self, drag: Drag) {
    if (self.full || self.docked != nil) { return }
    const dx, dy = kept(drag, Hold.Move)
    self.declared.placing.x = self.x0 + dx
    self.declared.placing.y = self.y0 + dy
  }

  // The grip taken: the body is never sized below what its content needs (the surface's least size, its tab row
  // over the body taken off). A body kept smaller (from an older save, a larger screen) is drawn at that least, and
  // the drag starts from it, its top left corner where it is.
  onGrabSize(mut self, drag: Drag) {
    self.onGrab()
    self.leastW = drag.room.leastWidth
    self.leastH = drag.room.leastHeight - peek self.tabHeight
    if (self.w0 < self.leastW) {
      self.x0 += (self.leastW - self.w0) / 2
      self.w0 = self.leastW
    }
    if (self.h0 < self.leastH) {
      self.y0 += (self.leastH - self.h0) / 2
      self.h0 = self.leastH
    }
  }

  // The grip follows the cursor up to the screen's edges, and down to the content's least size. The window is placed
  // by its centre, so the centre moves half as far.
  onSize(mut self, drag: Drag) {
    const dx, dy = kept(drag, Hold.Size)
    let width = self.minWidth.max(self.leastW).max(self.w0 + dx)
    let height = self.minHeight.max(self.leastH).max(self.h0 + dy)
    if (self.maxWidth != nil) { width = self.maxWidth.min(width) }
    if (self.maxHeight != nil) { height = self.maxHeight.min(height) }
    self.declared.placing.width = width
    self.declared.placing.height = height
    self.declared.placing.x = self.x0 + (width - self.w0) / 2
    self.declared.placing.y = self.y0 + (height - self.h0) / 2
  }

  // The side's line dragged left widens the side, right narrows it, within its bounds (`sideWidthOf`).
  onSideGrab(mut self) { self.side0 = peek self.sideWidth }
  onSide(mut self, drag: Drag) {
    self.sideDrag = (self.side0 - drag.dx).max(1)
  }
  onSideSettle(mut self) {
    const width = peek self.sideWidth
    self.sideDrag = 0
    self.remember((view: mut WindowView) => { view.side = width })
  }

  public render(self): Template {
    return $ltml {
      // As wide as the player made it, and never narrower than its tabs: the tab row is the one thing in its
      // grid, and the width it keeps is its least.
      <surface shown={self.shown} layer={Layer.Dialog} place={self.place} minWidth={self.width} height={self.height} clamp={true}
               raise={true} xAlign={Align.Start} focusLine={self.focusLine}
               @escape={self.onClose}>
        <box position={Position.Absolute} left={0} right={self.inset} top={self.tabHeight} bottom={0}
             border={Ordaen.art.frame.small} background={Ordaen.art.window.wood} padding={INSET}
             columns={self.bodyColumns} rows={BODY_ROWS} zLevel={BODY_LEVEL} hoverWithin={true}
             @enter={self.onEnter} @leave={self.onLeave}>
          <box rows={MAIN_ROWS} padding={self.padding}>
            <slot />
            <box $if={self.footed} padding={FOOTER_PAD}>
              {self.footer}
            </box>
          </box>
          <box $if={self.sided} border={Ordaen.art.frame.tabIconLine} rows={ONE} padding={self.padding}>
            {self.sideContent}
            <box position={Position.Absolute} left={0} top={0} bottom={0} width={SIDE_HANDLE}
                 @dragStart={self.onSideGrab} @drag={self.onSide} @dragStop={self.onSideSettle} />
          </box>
          <box $if={self.hovered} position={Position.Absolute} top={CORNER_TOP} right={CORNER_RIGHT}
               width={self.cornerWidth} height={CORNER_HEIGHT} overflow={Overflow.Hidden}>
            <CornerPlate $for={index, control of self.controls} control={control} index={index}
                         count={self.controls.length} full={self.full} @pressed={self.onCorner} />
          </box>
          <box $if={self.free} position={Position.Absolute} right={2 * PX} bottom={2 * PX} width={16 * PX}
               height={16 * PX} background={self.grip} @dragStart={self.onGrabSize} @drag={self.onSize}
               @dragStop={self.onSettle} />
        </box>
        <box columns={self.columns} gap={12 * PX} yAlign={Align.End}>
          <WindowTab $for={index, tab of self.tabs} tab={tab} index={index} selected={self.selected}
                     height={self.tabWhole} @grab={self.onGrab} @move={self.onMove} @drop={self.onSettle}
                     @picked={self.onPicked} />
        </box>
      </surface>
    }
  }
}
