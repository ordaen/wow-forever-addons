// Numbers as Ordaen writes them: one way for every module, which Ordaen's own settings decide.
//   The separators (`numberFormat`): «space» 1 000 000.09 (a space that doesn't break, so a number never wraps),
//   «comma» 1,000,000.09, «dot» 1.000.000,09.
//   At most `numberPrecision` decimals, the zeros at the end dropped (1795 is «1 795», 2.5 «2.5»); `numberRound`:
//   whole numbers from 1 up. Under 1 (not 0): at least two digits that aren't nought (0.25, 0.004).
//   A negative number keeps its sign unless it rounds to 0.
// What reads it is run again when the settings change.
import root Ordaen from "Ordaen"
import { NumberFormat } from "@/globals"

const NBSP = "\194\160"
// The most decimals a number under 1 takes.
const FINEST = 12

function decimalsFor(value: Number, precision: Integer, round: Boolean): Integer {
  if (value > 0 && value < 1) {
    let scaled = value
    let shifts = 0
    for (i of 1..=FINEST) {
      if (scaled >= 1) { break }
      scaled = scaled * 10
      shifts = i
    }
    return precision.max(shifts + 1)
  }
  return round ? 0 : precision
}

// Whole digits with `group` between every three from the right.
function grouped(digits: String, group: String): String {
  const n = digits.length
  if (n <= 3) { return digits }
  let first = n % 3
  let out = first > 0 ? digits.sub(1, first) : ""
  for (i of first + 1..=n step 3) {
    out = (out == "" ? "" : out + group) + digits.sub(i, i + 2)
  }
  return out
}

public function number(n: Number): String {
  if (!n.finite()) { return String.of(n) }
  let chosen = Ordaen.globals.values
  let thousands = chosen.numberFormat == NumberFormat.Space ? NBSP : chosen.numberFormat == NumberFormat.Comma ? "," : "."
  let point = chosen.numberFormat == NumberFormat.Dot ? "," : "."
  let value = n.abs()
  let text = `%.${decimalsFor(value, chosen.numberPrecision, chosen.numberRound)}f`.format(value)
  if (text.contains(".")) { text = (text.replace("0+$", "")).replace("%.$", "") }
  let whole, fraction = text.match("^(%d+)%.?(%d*)$")
  if (whole == nil) { return text }
  let sign = n < 0 && text.toNumber() != 0 ? "-" : ""
  let out = sign + grouped(whole, thousands)
  if (fraction != nil && fraction != "") { out = out + point + fraction }
  return out
}
