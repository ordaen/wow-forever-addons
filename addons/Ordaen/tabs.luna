// Tabs: a page's tabs along its top, 4 px apart, over a 1 px line: each tab's name in the dim colour, lighter with
// a shade under the cursor; the picked one white on a darker shade, outlined, with a 2 px light along its top
// inside. Left-click picks a tab: the strip writes the picked tab's index into the cell it was handed.
import { Edges, Line, Position, Side, Stated, Track } from "$ltml"
import { Component } from "@/module"
import { PX } from "@/units"

const LINE: Color = Color.hex("#3e2f1d")
const NAME: Stated<Color> = { default: Color.hex("#a3977f"), hover: Color.hex("#e8dcc4") }
const WHITE: Color = Color.hex("#ffffff")
const CLEAR: Color = Color.hex("#00000000")
const SHADE: Stated<Color> = { default: CLEAR, hover: Color.hex("#00000033") }
const PICKED: Color = Color.hex("#00000059")
// The picked tab's outline; the others keep its room with a line that draws nothing, so a tab's box is the same
// picked or not.
const OUTLINE: Line = { width: 1 * PX, color: LINE, sides: [Side.Top, Side.Left, Side.Right] }
const NO_OUTLINE: Line = { width: 1 * PX, color: CLEAR, sides: [Side.Top, Side.Left, Side.Right] }
const PADDING: Edges = { top: 7 * PX, right: 14 * PX, bottom: 6 * PX, left: 14 * PX }
const LIGHT: Color = Color.hex("#d6a56b")

// One tab of the strip.
public class Tab implements Component {
  derived picked: Boolean = self.selected == self.index
  derived background: Color | Stated<Color> = self.picked ? PICKED : SHADE
  derived border: Line = self.picked ? OUTLINE : NO_OUTLINE
  derived color: Color | Stated<Color> = self.picked ? WHITE : NAME
  // The light along the top: there on every tab, clear on the others, so only colours tell the picked one.
  derived light: Color = self.picked ? LIGHT : CLEAR

  label: Signal<String>
  const index: Integer
  selected: mut Signal<Integer>
  constructor(
    label: Signal<String>,
    index: Integer,
    selected: mut Signal<Integer>,
  ) {
    self.label = label
    self.index = index
    self.selected = selected
  }

  pick(mut self) { self.selected = self.index }

  public render(self): Template {
    return $ltml {
      <box padding={PADDING} background={self.background} border={self.border} @click={self.pick}>
        <box position={Position.Absolute} left={1 * PX} right={1 * PX} top={1 * PX} height={2 * PX}
             background={self.light} />
        <text value={self.label} textColor={self.color} stateFromParent={true} wrap={false} />
      </box>
    }
  }
}

public class Tabs implements Component {
  // One column as wide as each tab, and the rest of the strip.
  derived columns: Array<Track> = self.tracks()

  tabs: Signal<Array<String>>
  selected: mut Signal<Integer>
  constructor(
    tabs: Signal<Array<String>>,
    selected: mut Signal<Integer>,
  ) {
    self.tabs = tabs
    self.selected = selected
  }

  tracks(self): Array<Track> {
    let list: Array<Track> = []
    for (name of self.tabs) { list.push("auto") }
    list.push({ fr: 1 })
    return list
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} gap={4 * PX}>
        <box position={Position.Absolute} left={0} right={0} bottom={0} height={1 * PX} background={LINE} zLevel={1} />
        <Tab $for={index, name of self.tabs} label={name} index={index} selected={mut self.selected} />
      </box>
    }
  }
}
