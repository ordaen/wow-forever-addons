// Tabs: a page's tabs along its top, 4 px apart, over a 1 px line: each tab's name in the dim colour, lighter with
// a shade under the cursor; the picked one white on a darker shade, outlined, with a 2 px light along its top
// inside. Left-click picks a tab: the strip writes the picked tab's index into the cell it was handed. Where the
// strip is given counts, each tab shows its own after its name on a dark pill (a log's sub-tabs: the quests of each).
import { Align, ByInteractionState, Edges, Line, Position, Side, Track } from "$ltml"
import { Component } from "@/module"
import { BRIGHT_TEXT, SECONDARY_TEXT } from "@/units"

const LINE: Color = Color.hex("#3e2f1d")
const NAME: ByInteractionState<Color> = { default: Color.hex("#a3977f"), hover: Color.hex("#e8dcc4"), focus: Color.hex("#e8dcc4") }
const CLEAR: Color = Color.hex("#00000000")
const SHADE: ByInteractionState<Color> = { default: CLEAR, hover: Color.hex("#00000033"), focus: Color.hex("#00000033") }
const PICKED: Color = Color.hex("#00000059")
// The picked tab's outline; the others keep its room with a line that draws nothing, so a tab's box is the same
// picked or not.
const OUTLINE: Line = { width: 1.171875dp, color: LINE, sides: [Side.Top, Side.Left, Side.Right] }
const NO_OUTLINE: Line = { width: 1.171875dp, color: CLEAR, sides: [Side.Top, Side.Left, Side.Right] }
const PADDING: Edges = { top: 2sp, right: 4sp, bottom: 2sp, left: 4sp }
const LIGHT: Color = Color.hex("#d6a56b")
// A count after the name: on a dark pill.
const COUNTED: Array<Track> = ["max-content", "max-content"]
const NAME_ONLY: Array<Track> = ["max-content"]
const PILL: Color = Color.hex("#00000099")
const PILL_PAD: Edges = { right: 1sp, left: 1sp }

// One tab of the strip.
public class Tab implements Component {
  derived picked: Boolean = self.selected == self.index
  derived background: Color | ByInteractionState<Color> = self.picked ? PICKED : SHADE
  derived border: Line = self.picked ? OUTLINE : NO_OUTLINE
  derived color: Color | ByInteractionState<Color> = self.picked ? BRIGHT_TEXT : NAME
  // The light along the top: there on every tab, clear on the others, so only colours tell the picked one.
  derived light: Color = self.picked ? LIGHT : CLEAR
  derived counted: Boolean = self.count != nil
  derived countText: String = String.of(self.count ?? 0)
  derived tracks: Array<Track> = self.counted ? COUNTED : NAME_ONLY

  label: Signal<String>
  const index: Integer
  selected: mut Signal<Integer>
  count: Signal<Integer | nil>
  constructor(
    label: Signal<String>,
    index: Integer,
    selected: mut Signal<Integer>,
    count: Signal<Integer | nil> = nil
  ) {
    self.label = label
    self.index = index
    self.selected = selected
    self.count = count
  }

  pick(mut self) { self.selected = self.index }

  public render(self): Template {
    return $ltml {
      <box padding={PADDING} background={self.background} border={self.border} columns={self.tracks} gap={2sp}
           yAlign={Align.Center} @pointerPress={self.pick} @keyPress(.Enter)={self.pick} @keyPress(.Space)={self.pick}>
        <box position={Position.Absolute} left={1.171875dp} right={1.171875dp} top={1.171875dp} height={2.34375dp}
             background={self.light} />
        <text value={self.label} textColor={self.color} wrap={.None} />
        <box $if={self.counted} padding={PILL_PAD} background={PILL} xAlign={Align.Center}>
          <text value={self.countText} textColor={self.color} textSize={SECONDARY_TEXT} textFont={.Numbers} wrap={.None} />
        </box>
      </box>
    }
  }
}

public class Tabs implements Component {
  // One column as wide as each tab, and the rest of the strip.
  derived columns: Array<Track> = self.tracks()

  tabs: Signal<Array<String>>
  selected: mut Signal<Integer>
  // Each tab's count, by its place; none: no counts shown.
  counts: Signal<Array<Integer>>
  constructor(
    tabs: Signal<Array<String>>,
    selected: mut Signal<Integer>,
    counts: Signal<Array<Integer>> = []
  ) {
    self.tabs = tabs
    self.selected = selected
    self.counts = counts
  }

  tracks(self): Array<Track> {
    let list: Array<Track> = []
    for (name of self.tabs) { list.push("max-content") }
    list.push({ fr: 1 })
    return list
  }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} gap={1sp}>
        <box position={Position.Absolute} left={0ui} right={0ui} bottom={0ui} height={1.171875dp} background={LINE} zLevel={1} />
        <Tab $for={index, name of self.tabs} label={name} index={index} selected={mut self.selected}
             count={self.counts[index]} />
      </box>
    }
  }
}
