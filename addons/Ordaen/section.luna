// Section: a group of rows on a settings tab under its heading (a titled `Cut`: the title in gold bold, a bronze rule
// fading out to its right); the rows 14 px apart below it. Its unnamed slot takes the rows.
import { Cut } from "@/cut"
import { Component } from "@/module"

public class Section implements Component {
  title: Signal<string>
  constructor(title: Signal<string>) {
    self.title = title
  }

  public render(): Template {
    return $ltml {
      <box columns={1} gap={4sp}>
        <Cut title={self.title} />
        <slot />
      </box>
    }
  }
}
