// Section: a group of rows on a settings tab under its heading: the title in gold bold, a bronze rule fading out to
// its right; the rows 14 px apart below it. Its unnamed slot takes the rows.
import { Align, Shadow } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"

const GOLD: Color = Color.hex("#e8c35a")
// The design's 700: the same colour one pixel to the right.
const BOLD: Shadow = { color: GOLD, x: 1.171875dp, y: 0ui }

public class Section implements Component {
  title: Signal<String>
  constructor(title: Signal<String>) {
    self.title = title
  }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={4sp}>
        <box columns={["max-content", { fr: 1 }]} gap={3sp} yAlign={Align.Center}>
          <text value={self.title} textColor={GOLD} textShadow={BOLD} wrap={false} />
          <box height={1.171875dp} background={Ordaen.art.ctl.rule} />
        </box>
        <slot />
      </box>
    }
  }
}
