// Ordaen's root: what Ordaen's own files and every module read of Ordaen (`import root Ordaen from "Ordaen"`, the
// root as it is: a module needs Ordaen, so its root is made before any module's and ends after them). It holds the
// modules that run and draws each on the screen, keeps Ordaen's own settings and where the player put each part,
// turns the modules on and off as the player chooses, and draws the settings window once it is first asked for.
import Client from "$client"
import Debug from "$debug"
import Events from "$events"
import Game from "$game"
import { Anchored, Art, Point } from "$ltml"
import Runtime from "$runtime"
import { ARTWORK, OrdaenArt } from "@/art"
import { Conflict, ConflictQuestion } from "@/conflicts"
import { DEFAULTS, Globals } from "@/globals"
import { OwnerKeys } from "@/hotkeys"
import { Keeper } from "@/keeper"
import Locale from "@/locales"
import { Look, LookArt, Preset, artOf, preset, unoffered } from "@/look"
import { Module } from "@/module"
import { Mover } from "@/placed"
import { ProfileName, RENAMED } from "@/profiles"
import { Settings } from "@/settings"
import { SettingsWindow } from "@/settingsWindow"
import { BODY_TEXT, LEADINGS, spacingFor } from "@/units"
import { GearWorth } from "@/worth"

// The most items' tooltips kept at once.
const TIPS_MOST = 512
const QUEST_COLORS = "showQuestDifficultyColor"

// Where the player put a part, as it is kept: a point of it, the screen's point it stands by, and how far from it.
public struct KeptPlace implements Plain {
  point: Point = Point::Center
  to: Point | nil
  x: number<Length> | nil
  y: number<Length> | nil
}

// Where the player put each part, by the part's name: Ordaen's section `Ordaen:places` of the active profile, so going
// back, a savepoint and a profile hold where the parts stand.
public struct Places implements Plain {
  parts: mut map<string, KeptPlace> = {}
}

// The most room any module's part keeps along one edge.
function mostOf(kept: map<string, number<Length>>): number<Length> {
  let most: number<Length> = 0ui
  for (_, taken of kept) { most = most.max(taken) }
  return most
}

public class OrdaenCore implements App {
  public const icon: Art = "Interface/Icons/Trade_Engineering"
  public const title: string = "Ordaen"
  // The art everything Ordaen draws with, whatever the player chooses.
  public const art: OrdaenArt = ARTWORK
  // Every `Settings` together, as the settings window sees them, with the history of their changes.
  public const keeper: mut Keeper = new Keeper()
  // The fonts, colours and bars' art the player chose: Ordaen's own settings, kept apart from `globals`.
  public const look: mut Settings<Look>
  // The files the look picks, worked out again only when the look's values change.
  public derived lookArt: LookArt = artOf(self.look.values)
  // The settings every module follows.
  public const globals: mut Settings<Globals>
  // What `1sp` is as the player's density has it: every gap, padding and line height of every addon, given to the
  // renderer (`Runtime.spacingUnit`).
  public derived spacingUnit: number<Length> = spacingFor(self.globals.values.density)
  // The dev tools' window: whether it is open.
  public state dev = false
  // The modules that run: each module's root adds itself as it is made, and goes as it is destroyed.
  public const modules = new Registry<any Module>()
  // The room each module's part keeps along the screen's bottom edge (the bottom panel), by its module's folder, and
  // the room the highest keeps: the free parts that stand by that edge until the player moves them (the action bars)
  // stand above it.
  state bottoms: mut map<string, number<Length>> = mut {}
  public derived bottomTaken: number<Length> = self.bottomTakenOf()
  // The room each module's part keeps down from the screen's top right corner (the minimap at home), and the most:
  // what stands along the right edge (the tracker) starts under it.
  state topRights: mut map<string, number<Length>> = mut {}
  public derived topRightTaken: number<Length> = mostOf(self.topRights)
  // What each module asks the player to look at, by its folder: a count another module's part shows for it (the
  // panel's cell, a badge), read by the folder, so neither imports the other.
  state notices: mut map<string, integer> = mut {}
  // The modules drawn on the screen: each once, until it ends and what it drew goes with it.
  drawn: mut WeakMap<any Module, boolean> = {}
  // The mode in which the player moves every module's parts about the screen.
  public state placing = false
  // The parts drawn that the player can move: each part's `Mover` joins as it is made and leaves as it ends.
  public const parts = new Registry<Mover>()
  // The hotkeys modules add to the tooltips of the game's frames they draw or bind (the action bars' buttons).
  public const hotkeys = new Registry<any OwnerKeys>()
  // What items are worth to the player's spec, and how much more than what it wears.
  public const worth: mut GearWorth = new GearWorth()
  // Where the player put each part: read by a part an entry at a time, so a part follows its own place.
  const places: mut Settings<Places>
  // Which modules the player turned off: the account's, whatever each character's list of addons says.
  chosen: mut map<string, boolean> = {}
  // The settings window, made when it is first asked for.
  window: mut SettingsWindow | nil = nil
  // The game's tooltip of each item asked for, by its number: every slot and list that reads one asks the game once.
  // Emptied when the player levels up or a skill changes (what the tooltips mark usable follows the player), and
  // when it passes TIPS_MOST.
  tips: mut map<integer, Game::TooltipData> = {}
  tipCount = 0
  // Moves each time `tips` is emptied: what read a tooltip through `itemTip` reads it again.
  public state tipsAge = 0
  // The other addons that draw what modules draw, whose question waits to be drawn (`askWaiting`).
  unasked: mut array<Conflict> = []
  // The game's setting that colours a quest's level by its difficulty (`showQuestDifficultyColor`, in the world map's
  // filter menu): the quest log's and the tracker's levels follow it, as the game's own do.
  public state questColors: boolean = Client::C_CVar::GetCVarBool(QUEST_COLORS) == true
  // What waits for the player's fight to end (`afterCombat`), in the order asked.
  waiting: mut array<() => nil> = []

  constructor() {
    self.look = new Settings<Look>(preset(Preset::Ordaen), "look", self.keeper)
    self.globals = new Settings<Globals>(DEFAULTS, "", self.keeper)
    self.chosen = load<map<string, boolean>>(.Account, "choices", {})
    // A renamed module stays on or off as it was under its former name.
    for (former, current of RENAMED) {
      if (self.chosen[current] == nil) { self.chosen[current] = self.chosen[former] }
      self.chosen[former] = nil
    }
    // The account's places, kept before profiles held them, are moved into «Default» as they are first read.
    const before = Game::saved.stored(.Account, "places")
    if (before != nil) {
      self.keeper.profiles.adopt("places", "Ordaen:places", Places { parts: decode<map<string, KeptPlace>>(before, {}) })
    }
    self.places = new Settings<Places>(Places {}, "places", self.keeper)
    Runtime::command("/ordaen", (text: string) => self.command(text))
    Runtime::options(self.title, Locale::SETTINGS_OPEN, () => self.toggleSettings(nil))
    watch (running of self.modules) { self.draw(running) }
    // Every text any addon draws is in the look's fonts: given once here, and again when the look's change.
    watch { Runtime::fonts(self.lookArt.fonts) }
    // ... at Ordaen's body size, each kind of line at Ordaen's leading.
    Runtime::baseTextSize(BODY_TEXT)
    Runtime::leadings(LEADINGS)
    // Every gap, padding and line height in the unit the density gives, laid out again when it changes.
    watch { Runtime::spacingUnit(self.spacingUnit) }
    // The ring round the control the keyboard has focused is the look's accent, and follows it.
    watch { Runtime::focusColor(self.look.values.accent) }
    // A look loaded (at the start, at a switch of profile) that is a preset Ordaen doesn't offer is Ordaen's.
    watch (profile of self.keeper.profiles.active) { self.offered(profile) }
    Events::PLAYER_LEVEL_UP.listen(self.forgetTips)
    Events::SKILL_LINES_CHANGED.listen(self.forgetTips)
    Events::CVAR_UPDATE.listen(self.onSetting)
    watch (fighting of Game::situation.combat) {
      if (!fighting) { self.combatEnded() }
    }
    self.start()
  }

  // What runs once the player's fight ends: a change to protected frames (secure buttons, bindings) asked for in a
  // fight, which the client refuses until it ends. Out of a fight it runs now. It outlives what asked for it: a
  // module turned off in a fight has its buttons put away after it.
  public mut afterCombat(run: () => nil) {
    if (!Client::InCombatLockdown()) {
      run()
      return
    }
    self.waiting.push(run)
  }

  mut combatEnded() {
    const waiting = self.waiting
    self.waiting = mut []
    for (run of waiting) { run() }
  }

  bottomTakenOf(): number<Length> { return mostOf(self.bottoms) }

  // How far down from the screen's top right corner a module's part reaches, in UI units: 0 while it keeps no room
  // there (moved away, off, or the module ending).
  public mut keepTopRight(folder: string, taken: number<Length>) {
    self.topRights[folder] = taken
  }

  // How far up from the screen's bottom edge a module's part reaches, in UI units: 0 while it keeps no room there
  // (off, along another side, or the module ending).
  public mut keepBottom(folder: string, taken: number<Length>) {
    self.bottoms[folder] = taken
  }

  // How many things a module asks the player to look at (unread whispers): 0 once it asks nothing, as it ends too.
  public mut notice(folder: string, count: integer) {
    self.notices[folder] = count
  }

  // What a module asks the player to look at, by its folder: 0 where it asks nothing or doesn't run.
  public noticeOf(folder: string): integer { return self.notices[folder] ?? 0 }

  // The game's tooltip of an item, asked of the game once and kept; none while the game has none yet.
  public mut itemTip(id: integer): Game::TooltipData | nil {
    const kept = self.tips[id]
    if (kept != nil) { return kept }
    const tip = Game::items.tooltip(id)
    if (tip == nil) { return nil }
    if (self.tipCount >= TIPS_MOST) {
      self.tips = mut {}
      self.tipCount = 0
    }
    self.tips[id] = tip
    self.tipCount += 1
    return tip
  }

  // Every tooltip kept let go, and what read one told.
  mut forgetTips() {
    self.tips = mut {}
    self.tipCount = 0
    self.tipsAge += 1
  }

  // A setting of the game's changed: the one Ordaen follows read again.
  mut onSetting(name: string, value: string) {
    if (name == QUEST_COLORS) { self.questColors = value == "1" }
  }

  // Each module that runs and isn't drawn yet, drawn on the screen as a module's root is: what it draws ends with it.
  mut draw(running: array<any Module>) {
    for (module of running) {
      if (self.drawn[module] == nil) {
        self.drawn[module] = true
        Runtime::mount(module, Runtime::screen())
      }
    }
    if (running.length > 0) { self.askWaiting() }
  }

  // The look a profile holds, as it is read: one of a preset Ordaen doesn't offer is Ordaen's, kept so.
  mut offered(profile: ProfileName) {
    if (unoffered(peek self.look.values)) {
      Debug::log("the look of profile %s is a preset not offered: Ordaen's is used", profile)
      // How the profile is read, not the player's change: no step.
      self.keeper.unrecorded(() => self.look.reset())
    }
  }

  public mut toggleDev() { self.dev = !peek self.dev }
  public mut togglePlacing() { self.placing = !peek self.placing }

  // The settings window, at a module's page (`Runtime.Addon.of(self)` in the module; Ordaen's own page where none is
  // given), or closed where it shows that page: made and drawn the first time.
  public mut toggleSettings(page: Runtime::Addon | nil) {
    self.toggleNamed(page?.name ?? "")
  }

  // Whether the player has a module on, by its folder: Ordaen's own switch, whatever the client's list says.
  public isChosen(folder: string): boolean { return self.chosen[folder] != false }

  // A room in the spacing unit as a length, for a size worked out from gaps (a drawer as wide as its cells and the
  // gaps between them); read in a derived cell, it follows the density.
  public lengthOf(room: number<Spacing>): number<Length> { return room / 1sp * self.spacingUnit }
  // A length measured of the art as a room in the spacing unit, for a padding that meets the art's lines.
  public spacingOf(length: number<Length>): number<Spacing> { return length / self.spacingUnit * 1sp }

  // The settings window at the page of a module's folder (`""`: Ordaen's own), or closed where it shows that page.
  public mut toggleNamed(folder: string) {
    if (self.window == nil) {
      const made = new SettingsWindow()
      Runtime::mount(made, Runtime::screen())
      self.window = made
    }
    Debug::log("the settings window asked for, page %s", folder == "" ? "none" : folder)
    self.window?.toggle(folder)
  }

  // Where the player put a part, by the part's name; nothing for one never moved. Read in a `derived`, it is
  // followed: the part moves when its place is kept anew.
  public moved(part: string): Anchored | nil {
    const kept = self.places.values.parts[part]
    if (kept == nil) { return nil }
    return { point: kept.point, to: kept.to, x: kept.x, y: kept.y }
  }

  // Keep a part's place, a step of the history; nothing puts it back where its module says.
  public mut putAt(part: string, place: Anchored | nil) {
    self.places.change((values: mut Places): nil => {
      values.parts[part] = place == nil ? nil : KeptPlace { point: place.point, to: place.to, x: place.x, y: place.y }
    })
  }

  // The player's choice: kept, whatever comes of it. A module turned on is on in the client's own list of addons
  // from then, loaded where it can be, and its root made; turned off, its root is destroyed.
  public mut turn(addon: Runtime::Addon, on: boolean) {
    self.chosen[addon.name] = on
    Game::saved.store(.Account, "choices", self.chosen)
    Debug::log("module %s turned %s by the player", addon.name, on ? "on" : "off")
    self.run(addon, on)
  }

  // A module run or ended. What the player chose isn't touched: a module that can't be loaded now is tried again
  // at the next start.
  run(addon: Runtime::Addon, on: boolean) {
    if (!on) {
      addon.disable()
      return
    }
    const refused = addon.enable()
    if (refused != nil) { Debug::log("module %s: not made, the client says %s", addon.name, refused.reason) }
  }

  // The addons that are the player's modules: each one that needs Ordaen and has a root of its own. A library (code
  // alone, as Ordaen Trainer is) is no module: it loads as the modules that need it do, and has no switch of its own.
  public moduleAddons(): array<Runtime::Addon> {
    const own = Runtime::Addon::of(self)
    if (own == nil) { return [] }
    return own.dependents().filter((addon: Runtime::Addon): boolean => addon.hasRoot)
  }

  // The modules the player has run but those the player turned off, as the client's
  // list of addons has them: a start never changes that list. A module the list has off is refused by the client
  // and tried again at the next start; one the player turned off is left unloaded, wherever the list has it.
  mut start() {
    const modules = self.moduleAddons()
    for (addon of modules) {
      if (self.chosen[addon.name] == false) {
        Debug::log("module %s: turned off by the player", addon.name)
        // Loaded as another module needs it: its root ends.
        addon.stop()
        continue
      }
      Debug::log("module %s: to run", addon.name)
      const refused = addon.load()
      if (refused != nil) { Debug::log("module %s: not made, the client says %s", addon.name, refused.reason) }
    }
    self.askConflicts(modules)
  }

  // Each other addon loaded that draws what modules on draw, and was never answered since it came: the player is
  // asked to keep one. One that is off now forgets its answer, so it is asked again when it comes back.
  mut askConflicts(modules: array<Runtime::Addon>) {
    const answered = load<map<string, boolean>>(.Account, "conflicts", {})
    let asking: map<string, Runtime::Addon> = mut {}
    const running = modules.filter(module => self.chosen[module.name] != false)
    for (module of running) {
      for (other of module.conflicts()) {
        let (loaded, _) = Client::C_AddOns::IsAddOnLoaded(other.name)
        if (!loaded) {
          answered[other.name] = nil
        } else if (answered[other.name] == nil) {
          asking[other.name] = other
        }
      }
    }
    Game::saved.store(.Account, "conflicts", answered)
    for (name, other of asking) {
      const conflict: Conflict = {
        other: other,
        modules: running.filter(module => module.conflicts().any(one => one.name == name))
      }
      Debug::log("%s draws what %d modules draw: the player is asked", name, conflict.modules.length)
      self.unasked.push(conflict)
    }
  }

  // The questions waiting, drawn as the modules they are of are: nothing is drawn while Ordaen's root is being made.
  mut askWaiting() {
    const waiting = self.unasked
    self.unasked = mut []
    for (conflict of waiting) {
      Runtime::mount(new ConflictQuestion(conflict, (kept: boolean): nil => {
        self.conflictAnswered(conflict, kept)
        return nil
      }), Runtime::screen())
    }
  }

  // The player's answer, kept: Ordaen kept (the other addon is off from the reload), or the other (its modules off).
  mut conflictAnswered(conflict: Conflict, kept: boolean) {
    const answered = load<map<string, boolean>>(.Account, "conflicts", {})
    answered[conflict.other.name] = kept
    Game::saved.store(.Account, "conflicts", answered)
    if (kept) { return }
    for (module of conflict.modules) { self.turn(module, false) }
  }

  // `/ordaen` opens the settings, `/ordaen <module>` on that module's page: its folder or its name in the list, in
  // any case (`/ordaen minimap`). A word that names no module the player has opens Ordaen's own page.
  mut command(text: string) {
    const word = (text.match("^%s*(%S+)") ?? "").lower()
    self.toggleSettings(word == "" ? nil : self.moduleNamed(word))
  }

  moduleNamed(word: string): Runtime::Addon | nil {
    for (addon of self.moduleAddons()) {
      const folder = addon.name.lower()
      if (folder == word || folder == "ordaen" + word) { return addon }
    }
    return nil
  }
}
