// Ordaen's root: what Ordaen's own files and every module read of Ordaen (`import root Ordaen from "Ordaen"`, the
// root as it is: a module needs Ordaen, so its root is made before any module's and ends after them). It holds the
// modules that run and draws each on the screen, keeps Ordaen's own settings and where the player put each part,
// turns the modules on and off as the player chooses, and draws the settings window once it is first asked for.
import Debug from "$debug"
import { Anchored, Art, Point } from "$ltml"
import Game from "$game"
import Runtime from "$runtime"
import { ARTWORK, Artwork } from "@/art"
import { DEFAULTS, Globals } from "@/globals"
import { Keeper } from "@/keeper"
import Locale from "@/locales"
import { artOf, Look, LookArt, preset, Preset, unoffered } from "@/look"
import { Module } from "@/module"
import { Mover } from "@/placed"
import { ProfileName } from "@/profiles"
import { Settings } from "@/settings"
import { SettingsWindow } from "@/settingsWindow"

// Where the player put a part, as it is kept: a point of it, the screen's point it stands by, and how far from it.
public struct KeptPlace implements Plain {
  point: Point = Point.Center
  to: Point | nil
  x: Number | nil
  y: Number | nil
}

public class OrdaenCore implements App {
  public const icon: Art = "Interface/Icons/Trade_Engineering"
  public const title: String = "Ordaen"
  // The art everything Ordaen draws with, whatever the player chooses.
  public const art: Artwork = ARTWORK
  // Every `Settings`' draft together, as the settings window sees them.
  public const keeper: mut Keeper = new Keeper()
  // The fonts, colours and bars' art the player chose: Ordaen's own settings, kept apart from `globals`.
  public const look: mut Settings<Look>
  // The files the look picks, worked out again only when the look's values change.
  public derived lookArt: LookArt = artOf(self.look.values)
  // The settings every module follows.
  public const globals: mut Settings<Globals>
  // The dev tools' window: whether it is open.
  public state dev = false
  // The modules that run: each module's root adds itself as it is made, and goes as it is destroyed.
  public const modules = new Registry<any Module>()
  // The modules drawn on the screen: each once, until it ends and what it drew goes with it.
  drawn: mut WeakMap<any Module, Boolean> = {}
  // The mode in which the player moves every module's parts about the screen.
  public state placing = false
  // The parts drawn that the player can move: each part's `Mover` joins as it is made and leaves as it ends.
  public const parts = new Registry<Mover>()
  // Where the player put each part: read by a part an entry at a time, so a part follows its own place.
  state places: mut Map<String, KeptPlace> = {}
  // Which modules the player turned off: the account's, whatever each character's list of addons says.
  chosen: mut Map<String, Boolean> = {}
  // The settings window, made when it is first asked for.
  window: mut SettingsWindow | nil = nil

  constructor() {
    self.look = new Settings<Look>(preset(Preset.Ordaen), "look", mut self.keeper)
    self.globals = new Settings<Globals>(DEFAULTS, "", mut self.keeper)
    self.chosen = load<Map<String, Boolean>>(.Account, "choices", {})
    self.places = load<Map<String, KeptPlace>>(.Account, "places", {})
    Runtime.command("/ordaen", (text: String) => self.command(text))
    Runtime.options(self.title, Locale.SETTINGS_OPEN, () => self.toggleSettings(nil))
    watch (running of self.modules) { self.draw(running) }
    // Every text any addon draws is in the look's fonts: given once here, and again when the look's change.
    watch { Runtime.fonts(self.lookArt.fonts) }
    // A look loaded (at the start, at a switch of profile) that is a preset Ordaen doesn't offer is Ordaen's.
    watch (profile of self.keeper.profiles.active) { self.offered(profile) }
    self.start()
  }

  // Each module that runs and isn't drawn yet, drawn on the screen as a module's root is: what it draws ends with it.
  draw(mut self, running: Array<any Module>) {
    for (module of running) {
      if (self.drawn[module] == nil) {
        self.drawn[module] = true
        Runtime.mount(module, Runtime.screen())
      }
    }
  }

  // The look a profile holds, as it is read: one of a preset Ordaen doesn't offer is Ordaen's, kept so.
  offered(mut self, profile: ProfileName) {
    if (unoffered(peek self.look.values)) {
      Debug.log("the look of profile %s is a preset not offered: Ordaen's is used", profile)
      self.look.reset()
    }
  }

  public toggleDev(mut self) { self.dev = !peek self.dev }
  public togglePlacing(mut self) { self.placing = !peek self.placing }

  // The settings window, at a module's page (`Runtime.Addon.of(self)` in the module; Ordaen's own page where none is
  // given), or closed where it shows that page: made and drawn the first time.
  public toggleSettings(mut self, page: Runtime.Addon | nil) {
    self.toggleNamed(page?.name ?? "")
  }

  // The settings window at the page of a module's folder (`""`: Ordaen's own).
  toggleNamed(mut self, folder: String) {
    if (self.window == nil) {
      const made = new SettingsWindow()
      Runtime.mount(made, Runtime.screen())
      self.window = made
    }
    Debug.log("the settings window asked for, page %s", folder == "" ? "none" : folder)
    self.window?.toggle(folder)
  }

  // Where the player put a part, by the part's name; nothing for one never moved. Read in a `derived`, it is
  // followed: the part moves when its place is kept anew.
  public moved(self, part: String): Anchored | nil {
    const kept = self.places[part]
    if (kept == nil) { return nil }
    return { point: kept.point, to: kept.to, x: kept.x, y: kept.y }
  }

  // Keep a part's place; nothing puts it back where its module says.
  public putAt(mut self, part: String, place: Anchored | nil) {
    if (place == nil) {
      self.places[part] = nil
    } else {
      self.places[part] = { point: place.point, to: place.to, x: place.x, y: place.y }
    }
    Game.saved.store(.Account, "places", peek self.places)
  }

  // The player's choice: kept, whatever comes of it. A module turned on is on in the client's own list of addons
  // from then, loaded where it can be, and its root made; turned off, its root is destroyed.
  public turn(mut self, addon: Runtime.Addon, on: Boolean) {
    self.chosen[addon.name] = on
    Game.saved.store(.Account, "choices", self.chosen)
    Debug.log("module %s turned %s by the player", addon.name, on ? "on" : "off")
    self.run(addon, on)
  }

  // A module run or ended. What the player chose isn't touched: a module that can't be loaded now is tried again
  // at the next start.
  run(self, addon: Runtime.Addon, on: Boolean) {
    if (!on) {
      addon.disable()
      return
    }
    const refused = addon.enable()
    if (refused != nil) { Debug.log("module %s: not made, the client says %s", addon.name, refused.reason) }
  }

  // The modules the player has (each addon that needs Ordaen) run but those the player turned off, as the client's
  // list of addons has them: a start never changes that list. A module the list has off is refused by the client
  // and tried again at the next start; one the player turned off is left unloaded, wherever the list has it.
  start(self) {
    const own = Runtime.Addon.of(self)
    if (own == nil) { return }
    for (addon of own.dependents()) {
      if (self.chosen[addon.name] == false) {
        Debug.log("module %s: turned off by the player", addon.name)
        // Loaded as another module needs it: its root ends.
        addon.stop()
        continue
      }
      Debug.log("module %s: to run", addon.name)
      const refused = addon.load()
      if (refused != nil) { Debug.log("module %s: not made, the client says %s", addon.name, refused.reason) }
    }
  }

  // `/ordaen` opens the settings, `/ordaen <module>` on that module's page: its folder or its name in the list, in
  // any case (`/ordaen minimap`). A word that names no module the player has opens Ordaen's own page.
  command(mut self, text: String) {
    const word = (text.match("^%s*(%S+)") ?? "").lower()
    self.toggleSettings(word == "" ? nil : self.moduleNamed(word))
  }

  moduleNamed(self, word: String): Runtime.Addon | nil {
    const own = Runtime.Addon.of(self)
    if (own == nil) { return nil }
    for (addon of own.dependents()) {
      const folder = addon.name.lower()
      if (folder == word || folder == "ordaen" + word) { return addon }
    }
    return nil
  }
}
