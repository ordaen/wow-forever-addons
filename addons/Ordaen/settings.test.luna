// Settings read back from what was kept (`decode`): a field that isn't there, or isn't of its type, is the default's.
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import { Look, preset, Preset } from "@/look"

// A colour that lost its fields.
struct Partial implements Plain {
  r: Number
}

// What saved data may hold where the look was kept: the accent without its green, blue and alpha, the red a string,
// the text's colour whole.
struct Damaged implements Plain {
  accent: Partial
  red: String
  redText: Color
}

function color(c: Color): String {
  return "%g, %g, %g, %g".format(c.r, c.g, c.b, c.a)
}

test "`/ordaen` with a name no module has opens the settings on Ordaen's own page, marked in the list" {
  Test.mount(nil, { left: 20, top: 20, width: 200, height: 100, screen: true })
  Ordaen.command("minimap")
  Test.flush()
  Test.expect(Ordaen.window?.page == "")
  Test.shot("/ordaen minimap: no module is named so, Ordaen's own page shows with «General» marked")
  Ordaen.command("minimap")
  Test.flush()
}

test "a kept colour without some of its fields takes them from the default" {
  Game.saved.store(.Account, "Probe", Damaged { accent: { r: 0.1 }, red: "red", redText: { r: 0.5, g: 0.25, b: 0, a: 1 } })
  const look: Look = load(.Account, "Probe", preset(Preset.Ordaen))
  Test.note(`accent: ${color(look.accent)}`)
  Test.note(`red: ${color(look.red)}`)
  Test.note(`red's text, kept whole: ${color(look.redText)}`)
  Test.note(`the draft's accent: ${color(look.clone().accent)}`)
}
