// Ordaen's art: the pictures and the measures everything Ordaen draws is made of, the same whatever the player
// chooses. What the player chooses of the look (fonts, colours, a bar's fill) is Ordaen's settings (look.luna).
import { Art, Corners, Curves, Line, Metal, Piece, Radius, Reach, Side } from "$ltml"

public struct Spacing {
  sm: Number
  md: Number
  lg: Number
}

// The art, by what it is for.
public struct ArtFrame {
  // A window's or a small surface's metal on all four sides: windows, dialogs, tooltips, the minimap.
  small: Metal
  // A window tab's: the metal on its top and sides, its top corners rounded, open or closed alike.
  tab: Metal
  // A tab's icon: its picture cut by the tab's top-left curve, and the line on its right.
  tabIconClip: Metal
  tabIconLine: Metal
}

public struct ArtWindow {
  wood: Art
  // The game's dark marble, under a chosen thing's details.
  marble: Art
}

// One tone of the corner group's plates: the first of the group, with the group's rim round its left and bottom
// and its corner rounded; and one after another, a divider on its left and the rim under it.
public struct CornerPlates {
  first: Art
  next: Art
}

// A window's corner group: every control a plate of one tone with its glyph on it.
public struct CornerArt {
  bronze: CornerPlates
  red: CornerPlates
  gear: Art
  expand: Art
  contract: Art
  close: Art
}

// A window toolbar's glyphs, white for the box's `tint`: the filter, the sort, and a view's by what it shows.
public struct ToolGlyphs {
  filter: Art
  sort: Art
  columns: Art
  categories: Art
  list: Art
  table: Art
}

public struct ArtControls {
  tick: Art
  check: Art
  button: Art
  buttonAccent: Art
  buttonDisabled: Art
  groove: Art
  sliderFill: Art
  sliderKnob: Art
  rule: Art
  switchOn: Art
  switchOff: Art
  knobOn: Art
  knobOff: Art
  dropdownArrow: Art
  radio: Art
  radioOn: Art
  tool: ToolGlyphs
  // A window's corner group; its resize grip.
  corner: CornerArt
  // The marks no font carries, white, tinted by their box: up and down (a sorted heading), closed
  // and open (a tree row's fold).
  markUp: Art
  markDown: Art
  markClosed: Art
  markOpen: Art
  // A compared stat's more and less: the triangle filling its cell, outlined black, white inside, tinted by its box.
  compareUp: Art
  compareDown: Art
  // The light inside an item slot's quality rim, white, stretched over the slot and tinted with the quality's colour.
  qualityRim: Art
  grip: Art
  gripHover: Art
  gripDown: Art
}

public struct ArtPanel {
  // The panel's surface, and the metal along its inner side.
  wood: Art
  edge: Metal
  // The pill a count stands on.
  countBadge: Art
  // The shapes a face is cut to: round on a cell, the screen's corner under the panel's rim; the rim over the corner's
  // face, drawn over the same box as its shape; and the badge the level stands on.
  faceRound: Art
  corner: Art
  cornerRim: Art
  badge: Art
  // A bag button's edge on the wood: one line.
  slotEdge: Line
  // The reputation bar's fill, and a status bar's glass: its trough, its shine, its bronze ring.
  xpSteel: Art
  xpTrough: Art
  xpShine: Art
  xpTube: Art
}

public struct ArtMinimap {
  ring: Art
  ringLit: Art
}

public struct Artwork {
  spacing: Spacing
  frame: ArtFrame
  window: ArtWindow
  ctl: ArtControls
  panel: ArtPanel
  minimap: ArtMinimap
}

// The metal frame: the client's window frame at half size. The line is 3 units; the art stands past it by its
// reach on each side, and the box's background starts 1.5 units into the art. A rounded frame's right side is
// its left mirrored, so it reaches as far as the left.
const FRAME: Atlas = "ButtonFrameTemplateNoPortrait"
const REACH: Reach = { top: 14.5, right: 4.5, bottom: 10, left: 14.5 }
const REACH_ROUND: Reach = { top: 14.5, right: 14.5, bottom: 10, left: 14.5 }
const CURVES: Curves = { small: 8 / 1.2 / 0.5 + 14, large: 14 / 1.2 / 0.5 + 14, flare: 21 }
const TAB_CORNERS: Corners = { topLeft: Radius.Large, topRight: Radius.Large }
const ICON_CORNER: Corners = { topLeft: Radius.Large }

// The wood: one tile, repeated at the size the picture had in the design's window.
const WOOD: Piece = { file: "@/media/window-wood.tga", width: 512, height: 512, repeatSize: 746 / 1.2 }

// Ordaen's art: its measures, and its pictures from this addon's `media` and the client.
public const ARTWORK: Artwork = {
  spacing: { sm: 4, md: 8, lg: 16 },
  frame: {
    small: { nineSlice: FRAME, art: FRAME, width: 3, scale: 0.5, inset: -1.5, reach: REACH, curves: CURVES, lineStart: 10 },
    tab: { nineSlice: FRAME, art: FRAME, width: 3, scale: 0.5, inset: -1.5, reach: REACH_ROUND, sides: [Side.Top, Side.Left, Side.Right], radius: TAB_CORNERS, curves: CURVES, lineStart: 10 },
    tabIconClip: { nineSlice: FRAME, art: FRAME, width: 3, scale: 0.5, inset: -1.5, reach: REACH_ROUND, sides: [], radius: ICON_CORNER, curves: CURVES, lineStart: 10 },
    tabIconLine: { nineSlice: FRAME, art: FRAME, width: 3, scale: 0.5, inset: -1.5, reach: REACH, sides: [Side.Left], curves: CURVES, lineStart: 10 },
  },
  window: { wood: WOOD, marble: "Interface/FrameGeneral/UI-Background-Marble" },
  ctl: {
    // The checkbox, drawn whole: the well (the light ring over it under the cursor), and the tick.
    check: { file: "@/media/ctl-check.tga", width: 64, height: 256, rows: 4, normal: 0, glow: 1 },
    tick: { file: "@/media/ctl-check.tga", width: 64, height: 256, rows: 4, normal: 2 },
    // The push button and the dropdown's face: rows 0 normal, 1 pushed, 2 disabled, 3 the light over normal, 4 the
    // accent, 5 the accent pushed; caps half as wide as it is high.
    button: { file: "@/media/button.tga", width: 256, height: 512, cap: 32, capHeight: 0.5, rows: 8, normal: 0, pressed: 1, glow: 3 },
    buttonAccent: { file: "@/media/button.tga", width: 256, height: 512, cap: 32, capHeight: 0.5, rows: 8, normal: 4, pressed: 5, glow: 3 },
    buttonDisabled: { file: "@/media/button.tga", width: 256, height: 512, cap: 32, capHeight: 0.5, rows: 8, normal: 2 },
    // The slider: the groove with its edge, the fill inside it, the knob.
    groove: { file: "@/media/ctl-slider.tga", width: 64, height: 128, cap: 4, capHeight: 0.125, rows: 4, normal: 0 },
    sliderFill: { file: "@/media/ctl-slider.tga", width: 64, height: 128, rows: 4, normal: 1 },
    sliderKnob: "@/media/ctl-slider-knob.tga",
    rule: "@/media/ctl-rule.tga",
    // The switch: the track, a pill with round caps (rows 0 off, 1 on, 2 the ring over either), and the knob.
    switchOff: { file: "@/media/ctl-switch-track.tga", width: 128, height: 256, cap: 32, capHeight: 0.5, rows: 4, normal: 0, glow: 2 },
    switchOn: { file: "@/media/ctl-switch-track.tga", width: 128, height: 256, cap: 32, capHeight: 0.5, rows: 4, normal: 1, glow: 2 },
    knobOff: { file: "@/media/ctl-switch-knob.tga", width: 64, height: 128, rows: 2, normal: 0 },
    knobOn: { file: "@/media/ctl-switch-knob.tga", width: 64, height: 128, rows: 2, normal: 1 },
    dropdownArrow: "@/media/dropdown-arrow.tga",
    radio: { file: "@/media/ctl-radio.tga", width: 32, height: 64, rows: 2, normal: 0 },
    radioOn: { file: "@/media/ctl-radio.tga", width: 32, height: 64, rows: 2, normal: 1 },
    // A toolbar's glyphs (art/pieces/tool.json): rows of 16 x 16 px, white with their shadow.
    tool: {
      filter: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 256, rows: 8, normal: 0 },
      sort: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 256, rows: 8, normal: 1 },
      columns: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 256, rows: 8, normal: 2 },
      categories: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 256, rows: 8, normal: 3 },
      list: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 256, rows: 8, normal: 4 },
      table: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 256, rows: 8, normal: 5 },
    },
    // The marks (art/pieces/marks.json): 16 px cells, each triangle in its middle; the compared stat's two fill theirs.
    markUp: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 0 },
    markDown: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 1 },
    markClosed: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 2 },
    markOpen: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 3 },
    compareUp: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 4 },
    compareDown: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 5 },
    // An item slot's rim light (art/pieces/quality-rim.json): a 40 px slot's inner glow.
    qualityRim: "@/media/ctl-quality-rim.tga",
    // A window's corner group (art/pieces/corner.json): the plates by tone and place, the glyphs; the row by state
    // (a glyph pressed is its hover's: the mouse is on it).
    corner: {
      bronze: {
        first: { file: "@/media/ctl-corner-plate.tga", width: 128, height: 1024, rows: 16, normal: 0, hover: 1, pressed: 2 },
        next: { file: "@/media/ctl-corner-plate.tga", width: 128, height: 1024, rows: 16, normal: 3, hover: 4, pressed: 5 },
      },
      red: {
        first: { file: "@/media/ctl-corner-plate.tga", width: 128, height: 1024, rows: 16, normal: 6, hover: 7, pressed: 8 },
        next: { file: "@/media/ctl-corner-plate.tga", width: 128, height: 1024, rows: 16, normal: 9, hover: 10, pressed: 11 },
      },
      gear: { file: "@/media/ctl-corner-glyph.tga", width: 32, height: 256, rows: 8, normal: 0, hover: 1, pressed: 1 },
      expand: { file: "@/media/ctl-corner-glyph.tga", width: 32, height: 256, rows: 8, normal: 2, hover: 3, pressed: 3 },
      contract: { file: "@/media/ctl-corner-glyph.tga", width: 32, height: 256, rows: 8, normal: 4, hover: 5, pressed: 5 },
      close: { file: "@/media/ctl-corner-glyph.tga", width: 32, height: 256, rows: 8, normal: 6, hover: 7, pressed: 7 },
    },
    // A window's resize grip: the client's own.
    grip: "Interface/ChatFrame/UI-ChatIM-SizeGrabber-Up",
    gripHover: "Interface/ChatFrame/UI-ChatIM-SizeGrabber-Highlight",
    gripDown: "Interface/ChatFrame/UI-ChatIM-SizeGrabber-Down",
  },
  panel: {
    // The shapes a face is cut to: a circle, and the screen's corner; the corner's rim, from the same render.
    faceRound: "@/media/face-round-mask.tga",
    corner: "@/media/portrait-mask.tga",
    cornerRim: "@/media/portrait-rim.tga",
    badge: "@/media/level-badge.tga",
    slotEdge: { width: 1, color: Color.hex("#6c5535") },
    xpSteel: { file: "@/media/xp-fill-steel.tga", width: 1024, height: 32, tile: true },
    wood: WOOD,
    edge: { nineSlice: FRAME, art: FRAME, width: 3, scale: 0.5, inset: -1.5, reach: REACH, sides: [Side.Top], curves: CURVES, lineStart: 10 },
    countBadge: { file: "@/media/panel-count-badge.tga", width: 128, height: 64, cap: 32, capHeight: 0.5 },
    // The experience tube, back to front: the trough, the fill, the shine, the ring.
    xpTrough: { file: "@/media/xp-tube-trough.tga", width: 256, height: 64, cap: 64, capHeight: 1 },
    xpShine: { file: "@/media/xp-tube-shine.tga", width: 256, height: 64, cap: 64, capHeight: 1 },
    xpTube: { file: "@/media/xp-tube.tga", width: 256, height: 64, cap: 64, capHeight: 1 },
  },
  // A button on the minimap's ring, drawn whole: rows 0 the button, 1 the light ring over it, 2 lit.
  minimap: {
    ring: { file: "@/media/minimap-ring.tga", width: 128, height: 512, rows: 4, normal: 0, glow: 1 },
    ringLit: { file: "@/media/minimap-ring.tga", width: 128, height: 512, rows: 4, normal: 2, glow: 1 },
  },
}
