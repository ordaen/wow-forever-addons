// Ordaen's art: the pictures and the measures everything Ordaen draws is made of, the same whatever the player
// chooses. What the player chooses of the look (fonts, colours, a bar's fill) is Ordaen's settings (look.luna).
import { Art, ArtBorder, Corners, Curves, FramePieces, Line, Piece, Radius, Reach, Side, Tile } from "$ltml"

// Ordaen's art, by what it is for (`Ordaen.art`); each part is read through its types (`OrdaenArt.Window`).
public struct OrdaenArt {
  public struct Frame {
    // A window's metal on all four sides, a bracket over each corner.
    window: ArtBorder
    // A small surface's metal on all four sides, its corners rounded: dialogs, tooltips, the chat, the minimap.
    small: ArtBorder
    // A window tab's: the metal on its top and sides, its top corners rounded, open or closed alike.
    tab: ArtBorder
    // A tab standing at a framed box's left (the chat's open tab): the metal on its top, left and bottom, its left
    // corners rounded; its right is open, where the box's own left line stands over it.
    sideTab: ArtBorder
    // A tab's icon: its picture cut by the tab's top-left curve, and the line on its right.
    tabIconClip: ArtBorder
    tabIconLine: ArtBorder
  }

  public struct Window {
    wood: Art
    // The game's dark marble, under a chosen thing's details.
    marble: Art
  }

  // The bronze plates of a window's control group, which stands at the tab row's right end, its foot under the body's
  // top line: the first of the group, with the group's rim on its left and top and its corner rounded; one after
  // another, a divider on its left and the rim above it; the last, the rim on its right and top, its corner rounded.
  // Each with the rim's shadow beside it and above it.
  public struct Plates {
    first: Art
    next: Art
    last: Art
  }

  // A window's control group: every control a plate with its glyph on it, bronze, or red for the close, which is
  // always the group's last.
  public struct ControlGroup {
    bronze: Plates
    red: Art
    gear: Art
    expand: Art
    contract: Art
    close: Art
  }

  // A window toolbar's glyphs, white for the box's `tint`: the filter, the sort, a view's by what it shows (one grid:
  // `one`), refresh (a circling arrow), whom (a figure: for whom a list is), and sorting now (`arrange`: arrows up
  // and down).
  public struct Toolbar {
    filter: Art
    sort: Art
    columns: Art
    categories: Art
    list: Art
    table: Art
    refresh: Art
    whom: Art
    one: Art
    arrange: Art
  }

  // The well a scrolled list sits in: sunk into the wood, its rim the line round it and its floor darker than the
  // wood; the rows are cut at the rim's inner edge.
  public struct Well {
    rim: Line
    floor: Color
  }

  // A cut in the wood's two textures, laid over each other: `dark` multiplied into the wood (`Blend.Multiply`), its
  // shade; `light` added to it (`Blend.Add`), its lit lip.
  public struct CutLayers {
    dark: Art
    light: Art
  }

  // A cut in the wood (`Groove`, `Cut` without a title), 8 texels deep: `across` a strip repeated along it, `upright`
  // the same down a column.
  public struct CutArt {
    across: CutLayers
    upright: CutLayers
  }

  // A heading's rule of paint (`Cut` with a title, `Section`), 8 texels deep: `entry` where it rises, `tip` the rest of
  // it, stretched along it, narrowing to a point and fading.
  public struct HeadingArt {
    entry: Art
    tip: Art
  }

  public struct Controls {
    // A scrolled list's well (`ScrolledList`).
    well: Well
    tick: Art
    check: Art
    button: Art
    buttonAccent: Art
    buttonDisabled: Art
    // The push button's light by itself, for a plate dressed over a button of the client's, which keeps the mouse.
    buttonLight: Art
    // The «new» gem at a push button's left end.
    newGem: Art
    groove: Art
    sliderFill: Art
    sliderKnob: Art
    cut: CutArt
    heading: HeadingArt
    // A dialog title's rule: a groove cut into the wood, 4 px tall, stretched along it.
    carved: Art
    switchOn: Art
    switchOff: Art
    knobOn: Art
    knobOff: Art
    dropdownArrow: Art
    radio: Art
    radioOn: Art
    tool: Toolbar
    // A window's corner group; its resize grip.
    corner: ControlGroup
    // The marks no font carries, white, tinted by their box: up and down (a sorted heading), closed
    // and open (a tree row's fold).
    markUp: Art
    markDown: Art
    markClosed: Art
    markOpen: Art
    // A compared stat's more and less: the triangle filling its cell, outlined black, white inside, tinted by its box.
    compareUp: Art
    compareDown: Art
    // The light inside an item slot's quality rim, white, stretched over the slot and tinted with the quality's colour.
    qualityRim: Art
    // The client's crested item slot's rim alone, white, on the slot art's texels (its top left 41 of 64): tinted with
    // an item's quality's colour over the crest.
    crestRim: Art
    grip: Art
    gripHover: Art
    gripDown: Art
  }

  public struct Panel {
    // The panel's surface, and the metal along its inner side.
    wood: Art
    edge: ArtBorder
    // The pill a count stands on.
    countBadge: Art
    // The shapes a face is cut to: round on a cell, the screen's corner under the panel's rim; the rim over the corner's
    // face, drawn over the same box as its shape; and the badge the level stands on.
    faceRound: Art
    corner: Art
    cornerRim: Art
    badge: Art
    // A bag button's edge on the wood: one line.
    slotEdge: Line
    // The reputation bar's fill, and a status bar's glass: its trough, its shine, its bronze ring.
    xpSteel: Art
    xpTrough: Art
    xpShine: Art
    xpTube: Art
  }

  public struct Minimap {
    ring: Art
    ringLit: Art
  }

  frame: Frame
  window: Window
  ctl: Controls
  panel: Panel
  minimap: Minimap
}

// Whether a frame of art draws a side: every side where it names none.
function draws(metal: ArtBorder, side: Side): Boolean {
  const sides = metal.sides
  return sides == nil || sides.any(each => each == side)
}

// How far a frame of art stands past its line across a box (left and right) and down it (top and bottom), on the
// sides it draws. A border takes room inside the size its box is given: a size measured at the line takes these on.
public function reachAcross(metal: ArtBorder): Number<Length> {
  const left = draws(metal, Side.Left) ? metal.reach.left : 0
  const right = draws(metal, Side.Right) ? metal.reach.right : 0
  return (left + right) * metal.scale * 1ui
}

public function reachDown(metal: ArtBorder): Number<Length> {
  const top = draws(metal, Side.Top) ? metal.reach.top : 0
  const bottom = draws(metal, Side.Bottom) ? metal.reach.bottom : 0
  return (top + bottom) * metal.scale * 1ui
}

// How far in from its box's left edge the middle of a frame's left line stands: what is laid against the box from the
// left reaches this far to meet the line, under it.
public function toLeftLine(metal: ArtBorder): Number<Length> {
  return (metal.reach.left + metal.width / 2) * metal.scale * 1ui
}

// The metal frame: Ordaen's own (art/pieces/frame-*.json, drawn by wow-dev-tools design/scripts/frame-metal.mjs), one
// bronze rod for every line. An outer side is a band of 16 texels, outside in: 4 of shadow, a black line, the rod of
// 10, a black line; the line is the inner black, so the art stands 15 texels past it, and the box's background starts
// under the rod's middle (5 texels out). The pieces are grey: `tint` makes them bronze, and the light runs round the
// box's surface, its bottom right darker by `fall` than its top left. A window's outer frame and its tabs are drawn
// at full scale, its dividers at 0.75, a small surface's frame at 0.5.
const BRONZE: Color = Color.hex("#f0b673")
const FALL = 0.4
// A divider is set into the wood: a shade darker than the frame round it.
const INLAID = 0.88
const BAND: Reach = { top: 15, right: 15, bottom: 15, left: 15 }
const BAND_LINE = 15
const BAND_INSET = -5
// A rounded corner's curve where the background meets it (the rod's middle): its piece's 32 less the 10 texels out.
const ROUND: Curves = { small: 22, large: 22, flare: 0 }
const STRAIGHT: Curves = { small: 0, large: 0, flare: 0 }
const ALL_ROUND: Corners = { topLeft: Radius.Large, topRight: Radius.Large, bottomLeft: Radius.Large, bottomRight: Radius.Large }

const BRACKET_TL: Piece = { file: "@/media/frame-corner-bracket-tl.tga", width: 32, height: 32 }
const BRACKET_TR: Piece = { file: "@/media/frame-corner-bracket-tr.tga", width: 32, height: 32 }
const BRACKET_BL: Piece = { file: "@/media/frame-corner-bracket-bl.tga", width: 32, height: 32 }
const BRACKET_BR: Piece = { file: "@/media/frame-corner-bracket-br.tga", width: 32, height: 32 }
const ROUNDED_TL: Piece = { file: "@/media/frame-corner-rounded-tl.tga", width: 32, height: 32 }
const ROUNDED_TR: Piece = { file: "@/media/frame-corner-rounded-tr.tga", width: 32, height: 32 }
const ROUNDED_BL: Piece = { file: "@/media/frame-corner-rounded-bl.tga", width: 32, height: 32 }
const ROUNDED_BR: Piece = { file: "@/media/frame-corner-rounded-br.tga", width: 32, height: 32 }

const EDGE_TOP: Piece = { file: "@/media/frame-edge-top.tga", width: 64, height: 16, tile: Tile.Across }
const EDGE_BOTTOM: Piece = { file: "@/media/frame-edge-bottom.tga", width: 64, height: 16, tile: Tile.Across }
const EDGE_LEFT: Piece = { file: "@/media/frame-edge-left.tga", width: 16, height: 64, tile: Tile.Down }
const EDGE_RIGHT: Piece = { file: "@/media/frame-edge-right.tga", width: 16, height: 64, tile: Tile.Down }

const BRACKET: FramePieces = {
  topLeft: BRACKET_TL, topRight: BRACKET_TR, bottomLeft: BRACKET_BL,
  bottomRight: BRACKET_BR, top: EDGE_TOP, bottom: EDGE_BOTTOM, left: EDGE_LEFT, right: EDGE_RIGHT,
  tint: BRONZE, fall: FALL
}
const ROUNDED: FramePieces = {
  topLeft: ROUNDED_TL, topRight: ROUNDED_TR, bottomLeft: ROUNDED_BL,
  bottomRight: ROUNDED_BR, top: EDGE_TOP, bottom: EDGE_BOTTOM, left: EDGE_LEFT, right: EDGE_RIGHT,
  tint: BRONZE, fall: FALL
}

// The divider: 12 texels of metal centred in 16, lit flat; its line at the metal's middle, 8 texels in. It draws one
// side or two, never a corner.
const DIVIDER_ACROSS: Piece = { file: "@/media/frame-divider-across.tga", width: 64, height: 16, tile: Tile.Across }
const DIVIDER_DOWN: Piece = { file: "@/media/frame-divider-down.tga", width: 16, height: 64, tile: Tile.Down }
const DIVIDER: FramePieces = {
  topLeft: ROUNDED_TL, topRight: ROUNDED_TR, bottomLeft: ROUNDED_BL,
  bottomRight: ROUNDED_BR, top: DIVIDER_ACROSS, bottom: DIVIDER_ACROSS, left: DIVIDER_DOWN,
  right: DIVIDER_DOWN, tint: BRONZE, fall: FALL, inlaid: INLAID
}
const DIVIDER_REACH: Reach = { top: 8, right: 8, bottom: 8, left: 8 }
const DIVIDER_SCALE = 0.75

const TAB_CORNERS: Corners = { topLeft: Radius.Large, topRight: Radius.Large }
const SIDE_TAB_CORNERS: Corners = { topLeft: Radius.Large, bottomLeft: Radius.Large }
const ICON_CORNER: Corners = { topLeft: Radius.Large }

// The wood: one tile, repeated at the size the picture had in the design's window.
const WOOD: Piece = { file: "@/media/window-wood.tga", width: 512, height: 512, repeatSize: 746 / 1.2 }
// The game's dark marble, repeated at its own size both ways as the game's frames tile it (`horizTile`, `vertTile`):
// never stretched, whatever the box's shape.
const MARBLE: Piece = { file: "Interface/FrameGeneral/UI-Background-Marble", width: 256, height: 256, repeatSize: 256 }

// Ordaen's art: its measures, and its pictures from this addon's `media` and the client.
public const ARTWORK: OrdaenArt = {
  frame: {
    window: { drawnFrom: BRACKET, art: EDGE_TOP, width: 1, scale: 1, inset: BAND_INSET, reach: BAND, curves: STRAIGHT, lineStart: BAND_LINE },
    small: {
      drawnFrom: ROUNDED, art: EDGE_TOP, width: 0.5, scale: 0.5, inset: BAND_INSET * 0.5, reach: BAND, radius: ALL_ROUND,
      curves: ROUND, lineStart: BAND_LINE
    },
    tab: {
      drawnFrom: ROUNDED, art: EDGE_TOP, width: 1, scale: 1, inset: BAND_INSET, reach: BAND, sides: [Side.Top, Side.Left, Side.Right],
      radius: TAB_CORNERS, curves: ROUND, lineStart: BAND_LINE
    },
    sideTab: {
      drawnFrom: ROUNDED, art: EDGE_TOP, width: 1, scale: 1, inset: BAND_INSET, reach: BAND, sides: [Side.Top, Side.Left, Side.Bottom],
      radius: SIDE_TAB_CORNERS, curves: ROUND, lineStart: BAND_LINE
    },
    tabIconClip: {
      drawnFrom: ROUNDED, art: EDGE_TOP, width: 1, scale: 1, inset: BAND_INSET, reach: BAND, sides: [], radius: ICON_CORNER,
      curves: ROUND, lineStart: BAND_LINE
    },
    tabIconLine: {
      drawnFrom: DIVIDER, art: DIVIDER_DOWN, width: DIVIDER_SCALE, scale: DIVIDER_SCALE, inset: 0, reach: DIVIDER_REACH,
      sides: [Side.Left], curves: STRAIGHT, lineStart: 8
    }
  },
  window: { wood: WOOD, marble: MARBLE },
  ctl: {
    well: { rim: { width: 1.171875dp, color: Color.hex("#3e2f1d") }, floor: Color.hex("#0000004d") },
    // The checkbox, drawn whole: the well (the light ring over it under the cursor), and the tick.
    check: { file: "@/media/ctl-check.tga", width: 64, height: 256, rows: 4, normal: 0, glow: 1 },
    tick: { file: "@/media/ctl-check.tga", width: 64, height: 256, rows: 4, normal: 2 },
    // The push button and the dropdown's face: rows 0 normal, 1 pushed, 2 disabled, 3 the light over normal, 4 the
    // accent, 5 the accent pushed; caps half as wide as it is high.
    button: { file: "@/media/button.tga", width: 256, height: 512, cap: 32, capHeight: 0.5, rows: 8, normal: 0, pressed: 1, glow: 3 },
    buttonAccent: { file: "@/media/button.tga", width: 256, height: 512, cap: 32, capHeight: 0.5, rows: 8, normal: 4, pressed: 5, glow: 3 },
    buttonDisabled: { file: "@/media/button.tga", width: 256, height: 512, cap: 32, capHeight: 0.5, rows: 8, normal: 2 },
    buttonLight: { file: "@/media/button.tga", width: 256, height: 512, cap: 32, capHeight: 0.5, rows: 8, normal: 3 },
    newGem: "@/media/ctl-new-gem.tga",
    // The slider: the groove with its edge, the fill inside it, the knob.
    groove: { file: "@/media/ctl-slider.tga", width: 64, height: 128, cap: 4, capHeight: 0.125, rows: 4, normal: 0 },
    sliderFill: { file: "@/media/ctl-slider.tga", width: 64, height: 128, rows: 4, normal: 1 },
    sliderKnob: "@/media/ctl-slider-knob.tga",
    cut: {
      across: {
        dark: { file: "@/media/groove-dark.tga", width: 64, height: 8, tile: Tile.Across },
        light: { file: "@/media/groove-light.tga", width: 64, height: 8, tile: Tile.Across }
      },
      upright: {
        dark: { file: "@/media/groove-dark-upright.tga", width: 8, height: 64, tile: Tile.Down },
        light: { file: "@/media/groove-light-upright.tga", width: 8, height: 64, tile: Tile.Down }
      }
    },
    heading: { entry: "@/media/heading-paint-entry.tga", tip: "@/media/heading-paint-tip.tga" },
    carved: "@/media/ctl-carved.tga",
    // The switch: the track, a pill with round caps (rows 0 off, 1 on, 2 the ring over either), and the knob.
    switchOff: { file: "@/media/ctl-switch-track.tga", width: 128, height: 256, cap: 32, capHeight: 0.5, rows: 4, normal: 0, glow: 2 },
    switchOn: { file: "@/media/ctl-switch-track.tga", width: 128, height: 256, cap: 32, capHeight: 0.5, rows: 4, normal: 1, glow: 2 },
    knobOff: { file: "@/media/ctl-switch-knob.tga", width: 64, height: 128, rows: 2, normal: 0 },
    knobOn: { file: "@/media/ctl-switch-knob.tga", width: 64, height: 128, rows: 2, normal: 1 },
    dropdownArrow: "@/media/dropdown-arrow.tga",
    radio: { file: "@/media/ctl-radio.tga", width: 32, height: 64, rows: 2, normal: 0 },
    radioOn: { file: "@/media/ctl-radio.tga", width: 32, height: 64, rows: 2, normal: 1 },
    // A toolbar's glyphs (art/pieces/tool.json): rows of 16 x 16 px, white with their shadow.
    tool: {
      filter: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 0 },
      sort: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 1 },
      columns: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 2 },
      categories: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 3 },
      list: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 4 },
      table: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 5 },
      refresh: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 6 },
      whom: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 7 },
      one: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 8 },
      arrange: { file: "@/media/ctl-tool-glyph.tga", width: 32, height: 512, rows: 16, normal: 9 }
    },
    // The marks (art/pieces/marks.json): 16 px cells, each triangle in its middle; the compared stat's two fill theirs.
    markUp: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 0 },
    markDown: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 1 },
    markClosed: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 2 },
    markOpen: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 3 },
    compareUp: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 4 },
    compareDown: { file: "@/media/ctl-marks.tga", width: 32, height: 256, rows: 8, normal: 5 },
    // An item slot's rim light (art/pieces/quality-rim.json): a 40 px slot's inner glow.
    qualityRim: "@/media/ctl-quality-rim.tga",
    // A crested slot's rim (art/pieces/crest-rim.json).
    crestRim: "@/media/ctl-crest-rim.tga",
    // A window's control group (art/pieces/corner.json): the plates by tone and place, the glyphs; the row by state
    // (a glyph pressed is its hover's: the mouse is on it).
    corner: {
      bronze: {
        first: { file: "@/media/ctl-corner-plate.tga", width: 128, height: 1024, rows: 16, normal: 0, hover: 1, pressed: 2 },
        next: { file: "@/media/ctl-corner-plate.tga", width: 128, height: 1024, rows: 16, normal: 3, hover: 4, pressed: 5 },
        last: { file: "@/media/ctl-corner-plate.tga", width: 128, height: 1024, rows: 16, normal: 6, hover: 7, pressed: 8 }
      },
      red: { file: "@/media/ctl-corner-plate.tga", width: 128, height: 1024, rows: 16, normal: 9, hover: 10, pressed: 11 },
      gear: { file: "@/media/ctl-corner-glyph.tga", width: 32, height: 256, rows: 8, normal: 0, hover: 1, pressed: 1 },
      expand: { file: "@/media/ctl-corner-glyph.tga", width: 32, height: 256, rows: 8, normal: 2, hover: 3, pressed: 3 },
      contract: { file: "@/media/ctl-corner-glyph.tga", width: 32, height: 256, rows: 8, normal: 4, hover: 5, pressed: 5 },
      close: { file: "@/media/ctl-corner-glyph.tga", width: 32, height: 256, rows: 8, normal: 6, hover: 7, pressed: 7 }
    },
    // A window's resize grip: the client's own.
    grip: "Interface/ChatFrame/UI-ChatIM-SizeGrabber-Up",
    gripHover: "Interface/ChatFrame/UI-ChatIM-SizeGrabber-Highlight",
    gripDown: "Interface/ChatFrame/UI-ChatIM-SizeGrabber-Down"
  },
  panel: {
    // The shapes a face is cut to: a circle, and the screen's corner; the corner's rim, from the same render.
    faceRound: "@/media/face-round-mask.tga",
    corner: "@/media/portrait-mask.tga",
    cornerRim: "@/media/portrait-rim.tga",
    badge: "@/media/level-badge.tga",
    slotEdge: { width: 1ui, color: Color.hex("#6c5535") },
    xpSteel: { file: "@/media/xp-fill-steel.tga", width: 1024, height: 32, tile: Tile.Across },
    wood: WOOD,
    edge: {
      drawnFrom: ROUNDED, art: EDGE_TOP, width: 0.5, scale: 0.5, inset: BAND_INSET * 0.5, reach: BAND, sides: [Side.Top], curves: STRAIGHT,
      lineStart: BAND_LINE
    },
    countBadge: { file: "@/media/panel-count-badge.tga", width: 128, height: 64, cap: 32, capHeight: 0.5 },
    // The experience tube, back to front: the trough, the fill, the shine, the ring.
    xpTrough: { file: "@/media/xp-tube-trough.tga", width: 256, height: 64, cap: 64, capHeight: 1 },
    xpShine: { file: "@/media/xp-tube-shine.tga", width: 256, height: 64, cap: 64, capHeight: 1 },
    xpTube: { file: "@/media/xp-tube.tga", width: 256, height: 64, cap: 64, capHeight: 1 }
  },
  // A button on the minimap's ring, drawn whole: rows 0 the button, 1 the light ring over it, 2 lit.
  minimap: {
    ring: { file: "@/media/minimap-ring.tga", width: 128, height: 512, rows: 4, normal: 0, glow: 1 },
    ringLit: { file: "@/media/minimap-ring.tga", width: 128, height: 512, rows: 4, normal: 2, glow: 1 }
  }
}
