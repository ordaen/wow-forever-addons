// A window's tabs drawn with Ordaen's own art: each tab's wood is cut by its metal's rounded corners, the open
// one's as the others', and its picture by the clip at its top left.
import { Align, Key, Track } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { Placing, Window, WindowSide, WindowTabSpec } from "@/window"
import { PushButton } from "@/pushButton"
import { space } from "@/units"

class Tabbed {
  state tabs: Array<WindowTabSpec> = [
    { title: "Professions", desc: "Tailoring 75", icon: "Interface/Icons/Trade_Tailoring" },
    { title: "Recipes" },
  ]
  state tab = 1
  state placing: Placing = { x: 0, y: 0, width: 400, height: 300 }

  public render(self): Template {
    return $ltml {
      <Window keep={"test20"} tabs={self.tabs} selected={mut self.tab} placing={mut self.placing}>
        <text value={"the page"} />
      </Window>
    }
  }
}

class Gearbox {
  state tabs: Array<WindowTabSpec> = [{ title: "Recipes" }]
  state tab = 1
  state placing: Placing = { x: 0, y: 0, width: 400, height: 300 }
  state opened = 0
  state closed = 0
  // Whether the window has the button: a window made without it has none.
  const withSettings: Boolean

  constructor(withSettings: Boolean) { self.withSettings = withSettings }

  onSettings(mut self) { self.opened += 1 }
  onClose(mut self) { self.closed += 1 }

  public render(self): Template {
    return $ltml {
      <Window keep={"test43"} tabs={self.tabs} selected={mut self.tab} placing={mut self.placing} withSettings={self.withSettings}
              @settings={self.onSettings} @close={self.onClose}>
        <text value={"the page"} />
      </Window>
    }
  }
}

// Three windows over one another (`Desk`): Alpha left, Gamma right, Beta between them and reaching further down.
// Alpha stays drawn while hidden, as the settings window does; Beta and Gamma are drawn as they open. Each body is a
// face that says which window a click reached. Where all three overlap, the click reaches the one in front.
const SCREEN_W = 1600
const SCREEN_H = 900
const SHARED: Test.Point = { x: 800, y: 470 }
const ALPHA_ONLY: Test.Point = { x: 500, y: 470 }
const GAMMA_ONLY: Test.Point = { x: 1120, y: 470 }
const BETA_ONLY: Test.Point = { x: 800, y: 720 }
// With Gamma 120 lower: its tab row's room right of its tab, over Beta's body.
const ROOM_RIGHT_OF_TABS: Test.Point = { x: 950, y: 470 }
const FACE: Color = Color.hex("#30302a")
const FOOT: Array<Track> = ["auto", { fr: 1 }, "auto"]

class Desk {
  state alphaTabs: Array<WindowTabSpec> = [{ title: "Alpha" }]
  state betaTabs: Array<WindowTabSpec> = [{ title: "Beta" }]
  state gammaTabs: Array<WindowTabSpec> = [{ title: "Gamma" }]
  state tab = 1
  state alpha: Placing = { x: -150, y: 0, width: 400, height: 200 }
  state beta: Placing = { x: 0, y: 100, width: 400, height: 400 }
  state gamma: Placing = { x: 150, y: 0, width: 400, height: 200 }
  state alphaOpen = false
  state betaOpen = false
  state gammaOpen = false
  // The window the last click on a body reached.
  public state hit: String = ""

  onAlpha(mut self) { self.hit = "Alpha" }
  onBeta(mut self) { self.hit = "Beta" }
  onGamma(mut self) { self.hit = "Gamma" }
  closeAlpha(mut self) { self.alphaOpen = false }
  closeBeta(mut self) { self.betaOpen = false }
  closeGamma(mut self) { self.gammaOpen = false }

  public render(self): Template {
    return $ltml {
      <box>
        <Window keep={"test89"} shown={self.alphaOpen} tabs={self.alphaTabs} selected={mut self.tab} placing={mut self.alpha}
                @close={self.closeAlpha}>
          <box background={FACE} @click={self.onAlpha} />
        </Window>
        <Window keep={"test93"} $if={self.betaOpen} tabs={self.betaTabs} selected={mut self.tab} placing={mut self.beta}
                @close={self.closeBeta}>
          <box background={FACE} @click={self.onBeta} />
        </Window>
        <Window keep={"test97"} $if={self.gammaOpen} tabs={self.gammaTabs} selected={mut self.tab} placing={mut self.gamma}
                @close={self.closeGamma}>
          <box background={FACE} @click={self.onGamma} />
        </Window>
      </box>
    }
  }
}

// The window a click where all three overlap reaches: the one in front. A frame passes first, as one always does
// between two clicks of the player's.
function front(desk: Desk): String {
  Test.pass(0.02)
  Test.click(SHARED, nil)
  return desk.hit
}

function near(a: Number, b: Number): Boolean { return (a - b).abs() < 0.01 }

// The control group's textures drawn now, in the order they were made: each control's plate, then its glyph, each by
// the row of its file it shows.
function corner(): String {
  let parts: Array<String> = []
  for (drawn of Test.drawn()) {
    let file = drawn.file
    if (file is String) {
      if (file.contains("ctl-corner-plate")) { parts.push(`plate ${(drawn.top * 16 + 0.5).floor()}`) }
      if (file.contains("ctl-corner-glyph")) { parts.push(`glyph ${(drawn.top * 8 + 0.5).floor()}`) }
    }
  }
  return parts.join(", ")
}

test "a window made with settings has a button in its corner that its owner hears" {
  let page = new Gearbox(true)
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.moveTo(Test.holding("the page", nil))
  Test.flush()
  Test.shot("the cursor over the window: the group's plates, settings first, then full screen and close")
  // Settings is the first bronze plate with the gear, full screen one after it with the expand glyph, close the
  // red one after it: plates of one kind, each with its glyph.
  Test.expect(corner() == "plate 0, glyph 0, plate 3, glyph 2, plate 9, glyph 6")
  // Under the cursor a plate shows its hover row, the settings plate as full screen's.
  Test.moveTo(Test.painted(Ordaen.art.ctl.corner.gear, nil))
  Test.flush()
  Test.expect(corner() == "plate 1, glyph 1, plate 3, glyph 2, plate 9, glyph 6")
  Test.moveTo(Test.painted(Ordaen.art.ctl.corner.expand, nil))
  Test.flush()
  Test.expect(corner() == "plate 0, glyph 0, plate 4, glyph 3, plate 9, glyph 6")
  Test.click(Test.painted(Ordaen.art.ctl.corner.gear, nil), nil)
  Test.expect(page.opened == 1)
  Test.expect(page.closed == 0)
  Test.click(Test.painted(Ordaen.art.ctl.corner.gear, nil), nil)
  Test.expect(page.opened == 2)
  Test.click(Test.painted(Ordaen.art.ctl.corner.close, nil), nil)
  Test.expect(page.closed == 1)
  destroy page
}

test "a window made without settings has no button" {
  let page = new Gearbox(false)
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.moveTo(Test.holding("the page", nil))
  Test.flush()
  Test.shot("the cursor over the window: full screen and close alone")
  // Full screen is then the group's first plate.
  Test.expect(corner() == "plate 0, glyph 2, plate 9, glyph 6")
  destroy page
}

// A window of many long tabs, its body given less room than they take.
class Crowded {
  state tabs: Array<WindowTabSpec> = [
    { title: "The first long tab" }, { title: "The second long tab" }, { title: "The third long tab" },
    { title: "The fourth long tab" },
  ]
  state tab = 1
  state placing: Placing = { x: 0, y: 0, width: 330, height: 200 }

  public render(self): Template {
    return $ltml {
      <Window keep={"crowded"} tabs={self.tabs} selected={mut self.tab} placing={mut self.placing} withSettings={true}>
        <text value={"the page"} />
      </Window>
    }
  }
}

test "the control group stands in the tab row: outside the body, right of the last tab, on the body's top line" {
  let page = new Gearbox(true)
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.flush()
  const body = Test.edges(Ordaen.art.window.wood, 0)
  const gear = Test.edges(Ordaen.art.ctl.corner.gear, 0)
  const close = Test.edges(Ordaen.art.ctl.corner.close, 0)
  const tab = Test.holding("Recipes", nil)
  Test.expect(gear.bottom <= body.top && close.bottom <= body.top)
  Test.expect(gear.left > tab.x && close.right <= body.right && close.right > body.right - 20)
  // Shown with the window, not only while the cursor is over it.
  Test.expect(corner() == "plate 0, glyph 0, plate 3, glyph 2, plate 9, glyph 6")
  destroy page
}

test "the window is never narrower than its tabs and its control group" {
  let page = new Crowded()
  Test.mount(page, { left: 0, top: 0, width: 1600, height: 900 })
  Test.flush()
  const last = Test.holding("The fourth long tab", nil)
  const gear = Test.edges(Ordaen.art.ctl.corner.gear, 0)
  const body = Test.edges(Ordaen.art.window.wood, 0)
  Test.expect(last.x < gear.left && body.right - body.left > 330)
  Test.shot("four long tabs on a body given 330: the window as wide as the tabs and the group, none over another")
  // The grip dragged far left: the window stops where the row would overlap.
  const grip = Test.painted(Ordaen.art.ctl.grip, nil)
  Test.moveTo(grip)
  Test.press(nil)
  Test.moveTo({ x: grip.x + 1, y: grip.y })
  Test.pass(0.05)
  Test.moveTo({ x: grip.x - 2000, y: grip.y })
  Test.pass(0.05)
  Test.release(nil)
  Test.flush()
  const narrowed = Test.edges(Ordaen.art.window.wood, 0)
  Test.expect(near(narrowed.right - narrowed.left, body.right - body.left))
  Test.expect(Test.holding("The fourth long tab", nil).x < Test.edges(Ordaen.art.ctl.corner.gear, 0).left)
  destroy page
}

test "each control in the tab row works: settings and close are heard, full screen goes and comes back" {
  let page = new Gearbox(true)
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.flush()
  const before = Test.edges(Ordaen.art.window.wood, 0)
  Test.click(Test.painted(Ordaen.art.ctl.corner.expand, nil), nil)
  Test.flush()
  const full = Test.edges(Ordaen.art.window.wood, 0)
  Test.expect(full.right - full.left > before.right - before.left + 100)
  Test.click(Test.painted(Ordaen.art.ctl.corner.contract, nil), nil)
  Test.flush()
  const back = Test.edges(Ordaen.art.window.wood, 0)
  Test.expect(near(back.right - back.left, before.right - before.left))
  Test.click(Test.painted(Ordaen.art.ctl.corner.gear, nil), nil)
  Test.click(Test.painted(Ordaen.art.ctl.corner.close, nil), nil)
  Test.expect(page.opened == 1 && page.closed == 1)
  destroy page
}

// A window that opens, or is clicked, comes in front of the others and is the one Escape closes: however often the
// player went from one to another before.
test "windows opened and clicked in turn each come to the front and take Escape" {
  Test.screen(SCREEN_W, SCREEN_H)
  let desk = new Desk()
  Test.mount(desk, { left: 0, top: 0, width: 10, height: 10 })
  desk.alphaOpen = true
  Test.flush()
  desk.betaOpen = true
  Test.flush()
  Test.expect(front(desk) == "Beta")
  // Opened last, Beta is the one Escape closes; Alpha then.
  Test.expect(Test.key(Key.Escape))
  Test.expect(!desk.betaOpen)
  Test.expect(front(desk) == "Alpha")
  desk.betaOpen = true
  Test.flush()
  Test.expect(front(desk) == "Beta")
  // Clicked where it shows alone, a window comes in front, again and again.
  for (turn of 1..=12) {
    Test.click(ALPHA_ONLY, nil)
    Test.expect(desk.hit == "Alpha")
    Test.expect(front(desk) == "Alpha")
    Test.click(BETA_ONLY, nil)
    Test.expect(desk.hit == "Beta")
    Test.expect(front(desk) == "Beta")
  }
  Test.click(ALPHA_ONLY, nil)
  // Opened after all that, Gamma stands over both and takes Escape first.
  desk.gammaOpen = true
  Test.flush()
  Test.shot("Gamma opened over Alpha and Beta")
  Test.expect(front(desk) == "Gamma")
  Test.expect(Test.key(Key.Escape))
  Test.expect(!desk.gammaOpen)
  Test.expect(front(desk) == "Alpha")
  // Alpha hidden and shown again (kept drawn) comes in front as one opened does.
  desk.gammaOpen = true
  Test.flush()
  desk.alphaOpen = false
  Test.flush()
  desk.alphaOpen = true
  Test.flush()
  Test.expect(front(desk) == "Alpha")
  Test.click(GAMMA_ONLY, nil)
  Test.expect(front(desk) == "Gamma")
  Test.expect(Test.key(Key.Escape))
  Test.expect(!desk.gammaOpen)
  Test.expect(Test.key(Key.Escape))
  Test.expect(!desk.alphaOpen)
  Test.expect(Test.key(Key.Escape))
  Test.expect(!desk.betaOpen)
  destroy desk
}

// The tab row takes the mouse on its tabs alone: a click on its room right of them reaches the window under it, and
// the tab still moves its window.
test "a click right of a window's tabs reaches the window under them" {
  Test.screen(SCREEN_W, SCREEN_H)
  let desk = new Desk()
  Test.mount(desk, { left: 0, top: 0, width: 10, height: 10 })
  // Gamma lower, its tab row over Beta's body.
  desk.gamma = { x: 150, y: 120, width: 400, height: 200 }
  desk.betaOpen = true
  Test.flush()
  desk.gammaOpen = true
  Test.flush()
  Test.click(ROOM_RIGHT_OF_TABS, nil)
  Test.expect(desk.hit == "Beta")
  Test.shot("Beta clicked through the room right of Gamma's tab")
  // Beta clicked came in front, over Gamma's tab; Gamma clicked comes back, and its tab moves it.
  Test.click({ x: 1100, y: 600 }, nil)
  Test.expect(desk.hit == "Gamma")
  Test.pass(0.02)
  const was = desk.gamma.x
  const tab = Test.holding("Gamma", nil)
  Test.moveTo(tab)
  Test.press(nil)
  // The client starts the drag once the cursor has moved: from there on the window follows it.
  Test.moveTo({ x: tab.x + 1, y: tab.y })
  Test.pass(0.02)
  Test.moveTo({ x: tab.x + 31, y: tab.y })
  Test.pass(0.1)
  Test.release(nil)
  Test.expect((desk.gamma.x - was - 30).abs() < 1)
  destroy desk
}

test "the open tab and the others are cut by their metal's corners" {
  let page = new Tabbed()
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.shot("the first tab open: its wood and its picture cut at their rounded corners, the second tab's wood too")
  Test.click(Test.holding("Recipes", nil), nil)
  Test.shot("the second tab open: cut as the first was")
  destroy page
}

// A window with a footer: «Reset» at its left, a status, «Save» at its right, on the body's bottom line.
class Footed {
  state tabs: Array<WindowTabSpec> = [{ title: "Recipes" }]
  state tab = 1
  state placing: Placing = { x: 0, y: 0, width: 400, height: 300 }
  state saved = 0
  const footer: Template = $ltml {
    <box columns={FOOT} gap={space(.Group)} yAlign={Align.Center}>
      <PushButton label={"Reset"} width={100} />
      <text value={"2 waiting"} />
      <PushButton label={"Save"} width={100} @click={self.onSave} />
    </box>
  }

  onSave(mut self) { self.saved += 1 }

  public render(self): Template {
    return $ltml {
      <Window keep={"test280"} tabs={self.tabs} selected={mut self.tab} placing={mut self.placing} footer={self.footer}>
        <box background={FACE}>
          <text value={"the page"} />
        </box>
      </Window>
    }
  }
}

test "a footer stands on the window's bottom line under the content, its groups at its ends" {
  let page = new Footed()
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.shot("the content over the footer, a group's step between them; «Reset» left, «Save» right, the panel's step over the line")
  Test.click(Test.holding("Save", nil), nil)
  Test.expect(page.saved == 1)
  destroy page
}

// A window with a side section: the list's part with its footer, and beside it the details, the full height.
class Sided {
  state tabs: Array<WindowTabSpec> = [{ title: "Market" }]
  state tab = 1
  state placing: Placing = { x: 0, y: 0, width: 600, height: 300 }
  const footer: Template = $ltml {
    <box columns={FOOT} gap={space(.Group)} yAlign={Align.Center}>
      <text value={"5 items"} />
      <box />
      <PushButton label={"Scan"} width={100} />
    </box>
  }
  const details: WindowSide = {
    width: 200,
    content: $ltml {
      <box background={FACE}>
        <text value={"the details"} />
      </box>
    },
  }

  public render(self): Template {
    return $ltml {
      <Window keep={"test321"} tabs={self.tabs} selected={mut self.tab} placing={mut self.placing} footer={self.footer}
              side={self.details}>
        <box background={FACE}>
          <text value={"the list"} />
        </box>
      </Window>
    }
  }
}

test "a side section runs the body's full height beside the main one, the frame's line between them" {
  let page = new Sided()
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.shot("the list over its footer at the left; the details from the top line to the bottom one at the right")
  destroy page
}
