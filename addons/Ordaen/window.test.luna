// A window's tabs drawn with Ordaen's own art: each tab's wood is cut by its metal's rounded corners, the open
// one's as the others', and its picture by the clip at its top left.
import Test from "$test"
import root Ordaen from "Ordaen"
import { Placing, Window, WindowTabSpec } from "@/window"

class Tabbed {
  state tabs: Array<WindowTabSpec> = [
    { title: "Professions", desc: "Tailoring 75", icon: "Interface/Icons/Trade_Tailoring" },
    { title: "Recipes" },
  ]
  state tab = 1
  state placing: Placing = { x: 0, y: 0, width: 400, height: 300 }

  public render(self): Template {
    return $ltml {
      <Window tabs={self.tabs} selected={mut self.tab} placing={mut self.placing}>
        <text value={"the page"} />
      </Window>
    }
  }
}

class Gearbox {
  state tabs: Array<WindowTabSpec> = [{ title: "Recipes" }]
  state tab = 1
  state placing: Placing = { x: 0, y: 0, width: 400, height: 300 }
  state opened = 0
  state closed = 0
  // Whether the window has the button: a window made without it has none.
  const withSettings: Boolean

  constructor(withSettings: Boolean) { self.withSettings = withSettings }

  onSettings(mut self) { self.opened += 1 }
  onClose(mut self) { self.closed += 1 }

  public render(self): Template {
    return $ltml {
      <Window tabs={self.tabs} selected={mut self.tab} placing={mut self.placing} withSettings={self.withSettings}
              @settings={self.onSettings} @close={self.onClose}>
        <text value={"the page"} />
      </Window>
    }
  }
}

// The corner group's textures drawn now, in the order they were made: each control's plate, then its glyph, each by
// the row of its file it shows.
function corner(): String {
  let parts: Array<String> = []
  for (drawn of Test.drawn()) {
    let file = drawn.file
    if (file is String) {
      if (file.contains("ctl-corner-plate")) { parts.push(`plate ${(drawn.top * 16 + 0.5).floor()}`) }
      if (file.contains("ctl-corner-glyph")) { parts.push(`glyph ${(drawn.top * 8 + 0.5).floor()}`) }
    }
  }
  return parts.join(", ")
}

test "a window made with settings has a button in its corner that its owner hears" {
  let page = new Gearbox(true)
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.moveTo(Test.holding("the page", nil))
  Test.flush()
  Test.shot("the cursor over the window: the group's plates, settings first, then full screen and close")
  // Settings is the first bronze plate with the gear, full screen one after it with the expand glyph, close the
  // red one after it: plates of one kind, each with its glyph.
  Test.expect(corner() == "plate 0, glyph 0, plate 3, glyph 2, plate 9, glyph 6")
  // Under the cursor a plate shows its hover row, the settings plate as full screen's.
  Test.moveTo(Test.painted(Ordaen.art.ctl.corner.gear, nil))
  Test.flush()
  Test.expect(corner() == "plate 1, glyph 1, plate 3, glyph 2, plate 9, glyph 6")
  Test.moveTo(Test.painted(Ordaen.art.ctl.corner.expand, nil))
  Test.flush()
  Test.expect(corner() == "plate 0, glyph 0, plate 4, glyph 3, plate 9, glyph 6")
  Test.click(Test.painted(Ordaen.art.ctl.corner.gear, nil), nil)
  Test.expect(page.opened == 1)
  Test.expect(page.closed == 0)
  Test.click(Test.painted(Ordaen.art.ctl.corner.gear, nil), nil)
  Test.expect(page.opened == 2)
  Test.click(Test.painted(Ordaen.art.ctl.corner.close, nil), nil)
  Test.expect(page.closed == 1)
  destroy page
}

test "a window made without settings has no button" {
  let page = new Gearbox(false)
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.moveTo(Test.holding("the page", nil))
  Test.flush()
  Test.shot("the cursor over the window: full screen and close alone")
  // Full screen is then the group's first plate.
  Test.expect(corner() == "plate 0, glyph 2, plate 9, glyph 6")
  destroy page
}

test "the open tab and the others are cut by their metal's corners" {
  let page = new Tabbed()
  Test.mount(page, { left: 0, top: 0, width: 800, height: 600 })
  Test.shot("the first tab open: its wood and its picture cut at their rounded corners, the second tab's wood too")
  Test.click(Test.holding("Recipes", nil), nil)
  Test.shot("the second tab open: cut as the first was")
  destroy page
}
