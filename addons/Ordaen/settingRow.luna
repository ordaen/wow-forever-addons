// SettingRow: one setting's row on a settings page: its label in a 280 px column, its control beside it, 18 px
// apart, both centred on the row. The setting's hint shows in a Tip while the cursor is on the label, never inline.
// A disabled row draws at 45%. Every settings control draws its row with it, so the rows line up. Its unnamed slot
// takes the control.
import { Align } from "$ltml"
import { Component } from "@/module"
import { Tip } from "@/tip"

const LABEL_WIDTH = 328.125dp
const LABEL: Color = Color::hex("#cbb994")

public class SettingRow implements Component {
  state hovered = false
  derived tipShown: boolean = self.hovered && self.hint != ""
  derived opacity: number = self.disabled ? 0.45 : 1

  label: Signal<string>
  hint: Signal<string>
  disabled: Signal<boolean>
  constructor(
    label: Signal<string>,
    hint: Signal<string> = "",
    disabled: Signal<boolean> = false
  ) {
    self.label = label
    self.hint = hint
    self.disabled = disabled
  }

  mut onEnter() { self.hovered = true }
  mut onLeave() { self.hovered = false }

  public render(): Template {
    return $ltml {
      <box columns={[LABEL_WIDTH, { fr: 1 }]} gap={5.5sp} yAlign={Align::Center} opacity={self.opacity}>
        <box columns={1} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
          <text value={self.label} textColor={LABEL} />
          <Tip $if={self.tipShown} title={self.label} text={self.hint} />
        </box>
        <slot />
      </box>
    }
  }
}
