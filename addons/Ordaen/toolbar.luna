// A window's toolbar: the search field and, on the same row at its right, the filter, the sort and the view as
// icon-only buttons, each opening its list under it. Every window that searches, filters, sorts or chooses a view
// draws these with it.
//
// Toolbar: the row. The search field fills what the buttons leave, its hint in dim text while it is empty, a cross at
// its right while it holds text, which clears it; the search is cleared as the window closes. The buttons are its
// unnamed slot, in the order written, each 6 px after what stands before it.
// ToolButton: a 34 px square bronze plate with a glyph; a click opens or closes what its slot holds (the caller's
// list, drawn while `open`). The glyph is gold while the list is open or while `lit` (a filter that narrows the list);
// otherwise ink. Under the cursor, while closed, a Tip names what it does and what it is set to.
// A ToolButton's picture is a glyph its colour tints, or a picture of the game's in its own colours (a bag's icon,
// `tinted` false: open, its plate's light stays on it).
// ToolPick: a ToolButton with a list of choices, as a dropdown's (the picked one's mark gold): a click on a choice
// picks it and closes the list, a click anywhere else closes it. It shows the picked choice's own glyph where the
// choice has one (a view), else its own (a sort); its Tip says the picked choice.
// ToolAct: a ToolButton's plate and glyph that does one thing when clicked (sorting the bags now), its Tip saying what.
import { Align, Art, Beside, Bounds, Edges, Layer, Line, Position, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Choice, DropdownItem, ManyItem, flippedIn, labelsOf } from "@/dropdown"
import { Component } from "@/module"
import { Column } from "@/table"
import { Tip } from "@/tip"

const SIZE = 39.84375dp
const GLYPH = 18.75dp
const GAP = 2sp
const INK: Color = Color.hex("#e8dcc4")
const GOLD: Color = Color.hex("#f0c860")
const DIM: Color = Color.hex("#a3977f")
const WHITE: Color = Color.hex("#ffffff")
const FIELD_BACK: Color = Color.hex("#00000080")
const FIELD_EDGE: Line = { width: 1.171875dp, color: Color.hex("#4a3a24") }
const FIELD_PAD: Edges = { right: 3sp, left: 3sp }
// The clear cross at the field's right, and the room the text leaves it.
const CLEAR = 18.75dp
const CLEAR_PAD: Edges = { right: 3sp }
const FIELD_PAD_CLEAR: Edges = { right: 9sp, left: 3sp }
const ROW: Array<Track> = [{ fr: 1 }, "max-content"]
const FILL: Array<Track> = [{ fr: 1 }]
// Room for every button a toolbar holds; a track no button takes is none wide (each button carries its own gap).
const TOOLS: Array<Track> = ["max-content", "max-content", "max-content", "max-content", "max-content", "max-content"]
const AFTER: Edges = { left: GAP }
const LIST_BACK: Color = Color.hex("#0a0806f7")
const LIST_EDGE: Line = { width: 1.171875dp, color: Color.hex("#6c5535") }
const LIST_PAD: Edges = { top: 2sp, bottom: 2sp }
const LIST_WIDTH = 246.09375dp

public class Toolbar implements Component {
  derived searching: Boolean = self.search != ""
  derived fieldPad: Edges = self.searching ? FIELD_PAD_CLEAR : FIELD_PAD
  // Enter in the search field: what searches at once, where typing searches only once it settles.
  public submit: Event<nil> = new Event()

  search: mut Signal<String>
  placeholder: Signal<String>
  constructor(
    search: mut Signal<String>,
    // What the field searches by, in it while it is empty.
    placeholder: Signal<String>
  ) {
    self.search = search
    self.placeholder = placeholder
  }

  // A search is the window's while it shows: it closing (or the toolbar leaving it) clears it.
  destructor() { self.search = "" }

  onSubmit(mut self) { self.submit.emit() }

  clear(mut self) { self.search = "" }

  public render(self): Template {
    return $ltml {
      <box columns={ROW} yAlign={Align.Center}>
        <box height={SIZE} rows={FILL}>
          <input value={mut self.search} padding={self.fieldPad} textColor={INK} background={FIELD_BACK}
                 border={FIELD_EDGE} @submit={self.onSubmit} />
          <box $if={!self.searching} position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
               padding={FIELD_PAD} yAlign={Align.Center} mouseThrough={true}>
            <text value={self.placeholder} textColor={DIM} wrap={.Cut} />
          </box>
          <box $if={self.searching} position={Position.Absolute} top={0ui} right={0ui} bottom={0ui} padding={CLEAR_PAD}
               yAlign={Align.Center}>
            <box width={CLEAR} height={CLEAR} background={Ordaen.art.ctl.corner.close} @pointerPress={self.clear}
                 @keyPress(.Enter)={self.clear} @keyPress(.Space)={self.clear} />
          </box>
        </box>
        <box columns={TOOLS} yAlign={Align.Center}>
          <slot />
        </box>
      </box>
    }
  }
}

public class ToolButton implements Component {
  state hovered = false
  derived tipShown: Boolean = self.hovered && !self.open
  derived glyphColor: Color = !self.tinted ? WHITE : self.open || self.lit ? GOLD : INK
  derived plate: Art = self.open && !self.tinted ? Ordaen.art.ctl.buttonAccent : Ordaen.art.ctl.button

  icon: Signal<Art>
  title: Signal<String>
  text: Signal<String>
  open: mut Signal<Boolean>
  lit: Signal<Boolean>
  const tinted: Boolean
  constructor(
    icon: Signal<Art>,
    // What it does («Sort»), and what it is set to («By name»): its Tip.
    title: Signal<String>,
    text: Signal<String>,
    open: mut Signal<Boolean>,
    lit: Signal<Boolean> = false,
    // A glyph its colour tints; false for a picture of the game's, drawn in its own colours.
    tinted: Boolean = true
  ) {
    self.icon = icon
    self.title = title
    self.text = text
    self.open = open
    self.lit = lit
    self.tinted = tinted
  }

  toggle(mut self) { self.open = !self.open }
  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box padding={AFTER}>
        <box width={SIZE} height={SIZE}>
          <box position={Position.Absolute} left={0ui} top={0ui} width={SIZE} height={SIZE} xAlign={Align.Center}
               yAlign={Align.Center} background={self.plate} @pointerPress={self.toggle} @keyPress(.Enter)={self.toggle} @keyPress(.Space)={self.toggle} @pointerEnter={self.onEnter}
               @pointerLeave={self.onLeave}>
            <box width={GLYPH} height={GLYPH} background={self.icon} tint={self.glyphColor} />
            <Tip $if={self.tipShown} title={self.title} text={self.text} />
          </box>
          <slot />
        </box>
      </box>
    }
  }
}

public class ToolAct implements Component {
  public pressed: Event<nil> = new Event()
  state hovered = false
  derived glyph: Color = self.disabled ? DIM : INK

  icon: Signal<Art>
  title: Signal<String>
  text: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    icon: Signal<Art>,
    // What it does («Sort the bags»), and how («By quality»): its Tip.
    title: Signal<String>,
    text: Signal<String>,
    disabled: Signal<Boolean> = false
  ) {
    self.icon = icon
    self.title = title
    self.text = text
    self.disabled = disabled
  }

  onClick(self) {
    if (!self.disabled) { self.pressed.emit() }
  }
  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box padding={AFTER}>
        <box width={SIZE} height={SIZE} xAlign={Align.Center} yAlign={Align.Center} background={Ordaen.art.ctl.button}
             @pointerPress={self.onClick} @keyPress(.Enter)={self.onClick} @keyPress(.Space)={self.onClick} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
          <box width={GLYPH} height={GLYPH} background={self.icon} tint={self.glyph} />
          <Tip $if={self.hovered} title={self.title} text={self.text} />
        </box>
      </box>
    }
  }
}

public class ToolPick<T: Unknown> implements Component {
  state open = false
  derived picked: Choice<T> | nil = self.choices.find(choice => choice.value == self.value)
  derived shown: String = self.picked?.label ?? ""
  derived glyph: Art = self.picked?.icon ?? self.icon

  value: mut Signal<T>
  const choices: Array<Choice<T>>
  icon: Signal<Art>
  title: Signal<String>
  lit: Signal<Boolean>
  const listBounds: Bounds
  constructor(
    value: mut Signal<T>,
    choices: Array<Choice<T>>,
    // Its glyph where the picked choice has none of its own.
    icon: Signal<Art>,
    // What it chooses («Sort»): its Tip's title, over the picked choice.
    title: Signal<String>,
    lit: Signal<Boolean> = false,
    listWidth: Number<Length> = LIST_WIDTH
  ) {
    self.value = value
    self.choices = choices
    self.icon = icon
    self.title = title
    self.lit = lit
    self.listBounds = { min: listWidth, max: nil }
  }

  close(mut self) { self.open = false }

  onPick(mut self, value: T) {
    self.value = value
    self.open = false
  }

  public render(self): Template {
    return $ltml {
      <ToolButton icon={self.glyph} title={self.title} text={self.shown} open={mut self.open} lit={self.lit}>
        <surface leading={.Row} $if={self.open} layer={Layer.Tooltip} place={Beside { beside: "parent" }} width={self.listBounds}
                 background={LIST_BACK} border={LIST_EDGE} padding={LIST_PAD} columns={1} @pointerPressOutside={self.close}>
          <DropdownItem $for={choice of self.choices} choice={choice} value={self.value} compact={true}
                        @pick={self.onPick} />
        </surface>
      </ToolButton>
    }
  }
}

// ToolMany: a ToolButton with a list of choices of which any number are picked, as a ManyDropdown's (each with its
// tick): a click on a choice picks it or lets it go and leaves the list open, a click anywhere else closes it. Its Tip
// names the picked choices, or says `none`; it is lit where the caller says the picked ones narrow the list.
public class ToolMany<T: Unknown> implements Component {
  state open = false
  derived picked: String = labelsOf(self.choices, self.value)
  derived shown: String = self.picked == "" ? self.none : self.picked

  value: mut Signal<Array<T>>
  const choices: Array<Choice<T>>
  icon: Signal<Art>
  title: Signal<String>
  none: Signal<String>
  lit: Signal<Boolean>
  const tinted: Boolean
  const listBounds: Bounds
  constructor(
    value: mut Signal<Array<T>>,
    choices: Array<Choice<T>>,
    icon: Signal<Art>,
    // What it chooses («Raises the skill»): its Tip's title, over the picked choices.
    title: Signal<String>,
    // What its Tip says while nothing is picked.
    none: Signal<String>,
    lit: Signal<Boolean> = false,
    // A glyph its colour tints; false for a picture of the game's, drawn in its own colours.
    tinted: Boolean = true,
    listWidth: Number<Length> = LIST_WIDTH
  ) {
    self.value = value
    self.choices = choices
    self.icon = icon
    self.title = title
    self.none = none
    self.lit = lit
    self.tinted = tinted
    self.listBounds = { min: listWidth, max: nil }
  }

  close(mut self) { self.open = false }

  onFlip(mut self, flipped: T) { self.value = flippedIn(self.choices, peek self.value, flipped) }

  public render(self): Template {
    return $ltml {
      <ToolButton icon={self.icon} title={self.title} text={self.shown} open={mut self.open} lit={self.lit} tinted={self.tinted}>
        <surface leading={.Row} $if={self.open} layer={Layer.Tooltip} place={Beside { beside: "parent" }} width={self.listBounds}
                 background={LIST_BACK} border={LIST_EDGE} padding={LIST_PAD} columns={1} @pointerPressOutside={self.close}>
          <ManyItem $for={choice of self.choices} choice={choice} value={self.value} @flip={self.onFlip} />
        </surface>
      </ToolButton>
    }
  }
}

// ToolSort: the sort of a table as a ToolPick, the same one its headings set: a choice for each sortable column that
// has a heading (its number, from 1), then each of `more`, a sort no column shows (a class, a role), numbered after the
// columns. A heading clicked picks its choice here, and a choice picked here lights its heading.
public class ToolSort implements Component {
  sorted: mut Signal<Integer>
  const choices: Array<Choice<Integer>>
  title: Signal<String>
  constructor(
    // The table's column and choice it is sorted by, from 1; 0 for none.
    sorted: mut Signal<Integer>,
    columns: Array<Column>,
    // What it sorts («Sort»): its Tip's title.
    title: Signal<String>,
    // Sorts no column shows, by their labels: `columns.length + 1` and on.
    more: Array<String> = []
  ) {
    self.sorted = sorted
    self.title = title
    self.choices = sortChoices(columns, more)
  }

  public render(self): Template {
    return $ltml {
      <ToolPick value={mut self.sorted} choices={self.choices} icon={Ordaen.art.ctl.tool.sort} title={self.title} />
    }
  }
}

// The choices of a ToolSort: the sortable columns with a heading, then the sorts no column shows.
public function sortChoices(columns: Array<Column>, more: Array<String>): Array<Choice<Integer>> {
  const list: Array<Choice<Integer>> = []
  for (index, column of columns) {
    if (column.sortable == true && column.title != "") { list.push({ value: index, label: column.title }) }
  }
  for (index, label of more) { list.push({ value: columns.length + index, label: label }) }
  return list
}
