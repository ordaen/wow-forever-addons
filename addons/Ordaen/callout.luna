// Callout: a pointer at something on the screen the player should look at, as the client's own help tip and micro
// button alert are, in one of two looks (`CalloutLook`). Framed: the small metal frame round the windows' wood, a
// title in white and its text under it in the label colour, the window's close glyph at its top right where it is
// closable, and the client's help-tip arrow in gold. Speech: the client's own chat bubble made one colour, with its
// title (a count: the whispers waiting unread) in white, no close, and the bubble's tail in its colour where the arrow
// would be. It stands beside a frame of the game's, over it or under it (`CalloutSide`), on the dialogs' layer over the
// windows. The arrow (or tail) stands on the frame's middle, its point a gap short of the frame's edge; the bubble is
// centred over it and kept on the screen, so by a frame at the screen's edge the bubble moves inward and the arrow
// stays on the frame. Its owner shows it while what it says holds; the close glyph says the player has read it
// (`close`), and the owner hides it.
import { Align, Anchored, Edges, Frame, Layer, NineSlice, Point, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { BRIGHT_TEXT, SECONDARY_TEXT, TITLE_TEXT } from "@/units"

// Which side of the frame it stands on.
public enum CalloutSide { Above, Below }

// How it looks: framed, with a close glyph or without; or a chat bubble of one colour.
public enum CalloutLook {
  Framed { closable: boolean }
  Speech { tone: Color }
}

// As wide as what it says, up to its most: a long text wraps there.
const MOST = 468.75dp
const LABEL: Color = Color::hex("#cbb994")
const GOLD: Color = Color::hex("#f0c860")
// The client's help-tip arrow (65 by 28 px), pointing down as drawn; the gap from its point to the frame; how far the
// bubble comes over the arrow's base, so they meet.
const ARROW: Atlas = "helptip-arrow"
const ARROW_WIDTH = 38.0859375dp
const ARROW_HEIGHT = 16.40625dp
const GAP = 2.34375dp
const MEET = 2.34375dp
// The client's chat bubble: its nine pieces (corners and edges 16 units, as the client draws them), its tail (16 by
// 16, pointing down as drawn), which comes over the bubble's bottom edge as far as the edge's rim stands in from it.
const BUBBLE: NineSlice = { layout: "ChatBubble" }
const TAIL: Atlas = "ChatBubble-Tail"
const TAIL_SIZE = 16ui
const TAIL_MEET = 8ui
// The bubble is never smaller than its corners; its count stands in from its rim.
const BUBBLE_LEAST = 32ui
const BUBBLE_PAD: Edges = { top: 0sp, right: 3sp, bottom: 0sp, left: 3sp }
const GLYPH = 18.75dp
const HEAD: array<Track> = [{ fr: 1 }, "max-content"]
const PAD: number<Spacing> = 5sp

// Where the arrow stands: its point on the frame's top middle, or on its bottom middle.
function arrowPlaceOf(by: any Frame, side: CalloutSide): Anchored {
  if (side == CalloutSide::Above) {
    return { point: Point::Bottom, to: Point::Top, y: -GAP, by: by }
  }
  return { point: Point::Top, to: Point::Bottom, y: GAP, by: by }
}

// Where the bubble stands: centred past the arrow's base.
function bubblePlaceOf(by: any Frame, side: CalloutSide, arrowHeight: number<Length>, meet: number<Length>): Anchored {
  const past: number<Length> = GAP + arrowHeight - meet
  if (side == CalloutSide::Above) {
    return { point: Point::Bottom, to: Point::Top, y: -past, by: by }
  }
  return { point: Point::Top, to: Point::Bottom, y: past, by: by }
}

// A speech bubble's colour; nil for a framed callout.
function toneOf(look: CalloutLook): Color | nil {
  match (look) {
    .Framed => return nil
    .Speech => return look.tone
  }
}

// Whether a framed callout has its close glyph.
function closableOf(look: CalloutLook): boolean {
  match (look) {
    .Framed => return look.closable
    .Speech => return false
  }
}

public class Callout implements Component {
  public close: Event<nil> = new Event()

  derived tone: Color | nil = toneOf(self.look)
  derived speech: boolean = self.tone != nil
  derived framed: boolean = !self.speech
  derived closable: boolean = closableOf(self.look)
  derived arrow: Atlas = self.speech ? TAIL : ARROW
  derived arrowWidth: number<Length> = self.speech ? TAIL_SIZE : ARROW_WIDTH
  derived arrowHeight: number<Length> = self.speech ? TAIL_SIZE : ARROW_HEIGHT
  derived arrowPlace: Anchored = arrowPlaceOf(self.by, self.side)
  derived bubblePlace: Anchored = bubblePlaceOf(self.by, self.side, self.arrowHeight, self.speech ? TAIL_MEET : MEET)
  derived turn: number<Angle> = self.side == CalloutSide::Above ? 0deg : 180deg
  derived hasText: boolean = self.text != ""
  derived arrowTint: Color = self.tone ?? GOLD

  by: Signal<any Frame>
  title: Signal<string>
  text: Signal<string>
  side: Signal<CalloutSide>
  look: Signal<CalloutLook>
  pulse: Signal<boolean>
  constructor(
    // The frame it points at.
    by: Signal<any Frame>,
    title: Signal<string>,
    // Under the title, in a framed callout.
    text: Signal<string> = "",
    side: Signal<CalloutSide> = CalloutSide::Above,
    look: Signal<CalloutLook> = CalloutLook::Framed { closable: true },
    // It fades and comes back, over and over, while this holds: something waits for a look (unread whispers).
    pulse: Signal<boolean> = false
  ) {
    self.by = by
    self.title = title
    self.text = text
    self.side = side
    self.look = look
    self.pulse = pulse
  }

  mut onClose() { self.close.emit() }

  public render(): Template {
    return $ltml {
      <surface $if={self.framed} layer={Layer::Dialog} place={self.bubblePlace} clamp={true} columns={1}>
        <box leading={.Tight} border={Ordaen.art.frame.small} background={Ordaen.art.window.wood} padding={PAD}
             columns={1} gap={2sp} width={{ min: nil, max: MOST }} pulse={self.pulse}>
          <box columns={HEAD} gap={3sp}>
            <text value={self.title} textColor={BRIGHT_TEXT} textSize={TITLE_TEXT} leading={.Title} />
            <box $if={self.closable} width={GLYPH} height={GLYPH} background={Ordaen.art.ctl.corner.close}
                 @pointerPress={self.onClose} />
          </box>
          <text $if={self.hasText} value={self.text} textColor={LABEL} />
        </box>
      </surface>
      <surface $if={self.speech} layer={Layer::Dialog} place={self.bubblePlace} clamp={true} columns={1}>
        <box width={{ min: BUBBLE_LEAST, max: nil }} height={BUBBLE_LEAST} padding={BUBBLE_PAD} background={BUBBLE}
             desaturate={true} tint={self.tone} xAlign={Align::Center} yAlign={Align::Center} pulse={self.pulse}>
          <text value={self.title} textSize={SECONDARY_TEXT} textColor={BRIGHT_TEXT} textFont={.Numbers}
                leading={.Tight} wrap={.None} />
        </box>
      </surface>
      <surface layer={Layer::Dialog} place={self.arrowPlace} columns={1}>
        <box width={self.arrowWidth} height={self.arrowHeight} background={self.arrow} desaturate={true}
             tint={self.arrowTint} rotation={self.turn} pulse={self.pulse} />
      </surface>
    }
  }
}
