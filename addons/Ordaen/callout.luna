// Callout: a pointer at something on the screen the player should look at, as the client's own help tip and micro
// button alert are (an unspent talent point, by the button that opens the talents): the small metal frame round the
// windows' wood, a title in white and its text under it in the label colour, the window's close glyph at its top right,
// and the client's help-tip arrow, gold, on the side facing what it points at. It stands beside a frame of the game's,
// over it or under it (`CalloutSide`), its arrow's point a gap short of the frame's edge, kept on the screen, on the
// dialogs' layer over the windows. Its owner shows it while what it says holds; the close glyph says the player has
// read it (`close`), and the owner hides it.
import { Align, Anchored, Frame, Layer, Point, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { BRIGHT_TEXT, TIGHT_LINE, TITLE_LINE, TITLE_TEXT } from "@/units"

// Which side of the frame it stands on.
public enum CalloutSide { Above, Below }

// As wide as what it says, up to its most: a long text wraps there.
const MOST = 468.75dp
const LABEL: Color = Color.hex("#cbb994")
const GOLD: Color = Color.hex("#f0c860")
// The client's help-tip arrow (65 by 28 px), pointing down as drawn; the gap from its point to the frame.
const ARROW: Atlas = "helptip-arrow"
const ARROW_WIDTH = 38.0859375dp
const ARROW_HEIGHT = 16.40625dp
const GAP = 2.34375dp
const GLYPH = 18.75dp
const HEAD: Array<Track> = [{ fr: 1 }, "max-content"]
const PAD: Number<Spacing> = 5sp

// Where it stands by the frame: its foot on the frame's top, or its head on the frame's bottom.
function placeOf(by: any Frame, side: CalloutSide): Anchored {
  if (side == CalloutSide.Above) {
    return { point: Point.Bottom, to: Point.Top, y: -GAP, by: by }
  }
  return { point: Point.Top, to: Point.Bottom, y: GAP, by: by }
}

public class Callout implements Component {
  public close: Event<nil> = new Event()

  derived place: Anchored = placeOf(self.by, self.side)
  derived above: Boolean = self.side == CalloutSide.Above
  derived turn: Number<Angle> = self.above ? 0deg : 180deg
  derived hasText: Boolean = self.text != ""

  by: Signal<any Frame>
  title: Signal<String>
  text: Signal<String>
  side: Signal<CalloutSide>
  constructor(
    // The frame it points at.
    by: Signal<any Frame>,
    title: Signal<String>,
    text: Signal<String> = "",
    side: Signal<CalloutSide> = CalloutSide.Above
  ) {
    self.by = by
    self.title = title
    self.text = text
    self.side = side
  }

  onClose(mut self) { self.close.emit() }

  public render(self): Template {
    return $ltml {
      <surface layer={Layer.Dialog} place={self.place} clamp={true} columns={1} xAlign={Align.Center}>
        <box $if={!self.above} width={ARROW_WIDTH} height={ARROW_HEIGHT} background={ARROW} desaturate={true}
             tint={GOLD} rotation={self.turn} />
        <box lineHeight={TIGHT_LINE} border={Ordaen.art.frame.small} background={Ordaen.art.window.wood} padding={PAD}
             columns={1} gap={2sp} width={{ min: nil, max: MOST }}>
          <box columns={HEAD} gap={3sp}>
            <text value={self.title} textColor={BRIGHT_TEXT} textSize={TITLE_TEXT} lineHeight={TITLE_LINE} />
            <box width={GLYPH} height={GLYPH} background={Ordaen.art.ctl.corner.close} @pointerPress={self.onClose} />
          </box>
          <text $if={self.hasText} value={self.text} textColor={LABEL} />
        </box>
        <box $if={self.above} width={ARROW_WIDTH} height={ARROW_HEIGHT} background={ARROW} desaturate={true}
             tint={GOLD} rotation={self.turn} />
      </surface>
    }
  }
}
