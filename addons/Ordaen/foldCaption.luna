// FoldCaption: a section's caption in a list that folds (a category of items, a quest log's zone): the open or closed
// mark, then its title in gold, then what the list puts after it (the slot: a note, a count at the row's right), filling
// the row. A click anywhere on the row, Enter or Space reports `toggled`; whether it is folded is the owner's, which
// says so through `folded`.
import { Align, Art, ByInteractionState, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { rowShade } from "@/pickRow"

const GOLD: Color = Color::hex("#e8c35a")
const MARK = 14.0625dp
const COLUMNS: array<Track> = ["max-content", "max-content", { fr: 1 }]
// The whole row takes the click: it shades under the cursor and the keyboard's focus, as a list's row does.
const SHADE: Color | ByInteractionState<Color> = rowShade(false)

public class FoldCaption implements Component {
  public toggled: Event<nil> = new Event()

  derived mark: Art = self.folded ? Ordaen.art.ctl.markClosed : Ordaen.art.ctl.markOpen

  title: Signal<string>
  folded: Signal<boolean>
  constructor(title: Signal<string>, folded: Signal<boolean>) {
    self.title = title
    self.folded = folded
  }

  mut onToggle() { self.toggled.emit() }

  public render(): Template {
    return $ltml {
      <box columns={COLUMNS} gap={2sp} yAlign={Align::Center} background={SHADE} @pointerPress={self.onToggle}
           @keyPress(.Enter)={self.onToggle} @keyPress(.Space)={self.onToggle}>
        <box width={MARK} height={MARK} background={self.mark} />
        <text value={self.title} textColor={GOLD} wrap={.None} />
        <box yAlign={Align::Center}>
          <slot />
        </box>
      </box>
    }
  }
}
