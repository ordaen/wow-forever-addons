// FoldCaption: a section's caption in a list that folds (a category of items): the open or closed mark, then its
// title in gold. A click, Enter or Space reports `toggled`; whether it is folded is the owner's, which says so through
// `folded`.
import { Align, Art, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { space } from "@/units"

const GOLD: Color = Color.hex("#e8c35a")
const MARK = 14.0625dp
const COLUMNS: Array<Track> = ["max-content", "max-content"]

public class FoldCaption implements Component {
  public toggled: Event<nil> = new Event()

  derived mark: Art = self.folded ? Ordaen.art.ctl.markClosed : Ordaen.art.ctl.markOpen

  title: Signal<String>
  folded: Signal<Boolean>
  constructor(title: Signal<String>, folded: Signal<Boolean>) {
    self.title = title
    self.folded = folded
  }

  onToggle(mut self) { self.toggled.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={COLUMNS} gap={space(.Line)} yAlign={Align.Center} xAlignSelf={Align.Start} @pointerPress={self.onToggle}
           @keyPress(.Enter)={self.onToggle} @keyPress(.Space)={self.onToggle}>
        <box width={MARK} height={MARK} background={self.mark} />
        <text value={self.title} textColor={GOLD} wrap={false} />
      </box>
    }
  }
}
