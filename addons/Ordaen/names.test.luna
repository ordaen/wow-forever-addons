// A class's colour by its tag, a text as the player meant it, and a page's field.
import Client from "$client"
import Test from "$test"
import { Field } from "@/field"
import { classColor, trimmed } from "@/names"

test "a class's colour is the client's by its tag, whole; a tag it doesn't know has none" {
  const rgb = Client::RAID_CLASS_COLORS["MAGE"]
  const mage = classColor("MAGE")
  Test::expect(rgb == nil ? mage == nil : mage?.r == rgb.r && mage?.a == 1)
  Test::expect(classColor("NOT_A_CLASS") == nil && classColor(nil) == nil)
}

test "a text is trimmed of the spaces before and after, never of those inside" {
  Test::expect(trimmed("  Regy Ironsight ") == "Regy Ironsight")
  Test::expect(trimmed("   ") == "")
}

class Holder {
  state text = ""
  state said = 0
  onSubmit(mut self) { self.said += 1 }
  public render(self): Template {
    return $ltml { <box width={300dp}> <Field value={mut self.text} placeholder={"Name"} @submit={self.onSubmit} /> </box> }
  }
}

test "a field says what it asks for while it is empty, and takes what is typed" {
  const page = new Holder()
  Test::mount(page, { left: 0, top: 0, width: 400, height: 100 })
  Test::expect(Test::page().text("Name").shown())
  Test::page().input().type("Regy")
  Test::expect(page.text == "Regy" && !Test::page().text("Name").shown())
}
