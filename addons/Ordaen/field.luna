// Field: a line the player types in, sunk into the page as `TextField`'s field is (dark, with a fine bronze edge), as
// wide as where it stands, with what it asks for dim in it while it is empty. Enter reports `submit`. A page's own
// field (a dialog's name, a letter's subject), where `TextField` is a setting's row.
import { Align, Edges, Line, Position } from "$ltml"
import { Component } from "@/module"

const INK: Color = Color::hex("#e8dcc4")
const DIM: Color = Color::hex("#a3977f")
// The field's floor and its edge: what a field of the client's placed in a page is dressed in too (the chat's input).
public const FIELD_FILL: Color = Color::hex("#0d0a08")
public const FIELD_EDGE: Line = { width: 1.171875dp, color: Color::hex("#4a3a24") }
const PADDING: Edges = { right: 2.5sp, left: 2.5sp }
// A line of text and its padding.
public const FIELD_HEIGHT: Number<Length> = 35.15625dp

public class Field implements Component {
  public submit: Event<nil> = new Event()

  derived empty: Boolean = self.value == ""

  value: mut Signal<String>
  const maxLength: Integer | nil
  placeholder: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    value: mut Signal<String>,
    // The most characters it takes; any number when left out.
    maxLength: Integer | nil = nil,
    // What it asks for, dim in it while it is empty.
    placeholder: Signal<String> = "",
    disabled: Signal<Boolean> = false
  ) {
    self.value = value
    self.maxLength = maxLength
    self.placeholder = placeholder
    self.disabled = disabled
  }

  onSubmit(mut self) { self.submit.emit() }

  public render(self): Template {
    return $ltml {
      <box height={FIELD_HEIGHT} rows={[{ fr: 1 }]}>
        <input value={mut self.value} maxLength={self.maxLength} padding={PADDING} background={FIELD_FILL} border={FIELD_EDGE}
               textColor={INK} disabled={self.disabled} @submit={self.onSubmit} />
        <box $if={self.empty} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} padding={PADDING}
             yAlign={Align::Center} mouseThrough={true}>
          <text value={self.placeholder} textColor={DIM} wrap={.None} />
        </box>
      </box>
    }
  }
}
