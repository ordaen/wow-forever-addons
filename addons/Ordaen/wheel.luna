// Wheel: a ring of up to eight items round a middle, aimed by the direction the cursor went from where it was as the
// wheel opened, whatever the distance. Each item is a slice of the ring cut in the bank's stone, a gap off each side,
// its icon a square set into a hollow carved in the stone, whole over it (the hollow's lip shows round it); the slice
// aimed at is lit warm with a gold outline, its icon outlined gold. A submenu or a slot of several has a band of segments along its slice's outer edge, one for each of its items,
// edge to edge, the one the slice shows (stepped to by the mouse wheel, or a slot's current) solid gold. The middle
// names what is aimed at and what the hand can do there (`WheelMiddle`, the owner's words), with the ring's own icon
// above in a submenu. An item that can't be used now is dimmed where it stands, never taken away, so a direction stays
// the same item; its state shows as the action bars show it (its cooldown's sweep, charges or a count, red out of
// range, blue without the power). The icons glide out from the middle as it opens. The choice is the owner's
// (`chosen`, by `slotAt`): the secure part (`SecureWheel`) and this art work it out by one formula, written once for
// each (`slotAt`, `SLOT_LUA`), which a test holds to the same answers. Every slice, segment and curved outline is a box
// as large as the wheel, cut by masks (`art/pieces/radial.json`): a ring for its radii and two half-planes turned to
// its two edges; the straight edges are thin boxes turned along them.
import { Align, Art, FillDuration, Line, Mask, Piece, Position, TextAlign } from "$ltml"
import { Component } from "@/module"
import { BRIGHT_TEXT, SECONDARY_TEXT } from "@/units"

// Eight to a ring at most: four sides and four corners, aimed by feel.
public const WHEEL_MOST = 8
// Round the middle, the cursor chooses nothing (at a scale of 1).
public const DEAD_ZONE = 30dp

// The item a direction chooses: 0 in the dead zone round the middle, else the item whose slice holds the direction,
// item 1 straight up and the rest clockwise, each slice centred on its item. `dx` right and `dy` up from the middle.
public function slotAt(dx: number, dy: number, count: integer, dead: number): integer {
  if (count < 1 || dx * dx + dy * dy < dead * dead) { return 0 }
  const share = (dx.atan2(dy) / (2 * number::pi) + 1 + 0.5 / count) % 1
  return ((share * count).floor() + 1).min(count)
}

// `slotAt` as the client's restricted code runs it: from `dx`, `dy`, `count` and `dead`, it sets `slot`.
public const SLOT_LUA: string = [
  "local slot = 0",
  "if count > 0 and dx * dx + dy * dy >= dead * dead then",
  "  local share = (math.atan2(dx, dy) / (2 * math.pi) + 1 + 0.5 / count) % 1",
  "  slot = math.floor(share * count) + 1",
  "  if slot > count then slot = count end",
  "end"
].join("\n")

// How the items' names show: never, the one aimed at's in the middle, or that and every item's under its icon (an
// item with no icon has its name in its hollow already).
public enum WheelNames implements Plain { Off = "off", Chosen = "chosen", Always = "always" }

// One item of a ring as it is drawn.
public struct WheelItem {
  name: string
  // Its picture; none: its name, written in its hollow instead (an emote's command).
  icon: Art | nil
  // Dimmed where it stands: it can't be used now.
  dim: boolean
  // What its icon says as the action bars do: charges or a count (`""`: nothing); the icon tinted red out of range or
  // blue without the power it costs (none: as it is); its cooldown's run.
  count: string
  tone: Color | nil
  cooldown: FillDuration | nil
  // A submenu or a slot of several: how many items it holds (its band's segments, eight at most; 0: no band), and
  // the one the slice shows (0: none).
  segments: integer
  segment: integer
}

// An item that is a plain picture and a name, with no state.
public function plainItem(name: string, icon: Art | nil, dim: boolean): WheelItem {
  return { name: name, icon: icon, dim: dim, count: "", tone: nil, cooldown: nil, segments: 0, segment: 0 }
}

// What the middle says, one thing a line: the name of what is aimed at (or of the ring shown), dimmed where nothing
// is aimed at, and what the hand can do now, each its own line under it; three lines at most, none wrapped.
public struct WheelMiddle {
  name: string
  hints: array<string>
  dim: boolean
}

// The lines the middle holds at most: the name and two hints.
const MIDDLE_LINES = 3

// A piece of the ring as large as the wheel, cut by its masks.
struct Cut {
  art: Art
  tint: Color
  opacity: number
  masks: array<Mask>
}

// A straight edge: a thin box turned along a direction from the middle, between two radii.
struct Edge {
  left: number<Length>
  top: number<Length>
  width: number<Length>
  height: number<Length>
  turn: number<Angle>
  tint: Color
  opacity: number
}

// An item's icon where it stands.
struct Spot {
  item: WheelItem
  left: number<Length>
  top: number<Length>
  chosen: boolean
}

// The wheel's lengths at a scale of 1: the ring between its inner and outer edge, a band of segments inside the outer
// edge, the icons' squares halfway between the inner edge and the band, the round middle inside the inner edge.
public const WHEEL_SIZE = 380dp
const INNER = 88dp
const OUTER = 178dp
const BAND = 162dp
// The gap off each side of a slice; a ring of one is whole.
const GAP = 1.2deg
const ICON = 40dp
const ICON_AT = 125dp
// An icon's hollow: its square and the lip round it.
const CARVE = 48dp
// A name with no picture, in its wedge: kept this far off the wedge's sides and the ring's edges, and never wider than
// this (a ring of one or two items).
const WORDS_INSET = 6dp
const WORDS_MOST = 120dp
const MIDDLE = 168dp
const CATEGORY = 30dp
const RIM = 2dp
const OUTLINE_WIDTH = 1.5dp
const LIT_WIDTH = 2dp
// The icon aimed at, outlined.
const ICON_LIT: Line = { width: LIT_WIDTH, color: Color::hex("#ffd100") }
const SEPARATOR = 2dp
const MIDDLE_TEXT = 140dp

const PLAIN: Asset = "Interface/Buttons/WHITE8X8"
// The client's round mask: what shows of a box is a circle.
const ROUND: Asset = "Interface/CHARACTERFRAME/TempPortraitAlphaMask"
// The client's bank stone, tiled at its size across the wheel, a little darker.
const STONE: Piece = { file: "Interface/BankFrame/Bank-Background", width: 256, height: 256, repeatSize: 256 }
const STONE_TINT: Color = Color::hex("#e6e6e6")
// The masks: the right half of the wheel (turned, what lies clockwise of a direction for half a turn), the slices'
// ring, a band's ring, the slices' curved edges, a band's inner edge.
const HALF: Asset = "@/media/radial-half.tga"
const RING_SLICE: Asset = "@/media/radial-ring-slice.tga"
const RING_BAND: Asset = "@/media/radial-ring-band.tga"
const LINES_SLICE: Asset = "@/media/radial-lines-slice.tga"
const LINE_BAND: Asset = "@/media/radial-line-band.tga"
// The slices' shade towards the middle, and the warmth of the one aimed at.
const SHADE: Asset = "@/media/radial-shade.tga"
const WARM: Asset = "@/media/radial-warm.tga"
// An icon's hollow, under the icon: its lip round the icon's square.
const CARVED: Asset = "@/media/radial-carve.tga"
const MIDDLE_ART: Asset = "@/media/radial-middle.tga"

const OUTLINE: Color = Color::hex("#3e2f1d")
const GOLD: Color = Color::hex("#ffd100")
const SHADOW: Color = Color::hex("#000000")
const BRONZE: Color = Color::hex("#8c6a3f")
// An icon in its hollow, a little darker than itself; aimed at, as it is.
const HOLLOW: Color = Color::hex("#e0e0e0")
const NAME: Color = Color::hex("#f3e1b8")
const NAME_DIM: Color = Color::hex("#a3977f")
const HINT: Color = Color::hex("#8a7d66")
const WHITE: Color = Color::hex("#ffffff")
const DIM_OPACITY = 0.55
// A band's segment not shown, over a slice not aimed at and over the one aimed at.
const SEGMENT_OFF = 0.38
const SEGMENT_OFF_AIMED = 0.25

// An item's direction: item 1 up, the rest clockwise.
public function itemTurn(index: integer, count: integer): number<Angle> {
  return (index - 1) * 360deg / count
}

// How wide a slice of a ring of `count` is, its gaps taken off.
// How wide an item's name may stand in its wedge, at a scale of 1: the wedge's width at the band, its widest, less a
// margin each side (a long word reaches into the wedge's outer part); a ring of one or two, no wider than this.
function wordsWidthOf(count: integer): number<Length> {
  const across = 2 * BAND * (number::pi / count.max(1)).sin()
  return (across - 2 * WORDS_INSET).min(WORDS_MOST)
}

function sliceTurn(count: integer): number<Angle> {
  return count == 1 ? 360deg : 360deg / count - 2 * GAP
}

// What cuts a piece of the ring `ring` gives to the part between two directions, clockwise from `from` to `to`
// (half a turn at most): the ring, what lies clockwise of `from`, what lies before `to`. A whole turn, the ring alone.
function cutting(ring: Asset, from: number<Angle>, to: number<Angle>): array<Mask> {
  if (to - from >= 360deg) { return [{ art: ring }] }
  return [{ art: ring }, { art: HALF, turn: from }, { art: HALF, turn: to - 180deg }]
}

public class Wheel implements Component {
  // Every length, by the ring's scale.
  derived size: number<Length> = WHEEL_SIZE * self.scale
  derived count: integer = self.items.length.min(WHEEL_MOST)
  derived cuts: array<Cut> = self.cutsOf()
  derived edges: array<Edge> = self.edgesOf()
  derived spots: array<Spot> = self.spotsOf()
  // The items with a picture, each in its hollow; those with none, their name right in the wedge.
  derived pictured: array<Spot> = self.spots.filter(spot => spot.item.icon != nil)
  derived worded: array<Spot> = self.spots.filter(spot => spot.item.icon == nil)
  derived wordsWidth: number<Length> = wordsWidthOf(self.count) * self.scale
  derived wordsHeight: number<Length> = (BAND - INNER - 2 * WORDS_INSET) * self.scale
  derived middleSize: number<Length> = MIDDLE * self.scale
  derived categorySize: number<Length> = CATEGORY * self.scale
  derived named: boolean = self.middle.name != "" && self.names != WheelNames::Off
  derived hints: array<string> = self.hintsOf()

  items: Signal<array<WheelItem>>
  chosen: Signal<integer>
  middle: Signal<WheelMiddle>
  names: Signal<WheelNames>
  scale: Signal<number>
  opening: Signal<number>
  category: Signal<Art | nil>
  constructor(
    // The ring's items, up to `WHEEL_MOST`, item 1 up and the rest clockwise.
    items: Signal<array<WheelItem>>,
    // The item the cursor's direction chooses (`slotAt`): 0 for none.
    chosen: Signal<integer>,
    middle: Signal<WheelMiddle>,
    names: Signal<WheelNames>,
    scale: Signal<number> = 1,
    // How far it has opened, 0 to 1: the icons' distance from the middle.
    opening: Signal<number> = 1,
    // The icon of the ring shown, in the middle: a submenu's or a slot's own; none on the first ring.
    category: Signal<Art | nil> = nil
  ) {
    self.items = items
    self.chosen = chosen
    self.middle = middle
    self.names = names
    self.scale = scale
    self.opening = opening
    self.category = category
  }

  // The hints the middle has room for under the name.
  hintsOf(): array<string> {
    const room = MIDDLE_LINES - (self.named ? 1 : 0)
    const hints: array<string> = []
    for (index, hint of self.middle.hints) {
      if (index <= room) { hints.push(hint) }
    }
    return hints
  }

  // Slice `index`'s two edges.
  sides(index: integer): (number<Angle>, number<Angle>) {
    const middle = itemTurn(index, self.count)
    const half = sliceTurn(self.count) / 2
    return (middle - half, middle + half)
  }

  // The curved pieces, under to over: each slice's stone, its shade, its curved edges; each band's segments and its
  // inner edge (gold in the slice aimed at); the slice aimed at, lit, and its curved edges gold.
  cutsOf(): array<Cut> {
    const count = self.count
    const cuts: array<Cut> = []
    for (index, item of self.items) {
      if (index <= count) {
        const sides = self.sides(index)
        const opacity = item.dim ? DIM_OPACITY : 1
        cuts.push({ art: STONE, tint: STONE_TINT, opacity: opacity, masks: cutting(RING_SLICE, sides[1], sides[2]) })
        cuts.push({ art: SHADE, tint: WHITE, opacity: opacity, masks: cutting(RING_SLICE, sides[1], sides[2]) })
        cuts.push({ art: PLAIN, tint: OUTLINE, opacity: 1, masks: cutting(LINES_SLICE, sides[1], sides[2]) })
      }
    }
    for (index, item of self.items) {
      const several = item.segments.min(WHEEL_MOST)
      if (index <= count && several > 0) {
        const sides = self.sides(index)
        const each = (sides[2] - sides[1]) / several
        const aimed = self.chosen == index
        for (segment of 1..several) {
          const on = segment == item.segment
          const from = sides[1] + (segment - 1) * each
          cuts.push({
            art: PLAIN, tint: on ? GOLD : SHADOW, opacity: on ? 1 : aimed ? SEGMENT_OFF_AIMED : SEGMENT_OFF,
            masks: cutting(RING_BAND, from, from + each)
          })
        }
        cuts.push({ art: PLAIN, tint: aimed ? GOLD : OUTLINE, opacity: 1, masks: cutting(LINE_BAND, sides[1], sides[2]) })
      }
    }
    const chosen = self.chosen
    if (chosen >= 1 && chosen <= count) {
      const sides = self.sides(chosen)
      cuts.push({ art: WARM, tint: WHITE, opacity: 1, masks: cutting(RING_SLICE, sides[1], sides[2]) })
      cuts.push({ art: PLAIN, tint: GOLD, opacity: 1, masks: cutting(LINES_SLICE, sides[1], sides[2]) })
    }
    return cuts
  }

  // A thin box along the direction `turn`, between two radii.
  edge(turn: number<Angle>, from: number<Length>, to: number<Length>, width: number<Length>, tint: Color, opacity: number): Edge {
    const r = turn / 1rad
    const scale = self.scale
    const out = (from + to) / 2 * scale
    const long = (to - from) * scale
    return {
      left: self.size / 2 + r.sin() * out - width * scale / 2, top: self.size / 2 - r.cos() * out - long / 2,
      width: width * scale, height: long, turn: turn, tint: tint, opacity: opacity
    }
  }

  // The straight edges: each slice's two, the lines between a band's segments (gold in the slice aimed at, as its
  // band's inner edge is), the slice aimed at's two gold.
  edgesOf(): array<Edge> {
    const count = self.count
    const edges: array<Edge> = []
    if (count < 2) { return edges }
    for (index, item of self.items) {
      if (index <= count) {
        const sides = self.sides(index)
        edges.push(self.edge(sides[1], INNER, OUTER, OUTLINE_WIDTH, OUTLINE, 1))
        edges.push(self.edge(sides[2], INNER, OUTER, OUTLINE_WIDTH, OUTLINE, 1))
        const several = item.segments.min(WHEEL_MOST)
        const each = (sides[2] - sides[1]) / (1).max(several)
        const tint = self.chosen == index ? GOLD : OUTLINE
        for (line of 1..several - 1) { edges.push(self.edge(sides[1] + line * each, BAND, OUTER, SEPARATOR, tint, 1)) }
      }
    }
    const chosen = self.chosen
    if (chosen >= 1 && chosen <= count) {
      const sides = self.sides(chosen)
      edges.push(self.edge(sides[1], INNER, OUTER, LIT_WIDTH, GOLD, 1))
      edges.push(self.edge(sides[2], INNER, OUTER, LIT_WIDTH, GOLD, 1))
    }
    return edges
  }

  spotsOf(): array<Spot> {
    const count = self.count
    const spots: array<Spot> = []
    const out = ICON_AT * self.scale * (0.4 + 0.6 * self.opening)
    for (index, item of self.items) {
      if (index <= count) {
        const r = itemTurn(index, count) / 1rad
        const half = CARVE * self.scale / 2
        spots.push({
          item: item, left: self.size / 2 + r.sin() * out - half, top: self.size / 2 - r.cos() * out - half,
          chosen: self.chosen == index
        })
      }
    }
    return spots
  }

  public render(): Template {
    return $ltml {
      <box width={self.size} height={self.size} mouseThrough={true}>
        <box $for={cut of self.cuts} position={Position::Absolute} left={0dp} top={0dp} width={self.size} height={self.size}
             background={cut.art} tint={cut.tint} opacity={cut.opacity} mask={cut.masks} zLevel={1} />
        <box $for={edge of self.edges} position={Position::Absolute} left={edge.left} top={edge.top} width={edge.width}
             height={edge.height} background={PLAIN} tint={edge.tint} opacity={edge.opacity} rotation={edge.turn} zLevel={2} />
        <box $for={spot of self.pictured} position={Position::Absolute} left={spot.left} top={spot.top} width={CARVE * self.scale}
             height={CARVE * self.scale} opacity={spot.item.dim ? DIM_OPACITY : 1} zLevel={4}>
          // The hollow under the icon: its lip shows round the icon, its shade inside is under it, so the icon is whole.
          <box position={Position::Absolute} left={0dp} top={0dp} width={CARVE * self.scale} height={CARVE * self.scale}
               background={CARVED} />
          // The icon whole, its own thin rim and all: `icon` cuts every side's rim off, and an icon whose picture
          // reaches its edges (a skull, an anvil) loses part of it.
          <box position={Position::Absolute} left={(CARVE - ICON) / 2 * self.scale} top={(CARVE - ICON) / 2 * self.scale}
               width={ICON * self.scale} height={ICON * self.scale} background={spot.item.icon} desaturate={spot.item.dim}
               tint={spot.item.tone ?? (spot.chosen ? nil : HOLLOW)} cooldown={spot.item.cooldown} xAlign={Align::End}
               yAlign={Align::End} zLevel={1}>
            <text value={spot.item.count} textSize={SECONDARY_TEXT} textColor={BRIGHT_TEXT} />
          </box>
          <box $if={spot.chosen} position={Position::Absolute} left={(CARVE - ICON) / 2 * self.scale}
               top={(CARVE - ICON) / 2 * self.scale} width={ICON * self.scale} height={ICON * self.scale} border={ICON_LIT}
               zLevel={2} />
        </box>
        // An item with no picture: its name right in its wedge, centred where an icon would stand, wrapped as the wedge's
        // width needs; gold while aimed at.
        <box $for={spot of self.worded} position={Position::Absolute} left={spot.left + (CARVE * self.scale - self.wordsWidth) / 2}
             top={spot.top + (CARVE * self.scale - self.wordsHeight) / 2} width={self.wordsWidth} height={self.wordsHeight}
             yAlign={Align::Center} textAlign={TextAlign::Center} opacity={spot.item.dim ? DIM_OPACITY : 1}
             zLevel={4}>
          <text value={spot.item.name} textSize={SECONDARY_TEXT * self.scale} textColor={spot.chosen ? GOLD : NAME} leading={.Tight} />
        </box>
        <$if={self.names == WheelNames::Always}>
          <box $for={spot of self.pictured} position={Position::Absolute} left={spot.left - 30dp} top={spot.top + CARVE * self.scale}
               width={CARVE * self.scale + 60dp} xAlign={Align::Center} opacity={spot.item.dim ? DIM_OPACITY : 1} zLevel={4}>
            <text value={spot.item.name} textSize={SECONDARY_TEXT} textColor={NAME} />
          </box>
        </>
        <box position={Position::Absolute} left={(self.size - self.middleSize) / 2} top={(self.size - self.middleSize) / 2}
             width={self.middleSize} height={self.middleSize} background={MIDDLE_ART} xAlign={Align::Center}
             yAlign={Align::Center} zLevel={5}>
          <box width={MIDDLE_TEXT * self.scale} columns={1} xAlign={Align::Center} gap={1sp}>
            <box $if={self.category != nil} width={self.categorySize + 2 * RIM} height={self.categorySize + 2 * RIM}
                 background={PLAIN} tint={BRONZE} mask={ROUND}>
              <box position={Position::Absolute} left={RIM} top={RIM} width={self.categorySize} height={self.categorySize}
                   icon={self.category} mask={ROUND} />
            </box>
            <text $if={self.named} value={self.middle.name} textSize={1rem * self.scale} textColor={self.middle.dim ? NAME_DIM : NAME}
                  wrap={.Cut} />
            <text $for={hint of self.hints} value={hint} textSize={SECONDARY_TEXT * self.scale} textColor={HINT} wrap={.Cut} />
          </box>
        </box>
      </box>
    }
  }
}
