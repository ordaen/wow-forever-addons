// The library's PushButton holds its label inside the plate's caps: a label longer than the width it was given widens
// the button, whatever plate it is drawn on.
import { Align, Key, Layer, Point } from "$ltml"
import Test from "$test"
import { Move } from "$test"
import root Ordaen from "Ordaen"
import { CountInput, STEP_WIDTH } from "@/countInput"
import { Density } from "@/globals"
import { ButtonKey, ButtonPlate, PushButton } from "@/pushButton"

class Buttons {
  public render(): Template {
    return $ltml {
      <box rows={["max-content", "max-content", "max-content", "max-content"]} gap={3sp} xAlign={Align::Start}>
        <PushButton label={"Run the benchmarks"} width={90ui} />
        <PushButton label={"Выйти из игры"} width={60ui} plate={ButtonPlate::Accent} />
        <PushButton label={"Перезагрузить интерфейс"} width={40ui} disabled={true} />
        <PushButton label={"OK"} width={120ui} />
      </box>
    }
  }
}

class Cell {
  public render(): Template {
    return $ltml {
      <box columns={[98.4375dp]} rows={[35ui]} height={35ui} xAlign={Align::End}>
        <PushButton label={"Forget"} width={93.75dp} />
      </box>
    }
  }
}

test "a push button in a table's cell narrower than it holds its label in its content" {
  let page = new Cell()
  Test::mount(page, { left: 0, top: 0, width: 600, height: 300 })
  Test::expect(fits("Forget"))
  destroy page
}

// Whether the button's label stands inside its height and clear of the plate's rim by a gap at both ends.
function fits(label: string): boolean {
  const plate = Test::page().button(label).rect()
  const drawn = Test::page().text(label).letters()
  return drawn.left > plate.left + rimOf(plate) + 1 && drawn.right < plate.right - rimOf(plate) - 1 &&
    drawn.top >= plate.top && drawn.bottom <= plate.bottom
}

// The plate's rim: the carved line round the face, 15 of the art's 64 px in from each end, the art as high as the plate.
function rimOf(plate: Test::Rect): number { return (plate.bottom - plate.top) * 15 / 64 }

test "every push button's label stands inside its caps, a long one widening the button" {
  let page = new Buttons()
  Test::mount(page, { left: 0, top: 0, width: 600, height: 300 })
  Test::expect(fits("Run the benchmarks"))
  Test::expect(fits("Выйти из игры"))
  Test::expect(fits("Перезагрузить интерфейс"))
  Test::expect(fits("OK"))
  // A short label keeps the width it was given.
  const ok = Test::page().button("OK").rect()
  Test::expect((ok.right - ok.left - 120).abs() < 1)
  destroy page
  Test::expect(Test::blank())
}

// A row of buttons as a quest's page has them, in ruRU: each as wide as its label, the row as wide as its buttons.
class ButtonRow {
  public render(): Template {
    return $ltml {
      <box columns={["max-content", "max-content", { fr: 1 }, "max-content"]} gap={3sp}>
        <PushButton label={"Показать на карте"} width={131.25dp} />
        <PushButton label={"Поделиться"} width={131.25dp} />
        <box />
        <PushButton label={"Отказаться от задания"} width={131.25dp} plate={ButtonPlate::Accent} />
      </box>
    }
  }
}

// The row in a box of a fixed width it doesn't fit in.
class Fixed {
  public render(): Template {
    return $ltml { <box width={300ui}> <ButtonRow /> </box> }
  }
}

// The row in a window sized by what it holds, given less room than the row needs.
class Grown {
  public render(): Template {
    return $ltml {
      <surface layer={Layer::Dialog} place={{ point: Point::TopLeft, x: 20ui, y: 20ui }} width={300ui} padding={3.5sp}>
        <box rows={["max-content", "max-content"]}>
          <text value={"Задание"} />
          <ButtonRow />
        </box>
      </surface>
    }
  }
}

test "a label longer than the button's width keeps a gap past the plate's rim at both ends, at every spacing" {
  let page = new ButtonRow()
  Test::mount(page, { left: 0, top: 0, width: 900, height: 300 })
  Test::expect(fits("Отказаться от задания"))
  Ordaen.globals.values.density = Density::Compact
  Test::flush()
  Test::expect(fits("Отказаться от задания"))
  Ordaen.globals.values.density = Density::Roomy
  Test::flush()
  Test::expect(fits("Отказаться от задания"))
  Ordaen.globals.values.density = Density::Normal
  destroy page
}

test "a box of a fixed width narrower than what it holds needs is a fault that names it and how much it lacks" {
  let page = new Fixed()
  Test::mount(page, { left: 0, top: 0, width: 800, height: 300 })
  Test::shot("the row past its box of 300")
  const said = Test::faults().join("\n")
  const (short, _) = said.find("300 wide is")
  Test::expect(short != nil)
  destroy page
}

test "a window given less room than a row of buttons needs grows to hold it" {
  let page = new Grown()
  Test::mount(page, { left: 0, top: 0, width: 800, height: 300 })
  Test::expect(fits("Показать на карте"))
  Test::expect(fits("Поделиться"))
  Test::expect(fits("Отказаться от задания"))
  const window = Test::page().text("Задание")
  Test::expect(Test::page().button("Отказаться от задания").rect().right > window.rect().left + 300)
  Test::expect(Test::faults().length == 0)
  destroy page
}

class Asking {
  public pressed = 0

  mut onPress() { self.pressed += 1 }

  public render(): Template {
    return $ltml {
      <surface layer={Layer::Dialog} place={{ point: Point::TopLeft, x: 100ui, y: 50ui }} width={300ui} padding={3.5sp}>
        <PushButton label={"Remove friend"} width={140.625dp} plate={ButtonPlate::Danger} @click={self.onPress} />
      </surface>
    }
  }
}

test "a danger button is the red plate, and Enter never presses it: Space and the mouse do" {
  let page = new Asking()
  Test::mount(page, { left: 0, top: 0, width: 600, height: 300 })
  Test::expect(Test::page().button("Remove friend").paintedWith(Ordaen.art.ctl.buttonAccent))
  // The mouse presses it; the surface is the active one then, and Tab focuses it.
  Test::page().button("Remove friend").click()
  Test::key(Move::Next)
  Test::expect(page.pressed == 1 && Test::focused().contains("«Remove friend»"))
  Test::key(Key::Enter)
  Test::expect(page.pressed == 1)
  Test::key(Key::Space)
  Test::expect(page.pressed == 2)
  destroy page
}

class Keyed {
  public render(): Template {
    return $ltml {
      // As narrow as its label lets it: the label stands right at its room's start.
      <box columns={["max-content"]} xAlign={Align::Start}>
        <PushButton label={"Decline"} width={1dp} key={ButtonKey::Named { name: "Esc" }} />
      </box>
    }
  }
}

// Whether the key's segment stands inside the plate's rim, its key in it, and the label past its groove by a gap and
// clear of the plate's rim at its other end.
function keyedFits(): boolean {
  const plate = Test::page().button("Decline").rect()
  const segment = Test::page().box(Color::hex("#00000038")).rect()
  const key = Test::page().text("Esc").letters()
  const label = Test::page().text("Decline").letters()
  return segment.left >= plate.left + rimOf(plate) - 0.5 && segment.top >= plate.top && segment.bottom <= plate.bottom &&
    key.left >= segment.left && key.right <= segment.right && label.left > segment.right + 1 &&
    label.right < plate.right - rimOf(plate) - 1
}

test "a keyed button's label stands past the key's segment at every spacing" {
  let page = new Keyed()
  Test::mount(page, { left: 0, top: 0, width: 600, height: 300 })
  Test::expect(keyedFits())
  Ordaen.globals.values.density = Density::Compact
  Test::flush()
  Test::expect(keyedFits())
  Ordaen.globals.values.density = Density::Roomy
  Test::flush()
  Test::expect(keyedFits())
  Ordaen.globals.values.density = Density::Normal
  destroy page
}

const SQUARE_ICON: Asset = "Interface/Icons/Trade_BlackSmithing"

// A stepper's − and +, and a button with an icon alone as wide as it is high.
class Glyphs {
  public state count = 3

  public render(): Template {
    return $ltml {
      <box rows={["max-content", "max-content"]} gap={3sp} xAlign={Align::Start}>
        <CountInput value={mut self.count} least={1} most={9} />
        <PushButton label={""} icon={SQUARE_ICON} width={39.84375dp} />
      </box>
    }
  }
}

// Whether a glyph's button is as wide as it was made, and the icon's as high as it is wide.
function glyphsHold(): boolean {
  const fewer = Test::page().button("-").rect()
  const more = Test::page().button("+").rect()
  const icon = Test::page().button(SQUARE_ICON).rect()
  const step = STEP_WIDTH / 1ui
  return (fewer.right - fewer.left - step).abs() < 0.5 && (more.right - more.left - step).abs() < 0.5 &&
    (icon.right - icon.left - (icon.bottom - icon.top)).abs() < 0.5
}

test "a glyph's button keeps the width it was given at every spacing: the stepper's, and an icon alone square" {
  let page = new Glyphs()
  Test::mount(page, { left: 0, top: 0, width: 600, height: 300 })
  Test::expect(glyphsHold())
  Ordaen.globals.values.density = Density::Compact
  Test::flush()
  Test::expect(glyphsHold())
  Ordaen.globals.values.density = Density::Roomy
  Test::flush()
  Test::expect(glyphsHold())
  Ordaen.globals.values.density = Density::Normal
  destroy page
}
