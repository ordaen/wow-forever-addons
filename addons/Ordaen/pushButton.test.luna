// The library's PushButton holds its label inside the plate's caps: a label longer than the width it was given widens
// the button, whatever plate it is drawn on.
import { Align, Key, Layer, Point } from "$ltml"
import Test from "$test"
import { Move } from "$test"
import root Ordaen from "Ordaen"
import { ButtonPlate, PushButton } from "@/pushButton"

class Buttons {
  public render(self): Template {
    return $ltml {
      <box rows={["max-content", "max-content", "max-content", "max-content"]} gap={8ui} xAlign={Align.Start}>
        <PushButton label={"Run the benchmarks"} width={90ui} />
        <PushButton label={"Выйти из игры"} width={60ui} plate={ButtonPlate.Accent} />
        <PushButton label={"Перезагрузить интерфейс"} width={40ui} disabled={true} />
        <PushButton label={"OK"} width={120ui} />
      </box>
    }
  }
}

class Cell {
  public render(self): Template {
    return $ltml {
      <box columns={[98.4375dp]} rows={[35ui]} height={35ui} xAlign={Align.End}>
        <PushButton label={"Forget"} width={93.75dp} />
      </box>
    }
  }
}

test "a push button in a table's cell narrower than it holds its label in its content" {
  let page = new Cell()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 300 })
  Test.expect(fits("Forget"))
  destroy page
}

// Whether the button's label stands clear of its caps and inside its height.
function fits(label: String): Boolean {
  const plate = Test.page().button(label).rect()
  const drawn = Test.page().text(label).letters()
  // The carved line round the face: 14 of the art's 64 px in from each end, the face a quarter of the height in.
  const cap = (plate.bottom - plate.top) / 4
  return drawn.left >= plate.left + cap - 0.5 && drawn.right <= plate.right - cap + 0.5 &&
    drawn.top >= plate.top && drawn.bottom <= plate.bottom
}

test "every push button's label stands inside its caps, a long one widening the button" {
  let page = new Buttons()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 300 })
  Test.expect(fits("Run the benchmarks"))
  Test.expect(fits("Выйти из игры"))
  Test.expect(fits("Перезагрузить интерфейс"))
  Test.expect(fits("OK"))
  // A short label keeps the width it was given.
  const ok = Test.page().button("OK").rect()
  Test.expect((ok.right - ok.left - 120).abs() < 1)
  destroy page
  Test.expect(Test.blank())
}

class Asking {
  public pressed = 0

  onPress(mut self) { self.pressed += 1 }

  public render(self): Template {
    return $ltml {
      <surface layer={Layer.Dialog} place={{ point: Point.TopLeft, x: 100ui, y: 50ui }} width={300ui} padding={10ui}>
        <PushButton label={"Remove friend"} width={140.625dp} plate={ButtonPlate.Danger} @click={self.onPress} />
      </surface>
    }
  }
}

test "a danger button is the red plate, and Enter never presses it: Space and the mouse do" {
  let page = new Asking()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 300 })
  Test.expect(Test.page().button("Remove friend").paintedWith(Ordaen.art.ctl.buttonAccent))
  // The mouse presses it; the surface is the active one then, and Tab focuses it.
  Test.page().button("Remove friend").click()
  Test.key(Move.Next)
  Test.expect(page.pressed == 1 && Test.focused().contains("«Remove friend»"))
  Test.key(Key.Enter)
  Test.expect(page.pressed == 1)
  Test.key(Key.Space)
  Test.expect(page.pressed == 2)
  destroy page
}
