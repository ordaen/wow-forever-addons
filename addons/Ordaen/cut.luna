// A cut in the wood: a straight groove lit from above, across a column or down it, and the cut that parts sections
// of a window (the character window's, a quest page's rewards), its title cut into the wood at its middle.
import { Align, Shadow } from "$ltml"
import { Component } from "@/module"

// The groove's three bands, lit from above: its upper edge in shade, its floor, its lit lower lip; and the three
// together. A title cut into the wood at a cut's middle has its letters' upper walls in shade.
const CUT_SHADE: Number<Length> = 2.34375dp
const CUT_FLOOR: Number<Length> = 2.34375dp
const CUT_LIP: Number<Length> = 1.171875dp
public const CUT: Number<Length> = CUT_SHADE + CUT_FLOOR + CUT_LIP
const GROOVE_SHADE: Color = Color.hex("#0000008c")
const GROOVE_DEPTH: Color = Color.hex("#000000e6")
const GROOVE_LIP: Color = Color.hex("#ffdeaa52")
const CUT_TITLE: Color = Color.hex("#b8a07a")
const CUT_TITLE_SHADOW: Shadow = { color: Color.hex("#000000e6"), x: 0ui, y: 1.171875dp }

// A straight cut in the wood, lit from above: the shaded upper edge, the depth, the lit lower lip; across (`upright`
// false) or down its box (true, the light from the left: the shade on its left, the lip on its right).
public class Groove implements Component {
  upright: Signal<Boolean>
  constructor(upright: Signal<Boolean> = false) {
    self.upright = upright
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.upright} columns={[CUT_SHADE, CUT_FLOOR, CUT_LIP]} rows={[{ fr: 1 }]}>
        <box background={GROOVE_SHADE} />
        <box background={GROOVE_DEPTH} />
        <box background={GROOVE_LIP} />
      </box>
      <box $else>
        <box height={CUT_SHADE} background={GROOVE_SHADE} />
        <box height={CUT_FLOOR} background={GROOVE_DEPTH} />
        <box height={CUT_LIP} background={GROOVE_LIP} />
      </box>
    }
  }
}

// A cut in the wood across the column, the title at its middle where it has one.
public class Cut implements Component {
  derived titled: Boolean = self.title != ""

  title: Signal<String>
  constructor(title: Signal<String> = "") {
    self.title = title
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.titled} columns={[{ fr: 1 }, "max-content", { fr: 1 }]} gap={2.5sp} yAlign={Align.Center}>
        <Groove />
        <text value={self.title} textColor={CUT_TITLE} textShadow={CUT_TITLE_SHADOW} wrap={.None} />
        <Groove />
      </box>
      <Groove $else />
    }
  }
}
