// The rule on a window's wood, the spellbook's bronze line, in two forms: a heading's, the title in gold bold and the
// rule fading out to its right (a Section's, a character window's section); a divider's, the same bronze solid, from
// border to border (between two sections, beside the paper doll).
import { Align, Shadow } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"

// The rule's thickness, and its bronze at 45%: `ctl-rule`'s first texel, which fades from it to nothing.
public const CUT: Number<Length> = 1.171875dp
const RULE: Color = Color.hex("#d6a56b73")
const GOLD: Color = Color.hex("#e8c35a")
// The design's 700: the same colour one pixel to the right.
const BOLD: Shadow = { color: GOLD, x: 1.171875dp, y: 0ui }

// The divider's form: the solid rule across its box (`upright` false) or down it (true).
public class Groove implements Component {
  upright: Signal<Boolean>
  constructor(upright: Signal<Boolean> = false) {
    self.upright = upright
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.upright} columns={[CUT]} rows={[{ fr: 1 }]}>
        <box background={RULE} />
      </box>
      <box $else height={CUT} background={RULE} />
    }
  }
}

// A rule across the column: the heading's form where it has a title (the title at its left, the rule fading out
// after it), else the divider's.
public class Cut implements Component {
  derived titled: Boolean = self.title != ""

  title: Signal<String>
  constructor(title: Signal<String> = "") {
    self.title = title
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.titled} columns={["max-content", { fr: 1 }]} gap={3sp} yAlign={Align.Center}>
        <text value={self.title} textColor={GOLD} textShadow={BOLD} wrap={.None} />
        <box height={CUT} background={Ordaen.art.ctl.rule} />
      </box>
      <Groove $else />
    }
  }
}
