// The lines on a window's wood. A divider is a deep groove cut into it (the theme's `ctl.cut`), its shade multiplied
// into the wood and its lip added, so the grain goes on through it: whole from border to border, across or down (beside
// the paper doll), a title standing on it in the middle where it has one (the character window's sections). A heading
// (a Section's, the spellbook's) is its title in bold and a rule of paint after it (`ctl.heading`), rising over its
// first pixels and narrowing to a point at the column's end as it fades. The titles and the paint take the look's
// colours (`heading`, `headingPaint`).
import { Align, Blend, Position, TextWeight } from "$ltml"
import root Ordaen from "Ordaen"
import { OrdaenArt } from "@/art"
import { Component } from "@/module"

// The cut's depth and the heading's rule's, 8 texels of their art at a texel a pixel; the rule's entry, 8 texels.
public const CUT: Number<Length> = 9.375dp
const ENTRY: Number<Length> = 9.375dp
// The paint's opacity over the wood where it is whole, and the wood's colour on average (window-wood.tga).
const PAINT_OPACITY: Number = 0.85
const WOOD: Color = { r: 21 / 255, g: 13 / 255, b: 5 / 255, a: 1 }

// What the white paint is tinted to show `seen` on the wood: worked back from it at the paint's opacity over the wood's
// average, so a colour the grain shows through keeps its hue (a gold laid thin over brown would turn olive).
function paintFor(seen: Color): Color {
  const thin = 1 - PAINT_OPACITY
  return {
    r: ((seen.r - WOOD.r * thin) / PAINT_OPACITY).min(1).max(0),
    g: ((seen.g - WOOD.g * thin) / PAINT_OPACITY).min(1).max(0),
    b: ((seen.b - WOOD.b * thin) / PAINT_OPACITY).min(1).max(0),
    a: 1
  }
}

// One piece of the cut filling its box: its shade multiplied into the wood, its lip added over it.
class CutPiece implements Component {
  layers: OrdaenArt.CutLayers
  constructor(layers: OrdaenArt.CutLayers) {
    self.layers = layers
  }

  public render(self): Template {
    return $ltml {
      <box background={self.layers.dark} blend={Blend.Multiply}>
        <box position={Position.Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui} background={self.layers.light}
             blend={Blend.Add} />
      </box>
    }
  }
}

// The divider: the cut whole across its box (`upright` false) or down it (true, the light from the left); across, a
// `title` stands on it in the middle, the cut stopping short of it on each side.
public class Groove implements Component {
  derived titled: Boolean = self.title != ""
  derived color: Color = Ordaen.look.values.heading

  upright: Signal<Boolean>
  title: Signal<String>
  constructor(upright: Signal<Boolean> = false, title: Signal<String> = "") {
    self.upright = upright
    self.title = title
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.upright} columns={[CUT]} rows={[{ fr: 1 }]} yAlign={Align.Stretch}>
        <CutPiece layers={Ordaen.art.ctl.cut.upright} />
      </box>
      <box $elseif={self.titled} columns={[{ fr: 1 }, "max-content", { fr: 1 }]} gap={3sp} yAlign={Align.Center}>
        <box rows={[CUT]} yAlign={Align.Stretch}>
          <CutPiece layers={Ordaen.art.ctl.cut.across} />
        </box>
        <text value={self.title} textColor={self.color} textWeight={TextWeight.Bold} wrap={.None} />
        <box rows={[CUT]} yAlign={Align.Stretch}>
          <CutPiece layers={Ordaen.art.ctl.cut.across} />
        </box>
      </box>
      <box $else rows={[CUT]} yAlign={Align.Stretch}>
        <CutPiece layers={Ordaen.art.ctl.cut.across} />
      </box>
    }
  }
}

// A line across the column: the heading where it has a title (the title at its left, the paint after it to the
// column's end), else the divider.
public class Cut implements Component {
  derived titled: Boolean = self.title != ""
  derived color: Color = Ordaen.look.values.heading
  derived paint: Color = paintFor(Ordaen.look.values.headingPaint)

  title: Signal<String>
  constructor(title: Signal<String> = "") {
    self.title = title
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.titled} columns={["max-content", { fr: 1 }]} gap={3sp} yAlign={Align.Center}>
        <text value={self.title} textColor={self.color} textWeight={TextWeight.Bold} wrap={.None} />
        <box columns={[ENTRY, { fr: 1 }]} rows={[CUT]} yAlign={Align.Stretch}>
          <box background={Ordaen.art.ctl.heading.entry} tint={self.paint} />
          <box background={Ordaen.art.ctl.heading.tip} tint={self.paint} />
        </box>
      </box>
      <Groove $else />
    }
  }
}
