// What every addon builds on: what draws, and what a module's root is.

import { Art } from "$ltml"

// What draws. Its constructor sets it up, its destructor takes it down.
public trait Component {
  public render(self): Template
}

// One tab of a module's page in the settings window: its name, and its rows.
public struct SettingsPage {
  title: String
  content: Template
}

// A module as the settings window lists it, running or not: an addon the player has that needs Ordaen.
public trait Entry {
  // Its addon's folder: what tells it from the others.
  public const folder: String
  public const title: String
  public const icon: Art
  // Whether it runs: an addon that is off isn't loaded and costs nothing.
  public on: Signal<Boolean>
  // Its tabs in the settings window; none while it is off.
  public pages: Signal<Array<SettingsPage>>
  // Ask Ordaen to turn it on (it is made and drawn at once) or off (it is ended at once).
  public enable(self, on: Boolean)
}

// A module's root (`implements Module, App`): a component the player turns on and off. It adds itself to Ordaen's
// `modules` in its constructor (`Ordaen.modules.add(self)`: Ordaen's root is made before it), and is gone from there
// as it is destroyed. Ordaen draws each of its `modules` on the screen.
public trait Module: Component {
  public const title: String
  // Its tabs in the settings window, in order; none for a module with nothing to choose.
  public const pages: Array<SettingsPage>
}
