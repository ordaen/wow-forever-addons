// Dialog: a question over everything, the screen dimmed behind it. The small metal frame round the windows' wood,
// its title in gold at the top, the question under it, and its buttons at the bottom right, 8 px apart. A click on
// the dimmed screen does nothing: the question needs an answer. The unnamed slot takes the question, the slot
// `buttons` its PushButtons, up to three.
import { Align, Edges, Layer, Position, Shadow } from "$ltml"
import root Ordaen from "Ordaen"
import { reachAcross } from "@/art"
import { Component } from "@/module"
import { BODY_LINE, TITLE_LINE, TITLE_TEXT } from "@/units"

const TITLE: Color = Color.hex("#ffd100")
const SHADOW: Shadow = { color: Color.hex("#000000b3"), x: 1.171875dp, y: -1.171875dp }
const SHADE: Color = Color.hex("#0000008c")
const PLAIN: Edges = { top: 7sp, right: 7sp, bottom: 7sp, left: 7sp }
const TITLED: Edges = { top: 13sp, right: 7sp, bottom: 7sp, left: 7sp }

public class Dialog implements Component {
  derived titled: Boolean = self.title != ""
  derived padding: Edges = self.titled ? TITLED : PLAIN
  // Its width as drawn: the one it is given at the frame's line, and the art past the line on either side.
  derived framed: Number<Length> = self.width + reachAcross(Ordaen.art.frame.small)

  width: Signal<Number<Length>>
  title: Signal<String>
  constructor(
    width: Signal<Number<Length>>,
    title: Signal<String> = ""
  ) {
    self.width = width
    self.title = title
  }

  // The dimmed screen takes the clicks meant for what is under it.
  swallow(mut self) {}

  public render(self): Template {
    return $ltml {
      <surface lineHeight={BODY_LINE} layer={Layer.Dialog} place={"fill"} zLevel={100} background={SHADE} xAlign={Align.Center}
               yAlign={Align.Center} @pointerPress={self.swallow} @keyPress(.Enter)={self.swallow} @keyPress(.Space)={self.swallow}>
        <box width={self.framed} border={Ordaen.art.frame.small} background={Ordaen.art.window.wood}
             artOrigin={true} columns={1} gap={4sp} padding={self.padding}>
          <slot />
          <box columns={[{ fr: 1 }, "max-content"]}>
            <box />
            <box columns={["max-content", "max-content", "max-content"]} gap={2.5sp}>
              <slot #buttons />
            </box>
          </box>
          <box $if={self.titled} position={Position.Absolute} left={0ui} right={0ui} top={16.40625dp}
               xAlign={Align.Center}>
            <text value={self.title} textColor={TITLE} textSize={TITLE_TEXT} lineHeight={TITLE_LINE} textShadow={SHADOW} wrap={.None} />
          </box>
        </box>
      </surface>
    }
  }
}
