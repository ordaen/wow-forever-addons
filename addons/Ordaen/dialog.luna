// Dialog: a question over everything, the screen dimmed behind it. The small metal frame round the windows' wood,
// its title in gold at the top, the question under it, and its buttons at the bottom right, 8 px apart. A click on
// the dimmed screen does nothing: the question needs an answer. The unnamed slot takes the question, the slot
// `buttons` its PushButtons, up to three.
import { Align, Edges, Layer, Position, Shadow } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { PX } from "@/units"

const TITLE: Color = Color.hex("#ffd100")
const SHADOW: Shadow = { color: Color.hex("#000000b3"), x: 1 * PX, y: -1 * PX }
const SHADE: Color = Color.hex("#0000008c")
const PLAIN: Edges = { top: 24 * PX, right: 24 * PX, bottom: 24 * PX, left: 24 * PX }
const TITLED: Edges = { top: 44 * PX, right: 24 * PX, bottom: 24 * PX, left: 24 * PX }

public class Dialog implements Component {
  derived titled: Boolean = self.title != ""
  derived padding: Edges = self.titled ? TITLED : PLAIN

  width: Signal<Number>
  title: Signal<String>
  constructor(
    width: Signal<Number>,
    title: Signal<String> = "",
  ) {
    self.width = width
    self.title = title
  }

  // The dimmed screen takes the clicks meant for what is under it.
  swallow(mut self) {}

  public render(self): Template {
    return $ltml {
      <surface layer={Layer.Dialog} place={"fill"} zLevel={100} background={SHADE} xAlign={Align.Center}
               yAlign={Align.Center} textFamily={Ordaen.lookArt.font} @click={self.swallow}>
        <box width={self.width} border={Ordaen.art.frame.small} background={Ordaen.art.window.wood}
             artOrigin={true} columns={1} gap={14 * PX} padding={self.padding}>
          <slot />
          <box columns={[{ fr: 1 }, "auto"]}>
            <box />
            <box columns={["auto", "auto", "auto"]} gap={8 * PX}>
              <slot #buttons />
            </box>
          </box>
          <box $if={self.titled} position={Position.Absolute} left={0} right={0} top={14 * PX}
               xAlign={Align.Center}>
            <text value={self.title} textColor={TITLE} textSize={.Title} textShadow={SHADOW} wrap={false} />
          </box>
        </box>
      </surface>
    }
  }
}
