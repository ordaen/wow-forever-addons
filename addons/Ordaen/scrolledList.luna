// A list that scrolls, drawn as a well: a box sunk into the wood, its rim the look's line round it and its floor
// darker than the wood, and inside the rim the rows, which scroll and are cut at the rim's inner edge; or, on the
// wood (`Ground.Wood`), with no rim and no floor. Its one padding is the scrolling box's, so it scrolls with the rows:
// a row scrolled out is cut at the rim, never at the padding. A part that stays while the rows scroll (a table's
// headings) is its slot `head`, over the rows inside the rim, at the rows' sides. A list given `tracks` is a grid of
// them, its head and its rows subgrids of it: a table's columns, which its headings and its rows' cells stand in. Every
// list that scrolls is one; no module draws its own.
import { Align, Columns, Edges, Gaps, Line, Overflow, Size, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"

// What a list stands on: a well sunk into the wood, or the wood itself (a table's rows then ruled apart).
public enum Ground { Well, Wood }

// The room between the rim and what the well holds: the least room a text keeps from a frame's line, and an item's step.
// None where the rows bring their own (`rowsPadded`): they stand edge to edge inside the rim, their shade and rules
// with them.
const INSIDE = 3sp
const NONE = 0sp
// The head as high as it is, the rows the rest.
const PARTS: array<Track> = ["max-content", { fr: 1 }]
const SUBGRID: Columns = "subgrid"

public class ScrolledList implements Component {
  derived sunk: boolean = self.ground == Ground::Well
  // On the wood none: the list stands against its window's or its column's border, and its rows edge to edge.
  derived rim: Line | nil = self.sunk ? Ordaen.art.ctl.well.rim : nil
  derived floor = self.sunk ? Ordaen.art.ctl.well.floor : nil
  derived inside: number<Spacing> = self.rowsPadded || !self.sunk ? NONE : INSIDE
  // At the sides, the room it is given where it is.
  derived across: number<Spacing> = self.sides ?? self.inside
  // A table's head and rows stand in its tracks (`parts`), which keep the room at its sides: they reach over it, their
  // cells in the tracks. A list's head and rows keep the room themselves, the head the rows' sides.
  derived tabled: boolean = self.tracks != nil
  derived parts: Columns | nil = self.tabled ? SUBGRID : nil
  derived tableSides: Edges | nil = self.tabled ? { left: self.across, right: self.across } : nil
  derived headSides: Edges | nil = self.tabled ? nil : { left: self.across, right: self.across }
  derived room: Edges = {
    top: self.inside, right: self.tabled ? NONE : self.across, bottom: self.inside, left: self.tabled ? NONE : self.across
  }

  tracks: Signal<array<Track> | nil>
  columns: Signal<Columns | nil>
  rows: Signal<array<Track> | nil>
  gap: Signal<number<Spacing> | Gaps | nil>
  yAlign: Signal<Align | nil>
  height: Signal<number<Length> | nil>
  width: Signal<Size | nil>
  const virtual: boolean
  const rowsPadded: boolean
  ground: Signal<Ground>
  sides: Signal<number<Spacing> | nil>
  constructor(
    // The columns of a table: its head and its rows are subgrids of them, its `columns` none of its own.
    tracks: Signal<array<Track> | nil> = nil,
    // Its rows' grid: one column where none is said.
    columns: Signal<Columns | nil> = nil,
    rows: Signal<array<Track> | nil> = nil,
    gap: Signal<number<Spacing> | Gaps | nil> = nil,
    yAlign: Signal<Align | nil> = nil,
    // The well's height, its rim in it: it scrolls past it. None: the rest of the room its box gives it.
    height: Signal<number<Length> | nil> = nil,
    // The well's width, its rim in it. None: the width of its cell.
    width: Signal<Size | nil> = nil,
    // Its rows are of one height: a virtual list, which builds only the rows in view.
    virtual: boolean = false,
    // Its rows bring their own padding (and their shade, their rules): they stand edge to edge inside the rim.
    rowsPadded: boolean = false,
    // A well, or the wood.
    ground: Signal<Ground> = Ground::Well,
    // The room at its sides, over what its ground and its rows give: a table's on the wood, the window's room less its
    // cells' own.
    sides: Signal<number<Spacing> | nil> = nil
  ) {
    self.sides = sides
    self.ground = ground
    self.tracks = tracks
    self.columns = columns
    self.rows = rows
    self.gap = gap
    self.yAlign = yAlign
    self.height = height
    self.width = width
    self.virtual = virtual
    self.rowsPadded = rowsPadded
  }

  public render(): Template {
    return $ltml {
      <box columns={self.tracks} rows={PARTS} padding={self.tableSides} width={self.width} height={self.height} border={self.rim} background={self.floor}>
        <box columns={self.parts} padding={self.headSides}>
          <slot #head />
        </box>
        <virtualList $if={self.virtual} columns={self.parts} padding={self.room}>
          <slot />
        </virtualList>
        <box $else columns={self.parts ?? self.columns} rows={self.rows} gap={self.gap} yAlign={self.yAlign} padding={self.room}
             overflow={Overflow::Scroll}>
          <slot />
        </box>
      </box>
    }
  }
}
