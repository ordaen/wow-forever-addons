// Ordaen's own settings: what every module follows.

public enum Density { Compact = "compact", Normal = "normal", Roomy = "roomy" }
public enum NumberFormat { Space = "space", Comma = "comma", Dot = "dot" }
public enum LargeNumbers { Full = "full", Short = "short" }
public enum Clock { H24 = "24", H12 = "12" }

public struct Globals {
  // Ordaen's windows, on top of the game's UI scale.
  scale: Number
  density: Density
  // Borders and dividers exactly on the screen's pixels.
  pixel: Boolean
  numberFormat: NumberFormat
  numberRound: Boolean
  numberPrecision: Integer
  numbers: LargeNumbers
  sounds: Boolean
  clock: Clock
}

public const DEFAULTS: Globals = {
  scale: 1, density: Density.Normal, pixel: true, numberFormat: NumberFormat.Space, numberRound: false,
  numberPrecision: 2, numbers: LargeNumbers.Short, sounds: true, clock: Clock.H24,
}
