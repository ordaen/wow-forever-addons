// Ordaen's own settings: what every module follows.

public enum Density implements Plain { Compact = "compact", Normal = "normal", Roomy = "roomy" }
public enum NumberFormat implements Plain { Space = "space", Comma = "comma", Dot = "dot" }
public enum LargeNumbers implements Plain { Full = "full", Short = "short" }
// How a time of day is written: the client's own 24-hour mode (`Game.clock.hours24`), which «Time format» sets.
public enum Clock { H24 = "24", H12 = "12" }

public struct Globals implements Plain {
  // Ordaen's windows, on top of the game's UI scale.
  public mut scale: number
  public mut density: Density
  // Borders and dividers exactly on the screen's pixels.
  public mut pixel: boolean
  public mut numberFormat: NumberFormat
  public mut numberRound: boolean
  public mut numberPrecision: integer
  public mut numbers: LargeNumbers
  public mut sounds: boolean
}

public const DEFAULTS: Globals = {
  scale: 1, density: Density::Normal, pixel: true, numberFormat: NumberFormat::Space, numberRound: false,
  numberPrecision: 2, numbers: LargeNumbers::Short, sounds: true
}
