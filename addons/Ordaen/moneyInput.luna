// MoneyInput: an amount of money typed in as one text: «12g 50s 3c» (gold, silver and copper, in that order, each at
// most once, with the letters of the player's language). A number alone is gold. Silver and copper stand under 100
// once a larger unit is named. The amount is written to the cell as it parses and left as it was while the text
// doesn't parse, the field's edge red then; the text is written again, as the game's units, when something else
// changes the amount. `MoneyField` is the field alone; `MoneyInput` is the setting's row (SettingRow: its label, its
// hint, greyed while disabled) with the field in it. Disabled, it takes no typing.
import { Edges, Line } from "$ltml"
import { Component } from "@/module"
import Locale from "@/locales"
import { PX } from "@/units"
import { SettingRow } from "@/settingRow"

// The most it takes: 9,999,999 gold 99 silver 99 copper.
const MOST = 99999999999
const INK: Color = Color.hex("#e8dcc4")
const FILL: Color = Color.hex("#0d0a08")
const EDGE: Line = { width: 1 * PX, color: Color.hex("#4a3a24") }
const BAD: Line = { width: 1 * PX, color: Color.hex("#c0463c") }
const PADDING: Edges = { right: 10 * PX, left: 10 * PX }

// The copper a text names, or nothing where it isn't an amount.
public function copperOf(text: String): Integer | nil {
  let rest = text.replace("%s+", "").lower()
  if (rest == "") { return nil }
  let gold = 0
  let silver = 0
  let copper = 0
  // The last unit taken: 1 gold, 2 silver, 3 copper.
  let last = 0
  for (round of 1..=3) {
    if (rest == "") { break }
    const digits, unit, after = rest.match("^(%d+)(%D*)(.*)$")
    if (digits == nil || unit == nil || after == nil) { return nil }
    const amount = (digits.toNumber() ?? 0).floor()
    let kind = 0
    if (unit == Locale.MONEY_GOLD) {
      kind = 1
    } else if (unit == Locale.MONEY_SILVER) {
      kind = 2
    } else if (unit == Locale.MONEY_COPPER) {
      kind = 3
    } else if (unit == "" && round == 1 && after == "") {
      kind = 1
    }
    if (kind <= last) { return nil }
    if (last > 0 && amount > 99) { return nil }
    if (kind == 1) {
      gold = amount
    } else if (kind == 2) {
      silver = amount
    } else {
      copper = amount
    }
    last = kind
    rest = after
  }
  if (rest != "") { return nil }
  const total = gold * 10000 + silver * 100 + copper
  return total > MOST ? nil : total
}

// An amount as it is typed: its units from the largest, none that is nought.
public function copperText(copper: Integer): String {
  const gold = (copper / 10000).floor()
  const silver = (copper / 100).floor() % 100
  const rest = copper % 100
  let text = ""
  if (gold > 0) { text = `${gold}${Locale.MONEY_GOLD}` }
  if (silver > 0) { text = (text == "" ? "" : text + " ") + `${silver}${Locale.MONEY_SILVER}` }
  if (rest > 0 || text == "") { text = (text == "" ? "" : text + " ") + `${rest}${Locale.MONEY_COPPER}` }
  return text
}

public class MoneyField implements Component {
  public state text: String
  public derived bad: Boolean = self.text != "" && copperOf(self.text) == nil
  public derived edge: Line = self.bad ? BAD : EDGE

  value: mut Signal<Integer>
  disabled: Signal<Boolean>
  constructor(
    // In copper.
    value: mut Signal<Integer>,
    disabled: Signal<Boolean> = false,
  ) {
    self.value = value
    self.disabled = disabled
    self.text = copperText(peek self.value)
    watch (typed of self.text) { self.take(typed) }
    watch (amount of self.value) { self.show(amount) }
  }

  // What was typed names an amount: it is the cell's.
  take(mut self, typed: String) {
    const copper = copperOf(typed)
    if (copper != nil && copper != peek self.value) { self.value = copper }
  }

  // Another wrote the amount: the text says it, unless it already does.
  show(mut self, amount: Integer) {
    if (copperOf(peek self.text) != amount) { self.text = copperText(amount) }
  }

  public render(self): Template {
    return $ltml {
      <input value={mut self.text} width={180 * PX} height={30 * PX} padding={PADDING} background={FILL}
             border={self.edge} textColor={INK} textSize={14 * PX} maxLength={24} disabled={self.disabled} />
    }
  }
}

public class MoneyInput implements Component {
  label: Signal<String>
  value: mut Signal<Integer>
  hint: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    label: Signal<String>,
    value: mut Signal<Integer>,
    hint: Signal<String> = Locale.MONEY_HINT,
    disabled: Signal<Boolean> = false,
  ) {
    self.label = label
    self.value = value
    self.hint = hint
    self.disabled = disabled
  }

  public render(self): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <MoneyField value={mut self.value} disabled={self.disabled} />
      </SettingRow>
    }
  }
}
