// The library's ItemButton: icon, quality's border, count, markers, dimmed; the game's tooltip of the item asked for as
// the cursor comes onto it; Left-click picks and Shift+Left-click puts the item's link into the chat.
import { Art } from "$ltml"
import Test from "$test"
import Game from "$game"
import { Corner, ItemButton, Marker, Quality } from "@/itemButton"

const SHOPPING: Marker = { corner: Corner.TopLeft, color: Color.hex("#ffd100") }
const REAGENT: Marker = { corner: Corner.BottomLeft, color: Color.hex("#4fd1ff") }
const BOTH: Array<Marker> = [SHOPPING, REAGENT]

class Bag {
  state picked = 0
  state dimmed = false

  onPick(mut self, item: Integer) { self.picked = item }

  public render(self): Template {
    return $ltml {
      <box columns={["auto", "auto", "auto", "auto", "auto", "auto"]} gap={8}>
        <ItemButton item={nil} />
        <ItemButton item={6948} @pick={self.onPick} />
        <ItemButton item={2589} count={20} quality={Quality.Epic} dimmed={self.dimmed} />
        <ItemButton item={2592} count={5} quality={Quality.Uncommon} markers={BOTH} />
        <ItemButton item={774} quality={Quality.Poor} />
        <ItemButton item={9999} quality={Quality.Legendary} />
      </box>
    }
  }
}

test "an item's slot draws its icon, its quality's border, its count and markers, shows the game's tooltip, and a click picks or a Shift+click links the item" {
  Game.items.icon = (id: Integer): Art | nil => id == 9999 ? nil : "Interface/Icons/INV_Misc_Bag_08"
  let page = new Bag()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 200 })
  Test.shot("six slots: empty, common with an icon, an epic twenty, an uncommon five with two pips, a poor one, a legendary the game has no icon for")

  Test.moveTo({ x: 58, y: 16 })
  Test.shot("the cursor on the common slot: the light over its icon, the game's tooltip of the item asked for")

  Test.moveTo({ x: 590, y: 190 })
  Test.shot("the cursor away: the light gone, nothing asked (the game hides its tooltip)")

  Test.moveTo({ x: 10, y: 16 })
  Test.shot("the cursor on the empty slot: the light, no tooltip asked for")

  page.dimmed = true
  Test.shot("the epic dimmed by a search")

  Test.click({ x: 58, y: 16 }, nil)
  Test.expect(page.picked == 6948)
  Test.shot("the common slot clicked: picked, nothing put into the chat")

  page.picked = 0
  Game.input.shiftDown = (): Boolean => true
  Test.click({ x: 58, y: 16 }, nil)
  Test.expect(page.picked == 0)
  Test.shot("Shift+clicked: the item's link put into the chat, nothing picked")

  destroy page
  Test.expect(Test.blank())
}

// The slot as cells a test changes, to read what the snapshot's tree leaves out (a line's colour).
class Slot {
  state item: Integer | nil = 1
  state quality: Quality = Quality.Poor
  state count = 1
  button: ItemButton | nil

  constructor() {
    self.button = new ItemButton(self.item, self.count, self.quality)
  }

  destructor() {
    if (self.button != nil) { destroy self.button }
  }

  look(self): String {
    const button = self.button
    if (button == nil) { return "" }
    const lit = button.lit ? ", lit" : ""
    return "%.2f %.2f %.2f%s".format(button.edge.color.r, button.edge.color.g, button.edge.color.b, lit)
  }
}

test "each quality has its own border colour, lit inside from uncommon up, a slot with no item the plain one" {
  let slot = new Slot()
  const qualities = [Quality.Poor, Quality.Common, Quality.Uncommon, Quality.Rare, Quality.Epic, Quality.Legendary,
    Quality.Artifact, Quality.Heirloom]
  let seen: Array<String> = []
  for (quality of qualities) {
    slot.quality = quality
    const look = slot.look()
    Test.expect(!seen.any(other => other == look))
    seen.push(look)
    Test.note("%s: %s".format(String.of(quality), look))
  }
  slot.quality = Quality.Epic
  slot.item = nil
  Test.note("an empty slot of the epic quality: " + slot.look())
  slot.quality = Quality.Common
  Test.expect(slot.look() == seen[2])
  Test.shot("the borders' colours")
  destroy slot
}

test "an icon is drawn for each slot that has one" {
  Game.items.icon = (id: Integer): Art | nil => id == 9999 ? nil : "Interface/Icons/INV_Misc_Bag_08"
  let page = new Bag()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 200 })
  let icons = 0
  for (shown of Test.drawn()) {
    if (shown.file == "Interface/Icons/INV_Misc_Bag_08") { icons += 1 }
  }
  Test.expect(icons == 4)
  Test.note("textures drawn with the icon's file: " + String.of(icons))
  Test.shot("six slots, four of them with an icon (the empty one and the one with none to draw have no texture)")
  destroy page
}
