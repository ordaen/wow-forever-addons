// Tip: our tooltip beside what it explains: the small metal frame round the windows' wood, its name in white, its
// text under it in the label colour, wrapped at the tooltip's width, and under that its rows, each a label at the
// start in the label colour and its value at the end in white; then its sections, each a title in gold over rows of
// its own; a panel's room round it and a line's between its lines (`space`), and last its hotkeys (`Hotkeys`). It
// stands on the screen over everything and takes no mouse. Its owner writes it in the box it explains and shows it
// while the cursor is on that box: it stands beside that box as the game's tooltip stands beside a button (under it,
// or over it in the screen's lower half; by its left edge, or by its right edge in the screen's right third), kept on
// the screen.
import { Align, Art, Beside, Bounds, Layer, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { reachAcross } from "@/art"
import { Hotkeys } from "@/hotkeys"
import { Component } from "@/module"
import { BRIGHT_TEXT, TITLE_TEXT } from "@/units"

// As wide as what it says, up to its most at the frame's line: a long text wraps there.
const MOST = 468.75dp
const NAME: color = BRIGHT_TEXT
const LABEL: color = #cbb994
const HEADING: color = #ffd100
// How a row's value is worked out, dimmed before it.
const WORKING: color = #8c8270
const BY_ITS_BOX: Beside = { beside: "parent" }
const ROW: array<Track> = [{ fr: 1 }, "max-content"]
// A row's picture, its label and the word after it, side by side at the row's start.
const MARKED: array<Track> = ["max-content", "max-content", "max-content"]
// A row's picture: as high as its line.
const ICON = 16dp
// A section's bar of shares: thin, under its rows.
const SHARES_HEIGHT = 8dp
// The bar's one row, its whole height: its slices hold nothing that gives them a height of their own.
const ONE_ROW: array<Track> = [{ fr: 1 }]

// A word after a row's label in a colour of its own: a standing's name in its standing's colour. Without its text, the
// label stands alone.
public struct TipMark {
  public text: string
  public color: color
}

// One row of a Tip: its picture where it has one, what it is (in the label colour, or its own `tone`: an item's name in
// its quality's), a word after it in its own colour where it has one, and how much (in the numbers' font, in the
// names' colour, or its own `valueTone`: a buff's green, a debuff's red), with how it is worked out dimmed before it
// where the row says (`working`: «20 × 15 =» before «300»). The defaults are written out, not constants of this file: a
// default is made where the row is.
public struct TipRow {
  public label: string
  public value: string
  public working: string = ""
  public mark: TipMark = { text: "", color: BRIGHT_TEXT }
  public icon: Art | nil = nil
  public tone: color | nil = nil
  public valueTone: color | nil = nil
}

// A part of a whole a section's bar shows: its share of the whole and its colour.
public struct TipSlice {
  public share: number
  public color: color
}

// A titled group of a Tip's rows, under its text and its own rows: a stat's sources, «Items», «Effects»; where it has
// `shares`, a thin bar under its rows, the shares side by side across it, each as wide as its part of their sum.
public struct TipSection {
  public title: string
  public rows: array<TipRow>
  public shares: array<TipSlice> = []
}

function trackOf(slice: TipSlice): Track { return { fr: slice.share.max(0) } }

// A section's bar, as `Tip` draws each.
class TipShares implements Component {
  derived columns: array<Track> = self.shares.map(trackOf)

  shares: Signal<array<TipSlice>>
  constructor(shares: Signal<array<TipSlice>>) {
    self.shares = shares
  }

  public render(): Template {
    return $ltml {
      <box padding={{ top: 1sp }}>
        <box columns={self.columns} rows={ONE_ROW} height={SHARES_HEIGHT}>
          <box $for={slice of self.shares} background={slice.color} />
        </box>
      </box>
    }
  }
}

// What a control's Tip says, for a control that draws its own (a push button): its name, its text and its rows.
public struct TipText {
  public title: string
  public text: string
  public rows: array<TipRow>
}

// A row of a Tip, as `Tip` draws each.
class TipLine implements Component {
  derived iconed: boolean = self.row.icon != nil
  derived ink: color = self.row.tone ?? LABEL
  derived valueInk: color = self.row.valueTone ?? NAME
  derived worked: boolean = self.row.working != ""

  row: Signal<TipRow>
  constructor(row: Signal<TipRow>) {
    self.row = row
  }

  public render(): Template {
    return $ltml {
      <box columns={ROW} gap={3sp} yAlign={Align::Center}>
        <box columns={MARKED} gap={2sp} yAlign={Align::Center}>
          <box $if={self.iconed} width={ICON} height={ICON} icon={self.row.icon} />
          <text value={self.row.label} textColor={self.ink} />
          <text $if={self.row.mark.text != ""} value={self.row.mark.text} textColor={self.row.mark.color} />
        </box>
        <box $if={self.worked} columns={MARKED} gap={1sp} yAlign={Align::Center}>
          <text value={self.row.working} textColor={WORKING} wrap={.None} textFont={.Numbers} />
          <text value={self.row.value} textColor={self.valueInk} wrap={.None} textFont={.Numbers} />
        </box>
        <text $else value={self.row.value} textColor={self.valueInk} wrap={.None} textFont={.Numbers} />
      </box>
    }
  }
}

public class Tip implements Component {
  derived hasText: boolean = self.text != ""
  // Its width as drawn: its content's, up to its most and the art past the line on either side.
  derived width: Bounds = { min: nil, max: MOST + reachAcross(Ordaen.art.frame.small) }

  title: Signal<string>
  text: Signal<string>
  rows: Signal<array<TipRow>>
  keys: Signal<array<string>>
  sections: Signal<array<TipSection>>
  // Where it stands: beside the box it is written in, the game's way, unless its owner says which of its corners on
  // which of that box's (a page's tooltip beside the whole page, clear of what it lights).
  place: Signal<Beside>
  constructor(
    title: Signal<string>, text: Signal<string>, rows: Signal<array<TipRow>> = [], keys: Signal<array<string>> = [],
    sections: Signal<array<TipSection>> = [], place: Signal<Beside> = BY_ITS_BOX
  ) {
    self.title = title
    self.text = text
    self.rows = rows
    self.keys = keys
    self.sections = sections
    self.place = place
  }

  public render(): Template {
    return $ltml {
      <surface leading={.Tight} layer={Layer::Tooltip} place={self.place} clamp={true} width={self.width}
               border={Ordaen.art.frame.small} background={Ordaen.art.window.wood} artOrigin={true}
               padding={5sp} columns={1} gap={2sp}>
        <text value={self.title} textColor={NAME} textSize={TITLE_TEXT} leading={.Title} />
        <text $if={self.hasText} value={self.text} textColor={LABEL} />
        <TipLine $for={row of self.rows} row={row} />
        <box $for={section of self.sections} columns={1} gap={1sp} padding={{ top: 2sp }}>
          <text value={section.title} textColor={HEADING} />
          <TipLine $for={row of section.rows} row={row} />
          <TipShares $if={section.shares.length > 0} shares={section.shares} />
        </box>
        <Hotkeys keys={self.keys} />
      </surface>
    }
  }
}
