// Tip: our tooltip beside what it explains: the small metal frame round the windows' wood, its name in white, its
// text under it in the label colour, wrapped at the tooltip's width, and under that its rows, each a label at the
// start in the label colour and its value at the end in white. It stands on the screen over everything and takes no
// mouse. Its owner writes it in the box it explains and shows it while the cursor is on that box: it stands beside
// that box as the game's tooltip stands beside a button (under it, or over it in the screen's lower half; by its left
// edge, or by its right edge in the screen's right third), kept on the screen.
import { Align, Beside, Layer, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { PX } from "@/units"

const WIDTH = 314 * PX
const NAME: Color = Color.hex("#ffffff")
const LABEL: Color = Color.hex("#cbb994")
const BY_ITS_BOX: Beside = { beside: "parent" }
const ROW: Array<Track> = [{ fr: 1 }, "auto"]

// One row of a Tip: what it is, and how much.
public struct TipRow {
  const label: String
  const value: String
}

public class Tip implements Component {
  derived hasText: Boolean = self.text != ""

  title: Signal<String>
  text: Signal<String>
  rows: Signal<Array<TipRow>>
  constructor(title: Signal<String>, text: Signal<String>, rows: Signal<Array<TipRow>> = []) {
    self.title = title
    self.text = text
    self.rows = rows
  }

  public render(self): Template {
    return $ltml {
      <surface layer={Layer.Tooltip} place={BY_ITS_BOX} clamp={true} width={WIDTH}
               border={Ordaen.art.frame.small} background={Ordaen.art.window.wood} artOrigin={true}
               padding={12 * PX} columns={1} gap={2 * PX}>
        <text value={self.title} textColor={NAME} textSize={.Title} />
        <text $if={self.hasText} value={self.text} textColor={LABEL} />
        <box $for={row of self.rows} columns={ROW} gap={8 * PX} yAlign={Align.Center}>
          <text value={row.label} textColor={LABEL} />
          <text value={row.value} textColor={NAME} wrap={false} />
        </box>
      </surface>
    }
  }
}
