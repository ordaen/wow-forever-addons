// A module's entry in the settings window's list: its icon, its name, its switch; dimmed while it is off.
import { Art, Position } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, Entry, Module, SettingsPage } from "@/module"
import Runtime from "$runtime"
import { ListTab } from "@/listTab"
import { knobShown } from "@/switch"
import { PX } from "@/units"

const WIDTH = 38 * PX
const HEIGHT = 20 * PX
// The knob's art is a 26 px square with the 14 px knob in its middle: 3 px in from the track's left while off, 21
// while on, and 3 px down.
const KNOB = 26 * PX
const KNOB_TOP = (3 - 6) * PX
const KNOB_OFF = (3 - 6) * PX
const KNOB_ON = (21 - 6) * PX
const PREFIX = "Ordaen "

// A module the player has, as the settings window lists it: its addon's name, title and icon from its TOC; it runs
// while its root is among Ordaen's `modules`, and its pages are that root's.
public class ModuleEntry implements Entry {
  public const folder: String
  public const title: String
  public const icon: Art
  public derived running: any Module | nil = self.find()
  public derived on: Boolean = self.running != nil
  public derived pages: Array<SettingsPage> = self.running?.pages ?? []
  const addon: Runtime.Addon

  constructor(addon: Runtime.Addon) {
    self.addon = addon
    self.folder = addon.name
    self.title = addon.title
    self.icon = addon.icon ?? Ordaen.icon
  }

  find(self): any Module | nil {
    for (module of Ordaen.modules) {
      if (Runtime.Addon.of(module)?.name == self.folder) { return module }
    }
    return nil
  }

  public enable(self, on: Boolean) { Ordaen.turn(self.addon, on) }
}

// A module's on and off: Left-click turns it on (it is made and drawn at once) or off (it is ended at once).
public class ModuleSwitch implements Component {
  derived track: Art = self.entry.on ? Ordaen.art.ctl.switchOn : Ordaen.art.ctl.switchOff
  derived onOpacity: Number = knobShown(self.entry.on)
  derived offOpacity: Number = knobShown(!self.entry.on)

  entry: any Entry
  constructor(entry: any Entry) {
    self.entry = entry
  }

  flip(mut self) { self.entry.enable(!self.entry.on) }

  public render(self): Template {
    return $ltml {
      <box width={WIDTH} height={HEIGHT} background={self.track} @click={self.flip}>
        <box position={Position.Absolute} left={KNOB_OFF} top={KNOB_TOP} width={KNOB} height={KNOB}
             background={Ordaen.art.ctl.knobOff} opacity={self.offOpacity} />
        <box position={Position.Absolute} left={KNOB_ON} top={KNOB_TOP} width={KNOB} height={KNOB}
             background={Ordaen.art.ctl.knobOn} opacity={self.onOpacity} zLevel={1} />
      </box>
    }
  }
}

public class ModuleRow implements Component {
  // Its folder: the page the window is to show.
  public pick: Event<String> = new Event()

  // Its name in the list: its title without "Ordaen " (Ordaen Panel: Panel).
  derived name: String = self.nameOf()
  derived selected: Boolean = self.shown == self.entry.folder
  derived off: Boolean = !self.entry.on

  entry: any Entry
  shown: Signal<String>
  constructor(
    entry: any Entry,
    // The page the window shows.
    shown: Signal<String>,
  ) {
    self.entry = entry
    self.shown = shown
  }

  nameOf(self): String {
    let title = self.entry.title
    if (title.sub(1, PREFIX.length) == PREFIX) { return title.sub(PREFIX.length + 1) }
    return title
  }

  onPick(mut self) { self.pick.emit(self.entry.folder) }

  public render(self): Template {
    return $ltml {
      <ListTab label={self.name} icon={self.entry.icon} selected={self.selected} off={self.off}
               @pick={self.onPick}>
        <ModuleSwitch entry={self.entry} />
      </ListTab>
    }
  }
}
