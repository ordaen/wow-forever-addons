// ItemButton: an item's slot: its icon on a dark well, the border in its quality's colour (from uncommon up, lit inside
// in it: the rim's light), its count at the bottom
// right (from two up), and corner markers (a coloured pip each, in the top left, the top right or the bottom left)
// that other modules put on it; what its slot holds stands over the icon (a bag's mark of a new item, a lock). A slot
// with no item draws the well alone. Dimmed (by a search) it draws at 35%.
// Under the cursor the light of the other controls over the icon, and the game's own tooltip of the item beside it
// (Ordaen's tooltips draw it where they are on), gone when the cursor leaves; `entered` and `left` are told. Left-click reports
// `pick` with the item's number; Shift+Left-click puts the item's link into the chat instead, as the game's own slots
// do. Every click, of an empty slot too, is told as `pressed` (a bag's slot picks up and puts down there). With an
// `action` the right button is the client's own (a bag's item used: `Action.UseBagItem`). Nothing runs per frame.
import { Action, Align, Art, Click, Edges, Frame, Line, MouseButton, Position, Shadow, Stated } from "$ltml"
import Game from "$game"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { PX } from "@/units"

// The game's numbers for an item's quality.
public enum Quality {
  Poor = 0,
  Common = 1,
  Uncommon = 2,
  Rare = 3,
  Epic = 4,
  Legendary = 5,
  Artifact = 6,
  Heirloom = 7,
}

public enum Corner { TopLeft = "topLeft", TopRight = "topRight", BottomLeft = "bottomLeft" }

// A pip a module puts on an item's corner.
public struct Marker {
  corner: Corner
  color: Color
}

const WELL: Color = Color.hex("#0d0a08")
const CLEAR: Color = Color.hex("#00000000")
const SHINE: Stated<Color> = { default: CLEAR, hover: Color.hex("#ffffff26") }
const INK: Color = Color.hex("#ffffff")
const COUNT_SHADOW: Shadow = { color: Color.hex("#000000"), x: 1 * PX, y: -1 * PX }
const COUNT_PAD: Edges = { right: 3 * PX, bottom: 2 * PX }
const EDGE = 2 * PX
const POOR: Line = { width: EDGE, color: Color.hex("#9d9d9d") }
const COMMON: Line = { width: EDGE, color: Color.hex("#6c5535") }
const UNCOMMON: Line = { width: EDGE, color: Color.hex("#1eff00") }
const RARE: Line = { width: EDGE, color: Color.hex("#0070dd") }
const EPIC: Line = { width: EDGE, color: Color.hex("#a335ee") }
const LEGENDARY: Line = { width: EDGE, color: Color.hex("#ff8000") }
const ARTIFACT: Line = { width: EDGE, color: Color.hex("#e6cc80") }
const HEIRLOOM: Line = { width: EDGE, color: Color.hex("#00ccff") }
const PIP = 7 * PX
const PIP_EDGE: Line = { width: 1 * PX, color: Color.hex("#000000") }
const NONE: Array<Marker> = []

// One pip.
public class Pip implements Component {
  derived left: Number | nil = self.marker.corner == Corner.TopRight ? nil : 0
  derived right: Number | nil = self.marker.corner == Corner.TopRight ? 0 : nil
  derived top: Number | nil = self.marker.corner == Corner.BottomLeft ? nil : 0
  derived bottom: Number | nil = self.marker.corner == Corner.BottomLeft ? 0 : nil

  const marker: Marker
  constructor(marker: Marker) {
    self.marker = marker
  }

  public render(self): Template {
    return $ltml {
      <box position={Position.Absolute} left={self.left} right={self.right} top={self.top} bottom={self.bottom}
           width={PIP} height={PIP} background={self.marker.color} border={PIP_EDGE} />
    }
  }
}

public class ItemButton implements Component {
  public pick: Event<Integer> = new Event()
  public pressed: Event<Click> = new Event()
  public entered: Event<nil> = new Event()
  public left: Event<nil> = new Event()

  derived icon: Art | nil = self.iconOf()
  // The border: its quality's colour, the plain one for an empty slot.
  public derived edge: Line = self.edgeOf()
  // The rim's light: an item from uncommon up, in its quality's colour.
  public derived lit: Boolean = self.item != nil && self.quality != Quality.Poor && self.quality != Quality.Common
  // Always drawn, at no opacity when not lit: the slot keeps its boxes whatever it holds.
  derived rim: Number = self.lit ? 1 : 0
  derived opacity: Number = self.dimmed ? 0.35 : 1
  derived counted: Boolean = self.count > 1

  item: Signal<Integer | nil>
  count: Signal<Integer>
  quality: Signal<Quality>
  dimmed: Signal<Boolean>
  markers: Signal<Array<Marker>>
  size: Signal<Number>
  action: Signal<Action | nil>
  constructor(
    // The game's number of the item; none for an empty slot.
    item: Signal<Integer | nil>,
    count: Signal<Integer> = 1,
    quality: Signal<Quality> = Quality.Common,
    dimmed: Signal<Boolean> = false,
    markers: Signal<Array<Marker>> = NONE,
    size: Signal<Number> = 40 * PX,
    // What the client does on the player's click itself: none where the slot's clicks are its own alone.
    action: Signal<Action | nil> = nil,
  ) {
    self.item = item
    self.count = count
    self.quality = quality
    self.dimmed = dimmed
    self.markers = markers
    self.size = size
    self.action = action
  }

  iconOf(self): Art | nil {
    const item = self.item
    if (item == nil) { return nil }
    return Game.items.icon(item)
  }

  edgeOf(self): Line {
    if (self.item == nil) { return COMMON }
    return match (self.quality) {
      Quality.Poor => POOR,
      Quality.Common => COMMON,
      Quality.Uncommon => UNCOMMON,
      Quality.Rare => RARE,
      Quality.Epic => EPIC,
      Quality.Legendary => LEGENDARY,
      Quality.Artifact => ARTIFACT,
      Quality.Heirloom => HEIRLOOM,
    }
  }

  // The game's tooltip of the item beside the slot; the game hides it when the cursor leaves.
  onEnter(self, frame: any Frame) {
    const item = self.item
    if (item != nil) { Game.items.show(frame, item) }
    self.entered.emit()
  }

  onLeave(self) { self.left.emit() }

  onClick(self, click: Click) {
    const item = self.item
    if (item != nil && click.button == MouseButton.Left && Game.input.shiftDown()) {
      Game.chat.link(item)
      return
    }
    self.pressed.emit(click)
    if (item != nil && click.button == MouseButton.Left) { self.pick.emit(item) }
  }

  public render(self): Template {
    return $ltml {
      <box width={self.size} height={self.size} background={WELL} border={self.edge} opacity={self.opacity}
           action={self.action} @click={self.onClick} @enter={self.onEnter} @leave={self.onLeave}>
        <box position={Position.Absolute} left={0} top={0} right={0} bottom={0} icon={self.icon} />
        <box position={Position.Absolute} left={0} top={0} right={0} bottom={0}
             background={Ordaen.art.ctl.qualityRim} tint={self.edge.color} opacity={self.rim}
             zLevel={1} />
        <box position={Position.Absolute} left={0} top={0} right={0} bottom={0} background={SHINE}
             stateFromParent={true} />
        <Pip $for={marker of self.markers} marker={peek marker} />
        <slot />
        <box $if={self.counted} position={Position.Absolute} left={0} top={0} right={0} bottom={0}
             xAlign={Align.End} yAlign={Align.End} padding={COUNT_PAD}>
          <text value={self.count} textColor={INK} textSize={.Secondary} textShadow={COUNT_SHADOW} wrap={false} />
        </box>
      </box>
    }
  }
}
