// ItemButton: an item's slot: its icon on a dark well, the border in its quality's colour (from uncommon up, lit inside
// in it: the rim's light), its count at the bottom
// right (from two up), and corner markers (a coloured pip each, in the top left, the top right or the bottom left)
// that other modules put on it; what its slot holds stands over the icon (a bag's mark of a new item, a lock). A slot
// with no item draws the well alone. Dimmed (by a search) it draws at 35%. An item the client says the player
// can't use has its icon tinted red.
// Under the cursor the light of the other controls over the icon, and the game's own tooltip of the item beside it
// (of a slot the player wears, `worn`, that slot's: compared with nothing; of a letter's attachment, `mail`, the
// game's of it; Ordaen's tooltips draw it where they are
// on), gone when the cursor leaves; `entered` and `left` are told. Left-click reports
// `pick` with the item's number; Shift+Left-click puts the item's link into the chat instead, as the game's own slots
// do. Every click, of an empty slot too, is told as `pressed` (a bag's slot picks up and puts down there). Dragged
// with the left button it tells `dragged`, and something dragged let go on it `dropped`, as the game's own slots
// take a drag for a click (a bag's slot hands its item to the client's cursor, which the bars take). With an
// `action` its chord is the client's own (a bag's item used: `Action.UseBagItem`). A slot of a spell (`spell`) shows
// the spell's tooltip and links the spell. Nothing runs per frame.
import Client from "$client"
import Game from "$game"
import { Action, Align, Art, ByInteractionState, Cursor, Edges, Event, FillDuration, Frame, Line, MouseButton, Position, Shadow, TextFont } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { BRIGHT_TEXT, SECONDARY_TEXT } from "@/units"

// The game's numbers for an item's quality.
public enum Quality {
  Poor = 0
  Common = 1
  Uncommon = 2
  Rare = 3
  Epic = 4
  Legendary = 5
  Artifact = 6
  Heirloom = 7
}

// The client's quality of an item as the slot draws it; common where the client gave none.
public function qualityFrom(quality: Client::ItemQuality | nil): Quality {
  return match (quality) {
    .Poor => .Poor
    .Uncommon => .Uncommon
    .Rare => .Rare
    .Epic => .Epic
    .Legendary => .Legendary
    .Artifact => .Artifact
    .Heirloom => .Heirloom
    else => .Common
  }
}

// An item's name in its quality's colour, the game's (common: the light text of a dark well).
public function qualityColor(quality: Quality): Color {
  return match (quality) {
    .Poor => Color::hex("#9d9d9d")
    .Common => Color::hex("#f0e6d0")
    .Uncommon => Color::hex("#1eff00")
    .Rare => Color::hex("#0070dd")
    .Epic => Color::hex("#a335ee")
    .Legendary => Color::hex("#ff8000")
    .Artifact => Color::hex("#e6cc80")
    .Heirloom => Color::hex("#00ccff")
  }
}

// Whether the player can use the item, as the client says in its tooltip: no requirement marked unmet (level, class,
// skill, reputation), no slot or kind marked as not the player's. Read again when the kept tooltips are let go (a
// level-up, a skill changed).
public function usableItem(item: integer): boolean {
  _ = Ordaen.tipsAge
  const data = Ordaen.itemTip(item)
  if (data == nil) { return true }
  return !data.lines.any(line => line.usable == false || line.validSlot == false || line.validType == false)
}

public enum Corner { TopLeft = "topLeft", TopRight = "topRight", BottomLeft = "bottomLeft" }

// What an empty slot shows: a sunk well (the default), the client's own crested slot, as its bank and mailbox show
// it (standing out on the wood), or the client's square talent frame round the icon, as the talents draw theirs (a
// paper doll's slots, beside the talents' nodes).
public enum SlotWell { Sunk, Crested, Framed }

// A pip a module puts on an item's corner.
public struct Marker {
  corner: Corner
  color: Color
}

// A slot's well: sunk, near-black, the border round the slot; crested, the client's slot art with its own rim, the
// icon and what is drawn over it inside that rim (3 of the art's 41 texels on each side), cut to the client's icon
// shape, and an item's quality from uncommon up the rim's own colour: the theme's white copy of the rim over it, laid
// out as the crest is, tinted. The art is the file's top left 41 of its 64 texels (as its templates cut it): the
// whole file drawn that much larger, in a box that cuts it at the slot's edge.
const WELL: Color = Color::hex("#0d0a08")
const CREST: Asset = "Interface/Buttons/UI-Slot-Background"
const CREST_WHOLE = 64 / 41
const CREST_RIM = 3 / 41
const ICON_MASK: Asset = "Interface/Common/Common-IconMask"
// Framed: the client's talent frame (grey, its metal) over the slot, the icon and the well inside it, a tenth of the
// slot in from each side as the talents' nodes hold theirs; an item's quality from uncommon up the frame's tint, else
// darkened to sit with the client's empty-slot pictures (a common or poor item's, an empty slot's).
const TALENT_FRAME: Atlas = "talents-node-square-gray"
const TALENT_FRAME_RIM = 0.1
const FRAME_UNLIT: Color = Color::hex("#5a5a5a")
const NO_EDGE: Line = { width: 0dp, color: Color::hex("#00000000") }
const CLEAR: Color = Color::hex("#00000000")
const SHINE: ByInteractionState<Color> = { default: CLEAR, hover: Color::hex("#ffffff26"), focus: Color::hex("#ffffff26") }
const UNTINTED: Color = Color::hex("#ffffff")
// The game's tint of an item the player can't use (1, 0.1, 0.1).
public const UNUSABLE: Color = Color::hex("#ff1a1a")
const COUNT_SHADOW: Shadow = { color: Color::hex("#000000"), x: 1.171875dp, y: -1.171875dp }
const COUNT_PAD: Edges = { right: 1sp, bottom: 0.5sp }
const EDGE = 2.34375dp
const POOR: Line = { width: EDGE, color: Color::hex("#9d9d9d") }
const COMMON: Line = { width: EDGE, color: Color::hex("#6c5535") }
const UNCOMMON: Line = { width: EDGE, color: Color::hex("#1eff00") }
const RARE: Line = { width: EDGE, color: Color::hex("#0070dd") }
const EPIC: Line = { width: EDGE, color: Color::hex("#a335ee") }
const LEGENDARY: Line = { width: EDGE, color: Color::hex("#ff8000") }
const ARTIFACT: Line = { width: EDGE, color: Color::hex("#e6cc80") }
const HEIRLOOM: Line = { width: EDGE, color: Color::hex("#00ccff") }
const PIP = 8.203125dp
const PIP_EDGE: Line = { width: 1.171875dp, color: Color::hex("#000000") }
const NONE: array<Marker> = []

// One pip.
public class Pip implements Component {
  derived left: number<Length> | nil = self.marker.corner == Corner::TopRight ? nil : 0ui
  derived right: number<Length> | nil = self.marker.corner == Corner::TopRight ? 0ui : nil
  derived top: number<Length> | nil = self.marker.corner == Corner::BottomLeft ? nil : 0ui
  derived bottom: number<Length> | nil = self.marker.corner == Corner::BottomLeft ? 0ui : nil

  const marker: Marker
  constructor(marker: Marker) {
    self.marker = marker
  }

  public render(): Template {
    return $ltml {
      <box position={Position::Absolute} left={self.left} right={self.right} top={self.top} bottom={self.bottom}
           width={PIP} height={PIP} background={self.marker.color} border={PIP_EDGE} zLevel={2} />
    }
  }
}

public class ItemButton implements Component {
  public pick: Event<integer> = new Event()
  public pressed: Event<Event::Press> = new Event()
  public entered: Event<nil> = new Event()
  public left: Event<nil> = new Event()
  public dragged: Event<nil> = new Event()
  public dropped: Event<nil> = new Event()

  derived icon: Art | nil = self.iconOf()
  // Whether the player can use the item, as the client says in its tooltip: a requirement it marks unmet (level,
  // class, skill, reputation) or a slot or kind it marks as not the player's. One the player can't use is tinted red
  // over its icon, as the game's own slots are.
  public derived usable: boolean = self.usableOf()
  derived tint: Color = self.usable ? UNTINTED : UNUSABLE
  // The border: its quality's colour, the plain one for an empty slot.
  public derived edge: Line = self.edgeOf()
  // The rim's light: an item from uncommon up, in its quality's colour.
  public derived lit: boolean = self.item != nil && self.quality != Quality::Poor && self.quality != Quality::Common
  // Always drawn, at no opacity when not lit (or in a crest or a talent frame, which takes the colour): the slot keeps
  // its boxes whatever it holds.
  derived rim: number = self.lit && self.sunk ? 1 : 0
  derived opacity: number = self.dimmed ? 0.35 : 1
  derived counted: boolean = self.count > 1
  derived sunk: boolean = self.well == SlotWell::Sunk
  derived crested: boolean = self.well == SlotWell::Crested
  derived talentFramed: boolean = self.well == SlotWell::Framed
  // The well's dark under the whole slot when sunk; inside the talent frame when framed; none in a crest.
  derived floor: Color = self.sunk ? WELL : CLEAR
  derived crestSize: number<Length> = self.size * CREST_WHOLE
  // Where the icon stands inside the slot: inside the crest's rim or the talent frame, or edge to edge.
  derived inset: number<Length> = self.crested ? self.size * CREST_RIM : self.talentFramed ? self.size * TALENT_FRAME_RIM : 0dp
  // The border goes round the slot on a sunk well; a crest's rim and a talent frame are their own, coloured by an item's
  // quality.
  derived slotEdge: Line = self.sunk ? self.edge : NO_EDGE
  derived frameTint: Color = self.lit ? self.edge.color : FRAME_UNLIT
  derived framed: boolean = self.crested && self.lit
  derived iconMask: Asset | nil = self.crested ? ICON_MASK : nil

  // The frame its `enter` handed, while the cursor is on it.
  state hoveredBy: any Frame | nil = nil
  item: Signal<integer | nil>
  count: Signal<integer>
  quality: Signal<Quality>
  dimmed: Signal<boolean>
  markers: Signal<array<Marker>>
  size: Signal<number<Length>>
  action: Signal<Action | nil>
  actsOnPress: Signal<boolean>
  art: Signal<Art | nil>
  linkOnShift: Signal<boolean>
  worn: Signal<integer | nil>
  spell: Signal<integer | nil>
  currency: Signal<integer | nil>
  cooldown: Signal<FillDuration | nil>
  mail: Signal<[integer, integer] | nil>
  bag: Signal<[integer, integer] | nil>
  well: Signal<SlotWell>
  cursor: Signal<Cursor | nil>
  tipped: Signal<boolean>
  toldUsable: Signal<boolean | nil>
  constructor(
    // The game's number of the item; none for an empty slot.
    item: Signal<integer | nil>,
    count: Signal<integer> = 1,
    quality: Signal<Quality> = Quality::Common,
    dimmed: Signal<boolean> = false,
    markers: Signal<array<Marker>> = NONE,
    size: Signal<number<Length>> = 46.875dp,
    // What the client does on the player's click itself: none where the slot's clicks are its own alone.
    action: Signal<Action | nil> = nil,
    // Whether the client does the `action` as the button goes down; else as it comes up, whatever the player set, so
    // a drag off the slot is no click.
    actsOnPress: Signal<boolean> = false,
    // The icon the game gave with what the slot shows (a reagent's): drawn in place of the item's, with or without one.
    art: Signal<Art | nil> = nil,
    // Whether Shift+Left-click puts the item's link into the chat; off, it is told as `pressed` (a slot whose clicks
    // the player sets).
    linkOnShift: Signal<boolean> = true,
    // The player's own slot it is (the client's number for it: 1 the head): its tooltip is the worn item's, as the
    // game's paper doll shows it, never the item's by its number (which the game compares with what is worn: itself).
    worn: Signal<integer | nil> = nil,
    // The attachment of a letter of the open mailbox it shows (the letter's place in the inbox, the attachment's in
    // the letter): its tooltip is the game's of that attachment, as the game's open letter shows it.
    mail: Signal<[integer, integer] | nil> = nil,
    // The slot of the player's bags or bank it shows (the client's bag and slot): its tooltip is that very item's (bound
    // or not, how worn), as the game's bags show it, not the item's by its number.
    bag: Signal<[integer, integer] | nil> = nil,
    // The spell it shows, in place of an item (a spellbook's slot, its icon the `art`): its tooltip and its link are
    // the spell's, as the game's spellbook gives them.
    spell: Signal<integer | nil> = nil,
    // The currency it shows, in place of an item (a quest's currency reward, its icon the `art`): its tooltip is the
    // game's of the currency, with the `count`.
    currency: Signal<integer | nil> = nil,
    // The cooldown running on what it shows: the client's sweep over the icon. None: no sweep.
    cooldown: Signal<FillDuration | nil> = nil,
    // How its well stands on what holds it.
    well: Signal<SlotWell> = SlotWell::Sunk,
    // The cursor's look while it is on the slot (the coin bag at a merchant).
    cursor: Signal<Cursor | nil> = nil,
    // Whether it shows its tooltip itself; off where what holds it shows one for all of it (a reward's row).
    tipped: Signal<boolean> = true,
    // Whether the player can use it, where the game says so in its own right (a toy: the toy box's `IsToyUsable`) and
    // not by its tooltip, whose «Already known» a toy collected has in red. None: by its tooltip.
    usable: Signal<boolean | nil> = nil
  ) {
    self.toldUsable = usable
    self.cursor = cursor
    self.tipped = tipped
    self.cooldown = cooldown
    self.well = well
    self.currency = currency
    self.spell = spell
    self.mail = mail
    self.bag = bag
    self.art = art
    self.linkOnShift = linkOnShift
    self.actsOnPress = actsOnPress
    self.worn = worn
    self.item = item
    self.count = count
    self.quality = quality
    self.dimmed = dimmed
    self.markers = markers
    self.size = size
    self.action = action
    // What it holds changing under the cursor (an item equipped from it, the worn one landing there): its tooltip
    // follows.
    watch { self.retip() }
  }

  iconOf(): Art | nil {
    const art = self.art
    if (art != nil) { return art }
    const item = self.item
    if (item == nil) { return nil }
    return Game::items.icon(item)
  }

  usableOf(): boolean {
    const said = self.toldUsable
    if (said != nil) { return said }
    const item = self.item
    if (item == nil) { return true }
    return usableItem(item)
  }

  edgeOf(): Line {
    if (self.item == nil) { return self.crested ? NO_EDGE : COMMON }
    return match (self.quality) {
      Quality::Poor => POOR
      Quality::Common => COMMON
      Quality::Uncommon => UNCOMMON
      Quality::Rare => RARE
      Quality::Epic => EPIC
      Quality::Legendary => LEGENDARY
      Quality::Artifact => ARTIFACT
      Quality::Heirloom => HEIRLOOM
    }
  }

  // The game's tooltip of the item beside the slot, of a worn one its slot's; the game hides it when the cursor
  // leaves.
  mut onEnter(frame: any Frame) {
    self.hoveredBy = frame
    if (self.tipped) { self.tip(frame) }
    self.entered.emit()
  }

  // What it holds changed while the cursor is on it: the tooltip shown again, of what it holds now; none where it
  // holds nothing.
  retip() {
    const item = self.item
    _ = self.worn
    _ = self.spell
    _ = self.mail
    _ = self.bag
    _ = self.currency
    _ = self.count
    const frame = peek self.hoveredBy
    if (frame == nil || !(peek self.tipped)) { return }
    if (item == nil && peek self.spell == nil && peek self.currency == nil) {
      Game::items.hideAt(frame)
      return
    }
    self.tip(frame)
  }

  tip(frame: any Frame) {
    const item = self.item
    const worn = self.worn
    const spell = self.spell
    const mail = self.mail
    const bag = self.bag
    const currency = self.currency
    if (spell != nil) {
      Game::items.showSpell(frame, spell)
    } else if (currency != nil) {
      Game::items.showCurrency(frame, currency, self.count)
    } else if (item != nil && mail != nil) {
      Game::items.showMail(frame, mail[1], mail[2])
    } else if (item != nil && worn != nil) {
      Game::items.showWorn(frame, worn)
    } else if (item != nil && bag != nil) {
      Game::items.showBag(frame, bag[1], bag[2])
    } else if (item != nil) {
      Game::items.show(frame, item)
    }
  }

  mut onLeave() {
    self.hoveredBy = nil
    self.left.emit()
  }

  onClick(click: Event::Press) {
    const item = self.item
    const spell = self.spell
    const linking = self.linkOnShift && click.button == MouseButton::Left && Game::input.shiftDown()
    if (linking && spell != nil) {
      Game::chat.linkSpell(spell)
      return
    }
    if (linking && item != nil) {
      Game::chat.link(item)
      return
    }
    self.pressed.emit(click)
    if (item != nil && click.button == MouseButton::Left) { self.pick.emit(item) }
  }

  onDragStart() { self.dragged.emit() }
  onDrop() { self.dropped.emit() }

  public render(): Template {
    return $ltml {
      <box width={self.size} height={self.size} background={self.floor} border={self.slotEdge} opacity={self.opacity}
           action={self.action} actsOnPress={self.actsOnPress} cursor={self.cursor} @pointerPress={self.onClick} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}
           @dragStart={self.onDragStart} @drop={self.onDrop}>
        <box $if={self.crested} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             overflow={.Hidden}>
          <box position={Position::Absolute} left={0ui} top={0ui} width={self.crestSize} height={self.crestSize}
               background={CREST} />
        </box>
        <box $if={self.talentFramed} position={Position::Absolute} left={self.inset} top={self.inset} right={self.inset}
             bottom={self.inset} background={WELL} />
        <box position={Position::Absolute} left={self.inset} top={self.inset} right={self.inset} bottom={self.inset}
             icon={self.icon} tint={self.tint} mask={self.iconMask} cooldown={self.cooldown} />
        <box $if={self.talentFramed} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             background={TALENT_FRAME} tint={self.frameTint} zLevel={1} />
        <box $if={self.framed} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             overflow={.Hidden}>
          <box position={Position::Absolute} left={0ui} top={0ui} width={self.crestSize} height={self.crestSize}
               background={Ordaen.art.ctl.crestRim} tint={self.edge.color} />
        </box>
        <box position={Position::Absolute} left={self.inset} top={self.inset} right={self.inset} bottom={self.inset}
             background={Ordaen.art.ctl.qualityRim} tint={self.edge.color} opacity={self.rim} zLevel={1} />
        // The light under the cursor over the icon alone: inside a crest's rim or a talent frame, never over its curves.
        <box position={Position::Absolute} left={self.inset} top={self.inset} right={self.inset} bottom={self.inset}
             background={SHINE} />
        <Pip $for={marker of self.markers} marker={peek marker} />
        <slot />
        <box $if={self.counted} position={Position::Absolute} left={self.inset} top={self.inset} right={self.inset}
             bottom={self.inset} xAlign={Align::End} yAlign={Align::End} padding={COUNT_PAD}>
          <text value={self.count} textColor={BRIGHT_TEXT} textSize={SECONDARY_TEXT} leading={.Tight}
                textFont={TextFont::Numbers} textOutline={1} textShadow={COUNT_SHADOW} wrap={.None} />
        </box>
      </box>
    }
  }
}
