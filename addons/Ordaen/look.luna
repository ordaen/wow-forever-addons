// Ordaen's look: the fonts, the colours and the bars' art every module draws with, which the player chooses. It is
// Ordaen's own settings (`Ordaen:look`), applied at once and gone back through with every other. A preset is a whole
// look by its name: choosing one writes every entry at once, one change, and a change after it is a change like any other.
// What no preset changes (the metal, the wood, the controls' art, the measures) is Ordaen's art (art.luna).
import { Art, FontFiles, Fonts, Piece, Tile } from "$ltml"

// The fonts Ordaen ships (its media, SIL Open Font License): each with Cyrillic, and each with a bold face, which
// bold text is drawn in. A font with no bold face isn't offered.
public enum Font implements Plain {
  FiraSans = "firaSans"
  AlegreyaSans = "alegreyaSans"
  PtSans = "ptSans"
  Philosopher = "philosopher"
  AlegreyaSC = "alegreyaSC"
  CormorantSC = "cormorantSC"
  FiraCondensed = "firaCondensed"
  PtSansNarrow = "ptSansNarrow"
}

// The fonts numbers may be drawn in: those whose ten digits are equally wide (`TabularFont`, measured as the addon is
// built), so a count never shifts as it changes. The client draws a font's own digits, never its tabular ones.
public enum NumbersFont implements Plain {
  PtSans = "ptSans"
  PtSansNarrow = "ptSansNarrow"
}

// The fonts a page of sentences may be set in (`TextFont.Book`: a quest's story on its parchment): serifs made for
// reading, each with Cyrillic, shipped regular and bold (SIL Open Font License).
public enum BookFont implements Plain {
  PtSerif = "ptSerif"
  Alegreya = "alegreya"
  Literata = "literata"
  Lora = "lora"
}

// What a plain bar is filled with.
public enum BarTexture implements Plain { Flat = "flat", Blizzard = "blizzard" }
// What fills an experience bar, and every bar that looks like it: chosen where the bar is, over the look's bar texture.
public enum XpFill implements Plain { Deep = "deep", Grain = "grain", Brushed = "brushed", Potion = "potion", Clouds = "clouds", Steel = "steel" }
// A bar's edge.
public enum BarFrame implements Plain { Bezel = "bezel", Groove = "groove" }
public enum Animation implements Plain { Smooth = "smooth", Fast = "fast", Off = "off" }
// A colour of the palette, by its name: what a class is coloured with.
public enum Hue implements Plain {
  Red = "red", Orange = "orange", Yellow = "yellow", Green = "green", Cyan = "cyan", Blue = "blue"
  Violet = "violet", Pink = "pink", Tan = "tan", White = "white", Grey = "grey"
}

public enum Preset { Ordaen = "ordaen", Minimal = "minimal" }
// The presets, in the order the settings window lists them.
public const PRESETS: Array<Preset> = [Preset::Ordaen, Preset::Minimal]

public struct Look implements Plain {
  // The text's, the titles', the numbers' and a page of sentences' fonts.
  font: Font
  fontHeader: Font
  fontNumbers: NumbersFont
  fontBook: BookFont
  accent: Color
  // A section's title (a heading's, or one standing on a cut), and the paint of a heading's rule as it shows on the wood.
  heading: Color
  headingPaint: Color
  barTexture: BarTexture
  barFrame: BarFrame
  animation: Animation
  // The palette every module colours with: each colour as a bar's fill, and as text.
  red: Color
  redText: Color
  orange: Color
  orangeText: Color
  yellow: Color
  yellowText: Color
  green: Color
  greenText: Color
  cyan: Color
  cyanText: Color
  blue: Color
  blueText: Color
  violet: Color
  violetText: Color
  pink: Color
  pinkText: Color
  tan: Color
  tanText: Color
  white: Color
  whiteText: Color
  grey: Color
  greyText: Color
  // Each class's colour of the palette.
  warrior: Hue
  paladin: Hue
  hunter: Hue
  rogue: Hue
  priest: Hue
  shaman: Hue
  mage: Hue
  warlock: Hue
  druid: Hue
}

// Ordaen's own look: bronze, dark wood, Ordaen's own fonts.
const ORDAEN: Look = {
  font: Font::FiraSans, fontHeader: Font::AlegreyaSC, fontNumbers: NumbersFont::PtSansNarrow, fontBook: BookFont::PtSerif,
  accent: { r: 0.72, g: 0.56, b: 0.34, a: 1 },
  heading: Color::hex("#e8c35a"), headingPaint: Color::hex("#a8853a"),
  barTexture: BarTexture::Flat, barFrame: BarFrame::Bezel, animation: Animation::Smooth,
  red: { r: 0.737, g: 0.004, b: 0.044, a: 1 }, redText: { r: 0.999, g: 0.631, b: 0.582, a: 1 },
  orange: { r: 0.634, g: 0.256, b: 0.007, a: 1 }, orangeText: { r: 0.996, g: 0.644, b: 0.484, a: 1 },
  yellow: { r: 0.779, g: 0.588, b: 0.032, a: 1 }, yellowText: { r: 1, g: 0.85, b: 0.535, a: 1 },
  green: { r: 0.034, g: 0.422, b: 0.007, a: 1 }, greenText: { r: 0.565, g: 0.821, b: 0.537, a: 1 },
  cyan: { r: 0.023, g: 0.434, b: 0.525, a: 1 }, cyanText: { r: 0.318, g: 0.814, b: 0.951, a: 1 },
  blue: { r: 0.006, g: 0.335, b: 0.671, a: 1 }, blueText: { r: 0.336, g: 0.625, b: 0.997, a: 1 },
  violet: { r: 0.472, g: 0.287, b: 0.629, a: 1 }, violetText: { r: 0.823, g: 0.662, b: 0.981, a: 1 },
  pink: { r: 0.608, g: 0.234, b: 0.415, a: 1 }, pinkText: { r: 0.979, g: 0.615, b: 0.77, a: 1 },
  tan: { r: 0.494, g: 0.358, b: 0.21, a: 1 }, tanText: { r: 0.865, g: 0.713, b: 0.555, a: 1 },
  white: { r: 0.669, g: 0.669, b: 0.669, a: 1 }, whiteText: { r: 0.934, g: 0.934, b: 0.934, a: 1 },
  grey: { r: 0.389, g: 0.389, b: 0.389, a: 1 }, greyText: { r: 0.743, g: 0.743, b: 0.743, a: 1 },
  warrior: Hue::Tan, paladin: Hue::Pink, hunter: Hue::Green, rogue: Hue::Yellow, priest: Hue::White,
  shaman: Hue::Blue, mage: Hue::Cyan, warlock: Hue::Violet, druid: Hue::Orange
}

// Flat, thin lines, almost no textures or animations.
const MINIMAL: Look = {
  fontHeader: Font::FiraSans,
  accent: { r: 0.62, g: 0.62, b: 0.62, a: 1 },
  animation: Animation::Off,
  ..ORDAEN
}

// A preset: a whole look.
public function preset(name: Preset): Look {
  match (name) {
    Preset::Ordaen => return ORDAEN
    Preset::Minimal => return MINIMAL
  }
}

// The look a player who chose the Blizzard preset has saved, as it loads: its fonts (the client's, which have no bold)
// are no longer offered and load as Ordaen's. Ordaen offers no such preset, and loads it as Ordaen's.
const BLIZZARD: Look = {
  accent: { r: 1, g: 0.82, b: 0, a: 1 },
  barTexture: BarTexture::Blizzard, animation: Animation::Fast,
  ..ORDAEN
}

// Whether a look loaded is one of a preset Ordaen doesn't offer, to be loaded as Ordaen's.
public function unoffered(look: Look): Boolean {
  return look.equal(BLIZZARD)
}

// The preset a look is, where it is one as it stands.
public function presetOf(look: Look): Preset | nil {
  for (name of PRESETS) {
    if (look.equal(preset(name))) { return name }
  }
  return nil
}

// A colour of the palette as a look has it.
public function hueColor(look: Look, hue: Hue): Color {
  match (hue) {
    Hue::Red => return look.red
    Hue::Orange => return look.orange
    Hue::Yellow => return look.yellow
    Hue::Green => return look.green
    Hue::Cyan => return look.cyan
    Hue::Blue => return look.blue
    Hue::Violet => return look.violet
    Hue::Pink => return look.pink
    Hue::Tan => return look.tan
    Hue::White => return look.white
    Hue::Grey => return look.grey
  }
}

// The files a look picks, as what draws them takes them: read through `Ordaen::lookArt`, worked out once a save.
// Its fonts are the renderer's (`Runtime.fonts`, given by Ordaen's root): every text an addon draws takes the one
// its `textFont` names, `Body` where it names none.
public struct LookArt {
  fonts: Fonts
  bar: Art
}

// A font's files, regular and bold (its heavier face).
function fontFiles(font: Font): FontFiles {
  match (font) {
    Font::FiraSans => return { regular: "@/media/fonts/FiraSans-Regular.ttf", bold: "@/media/fonts/FiraSans-Medium.ttf" }
    Font::AlegreyaSans => return {
      regular: "@/media/fonts/AlegreyaSans-Regular.ttf", bold: "@/media/fonts/AlegreyaSans-Medium.ttf"
    }
    Font::PtSans => return { regular: "@/media/fonts/PTSans-Regular.ttf", bold: "@/media/fonts/PTSans-Bold.ttf" }
    Font::Philosopher => return {
      regular: "@/media/fonts/Philosopher-Regular.ttf", bold: "@/media/fonts/Philosopher-Bold.ttf"
    }
    Font::AlegreyaSC => return { regular: "@/media/fonts/AlegreyaSC-Medium.ttf", bold: "@/media/fonts/AlegreyaSC-Bold.ttf" }
    Font::CormorantSC => return {
      regular: "@/media/fonts/CormorantSC-SemiBold.ttf", bold: "@/media/fonts/CormorantSC-Bold.ttf"
    }
    Font::FiraCondensed => return {
      regular: "@/media/fonts/FiraSansCondensed-Medium.ttf", bold: "@/media/fonts/FiraSansCondensed-Bold.ttf"
    }
    Font::PtSansNarrow => return {
      regular: "@/media/fonts/PTSansNarrow-Regular.ttf", bold: "@/media/fonts/PTSansNarrow-Bold.ttf"
    }
  }
}

// A book font's files, regular and bold.
function bookFiles(font: BookFont): FontFiles {
  match (font) {
    BookFont::PtSerif => return { regular: "@/media/fonts/PTSerif-Regular.ttf", bold: "@/media/fonts/PTSerif-Bold.ttf" }
    BookFont::Alegreya => return { regular: "@/media/fonts/Alegreya-Regular.ttf", bold: "@/media/fonts/Alegreya-Bold.ttf" }
    BookFont::Literata => return { regular: "@/media/fonts/Literata-Regular.ttf", bold: "@/media/fonts/Literata-Bold.ttf" }
    BookFont::Lora => return { regular: "@/media/fonts/Lora-Regular.ttf", bold: "@/media/fonts/Lora-Bold.ttf" }
  }
}

// A numbers font's files: the regular one, its digits measured where it is written, and its bold face.
function numbersFile(font: NumbersFont): TabularFont {
  match (font) {
    NumbersFont::PtSans => return "@/media/fonts/PTSans-Regular.ttf"
    NumbersFont::PtSansNarrow => return "@/media/fonts/PTSansNarrow-Regular.ttf"
  }
}

function numbersBold(font: NumbersFont): Asset {
  match (font) {
    NumbersFont::PtSans => return "@/media/fonts/PTSans-Bold.ttf"
    NumbersFont::PtSansNarrow => return "@/media/fonts/PTSansNarrow-Bold.ttf"
  }
}

function barFile(texture: BarTexture): Art {
  match (texture) {
    BarTexture::Flat => return "Interface/Buttons/WHITE8X8"
    BarTexture::Blizzard => return "Interface/TargetingFrame/UI-StatusBar"
  }
}

// An experience bar's fill: one tile, repeated along the bar.
function xpPiece(file: Asset): Piece {
  return { file: file, width: 1024, height: 32, tile: Tile::Across }
}

public function xpFillArt(fill: XpFill): Art {
  match (fill) {
    XpFill::Deep => return xpPiece("@/media/xp-fill-deep.tga")
    XpFill::Grain => return xpPiece("@/media/xp-fill-grain.tga")
    XpFill::Brushed => return xpPiece("@/media/xp-fill-brushed.tga")
    XpFill::Potion => return xpPiece("@/media/xp-fill-potion.tga")
    XpFill::Clouds => return xpPiece("@/media/xp-fill-clouds.tga")
    XpFill::Steel => return xpPiece("@/media/xp-fill-steel.tga")
  }
}

public function artOf(look: Look): LookArt {
  return {
    fonts: {
      body: fontFiles(look.font), title: fontFiles(look.fontHeader),
      numbers: { regular: numbersFile(look.fontNumbers), bold: numbersBold(look.fontNumbers) }, book: bookFiles(look.fontBook)
    },
    bar: barFile(look.barTexture)
  }
}
