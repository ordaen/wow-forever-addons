-- two hours: nothing under the price
box 0,0 200x15.6
  text 0,0 200x15.6 "price" #ffffff

-- one day: «(1 d.)» in amber
box 0,0 200x31.2
  text 0,0 200x15.6 "price" #ffffff
  text 0,15.6 200x15.6 "(1 d.)" #ffb02e

-- three days and a bit: «(3 d.)», still amber
box 0,0 200x31.2
  text 0,0 200x15.6 "price" #ffffff
  text 0,15.6 200x15.6 "(3 d.)" #ffb02e

-- four days: «(4 d.)» dimmed
box 0,0 200x31.2
  text 0,0 200x15.6 "price" #ffffff
  text 0,15.6 200x15.6 "(4 d.)" #a3977f

-- thirty days: «(30 d.)» dimmed, the last one shown
box 0,0 200x31.2
  text 0,0 200x15.6 "price" #ffffff
  text 0,15.6 200x15.6 "(30 d.)" #a3977f

-- thirty-one days: nothing, a price that old isn't one
box 0,0 200x15.6
  text 0,0 200x15.6 "price" #ffffff

-- no price: nothing
box 0,0 200x15.6
  text 0,0 200x15.6 "price" #ffffff
