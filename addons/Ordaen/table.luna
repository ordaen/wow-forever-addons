// Table: columns under headings, and the rows the page draws under them. The headings are the table's; a click on a
// sortable heading sorts by it, again reverses (the cells `sorted`, the column's number from 1, and `descending`, which
// the page handed with `mut` and orders its rows by: the table keeps no list of rows, so a row follows its own cells
// and nothing is made for it when another changes). The rows are `TableRow`s in the table's slot, each laid out in the
// columns' tracks (`tracksOf(columns)`, made once where the columns are). The body is a virtual list, each row as high
// as the first it built came to (a box, every row built, where the table is told its rows vary): it scrolls where it is
// given a `height`, or where the table is given a height (its headings, then the body in the rest of it), and a `$for`
// of rows in it builds only the rows in view, handing on the rows that leave to the items that come in: a row follows
// its item's cell. A cell's texts wrap at its column unless they say they are cut (`wrap={.Cut}`); while the owner
// has no rows, the table
// says what it is given as `empty` under its headings. `ToolSort` is its sort in the toolbar, with sorts no column shows.
import Game from "$game"
import { Align, Art, ByInteractionState, Edges, Event, Frame, Line, MouseButton, Position, Side, TextAlign, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component } from "@/module"
import { Ground, ScrolledList } from "@/scrolledList"
import { BRIGHT_TEXT } from "@/units"

// A column: its heading (`""`: none), its width, where its heading and its cells stand (`Align.Center` too), whether a
// heading click sorts by it, the group it is in: neighbouring columns of one group share a heading over theirs.
public struct Column {
  title: String
  width: Track
  align: Align | nil
  sortable: Boolean | nil
  group: String | nil
}

// A heading over a run of columns: its group's title, `""` over a column in none; how many columns it spans.
struct Span {
  title: String
  columns: Integer
}

// The headings over the columns' headings, one per run of neighbouring columns of one group, one per column in none;
// none where no column has a group.
function spansOf(columns: Array<Column>): Array<Span> {
  let spans: Array<Span> = []
  if (!columns.any(column => column.group != nil)) { return spans }
  for (index, column of columns) {
    const group = column.group
    if (group == nil) {
      spans.push({ title: "", columns: 1 })
    } else if (columns[index - 1]?.group != group) {
      let run = 1
      for (next of index + 1..columns.length) {
        if (columns[next]?.group != group) { break }
        run = run + 1
      }
      spans.push({ title: group, columns: run })
    }
  }
  return spans
}

const NAME: ByInteractionState<Color> = { default: Color.hex("#cbb994"), hover: BRIGHT_TEXT, focus: BRIGHT_TEXT }
const PLAIN: Color = Color.hex("#a3977f")
const GOLD: Color = Color.hex("#f0c860")
const RULE: Line = { width: 1.171875dp, color: Color.hex("#3e2f1d"), sides: [Side.Bottom] }
// A group's heading: its title over its columns, a rule under it reaching across them.
const GROUP_RULE: Line = { width: 1.171875dp, color: Color.hex("#5a4630"), sides: [Side.Bottom] }
const LIGHT: Color = Color.hex("#d6a56b")
const CLEAR: Color = Color.hex("#00000000")
const SHADE: ByInteractionState<Color> = { default: CLEAR, hover: Color.hex("#00000033"), focus: Color.hex("#00000033") }
const BACK: Color = Color.hex("#00000040")
const PADDING: Edges = { top: 3sp, bottom: 3sp }
// A row of one line of text is the line and half a line round it: a line and a half of the rhythm, whatever the
// density.
const ROW_PADDING: Edges = { top: 1.5sp, right: 3sp, bottom: 1.5sp, left: 3sp }
const SIDES: Edges = { left: 3sp, right: 3sp }
const HEAD: Array<Track> = ["max-content", "max-content"]
// A row of one line of text: the text and the row's padding.
public const ROW: Number<Length> = 32.8125dp
// Where the text of a table with no rows stands: under its headings, a row down.
const EMPTY_TOP: Number<Length> = 46.875dp
// The well fills what the table is given; its headings stay over its rows as they scroll.
const FILLED: Array<Track> = [{ fr: 1 }]
// A sorted heading's mark (ctl.markUp, ctl.markDown): a triangle 8 px wide and 6 high in the middle of a 16 px cell.
const MARK_WIDTH = 9.375dp
const MARK_HEIGHT = 7.03125dp
const MARK_CELL = 18.75dp
const MARK_LEFT = (MARK_WIDTH - MARK_CELL) / 2
const MARK_TOP = (MARK_HEIGHT - MARK_CELL) / 2

// The tracks of a table's columns: one per column, as wide as its `width`.
public function tracksOf(columns: Array<Column>): Array<Track> {
  let list: Array<Track> = []
  for (column of columns) { list.push(column.width) }
  return list
}

// One heading.
public class Heading implements Component {
  derived picked: Boolean = self.sorted == self.index
  // The light under it and the mark are always drawn, what isn't the state clear or at no opacity: only colours and
  // the mark's art tell the heading the rows are ordered by, and which way.
  derived light: Color = self.picked ? LIGHT : CLEAR
  derived marked: Number = self.picked ? 1 : 0
  derived mark: Art = self.descending ? Ordaen.art.ctl.markDown : Ordaen.art.ctl.markUp
  derived sortable: Boolean = self.column.sortable == true
  derived color: Color | ByInteractionState<Color> = self.picked ? GOLD : self.sortable ? NAME : PLAIN
  derived shade: Color | ByInteractionState<Color> = self.sortable ? SHADE : CLEAR

  column: Signal<Column>
  const index: Integer
  sorted: mut Signal<Integer>
  descending: mut Signal<Boolean>
  constructor(
    column: Signal<Column>,
    index: Integer,
    sorted: mut Signal<Integer>,
    descending: mut Signal<Boolean>
  ) {
    self.column = column
    self.index = index
    self.sorted = sorted
    self.descending = descending
  }

  onClick(mut self) {
    if (!self.sortable) { return }
    if (self.picked) {
      self.descending = !self.descending
    } else {
      self.sorted = self.index
      self.descending = false
    }
  }

  public render(self): Template {
    return $ltml {
      <box padding={PADDING} xAlign={self.column.align} background={self.shade} @pointerPress={self.onClick} @keyPress(.Enter)={self.onClick} @keyPress(.Space)={self.onClick}>
        <box position={Position.Absolute} left={0ui} right={0ui} bottom={0ui} height={2.34375dp} background={self.light} />
        // The title lights with the heading, wherever on it the cursor is.
        <box columns={HEAD} gap={1sp} yAlign={Align.Center} interactionState={self.$interactionState}>
          <text value={self.column.title} textColor={self.color} wrap={.None} />
          // The mark takes the triangle's own room; its cell, a triangle in its middle, reaches past it.
          <box $if={self.sortable} width={MARK_WIDTH} height={MARK_HEIGHT}>
            <box position={Position.Absolute} left={MARK_LEFT} top={MARK_TOP} width={MARK_CELL}
                 height={MARK_CELL} background={self.mark} tint={GOLD}
                 opacity={self.marked} />
          </box>
        </box>
      </box>
    }
  }
}

// A group's heading over its columns' headings; over a column in no group, nothing.
class GroupHeading implements Component {
  derived titled: Boolean = self.span.title != ""

  span: Signal<Span>
  constructor(span: Signal<Span>) { self.span = span }

  public render(self): Template {
    return $ltml {
      <box $if={self.titled} columnSpan={self.span.columns} padding={PADDING} xAlign={Align.Center} border={GROUP_RULE}>
        <text value={self.span.title} textColor={PLAIN} wrap={.None} />
      </box>
      <box $else columnSpan={self.span.columns} />
    }
  }
}

// One row of a table: its cells in the slot, laid out in the columns' tracks. The shade under the cursor; selected, a
// darker one. On the wood (`Ground.Wood`, as its table stands) a rule under it. A click of any button reports `pick` with the click (its button and where it was in the row), as a
// box's `click` does: the page tells a left-click from a right-click. A double press reports `double` after its
// second `pick`; the cursor coming onto any part of the row reports `enter` with the row's frame (a tooltip stands
// beside it), and leaving it `leave`.
public class TableRow implements Component {
  public pick: Event<MouseButton> = new Event()
  public double: Event<nil> = new Event()
  public enter: Event<any Frame> = new Event()
  public leave: Event<nil> = new Event()

  derived background: Color | ByInteractionState<Color> = self.selected ? BACK : SHADE
  derived rule: Line | nil = self.ground == Ground.Wood ? RULE : nil

  tracks: Signal<Array<Track>>
  selected: Signal<Boolean>
  // How high it is: as high as what it holds with its padding (a line of text: a line and a half), unless it is told
  // another (a row of icons).
  const height: Number<Length> | nil
  ground: Signal<Ground>
  constructor(
    tracks: Signal<Array<Track>>,
    selected: Signal<Boolean> = false,
    height: Number<Length> | nil = nil,
    // What its table stands on: on the wood, rows are ruled apart.
    ground: Signal<Ground> = Ground.Well
  ) {
    self.tracks = tracks
    self.selected = selected
    self.height = height
    self.ground = ground
  }

  onClick(mut self, click: Event.Press) { self.pick.emit(click.button) }
  onKey(mut self) { self.pick.emit(.Left) }
  onDouble(mut self) { self.double.emit() }
  // A list's row: the tooltips of what it holds stand beside it, never over the rows round it.
  onEnter(mut self, frame: any Frame) {
    Game.tooltip.rowAt(frame)
    self.enter.emit(frame)
  }
  onLeave(mut self) { self.leave.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={self.tracks} height={self.height} gap={3sp} padding={ROW_PADDING} yAlign={Align.Center} background={self.background} border={self.rule}
           @pointerPress.self={self.onClick} @pointerPress.self.double={self.onDouble} @pointerEnter={self.onEnter}
           @pointerLeave={self.onLeave} @keyPress(.Enter)={self.onKey} @keyPress(.Space)={self.onKey}>
        <slot />
      </box>
    }
  }
}

// One cell of a row, as its column says: where what it holds stands. Nothing in it stands past its column: a text
// wraps there, or is cut there where it says so (`wrap={.Cut}`).
public class TableCell implements Component {
  derived xAlign: Align | nil = self.align ?? self.column?.align
  derived textAlign: TextAlign | nil = textAlignOf(self.xAlign)

  column: Signal<Column | nil>
  align: Signal<Align | nil>
  constructor(
    // Its column: where what it holds stands.
    column: Signal<Column | nil> = nil,
    // Where what it holds stands, over its column's.
    align: Signal<Align | nil> = nil
  ) {
    self.column = column
    self.align = align
  }

  public render(self): Template {
    return $ltml {
      <box xAlign={self.xAlign} textAlign={self.textAlign} yAlign={Align.Center}>
        <slot />
      </box>
    }
  }
}

// A wrapped text's lines stand where its cell does.
function textAlignOf(align: Align | nil): TextAlign | nil {
  return match (align) {
    Align.Center => TextAlign.Center
    Align.End => TextAlign.End
    else => nil
  }
}

public class Table implements Component {
  derived tracks: Array<Track> = tracksOf(self.columns)
  derived spans: Array<Span> = spansOf(self.columns)
  derived headBack: Color | nil = self.ground == Ground.Well ? BACK : nil

  const columns: Array<Column>
  sorted: mut Signal<Integer>
  descending: mut Signal<Boolean>
  height: Signal<Number<Length> | nil>
  const rowsVary: Boolean
  empty: Signal<String>
  ground: Signal<Ground>
  derived emptyShown: Boolean = self.empty != ""
  constructor(
    columns: Array<Column>,
    // The column the rows are ordered by, from 1; 0 for none.
    sorted: mut Signal<Integer>,
    descending: mut Signal<Boolean>,
    // The table's height, its headings and its well's rim in it: its rows scroll past it. None: the rest of the room
    // its box gives it.
    height: Signal<Number<Length> | nil> = nil,
    // Its rows aren't of one height: each is as high as what it holds, and every row is built. Otherwise the body is
    // a virtual list, its rows as high as the first it built came to.
    rowsVary: Boolean = false,
    // What it says under its headings while it has no rows («Nothing found»): the owner, which knows its rows, says
    // it while there are none; `""` says nothing.
    empty: Signal<String> = "",
    // What it stands on: a well (its headings on a darker band), or the wood (its rows ruled apart: their
    // `TableRow`s say so too).
    ground: Signal<Ground> = Ground.Well
  ) {
    self.empty = empty
    self.ground = ground
    self.columns = columns
    self.sorted = sorted
    self.descending = descending
    self.height = height
    self.rowsVary = rowsVary
  }

  public render(self): Template {
    return $ltml {
      <box columns={1} rows={FILLED}>
        <ScrolledList columns={1} height={self.height} virtual={!self.rowsVary} ground={self.ground}>
          <box #head columns={self.tracks} gap={3sp} padding={SIDES} background={self.headBack} border={RULE}>
            <GroupHeading $for={span of self.spans} span={span} />
            <Heading $for={index, column of self.columns} column={column} index={index} sorted={mut self.sorted}
                     descending={mut self.descending} />
          </box>
          <slot />
        </ScrolledList>
        <box $if={self.emptyShown} position={Position.Absolute} left={0ui} right={0ui} top={EMPTY_TOP} xAlign={Align.Center}>
          <text value={self.empty} textColor={PLAIN} />
        </box>
      </box>
    }
  }
}
