// Table: columns under headings, and the rows the page draws under them, as a grid: the table's columns are its
// leaves' (`Column`s), and its headings, each row and each group of headings are subgrids of them, so every cell stands
// in its column whatever holds it. A group's heading stands over its columns' (`group`, a path of titles, outermost
// first: groups in groups to any depth). A click on a sortable heading sorts by it, again reverses (the cells
// `sorted`, the column's number from 1, and `descending`, which the page handed with `mut` and orders its rows by: the
// table keeps no list of rows, so a row follows its own cells and nothing is made for it when another changes). The
// rows are `TableRow`s in the table's slot, their cells `TableCell`s, each with its room; a box between the table and
// its rows is a subgrid too (`columns={"subgrid"}`). The body is a virtual list, each row as high as the first it
// built came to (a box, every row built, where the table is told its rows vary): it scrolls where it is given a
// `height`, or where the table is given a height (its headings, then the body in the rest of it), and a `$for` of rows
// in it builds only the rows in view, handing on the rows that leave to the items that come in: a row follows its
// item's cell. A cell's texts wrap at its column unless they say they are cut (`wrap={.Cut}`); while the owner has no
// rows, the table says what it is given as `empty` under its headings. On the wood its cells are ruled apart, the
// lines collapsed onto their boundaries, and each row ruled under. `ToolSort` is its sort in the toolbar, with sorts
// no column shows.
import Game from "$game"
import { Align, Art, ByInteractionState, Edges, Event, Fit, Frame, Line, MouseButton, Position, Side, TextAlign, Track } from "$ltml"
import root Ordaen from "Ordaen"
import Locale from "@/locales"
import { Component } from "@/module"
import { Ground, ScrolledList } from "@/scrolledList"
import { Tip } from "@/tip"
import { BRIGHT_TEXT, SECONDARY_TEXT, WINDOW_ROOM } from "@/units"

// A column: its heading (`""`: none), its width, where its heading and its cells stand (`Align.Center` too), whether a
// heading click sorts by it, the groups it is in, outermost first: neighbouring columns of one group share a heading
// over theirs; what its heading's Tip says of it under the cursor (its title the Tip's), none for none.
public struct Column {
  title: String
  width: Track
  align: Align | nil
  sortable: Boolean | nil
  group: Array<String> | nil
  tip: String | nil
}

// A heading: a column's (nothing `under` it), or a group's, its title over the headings `under` it. `index` (from 1) is
// its first column, `count` how many it stands over, `column` its first.
struct Head {
  title: String
  column: Column
  index: Integer
  count: Integer
  under: Array<Head>
}

// The headings over columns `from` to `to`, `depth` groups in: a column in no further group its own, a run of
// neighbouring columns in one its group's, the headings under it the run's at the next depth.
function headsOf(columns: Array<Column>, from: Integer, to: Integer, depth: Integer): Array<Head> {
  let heads: Array<Head> = []
  // The first column the headings so far leave.
  let next = from
  for (at of from..to) {
    if (at < next) { continue }
    const column = columns[at] ?? panic("a column of the table")
    const title = (column.group ?? [])[depth]
    let last = at
    if (title != nil) {
      for (beside of at + 1..to) {
        if (!sameGroup(columns[beside], column, depth)) { break }
        last = beside
      }
    }
    const under = title == nil ? [] : headsOf(columns, at, last, depth + 1)
    heads.push({ title: title ?? "", column: column, index: at, count: last - at + 1, under: under })
    next = last + 1
  }
  return heads
}

// Whether a column is in the same groups as another, to `depth` in.
function sameGroup(next: Column | nil, column: Column, depth: Integer): Boolean {
  if (next == nil) { return false }
  for (d of 1..depth) {
    if ((next.group ?? [])[d] != (column.group ?? [])[d]) { return false }
  }
  return true
}

// Every heading of a table, as one group over all its columns that has no title.
function headOf(columns: Array<Column>): Head {
  const first = columns[1] ?? panic("a table has a column")
  return { title: "", column: first, index: 1, count: columns.length, under: headsOf(columns, 1, columns.length, 1) }
}

const NAME: ByInteractionState<Color> = { default: Color.hex("#cbb994"), hover: BRIGHT_TEXT, focus: BRIGHT_TEXT }
const PLAIN: Color = Color.hex("#a3977f")
const GOLD: Color = Color.hex("#f0c860")
// The lines of a table on the wood: between every two cells, collapsed onto their boundary; under each row.
const LINE: Line = { width: 1.171875dp, color: Color.hex("#3e2f1d"), sides: nil }
const UNDER: Line = { width: 1.171875dp, color: Color.hex("#3e2f1d"), sides: [Side.Bottom] }
// The headings of a table on the wood: ruled over and under.
const HEAD_RULES: Line = { width: 1.171875dp, color: Color.hex("#3e2f1d"), sides: [Side.Top, Side.Bottom] }
// A group's title in a well: a rule under it reaching across its columns.
const GROUP_RULE: Line = { width: 1.171875dp, color: Color.hex("#5a4630"), sides: [Side.Bottom] }
const LIGHT: Color = Color.hex("#d6a56b")
const CLEAR: Color = Color.hex("#00000000")
const SHADE: ByInteractionState<Color> = { default: CLEAR, hover: Color.hex("#00000033"), focus: Color.hex("#00000033") }
const BACK: Color = Color.hex("#00000040")
// A cell's room: a row of one line of text is the line and half a line round it, a line and a half of the rhythm
// whatever the density; at its sides half a row's step, so two texts side by side stand a step apart, the line between
// them in the middle. A heading over the rows has a line's room over and under.
const CELL_SIDE: Number<Spacing> = 1.5sp
const CELL_PADDING: Edges = { top: 1.5sp, right: CELL_SIDE, bottom: 1.5sp, left: CELL_SIDE }
const HEADING_PADDING: Edges = { top: 3sp, right: CELL_SIDE, bottom: 3sp, left: CELL_SIDE }
// The room a table's first and last cells keep from its sides, past their own: in a well, the room a text keeps from a
// frame's line; on the wood a table has no side of its own (it stands against its window's or its column's border),
// and they keep the window's room from it, as what stands over the table does.
const WELL_SIDES: Number<Spacing> = 6sp - CELL_SIDE
const WOOD_SIDES: Number<Spacing> = WINDOW_ROOM - CELL_SIDE
const HEAD: Array<Track> = ["max-content", "max-content"]
// A row of one line of text: the text and its cells' room.
public const ROW: Number<Length> = 32.8125dp
// Where the text of a table with no rows stands: under its headings, a row down.
const EMPTY_TOP: Number<Length> = 46.875dp
// The well fills what the table is given; its headings stay over its rows as they scroll. Sorted, the order's line over
// it, its text where the cells' text starts.
const FILLED: Array<Track> = [{ fr: 1 }]
const ORDERED: Array<Track> = ["max-content", { fr: 1 }]
// A sorted heading's mark (ctl.markUp, ctl.markDown): a triangle 8 px wide and 6 high in the middle of a 16 px cell.
const MARK_WIDTH = 9.375dp
const MARK_HEIGHT = 7.03125dp
const MARK_CELL = 18.75dp
const MARK_LEFT = (MARK_WIDTH - MARK_CELL) / 2
const MARK_TOP = (MARK_HEIGHT - MARK_CELL) / 2

// The tracks of a table's columns: one per column. A width is a `fit` column of it: as wide as its heading and its
// cells need where the room allows, the shares giving way first, its cells wrapped where none can; never cut.
function tracksOf(columns: Array<Column>): Array<Track> {
  let list: Array<Track> = []
  for (column of columns) {
    const width = column.width
    list.push(width is Number ? Fit { fit: width } : width)
  }
  return list
}

// Whether `a` comes before `b` in a table sorted by `sorts`: by the first, where it leaves them level by the next, and
// on (each a column's number, negative where it runs down). `before(a, b, column)` is a column's own order, ascending,
// of rows that have something there; `missing(row, column)`, where a row has nothing in a column (a «—»): such a row
// stands after every one that has, either way. What a page sorts its rows with.
public function sortedBefore<T>(
  a: T, b: T, sorts: Array<Integer>, before: (a: T, b: T, column: Integer) => Boolean,
  missing: ((row: T, column: Integer) => Boolean) | nil = nil
): Boolean {
  for (sort of sorts) {
    const column = sort.abs()
    if (missing != nil) {
      const gone = missing(a, column)
      if (gone != missing(b, column)) { return !gone }
      if (gone) { continue }
    }
    if (before(a, b, column)) { return sort > 0 }
    if (before(b, a, column)) { return sort < 0 }
  }
  return false
}

// A table's sorts, then `column` where none of them is by it, the first one's way: what tells rows apart that the
// player's sorts leave level (the name).
public function sortsThen(sorts: Array<Integer>, column: Integer): Array<Integer> {
  if (sorts.any(sort => sort.abs() == column)) { return sorts }
  const all = sorts.map(sort => sort)
  all.push((sorts[1] ?? 0) < 0 ? -column : column)
  return all
}

// The order a table's rows are sorted in, in words: each sort's heading (a group's titles before it, «Auction -
// Cost»), a descending one marked so, `>` between; nothing while none sorts.
function orderOf(columns: Array<Column>, sorts: Array<Integer>): String {
  const words: Array<String> = []
  for (sort of sorts) {
    const column = columns[sort.abs()]
    if (column == nil) { continue }
    const path = (column.group ?? []).map(title => title)
    path.push(column.title)
    const name = path.filter(title => title != "").join(" - ")
    words.push(sort < 0 ? Locale.TABLE_SORT_DOWN.format(name) : name)
  }
  return words.join(" > ")
}

// Where a column stands among a table's sorts, from 1; 0 where it sorts nothing.
function placeOf(sorts: Array<Integer>, column: Integer): Integer {
  for (at, sort of sorts) {
    if (sort.abs() == column) { return at }
  }
  return 0
}

// A column's heading, as high as the headings beside it, its title in its middle; under a group's, a cell's room.
class Heading implements Component {
  derived place: Integer = placeOf(self.sorts, self.index)
  derived picked: Boolean = self.place == 1
  derived padding: Edges = self.grouped ? CELL_PADDING : HEADING_PADDING
  // The light under it and the mark are always drawn, what isn't the state clear or at no opacity: only colours and
  // the mark's art tell the heading the rows are ordered by, and which way; a later sort's mark at half.
  derived light: Color = self.picked ? LIGHT : CLEAR
  derived marked: Number = self.picked ? 1 : self.place > 0 ? 0.5 : 0
  derived down: Boolean = (self.sorts[self.place] ?? 0) < 0
  derived mark: Art = self.down ? Ordaen.art.ctl.markDown : Ordaen.art.ctl.markUp
  derived sortable: Boolean = self.column.sortable == true
  derived markFirst: Boolean = self.column.align == Align.End
  derived color: Color | ByInteractionState<Color> = self.picked ? GOLD : self.sortable ? NAME : PLAIN
  derived shade: Color | ByInteractionState<Color> = self.sortable ? SHADE : CLEAR
  state hovered = false
  derived tipped: Boolean = self.column.tip != nil
  derived tipShown: Boolean = self.hovered && self.tipped
  derived tipText: String = self.column.tip ?? ""

  column: Signal<Column>
  const index: Integer
  sorts: mut Signal<Array<Integer>>
  const grouped: Boolean
  constructor(
    column: Signal<Column>,
    index: Integer,
    sorts: mut Signal<Array<Integer>>,
    // It stands under a group's heading.
    grouped: Boolean
  ) {
    self.column = column
    self.index = index
    self.sorts = sorts
    self.grouped = grouped
  }

  // A click sorts by it after the sorts before (ascending), or turns its own sort round where it sorts already.
  onClick(mut self) {
    if (!self.sortable) { return }
    const sorts = self.sorts.map(sort => sort)
    const place = self.place
    if (place == 0) {
      sorts.push(self.index)
    } else {
      sorts[place] = -(sorts[place] ?? 0)
    }
    self.sorts = sorts
  }

  // A right click (or Delete) takes its sort away; the later sorts move up.
  onRemove(mut self) {
    if (self.place == 0) { return }
    const index = self.index
    self.sorts = self.sorts.filter(sort => sort.abs() != index)
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box yAlignSelf={Align.Stretch} padding={self.padding} xAlign={self.column.align} yAlign={Align.Center} background={self.shade}
           @pointerPress(.Left)={self.onClick} @pointerPress(.Right)={self.onRemove} @keyPress(.Enter)={self.onClick}
           @keyPress(.Space)={self.onClick} @keyPress(.Delete)={self.onRemove}>
        // A heading with a Tip hears the cursor over it, and takes no click from the heading.
        <box $if={self.tipped} position={Position.Absolute} left={0ui} right={0ui} top={0ui} bottom={0ui} mouseThrough={true}
             @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
          <Tip $if={self.tipShown} title={self.column.title} text={self.tipText} />
        </box>
        <box position={Position.Absolute} left={0ui} right={0ui} bottom={0ui} height={2.34375dp} background={self.light} />
        // The title lights with the heading, wherever on it the cursor is.
        <box columns={HEAD} gap={1sp} yAlign={Align.Center} interactionState={self.$interactionState}>
          // A column whose cells stand at its end has its mark before the title: the title ends where they do.
          <box $if={self.sortable && self.markFirst} width={MARK_WIDTH} height={MARK_HEIGHT}>
            <box position={Position.Absolute} left={MARK_LEFT} top={MARK_TOP} width={MARK_CELL}
                 height={MARK_CELL} background={self.mark} tint={GOLD}
                 opacity={self.marked} />
          </box>
          <text value={self.column.title} textColor={self.color} wrap={.None} />
          // The mark takes the triangle's own room; its cell, a triangle in its middle, reaches past it.
          <box $if={self.sortable && !self.markFirst} width={MARK_WIDTH} height={MARK_HEIGHT}>
            <box position={Position.Absolute} left={MARK_LEFT} top={MARK_TOP} width={MARK_CELL}
                 height={MARK_CELL} background={self.mark} tint={GOLD}
                 opacity={self.marked} />
          </box>
        </box>
      </box>
    }
  }
}

// The headings over a run of columns, a subgrid of them: a group's title over them, then the headings under it, a
// column's or a group's in turn. The table's own (`table`) has no title, and is the band over its rows: on a darker
// band in a well, ruled over and under on the wood. On the wood its cells are ruled apart; in a well only a group's
// title is ruled under.
class HeadGroup implements Component {
  derived wood: Boolean = self.ground == Ground.Wood
  derived lines: Line | nil = self.wood ? LINE : nil
  derived titleRule: Line | nil = self.wood ? nil : GROUP_RULE
  derived background: Color | nil = self.table && !self.wood ? BACK : nil
  derived border: Line | nil = !self.table ? nil : self.wood ? HEAD_RULES : UNDER

  head: Signal<Head>
  sorts: mut Signal<Array<Integer>>
  ground: Signal<Ground>
  const table: Boolean
  constructor(
    head: Signal<Head>,
    sorts: mut Signal<Array<Integer>>,
    ground: Signal<Ground>,
    // The table's headings, all of them.
    table: Boolean = false
  ) {
    self.head = head
    self.sorts = sorts
    self.ground = ground
    self.table = table
  }

  public render(self): Template {
    return $ltml {
      <box columns={"subgrid"} columnSpan={self.head.count} background={self.background} border={self.border}
           lines={self.lines}>
        <box $if={!self.table} columnSpan={self.head.count} padding={CELL_PADDING} xAlign={Align.Center}
             yAlign={Align.Center} border={self.titleRule}>
          <text value={self.head.title} textColor={PLAIN} wrap={.None} />
        </box>
        // The headings come of the columns, which never change: each is read once.
        <$for={under of self.head.under}>
          <Heading $if={under.under.length == 0} column={under.column} index={peek under.index} sorts={mut self.sorts}
                   grouped={!self.table} />
          <HeadGroup $else head={under} sorts={mut self.sorts} ground={self.ground} />
        </>
      </box>
    }
  }
}

// One row of a table, a subgrid of its columns: its `TableCell`s in the slot. The shade under the cursor; selected, a
// darker one. On the wood (`Ground.Wood`, as its table stands) its cells ruled apart and a rule under it. A click of
// any button reports `pick` with the click (its button and where it was in the row), as a box's `click` does: the page
// tells a left-click from a right-click. A double press reports `double` after its second `pick`; the cursor coming
// onto any part of the row reports `enter` with the row's frame (a tooltip stands beside it), and leaving it `leave`.
public class TableRow implements Component {
  public pick: Event<MouseButton> = new Event()
  public double: Event<nil> = new Event()
  public enter: Event<any Frame> = new Event()
  public leave: Event<nil> = new Event()

  derived background: Color | ByInteractionState<Color> = self.selected ? BACK : SHADE
  derived wood: Boolean = self.ground == Ground.Wood
  derived lines: Line | nil = self.wood ? LINE : nil
  derived rule: Line | nil = self.wood ? UNDER : nil

  selected: Signal<Boolean>
  // How high it is: as high as what it holds with its cells' room (a line of text: a line and a half), unless it is
  // told another (a row of icons).
  const height: Number<Length> | nil
  ground: Signal<Ground>
  constructor(
    selected: Signal<Boolean> = false,
    height: Number<Length> | nil = nil,
    // What its table stands on: on the wood, rows are ruled.
    ground: Signal<Ground> = Ground.Well
  ) {
    self.selected = selected
    self.height = height
    self.ground = ground
  }

  onClick(mut self, click: Event.Press) { self.pick.emit(click.button) }
  onKey(mut self) { self.pick.emit(.Left) }
  onDouble(mut self) { self.double.emit() }
  // A list's row: the tooltips of what it holds stand beside it, never over the rows round it.
  onEnter(mut self, frame: any Frame) {
    Game.tooltip.rowAt(frame)
    self.enter.emit(frame)
  }
  onLeave(mut self) { self.leave.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={"subgrid"} height={self.height} yAlign={Align.Center} background={self.background}
           border={self.rule} lines={self.lines} @pointerPress.self={self.onClick} @pointerPress.self.double={self.onDouble}
           @pointerEnter={self.onEnter} @pointerLeave={self.onLeave} @keyPress(.Enter)={self.onKey} @keyPress(.Space)={self.onKey}>
        <slot />
      </box>
    }
  }
}

// One cell of a row: its room round what it holds (`CELL_PADDING` where it says none), where that stands, as its
// column says or over it, and the columns it takes. Nothing in it stands past its column: a text wraps there, or is
// cut there where it says so (`wrap={.Cut}`).
public class TableCell implements Component {
  derived xAlign: Align | nil = self.align ?? self.column?.align
  derived textAlign: TextAlign | nil = textAlignOf(self.xAlign)

  column: Signal<Column | nil>
  align: Signal<Align | nil>
  padding: Signal<Edges>
  background: Signal<Color | nil>
  const span: Integer | nil
  constructor(
    // Its column: where what it holds stands.
    column: Signal<Column | nil> = nil,
    // Where what it holds stands, over its column's.
    align: Signal<Align | nil> = nil,
    padding: Signal<Edges> = CELL_PADDING,
    // Its ground (a price the cheaper of two), under its room too.
    background: Signal<Color | nil> = nil,
    // The columns it takes: one where none is said.
    span: Integer | nil = nil
  ) {
    self.column = column
    self.align = align
    self.padding = padding
    self.background = background
    self.span = span
  }

  public render(self): Template {
    return $ltml {
      <box columnSpan={self.span} padding={self.padding} background={self.background} xAlign={self.xAlign}
           textAlign={self.textAlign} yAlign={Align.Center}>
        <slot />
      </box>
    }
  }
}

// A wrapped text's lines stand where its cell does.
function textAlignOf(align: Align | nil): TextAlign | nil {
  return match (align) {
    Align.Center => TextAlign.Center
    Align.End => TextAlign.End
    else => nil
  }
}

public class Table implements Component {
  derived tracks: Array<Track> = tracksOf(self.columns)
  derived head: Head = headOf(self.columns)
  derived sides: Number<Spacing> = self.ground == Ground.Wood ? WOOD_SIDES : WELL_SIDES

  // The order the rows are sorted in, over the table while there is one.
  derived order: String = orderOf(self.columns, self.sorts)
  derived ordered: Boolean = self.order != ""
  derived rows: Array<Track> = self.ordered ? ORDERED : FILLED
  derived orderPadding: Edges = { top: 2sp, left: self.sides + CELL_SIDE, right: self.sides + CELL_SIDE, bottom: 1sp }

  columns: Signal<Array<Column>>
  sorts: mut Signal<Array<Integer>>
  height: Signal<Number<Length> | nil>
  const rowsVary: Boolean
  empty: Signal<String>
  ground: Signal<Ground>
  derived emptyShown: Boolean = self.empty != ""
  constructor(
    // Follows what it is given: a column for each of what the rows hold (a profession each character may have).
    columns: Signal<Array<Column>>,
    // What the rows are sorted by, in turn (`sortedBefore`): each a column's number from 1, negative where it runs down.
    // A click on a heading adds its column, or turns its sort round; a right click takes it away.
    sorts: mut Signal<Array<Integer>>,
    // The table's height, its headings and its well's rim in it: its rows scroll past it. None: the rest of the room
    // its box gives it.
    height: Signal<Number<Length> | nil> = nil,
    // Its rows aren't of one height: each is as high as what it holds, and every row is built. Otherwise the body is
    // a virtual list, its rows as high as the first it built came to.
    rowsVary: Boolean = false,
    // What it says under its headings while it has no rows («Nothing found»): the owner, which knows its rows, says
    // it while there are none; `""` says nothing.
    empty: Signal<String> = "",
    // What it stands on: a well (its headings on a darker band), or the wood (its cells ruled apart: their
    // `TableRow`s say so too).
    ground: Signal<Ground> = Ground.Well
  ) {
    self.empty = empty
    self.ground = ground
    self.columns = columns
    self.sorts = sorts
    self.height = height
    self.rowsVary = rowsVary
  }

  public render(self): Template {
    return $ltml {
      <box columns={1} rows={self.rows}>
        <box $if={self.ordered} padding={self.orderPadding}>
          <text value={self.order} textSize={SECONDARY_TEXT} textColor={PLAIN} wrap={.Cut} />
        </box>
        <ScrolledList tracks={self.tracks} height={self.height} virtual={!self.rowsVary} ground={self.ground}
                      sides={self.sides}>
          <HeadGroup #head head={self.head} sorts={mut self.sorts} ground={self.ground} table={true} />
          <slot />
        </ScrolledList>
        <box $if={self.emptyShown} position={Position.Absolute} left={0ui} right={0ui} top={EMPTY_TOP} xAlign={Align.Center}>
          <text value={self.empty} textColor={PLAIN} />
        </box>
      </box>
    }
  }
}
