// Band: a spell's facts in the design's short form, a cell each, as its tooltip and its card show them: the cost as a
// dot in its resource's colour and the number, the range, the cast («Instant», «2.5 sec», channelled, on the next
// swing), the cooldown as «CD 10 sec»; a glyph before each. `bandOf` reads them from the game's tooltip lines for the
// spell; `BandCell` draws one, and what it explains (a term) is the host's, through its slot `opened`.
import Game from "$game"
import { Align, Beside, Cursor, Edges, Layer, Line, Piece, Position, Side, Tile } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import Locale from "@/locales"
import { Component } from "@/module"

// The glyphs' pictures (art/pieces/tooltip-glyphs.json): a column of 20 px cells, a row each in the order of
// `Glyph`, the 16 px glyph 2 px in from its cell's top left, its shadow inside the cell; then the cost's dot's light
// and shade alone, drawn over the tinted dot.
const GLYPH_FILE: Asset = "@/media/tooltip-glyphs.tga"
const GLYPH = 18.75dp
const GLYPH_CELL = 23.4375dp
const GLYPH_IN = -2.34375dp
const function glyphPieces(): array<Piece> {
  let list: array<Piece> = []
  for (row of 0..13) { list.push({ file: GLYPH_FILE, width: 32, height: 512, rows: 16, normal: row }) }
  return list
}
const GLYPH_ART: array<Piece> = glyphPieces()
const DOT_LIGHT: Piece = GLYPH_ART[14] ?? panic("the dot's light is the last row")

// The glyphs, by their names in the design (`tooltips`): what a fact is about, drawn before its text (the cost's is
// the design's dot, in its resource's colour).
public enum Glyph {
  Dmg = "dmg", Spd = "spd", Arm = "arm", Blk = "blk", Alliance = "alliance", Horde = "horde", Elite = "elite"
  Time = "time", Cost = "cost", CastNow = "castNow", CastTime = "castTime", CastChan = "castChan"
  CastNext = "castNext"
}

// A glyph's picture.
public function glyphArt(glyph: Glyph): Piece {
  const row = match (glyph) {
    .Dmg => 1, .Spd => 2, .Arm => 3, .Blk => 4, .Alliance => 5, .Horde => 6, .Elite => 7, .Time => 8, .Cost => 9
    .CastNow => 10, .CastTime => 11, .CastChan => 12, .CastNext => 13
  }
  return GLYPH_ART[row] ?? panic("a row for every glyph")
}

// What a cell of a spell's band says: its cost, its range (or melee), its cast of each kind, its cooldown; `Other`
// for a cell of anything else (an item's damage, a unit's level).
public enum BandKind { Cost, Range, Melee, CastNow, CastTime, CastChan, CastNext, Cooldown, Other }

// A cell of a band: its text, in its colour (the body's where it has none), its glyph before it in its tint (a
// cost's dot in its resource's colour), and what it says.
public struct BandFact {
  text: string
  color: Color | nil
  glyph: Glyph | nil
  tint: Color | nil
  kind: BandKind = BandKind::Other
}

// A spell's band: its cells, and the places of the tooltip's lines they were read from (no other reader takes them).
public struct Band {
  facts: array<BandFact>
  taken: map<integer, boolean>
}

// The game's numbers for what a line of a tooltip is.
const BLANK = 1
const SPELL_NAME = 13
const PASSIVE = 33
const DESCRIPTION = 34
const REQUIREMENT = 43
// Before the lines of the item a recipe makes.
const NESTED = 19
// A one-sided line stands in the band among the tooltip's first lines alone.
const BAND_LINES = 4

// The resources' colours, the design's (TooltipColumns' `.res`).
const MANA: Color = Color::hex("#2f6fe0")
const RAGE: Color = Color::hex("#c7281c")
const ENERGY: Color = Color::hex("#e8d040")

// A cost's dot: the design's colour of its resource; the client's own for one it has none of.
function resourceColorOf(cost: Game::SpellCost): Color | nil {
  return match (cost.resource) {
    .Mana => MANA
    .Rage => RAGE
    .Energy => ENERGY
    .Focus, .Health, .Other => cost.color
  }
}

// What follows a label's colon («Cooldown: 10 sec» is «10 sec»), or the text.
function valueOf(text: string): string {
  return text.match("^[^:]+:%s*(.+)$") ?? text
}

// A number as the game wrote it in a line («1,5», «2.5»).
function digitsOf(text: string): string { return text.match("%d+[,%.]?%d*") ?? "" }

// The word of a label the game writes before a list («Reagents: %s», «Материалы: |n», «Инструменты:»).
function wordOf(label: string): string {
  return label.match("^%s*([^:|%%]-)%s*:") ?? ""
}

// A line that lists what the spell takes (its reagents, its tools): never a cell.
function isList(text: string): boolean {
  const label = text.match("^%s*([^:]-)%s*:")
  if (label == nil) { return false }
  return label == wordOf(Game::strings.spellReagents) || label == wordOf(Runtime::text("SPELL_TOTEMS") ?? "")
}

// How long a channelled spell lasts, as its description says it («over 5 sec.», «в течение 5 сек.»), else its first
// time in seconds; nothing where it says none.
function channelOf(description: string): string | nil {
  const seconds = description.match("в течение (%d+[,%.]?%d*)%s*сек") ?? description.match("over (%d+[,%.]?%d*)%s*sec") ??
    description.match("(%d+[,%.]?%d*)%s*сек") ?? description.match("(%d+[,%.]?%d*)%s*sec")
  return seconds == nil ? nil : Locale::CAST_SECONDS.format(seconds)
}

function isCast(kind: BandKind): boolean {
  return kind == .CastNow || kind == .CastTime || kind == .CastChan || kind == .CastNext
}

// A cell from one side of one of the spell's first lines. `first`: the line is the band's first, where the cost and
// the range stand; `right`: the line's right side; `cast`: its left side was the cast, so this is the cooldown;
// `channel`: how long the spell is channelled, where it is.
function cellOf(
  text: string, first: boolean, right: boolean, cost: Game::SpellCost | nil, cast: boolean, channel: string | nil
): BandFact {
  const digits = text.match("%d[%d%s\194\160]*")
  if (text == Game::strings.castInstant || text == Game::strings.castInstantNoMana) {
    return { text: Locale::CAST_INSTANT, glyph: .CastNow, kind: .CastNow }
  }
  if (text.contains(Game::strings.castChanneled)) {
    // The glyph says it is channelled; the cell says for how long, as the description has it (the game's word where
    // it says no time).
    return { text: channel ?? text, glyph: .CastChan, kind: .CastChan }
  }
  if (text.unformat(Game::strings.castTimeSec) != nil) {
    return { text: Locale::CAST_SECONDS.format(digitsOf(text)), glyph: .CastTime, kind: .CastTime }
  }
  if (text.unformat(Game::strings.castTimeMin) != nil) {
    return { text: Locale::CAST_MINUTES.format(digitsOf(text)), glyph: .CastTime, kind: .CastTime }
  }
  if (text == Game::strings.onNextSwing || text == Game::strings.onNextRanged) {
    return { text: Locale::CAST_NEXT, glyph: .CastNext, kind: .CastNext }
  }
  if (!right && first && cost != nil && digits != nil && (digits.replace("%D", "")).toNumber() == cost.amount) {
    // The cost: a dot in its resource's colour and the number.
    return { text: digits.replace("%s+$", ""), glyph: .Cost, tint: resourceColorOf(cost), kind: .Cost }
  }
  if (right && cast) {
    return digits == nil ? { text: text } : { text: "CD " + valueOf(text), kind: .Cooldown }
  }
  if (first) {
    // The range, beside the cost or alone: its value only, the closing full stop dropped. A line that says no range
    // (an armour kit's «Armor: +24») is a cell as it reads.
    if (text == Game::strings.meleeRange || text == Locale::MELEE_RANGE_TEXT) {
      return { text: Locale::MELEE_RANGE_SHORT, kind: .Melee }
    }
    if (text == Game::strings.unlimitedRange) { return { text: text, kind: .Range } }
    const distance = text.unformat(Game::strings.spellRange)
    if (distance != nil) {
      // The distance and the unit after it in the client's line («30 yd», «30 м»), the rest of the line left out.
      const unit = Game::strings.spellRange.match("%%s(%s*[^%s]*)") ?? ""
      return { text: (string::of(distance[1]) + unit).replace("%.$", ""), kind: .Range }
    }
  }
  return { text: text }
}

function textOf(text: string | nil): string | nil { return text == "" ? nil : text }

// A spell's band, from the game's tooltip lines for it and what it costs: the cells of its two-sided lines (cost and
// range, cast and cooldown) and of its one-sided ones among its first lines before any other, reagents and tools
// left out.
public function bandOf(lines: array<Game::TooltipLine>, cost: Game::SpellCost | nil): Band {
  const facts: array<BandFact> = []
  const taken: map<integer, boolean> = {}
  let description = ""
  for (line of lines) {
    if (line.kind == DESCRIPTION) { description = description + (line.left ?? "") }
  }
  const channel = channelOf(description)
  // The band's lines read so far, and whether a line that is no cell came before.
  let read = 0
  let past = false
  for (at, line of lines) {
    if (line.kind == NESTED) { break }
    const left = textOf(line.left)
    const right = textOf(line.right)
    if (line.kind == DESCRIPTION) {
      past = true
    } else if (line.kind != SPELL_NAME && line.kind != REQUIREMENT && line.kind != PASSIVE && line.kind != BLANK && left != nil) {
      if (right != nil) {
        read += 1
        const cast = cellOf(left, read == 1, false, cost, false, channel)
        facts.push(cast)
        facts.push(cellOf(right, read == 1, true, cost, isCast(cast.kind), channel))
        taken[at] = true
      } else if (!isList(left)) {
        if (at <= BAND_LINES && !past) {
          read += 1
          facts.push(cellOf(left, read == 1, false, cost, false, channel))
          taken[at] = true
        } else {
          past = true
        }
      }
    }
  }
  return { facts: facts, taken: taken }
}

// A term's underline under its text, while the tooltip that shows it is locked: dashed and dim, half the gap between
// the lines below its text (the gap moves it).
public const TERM_DASH: Piece = { file: "@/media/dash.tga", width: 8, height: 1, tile: Tile::Across }
public const TERM_UNDERLINE: Color = Color::hex("#ffd10080")
public const TERM_UNDERLINE_HEIGHT: number<Length> = 1.171875dp
const LINE_GAP: number<Spacing> = 2sp
public function termUnderlineAt(): number<Length> {
  return -(Ordaen.lengthOf(LINE_GAP) / 2 + TERM_UNDERLINE_HEIGHT)
}

const TEXT: Color = Color::hex("#f3e7cc")
const DIVIDER: Line = { width: 1.171875dp, color: Color::hex("#d6a56b2e"), sides: [Side::Left] }
const CELL_PAD: Edges = { top: 2.5sp, right: 3sp, bottom: 2.5sp, left: 3sp }
// The band ends what holds it: no room under it.
const CELL_PAD_LAST: Edges = { top: 2.5sp, right: 3sp, left: 3sp }
const BY_ITS_TEXT: Beside = { beside: "parent" }

// A cell of a band: its glyph before its text, in the cell's middle, never wrapped, a divider before every cell but
// the first. `lit`: it explains something (in a locked tooltip): underlined, and with the cursor on the cell what
// it explains, the slot `opened`, stands beside it until the cursor leaves. The whole cell is the fact it explains.
public class BandCell implements Component {
  state over = false
  derived open: boolean = self.lit && self.over
  derived divider: Line | nil = self.index > 1 ? DIVIDER : nil
  derived padding: Edges = self.last ? CELL_PAD_LAST : CELL_PAD
  derived glyph: Piece | nil = self.glyphOf()
  derived dot: boolean = self.fact.glyph == .Cost
  derived color: Color = self.fact.color ?? TEXT

  fact: Signal<BandFact>
  index: Signal<integer>
  last: Signal<boolean>
  lit: Signal<boolean>
  constructor(fact: Signal<BandFact>, index: Signal<integer>, last: Signal<boolean>, lit: Signal<boolean> = false) {
    self.fact = fact
    self.index = index
    self.last = last
    self.lit = lit
    watch { self.forgetCursor() }
  }

  glyphOf(self): Piece | nil {
    const glyph = self.fact.glyph
    return glyph != nil ? glyphArt(glyph) : nil
  }

  // What takes the cursor goes as the cell stops explaining, and says nothing as it goes.
  forgetCursor(mut self) {
    if (!self.lit) { self.over = false }
  }

  onEnter(mut self) { self.over = true }
  onLeave(mut self) { self.over = false }

  public render(self): Template {
    return $ltml {
      <box padding={self.padding} border={self.divider} xAlign={Align::Center}>
        <box columns={["max-content", "max-content"]} gap={1.5sp} yAlign={Align::Center}>
          // The glyph, in its tint (a cost's dot in its resource's colour): its cell reaches past its room to hold
          // its shadow.
          <box $if={self.glyph != nil} width={GLYPH} height={GLYPH}>
            <box position={Position::Absolute} left={GLYPH_IN} top={GLYPH_IN} width={GLYPH_CELL} height={GLYPH_CELL}
                 background={self.glyph} tint={self.fact.tint}>
              // The cost's dot keeps the design's light: its light and shade, untinted, over the tinted dot.
              <box $if={self.dot} position={Position::Absolute} left={0ui} top={0ui} width={GLYPH_CELL}
                   height={GLYPH_CELL} background={DOT_LIGHT} />
            </box>
          </box>
          <box>
            <text value={self.fact.text} textColor={self.color} wrap={.None} />
            <box $if={self.lit} position={Position::Absolute} left={0ui} right={0ui} bottom={termUnderlineAt()}
                 height={TERM_UNDERLINE_HEIGHT} background={TERM_DASH} tint={TERM_UNDERLINE} />
          </box>
        </box>
        <box $if={self.lit} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             cursor={Cursor::Help} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave} />
        <surface leading={.Tight} $if={self.open} layer={Layer::Tooltip} place={BY_ITS_TEXT}>
          <slot #opened />
        </surface>
      </box>
    }
  }
}
