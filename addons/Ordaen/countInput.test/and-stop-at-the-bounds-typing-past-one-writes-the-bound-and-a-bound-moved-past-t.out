-- 3 of 1 to 5: both looks show 3
box 0,0 300x64.33
  box 0,0 75x28.33
    box 0,0 23.33x28.33 Interface\AddOns\Ordaen\media\button row 0 of 8 @click repeats
      box 0,0 23.33x28.33 absolute
        text 8.54,6.67 6.25x15 "-" #ffd100
    box 28.33,6.67 18.33x15
      text 34.38,6.67 6.25x15 "3" #ffffff
    box 51.67,0 23.33x28.33 Interface\AddOns\Ordaen\media\button row 0 of 8 @click repeats
      box 51.67,0 23.33x28.33 absolute
        text 60.21,6.67 6.25x15 "+" #ffd100
  box 0,38.33 80x26
    box 0,38.33 80x26 #00000080 input "3" @change

