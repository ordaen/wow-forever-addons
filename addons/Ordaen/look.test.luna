// The presets as the design site reads them: one line of JSON each, the snapshot of this test. The presets are
// written once, in look.luna; the site reads this snapshot (`design/.vitepress/theme/themes.js` in wow-dev-tools),
// and the suite fails where the two part.
import Test from "$test"
import Ordaen from "Ordaen"
import root Core from "Ordaen"
import { artOf, presetOf } from "@/look"

function color(c: Color): String {
  return "[%g, %g, %g]".format(c.r, c.g, c.b)
}

function text(key: String, value: String): String {
  return `"${key}": "${value}"`
}

function hue(key: String, value: Ordaen.Hue): String {
  return text(key, `${value}`)
}

function paint(key: String, value: Color): String {
  return `"${key}": ${color(value)}`
}

function json(name: Ordaen.Preset): String {
  let l = Ordaen.preset(name)
  let entries = [
    text("font", `${l.font}`), text("fontHeader", `${l.fontHeader}`), text("fontNumbers", `${l.fontNumbers}`),
    paint("accent", l.accent), text("barTexture", `${l.barTexture}`), text("xpFill", `${l.xpFill}`),
    text("barFrame", `${l.barFrame}`), text("anim", `${l.animation}`),
    paint("palette.red", l.red), paint("palette.redText", l.redText),
    paint("palette.orange", l.orange), paint("palette.orangeText", l.orangeText),
    paint("palette.yellow", l.yellow), paint("palette.yellowText", l.yellowText),
    paint("palette.green", l.green), paint("palette.greenText", l.greenText),
    paint("palette.cyan", l.cyan), paint("palette.cyanText", l.cyanText),
    paint("palette.blue", l.blue), paint("palette.blueText", l.blueText),
    paint("palette.violet", l.violet), paint("palette.violetText", l.violetText),
    paint("palette.pink", l.pink), paint("palette.pinkText", l.pinkText),
    paint("palette.tan", l.tan), paint("palette.tanText", l.tanText),
    paint("palette.white", l.white), paint("palette.whiteText", l.whiteText),
    paint("palette.grey", l.grey), paint("palette.greyText", l.greyText),
    hue("class.WARRIOR", l.warrior), hue("class.PALADIN", l.paladin), hue("class.HUNTER", l.hunter),
    hue("class.ROGUE", l.rogue), hue("class.PRIEST", l.priest), hue("class.SHAMAN", l.shaman),
    hue("class.MAGE", l.mage), hue("class.WARLOCK", l.warlock), hue("class.DRUID", l.druid),
  ]
  let values = ""
  for (i, entry of entries) { values += (i > 1 ? ", " : "") + entry }
  return `{"id": "${name}", "values": {${values}}}`
}

test "the presets, as the design site reads them" {
  for (name of Ordaen.PRESETS) { Test.note(json(name)) }
}

function file(font: Asset | nil): String {
  if (font == nil) { return "the client's own text font" }
  return font
}

test "the files each preset draws its text, titles and numbers in" {
  for (name of Ordaen.PRESETS) {
    let fonts = artOf(Ordaen.preset(name)).fonts
    Test.note(`${name}: ${file(fonts.body)}; ${file(fonts.title)}; ${file(fonts.numbers)}`)
  }
}

// The Blizzard preset isn't offered: a player who chose it has its look saved, and it loads as Ordaen's.
test "a look saved as the Blizzard preset loads as Ordaen's" {
  let blizzard: Ordaen.Look = {
    font: Ordaen.Font.Friz, fontHeader: Ordaen.Font.Friz, fontNumbers: Ordaen.Font.ArialNarrow,
    accent: Color.hex("#ffd100"), barTexture: Ordaen.BarTexture.Blizzard, animation: Ordaen.Animation.Fast,
    ..Ordaen.preset(Ordaen.Preset.Ordaen),
  }
  Core.look.choose(blizzard)
  Core.keeper.saveAll()
  Test.expect(Core.look.values.font == Ordaen.Font.Friz)
  Test.reload()
  Test.expect(presetOf(Core.look.values) == Ordaen.Preset.Ordaen)
  // A look of the player's own that differs from it in anything is kept.
  blizzard.animation = Ordaen.Animation.Smooth
  Core.look.choose(blizzard)
  Core.keeper.saveAll()
  Test.reload()
  Test.expect(Core.look.values.font == Ordaen.Font.Friz)
}
