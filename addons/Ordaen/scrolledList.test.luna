// A list that scrolls is a well: its rim round the rows, its floor under them, and the rows cut at the rim's inner
// edge as they scroll out.
import Test from "$test"
import root Ordaen from "Ordaen"
import { ScrolledList } from "@/scrolledList"

class Rows {
  state names: array<string> = ["Row 1", "Row 2", "Row 3", "Row 4", "Row 5", "Row 6", "Row 7", "Row 8", "Row 9", "Row 10"]

  public render(): Template {
    return $ltml {
      <box rows={[{ fr: 1 }]} padding={3sp}>
        <ScrolledList columns={1} height={100dp}>
          <box $for={name of self.names} height={28dp}>
            <text value={name} />
          </box>
        </ScrolledList>
      </box>
    }
  }
}

test "the well's rim stands round the list and its rows are cut at the rim's inner edge" {
  Test::mount(new Rows(), { left: 100, top: 100, width: 300, height: 200 })
  // The floor is the look's; the scrolling box stands inside the rim (in by its width on every side: the shot), so
  // what it cuts is cut at the rim's inner edge.
  Test::expect(Test::page().paintedWith(Ordaen.art.ctl.well.floor))
  Test::shot("at the top")
  Test::page().text("Row 2").wheel(-1)
  // Scrolled: a row half out at the top is cut at the rim's inner edge, the rim drawn whole over nothing.
  Test::shot("scrolled")
}

const SHADE: Color = Color::hex("#30405a")
const OTHER_SHADE: Color = Color::hex("#305a40")

// Two wells side by side, the same row in each: one whose rows bring their own padding, one whose rows don't.
class Padded {
  public render(): Template {
    return $ltml {
      <box columns={[{ fr: 1 }, { fr: 1 }]} gap={3sp}>
        <ScrolledList columns={1} height={100dp} rowsPadded={true}>
          <box padding={3sp} background={SHADE}> <text value={"Own"} /> </box>
        </ScrolledList>
        <ScrolledList columns={1} height={100dp}>
          <box padding={3sp} background={OTHER_SHADE}> <text value={"Inset"} /> </box>
        </ScrolledList>
      </box>
    }
  }
}

test "rows that bring their own padding stand edge to edge inside the rim, the well's own room gone" {
  Test::mount(new Padded(), { left: 0, top: 0, width: 400, height: 200 })
  const own = Test::page().box(SHADE).rect()
  const inset = Test::page().box(OTHER_SHADE).rect()
  // The same well, the rows 3sp nearer its rim on each side.
  Test::expect((own.right - own.left) - (inset.right - inset.left) > 5)
}
