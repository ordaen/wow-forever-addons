// Ordaen's own page in the settings window: the settings every module follows, on three tabs. Each control writes
// one entry of their draft.
import { Clock, Density, Globals, LargeNumbers, NumberFormat } from "@/globals"
import { Component } from "@/module"
import { Settings } from "@/settings"
import { Checkbox } from "@/checkbox"
import { Choice, Dropdown } from "@/dropdown"
import { Slider, Unit } from "@/slider"
import Locale from "@/locales"

const DENSITIES: Array<Choice<Density>> = [
  { value: Density.Compact, label: Locale.GLOBAL_DENSITY_COMPACT },
  { value: Density.Normal, label: Locale.GLOBAL_DENSITY_NORMAL },
  { value: Density.Roomy, label: Locale.GLOBAL_DENSITY_ROOMY },
]
const FORMATS: Array<Choice<NumberFormat>> = [
  { value: NumberFormat.Space, label: Locale.GLOBAL_NUMBERFORMAT_SPACE },
  { value: NumberFormat.Comma, label: Locale.GLOBAL_NUMBERFORMAT_COMMA },
  { value: NumberFormat.Dot, label: Locale.GLOBAL_NUMBERFORMAT_DOT },
]
const LARGE: Array<Choice<LargeNumbers>> = [
  { value: LargeNumbers.Full, label: Locale.GLOBAL_NUMBERS_FULL },
  { value: LargeNumbers.Short, label: Locale.GLOBAL_NUMBERS_SHORT },
]
const CLOCKS: Array<Choice<Clock>> = [
  { value: Clock.H24, label: Locale.GLOBAL_CLOCK_24 },
  { value: Clock.H12, label: Locale.GLOBAL_CLOCK_12 },
]

public class ScalePage implements Component {
  globals: mut Settings<Globals>
  constructor(globals: mut Settings<Globals>) {
    self.globals = globals
  }

  public render(self): Template {
    return $ltml {
      <Slider label={Locale.GLOBAL_SCALE} hint={Locale.GLOBAL_SCALE_TIP} value={mut self.globals.draft.scale}
              least={0.7} most={1.5} step={0.05} unit={Unit.Percent} />
      <Dropdown label={Locale.GLOBAL_DENSITY} hint={Locale.GLOBAL_DENSITY_TIP}
                value={mut self.globals.draft.density} choices={DENSITIES} />
      <Checkbox label={Locale.GLOBAL_PIXEL} hint={Locale.GLOBAL_PIXEL_TIP} value={mut self.globals.draft.pixel} />
    }
  }
}

public class NumbersPage implements Component {
  // Rounded numbers have no decimal places to choose.
  derived rounded: Boolean = self.globals.draft.numberRound

  globals: mut Settings<Globals>
  constructor(globals: mut Settings<Globals>) {
    self.globals = globals
  }

  public render(self): Template {
    return $ltml {
      <Dropdown label={Locale.GLOBAL_NUMBERFORMAT} hint={Locale.GLOBAL_NUMBERFORMAT_TIP}
                value={mut self.globals.draft.numberFormat} choices={FORMATS} />
      <Checkbox label={Locale.GLOBAL_NUMBERROUND} hint={Locale.GLOBAL_NUMBERROUND_TIP}
                value={mut self.globals.draft.numberRound} />
      <Slider label={Locale.GLOBAL_NUMBERPRECISION} hint={Locale.GLOBAL_NUMBERPRECISION_TIP}
              value={mut self.globals.draft.numberPrecision} least={0} most={3} disabled={self.rounded} />
      <Dropdown label={Locale.GLOBAL_NUMBERS} hint={Locale.GLOBAL_NUMBERS_TIP}
                value={mut self.globals.draft.numbers} choices={LARGE} />
    }
  }
}

public class BehaviourPage implements Component {
  globals: mut Settings<Globals>
  constructor(globals: mut Settings<Globals>) {
    self.globals = globals
  }

  public render(self): Template {
    return $ltml {
      <Checkbox label={Locale.GLOBAL_SOUNDS} hint={Locale.GLOBAL_SOUNDS_TIP} value={mut self.globals.draft.sounds} />
      <Dropdown label={Locale.GLOBAL_CLOCK} hint={Locale.GLOBAL_CLOCK_TIP} value={mut self.globals.draft.clock}
                choices={CLOCKS} />
    }
  }
}
