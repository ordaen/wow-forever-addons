// One window's body and footer, of one vault at a time: the bags' window shows the bags, or the bank's or the guild
// bank's copy away from them; the vault's window shows the bank or the guild bank while the game has it open. Its
// header: the search (it dims what doesn't match), the sort, «Sort the bags», the view, the bag slots (the bank's on
// the bank's). By category: the tabs at the left with their counts, the tab's items in cards side by side in the kinds'
// fixed order, «Free» last; a card per bag, its empty slots shown, its fill; or every slot in
// one card. The guild bank shows the guild's tabs at the left and the tab's slots in their own order, with the tab's
// log and the money's log as pages while it is open. The list is as high as what it holds: the window is never sized to
// hide an item under a scroll; it scrolls only where the screen is too low for it.
import Client from "$client"
import Game from "$game"
import { Align, ArtBorder, Edges, Overflow, Side, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { ARTWORK, Choice, Component, FooterBand, FooterCount, FooterCounts, ListTab, ModuleMemory, Money, PushButton, SECONDARY_TEXT, ScrolledList, Tabs, Tip, TipRow, ToolAct, ToolButton, ToolPick, Toolbar, reachDown } from "Ordaen"
import { BANK_ICON } from "@/bank"
import { Clicks, UseClick } from "@/clicks"
import { GuildBank, GuildPage, GuildTab, withdrawalsText } from "@/guild"
import { JunkRules } from "@/junk"
import { CARD_GAP, CardRoom, CardRow, PAGE_SIDE, ROW_LEAST, ROW_ROOM, SIDE_ROOM, SLOT_GAP, SLOT_SIZE, Section, TOOL_ROOM, TOP_ROOM, cardRoom, cardWidth, frameSides, heightOf, linesOf } from "@/layout"
import Locale from "@/locales"
import { Grouping, KINDS, Slot, SortBy, Tab, View } from "@/model"
import { CardLine, Filter, Shelf } from "@/rows"
import { bagSections, countsOf, oneSection, tabName, tabSections } from "@/sections"
import { SlotMenu } from "@/slotMenu"
import { Stock } from "@/stock"
import { Vault } from "@/vault"

// What the module keeps of the player's choices: the tabs hidden; whether a tab with nothing in it hides; each tab's
// grouping (by type where none is said); the junk's rules; the slot's clicks; the room between two slots, in steps of
// the spacing; a slot's size, in the interface's pixels.
public struct Choices implements Plain {
  hidden: Array<Tab>
  hideEmpty: Boolean
  grouping: Map<Tab, Grouping>
  junk: JunkRules
  slotPresses: Clicks
  // The junk is sold as a merchant's window opens, as «Sell junk» sells it.
  sellJunkAtVendor: Boolean = true
  slotGap: Number = SLOT_GAP
  slotSize: Number = SLOT_SIZE
  rowLeast: Number = ROW_LEAST
}

// How the player left the bags' view, the profile's (`ModuleMemory`): the view and the sort the header picks. The
// search isn't kept.
public struct BagsView implements Plain {
  view: View = View.Categories
  sort: SortBy = SortBy.Bags
}

// The list of tabs at the left, and the room between it and the cards: more than between two cards, so the list reads
// apart from them.
public const TABS_WIDTH = 217.96875dp
public const TABS_GAP: Number<Spacing> = 8sp
// The room the list's scroll bar takes at its right.
public const SCROLL_ROOM = 18.75dp
// What a window keeps above and below its list (its tab row, its header, its footer's text, its room), the footer's
// marble's own room besides (`footRoom`): the list is never higher than the screen less these.
const AROUND_LIST = 257.8125dp

const BODY: Array<Track> = ["max-content", { fr: 1 }]
const WITH_TABS: Array<Track> = [TABS_WIDTH, { fr: 1 }]
// The tabs' column: the window's room at the top, the sides and under them.
const COLUMN_ROOM: Edges = { top: 8sp, right: 4sp, bottom: 8sp, left: 4sp }
const FILL: Array<Track> = [{ fr: 1 }]
const NOTED: Array<Track> = ["max-content", { fr: 1 }]
// The counts, the room between, the buttons (or the gold tracked), the money.
const FOOT: Array<Track> = ["max-content", { fr: 1 }, "max-content", "max-content"]
// The footer band's room over and under what it holds, and its line along the top (Ordaen's FooterBand).
const FOOT_BAND: Number<Spacing> = 4sp
const BAND_LINE: ArtBorder = { sides: [Side.Top], ..ARTWORK.frame.tabIconLine }
const LABEL: Color = Color.hex("#a3977f")
const COUNT: Color = Color.hex("#a3977f")
const BUTTON = 140.625dp
const SORTS: Array<Choice<SortBy>> = [
  { value: SortBy.Bags, label: Locale.SORT_BAGS },
  { value: SortBy.Quality, label: Locale.SORT_QUALITY },
  { value: SortBy.Name, label: Locale.SORT_NAME },
  { value: SortBy.Level, label: Locale.SORT_LEVEL },
  { value: SortBy.Count, label: Locale.SORT_COUNT },
  { value: SortBy.Type, label: Locale.SORT_TYPE }
]
// The backpack's icon of the game's, on the bag slots' button.
const BACKPACK: FileId = 130716

// The junk of a vault's slots, and what a merchant gives for it.
public function junkIn(stock: Stock): Array<Slot> {
  _ = stock.revision
  return stock.all.filter(slot => slot.junk)
}

public function worthIn(junk: Array<Slot>): Integer {
  let worth = 0
  for (slot of junk) { worth += slot.read.price * slot.read.count }
  return worth
}

// A tab of the guild's at the window's left: its icon and name, the withdrawals a day it allows; one the player may
// not see is dim, and away from the guild bank every tab but the one seen last.
class GuildTabEntry implements Component {
  public picked: Event<Integer> = new Event()
  derived selected: Boolean = self.page == GuildPage.Items && self.current == self.tab.index
  derived off: Boolean = !self.tab.viewable || (!self.live && !self.selected)
  derived limit: String = withdrawalsText(self.tab)

  tab: Signal<GuildTab>
  current: Signal<Integer>
  page: Signal<GuildPage>
  live: Signal<Boolean>
  constructor(tab: Signal<GuildTab>, current: Signal<Integer>, page: Signal<GuildPage>, live: Signal<Boolean>) {
    self.tab = tab
    self.current = current
    self.page = page
    self.live = live
  }

  onPick(self) {
    if (self.tab.viewable && self.live) { self.picked.emit(self.tab.index) }
  }

  public render(self): Template {
    return $ltml {
      <ListTab label={self.tab.name} icon={self.tab.icon} selected={self.selected} off={self.off} @pick={self.onPick}>
        <text value={self.limit} textColor={COUNT} textSize={SECONDARY_TEXT} textFont={.Numbers} />
      </ListTab>
    }
  }
}

public class Pane {
  // The header's «Sort the bags»; a guild's tab, its log, its money's log picked; the footer's buttons.
  public arrange: Event<nil> = new Event()
  public guildTab: Event<Integer> = new Event()
  public guildLog: Event<nil> = new Event()
  public moneyLog: Event<nil> = new Event()
  public sellJunk: Event<nil> = new Event()
  public deposit: Event<nil> = new Event()
  public withdraw: Event<nil> = new Event()

  public state tab: Tab = Tab.All
  public state search = ""
  state goldShown = false

  derived isGuild: Boolean = self.vault == Vault.Guild
  public derived isBags: Boolean = self.vault == Vault.Bags
  derived isBank: Boolean = self.vault == Vault.Bank
  public derived categories: Boolean = !self.isGuild && self.list.values.view == View.Categories
  derived withList: Boolean = self.categories || self.isGuild
  derived query: String = self.search.lower()
  // The vault's slots, read once at least: the bank's are read at a banker alone.
  derived stock: Stock = self.stockOf()
  derived seen: Boolean = self.stock.total > 0
  // Away from its vault, a copy: the window says so, and its slots are shown, not used.
  derived copy: Boolean = !self.live && self.seen
  derived copyText: String = self.isGuild ? Locale.GUILD_COPY : Locale.BANK_COPY
  // The copy's note over the list, which takes the rest.
  derived listRows: Array<Track> = self.copy ? NOTED : FILL
  public derived counts: Map<Tab, Integer> = self.countsOf()
  public derived tabs: Array<Tab> = self.tabsOf()
  derived shownTab: Tab = self.tabs.any(tab => tab == self.tab) ? self.tab : Tab.All
  // The categories as Ordaen's column of tabs has them: each's name, its count, off where it holds nothing, and the
  // shown one's place, which a click writes.
  derived tabNames: Array<String> = self.tabs.map(tab => tabName(tab))
  derived tabCounts: Array<Integer> = self.tabs.map(tab => self.counts[tab] ?? 0)
  derived tabOffs: Array<Boolean> = self.tabs.map(tab => (self.counts[tab] ?? 0) == 0)
  state tabPlace = 1
  public derived sections: Array<Section> = self.sectionsOf()
  // The list's width: the body's but for the window's room, the tabs where they show, the scroll bar.
  derived slotGap: Number<Spacing> = self.choices.slotGap * 1sp
  derived room: CardRoom = cardRoom(self.choices.slotGap, self.choices.slotSize, self.choices.rowLeast)
  derived slotSize: Number<Length> = self.room.slot
  // The least window: a card of the fewest slots in a row, the list of tabs beside it where it shows.
  public derived leastWidth: Number<Length> = frameSides() + self.tabsRoom + cardWidth(self.room.least, self.room) + SCROLL_ROOM
  derived tabsRoom: Number<Length> = self.withList ? TABS_WIDTH + Ordaen.lengthOf(2 * PAGE_SIDE) : 0ui
  // The toolbar keeps the page's sides itself, or stands in the column beside the tabs that keeps them.
  derived toolRoom: Edges = self.withList ? TOP_ROOM : TOOL_ROOM
  derived listWidth: Number<Length> = self.width - frameSides() - self.tabsRoom - SCROLL_ROOM
  public derived lines: Array<CardRow> = linesOf(self.sections, self.listWidth, self.room)
  // As high as its cards, or as the screen lets it be.
  derived cardsHeight: Number<Length> = heightOf(self.lines, self.room)
  derived footRoom: Number<Length> = Ordaen.lengthOf(FOOT_BAND) + reachDown(BAND_LINE) + BAND_LINE.width * 1ui
  derived listHeight: Number<Length> = self.cardsHeight.min(Client.UIParent.GetHeight() * 1ui - AROUND_LIST - self.footRoom)
  // It scrolls where the screen is too low for it, and clips otherwise: either way the cards, laid out for the width
  // it has, ask nothing of the window's least width, so the grip narrows it past the row it started from.
  derived listOverflow: Overflow = self.listHeight < self.cardsHeight ? Overflow.Scroll : Overflow.Hidden
  public derived filter: Filter = { query: self.query, place: Game.bags.place, lit: self.isBags ? self.lit : -1 }
  derived free: Integer = self.stock.free
  derived fills: Map<Integer, String> = self.stock.fills
  // The footer's counts: the free slots of the bags or the bank, and its junk where the junk is shown; the guild
  // bank's withdrawal left today.
  derived footCounts: Array<FooterCount> = self.footCountsOf()
  // The junk in the shown vault: how many, and what a merchant gives for it.
  derived junk: Array<Slot> = junkIn(self.stock)
  derived junkCount: Integer = self.junk.count(slot => peek slot.id != 0)
  derived junkWorth: Integer = worthIn(self.junk)
  derived junkShown: Boolean = self.categories && self.shownTab == Tab.Junk
  derived selling: Boolean = self.isBags && Game.bags.place == Game.BagPlace.Merchant && self.junkCount > 0
  derived guildLive: Boolean = self.isGuild && self.live
  derived gridShown: Boolean = !self.isGuild || !self.live || (self.guild.page == GuildPage.Items && !self.guild.loading)
  derived guildLeft: String = self.guild.withdrawLeft < 0 ? Locale.GUILD_ANY : Game.money.format(self.guild.withdrawLeft)
  derived goldRows: Array<TipRow> = self.gold
  derived bankSlots: Boolean = self.isBank && self.live
  // The view's glyphs: categories in tabs, sections side by side, one grid. Ordaen's art is read once its root is
  // made, as the module's is.
  views: Array<Choice<View>> = [
    { value: View.Categories, label: Locale.VIEW_CATEGORIES, icon: Ordaen.art.ctl.tool.categories },
    { value: View.Bags, label: Locale.VIEW_BAGS, icon: Ordaen.art.ctl.tool.table },
    { value: View.One, label: Locale.VIEW_ONE, icon: Ordaen.art.ctl.tool.one }
  ]
  // What every card and slot of the list reads, and the events they tell.
  public shelf: Shelf

  const carried: Stock
  const bank: Stock
  const guildStock: Stock
  const guild: GuildBank
  vault: Signal<Vault>
  // Whether the vault is open: the bags always, the bank at a banker, the guild bank at its vault.
  live: Signal<Boolean>
  list: mut ModuleMemory<BagsView>
  choices: Signal<Choices>
  // The window's body's width, as the player sized it.
  width: Signal<Number<Length>>
  lit: Signal<Integer>
  running: Signal<Boolean>
  gold: Signal<Array<TipRow>>
  slotsOpen: mut Signal<Boolean>
  bankSlotsOpen: mut Signal<Boolean>
  constructor(
    carried: Stock,
    bank: Stock,
    guildStock: Stock,
    guild: GuildBank,
    vault: Signal<Vault>,
    live: Signal<Boolean>,
    list: mut ModuleMemory<BagsView>,
    choices: Signal<Choices>,
    width: Signal<Number<Length>>,
    lit: Signal<Integer>,
    running: Signal<Boolean>,
    gold: Signal<Array<TipRow>>,
    slotsOpen: mut Signal<Boolean>,
    bankSlotsOpen: mut Signal<Boolean>,
    menu: Signal<SlotMenu | nil>,
    useClick: Signal<UseClick>
  ) {
    self.carried = carried
    self.bank = bank
    self.guildStock = guildStock
    self.guild = guild
    self.vault = vault
    self.live = live
    self.list = list
    self.choices = choices
    self.width = width
    self.lit = lit
    self.running = running
    self.gold = gold
    self.slotsOpen = slotsOpen
    self.bankSlotsOpen = bankSlotsOpen
    self.shelf = new Shelf(self.filter, self.free, self.slotSize, self.slotGap, self.fills, menu, useClick, self.live)
    // The tab clicked is the one shown; the one shown (kept, or the first where it went) is the one lit.
    watch (place of self.tabPlace) {
      const tab = (peek self.tabs)[place]
      if (tab != nil && tab != peek self.tab) { self.tab = tab }
    }
    watch (shown of self.shownTab) {
      for (place, tab of peek self.tabs) {
        if (tab == shown && place != peek self.tabPlace) { self.tabPlace = place }
      }
    }
  }

  stockOf(self): Stock {
    return match (self.vault) {
      .Bags => self.carried
      .Bank => self.bank
      .Guild => self.guildStock
    }
  }

  countsOf(self): Map<Tab, Integer> {
    const stock = self.stock
    _ = stock.revision
    return countsOf(stock.all)
  }

  // «All», «New» while something is new, then the kinds' tabs but those hidden, or empty where empty ones hide.
  tabsOf(self): Array<Tab> {
    const choices = self.choices
    let tabs: Array<Tab> = [Tab.All]
    if ((self.counts[Tab.New] ?? 0) > 0) { tabs.push(Tab.New) }
    for (kind of KINDS) {
      const empty = (self.counts[kind] ?? 0) == 0
      const hidden = choices.hidden.any(tab => tab == kind)
      if (!hidden && !(choices.hideEmpty && empty)) { tabs.push(kind) }
    }
    return tabs
  }

  sectionsOf(self): Array<Section> {
    const stock = self.stock
    _ = stock.revision
    if (self.isGuild) { return oneSection(stock.bags) }
    return match (self.list.values.view) {
      .Categories => tabSections(stock.all, self.shownTab, self.choices.grouping[self.shownTab] ?? .Type, self.list.values.sort)
      .Bags => bagSections(stock.bags, stock.infos.map(info => info.name))
      .One => oneSection(stock.bags)
    }
  }

  footCountsOf(self): Array<FooterCount> {
    if (self.guildLive) { return [{ label: Locale.GUILD_LEFT, value: self.guildLeft }] }
    const free: FooterCount = { label: Locale.FOOT_FREE, value: Locale.FREE_OF.format(self.free, self.stock.total) }
    if (!self.junkShown) { return [free] }
    return [free, { label: Locale.FOOT_JUNK, value: Locale.JUNK_WORTH.format(self.junkCount, Game.money.format(self.junkWorth)) }]
  }

  onGuildTab(self, tab: Integer) { self.guildTab.emit(tab) }
  onGuildLog(self) { self.guildLog.emit() }
  onMoneyLog(self) { self.moneyLog.emit() }
  onArrange(self) { self.arrange.emit() }
  onSellJunk(self) { self.sellJunk.emit() }
  onDeposit(self) { self.deposit.emit() }
  onWithdraw(self) { self.withdraw.emit() }
  onGoldEnter(mut self) { self.goldShown = true }
  onGoldLeave(mut self) { self.goldShown = false }

  // The footer band: the game's dark marble, the window's width, its line between it and the list.
  public const footer: Template = $ltml {
    <FooterBand>
      <box columns={FOOT} gap={6sp} yAlign={Align.Center}>
        <FooterCounts counts={self.footCounts} />
        <box />
        <PushButton $if={self.selling} label={Locale.SELL_JUNK} width={BUTTON} @click={self.onSellJunk} />
        <box $elseif={self.guildLive} columns={2} gap={3sp}>
          <PushButton label={Locale.GUILD_DEPOSIT} width={BUTTON} @click={self.onDeposit} />
          <PushButton label={Locale.GUILD_WITHDRAW} width={BUTTON} disabled={!self.guild.canWithdraw} @click={self.onWithdraw} />
        </box>
        <text $else value={Game.money.tracked} textFont={.Numbers} />
        <Money $if={self.isGuild} amount={self.guild.money} />
        <box $else @pointerEnter={self.onGoldEnter} @pointerLeave={self.onGoldLeave}>
          <Money amount={Game.money.amount} />
          <Tip $if={self.goldShown} title={Locale.GOLD} text={""} rows={self.goldRows} />
        </box>
      </box>
    </FooterBand>
  }

  // The cards, as high as they are together.
  const cards: Template = $ltml {
    <box columns={1} gap={CARD_GAP} height={self.listHeight} overflow={self.listOverflow}>
      <CardLine $for={line of self.lines} line={line} shelf={self.shelf} />
    </box>
  }

  // The toolbar: the search, the sort, tidying, the view, the bag slots.
  const tools: Template = $ltml {
    <box padding={self.toolRoom}>
      <Toolbar search={mut self.search} placeholder={Locale.SEARCH}>
        <ToolPick value={mut self.list.values.sort} choices={SORTS} icon={Ordaen.art.ctl.tool.sort} title={Locale.SORT} />
        <ToolAct icon={Ordaen.art.ctl.tool.arrange} title={Locale.ARRANGE} text={Locale.ARRANGE_TIP}
                 disabled={self.running || !self.isBags} @pressed={self.onArrange} />
        <ToolPick value={mut self.list.values.view} choices={self.views} icon={Ordaen.art.ctl.tool.categories} title={Locale.VIEW} />
        <ToolButton $if={self.isBags} icon={BACKPACK} title={Locale.BAG_SLOTS} text={Locale.BAG_SLOTS_TIP}
                    open={mut self.slotsOpen} tinted={false} />
        <ToolButton $elseif={self.bankSlots} icon={BANK_ICON} title={Locale.BANK_SLOTS} text={Locale.BANK_SLOTS_TIP}
                    open={mut self.bankSlotsOpen} tinted={false} />
      </Toolbar>
    </box>
  }

  // The vault's note over the list, and the list: the cards, or the guild's log.
  const content: Template = $ltml {
    <box columns={1} rows={self.listRows} gap={3sp}>
      <box $if={self.copy} padding={ROW_ROOM}> <text value={self.copyText} textColor={LABEL} textSize={SECONDARY_TEXT} /> </box>
      <box $if={!self.seen && !self.live} padding={ROW_ROOM}> <text value={Locale.BANK_UNSEEN} textColor={LABEL} /> </box>
      <box $elseif={self.gridShown} columns={1}>
        {self.cards}
      </box>
      <text $elseif={self.guild.page == GuildPage.Items} value={Locale.GUILD_LOADING} textColor={LABEL} />
      <ScrolledList $else columns={1} gap={3sp}>
        <text $for={line of self.guild.log} value={line} />
      </ScrolledList>
    </box>
  }

  // With a list of tabs (the categories, the guild bank's tabs): the tabs down a marble column at the left, the page's
  // whole height, the toolbar and the list beside it. Else the toolbar over the list.
  public const body: Template = $ltml {
    <box $if={self.withList} columns={WITH_TABS} rows={FILL}>
      <box $if={self.isGuild} columns={1} gap={0.5sp} padding={COLUMN_ROOM} background={Ordaen.art.window.marble}>
        <GuildTabEntry $for={tab of self.guild.tabs} tab={tab} current={self.guild.tab} page={self.guild.page} live={self.live}
                       @picked={self.onGuildTab} />
        <ListTab $if={self.live} label={Locale.GUILD_LOG} selected={self.guild.page == GuildPage.Log} @pick={self.onGuildLog} />
        <ListTab $if={self.live} label={Locale.GUILD_MONEY_LOG} selected={self.guild.page == GuildPage.MoneyLog}
                 @pick={self.onMoneyLog} />
      </box>
      <Tabs $else tabs={self.tabNames} selected={mut self.tabPlace} counts={self.tabCounts} offs={self.tabOffs} vertical={true} />
      <box rows={BODY} gap={6sp} padding={SIDE_ROOM}>
        {self.tools}
        {self.content}
      </box>
    </box>
    <box $else rows={BODY} gap={6sp}>
      {self.tools}
      {self.content}
    </box>
  }
}
