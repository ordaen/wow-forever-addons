// Ordaen Inventory: every bag in one window, in place of the game's bag windows. At a banker or the guild's vault the bank or
// the guild bank is a window of its own beside the bags'; away from them, each is a tab of the bags' window with its
// icon, showing what it held when the player last saw it this session. The bags' window shows while the game has its
// bags, its bank or its guild bank open, the vault's while it has the bank or the guild bank open, and the game's own
// windows of those are held unseen and off the screen meanwhile; a close shuts them. Each window's body is a pane
// (`@/pane`): the header, the views, the list of cards, the footer; its corner's settings plate opens the module's place
// in the settings window. Junk is a category decided once for all three views (`@/junk`): a coin on its slots, the
// «Junk» tab, the tooltip's note of why; at a merchant «Sell junk» sells it. A slot's clicks are the player's scheme
// (`@/clicks`), and its menu holds every action on the item. A window is at least a row of the fewest slots wide (the
// player's choice), beside its tabs where they show, and at least as high as its list: no item hides under a scroll.
// While it is shut nothing is read and no event of it is heard.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Event, Frame, MouseButton } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import {
  ButtonPlate, Dialog, KeptWindow, Module, ModuleMemory, MoneyField, PushButton, Settings, SettingsPage, TipRow, Window, WindowTabSpec,
  WindowsPage, say, windowsTitle
} from "Ordaen"
import { Arranger } from "@/arrange"
import { BagLine, BagSlotsWindow } from "@/bagSlots"
import { BANK_ICON, BankBag, BankSlotsWindow, bankInfos } from "@/bank"
import { BagChanger, Change } from "@/change"
import { OURS, SlotAction, UseClick, actionAt, chordOf, useClickOf } from "@/clicks"
import { Gold } from "@/gold"
import { Guard, GuardTips, Hovered } from "@/guard"
import { GUILD_ICON, GuildBank } from "@/guild"
import { JUNK_RULES, JunkLists, JunkRules, LEARNED, Mark, NO_LISTS, afterSale, shareOf, teaches, withMark, withScore } from "@/junk"
import { NO_ROOM, ROW_LEAST, SLOT_GAP, SLOT_SIZE } from "@/layout"
import Locale from "@/locales"
import { LOOT_CHOICES, LootChoices, Looter } from "@/loot"
import { CONTAINER, MOVED, Slot, SortBy, handsOver } from "@/model"
import { BagsView, Choices, Pane, junkIn, worthIn } from "@/pane"
import { ClicksPage, ConveniencePage, JunkPage, LookPage, LootPage } from "@/settings"
import { MenuAct, SlotMenu, menuOf } from "@/slotMenu"
import { Stock } from "@/stock"
import { LootLines, LootToasts } from "@/toasts"
import { GUILD_SLOTS, Vault, pickupIn } from "@/vault"

// What the module remembers for the character: the protected slots, one at most for each slot of the bags.
// Where the window stands is the window's own (`Window`, the profile's).
public struct Kept implements Plain {
  guards: Array<Guard>
}

const BAGS_VIEW: BagsView = {}

// A sale by hand at a merchant, noted as the player's click sells: the next update of its bag says whether it sold.
struct Sale {
  const bag: Integer
  const index: Integer
  const id: Integer
  const count: Integer
  const price: Integer
  const link: String
  // Whether it teaches the bags: learning is on and neither a mark nor a rule decides the item.
  const teaches: Boolean
}

// The guild's money the dialog moves: in, or out.
enum MoneyMove { Deposit, Withdraw }

const DEFAULTS: Choices = { hidden: [], hideEmpty: false, grouping: {}, junk: JUNK_RULES, slotPresses: OURS, slotGap: SLOT_GAP, slotSize: SLOT_SIZE,
  rowLeast: ROW_LEAST, loot: LOOT_CHOICES
}
const NOTHING_KEPT: Kept = { guards: [] }
// The window's body: wide enough for the tabs and ten slots, tall enough for ten rows.
// Between the window and a bag's window opened beside it.
const BESIDE: Number<Spacing> = 6sp
const WIDTH = 773.4375dp
const HEIGHT = 609.375dp
// The bags and Ordaen Trading's merchant window open together: by default they stand side by side about the screen's
// middle, the bags on the right, this gap between them.
const APART = 11.71875dp
const BAGS_X = (WIDTH + APART) / 2
// Junk sold at once by «Sell junk»: what the merchant's buyback keeps, so all can be bought back.
const SAFE_SALE = 12

// The module's mark in the chat.
const CAPTION: Color = Color.hex("#e8c35a")
const BUTTON = 140.625dp
const DIALOG = 375dp
// The bags' tab of the window: the game's bag icon.
const BAGS_ICON: Asset = "Interface/Icons/INV_Misc_Bag_08"

public class Inventory implements Module, App {
  public const title: String = "Ordaen Inventory"
  // Its windows, declared: where each stands and what the player does with it, kept in the profile.
  public window: mut KeptWindow = new KeptWindow("main", self.title, { x: BAGS_X, y: 0ui, width: WIDTH, height: HEIGHT })
  public slotsWindow: mut KeptWindow = new KeptWindow("slots", Locale.BAG_SLOTS, { x: 0ui, y: 0ui, width: 292.96875dp, height: 351.5625dp })
  public bankSlotsWindow: mut KeptWindow = new KeptWindow("bankSlots", Locale.BANK_SLOTS, { x: 0ui, y: 0ui, width: 292.96875dp, height: 351.5625dp })
  // The bank's or the guild bank's window while the game has it open.
  public vaultWindow: mut KeptWindow = new KeptWindow("vault", Locale.BANK, { x: 0ui, y: 0ui, width: WIDTH, height: HEIGHT })
  public const windows: mut Array<mut KeptWindow> = [
    self.window, self.vaultWindow, self.slotsWindow, self.bankSlotsWindow
  ]
  // A merchant's window is open; Ordaen Trading's shows its buyback (`showsBuyback`): a slot's use there sells nothing,
  // as the game's window has it.
  state atMerchant = false
  state buyingBack = false
  // The junk was sold by itself at this merchant's visit.
  state soldThisVisit = false
  public settings: mut Settings<Choices> = new Settings<Choices>(DEFAULTS)
  public const pages: Array<SettingsPage> = [
    { title: windowsTitle(), content: $ltml { <WindowsPage windows={mut self.windows} /> } },
    { title: Locale.PAGE_LOOK, content: $ltml { <LookPage slotSize={mut self.settings.values.slotSize} slotGap={mut self.settings.values.slotGap}
                                                          rowLeast={mut self.settings.values.rowLeast} /> } },
    { title: Locale.PAGE_CONVENIENCE, content: $ltml { <ConveniencePage sellJunk={mut self.settings.values.sellJunkAtVendor} /> } },
    { title: Locale.PAGE_LOOT, content: $ltml { <LootPage choices={mut self.settings.values.loot} /> } },
    { title: Locale.PAGE_JUNK, content: $ltml { <JunkPage rules={mut self.settings.values.junk} @reset={self.onResetJunk} /> } },
    { title: Locale.PAGE_SLOT, content: $ltml { <ClicksPage clicks={mut self.settings.values.slotPresses} /> } }
  ]
  public memory: mut ModuleMemory<Kept> = new ModuleMemory<Kept>(NOTHING_KEPT, .Character)
  // What the player marked and what the bags learned: the active profile's, kept at once as play makes it.
  public junkLists: mut ModuleMemory<JunkLists> = new ModuleMemory<JunkLists>(NO_LISTS, .Character, "junk")
  public gold: Gold
  public arranger: mut Arranger
  // A bag from the bags being put on, the bag it replaces emptied first.
  public changer: mut BagChanger = new BagChanger()
  public hovered: mut Hovered
  tips: GuardTips

  // The slots of the bags, the bank and the guild bank's shown tab.
  public carried: mut Stock = new Stock(.Bags)
  public bank: mut Stock = new Stock(.Bank)
  public vaultGuild: mut Stock = new Stock(.Guild)
  public guild: mut GuildBank
  // A bank's container changed since the client's last batch of updates.
  bankDirty = false
  sale: Sale | nil = nil

  public state slotsOpen = false
  public state bankSlotsOpen = false
  public state lit = -1
  // The bag a line of the bag slots kept lit by a click; -1 for none. The cursor's coming and going lights another
  // and gives it back.
  state kept = -1
  // The client's bag buttons hooked (the bottom panel shows them): the cursor on one lights its bag, as on ours.
  hooked: mut Map<any Client.Frame, Boolean> = {}
  // The slot whose menu is open, with its lines.
  public state menu: SlotMenu | nil = nil
  // The guild's money dialog, and what it holds.
  state moving: MoneyMove | nil = nil
  // The refundable purchase whose sale is asked about.
  state refunding: Slot | nil = nil
  derived refundText: String = self.refundTextOf()
  state amount = 0
  // The window is built the first time it opens, and kept drawn, shown or hidden, from then on.
  state ever = false

  public derived bankOpen: Boolean = Game.bankObserver.open
  public derived shown: Boolean = Game.bags.open || self.bankOpen || self.guild.open
  // At the bank or the guild's vault: it has a window of its own, and the bags' window shows the bags alone.
  public derived atVault: Boolean = self.bankOpen || self.guild.open
  derived vaultOpen: Vault = self.bankOpen ? Vault.Bank : Vault.Guild
  // The bags' window's tabs: the bags; away from the vaults, the bank and the guild bank seen this session.
  public derived vaults: Array<Vault> = self.vaultsOf()
  public state windowTab = 1
  public derived vault: Vault = self.vaults[self.windowTab] ?? Vault.Bags
  derived windowTabs: Array<WindowTabSpec> = self.vaults.map(vault => self.tabSpec(vault))
  derived live: Boolean = self.liveIn(self.vault)
  // The vault's window: its one tab, the bank's or the guild bank's.
  state vaultTab = 1
  derived vaultTabs: Array<WindowTabSpec> = [self.tabSpec(self.vaultOpen)]
  derived mainWidth: Number<Length> = self.window.placing.width
  derived vaultWidth: Number<Length> = self.vaultWindow.placing.width
  // The game's own windows held unseen while ours stands in their place.
  derived gameFrames: Array<any Frame> = self.gameFramesOf()
  // The header's picks: the view and the sort, kept in the profile as they are picked.
  public list: mut ModuleMemory<BagsView> = new ModuleMemory<BagsView>(BAGS_VIEW, .Profile, "view")
  // The chord a container's slot is used by, the client's own secure click.
  derived useClick: UseClick = useClickOf(self.settings.values.slotPresses)
  derived bagLines: Array<BagLine> = self.bagLinesOf()
  derived bankBags: Array<BankBag> = self.bankBagsOf()
  derived goldRows: Array<TipRow> = self.gold.rows
  derived running: Boolean = self.arranger.running
  // The bags' junk, whatever the window shows: what the merchant's window sells.
  derived carriedJunk: Array<Slot> = junkIn(self.carried)
  public derived carriedJunkCount: Integer = self.carriedJunk.count(slot => peek slot.id != 0)
  public derived carriedJunkWorth: Integer = worthIn(self.carriedJunk)
  derived moneyTitle: String = self.moving == MoneyMove.Withdraw ? Locale.GUILD_WITHDRAW : Locale.GUILD_DEPOSIT
  // The bags' window's body, and the vault's.
  public main: Pane
  public side: Pane
  // Looting fast, and the lines of what was looted.
  public looter: Looter
  public lootLines: mut LootLines = new LootLines()
  derived lootChoices: LootChoices = self.settings.values.loot
  derived toastsShown: Boolean = self.lootChoices.toasts
  // The money while a loot window is open: what it gains is looted.
  lootMoney: Integer | nil = nil

  constructor() {
    self.gold = new Gold()
    self.arranger = new Arranger()
    self.hovered = new Hovered()
    self.guild = new GuildBank()
    self.tips = new GuardTips(self.hovered, self.settings.values, self.bankOpen, self.guild.open)
    self.main = new Pane(
      self.carried, self.bank, self.vaultGuild, self.guild, self.vault, self.live, mut self.list, self.settings.values,
      self.mainWidth, self.lit, self.running, self.goldRows, mut self.slotsOpen, mut self.bankSlotsOpen, self.menu, self.useClick
    )
    self.side = new Pane(
      self.carried, self.bank, self.vaultGuild, self.guild, self.vaultOpen, self.atVault, mut self.list, self.settings.values,
      self.vaultWidth, self.lit, self.running, self.goldRows, mut self.slotsOpen, mut self.bankSlotsOpen, self.menu, self.useClick
    )
    self.looter = new Looter(self.lootChoices)
    self.looter.took.listen(self.onLooted)
    Game.loot.opened.listen(self.onLootOpened)
    Game.loot.closed.listen(self.onLootClosed)
    watch (copper of Game.money.amount) { self.onMoney(copper) }
    Ordaen.modules.add(self)
    self.changer.stuck.listen(self.onBagStuck)
    Game.bags.updated.listen(self.onUpdated)
    Game.bags.loaded.listen(self.onLoaded)
    Events.MERCHANT_SHOW.listen(self.onMerchantShown)
    Events.MERCHANT_CLOSED.listen(self.onMerchantClosed)
    Game.bankObserver.changed.listen(self.onBankChanged)
    self.guild.slots.listen(self.readGuild)
    self.hear(self.main)
    self.hear(self.side)
    watch (open of self.atVault) { self.onVault(open) }
    watch (open of self.slotsOpen) { self.placeSlots(open, mut self.slotsWindow, self.window, true) }
    watch (open of self.bankSlotsOpen) { self.placeSlots(open, mut self.bankSlotsWindow, self.vaultWindow, false) }
    watch (open of Game.bags.open) { self.onOpen(open) }
    watch (open of self.bankOpen) { self.onBank(open) }
    watch (open of self.guild.open) { self.onGuild(open) }
    watch (buttons of Game.bags.buttons) { for (button of buttons) { self.hookBag(button) } }
    // A mark, a score or a rule changed: every slot's verdict is worked out again.
    watch { self.judge(self.junkLists.values, self.settings.values.junk) }
  }

  destructor() {
    Game.bags.follow(false)
  }

  // The bank's tab always (it says how to see it until the bank was read); the guild bank's once a tab of it was read.
  vaultsOf(self): Array<Vault> {
    let vaults: Array<Vault> = [Vault.Bags]
    if (self.atVault) { return vaults }
    vaults.push(Vault.Bank)
    if (self.vaultGuild.total > 0) { vaults.push(Vault.Guild) }
    return vaults
  }

  // Whether the vault's slots are the game's as they are: the bags always, the bank and the guild bank while open.
  liveIn(self, vault: Vault): Boolean {
    return match (vault) {
      .Bags => true
      .Bank => self.bankOpen
      .Guild => self.guild.open
    }
  }

  // What a pane tells: its slots' clicks and the cursor, its header's and its footer's buttons.
  hear(mut self, pane: Pane) {
    pane.shelf.pressed.listen(self.onPressed)
    pane.shelf.pickup.listen(self.onPickup)
    pane.shelf.entered.listen(self.onEnter)
    pane.shelf.left.listen(self.onLeave)
    pane.shelf.picked.listen(self.onMenuPick)
    pane.shelf.closed.listen(self.onMenuClose)
    pane.arrange.listen(self.arrange)
    pane.guildTab.listen(self.onGuildTab)
    pane.guildLog.listen(self.onGuildLog)
    pane.moneyLog.listen(self.onMoneyLog)
    pane.sellJunk.listen(self.sellJunk)
    watch { self.sellAtVisit() }
    pane.deposit.listen(self.onDeposit)
    pane.withdraw.listen(self.onWithdraw)
  }

  // At the bank or the guild's vault the bags' window shows the bags, and the vault's window stands at its left,
  // level with its top, at the size it was left at.
  onVault(mut self, open: Boolean) {
    self.windowTab = 1
    if (!open) { return }
    const at = peek self.window.placing
    const size = peek self.vaultWindow.memory.values
    self.vaultWindow.memory.write({
      x: at.x - at.width / 2 - Ordaen.lengthOf(BESIDE) - size.width / 2, y: at.y - at.height / 2 + size.height / 2, ..size
    })
  }

  tabSpec(self, vault: Vault): WindowTabSpec {
    return match (vault) {
      .Bags => { title: Locale.TITLE, desc: nil, icon: BAGS_ICON }
      .Bank => { title: Locale.BANK, desc: nil, icon: BANK_ICON }
      .Guild => { title: Locale.GUILD_BANK, desc: nil, icon: GUILD_ICON }
    }
  }

  gameFramesOf(self): Array<any Frame> {
    let frames: Array<any Frame> = []
    for (window of Game.bags.windows) { frames.push(window) }
    if (self.bankOpen) {
      const bank = Runtime.frame("BankFrame")
      if (bank != nil) { frames.push(bank) }
    }
    // The guild bank's window is loaded as it opens: looked for again once its first slots came.
    if (self.guild.open && !self.guild.loading) {
      const guild = Runtime.frame("GuildBankFrame")
      if (guild != nil) { frames.push(guild) }
    }
    return frames
  }

  byCount(self): Boolean { return peek self.list.values.sort == SortBy.Count }

  // The bags opened: everything read anew and followed while they are; shut, nothing is heard.
  onOpen(mut self, open: Boolean) {
    Game.bags.follow(open)
    if (!open) {
      self.arranger.stop()
      self.lit = -1
      self.hovered.slot = nil
      self.menu = nil
      return
    }
    self.ever = true
    self.readAll()
  }

  // The bank opened: its window shows, read now and again after each batch of the client's updates while it is open.
  onBank(mut self, open: Boolean) {
    if (!open) {
      self.bankSlotsOpen = false
      return
    }
    self.ever = true
    self.readBank()
    Events.BAG_UPDATE_DELAYED.listen(self.onBatch)
  }

  onBankChanged(mut self) { self.bankDirty = true }

  onBatch(mut self) {
    if (!self.bankDirty) { return }
    self.bankDirty = false
    self.readBank()
  }

  readBank(mut self) {
    const changed = self.bank.read(bankInfos(), peek self.junkLists.values, peek self.settings.values.junk)
    self.bank.regroup(changed, self.byCount())
  }

  onGuild(mut self, open: Boolean) {
    if (!open) {
      self.moving = nil
      return
    }
    self.ever = true
  }

  // The guild bank's shown tab came: its slots read, in their own order.
  readGuild(mut self) {
    const tab = peek self.guild.tab
    const info: Game.BagInfo = { bag: tab, item: nil, name: "", icon: nil, slots: GUILD_SLOTS, general: true }
    const changed = self.vaultGuild.read([info], peek self.junkLists.values, peek self.settings.values.junk)
    self.vaultGuild.regroup(changed, self.byCount())
  }

  // Every bag read: a bag whose size changed gets its slots made again.
  public readAll(mut self) {
    let infos: Array<Game.BagInfo> = []
    for (bag of Game.bags.containers) { infos.push(Game.bags.bag(bag)) }
    self.settle(self.carried.read(infos, peek self.junkLists.values, peek self.settings.values.junk))
  }

  // A bag the game told changed: its slots read again; another size, every bag.
  // An item the client loaded: each bag holding it read before it was is read again, its verdict with it.
  onLoaded(mut self, item: Integer) {
    for (place, slots of self.carried.bags) {
      const bag = self.carried.infos[place]?.bag
      if (bag != nil && slots.any(slot => peek slot.id == item && !slot.read.loaded)) { self.onUpdated(bag) }
    }
  }

  onUpdated(mut self, bag: Integer) {
    const place = self.carried.placeOf(bag)
    const changed = place == nil ? nil :
      self.carried.update(place, Game.bags.size(bag), peek self.junkLists.values, peek self.settings.values.junk)
    if (changed == nil) {
      self.readAll()
    } else {
      self.settle(changed)
    }
    self.learnSale(bag)
    self.arranger.step()
    self.changer.step()
  }

  // What an update of the bags changed: the protections follow their items, and the sections are worked out again.
  settle(mut self, changed: Integer) {
    if (Client.bit.band(changed, MOVED) != 0) { self.follow() }
    self.carried.regroup(changed, self.byCount())
  }

  // Every slot's verdict worked out again: a mark, a score or a rule changed.
  judge(mut self, lists: JunkLists, rules: JunkRules) {
    self.carried.regroup(self.carried.judge(lists, rules), false)
    self.bank.regroup(self.bank.judge(lists, rules), false)
    self.vaultGuild.regroup(self.vaultGuild.judge(lists, rules), false)
  }

  // The protections where their items are: one whose slot holds its item stays; one whose item came into another slot
  // goes with it; one whose item is gone from the bags is dropped. A slot is drawn protected where one stays.
  follow(mut self) {
    const kept = peek self.memory.values
    let guards: Array<Guard> = []
    let changed = false
    for (guard of kept.guards) {
      const slot = self.carried.slotAt(guard.bag, guard.slot)
      if (slot != nil && peek slot.id == guard.id) {
        guards.push(guard)
      } else {
        changed = true
        const moved = self.carried.arrived.find(found => peek found.id == guard.id && !self.guardedIn(guards, found))
        if (moved != nil) { guards.push({ bag: moved.bag, slot: moved.index, id: guard.id }) }
      }
    }
    if (changed) { self.memory.write({ guards: guards, ..kept }) }
    self.markGuards(guards)
  }

  guardedIn(self, guards: Array<Guard>, slot: Slot): Boolean {
    return guards.any(guard => guard.bag == slot.bag && guard.slot == slot.index)
  }

  markGuards(mut self, guards: Array<Guard>) {
    for (slot of self.carried.all) { slot.guarded = self.guardedIn(guards, slot) }
  }

  bagLinesOf(self): Array<BagLine> {
    _ = self.carried.revision
    let lines: Array<BagLine> = []
    for (index, info of self.carried.infos) {
      // A bag's place stands empty too; the keyring (no place) only where the client gives it slots.
      if (info.bag >= 0 || info.slots > 0) {
        const slots = self.carried.bags[index] ?? []
        lines.push({ info: info, used: slots.count(slot => peek slot.id != 0) })
      }
    }
    return lines
  }

  // The bank's bags: each container past the bank's own, at its place among the bank's bag slots.
  bankBagsOf(self): Array<BankBag> {
    _ = self.bank.revision
    let bags: Array<BankBag> = []
    for (index, info of self.bank.infos) {
      if (index > 1) {
        const slots = self.bank.bags[index] ?? []
        bags.push({ place: index, info: info, used: slots.count(slot => peek slot.id != 0) })
      }
    }
    return bags
  }

  // A click on a slot: what the cursor holds is put down by the left button; else the chord's action in the player's
  // scheme. A container's use is the client's own secure click on its chord (`useClick`), done before this is told.
  // A copy's slot (its vault shut) takes no click: only its vault's own are the game's.
  onPressed(mut self, slot: mut Slot, click: Event.Press) {
    self.menu = nil
    if (!self.liveIn(slot.vault)) { return }
    // The waiting spell took the item on the secure click.
    if (slot.vault != Vault.Guild && peek Game.player.targeting) { return }
    if (click.button == MouseButton.Left && self.dropMoney()) { return }
    if (click.button == MouseButton.Left && Client.CursorHasItem()) {
      pickupIn(slot.vault, slot.bag, slot.index)
      return
    }
    const chord = chordOf(click.button, Game.input.shiftDown(), Game.input.controlDown(), Game.input.altDown())
    if (chord == nil) { return }
    self.act(mut slot, actionAt(peek self.settings.values.slotPresses, chord))
  }

  // Gold on the cursor let go on a slot, as the game's bags do: the player's back into the purse, the guild bank's
  // taken out of it. False where the cursor holds no gold.
  dropMoney(self): Boolean {
    const kind, money, _, _ = Client.GetCursorInfo()
    if (kind == "money") {
      Client.DropCursorMoney()
    } else if (kind == "guildbankmoney" && money is Number) {
      Client.WithdrawGuildBankMoney(money)
    } else {
      return false
    }
    Client.ClearCursor()
    return true
  }

  act(mut self, slot: mut Slot, action: SlotAction) {
    const id = peek slot.id
    match (action) {
      .Use => self.used(slot)
      .Pickup => pickupIn(slot.vault, slot.bag, slot.index)
      .Menu => self.openMenu(slot)
      .Link => {
        if (id != 0) { Game.chat.link(id) }
      }
      .Protect => {
        if (slot.vault == Vault.Bags) { self.guard(slot) }
      }
      .Socket => {
        if (id != 0 && slot.vault != Vault.Guild) { _ = Client.C_Container.SocketContainerItem(slot.bag, slot.index) }
      }
      .Nothing => {}
    }
  }

  // The slot's use: a guild bank's stack goes into the bags; a container's the client used itself, and at a merchant
  // the sale is noted, to be learned from once the bag's update says it sold.
  used(mut self, slot: Slot) {
    const id = peek slot.id
    if (id == 0) { return }
    if (slot.vault == Vault.Guild) {
      self.guild.take(slot.bag, slot.index)
      return
    }
    const place = peek Game.bags.place
    if (place == Game.BagPlace.Merchant && slot.vault == Vault.Bags) {
      // The buyback shown: nothing is sold. A purchase still refundable is asked about first, and refunded.
      if (peek self.buyingBack) { return }
      if (refundOf(slot) != nil) {
        self.refunding = slot
        return
      }
    }
    if (slot.vault == Vault.Bags && !handsOver(place) && slot.read.kind == CONTAINER) {
      self.putOn(slot)
      return
    }
    if (slot.vault != Vault.Bags || !handsOver(place) || !Game.bags.send(slot.bag, slot.index)) { return }
    if (place != Game.BagPlace.Merchant) { return }
    const rules = peek self.settings.values.junk
    self.sale = {
      bag: slot.bag, index: slot.index, id: id, count: peek slot.count, price: slot.read.price, link: slot.read.link,
      teaches: rules.learn && teaches(slot.read, peek self.junkLists.values, rules)
    }
  }

  // The bag of a noted sale updated: what left the slot was sold. It says so, and teaches the bags.
  learnSale(mut self, bag: Integer) {
    const sale = self.sale
    if (sale == nil || sale.bag != bag) { return }
    self.sale = nil
    const slot = self.carried.slotAt(sale.bag, sale.index)
    const left = slot != nil && peek slot.id == sale.id ? peek slot.count : 0
    const sold = sale.count - left
    if (sold <= 0) { return }
    self.say(Locale.CHAT_SOLD.format(sale.link, Game.money.format(sale.price * sold)))
    if (!sale.teaches) { return }
    const lists = peek self.junkLists.values
    const was = lists.learned[sale.id] ?? 0
    const now = afterSale(was, shareOf(sold, Game.items.maxStack(sale.id) ?? 1))
    self.junkLists.write(withScore(lists, sale.id, now))
    if (was <= LEARNED && now > LEARNED) { self.say(Locale.CHAT_LEARNED.format(sale.link)) }
  }

  // A bag of the bags used: put on, in an empty place or the smallest bag's; the chat says why where it can't be.
  putOn(mut self, slot: Slot) { self.change(slot, nil) }

  onBagStuck(self) { say({ name: Locale.CHAT_CAPTION, color: CAPTION }, Locale.CHAT_BAG_STUCK) }

  change(mut self, slot: Slot, into: Integer | nil) {
    const infos = peek self.carried.infos
    const change = self.changer.start(slot, self.carried.all, (bag: Integer): Boolean => self.carried.general(bag), into)
    const line = match (change) {
      Change.Started => ""
      Change.NoPlace => Locale.CHAT_NO_BAG_PLACE
      Change.NoRoom => Locale.CHAT_NO_BAG_ROOM
      Change.Refused => Locale.CHAT_BAG_REFUSED
      Change.Busy => Locale.CHAT_BAG_BUSY
    }
    if (line != "") { say({ name: Locale.CHAT_CAPTION, color: CAPTION }, line) }
  }

  // A bag held on the cursor let go on a bag's place. One from the bags (the client holds it locked in its slot) is
  // let go and put on as its use is, the bag there emptied first where it must be; one taken off a place is put on
  // there, the client swapping the two where the one there is empty.
  onPutBag(mut self, into: Integer) {
    const bag = self.carried.all.find(slot => peek slot.locked && slot.read.kind == CONTAINER && slot.vault == Vault.Bags)
    if (bag != nil) {
      Client.ClearCursor()
      self.change(bag, into)
      return
    }
    if (Game.bags.wearHeld(into) == Game.Wear.Refused) { say({ name: Locale.CHAT_CAPTION, color: CAPTION }, Locale.CHAT_BAG_REFUSED) }
  }

  // A line of the module's in the chat, where the player keeps them.
  say(self, line: String) {
    if (peek self.settings.values.junk.chat) { say({ name: Locale.CHAT_CAPTION, color: CAPTION }, line) }
  }

  openMenu(mut self, slot: Slot) {
    const id = peek slot.id
    if (id == 0) { return }
    const marked = (peek self.junkLists.values).marks[id]
    self.menu = menuOf(slot, marked?.mark, peek Game.bags.place)
  }

  onMenuClose(mut self) { self.menu = nil }

  // A line of the menu: its action, in the click's own call.
  onMenuPick(mut self, index: Integer) {
    const menu = peek self.menu
    self.menu = nil
    if (menu == nil) { return }
    const slot = menu.slot
    match (menu.acts[index] ?? MenuAct.Heading) {
      .Heading => {}
      .MarkJunk => self.mark(slot, .Junk)
      .MarkKeep => self.mark(slot, .Keep)
      .Unmark => self.mark(slot, nil)
      .Link => Game.chat.link(peek slot.id)
      .Socket => {
        _ = Client.C_Container.SocketContainerItem(slot.bag, slot.index)
      }
      .Sell => {
        _ = Game.bags.send(slot.bag, slot.index)
      }
      .Protect => self.guard(slot)
    }
  }

  // The player's mark on the slot's item: kept at once, every slot's verdict follows.
  public mark(mut self, slot: Slot, mark: Mark | nil) {
    const id = peek slot.id
    if (id == 0) { return }
    self.junkLists.write(withMark(peek self.junkLists.values, id, mark))
    const line = mark == nil ? Locale.CHAT_UNMARKED : mark == Mark.Junk ? Locale.CHAT_MARKED_JUNK : Locale.CHAT_MARKED_KEEP
    self.say(line.format(slot.read.link))
  }

  // At a merchant, its junk sold once a visit where the player wants it so: as soon as the bags know their junk (the
  // merchant opens them with its window, and they read their slots then).
  sellAtVisit(mut self) {
    if (!self.atMerchant) {
      self.soldThisVisit = false
      return
    }
    if (peek self.soldThisVisit || self.carriedJunkCount == 0 || !self.settings.values.sellJunkAtVendor) { return }
    self.soldThisVisit = true
    self.sellJunk()
  }

  // Ordaen Trading's merchant window shows its buyback, or its goods again.
  public showsBuyback(mut self, shown: Boolean) { self.buyingBack = shown }

  onMerchantShown(mut self) { self.atMerchant = true }

  onMerchantClosed(mut self) {
    self.atMerchant = false
    self.buyingBack = false
  }

  // «Sell junk» at a merchant (Ordaen Trading's window): the next junk items, `SAFE_SALE` at most so all can be bought
  // back, each the client's sale in the player's click. A locked slot and junk the merchant gives nothing for stay.
  public sellJunk(mut self) {
    let sold = 0
    let worth = 0
    for (slot of self.carried.all) {
      if (sold < SAFE_SALE && slot.junk && peek slot.id != 0 && !peek slot.locked && slot.read.price > 0 && refundOf(slot) == nil) {
        if (Game.bags.send(slot.bag, slot.index)) {
          sold += 1
          worth += slot.read.price * peek slot.count
        }
      }
    }
    if (sold > 0) { self.say(Locale.CHAT_SOLD_JUNK.format(sold, Game.money.format(worth))) }
  }

  // «Forget what was learned» and «Forget my marks» on the junk's page.
  onResetJunk(mut self, marks: Boolean) {
    const lists = peek self.junkLists.values
    self.junkLists.write(marks ? { marks: {}, ..lists } : { learned: {}, ..lists })
  }

  // A slot's item dragged off it, or what is dragged let go on it: picked up or put down there, as a plain click
  // does. The client's cursor holds what is picked up: an action bar's button takes it where it is let go.
  onPickup(self, slot: Slot) {
    if (self.liveIn(slot.vault)) { pickupIn(slot.vault, slot.bag, slot.index) }
  }

  // An item's slot protected, or no more: an empty slot has nothing to protect.
  public guard(mut self, slot: Slot) {
    if (peek slot.id == 0) { return }
    const kept = peek self.memory.values
    let guards: Array<Guard> = []
    let was = false
    for (guard of kept.guards) {
      if (guard.bag == slot.bag && guard.slot == slot.index) { was = true } else { guards.push(guard) }
    }
    if (!was) { guards.push({ bag: slot.bag, slot: slot.index, id: peek slot.id }) }
    self.memory.write({ guards: guards, ..kept })
    self.markGuards(guards)
  }

  // The cursor on a slot: its item new no more (the tabs and the sections worked out again: «New» counts it no
  // more), and the tooltip's lines about it.
  onEnter(mut self, slot: mut Slot) {
    if (peek slot.isNew) {
      slot.see()
      match (slot.vault) {
        .Bags => { self.carried.revision += 1 }
        .Bank => { self.bank.revision += 1 }
        .Guild => { self.vaultGuild.revision += 1 }
      }
    }
    self.hovered.slot = slot
  }

  onLeave(mut self, slot: Slot) {
    if (peek self.hovered.slot == slot) { self.hovered.slot = nil }
  }

  onGuildTab(mut self, tab: Integer) {
    self.guild.page = .Items
    self.guild.show(tab)
  }

  onGuildLog(mut self) { self.guild.showPage(.Log) }
  onMoneyLog(mut self) { self.guild.showPage(.MoneyLog) }

  onDeposit(mut self) {
    self.amount = 0
    self.moving = .Deposit
  }

  onWithdraw(mut self) {
    self.amount = 0
    self.moving = .Withdraw
  }

  onMoneyCancel(mut self) { self.moving = nil }

  refundTextOf(self): String {
    const slot = self.refunding
    const info = slot == nil ? nil : refundOf(slot)
    if (slot == nil || info == nil) { return "" }
    return info.money > 0 ? Locale.REFUND_ASK_MONEY.format(slot.read.link, Game.money.format(info.money.floor())) :
      Locale.REFUND_ASK.format(slot.read.link)
  }

  // The refund asked about given, in the player's click.
  onRefund(mut self) {
    const slot = peek self.refunding
    self.refunding = nil
    if (slot != nil) { Client.C_Container.ContainerRefundItemPurchase(slot.bag, slot.index, false) }
  }

  onRefundCancel(mut self) { self.refunding = nil }

  // The guild's money moved, in the player's click on the dialog's button.
  onMoneyMove(mut self) {
    const amount = peek self.amount
    if (amount > 0) {
      if (peek self.moving == MoneyMove.Withdraw) { self.guild.withdraw(amount) } else { self.guild.deposit(amount) }
    }
    self.moving = nil
  }

  // «Sort the bags»: the bags that take any item, their unprotected slots, into the sort's order.
  arrange(mut self) {
    const infos = peek self.carried.infos
    self.arranger.start(self.carried.all, (bag: Integer): Boolean => self.carried.general(bag), peek self.list.values.sort)
  }

  onLit(mut self, bag: Integer) { self.lit = bag < 0 ? peek self.kept : bag }

  // A bag's line clicked: that bag kept lit, or no more.
  onKeepBag(mut self, bag: Integer) {
    self.kept = peek self.kept == bag ? -1 : bag
    self.lit = peek self.kept < 0 ? bag : peek self.kept
  }

  // A worn bag's line dragged: the bag onto the cursor.
  onLiftBag(mut self, bag: Integer) { _ = Game.bags.pickupBag(bag) }

  hookBag(mut self, button: Game.BagButton) {
    const frame: any Client.Frame = button.frame
    if (self.hooked[frame] == true) { return }
    self.hooked[frame] = true
    const bag = button.bag
    _ = frame.HookScript("OnEnter", (...args: Unknown): nil => { self.lit = bag })
    _ = frame.HookScript("OnLeave", (...args: Unknown): nil => { if (peek self.lit == bag) { self.lit = -1 } })
  }
  onSlotsClosed(mut self) { self.slotsOpen = false }
  onBankSlotsClosed(mut self) { self.bankSlotsOpen = false }

  // A window of bag slots opens beside its window, level with its top, at the size it was left at: the bags' at the
  // bags' window's right, the bank's at the bank's window's left.
  placeSlots(mut self, open: Boolean, slots: mut KeptWindow, beside: KeptWindow, right: Boolean) {
    if (!open) { return }
    const at = peek beside.placing
    const size = peek slots.memory.values
    const away = at.width / 2 + Ordaen.lengthOf(BESIDE) + size.width / 2
    slots.memory.write({ x: right ? at.x + away : at.x - away, y: at.y - at.height / 2 + size.height / 2, ..size })
  }

  // The bags' window's close shuts the game's bags, and leaves the bank and the guild bank, which hides it.
  onClose(mut self) {
    Game.bags.close()
    self.onVaultClose()
  }

  // The vault's window's close leaves the bank or the guild bank.
  onVaultClose(mut self) {
    if (peek self.bankOpen) { Client.C_Bank.CloseBankFrame() }
    self.guild.close()
  }

  onSettings(self) { Ordaen.toggleSettings(Runtime.Addon.of(self)) }

  // An item or a currency taken from the loot window is a line; the money is the purse's gain.
  onLooted(mut self, slot: Game.LootSlot) {
    if (peek self.toastsShown && slot.kind != .Money) { self.lootLines.post(slot) }
  }

  onLootOpened(mut self, auto: Boolean) { self.lootMoney = peek Game.money.amount }
  onLootClosed(mut self) { self.lootMoney = nil }

  onMoney(mut self, copper: Integer) {
    const was = self.lootMoney
    if (was == nil) { return }
    self.lootMoney = copper
    if (copper > was && peek self.toastsShown) { self.lootLines.postCoins(copper - was) }
  }

  public render(self): Template {
    return $ltml {
      <frame $for={window of self.gameFrames} of={window} opacity={0} away={true} />
      <LootToasts $if={self.toastsShown} lines={mut self.lootLines} />
      <$if={self.ever}>
        <Window tabs={self.windowTabs} selected={mut self.windowTab} declared={mut self.window} shown={self.shown}
                minWidth={self.main.leastWidth} padding={NO_ROOM} withSettings={true} footer={self.main.footer} @close={self.onClose} @settings={self.onSettings}>
          {self.main.body}
        </Window>
        <Window tabs={self.vaultTabs} selected={mut self.vaultTab} declared={mut self.vaultWindow} shown={self.atVault}
                minWidth={self.side.leastWidth} padding={NO_ROOM} footer={self.side.footer} @close={self.onVaultClose}>
          {self.side.body}
        </Window>
        <BagSlotsWindow $if={self.slotsOpen && self.shown && self.main.isBags} lines={self.bagLines} declared={mut self.slotsWindow}
                        @close={self.onSlotsClosed} @lit={self.onLit} @put={self.onPutBag}
                        @pick={self.onKeepBag} @lift={self.onLiftBag} />
        <BankSlotsWindow $if={self.bankSlotsOpen && self.bankOpen} bags={self.bankBags} declared={mut self.bankSlotsWindow}
                         @close={self.onBankSlotsClosed} />
        <Dialog $if={self.refunding != nil} width={DIALOG} title={Locale.REFUND}>
          <text value={self.refundText} />
          <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.onRefundCancel} />
          <PushButton #buttons label={Locale.REFUND} width={BUTTON} plate={ButtonPlate.Accent} @click={self.onRefund} />
        </Dialog>
        <Dialog $if={self.moving != nil} width={DIALOG} title={self.moneyTitle}>
          <MoneyField value={mut self.amount} />
          <PushButton #buttons label={Locale.CANCEL} width={BUTTON} @click={self.onMoneyCancel} />
          <PushButton #buttons label={self.moneyTitle} width={BUTTON} plate={ButtonPlate.Accent} @click={self.onMoneyMove} />
        </Dialog>
      </>
    }
  }
}

// What the merchant gives back for a purchase still refundable (bought for items, currencies or more money than it sells
// for, within the game's time); none for anything else.
function refundOf(slot: Slot): Client.ItemPurchaseInfo | nil {
  const info = Client.C_Container.GetContainerItemPurchaseInfo(slot.bag, slot.index, false)
  if (info == nil || info.refundSeconds <= 0) { return nil }
  if (info.money <= 0 && info.itemCount <= 0 && info.currencyCount <= 0) { return nil }
  return info
}
