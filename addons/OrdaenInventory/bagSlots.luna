// The bag slots: a small window of their own beside the bags, opened by the header's bag button. Each bag with its
// icon, its name and its fill («5/16»), the backpack first; the cursor on one shows its tooltip and lights its items in
// the bags' window, the rest faded; a click keeps it lit, as the game's bag button opens its bag, until clicked
// again. An empty place stands too, as «Empty bag slot». A bag let go on a line, or a click there while the cursor
// holds one, puts it on in that place; a worn bag's line dragged takes the bag off its place onto the cursor.
import Client from "$client"
import Game from "$game"
import { Align, Frame, Track } from "$ltml"
import { Component, KeptWindow, SECONDARY_TEXT, Window, WindowTabSpec } from "Ordaen"
import { NO_ROOM, ROW_ROOM, frameSides } from "@/layout"
import Locale from "@/locales"

const ROW: array<Track> = [37.5dp, { fr: 1 }, "max-content"]
const ICON = 37.5dp
const INK: Color = Color::hex("#e8dcc4")
const LABEL: Color = Color::hex("#a3977f")
const WELL: Color = Color::hex("#0d0a08")
const CLEAR: Color = Color::hex("#00000000")
const SHADE: Color = Color::hex("#00000059")
// The room the list takes inside the window: the window is that and its sides (the frame, its inset, its room).
const LIST = 260dp

// A bag as the window lists it: what the game says of it, and how many of its slots hold something.
public struct BagLine {
  const info: Game::BagInfo
  const used: integer
}

class BagEntry implements Component {
  public lit: Event<integer> = new Event()
  public put: Event<integer> = new Event()
  public pick: Event<integer> = new Event()
  public lift: Event<integer> = new Event()
  // The backpack is no place: it is never taken off, nor anything put on there.
  derived place: boolean = self.line.info.bag > 0
  derived name: string = self.line.info.slots > 0 ? self.line.info.name : Locale::EMPTY_BAG_PLACE
  state hovered = false
  derived fill: string = self.line.info.slots > 0 ? Locale::FILL.format(self.line.used, self.line.info.slots) : ""
  derived back: Color = self.hovered ? SHADE : CLEAR

  line: Signal<BagLine>
  constructor(line: Signal<BagLine>) { self.line = line }

  mut onEnter(frame: any Frame) {
    self.hovered = true
    const item = self.line.info.item
    if (item != nil) { Game::items.show(frame, item) }
    self.lit.emit(self.line.info.bag)
  }

  onDrop() {
    if (self.place) { self.put.emit(self.line.info.bag) }
  }

  onPress() {
    if (!Client::CursorHasItem()) {
      self.pick.emit(self.line.info.bag)
    } else if (self.place) {
      self.put.emit(self.line.info.bag)
    }
  }

  onDragStart() {
    if (self.place && self.line.info.slots > 0) { self.lift.emit(self.line.info.bag) }
  }

  mut onLeave() {
    self.hovered = false
    self.lit.emit(-1)
  }

  public render(): Template {
    return $ltml {
      <box columns={ROW} gap={3sp} yAlign={Align::Center} padding={ROW_ROOM} background={self.back} @pointerEnter={self.onEnter}
           @pointerLeave={self.onLeave} @drop={self.onDrop} @pointerPress={self.onPress} @dragStart={self.onDragStart}>
        <box width={ICON} height={ICON} background={WELL} icon={self.line.info.icon} />
        <text value={self.name} textColor={INK} />
        <text value={self.fill} textColor={LABEL} textFont={.Numbers} textSize={SECONDARY_TEXT} wrap={.None} />
      </box>
    }
  }
}

public class BagSlotsWindow implements Component {
  public close: Event<nil> = new Event()
  public lit: Event<integer> = new Event()
  // A bag let go on a place, by the place.
  public put: Event<integer> = new Event()
  // A line clicked with nothing held, and a worn bag's line dragged: by the place.
  public pick: Event<integer> = new Event()
  public lift: Event<integer> = new Event()
  state tab = 1
  derived tabs: array<WindowTabSpec> = [{ title: Locale::BAG_SLOTS }]

  lines: Signal<array<BagLine>>
  declared: mut KeptWindow
  constructor(lines: Signal<array<BagLine>>, declared: mut KeptWindow) {
    self.lines = lines
    self.declared = declared
  }

  onClose() { self.close.emit() }
  onLit(bag: integer) { self.lit.emit(bag) }
  onPut(bag: integer) { self.put.emit(bag) }
  onPick(bag: integer) { self.pick.emit(bag) }
  onLift(bag: integer) { self.lift.emit(bag) }

  public render(): Template {
    return $ltml {
      <Window tabs={self.tabs} selected={mut self.tab} declared={mut self.declared} minWidth={LIST + frameSides()} padding={NO_ROOM} @close={self.onClose}>
        <box columns={1} gap={3sp}>
          <BagEntry $for={line of self.lines} line={line} @lit={self.onLit} @put={self.onPut} @pick={self.onPick}
                    @lift={self.onLift} />
        </box>
      </Window>
    }
  }
}
