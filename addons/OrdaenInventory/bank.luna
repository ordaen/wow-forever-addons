// The character's bank in the bags' window: its containers are the tabs the client names
// (`C_Bank.FetchPurchasedBankTabData`), each a container by its `ID`, read and picked up as the bags are. The first is
// the bank itself; each further one holds a bank bag, which lies in the bank's bag slot of the same place
// (`Enum.BagIndex.Characterbanktab`). The bank's bag slots open as a small window of their own from the header: each
// bag with its name and fill (a click picks it up or puts the one on the cursor there), and the next slot to buy, with
// its price, which a confirmation buys.
import Client from "$client"
import Game from "$game"
import { Align, Frame, Track } from "$ltml"
import { ButtonPlate, Component, Dialog, KeptWindow, Money, PushButton, SECONDARY_TEXT, Window, WindowTabSpec } from "Ordaen"
import { NO_ROOM, frameSides } from "@/layout"
import Locale from "@/locales"

// The bank's bag slots, by their place among the bank's tabs (`Enum.BagIndex.Characterbanktab`).
const BAG_SLOTS = -2
const ROW: array<Track> = [37.5dp, { fr: 1 }, "max-content"]
const ICON = 37.5dp
const INK: Color = Color::hex("#e8dcc4")
const LABEL: Color = Color::hex("#a3977f")
const WELL: Color = Color::hex("#0d0a08")
const CLEAR: Color = Color::hex("#00000000")
const SHADE: Color = Color::hex("#00000059")
const RED: Color = Color::hex("#ff4040")
// The room the list takes inside the window: the window is that and its sides (the frame, its inset, its room).
const LIST = 260dp
const DIALOG = 375dp
const BUTTON = 117.1875dp

// The bank's containers as the bags' window reads them: a tab with no name of its own is named by its place.
public function bankInfos(): array<Game::BagInfo> {
  let infos: array<Game::BagInfo> = []
  for (index, tab of Client::C_Bank::FetchPurchasedBankTabData(Client::BankType::Character)) {
    const bag = tab.ID.floor()
    const name = tab.name != "" ? tab.name : index == 1 ? Locale::BANK : Locale::BANK_BAG.format(index - 1)
    infos.push({ bag: bag, item: nil, name: name, icon: tab.icon, slots: Game::bags.size(bag), general: true })
  }
  return infos
}

// A bank bag's line: its icon, name and fill; a click picks the bag up, or puts the one on the cursor there.
public struct BankBag {
  const place: integer
  const info: Game::BagInfo
  const used: integer
}

class BankBagEntry implements Component {
  state hovered = false
  derived fill: string = Locale::FILL.format(self.bag.used, self.bag.info.slots)
  derived back: Color = self.hovered ? SHADE : CLEAR

  bag: Signal<BankBag>
  constructor(bag: Signal<BankBag>) { self.bag = bag }

  onEnter(mut self, frame: any Frame) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }
  onPress(self) { Game::bags.pickup(BAG_SLOTS, self.bag.place) }

  public render(self): Template {
    return $ltml {
      <box columns={ROW} gap={3sp} yAlign={Align::Center} background={self.back} @pointerEnter={self.onEnter}
           @pointerLeave={self.onLeave} @pointerPress={self.onPress}>
        <box width={ICON} height={ICON} background={WELL} icon={self.bag.info.icon} />
        <text value={self.bag.info.name} textColor={INK} />
        <text value={self.fill} textColor={LABEL} textFont={.Numbers} textSize={SECONDARY_TEXT} wrap={.None} />
      </box>
    }
  }
}

// The bank's bag slots: the bags in them, and the next slot to buy while the client sells one.
public class BankSlotsWindow implements Component {
  public close: Event<nil> = new Event()
  state tab = 1
  state asking = false
  derived tabs: array<WindowTabSpec> = [{ title: Locale::BANK_SLOTS, desc: nil, icon: BANK_ICON }]
  // What the next slot costs and whether the player can pay it, read as the window shows and when the money changes.
  derived next: Client::PurchasableBankTabData | nil = self.nextOf()
  derived buyable: boolean = self.next != nil && Client::C_Bank::CanPurchaseBankTab(Client::BankType::Character)
  derived cost: integer = (self.next?.tabCost ?? 0).floor()
  derived afford: boolean = self.next?.canAfford == true
  derived costColor: Color = self.afford ? INK : RED

  bags: Signal<array<BankBag>>
  declared: mut KeptWindow
  constructor(bags: Signal<array<BankBag>>, declared: mut KeptWindow) {
    self.bags = bags
    self.declared = declared
  }

  nextOf(self): Client::PurchasableBankTabData | nil {
    _ = Game::money.amount
    _ = self.bags
    return Client::C_Bank::FetchNextPurchasableBankTabData(Client::BankType::Character)
  }

  onClose(self) { self.close.emit() }
  onBuy(mut self) { self.asking = true }
  onNo(mut self) { self.asking = false }

  // The client's own purchase, in the player's click on «Yes».
  onYes(mut self) {
    self.asking = false
    Client::C_Bank::PurchaseBankTab(Client::BankType::Character)
  }

  public render(self): Template {
    return $ltml {
      <Window tabs={self.tabs} selected={mut self.tab} declared={mut self.declared} minWidth={LIST + frameSides()} padding={NO_ROOM} @close={self.onClose}>
        <box columns={1} gap={3sp}>
          <BankBagEntry $for={bag of self.bags} bag={bag} />
          <box $if={self.buyable} columns={ROW} gap={3sp} yAlign={Align::Center}>
            <box width={ICON} height={ICON} background={WELL} />
            <Money amount={self.cost} color={self.costColor} />
            <PushButton label={Locale::BANK_BUY} width={BUTTON} disabled={!self.afford} @click={self.onBuy} />
          </box>
        </box>
      </Window>
      <Dialog $if={self.asking} width={DIALOG} title={Locale::BANK_BUY}>
        <Money amount={self.cost} />
        <PushButton #buttons label={Locale::NO} width={BUTTON} @click={self.onNo} />
        <PushButton #buttons label={Locale::YES} width={BUTTON} plate={ButtonPlate::Accent} @click={self.onYes} />
      </Dialog>
    }
  }
}

// The bank's own icon of the game's (its side tab).
public const BANK_ICON: Asset = "Interface/ICONS/INV_SideTab_Bank_c60"
