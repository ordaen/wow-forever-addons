// How the window's sections are laid out: each a card (its caption, its slots in rows of as many as the card is wide),
// cards side by side in their fixed order while they fit the list's width, each line of them as high as its tallest
// card. A line's height is worked out here, so the list can be as high as what it holds and no item is hidden under a
// scroll the window was sized to.
import { Edges, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { WINDOW_ROOM, windowSides } from "Ordaen"
import { Slot } from "@/model"

// A window's page runs to the frame's line on every side and down to its footer (`padding` none): its list takes the
// whole section. What stands over the list (the toolbar) keeps the window's room at the top and the sides.
public const NO_ROOM: Edges = {}
// The window's room at a page's sides, kept by what stands beside a list of tabs: the toolbar and the items alike.
public const PAGE_SIDE: number<Spacing> = 8sp
public const SIDE_ROOM: Edges = { right: PAGE_SIDE, left: PAGE_SIDE }
public const TOP_ROOM: Edges = { top: 8sp }
public const TOOL_ROOM: Edges = { top: 8sp, right: PAGE_SIDE, left: PAGE_SIDE }
// A line of a list: its text kept off the frame.
public const ROW_ROOM: Edges = { top: 1sp, right: 8sp, bottom: 1sp, left: 8sp }

// What a window takes of its width round a page with no room of its own: the frame's line and the art past it.
public function frameSides(): number<Length> {
  return windowSides() - Ordaen.lengthOf(2 * WINDOW_ROOM)
}

// A slot's size is the player's choice (`Choices.slotSize`, in the interface's pixels: `SLOT_PIXEL` each), this where
// none is made, from `SLOT_SIZE_LEAST` to `SLOT_SIZE_MOST`. Inside a card, round what it holds; between two cards.
// Between two slots of a card is the player's choice (`Choices.slotGap`, in steps of the spacing), this where none is
// made; at most `SLOT_GAP_MOST`. A card's row holds at least the player's choice of slots (`Choices.rowLeast`), this
// where none is made, from `ROW_LEAST` (a caption fits) to `ROW_LEAST_MOST`: what a group is at least as wide as, and
// the window too.
public const SLOT_SIZE = 50
public const SLOT_SIZE_LEAST = 30
public const SLOT_SIZE_MOST = 64
const SLOT_PIXEL: number<Length> = 1.171875dp
public const CARD_PAD: number<Spacing> = 2sp
public const CARD_GAP: number<Spacing> = 3sp
public const SLOT_GAP = 3
public const SLOT_GAP_MOST = 10
public const ROW_LEAST = 4
public const ROW_LEAST_MOST = 12

// A slot's size and the rooms of the cards as lengths, as the density has them now, and the fewest slots in a card's
// row: what the cards' widths and heights are worked out with.
public struct CardRoom {
  public least: integer
  public slot: number<Length>
  public gap: number<Length>
  public pad: number<Length>
  public between: number<Length>
}

// The slots' size and the cards' rooms at the density the player chose, the slots' size and gap, and the fewest slots
// in a row; read in a `derived`, it follows them.
public function cardRoom(slotGap: number, slotSize: number, rowLeast: number): CardRoom {
  return {
    least: rowLeast.floor(), slot: slotSize * SLOT_PIXEL, gap: Ordaen.lengthOf(slotGap * 1sp), pad: Ordaen.lengthOf(CARD_PAD),
    between: Ordaen.lengthOf(CARD_GAP)
  }
}
// A caption's height, which the cards' heights are worked out with (the list is as high as they are, up to the
// screen's): the caption takes its text's height, which at the body's text size (14) is its font's line, this.
public const CAPTION_HIGH: number<Length> = 23.625dp

// A section: its caption (none where it has none: the one-bag view, a tab grouped in one), the bag it is (-1 for none),
// its slots in their order; the «Free» section, one slot with the free count.
public struct Section {
  public key: string
  public title: string
  public bag: integer
  public slots: array<Slot>
  public free: boolean
}

// A section as a card: how many slots wide it is.
public struct Card {
  public section: Section
  public span: integer
}

// A line of cards side by side: each card's width, and the line's height (its tallest card's).
public struct CardRow {
  public cards: array<Card>
  public tracks: array<Track>
  public height: number<Length>
}

// How many slots a row of a card as wide as `width` holds.
public function spanIn(width: number<Length>, room: CardRoom): integer {
  return ((width - 2 * room.pad + room.gap) / (room.slot + room.gap)).floor().max(1)
}

// How wide a card of `span` slots is, its padding with it.
public function cardWidth(span: integer, room: CardRoom): number<Length> {
  return span * room.slot + (span - 1) * room.gap + 2 * room.pad
}

// A card with a caption (a group) is at least the fewest slots in a row wide, however few it holds.
function spanOf(section: Section, most: integer, room: CardRoom): integer {
  const count = section.free ? 1 : section.slots.length
  const least = section.title != "" ? room.least : 1
  return count.max(least).min(most)
}

// How high a card is: its caption, and its rows of slots.
function cardHeight(section: Section, span: integer, room: CardRoom): number<Length> {
  let high = 2 * room.pad
  if (section.title != "") { high += CAPTION_HIGH + room.gap }
  const count = section.free ? 1 : section.slots.length
  const rows = ((count + span - 1) / span).floor().max(1)
  return high + rows * room.slot + (rows - 1) * room.gap
}

// The lines of `sections` in a list `width` wide.
public function linesOf(sections: array<Section>, width: number<Length>, room: CardRoom): array<CardRow> {
  let lines: array<CardRow> = mut []
  let cards: array<Card> = mut []
  let tracks: array<Track> = mut []
  let high: number<Length> = 0ui
  let used: number<Length> = 0ui
  const most = spanIn(width, room)
  for (section of sections) {
    const span = spanOf(section, most, room)
    const wide = cardWidth(span, room)
    if (cards.length > 0 && used + room.between + wide > width) {
      lines.push({ cards: cards, tracks: tracks, height: high })
      cards = mut []
      tracks = mut []
      high = 0ui
      used = 0ui
    }
    used = cards.length == 0 ? wide : used + room.between + wide
    cards.push({ section: section, span: span })
    tracks.push(wide)
    high = high.max(cardHeight(section, span, room))
  }
  if (cards.length > 0) { lines.push({ cards: cards, tracks: tracks, height: high }) }
  return lines
}

// How high the lines are together, the room between them with them.
public function heightOf(lines: array<CardRow>, room: CardRoom): number<Length> {
  let high: number<Length> = 0ui
  for (index, line of lines) { high += index > 1 ? room.between + line.height : line.height }
  return high
}
