// The sections each view shows, and the order of the items in them: by type in a tab, a section per bag, or every slot
// in one grid. Worked out again only when what lies in the bags changes where they are, or when a choice of the window's
// does; a count or a lock changing is drawn by its slot alone.
import Runtime from "$runtime"
import { kindName } from "Ordaen"
import { Section } from "@/layout"
import Locale from "@/locales"
import { Grouping, Slot, SortBy, Tab, rankOf } from "@/model"

// A tab's name: a kind's is Ordaen's (`kindName`).
public function tabName(tab: Tab): string {
  return match (tab) {
    .All => Locale::TAB_ALL
    .New => Locale::TAB_NEW
    .Quest => kindName(.Quest)
    .Consumables => kindName(.Consumables)
    .Equipment => kindName(.Equipment)
    .Trade => kindName(.Trade)
    .Recipes => kindName(.Recipes)
    .Keys => kindName(.Keys)
    .Other => kindName(.Other)
    .Junk => Locale::TAB_JUNK
  }
}

// Whether `a` comes before `b` in the sort's order: each sort's own first, then the name, then the place in the bags,
// so no two items are ever equal and the order holds from one update to the next.
public function before(a: Slot, b: Slot, by: SortBy): boolean {
  const x = a.read
  const y = b.read
  if (by == .Quality && x.quality != y.quality) { return x.quality > y.quality }
  if (by == .Level && x.level != y.level) { return x.level > y.level }
  if (by == .Count && x.count != y.count) { return x.count > y.count }
  if (by == .Type && x.kind != y.kind) { return x.kind < y.kind }
  if (by == .Type && x.subkind != y.subkind) { return x.subkind < y.subkind }
  if (by != .Bags && x.name != y.name) { return x.name < y.name }
  if (a.bag != b.bag) { return a.bag < b.bag }
  return a.index < b.index
}

// Whether the slot's item is in the tab.
public function inTab(slot: Slot, tab: Tab): boolean {
  if (peek slot.id == 0) { return false }
  return match (tab) {
    .All => true
    .New => peek slot.isNew
    else => slot.tab == tab
  }
}

// How a tab's items split into sections: all in one (the new items always), by category (the All tab grouped by
// type: a section per tab), by subclass (another tab grouped by type), or by where they are worn.
enum Split { One, Category, Subclass, Worn }

function splitOf(tab: Tab, grouping: Grouping): Split {
  if (tab == .New) { return .One }
  return match (grouping) {
    .None => .One
    .Type => tab == .All ? Split::Category : Split::Subclass
    .Worn => .Worn
  }
}

// The client's miscellaneous class (`Enum.ItemClass.Miscellaneous`) and its first subclass, which the client names
// «Junk» though its items aren't (a hearthstone): captioned by its tab, so only the junk tab says junk.
const MISC = 15
const MISC_JUNK = 0

// One section of a tab: its items, its caption, and where it stands among the others.
struct Group {
  key: string
  title: string
  rank: integer
  subkind: integer
  slots: mut array<Slot>
}

// The categories view's sections for a tab: split as its setting says, each sorted, in the kinds' fixed order whatever
// the sort; no section without items; then «Free».
public function tabSections(slots: array<Slot>, tab: Tab, grouping: Grouping, by: SortBy): array<Section> {
  let groups: array<mut Group> = mut []
  let found: map<string, mut Group> = mut {}
  const split = splitOf(tab, grouping)
  for (slot of slots) {
    if (inTab(slot, tab)) {
      const key = keyOf(slot, split)
      const group = found[key]
      if (group != nil) {
        group.slots.push(slot)
      } else {
        const made: Group = mut {
          key: key, title: titleOf(slot, split), rank: rankOf(slot.tab),
          subkind: split == .Subclass ? slot.read.subkind : 0, slots: [slot]
        }
        found[key] = made
        groups.push(made)
      }
    }
  }
  groups.sort((a: Group, b: Group): boolean => groupBefore(a, b))
  let sections: array<Section> = mut []
  for (group of groups) {
    group.slots.sort((a: Slot, b: Slot): boolean => before(a, b, by))
    sections.push({ key: group.key, title: group.title, bag: -1, slots: group.slots, free: false })
  }
  sections.push({ key: "free", title: Locale::FREE, bag: -1, slots: [], free: true })
  return sections
}

function groupBefore(a: Group, b: Group): boolean {
  if (a.rank != b.rank) { return a.rank < b.rank }
  if (a.subkind != b.subkind) { return a.subkind < b.subkind }
  return a.key < b.key
}

function keyOf(slot: Slot, split: Split): string {
  return match (split) {
    .One => "all"
    .Category => `${slot.tab}`
    .Subclass => `${slot.tab}/${slot.read.subkind}`
    .Worn => `worn/${slot.read.worn}`
  }
}

// A section's caption: none for all in one; the tab's name for a category; the subclass's name as the game says it;
// where an item is worn as the game names it (`INVTYPE_HEAD`), what isn't worn under its tab's name.
function titleOf(slot: Slot, split: Split): string {
  return match (split) {
    .One => ""
    .Category => tabName(slot.tab)
    .Subclass => subclassName(slot)
    .Worn => slot.read.worn != "" ? Runtime::text(slot.read.worn) ?? slot.read.worn : tabName(slot.tab)
  }
}

function subclassName(slot: Slot): string {
  const read = slot.read
  if (read.subkindName == "" || read.kind == MISC && read.subkind == MISC_JUNK) { return tabName(slot.tab) }
  return read.subkindName
}

// A section for each bag, in the bags' order, every slot of it with the empty ones, its name for a caption.
public function bagSections(bags: array<array<Slot>>, names: array<string>): array<Section> {
  let sections: array<Section> = mut []
  for (index, slots of bags) {
    if (slots.length > 0) {
      sections.push({ key: `bag/${index}`, title: names[index] ?? "", bag: index - 1, slots: slots, free: false })
    }
  }
  return sections
}

// Every slot in one grid, in the bags' order, the empty ones too.
public function oneSection(bags: array<array<Slot>>): array<Section> {
  let slots: array<Slot> = mut []
  for (bag of bags) {
    for (slot of bag) { slots.push(slot) }
  }
  return [{ key: "one", title: "", bag: -1, slots: slots, free: false }]
}

// How many items each tab has: a tab with none isn't in the map.
public function countsOf(slots: array<Slot>): map<Tab, integer> {
  let counts: map<Tab, integer> = mut {}
  for (slot of slots) {
    if (peek slot.id != 0) {
      counts[Tab::All] = (counts[Tab::All] ?? 0) + 1
      counts[slot.tab] = (counts[slot.tab] ?? 0) + 1
      if (peek slot.isNew) { counts[Tab::New] = (counts[Tab::New] ?? 0) + 1 }
    }
  }
  return counts
}
