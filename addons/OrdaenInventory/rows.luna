// The window's list: its lines of cards, each card a section's caption and slots. A slot is the library's item slot:
// its item, its count, its quality's rim; dimmed where the search or the place leaves it out or another bag is lit; a
// new item's glow inside it until it is hovered; a lock on a protected one; a coin on a junk one; its menu under it
// while open. A container's slot has the client's own use of the item on the scheme's chord for Use (secure) while its
// vault is open, as the button comes up; every other click and the cursor's coming and going are told to the window
// through the shelf.
import Game from "$game"
import { Action, Align, Cursor, Event, MouseButton, Position, Shadow, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { Component, ItemButton, Menu, MenuEntry, Quality, SECONDARY_TEXT, SlotWell, usableItem } from "Ordaen"
import { UseClick } from "@/clicks"
import { CARD_GAP, CARD_PAD, Card, CardRow, Section } from "@/layout"
import { CONTAINER, Slot, handsOver } from "@/model"
import { SlotMenu } from "@/slotMenu"
import { Vault } from "@/vault"

const CAPTION: Color = Color::hex("#e8c35a")
const LABEL: Color = Color::hex("#a3977f")
const NEW_GLOW: Color = Color::hex("#ffd65a")
const SHADOW: Shadow = { color: Color::hex("#000000"), x: 1.171875dp, y: -1.171875dp }
const LOCK = 16.40625dp
const COIN = 14.0625dp
// A caption: its name in what the fill leaves (cut where it is longer, as in Russian), the fill at the end.
const CAPTION_TRACKS: array<Track> = [{ fr: 1 }, "max-content"]
// The client's padlock, small, over a protected slot's top left corner.
const PADLOCK: Atlas = "QuestSharing-Padlock"
// The client's gold coin, a disc with its dark rim, over a junk slot's top right corner.
const COIN_ART: Asset = "Interface/MoneyFrame/UI-GoldIcon"
const NO_ENTRIES: array<MenuEntry> = []
// The classes of items crafting takes (`Enum.ItemClass`: trade goods, reagents).
const TRADE = 7
const REAGENT = 5
const QUEST = 12
// The game's marks over a quest's item: its border, and the «!» of one that starts a quest not yet taken
// (`TEXTURE_ITEM_QUEST_BORDER`, `TEXTURE_ITEM_QUEST_BANG`).
const QUEST_BORDER: Asset = "Interface/ContainerFrame/UI-Icon-QuestBorder"
const QUEST_BANG: Asset = "Interface/ContainerFrame/UI-Icon-QuestBang"
// The game's letter, over a slot whose item is put into the letter being written, in its middle.
// The game's green arrow over gear worth more to the player's spec than what it wears, in the slot's bottom left.
const UPGRADE_ART: Atlas = "bags-greenarrow"
const UPGRADE = 16.40625dp
// The client's classes of gear (`Enum.ItemClass`): weapons and armour.
const WEAPON = 2
const ARMOR = 4

// What leaves a slot dimmed: the search's text (lower case), where the player stands, and the bag lit in the bag
// slots' window (-1 for none).
public struct Filter {
  const query: string
  const place: Game::BagPlace
  const lit: integer
}

// What every row, place and slot of the grid reads of the window, and the events they tell it: one object, made by the
// window and handed down.
public class Shelf {
  public pressed: Event<(Slot, Event::Press)> = new Event()
  // A slot's item dragged off it, or something dragged let go on it: what a plain pick up does, as the game's own
  // slots take a drag.
  public pickup: Event<Slot> = new Event()
  public entered: Event<Slot> = new Event()
  public left: Event<Slot> = new Event()
  // A line of the open menu clicked (its place), or a click outside it.
  public picked: Event<integer> = new Event()
  public closed: Event<nil> = new Event()

  public filter: Signal<Filter>
  public free: Signal<integer>
  // A slot's size, and the room between two slots of a card, as the player chose them.
  public slot: Signal<number<Length>>
  public gap: Signal<number<Spacing>>
  public fills: Signal<map<integer, string>>
  public menu: Signal<SlotMenu | nil>
  // How a container's slot is used (the client's secure click).
  public useClick: Signal<UseClick>
  // Whether the slots' vault is open: shut (the bank away from a banker), they are its copy, shown and not used.
  public live: Signal<boolean>
  constructor(
    filter: Signal<Filter>,
    free: Signal<integer>,
    slot: Signal<number<Length>>,
    gap: Signal<number<Spacing>>,
    fills: Signal<map<integer, string>>,
    menu: Signal<SlotMenu | nil>,
    useClick: Signal<UseClick>,
    live: Signal<boolean>
  ) {
    self.filter = filter
    self.free = free
    self.slot = slot
    self.gap = gap
    self.fills = fills
    self.menu = menu
    self.useClick = useClick
    self.live = live
  }
}

// Whether the place keeps the slot's item lit: at the auction house and the mailbox what isn't bound (nor a quest's,
// which the mail takes neither), at crafting the reagents, at a merchant what isn't a quest's.
function fits(slot: Slot, place: Game::BagPlace): boolean {
  return match (place) {
    .AuctionHouse => !slot.read.bound
    .Mail => !slot.read.bound && slot.read.kind != QUEST
    .Crafting => slot.read.kind == TRADE || slot.read.kind == REAGENT
    .Merchant => slot.read.kind != QUEST
    else => true
  }
}

class BagSlot implements Component {
  derived item: integer | nil = self.slot.id == 0 ? nil : self.slot.id
  derived dimmed: boolean = self.dimmedOf()
  derived count: integer = self.slot.count
  derived quality: Quality = self.slot.quality
  // At a merchant, the client's coin bag: red over what he gives nothing for.
  // Its place in the player's bags or bank while that is open: its tooltip that very item's (bound or not).
  derived place: [integer, integer] | nil = self.slot.vault == Vault::Guild || !self.shelf.live ? nil : [self.slot.bag, self.slot.index]
  derived cursor: Cursor | nil = self.slot.id == 0 || !self.shelf.live || self.shelf.filter.place != Game::BagPlace::Merchant ? nil :
    self.slot.read.price > 0 ? Cursor::Buy : Cursor::BuyError
  derived coin: boolean = self.slot.junk && self.slot.id != 0
  // Gear the player can use, worth more to its spec than what it wears (Ordaen's worth).
  derived upgrade: boolean = self.upgradeNow()
  derived questMark: Asset | nil = self.slot.startsQuest ? QUEST_BANG : self.slot.questItem ? QUEST_BORDER : nil
  // A container's item is used by the client's secure click, on the scheme's chord for Use; a guild bank's has none,
  // nor a copy of a vault that isn't open, nor any slot while Use hands the item over (sold to a merchant, put in a
  // trade or a letter): the client's secure use equips what can be worn (`SecureTemplates.lua`), so the bags hand it
  // over themselves. A bag's use is the bags' own too: the client's puts it on only where a place is empty. While a
  // spell waits for an item to land on (an enchant, a sharpening stone, lockpicking), the left click gives it this
  // one, as the game's bags do, whatever the scheme says.
  derived action: Action | nil = self.slot.vault == Vault::Guild || !self.shelf.live ? nil :
    Game::player.targeting ? Action.UseBagItem { bag: self.slot.bag, slot: self.slot.index, chord: MouseButton::Left } :
    handsOver(self.shelf.filter.place) || self.slot.read.kind == CONTAINER ? nil :
    Action.UseBagItem { bag: self.slot.bag, slot: self.slot.index, chord: self.shelf.useClick.chord }
  derived menuShown: boolean = self.shelf.menu?.slot == self.slot
  derived menuEntries: array<MenuEntry> = self.shelf.menu?.entries ?? NO_ENTRIES
  derived menuTitle: string = self.shelf.menu?.title ?? ""

  slot: Signal<Slot>
  const shelf: Shelf
  constructor(slot: Signal<Slot>, shelf: Shelf) {
    self.slot = slot
    self.shelf = shelf
  }

  upgradeNow(): boolean {
    const slot = self.slot
    if (slot.id == 0 || (slot.read.kind != WEAPON && slot.read.kind != ARMOR) || !usableItem(slot.id)) { return false }
    return (Ordaen.worth.upgradeOf(slot.read.link) ?? 0) > 0
  }

  dimmedOf(): boolean {
    const slot = self.slot
    const filter = self.shelf.filter
    if (filter.lit >= 0 && slot.bag != filter.lit) { return true }
    // On the cursor, or held by the client (a letter, a trade): dimmed until it is let go.
    if (slot.id == 0 || slot.locked) { return slot.locked }
    if (filter.query != "" && !slot.lower.contains(filter.query)) { return true }
    return !fits(slot, filter.place)
  }

  onPressed(click: Event::Press) { self.shelf.pressed.emit(self.slot, click) }

  onPickup() { self.shelf.pickup.emit(self.slot) }
  onEnter() { self.shelf.entered.emit(self.slot) }
  onLeave() { self.shelf.left.emit(self.slot) }
  onPicked(index: integer) { self.shelf.picked.emit(index) }
  onClosed() { self.shelf.closed.emit() }

  public render(): Template {
    return $ltml {
      <ItemButton item={self.item} count={self.count} quality={self.quality} dimmed={self.dimmed} size={self.shelf.slot} well={SlotWell::Crested}
                  action={self.action} linkOnShift={false} cursor={self.cursor} bag={self.place} @pressed={self.onPressed} @dragged={self.onPickup}
                  @dropped={self.onPickup} @entered={self.onEnter} @left={self.onLeave}>
        <box $if={self.questMark != nil} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             background={self.questMark} zLevel={1} />
        <box $if={self.slot.isNew} position={Position::Absolute} left={0ui} top={0ui} right={0ui} bottom={0ui}
             background={Ordaen.art.ctl.qualityRim} tint={NEW_GLOW} zLevel={2} />
        <box $if={self.slot.guarded} position={Position::Absolute} left={2.34375dp} top={2.34375dp} width={LOCK} height={LOCK}
             background={PADLOCK} zLevel={3} />
        <box $if={self.upgrade} position={Position::Absolute} left={2.34375dp} bottom={2.34375dp} width={UPGRADE}
             height={UPGRADE} background={UPGRADE_ART} zLevel={3} />
        <box $if={self.coin} position={Position::Absolute} right={2.34375dp} top={2.34375dp} width={COIN} height={COIN}
             background={COIN_ART} zLevel={3} />
        <Menu $if={self.menuShown} entries={self.menuEntries} title={self.menuTitle} @pick={self.onPicked}
              @close={self.onClosed} />
      </ItemButton>
    }
  }
}

// A section's caption: its name, a bag's fill after it. «Free»'s name is plain.
class Caption implements Component {
  derived fill: string = self.section.bag >= 0 ? self.shelf.fills[self.section.bag] ?? "" : ""
  derived titleColor: Color = self.section.free ? LABEL : CAPTION

  section: Signal<Section>
  const shelf: Shelf
  constructor(section: Signal<Section>, shelf: Shelf) {
    self.section = section
    self.shelf = shelf
  }

  public render(): Template {
    return $ltml {
      <box columns={CAPTION_TRACKS} gap={3sp} leading={.Tight} yAlign={Align::Center}>
        <text value={self.section.title} textColor={self.titleColor} textShadow={SHADOW} wrap={.Cut} />
        <text value={self.fill} textColor={LABEL} textSize={SECONDARY_TEXT} textFont={.Numbers} wrap={.None} />
      </box>
    }
  }
}

// A section as a card: a darker ground, its caption, its slots in rows as wide as the card.
class SectionCard implements Component {
  derived titled: boolean = self.card.section.title != ""
  derived free: boolean = self.card.section.free
  derived span: integer = self.card.span
  derived slots: array<Slot> = self.card.section.slots
  derived section: Section = self.card.section

  card: Signal<Card>
  const shelf: Shelf
  constructor(card: Signal<Card>, shelf: Shelf) {
    self.card = card
    self.shelf = shelf
  }

  public render(): Template {
    return $ltml {
      <box columns={1} gap={self.shelf.gap} padding={CARD_PAD}>
        <Caption $if={self.titled} section={self.section} shelf={self.shelf} />
        <box columns={self.span} gap={self.shelf.gap}>
          <ItemButton $if={self.free} item={nil} count={self.shelf.free} size={self.shelf.slot} well={SlotWell::Crested} />
          <BagSlot $for={slot of self.slots} $key={slot} slot={slot} shelf={self.shelf} />
        </box>
      </box>
    }
  }
}

// A line of cards side by side, each as high as itself.
public class CardLine implements Component {
  derived tracks: array<Track> = self.line.tracks
  derived cards: array<Card> = self.line.cards

  line: Signal<CardRow>
  const shelf: Shelf
  constructor(line: Signal<CardRow>, shelf: Shelf) {
    self.line = line
    self.shelf = shelf
  }

  public render(): Template {
    return $ltml {
      <box columns={self.tracks} gap={CARD_GAP} yAlign={Align::Start}>
        <SectionCard $for={card of self.cards} $key={card.section.key} card={card} shelf={self.shelf} />
      </box>
    }
  }
}
