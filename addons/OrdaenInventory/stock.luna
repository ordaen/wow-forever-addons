// The slots of one vault as the window keeps them: a list for each container in the vault's order (the backpack and
// the bags; the bank's tabs; the guild bank's tabs), all of them in that order, each container's fill and the free
// slots. Its `revision` moves when what lies where changed: what the sections are worked out again for.
import Client from "$client"
import Game from "$game"
import { JunkLists, JunkRules } from "@/junk"
import Locale from "@/locales"
import { COUNTED, JUDGED, MARKED, MOVED, Slot } from "@/model"
import { Vault } from "@/vault"

public class Stock {
  public const vault: Vault
  // Every slot, a list for each container, and all of them in order: made again only when a container's size changes.
  public bags: mut Array<mut Array<mut Slot>> = []
  public all: mut Array<mut Slot> = []
  public state revision = 0
  public state infos: Array<Game.BagInfo> = []
  public state fills: Map<Integer, String> = {}
  // How many items each container held at the last count: its fill's text is made again when this changes.
  used: mut Array<Integer> = []
  public state free = 0
  public state total = 0
  // The slots that took another item in the last update: a protection follows its item there.
  public arrived: mut Array<Slot> = []

  constructor(vault: Vault) { self.vault = vault }

  // Every container read: one whose size changed, or another container in its place (the guild bank's tab), gets its
  // slots made again. What changed, each a bit.
  public read(mut self, infos: Array<Game.BagInfo>, lists: JunkLists, rules: JunkRules): Integer {
    let sized = infos.length != self.bags.length
    for (index, info of infos) {
      const had = self.bags[index]
      if (had == nil || had.length != info.slots || (had[1]?.bag ?? info.bag) != info.bag) { sized = true }
    }
    if (sized) {
      let bags: Array<mut Array<mut Slot>> = []
      let all: Array<mut Slot> = []
      for (info of infos) {
        let slots: Array<mut Slot> = []
        for (index of 1..info.slots) {
          const slot = new Slot(self.vault, info.bag, index)
          slots.push(slot)
          all.push(slot)
        }
        bags.push(slots)
      }
      self.bags = bags
      self.all = all
      // A fill says the slots too: each is made again.
      self.used.clear()
    }
    self.infos = infos
    let changed = sized ? MOVED : 0
    self.arrived.clear()
    for (slot of self.all) { changed = Client.bit.bor(changed, self.refreshSlot(slot, lists, rules)) }
    self.count()
    return changed
  }

  // One container read again, by its place: nil where its size isn't the one kept (then every one is read).
  public update(mut self, place: Integer, size: Integer, lists: JunkLists, rules: JunkRules): Integer | nil {
    const slots = self.bags[place]
    if (slots == nil || slots.length != size) { return nil }
    self.arrived.clear()
    let changed = 0
    for (slot of slots) { changed = Client.bit.bor(changed, self.refreshSlot(slot, lists, rules)) }
    self.count()
    return changed
  }

  // The verdict on every item worked out again: a mark, a score or a rule changed.
  public judge(mut self, lists: JunkLists, rules: JunkRules): Integer {
    let changed = 0
    for (slot of self.all) { changed = Client.bit.bor(changed, slot.judge(lists, rules)) }
    return changed
  }

  // The sections are worked out again where an update changed where items lie, what is new or what is junk, or a count
  // where the sort is by count.
  public regroup(mut self, changed: Integer, byCount: Boolean) {
    const regroup = Client.bit.band(changed, MOVED + MARKED + JUDGED) != 0 ||
      (Client.bit.band(changed, COUNTED) != 0 && byCount)
    if (regroup) { self.revision += 1 }
  }

  // A container's place among the kept ones (1 on), by its number; none for one not kept.
  public placeOf(self, bag: Integer): Integer | nil {
    for (index, info of self.infos) {
      if (info.bag == bag) { return index }
    }
    return nil
  }

  // Whether a container takes any item, by its number; false for one not kept.
  public general(self, bag: Integer): Boolean {
    const place = self.placeOf(bag)
    return place != nil && self.infos[place]?.general == true
  }

  // The slot at a container's number and its slot, where it is kept.
  public slotAt(self, bag: Integer, index: Integer): Slot | nil {
    for (slots of self.bags) {
      const first = slots[1]
      if (first != nil && first.bag == bag) { return slots[index] }
    }
    return nil
  }

  refreshSlot(mut self, slot: mut Slot, lists: JunkLists, rules: JunkRules): Integer {
    const changed = slot.refresh(lists, rules)
    if (Client.bit.band(changed, MOVED) != 0 && peek slot.id != 0) { self.arrived.push(slot) }
    return changed
  }

  // Each container's fill and the free slots: the fills' texts made again only where a container's count changed.
  count(mut self) {
    let free = 0
    let total = 0
    let same = self.used.length == self.bags.length
    for (index, slots of self.bags) {
      let used = 0
      for (slot of slots) {
        if (peek slot.id != 0) { used += 1 }
      }
      if (self.used[index] != used) {
        self.used[index] = used
        same = false
      }
      free += slots.length - used
      total += slots.length
    }
    if (!same) {
      let fills: Map<Integer, String> = {}
      for (index, slots of self.bags) {
        const info = self.infos[index]
        if (info != nil) { fills[info.bag] = Locale.FILL.format(self.used[index] ?? 0, slots.length) }
      }
      self.fills = fills
    }
    self.free = free
    self.total = total
  }
}
