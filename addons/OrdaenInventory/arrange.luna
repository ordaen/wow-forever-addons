// «Sort the bags»: the items moved in the bags into the window's order (the kinds' order, the sort's within each),
// around the protected slots, which keep what they hold. Only the bags that take any item take part: a quiver or a soul
// bag keeps its own. The moves are swaps of two slots, as many at once as touch no slot twice; the next go waits for
// the client's word that the last moved (`Game.bags.updated`), and the run ends when every slot holds what it should,
// when a go moves nothing and no slot is locked (a locked slot is waited for), or after as many goes as there are
// places.
import Game from "$game"
import { Slot, SortBy } from "@/model"
import { tabSections } from "@/sections"

public class Arranger {
  // Whether a run goes.
  public state running = false
  // The slots that take part, in the bags' order, and the stack each of the first should hold (`Slot.key`): one for
  // each item, the places past them want nothing.
  places: array<Slot> = []
  wanted: array<integer> = []
  // How many goes are left: a run ends after as many goes as there are places, whatever the client did.
  left = 0

  // A run over `slots` (every slot of the bags, in their order) into the order `by`; `general` tells the bags that
  // take part. A protected slot (`Slot.guarded`) keeps what it holds.
  public start(mut self, slots: array<Slot>, general: (bag: integer) => boolean, by: SortBy) {
    let places: array<Slot> = []
    let items: array<Slot> = []
    for (slot of slots) {
      if (general(slot.bag) && !peek slot.guarded) {
        places.push(slot)
        if (peek slot.id != 0) { items.push(slot) }
      }
    }
    // The window's order: the kinds' sections in their order, each sorted.
    let ordered: array<Slot> = []
    for (section of tabSections(items, .All, .Type, by)) {
      for (slot of section.slots) { ordered.push(slot) }
    }
    // The places past the last item want nothing: they hold what the swaps leave them.
    let wanted: array<integer> = []
    for (slot of ordered) { wanted.push(slot.key()) }
    self.places = places
    self.wanted = wanted
    self.left = places.length
    self.running = true
    self.step()
  }

  public stop(mut self) { self.running = false }

  // One go: each place that holds another stack than it should takes it from a later place that holds it, a slot
  // locked or taken from in this go left for the next. Nothing left to move ends the run.
  public step(mut self) {
    if (!peek self.running) { return }
    if (self.left <= 0) {
      self.stop()
      return
    }
    self.left -= 1
    // The later places a swap of this go took a stack from: each is left for the next go. A place a swap filled is
    // never looked at again in the go, as the walk and `holderOf` go on past it.
    let taken: map<Slot, boolean> = {}
    let pending = false
    let moved = false
    for (index, place of self.places) {
      const want = self.wanted[index]
      if (want != nil && place.key() != want) {
        pending = true
        if (taken[place] != true && !peek place.locked) {
          const from = self.holderOf(want, index, taken)
          if (from != nil && Game::bags.swap(from.bag, from.index, place.bag, place.index)) {
            taken[from] = true
            moved = true
          }
        }
      }
    }
    if (!pending || (!moved && !self.anyLocked())) { self.stop() }
  }

  // A later place that holds the stack where it doesn't belong, not taken from in this go and not locked. The first
  // wrong place of a go always finds one: a place where the stack belongs is never emptied of it, and the rest wait for
  // a go.
  holderOf(self, want: integer, after: integer, taken: map<Slot, boolean>): Slot | nil {
    for (index, place of self.places) {
      if (index > after && taken[place] != true && !peek place.locked && place.key() == want && self.wanted[index] != want) {
        return place
      }
    }
    return nil
  }

  anyLocked(self): boolean {
    return self.places.any(place => peek place.locked)
  }
}
