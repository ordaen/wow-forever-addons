// A slot protected from «Sort the bags», and what Ordaen Tooltips' item tooltip says of the slot under the cursor: that
// it is protected («This slot is protected from sorting», among what other modules add), and its clicks as the
// player's scheme has them («Double left click: Sell»), each that does something to this slot where the player stands
// (a use named for what it does there, none for an item the client does nothing with; a link while the chat's input is
// open). Without Ordaen Tooltips there
// is no such line: Bags adds nothing to the game's own tooltip.
import Client from "$client"
import Game from "$game"
import root Tooltips from "OrdaenTooltips"
import type { ItemKeys, ItemLines, Line } from "OrdaenTooltips"
import { CHORDS, SlotAction, actionAt, actionName, chordName } from "@/clicks"
import Locale from "@/locales"
import { Slot } from "@/model"
import { Choices } from "@/pane"
import { socketable, whyText } from "@/slotMenu"
import { Vault } from "@/vault"

// A protected slot, kept for the character: where it is and the item it protects. The protection follows its item:
// moved by hand, it goes with it; the item gone from the bags, it is dropped.
public struct Guard implements Plain {
  public mut bag: integer
  public mut slot: integer
  public mut id: integer
}

const NONE: array<Line> = []
const NO_KEYS: array<string> = []

// The slot the cursor is on, as the window says it.
public class Hovered {
  public state slot: Slot | nil = nil
}

// The notes of the slot under the cursor: why its item is junk, and that it is protected.
public class GuardLine implements ItemLines {
  const hovered: Hovered
  constructor(hovered: Hovered) { self.hovered = hovered }

  public lines(item: integer, link: string): array<Line> {
    const slot = self.hovered.slot
    if (slot == nil || slot.id != item) { return NONE }
    const why = slot.why
    if (why != nil && slot.guarded) { return [{ left: Locale::JUNK_NOTE.format(whyText(why)) }, { left: Locale::PROTECTED }] }
    if (why != nil) { return [{ left: Locale::JUNK_NOTE.format(whyText(why)) }] }
    if (slot.guarded) { return [{ left: Locale::PROTECTED }] }
    return NONE
  }
}

// The clicks of a slot of the bags, the bank or the guild bank, as the player's scheme has them.
public class GuardKey implements ItemKeys {
  const hovered: Hovered
  choices: Signal<Choices>
  // The bank and the guild bank open: what a container's use does there.
  bankOpen: Signal<boolean>
  guildOpen: Signal<boolean>
  constructor(hovered: Hovered, choices: Signal<Choices>, bankOpen: Signal<boolean>, guildOpen: Signal<boolean>) {
    self.hovered = hovered
    self.choices = choices
    self.bankOpen = bankOpen
    self.guildOpen = guildOpen
  }

  public keys(item: integer, link: string): array<string> {
    const slot = self.hovered.slot
    if (slot == nil || slot.id != item) { return NO_KEYS }
    let keys: array<string> = mut []
    for (chord of CHORDS) {
      const name = clickName(slot, actionAt(self.choices.slotPresses, chord), self.bankOpen, self.guildOpen)
      if (name != nil) { keys.push(Locale::KEY_CLICK.format(chordName(chord), name)) }
    }
    return keys
  }
}

// What a click does to the slot now, as its hint says it; none where it does nothing: protecting is the bags' alone,
// sockets gear's, a link the chat's while its input is open.
function clickName(slot: Slot, action: SlotAction, bankOpen: boolean, guildOpen: boolean): string | nil {
  return match (action) {
    .Nothing => nil
    .Use => useName(slot, bankOpen, guildOpen)
    .Protect => slot.vault != Vault::Bags ? nil : slot.guarded ? Locale::MENU_UNPROTECT : Locale::MENU_PROTECT
    .Socket => socketable(slot) ? actionName(action) : nil
    .Link => Game::chat.typing ? actionName(action) : nil
    else => actionName(action)
  }
}

// What the client's use of the slot's item does where the player stands: a guild bank's stack goes into the bags, as
// does the bank's while it is open; a window open takes the bags' item as it can (the guild bank, the bank, a letter, a
// trade, a merchant, the auction house; never a bound one where it is refused, never one sold for nothing); else the
// item's own use. None: the client does nothing with it.
function useName(slot: Slot, bankOpen: boolean, guildOpen: boolean): string | nil {
  const read = slot.read
  if (slot.id == 0) { return nil }
  if (slot.vault == Vault::Guild) { return Locale::USE_TO_BAGS }
  if (slot.vault == Vault::Bank) { return bankOpen ? Locale::USE_TO_BAGS : nil }
  if (guildOpen) { return read.bound ? nil : Locale::USE_TO_GUILD }
  if (bankOpen) { return Locale::USE_TO_BANK }
  return match (Game::bags.place) {
    .Mail => read.bound ? nil : Locale::USE_ATTACH
    .Trade => read.bound ? nil : Locale::USE_TRADE
    .Merchant => read.price > 0 ? Locale::USE_SELL : nil
    .AuctionHouse => read.bound ? nil : Locale::USE_AUCTION
    else => ownUse(slot)
  }
}

// The item's own use, as the client's right-click does it: gear put on, a container of loot opened, a page read, the
// quest it starts begun, its spell cast (a potion, food, a recipe learned).
function ownUse(slot: Slot): string | nil {
  if (slot.read.worn != "") { return Locale::USE_EQUIP }
  const info = Client::C_Container::GetContainerItemInfo(slot.bag, slot.index)
  if (info != nil && info.hasLoot) { return Locale::USE_OPEN }
  if (info != nil && info.isReadable) { return Locale::USE_READ }
  const quest = Client::C_Container::GetContainerItemQuestInfo(slot.bag, slot.index)
  if (quest.questID != nil && !quest.isActive) { return Locale::USE_QUEST }
  const (spell, _) = Client::C_Item::GetItemSpell(slot.id)
  return spell != nil ? Locale::ACT_USE : nil
}

// Both added to Tooltips while it is on: the watch's run owns them, so they end when either module does.
public class GuardTips {
  const line: GuardLine
  const key: GuardKey

  constructor(hovered: Hovered, choices: Signal<Choices>, bankOpen: Signal<boolean>, guildOpen: Signal<boolean>) {
    self.line = new GuardLine(hovered)
    self.key = new GuardKey(hovered, choices, bankOpen, guildOpen)
    watch (tooltips of Tooltips) {
      if (tooltips == nil) { return }
      tooltips.held.add(self.line)
      tooltips.keys.add(self.key)
    }
  }
}
