// Waits for a version in `OrdaenTooltips/addon.json` (`lunatype check`: «`OrdaenTooltips` says no version, so the
// range this addon lists for it holds to nothing»). With it: this file is `rows.luna`, `addon.json` lists
// `"OrdaenTooltips": "^1.0.0"`, and the root holds `lines: TooltipLines`, made in its constructor after the shopping
// list: `self.lines = new TooltipLines(self.prices, self.priceLine, self.shopping)`.

// Ordaen Auction's lines in an item's tooltip, added to Ordaen Tooltips' sections (`redesign/extend.md`, case 1): the
// «Auction» line in `worth` (what one costs on the house, and how old the price is), the shopping list's in `held` (how
// many are wanted, and how many this character holds of them). Each is asked once per item shown, and again when a
// cell it read moves: a price's `revision`, the list's.
import Game from "$game"
import { ItemId } from "Ordaen"
import root Tooltips from "OrdaenTooltips"
import type { ItemLines, Line } from "OrdaenTooltips"
import Locale from "@/locales"
import { PriceKey, PriceSource } from "@/quote"
import { ShoppingList } from "@/shopping"
import Style from "@/style"

const NONE: Array<Line> = []
const AMBER_DAYS = 3

// A price's age as the line says it: nothing under a day, «(2 d.)» from a day on; its colour, amber to the third day,
// dim beyond, none under a day.
function aged(hours: Integer): (String, Color | nil) {
  const days = (hours / 24).floor()
  if (days < 1) { return "", nil }
  return " " + Locale.AGE_DAYS.format(days), days <= AMBER_DAYS ? Style.AMBER : Style.DIM
}

// The «Auction» line of an item's tooltip.
public class PriceLine implements ItemLines {
  const prices: any PriceSource
  // The setting: the line shows.
  on: Signal<Boolean>

  constructor(prices: any PriceSource, on: Signal<Boolean>) {
    self.prices = prices
    self.on = on
  }

  public lines(self, item: Integer, link: String): Array<Line> {
    if (!self.on) { return NONE }
    _ = self.prices.revision
    const quote = self.prices.buy(PriceKey.ofLink(item, link))
    if (quote == nil) { return NONE }
    const age, color = aged(quote.age())
    return [{ left: Locale.AUCTION, right: Game.money.format(quote.copper()) + age, rightColor: color }]
  }
}

// Both lines, added to Tooltips' sections while Tooltips is on: the watch's run owns them, so they end when either
// module does. Without Tooltips the root import stays nil and nothing is added.
public class TooltipLines {
  const price: PriceLine
  const listed: ListedLine

  constructor(prices: any PriceSource, on: Signal<Boolean>, list: ShoppingList) {
    self.price = new PriceLine(prices, on)
    self.listed = new ListedLine(list)
    watch (tooltips of Tooltips) {
      if (tooltips == nil) { return }
      tooltips.worth.add(self.price)
      tooltips.held.add(self.listed)
    }
  }
}

// The shopping list's line: «On the shopping list: 12 (bought 4)».
public class ListedLine implements ItemLines {
  const list: ShoppingList

  constructor(list: ShoppingList) {
    self.list = list
  }

  public lines(self, item: Integer, link: String): Array<Line> {
    const needed = self.list.needed[ItemId.of(item)]
    if (needed == nil) { return NONE }
    const held = Game.items.owned(item).min(needed)
    return [{ left: Locale.IN_LIST, right: Locale.IN_LIST_HELD.format(needed, held) }]
  }
}
