// The item panel (design `auction`): what opens at a page's right when the player picks an item, on «Buy» and on «Sell»
// alike: one layout. The item (its slot, its name in its quality's colour, a detail under it); its price's trend, a
// chart of the day (a bar an hour), the week or the month (a bar a day), the player's pick; its prices (the market with
// its age, the lowest listed, the merchant's); then what the page does with it (its slot: «Buy»'s listings and «Buy»,
// «Sell»'s quantity and «Post»), in the rest of the panel's height.
import { Age, Choice, Component, Copper, Hour, ItemButton, ItemId, Money, PX, Segmented } from "Ordaen"
import { Align, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { PriceHistory } from "@/history"
import { House } from "@/house"
import Locale from "@/locales"
import { PriceKey, PriceSource } from "@/quote"
import Style from "@/style"

// How far back the chart looks.
public enum Span { Day = "day", Week = "week", Month = "month" }

const SPANS: Array<Choice<Span>> = [
  { value: Span.Day, label: Locale.SPAN_DAY },
  { value: Span.Week, label: Locale.SPAN_WEEK },
  { value: Span.Month, label: Locale.SPAN_MONTH },
]
const HOURS_A_DAY = 24
const WEEK = 7
const MONTH = 30
const CHART_HEIGHT = 72 * PX
// A bar's least height, so a price at the span's lowest still shows.
const LEAST_BAR = 2 * PX
const BAR: Color = Color.hex("#d6a56b")
const LAST_BAR: Color = Color.hex("#f0c860")
const CHART_BACK: Color = Color.hex("#00000040")

// The header, the chart, the prices, and the page's part, which takes the rest.
const PANEL: Array<Track> = ["auto", "auto", "auto", { fr: 1 }]
const HEAD: Array<Track> = ["auto", { fr: 1 }]
const PAIR: Array<Track> = [{ fr: 1 }, "auto"]
const PRICE: Array<Track> = ["auto", "auto"]
const ENDS: Array<Track> = ["auto", { fr: 1 }, "auto"]

// One bar of the chart: its height (none where no price was seen in its hour or day), and its colour: the latest gold.
struct Bar {
  height: Number
  color: Color
}

// The lowest price of each hour (the day's span) or day (the week's and the month's), oldest first; 0 where none
// was seen (a list keeps no hole). A day is the hours `Hour` counts from its first, as the history keeps them.
function lowestOf(history: any PriceHistory, key: PriceKey, span: Span, now: Hour): Array<Integer> {
  const hourly = span == Span.Day
  const count = hourly ? HOURS_A_DAY : span == Span.Week ? WEEK : MONTH
  const today = (now / HOURS_A_DAY).floor()
  const first = hourly ? now - (HOURS_A_DAY - 1) : (today - (count - 1)) * HOURS_A_DAY
  let lows: Array<Integer> = []
  for (index of 1..=count) { lows.push(0) }
  for (point of history.hours(key, Hour.of(first), now)) {
    const at = hourly ? point.hour - first + 1 : ((point.hour - first) / HOURS_A_DAY).floor() + 1
    const kept = lows[at] ?? 0
    if (at >= 1 && at <= count && (kept == 0 || point.copper < kept)) { lows[at] = point.copper }
  }
  return lows
}

class PriceChart implements Component {
  state span: Span = Span.Day
  derived lows: Array<Integer> = self.lowsOf()
  derived low: Integer = self.ends(false)
  derived high: Integer = self.ends(true)
  derived priced: Boolean = self.high > 0
  derived bars: Array<Bar> = self.barsOf()
  derived columns: Array<Track> = self.columnsOf()

  const key: PriceKey
  const history: any PriceHistory | nil
  constructor(key: PriceKey, history: any PriceHistory | nil) {
    self.key = key
    self.history = history
  }

  lowsOf(self): Array<Integer> {
    const history = self.history
    if (history == nil) { return [] }
    _ = history.revision
    return lowestOf(history, self.key, self.span, Hour.now())
  }

  // The span's highest price (`highest`) or its lowest; 0 where none was seen.
  ends(self, highest: Boolean): Integer {
    let found = 0
    for (copper of self.lows) {
      if (copper > 0 && (found == 0 || (highest ? copper > found : copper < found))) { found = copper }
    }
    return found
  }

  barsOf(self): Array<Bar> {
    let list: Array<Bar> = []
    const high = self.high
    const last = self.lows.length
    for (index, copper of self.lows) {
      const height = copper > 0 && high > 0 ? LEAST_BAR.max(CHART_HEIGHT * copper / high) : 0
      list.push({ height: height, color: index == last ? LAST_BAR : BAR })
    }
    return list
  }

  columnsOf(self): Array<Track> {
    let list: Array<Track> = []
    for (bar of self.lows) { list.push({ fr: 1 }) }
    return list
  }

  public render(self): Template {
    return $ltml {
      <box gap={Style.ROW_GAP}>
        <Segmented value={mut self.span} choices={SPANS} />
        <box $if={self.priced} gap={4 * PX}>
          <box columns={self.columns} gap={1 * PX} height={CHART_HEIGHT} yAlign={Align.End} background={CHART_BACK}>
            <box $for={bar of self.bars} height={bar.height}
                 background={bar.color} />
          </box>
          <box columns={ENDS} gap={Style.ROW_GAP} yAlign={Align.Center}>
            <Money amount={self.low} />
            <box />
            <Money amount={self.high} />
          </box>
        </box>
        <box $else height={CHART_HEIGHT} background={CHART_BACK} xAlign={Align.Center} yAlign={Align.Center}>
          <text value={Locale.NO_HISTORY} textColor={Style.DIM} textSize={.Secondary} />
        </box>
      </box>
    }
  }
}

public class ItemPanel implements Component {
  derived market: Copper | nil = self.marketOf()
  derived age: Number | nil = self.ageOf()
  derived lowest: Copper | nil = self.lowestOf()
  derived vendor: Copper | nil = self.prices.vendor(self.item)
  derived marketAmount: Integer = self.market ?? 0
  derived lowestAmount: Integer = self.lowest ?? 0
  derived vendorAmount: Integer = self.vendor ?? 0

  const item: ItemId
  const key: PriceKey
  const name: String
  const color: Color
  const detail: String
  const house: House
  const prices: any PriceSource
  const history: any PriceHistory | nil
  constructor(
    item: ItemId,
    name: String,
    color: Color,
    // The line under the name: how many are listed («Buy»), how many the bags hold («Sell»).
    detail: String,
    house: House,
    prices: any PriceSource,
    history: any PriceHistory | nil,
  ) {
    self.item = item
    self.key = PriceKey.of(item)
    self.name = name
    self.color = color
    self.detail = detail
    self.house = house
    self.prices = prices
    self.history = history
  }

  marketOf(self): Copper | nil {
    _ = self.prices.revision
    return self.house.quote(self.key)?.copper()
  }

  ageOf(self): Number | nil {
    _ = self.prices.revision
    const quote = self.house.quote(self.key)
    return quote != nil ? quote.age() * 3600 : nil
  }

  lowestOf(self): Copper | nil {
    _ = self.prices.revision
    return self.house.listed(self.key)?.low()
  }

  public render(self): Template {
    return $ltml {
      <box rows={PANEL} gap={Style.GAP} padding={Style.PANEL_PAD} border={Style.FRAME}
           background={Ordaen.art.window.marble}>
        <box columns={HEAD} gap={10 * PX} yAlign={Align.Center}>
          <ItemButton item={self.item} size={Style.BIG_SLOT} />
          <box gap={2 * PX} overflow={.Hidden}>
            <text value={self.name} textColor={self.color} textSize={.Title} wrap={false} />
            <text value={self.detail} textColor={Style.DIM} textSize={.Secondary} wrap={false} />
          </box>
        </box>
        <PriceChart key={self.key} history={self.history} />
        <box columns={PAIR} gap={Style.ROW_GAP} yAlign={Align.Center}>
          <text value={Locale.COLUMN_MARKET} textColor={Style.INK} />
          <box $if={self.market != nil} columns={PRICE} gap={4 * PX} yAlign={Align.Center}>
            <Money amount={self.marketAmount} />
            <Age seconds={self.age} />
          </box>
          <text $else value={"—"} textColor={Style.DIM} />
          <text value={Locale.COLUMN_LOW} textColor={Style.INK} />
          <Money $if={self.lowest != nil} amount={self.lowestAmount} />
          <text $else value={"—"} textColor={Style.DIM} />
          <text value={Locale.VENDOR_PRICE} textColor={Style.INK} />
          <Money $if={self.vendor != nil} amount={self.vendorAmount} />
          <text $else value={"—"} textColor={Style.DIM} />
        </box>
        <box rows={[{ fr: 1 }]}>
          <slot />
        </box>
      </box>
    }
  }
}
