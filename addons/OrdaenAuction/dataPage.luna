// «Data»: the last full scan (when, how many auctions and items), the house's size at rest, the sales ledger's
// totals, and the settings as they stand (their page, read-only), with «Settings» to change them in Ordaen's settings
// window: one place to change them.
import Game from "$game"
import { Align, Overflow, Track } from "$ltml"
import Runtime from "$runtime"
import { Component, Money, number, PushButton, PX, Section, Settings } from "Ordaen"
import root Ordaen from "Ordaen"
import { Deal, Ledger } from "@/ledger"
import Locale from "@/locales"
import { serverSeconds } from "@/quote"
import { Scanner } from "@/scan"
import { Choices, GeneralPage } from "@/settings"
import Style from "@/style"
import { agoText, auctionsText, itemsText } from "@/style"

const ROW: Array<Track> = [{ fr: 1 }, "auto"]

// A line: what at the left, how much at the right.
class Fact implements Component {
  label: Signal<String>
  value: Signal<String>
  constructor(label: Signal<String>, value: Signal<String>) {
    self.label = label
    self.value = value
  }

  public render(self): Template {
    return $ltml {
      <box columns={ROW} gap={8 * PX}>
        <text value={self.label} textColor={Style.DIM} textSize={Style.TEXT} />
        <text value={self.value} textColor={Style.INK} textSize={Style.TEXT} wrap={false} />
      </box>
    }
  }
}

// The money of a kind of the ledger's rows, at the right of a line.
class DealtLine implements Component {
  derived rows: Integer = self.counted()
  derived text: String = self.label.format(self.rows)
  derived copper: Integer = self.money()

  label: Signal<String>
  const deal: Deal
  const ledger: Ledger
  constructor(label: Signal<String>, deal: Deal, ledger: Ledger) {
    self.label = label
    self.deal = deal
    self.ledger = ledger
  }

  counted(self): Integer {
    _ = self.ledger.revision
    const rows, _ = self.ledger.total(self.deal)
    return rows
  }

  money(self): Integer {
    _ = self.ledger.revision
    const _, copper = self.ledger.total(self.deal)
    return copper
  }

  public render(self): Template {
    return $ltml {
      <box columns={ROW} gap={8 * PX}>
        <text value={self.text} textColor={Style.DIM} textSize={Style.TEXT} />
        <Money amount={self.copper} />
      </box>
    }
  }
}

public class DataPage implements Component {
  derived scanned: Boolean = self.lastFull > 0
  derived last: String = self.lastText()
  derived counted: String = self.scanner.auctions > 0 ?
    Locale.SCAN_COUNTS.format(auctionsText(self.scanner.auctions), itemsText(self.scanner.items)) : "—"
  derived size: String = Locale.KB.format((self.scanner.size / 1024).ceil())
  derived known: String = number(self.items)

  const scanner: Scanner
  const ledger: Ledger
  lastFull: Signal<Integer>
  items: Signal<Integer>
  settings: mut Settings<Choices>
  constructor(
    scanner: Scanner,
    ledger: Ledger,
    lastFull: Signal<Integer>,
    items: Signal<Integer>,
    // The settings: their page drawn read-only.
    settings: mut Settings<Choices>,
  ) {
    self.scanner = scanner
    self.ledger = ledger
    self.lastFull = lastFull
    self.items = items
    self.settings = settings
  }

  lastText(self): String {
    if (!self.scanned) { return Locale.NEVER }
    _ = Game.clock.seconds
    return agoText(serverSeconds() - self.lastFull)
  }

  onSettings(self) { Ordaen.toggleSettings(Runtime.Addon.of(self)) }

  public render(self): Template {
    return $ltml {
      // The page scrolls where the settings run past the window.
      <box columns={1} overflow={Overflow.Scroll}>
        <box rows={["auto"]} gap={8 * PX}>
          <Section title={Locale.SECTION_SCANS}>
            <Fact label={Locale.LAST_FULL} value={self.last} />
            <Fact label={Locale.LAST_FULL_COUNTS} value={self.counted} />
            <Fact label={Locale.ITEMS_KNOWN} value={self.known} />
            <Fact label={Locale.SIZE} value={self.size} />
          </Section>
          <Section title={Locale.SECTION_LEDGER}>
            <DealtLine label={Locale.SOLD_ROWS} deal={Deal.Sold} ledger={self.ledger} />
            <DealtLine label={Locale.BOUGHT_ROWS} deal={Deal.Bought} ledger={self.ledger} />
          </Section>
          <Section title={Locale.SECTION_SETTINGS}>
            <GeneralPage settings={mut self.settings} disabled={true} />
            <box xAlign={Align.Start}>
              <PushButton label={Locale.SETTINGS} width={140 * PX} @click={self.onSettings} />
            </box>
          </Section>
        </box>
      </box>
    }
  }
}
