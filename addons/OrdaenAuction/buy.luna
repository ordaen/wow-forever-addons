// «Buy» (design `auction`): at the left the house's categories (the classes of items as the game's own window lists
// them, a class picked showing its subclasses); a search by name and, on its row, the filter's funnel (level, quality);
// what the house showed last (ours, the shopping list's «Search all», or the game's), each item with its markers, how
// many are listed, its lowest price for one, its market, the lowest as a share of the market (green under 90%, red
// over 100%) and the price's age. A category, the funnel and the search are sent to the house; what is typed is sent
// once the typing settles (`SETTLE`), or at once on Enter, and filters the rows already shown by the names the house
// keeps lowercased. A row picked: at the right its listings, a quantity, the total, «Buy» (the client's from a click
// alone) and «Add to shopping list».
import Client from "$client"
import Game from "$game"
import { Align, Beside, Edges, Layer, Line, Overflow, Side, Track } from "$ltml"
import { ageText, Choice, Column, Component, Copper, CountInput, DropdownItem, ItemButton, ItemId, ListTab, Money, PushButton, PX, space, Table, TableRow, ToolButton, Toolbar, tracksOf, Memory } from "Ordaen"
import root Ordaen from "Ordaen"
import { PriceHistory } from "@/history"
import { House } from "@/house"
import { ItemPanel } from "@/itemPanel"
import Locale from "@/locales"
import { Purchase } from "@/purchase"
import { PriceKey, PriceSource, Quote } from "@/quote"
import { ShoppingList } from "@/shopping"
import Style from "@/style"
import { leftText } from "@/style"

// One item the house showed, as its row draws it.
public struct Found {
  key: PriceKey
  item: ItemId
  name: String
  // The name lowercased, as a search matches it.
  lower: String
  color: Color
  listed: Integer
  low: Copper
  market: Quote | nil
  // The lowest as a share of the market, in percent; none without a market.
  share: Integer | nil
}

const NAME_COLUMN = 1
const LISTED_COLUMN = 3
const LOW_COLUMN = 4
const MARKET_COLUMN = 5
const SHARE_COLUMN = 6

const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_ITEM, width: { fr: 1 }, sortable: true },
  { title: "", width: 44 * PX },
  { title: Locale.COLUMN_LISTED, width: 90 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_LOW, width: 96 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_MARKET, width: 90 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_SHARE, width: 56 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_AGE, width: 70 * PX, align: Align.End, sortable: true },
]
const TRACKS: Array<Track> = tracksOf(COLUMNS)
const LISTING_COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_UNIT, width: { fr: 1 }, align: Align.End },
  { title: Locale.COLUMN_COUNT, width: 48 * PX, align: Align.End },
  { title: Locale.COLUMN_LEFT, width: 56 * PX, align: Align.End },
]
const LISTING_TRACKS: Array<Track> = tracksOf(LISTING_COLUMNS)
// The categories at the left, the results at the right.
const PAGE: Array<Track> = [Style.CATEGORIES, { fr: 1 }]
// A subclass stands in under its class.
const SUBCLASS_PAD: Edges = { left: 14 * PX }
// How long the typing settles before what is typed is searched for, in seconds.
const SETTLE = 0.25
const FILL: Array<Track> = [{ fr: 1 }]
const SIDE: Array<Track> = ["auto", { fr: 1 }]
// The toolbar, and the shopping list's window at the row's right end.
const TOOLS: Array<Track> = [{ fr: 1 }, "auto"]
const ITEM: Array<Track> = ["auto", { fr: 1 }]
// The item panel's part: the listings (the rest of its height), the quantity and the total, a refusal, the buttons.
const PANEL: Array<Track> = [{ fr: 1 }, "auto", "auto", "auto", "auto"]
const PAIR: Array<Track> = [{ fr: 1 }, "auto"]
const MENU_WIDTH = 210 * PX
const MENU_BACK: Color = Color.hex("#0a0806f7")
const MENU_EDGE: Line = { width: 1 * PX, color: Color.hex("#6c5535") }
const MENU_PAD: Edges = { top: 6 * PX, bottom: 6 * PX }
const MENU_RULE: Line = { width: 1 * PX, color: Color.hex("#d6a56b33"), sides: [Side.Top] }
const AFTER_RULE: Edges = { top: 6 * PX }
// The most of a commodity the quantity takes: the shopping list takes more than is listed, so the listings don't bound
// it («Buy» asks that they hold it).
const MOST_COUNT = 999999
const STEP = 28 * PX
// The pip of an item on the shopping list.
const LISTED_PIP: Color = Color.hex("#40c0ff")
// The share's colours: a bargain under 90% of the market, dear over 100%.
const CHEAP = 90
const DEAR = 100

// A filter that lets every one through: no class, no subclass, any level, any quality.
const ANY = -1
// The level filter: any, or a band of ten levels by its first (1, 11, ... 51).
const LEVELS: Array<Choice<Integer>> = [
  { value: ANY, label: Locale.ANY_LEVEL },
  { value: 1, label: Locale.LEVELS.format(1, 10) },
  { value: 11, label: Locale.LEVELS.format(11, 20) },
  { value: 21, label: Locale.LEVELS.format(21, 30) },
  { value: 31, label: Locale.LEVELS.format(31, 40) },
  { value: 41, label: Locale.LEVELS.format(41, 50) },
  { value: 51, label: Locale.LEVELS.format(51, 60) },
]
const QUALITIES: Array<Choice<Integer>> = [
  { value: ANY, label: Locale.ANY_QUALITY },
  { value: 1, label: Locale.QUALITY_COMMON },
  { value: 2, label: Locale.QUALITY_UNCOMMON },
  { value: 3, label: Locale.QUALITY_RARE },
  { value: 4, label: Locale.QUALITY_EPIC },
]

// The label of the choice a filter's value is.
function labelOf(choices: Array<Choice<Integer>>, value: Integer): String {
  return choices.find(choice => choice.value == value)?.label ?? ""
}

// The filter's menu under the toolbar's funnel: the level bands and the qualities, each a list of its choices (the
// first lets every one through), the second under a rule. A choice picked stays in the open menu; a click anywhere
// else closes it. The classes are the categories at the page's left.
// How the player left «Buy»'s list: the filter's level band and quality, the column it is sorted by (0: as the
// house gives it) and which way.
public struct BuyView implements Plain {
  level: Integer = ANY
  quality: Integer = ANY
  sorted: Integer = 0
  descending: Boolean = false
}
const BUY_VIEW: BuyView = {}

class FilterMenu implements Component {
  public close: Event<nil> = new Event()

  level: mut Signal<Integer>
  quality: mut Signal<Integer>
  constructor(level: mut Signal<Integer>, quality: mut Signal<Integer>) {
    self.level = level
    self.quality = quality
  }

  onLevel(mut self, value: Integer) { self.level = value }
  onQuality(mut self, value: Integer) { self.quality = value }
  onClose(self) { self.close.emit() }

  public render(self): Template {
    return $ltml {
      <surface layer={Layer.Tooltip} place={Beside { beside: "parent" }} width={MENU_WIDTH} background={MENU_BACK}
               border={MENU_EDGE} padding={MENU_PAD} columns={1} @clickOutside={self.onClose}>
        <DropdownItem $for={choice of LEVELS} choice={choice} value={self.level} compact={true}
                      @pick={self.onLevel} />
        <box columns={1} padding={AFTER_RULE} border={MENU_RULE}>
          <DropdownItem $for={choice of QUALITIES} choice={choice} value={self.quality} compact={true}
                        @pick={self.onQuality} />
        </box>
      </surface>
    }
  }
}

// A class of the house's categories at the page's left: its entry, and while it is the class picked, its subclasses
// under it, stood in. Picking reports the class and the subclass (`ANY` for the class whole).
class CategoryEntry implements Component {
  public pick: Event<(Integer, Integer)> = new Event()

  derived open: Boolean = self.itemClass == self.category.itemClass
  derived whole: Boolean = self.open && self.itemSubclass == ANY

  category: Signal<Game.ItemCategory>
  itemClass: Signal<Integer>
  itemSubclass: Signal<Integer>
  constructor(category: Signal<Game.ItemCategory>, itemClass: Signal<Integer>, itemSubclass: Signal<Integer>) {
    self.category = category
    self.itemClass = itemClass
    self.itemSubclass = itemSubclass
  }

  onClass(self) { self.pick.emit(self.category.itemClass, ANY) }
  onSubclass(self, subclass: Integer) { self.pick.emit(self.category.itemClass, subclass) }

  public render(self): Template {
    return $ltml {
      <box columns={1}>
        <ListTab label={self.category.name} selected={self.whole} @pick={self.onClass} />
        <box $if={self.open} columns={1} padding={SUBCLASS_PAD}>
          <SubclassEntry $for={sub of self.category.subclasses} $key={sub.itemSubclass} subclass={sub}
                         itemSubclass={self.itemSubclass} @pick={self.onSubclass} />
        </box>
      </box>
    }
  }
}

// A subclass under its class: picking reports its number.
class SubclassEntry implements Component {
  public pick: Event<Integer> = new Event()

  derived selected: Boolean = self.itemSubclass == self.subclass.itemSubclass

  subclass: Signal<Game.ItemSubcategory>
  itemSubclass: Signal<Integer>
  constructor(subclass: Signal<Game.ItemSubcategory>, itemSubclass: Signal<Integer>) {
    self.subclass = subclass
    self.itemSubclass = itemSubclass
  }

  onPick(self) { self.pick.emit(self.subclass.itemSubclass) }

  public render(self): Template {
    return $ltml {
      <ListTab label={self.subclass.name} selected={self.selected} @pick={self.onPick} />
    }
  }
}

// An age in seconds, as the `Age` control reads one; none without a price.
public function ageOf(quote: Quote | nil): Number | nil {
  if (quote == nil) { return nil }
  return quote.age() * 3600
}

// The age column's text and colour: the hours under a day (a house's prices move by the hour), «< 1 h» for this
// hour's; from a day the market's days (`ageText`: amber to the third day, dimmed after); nothing without a price.
public function ageCell(quote: Quote | nil): (String, Color) {
  if (quote == nil) { return "", Style.DIM }
  const hours = quote.age()
  if (hours < 1) { return Locale.AGE_FRESH, Style.INK }
  if (hours < 24) { return Locale.HOURS.format(hours), Style.INK }
  const text, color = ageText(hours * 3600)
  return text, color ?? Style.DIM
}

// The share's colour: green for a bargain, red where dear, the ink between.
function shareColor(share: Integer | nil): Color {
  if (share == nil) { return Style.DIM }
  if (share < CHEAP) { return Style.GREEN }
  if (share > DEAR) { return Style.RED }
  return Style.INK
}

// The share as a row writes it: a dash where there is none.
function shareText(share: Integer | nil): String {
  return share != nil ? "%d%%".format(share) : "—"
}

// One row. Its name is cut where its column is narrower than it, so a long name never pushes the table past the page.
class FoundRow implements Component {
  public pick: Event<PriceKey> = new Event()

  derived age: String = self.ageTextOf()
  derived ageInk: Color = self.ageInkOf()
  derived priced: Boolean = self.found.market != nil
  derived market: Integer = self.found.market?.copper() ?? 0
  derived share: String = shareText(self.found.share)
  derived shareInk: Color = shareColor(self.found.share)

  // The row's line: the table hands the row to another line as it scrolls.
  found: Signal<Found>
  selected: Signal<Boolean>
  wanted: Signal<Boolean>
  constructor(found: Signal<Found>, selected: Signal<Boolean>, wanted: Signal<Boolean>) {
    self.found = found
    self.selected = selected
    self.wanted = wanted
  }

  onPick(self) { self.pick.emit(self.found.key) }

  ageTextOf(self): String {
    const text, _ = ageCell(self.found.market)
    return text
  }

  ageInkOf(self): Color {
    const _, color = ageCell(self.found.market)
    return color
  }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={TRACKS} selected={self.selected} @pick={self.onPick}>
        <box columns={ITEM} gap={8 * PX} yAlign={Align.Center}>
          <ItemButton item={self.found.item} size={Style.SLOT} />
          <box overflow={.Hidden}>
            <text value={self.found.name} textColor={self.found.color} wrap={false} />
          </box>
        </box>
        <box yAlign={Align.Center}>
          <box $if={self.wanted} width={8 * PX} height={8 * PX} background={LISTED_PIP} />
        </box>
        <box xAlign={Align.End}>
          <text value={"%d"} arguments={[self.found.listed]} textColor={Style.INK} />
        </box>
        <box xAlign={Align.End}>
          <Money amount={self.found.low} />
        </box>
        <box xAlign={Align.End}>
          <Money $if={self.priced} amount={self.market} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.share} textColor={self.shareInk} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.age} textColor={self.ageInk} wrap={false} />
        </box>
      </TableRow>
    }
  }
}

public class BuyPage implements Component {
  // «Shopping list» was clicked: its window opens, or closes.
  public openList: Event<nil> = new Event()

  // What the search field holds, and what is searched for: the field's once the typing settles, or on Enter.
  state typed = ""
  state search = ""
  // The category picked at the left: a class and one of its subclasses, `ANY` for none.
  state itemClass = ANY
  state itemSubclass = ANY
  state filterOpen = false
  // The filter's Tip: the level band and the quality it lets through.
  derived filterText: String = [labelOf(LEVELS, self.list.values.level), labelOf(QUALITIES, self.list.values.quality)].join(", ")
  // How the player left the list, the profile's (`Memory`, `redesign/kept.md`); the search isn't kept.
  public list: mut Memory<BuyView> = new Memory<BuyView>(BUY_VIEW, .Profile, "buy")
  state picked: PriceKey | nil = nil
  // What the house was last searched for, as `wanted` says it.
  state sent = ""
  // Every row of what the house showed, sorted: rebuilt as the house shows other items, its prices move or the sort
  // changes, never as the player types. The rows shown are those whose lowercased name holds the search.
  derived all: Array<Found> = self.allOf()
  derived rows: Array<Found> = self.matching()
  // The row picked, while it is shown: one or none, handed to the window's side section.
  derived picks: Array<Found> = self.chosenOf()
  derived filtered: Boolean = self.list.values.level != ANY || self.list.values.quality != ANY
  derived wanted: String = "%s|%d|%d|%d|%d".format(self.search, self.itemClass, self.itemSubclass, self.list.values.level,
    self.list.values.quality)
  derived empty: String = self.items > 0 ? Locale.NO_RESULTS : Locale.NO_PRICES_FIND
  derived anyClass: Boolean = self.itemClass == ANY
  // The typing's turn: a settle that comes after a later key, or after Enter, is stale.
  turn = 0

  // The house's categories, as the client lists them.
  const categories: Array<Game.ItemCategory>
  house: mut House
  const prices: any PriceSource
  offers: Signal<Array<Game.Offer>>
  items: Signal<Integer>
  // The shopping list: its items marked, the row picked added to it.
  shopping: mut ShoppingList
  chosen: mut Signal<Array<Found>>
  constructor(
    house: mut House,
    prices: any PriceSource,
    // What the house showed last.
    offers: Signal<Array<Game.Offer>>,
    // How many items the house's prices cover.
    items: Signal<Integer>,
    shopping: mut ShoppingList,
    // The row picked, while it is shown: the window's side section draws it.
    chosen: mut Signal<Array<Found>>,
  ) {
    self.house = house
    self.prices = prices
    self.offers = offers
    self.items = items
    self.shopping = shopping
    self.chosen = chosen
    self.categories = Game.auctionQuery.categories()
    watch (picks of self.picks) { self.chosen = picks.map(found => found) }
    self.sent = peek self.wanted
    // A key typed: what is typed is searched for once no other key comes for `SETTLE` seconds.
    watch (typed of self.typed) {
      self.turn += 1
      const turn = self.turn
      Client.C_Timer.After(SETTLE, () => self.settle(turn))
    }
    // The search, the category or a filter moved: the house searched as soon as it takes a query; what moves
    // meanwhile is sent whole after.
    watch {
      const wanted = self.wanted
      if (wanted != peek self.sent && Game.auctionQuery.ready) {
        if (Game.auctionQuery.search(peek self.search, peek self.filters())) { self.sent = wanted }
      }
    }
  }

  // The typing settled, unless a key or Enter came since.
  settle(mut self, turn: Integer) {
    if (turn == self.turn) { self.search = peek self.typed }
  }

  // Enter in the search field: what is typed is searched for now.
  searchNow(mut self) {
    self.turn += 1
    self.search = peek self.typed
  }

  filters(self): Game.SearchFilters {
    const level = self.list.values.level
    return {
      itemClass: self.itemClass != ANY ? self.itemClass : nil,
      itemSubclass: self.itemClass != ANY && self.itemSubclass != ANY ? self.itemSubclass : nil,
      minLevel: level != ANY ? level : nil,
      maxLevel: level != ANY ? level + 9 : nil,
      qualities: self.list.values.quality != ANY ? [self.list.values.quality] : [],
    }
  }

  allOf(mut self): Array<Found> {
    _ = self.prices.revision
    let list: Array<Found> = []
    for (offer of self.offers) {
      const key = PriceKey.given(offer.key)
      const item = key.item()
      const named = self.house.named(item)
      const market = self.house.quote(key)
      const share = market != nil && market.copper() > 0 ? (offer.copper * 100 / market.copper()).round() : nil
      list.push({
        key: key, item: item, name: named.name, lower: named.lower, color: named.color, listed: offer.quantity,
        low: Copper.of(offer.copper), market: market, share: share,
      })
    }
    const column = self.list.values.sorted
    const down = self.list.values.descending
    if (column != 0) { list.sort((a, b) => down ? before(b, a, column) : before(a, b, column)) }
    return list
  }

  // The rows whose lowercased name holds the search: all of them for none.
  matching(self): Array<Found> {
    const sought = self.search.lower()
    if (sought == "") { return self.all }
    return self.all.filter(row => row.lower.contains(sought))
  }

  chosenOf(self): Array<Found> {
    const picked = self.picked
    const row = picked != nil ? self.rows.find(row => row.key == picked) : nil
    return row != nil ? [row] : []
  }

  onPick(mut self, key: PriceKey) { self.picked = key }
  closeFilter(mut self) { self.filterOpen = false }
  pickAll(mut self) {
    self.itemClass = ANY
    self.itemSubclass = ANY
  }
  pickCategory(mut self, itemClass: Integer, itemSubclass: Integer) {
    self.itemClass = itemClass
    self.itemSubclass = itemSubclass
  }

  onOpenList(mut self) { self.openList.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={PAGE} rows={FILL} gap={space(.Item)}>
        // The categories: every item, then each class.
        <box rows={FILL} border={Style.FRAME} background={Style.LISTS_BACK}>
          <box overflow={Overflow.Scroll}>
            <ListTab label={Locale.ALL_CLASSES} selected={self.anyClass} @pick={self.pickAll} />
            <CategoryEntry $for={category of self.categories} $key={category.itemClass} category={category}
                           itemClass={self.itemClass} itemSubclass={self.itemSubclass} @pick={self.pickCategory} />
          </box>
        </box>
        <box rows={SIDE} gap={space(.Item)}>
          // The toolbar (the search, the filter), and the shopping list's window at the row's right end.
          <box columns={TOOLS} gap={space(.Item)} yAlign={Align.Center}>
            <Toolbar search={mut self.typed} placeholder={Locale.SEARCH} @submit={self.searchNow}>
              <ToolButton icon={Ordaen.art.ctl.tool.filter} title={Locale.FILTER} text={self.filterText}
                          open={mut self.filterOpen} lit={self.filtered}>
                <FilterMenu $if={self.filterOpen} level={mut self.list.values.level} quality={mut self.list.values.quality}
                            @close={self.closeFilter} />
              </ToolButton>
            </Toolbar>
            <PushButton label={Locale.PAGE_SHOPPING} width={Style.OPENER} @click={self.onOpenList} />
          </box>
          <box rows={FILL} border={Style.FRAME} background={Style.LISTS_BACK}>
            <Table columns={COLUMNS} sorted={mut self.list.values.sorted} descending={mut self.list.values.descending}
                   rowHeight={Style.ITEM_ROW}>
              <FoundRow $for={row of self.rows} $key={row.key} found={row} selected={self.picked == row.key}
                        wanted={self.shopping.needed[row.item] != nil} @pick={self.onPick} />
              <box $if={self.rows.length == 0} padding={Style.NOTE_PAD} yAlign={Align.Center}>
                <text value={self.empty} textColor={Style.DIM} />
              </box>
            </Table>
          </box>
        </box>
      </box>
    }
  }
}

// The time a listing has left, where the client says it.
function leftOf(seconds: Integer | nil): String {
  return seconds != nil ? leftText(seconds) : "—"
}

// One listing of the picked item: its price for one, how many, the time left; marked where the next click buys
// from it (its place within `first` to `last`).
class ListingRow implements Component {
  derived left: String = leftOf(self.listing.left)
  derived selected: Boolean = self.index >= self.first && self.index <= self.last

  const listing: Game.Listing
  const index: Integer
  first: Signal<Integer>
  last: Signal<Integer>
  constructor(listing: Game.Listing, index: Integer, first: Signal<Integer>, last: Signal<Integer>) {
    self.listing = listing
    self.index = index
    self.first = first
    self.last = last
  }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={LISTING_TRACKS} selected={self.selected}>
        <box xAlign={Align.End}>
          <Money amount={self.listing.unit} />
        </box>
        <box xAlign={Align.End}>
          <text value={"%d"} arguments={[self.listing.quantity]} textColor={Style.INK} wrap={false} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.left} textColor={Style.INK} wrap={false} />
        </box>
      </TableRow>
    }
  }
}

// The row picked: its listings (those the next click buys from marked), a quantity of a commodity (an item's
// auction is bought whole), the total, «Buy» (a commodity's second click confirms the price the client gave) and
// «Add to shopping list».
public class Chosen implements Component {
  state count = 1
  state listSorted = 0
  state listDescending = false
  derived listings: Array<Game.Listing> = self.purchase.listings ?? []
  derived commodity: Boolean = self.purchase.commodity
  // The listings the next click buys from: a commodity's first so many, an item's one auction.
  derived first: Integer = self.commodity ? 1 : self.purchase.next
  derived last: Integer = self.commodity ? self.purchase.coveredBy(self.count) : self.purchase.next
  derived refused: Boolean = self.purchase.refused != nil
  derived refusedText: String = self.purchase.refused ?? ""
  derived auction: Game.Listing | nil = self.listings[self.purchase.next]
  derived quoted: Boolean = self.purchase.quotedCount > 0 && self.purchase.quotedCount == self.count
  derived total: Integer = self.totalOf()
  derived buyLabel: String = self.quoted ? Locale.CONFIRM : Locale.BUY
  derived canBuy: Boolean = !Game.auctionActions.busy && (self.commodity ? self.count <= self.purchase.held :
      self.auction != nil)
  derived auctionCount: String = String.of(self.auction?.quantity ?? 0)

  // Under the item's name in its panel: how many are listed.
  const detail: String
  const found: Found
  const house: House
  const prices: any PriceSource
  const history: any PriceHistory | nil
  purchase: mut Purchase
  shopping: mut ShoppingList
  constructor(
    found: Found,
    house: House,
    prices: any PriceSource,
    history: any PriceHistory | nil,
    shopping: mut ShoppingList,
  ) {
    self.found = found
    self.house = house
    self.prices = prices
    self.history = history
    self.shopping = shopping
    self.detail = Locale.LISTED_COUNT.format(found.listed)
    self.purchase = new Purchase(found.key)
  }

  totalOf(self): Integer {
    if (!self.commodity) { return self.auction?.buyout ?? 0 }
    if (self.quoted) { return self.purchase.quotedTotal }
    return self.purchase.costOf(self.count) ?? 0
  }

  // From the player's click alone.
  onBuy(mut self) { _ = self.purchase.buy(peek self.count) }

  // The quantity on the shopping list, as the player's own line.
  onList(mut self) { self.shopping.add(self.found.item, peek self.count, .ByHand) }

  public render(self): Template {
    return $ltml {
      <ItemPanel item={self.found.item} name={self.found.name} color={self.found.color} detail={self.detail}
                 house={self.house} prices={self.prices} history={self.history}>
        <box rows={PANEL} gap={space(.Item)}>
          <box rows={FILL} border={Style.FRAME} background={Style.LISTS_BACK}>
            <Table columns={LISTING_COLUMNS} sorted={mut self.listSorted} descending={mut self.listDescending}>
              <ListingRow $for={index, listing of self.listings} $key={index} listing={peek listing}
                          index={index} first={self.first} last={self.last} />
            </Table>
          </box>
          <box columns={PAIR} gap={space(.Item)} yAlign={Align.Center}>
            <text value={Locale.QUANTITY} textColor={Style.INK} />
            <CountInput $if={self.commodity} value={mut self.count} least={1} most={MOST_COUNT} step={STEP} />
            <text $else value={self.auctionCount} textColor={Style.INK} />
            <text value={Locale.TOTAL} textColor={Style.INK} />
            <box xAlign={Align.End}>
              <Money amount={self.total} />
            </box>
          </box>
          <box>
            <text $if={self.refused} value={self.refusedText} textColor={Style.RED} textSize={.Secondary} />
          </box>
          <PushButton label={self.buyLabel} width={Style.PANEL_BUTTON} accent={true} disabled={!self.canBuy}
                      @click={self.onBuy} />
          <PushButton label={Locale.TO_LIST} width={Style.PANEL_BUTTON} @click={self.onList} />
        </box>
      </ItemPanel>
    }
  }
}

// Whether `a` comes before `b` by the column, cheapest, fewest, first by name and youngest first.
function before(a: Found, b: Found, column: Integer): Boolean {
  if (column == NAME_COLUMN) { return a.name < b.name }
  if (column == LISTED_COLUMN) { return a.listed < b.listed }
  if (column == LOW_COLUMN) { return a.low < b.low }
  if (column == MARKET_COLUMN) { return (a.market?.copper() ?? 0) < (b.market?.copper() ?? 0) }
  if (column == SHARE_COLUMN) { return (a.share ?? 0) < (b.share ?? 0) }
  return (a.market?.seen() ?? 0) > (b.market?.seen() ?? 0)
}
