// «Buy» (design `auction`): a search by name and three filters (class, level, quality) sent to the house, and what the
// house showed last (ours, the shopping list's «Search all», or the game's), each item with its markers, how many are
// listed, its lowest price for one, its market, the lowest as a share of the market (green under 90%, red over 100%)
// and the price's age. A row picked: at the right its listings, a quantity, the total, «Buy» (the client's from a
// click alone) and «Add to shopping list».
import Game from "$game"
import { Align, Edges, Track } from "$ltml"
import { Age, Choice, Column, CompactDropdown, Component, Copper, CountInput, CountLook, ItemButton, ItemId, Money, PushButton, PX, Table, TableRow, tracksOf } from "Ordaen"
import { House } from "@/house"
import Locale from "@/locales"
import { Purchase } from "@/purchase"
import { PriceKey, PriceSource, Quote } from "@/quote"
import { ShoppingList } from "@/shopping"
import Style from "@/style"
import { leftText } from "@/style"

// One item the house showed, as its row draws it.
public struct Found {
  key: PriceKey
  item: ItemId
  name: String
  color: Color
  listed: Integer
  low: Copper
  market: Quote | nil
  // The lowest as a share of the market, in percent; none without a market.
  share: Integer | nil
}

const NAME_COLUMN = 1
const LISTED_COLUMN = 3
const LOW_COLUMN = 4
const MARKET_COLUMN = 5
const SHARE_COLUMN = 6

const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_ITEM, width: { fr: 1 }, sortable: true },
  { title: "", width: 44 * PX },
  { title: Locale.COLUMN_LISTED, width: 90 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_LOW, width: 96 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_MARKET, width: 90 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_SHARE, width: 56 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_AGE, width: 70 * PX, align: Align.End, sortable: true },
]
const TRACKS: Array<Track> = tracksOf(COLUMNS)
const LISTING_COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_UNIT, width: { fr: 1 }, align: Align.End },
  { title: Locale.COLUMN_COUNT, width: 48 * PX, align: Align.End },
  { title: Locale.COLUMN_LEFT, width: 56 * PX, align: Align.End },
]
const LISTING_TRACKS: Array<Track> = tracksOf(LISTING_COLUMNS)
const PAGE: Array<Track> = [{ fr: 1 }, Style.BUY_PANEL]
// The search box takes what the three filters leave of the page's width.
const TOOLS: Array<Track> = [{ fr: 1 }, 150 * PX, 130 * PX, 130 * PX]
const ITEM: Array<Track> = ["auto", { fr: 1 }]
const PAIR: Array<Track> = [{ fr: 1 }, "auto"]
const FIELD_PAD: Edges = { right: 10 * PX, left: 10 * PX }
const FIELD_BACK: Color = Color.hex("#00000080")
// The most of a commodity the quantity takes: the shopping list takes more than is listed, so the listings don't bound
// it («Buy» asks that they hold it); six digits fill the field.
const MOST_COUNT = 999999
const PANEL_BUTTON = 208 * PX
// The pip of an item on the shopping list.
const LISTED_PIP: Color = Color.hex("#40c0ff")
// The share's colours: a bargain under 90% of the market, dear over 100%.
const CHEAP = 90
const DEAR = 100

// The class filter: every class, or one the client numbers (`C_Item.GetItemInfoInstant`'s sixth value).
const ANY = -1
const CLASSES: Array<Choice<Integer>> = [
  { value: ANY, label: Locale.ALL_CLASSES },
  { value: 7, label: Locale.CLASS_TRADE },
  { value: 2, label: Locale.CLASS_WEAPON },
  { value: 4, label: Locale.CLASS_ARMOR },
  { value: 0, label: Locale.CLASS_CONSUMABLE },
]
// The level filter: any, or a band of ten levels by its first (1, 11, ... 51).
const LEVELS: Array<Choice<Integer>> = [
  { value: ANY, label: Locale.ANY_LEVEL },
  { value: 1, label: Locale.LEVELS.format(1, 10) },
  { value: 11, label: Locale.LEVELS.format(11, 20) },
  { value: 21, label: Locale.LEVELS.format(21, 30) },
  { value: 31, label: Locale.LEVELS.format(31, 40) },
  { value: 41, label: Locale.LEVELS.format(41, 50) },
  { value: 51, label: Locale.LEVELS.format(51, 60) },
]
const QUALITIES: Array<Choice<Integer>> = [
  { value: ANY, label: Locale.ANY_QUALITY },
  { value: 1, label: Locale.QUALITY_COMMON },
  { value: 2, label: Locale.QUALITY_UNCOMMON },
  { value: 3, label: Locale.QUALITY_RARE },
  { value: 4, label: Locale.QUALITY_EPIC },
]

// What the game says of an item: its name and its quality's colour, from its tooltip's first line.
public function nameOf(item: Integer): (String, Color) {
  const data = Game.items.tooltip(item)
  const first = data != nil ? data.lines[1] : nil
  if (first == nil) { return Locale.UNKNOWN_ITEM.format(item), Style.INK }
  return first.left ?? Locale.UNKNOWN_ITEM.format(item), first.quality ?? first.leftColor ?? Style.INK
}

// An age in seconds, as the `Age` control reads one; none without a price.
public function ageOf(quote: Quote | nil): Number | nil {
  if (quote == nil) { return nil }
  return quote.age() * 3600
}

// The share's colour: green for a bargain, red where dear, the ink between.
function shareColor(share: Integer | nil): Color {
  if (share == nil) { return Style.DIM }
  if (share < CHEAP) { return Style.GREEN }
  if (share > DEAR) { return Style.RED }
  return Style.INK
}

// One row. Its name is cut where its column is narrower than it, so a long name never pushes the table past the page.
class FoundRow implements Component {
  public pick: Event<PriceKey> = new Event()

  derived age: Number | nil = ageOf(self.found.market)
  derived priced: Boolean = self.found.market != nil
  derived market: Integer = self.found.market?.copper() ?? 0
  derived share: String = self.found.share != nil ? "%d%%".format(self.found.share) : "—"
  derived shareInk: Color = shareColor(self.found.share)

  const found: Found
  selected: Signal<Boolean>
  wanted: Signal<Boolean>
  constructor(found: Found, selected: Signal<Boolean>, wanted: Signal<Boolean>) {
    self.found = found
    self.selected = selected
    self.wanted = wanted
  }

  onPick(self) { self.pick.emit(self.found.key) }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={TRACKS} selected={self.selected} @pick={self.onPick}>
        <box columns={ITEM} gap={8 * PX} yAlign={Align.Center}>
          <ItemButton item={self.found.item} size={Style.SLOT} />
          <box overflow={.Hidden}>
            <text value={self.found.name} textColor={self.found.color} wrap={false} />
          </box>
        </box>
        <box yAlign={Align.Center}>
          <box $if={self.wanted} width={8 * PX} height={8 * PX} background={LISTED_PIP} />
        </box>
        <box xAlign={Align.End}>
          <text value={"%d"} arguments={[self.found.listed]} textColor={Style.INK} />
        </box>
        <box xAlign={Align.End}>
          <Money amount={self.found.low} />
        </box>
        <box xAlign={Align.End}>
          <Money $if={self.priced} amount={self.market} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.share} textColor={self.shareInk} />
        </box>
        <box xAlign={Align.End}>
          <Age seconds={self.age} />
        </box>
      </TableRow>
    }
  }
}

public class BuyPage implements Component {
  state search = ""
  state itemClass = ANY
  state level = ANY
  state quality = ANY
  state sorted = 0
  state descending = false
  state picked: PriceKey | nil = nil
  // What the house was last searched for, as `wanted` says it.
  state sent = ""
  derived rows: Array<Found> = self.found()
  // The row picked, while it is shown: one or none.
  derived chosen: Array<Found> = self.chosenOf()
  derived searching: Boolean = self.search != ""
  derived filtered: Boolean = self.itemClass != ANY || self.level != ANY || self.quality != ANY
  derived wanted: String = "%s|%d|%d|%d".format(self.search, self.itemClass, self.level, self.quality)
  derived empty: String = self.items > 0 ? Locale.NO_RESULTS : Locale.NO_PRICES_FIND

  const house: House
  const prices: any PriceSource
  offers: Signal<Array<Game.Offer>>
  items: Signal<Integer>
  // The shopping list: its items marked, the row picked added to it.
  shopping: mut ShoppingList
  constructor(
    house: House,
    prices: any PriceSource,
    // What the house showed last.
    offers: Signal<Array<Game.Offer>>,
    // How many items the house's prices cover.
    items: Signal<Integer>,
    shopping: mut ShoppingList,
  ) {
    self.house = house
    self.prices = prices
    self.offers = offers
    self.items = items
    self.shopping = shopping
    self.sent = peek self.wanted
    // The box or a filter moved: the house searched as soon as it takes a query; what is typed meanwhile is sent
    // whole after.
    watch {
      const wanted = self.wanted
      if (wanted != peek self.sent && (self.searching || self.filtered) && Game.auctionQuery.ready) {
        if (Game.auctionQuery.search(peek self.search, peek self.filters())) { self.sent = wanted }
      }
    }
  }

  filters(self): Game.SearchFilters {
    const level = self.level
    return {
      itemClass: self.itemClass != ANY ? self.itemClass : nil,
      itemSubclass: nil,
      minLevel: level != ANY ? level : nil,
      maxLevel: level != ANY ? level + 9 : nil,
      qualities: self.quality != ANY ? [self.quality] : [],
    }
  }

  found(self): Array<Found> {
    _ = self.prices.revision
    const sought = self.search.lower()
    let list: Array<Found> = []
    for (offer of self.offers) {
      const key = PriceKey.given(offer.key)
      const item = key.item()
      const name, color = nameOf(item)
      if (sought == "" || name.lower().contains(sought)) {
        const market = self.house.quote(key)
        const share = market != nil && market.copper() > 0 ? (offer.copper * 100 / market.copper()).round() : nil
        list.push({
          key: key, item: item, name: name, color: color, listed: offer.quantity, low: Copper.of(offer.copper),
          market: market, share: share,
        })
      }
    }
    const column = self.sorted
    const down = self.descending
    if (column != 0) { list.sort((a, b) => down ? before(b, a, column) : before(a, b, column)) }
    return list
  }

  chosenOf(self): Array<Found> {
    const picked = self.picked
    const row = picked != nil ? self.rows.find(row => row.key == picked) : nil
    return row != nil ? [row] : []
  }

  onPick(mut self, key: PriceKey) { self.picked = key }

  public render(self): Template {
    return $ltml {
      <box columns={PAGE} gap={Style.GAP}>
        <box rows={["auto", "auto", { fr: 1 }]} gap={8 * PX}>
          <box columns={TOOLS} gap={8 * PX} yAlign={Align.Center}>
            <box height={30 * PX} rows={[{ fr: 1 }]}>
              <input value={mut self.search} padding={FIELD_PAD} textColor={Style.INK}
                     background={FIELD_BACK} border={Style.FRAME} />
              <box $if={!self.searching} position={.Absolute} left={0} top={0} right={0} bottom={0}
                   padding={FIELD_PAD} yAlign={Align.Center}>
                <text value={Locale.SEARCH} textColor={Style.DIM} wrap={false} />
              </box>
            </box>
            <CompactDropdown value={mut self.itemClass} choices={CLASSES} width={150 * PX} />
            <CompactDropdown value={mut self.level} choices={LEVELS} width={130 * PX} />
            <CompactDropdown value={mut self.quality} choices={QUALITIES} width={130 * PX} />
          </box>
          <Table columns={COLUMNS} sorted={mut self.sorted} descending={mut self.descending} height={Style.LIST}>
            <FoundRow $for={row of self.rows} $key={row.key} found={peek row} selected={self.picked == row.key}
                      wanted={self.shopping.needed[row.item] != nil} @pick={self.onPick} />
          </Table>
          <text $if={self.rows.length == 0} value={self.empty} textColor={Style.DIM} />
        </box>
        <box rows={["auto"]} gap={10 * PX} padding={10 * PX} border={Style.FRAME} background={Style.LISTS_BACK}>
          <text $if={self.chosen.length == 0} value={Locale.PICK_ROW} textColor={Style.DIM} />
          <Chosen $for={found of self.chosen} $key={found.key} found={peek found} shopping={mut self.shopping} />
        </box>
      </box>
    }
  }
}

// The time a listing has left, where the client says it.
function leftOf(seconds: Integer | nil): String {
  return seconds != nil ? leftText(seconds) : "—"
}

// One listing of the picked item: its price for one, how many, the time left; marked where the next click buys
// from it (its place within `first` to `last`).
class ListingRow implements Component {
  derived left: String = leftOf(self.listing.left)
  derived selected: Boolean = self.index >= self.first && self.index <= self.last

  const listing: Game.Listing
  const index: Integer
  first: Signal<Integer>
  last: Signal<Integer>
  constructor(listing: Game.Listing, index: Integer, first: Signal<Integer>, last: Signal<Integer>) {
    self.listing = listing
    self.index = index
    self.first = first
    self.last = last
  }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={LISTING_TRACKS} selected={self.selected}>
        <box xAlign={Align.End}>
          <Money amount={self.listing.unit} />
        </box>
        <box xAlign={Align.End}>
          <text value={"%d"} arguments={[self.listing.quantity]} textColor={Style.INK} wrap={false} />
        </box>
        <box xAlign={Align.End}>
          <text value={self.left} textColor={Style.INK} wrap={false} />
        </box>
      </TableRow>
    }
  }
}

// The row picked: its listings (those the next click buys from marked), a quantity of a commodity (an item's
// auction is bought whole), the total, «Buy» (a commodity's second click confirms the price the client gave) and
// «Add to shopping list».
class Chosen implements Component {
  state count = 1
  state listSorted = 0
  state listDescending = false
  derived listings: Array<Game.Listing> = self.purchase.listings ?? []
  derived commodity: Boolean = self.purchase.commodity
  // The listings the next click buys from: a commodity's first so many, an item's one auction.
  derived first: Integer = self.commodity ? 1 : self.purchase.next
  derived last: Integer = self.commodity ? self.purchase.coveredBy(self.count) : self.purchase.next
  derived refused: Boolean = self.purchase.refused != nil
  derived refusedText: String = self.purchase.refused ?? ""
  derived auction: Game.Listing | nil = self.listings[self.purchase.next]
  derived quoted: Boolean = self.purchase.quotedCount > 0 && self.purchase.quotedCount == self.count
  derived total: Integer = self.totalOf()
  derived buyLabel: String = self.quoted ? Locale.CONFIRM : Locale.BUY
  derived canBuy: Boolean = !Game.auctionActions.busy && (self.commodity ? self.count <= self.purchase.held :
      self.auction != nil)
  derived auctionCount: String = String.of(self.auction?.quantity ?? 0)

  const found: Found
  purchase: mut Purchase
  shopping: mut ShoppingList
  constructor(found: Found, shopping: mut ShoppingList) {
    self.found = found
    self.shopping = shopping
    self.purchase = new Purchase(found.key)
  }

  totalOf(self): Integer {
    if (!self.commodity) { return self.auction?.buyout ?? 0 }
    if (self.quoted) { return self.purchase.quotedTotal }
    return self.purchase.costOf(self.count) ?? 0
  }

  // From the player's click alone.
  onBuy(mut self) { _ = self.purchase.buy(peek self.count) }

  // The quantity on the shopping list, as the player's own line.
  onList(mut self) { self.shopping.add(self.found.item, peek self.count, .ByHand) }

  public render(self): Template {
    return $ltml {
      <box rows={["auto"]} gap={10 * PX}>
        <box columns={ITEM} gap={10 * PX} yAlign={Align.Center}>
          <ItemButton item={self.found.item} size={Style.BIG_SLOT} />
          <text value={self.found.name} textColor={self.found.color} textSize={.Title} />
        </box>
        <Table columns={LISTING_COLUMNS} sorted={mut self.listSorted} descending={mut self.listDescending}
               height={Style.LISTINGS}>
          <ListingRow $for={index, listing of self.listings} $key={index} listing={peek listing}
                      index={index} first={self.first} last={self.last} />
        </Table>
        <box columns={PAIR} gap={8 * PX} yAlign={Align.Center}>
          <text value={Locale.QUANTITY} textColor={Style.INK} />
          <box $if={self.commodity} width={80 * PX} height={30 * PX} rows={[{ fr: 1 }]}>
            <CountInput value={mut self.count} least={1} most={MOST_COUNT} look={CountLook.Field} />
          </box>
          <text $else value={self.auctionCount} textColor={Style.INK} />
          <text value={Locale.TOTAL} textColor={Style.INK} />
          <box xAlign={Align.End}>
            <Money amount={self.total} />
          </box>
        </box>
        <text $if={self.refused} value={self.refusedText} textColor={Style.RED} textSize={.Secondary} />
        <PushButton label={self.buyLabel} width={PANEL_BUTTON} accent={true} disabled={!self.canBuy}
                    @click={self.onBuy} />
        <PushButton label={Locale.TO_LIST} width={PANEL_BUTTON} @click={self.onList} />
      </box>
    }
  }
}

// Whether `a` comes before `b` by the column, cheapest, fewest, first by name and youngest first.
function before(a: Found, b: Found, column: Integer): Boolean {
  if (column == NAME_COLUMN) { return a.name < b.name }
  if (column == LISTED_COLUMN) { return a.listed < b.listed }
  if (column == LOW_COLUMN) { return a.low < b.low }
  if (column == MARKET_COLUMN) { return (a.market?.copper() ?? 0) < (b.market?.copper() ?? 0) }
  if (column == SHARE_COLUMN) { return (a.share ?? 0) < (b.share ?? 0) }
  return (a.market?.seen() ?? 0) > (b.market?.seen() ?? 0)
}
