// The item panel: one layout on «Buy» and on «Sell»; its chart of the item's price, the day an hour a bar, the week and
// the month a day a bar, from the history as it is kept (the last day by the hour, the days before by their lowest);
// with no history, it says so.
import Game from "$game"
import Test from "$test"
import { Hour } from "Ordaen"
import root Auction from "OrdaenAuction"
import { HourPrice, PriceHistory } from "@/history"
import { PriceKey } from "@/quote"

// 2026-09-21, in the server's seconds: a whole hour.
const START = 1790002800
const LINEN: Integer = 2589
const PAGE: Test.Page = { left: 0, top: 0, width: 1200, height: 800, screen: true }

// A history as the scan keeps it: these points, whatever the item.
class Kept implements PriceHistory {
  public state revision = 0
  const points: Array<HourPrice>
  constructor(points: Array<HourPrice>) { self.points = points }
  public hours(self, key: PriceKey, from: Hour, to: Hour): Array<HourPrice> {
    return self.points.filter(point => point.hour >= from && point.hour <= to)
  }
}

function names(id: Integer): Game.TooltipData | nil {
  if (id != LINEN) { return nil }
  return { lines: [{ left: "Linen Cloth", kind: 0 }] }
}

test "with no history the chart says so, on «Buy» and on «Sell» alike" {
  Game.clock.server = START
  Test.mount(nil, PAGE)
  Game.items.tooltip = names
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  Test.pass(0.02)
  Test.click(Test.holding("Linen Cloth", nil), nil)
  Test.pass(0.02)
  // Found, or the test fails here.
  _ = Test.holding("No price history yet.", nil)
  Game.auctionActions.sellable = (): Array<Game.Sellable> | nil => [
    { item: LINEN, count: 20, bag: 0, slot: 1, commodity: true },
  ]
  Auction.page = 2
  Test.pass(0.02)
  Test.click(Test.holding("Linen Cloth", nil), nil)
  Test.pass(0.02)
  Test.shot("«Sell»: linen picked, the panel as «Buy» has it, no history")
  Game.auctionHouse.open = false
  Test.pass(0.02)
}

test "the chart: the day a bar an hour, the week and the month a bar a day" {
  Game.clock.server = START
  const now = Hour.now()
  Test.mount(nil, PAGE)
  // The last day by the hour (three hours seen), the days before by their lowest.
  Auction.history = new Kept([
    { hour: now.after(-40 * 24), copper: 10 },
    { hour: now.after(-20 * 24), copper: 60 },
    { hour: now.after(-3 * 24), copper: 40 },
    { hour: now.after(-2 * 24), copper: 30 },
    { hour: now.after(-5), copper: 44 },
    { hour: now.after(-1), copper: 38 },
    { hour: now, copper: 36 },
  ])
  Game.items.tooltip = names
  Game.auctionHouse.open = true
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  Test.pass(0.02)
  Test.click(Test.holding("Linen Cloth", nil), nil)
  Test.pass(0.02)
  Test.shot("the day: three hours priced, the last gold; 36 to 44")
  Test.click(Test.holding("Week", nil), nil)
  Test.pass(0.02)
  Test.shot("the week: three days priced; 30 to 40")
  Test.click(Test.holding("Month", nil), nil)
  Test.pass(0.02)
  Test.shot("the month: four days priced, the one 40 days old left out; 30 to 60")
  Game.auctionHouse.open = false
  Test.pass(0.02)
  Auction.history = nil
}
