// «Buy» with a browse's rows, sorted, searched on the house by name and filters, a row picked and its listings asked,
// a commodity bought in two clicks and an item's auction bought out from a click. The house is browsed twice, shut,
// and opened again a day after the second browse, so each market is a day old.
import Game from "$game"
import { Key } from "$ltml"
import Test from "$test"
import Wow from "LunaTypeRenderer"
import { ItemId } from "Ordaen"
import root Auction from "OrdaenAuction"
import root Ordaen from "Ordaen"

// 2026-09-21, in the server's seconds: a whole hour.
const START = 1790002800
const HOUR = 3600
const COPPER_ORE: Integer = 2770
const LINEN: Integer = 2589
const AXE: Integer = 2847

function names(id: Integer): Game.TooltipData | nil {
  const name = id == LINEN ? "Linen Cloth" : id == COPPER_ORE ? "Copper Ore" : id == AXE ? "Bronze Axe" : nil
  if (name == nil) { return nil }
  return { lines: [{ left: name, kind: 0 }] }
}

// The searches the house was asked for: how many, and the last one's text, class and subclass.
class Searches {
  public count = 0
  public text = ""
  public itemClass = -1
  public itemSubclass = -1

  public heard(mut self, text: String, filters: Game.SearchFilters): Boolean {
    self.count += 1
    self.text = text
    self.itemClass = filters.itemClass ?? -1
    self.itemSubclass = filters.itemSubclass ?? -1
    return true
  }
}

// The game's tooltips asked for: how many.
class Tooltips {
  public count = 0

  public of(mut self, id: Integer): Game.TooltipData | nil {
    self.count += 1
    return names(id)
  }
}

// Each test opens the house with linen and copper ore shown, ready for a query, and counts the searches it is asked.
test "typing: ten keys a tenth of a second apart are one search, once the typing settles; Enter searches at once" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1200, height: 800, screen: true })
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.items.tooltip = names
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: COPPER_ORE, copper: 90, quantity: 40 }])
  Test.pass(0.02)
  let searches = new Searches()
  Game.auctionQuery.search = (text: String, filters: Game.SearchFilters): Boolean => searches.heard(text, filters)
  // The names are the house's, lowercased once: a search asks the game for none.
  let tooltips = new Tooltips()
  Game.items.tooltip = (id: Integer): Game.TooltipData | nil => tooltips.of(id)
  Test.click(Test.field(1), nil)
  for (letter of ["c", "o", "p", "p", "e", "r", " ", "o", "r", "e"]) {
    Test.type(letter)
    Test.pass(0.1)
  }
  Test.expect(searches.count == 0)
  Test.pass(0.3)
  Test.expect(searches.count == 1 && searches.text == "copper ore")
  Test.expect(tooltips.count == 0)
  Test.shot("ten keys, then the typing settled: one search, for «copper ore»; the rows are copper ore's")
  Test.click(Test.field(1), nil)
  Test.erase(4)
  _ = Test.key(Key.Enter)
  Test.expect(searches.count == 2 && searches.text == "copper")
  Test.pass(0.3)
  Test.expect(searches.count == 2)
  Game.auctionQuery.ready = false
  Game.auctionHouse.open = false
  Test.pass(0.02)
}

test "the age column: «< 1 h» for this hour's price, the hours under a day, the market's days from one" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1200, height: 800, screen: true })
  Game.auctionHouse.open = true
  Game.items.tooltip = names
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: COPPER_ORE, copper: 90, quantity: 40 }])
  Test.pass(0.02)
  Test.expect(Test.holding("< 1 h", nil).x > 0)
  Game.auctionHouse.open = false
  Test.pass(0.02)
  Game.clock.server = START + 5 * HOUR
  Game.auctionHouse.open = true
  Test.pass(0.02)
  Test.expect(Test.holding("5 h", nil).x > 0)
  Test.shot("five hours after the browse: each price 5 h old")
  Game.auctionHouse.open = false
  Test.pass(0.02)
}

test "the categories: a class picked shows its subclasses and loads the class, a subclass loads it, «All items» every one" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1200, height: 800, screen: true })
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.items.tooltip = names
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: COPPER_ORE, copper: 90, quantity: 40 }])
  Test.pass(0.02)
  let searches = new Searches()
  Game.auctionQuery.search = (text: String, filters: Game.SearchFilters): Boolean => searches.heard(text, filters)
  Test.shot("the categories at the left: every item, then each class the game's window lists")
  Test.click(Test.holding("Weapon", nil), nil)
  Test.pass(0.02)
  Test.expect(searches.count == 1 && searches.itemClass == 2 && searches.itemSubclass == -1)
  Test.shot("Weapon picked: its subclasses under it; the house searched for weapons")
  Test.click(Test.holding("Daggers", nil), nil)
  Test.pass(0.02)
  Test.expect(searches.count == 2 && searches.itemClass == 2 && searches.itemSubclass == 15)
  Test.click(Test.holding("All items", nil), nil)
  Test.pass(0.02)
  Test.expect(searches.count == 3 && searches.itemClass == -1)
  Test.shot("«All items» picked again: the subclasses folded; the house searched with no class")
  Game.auctionQuery.ready = false
  Game.auctionHouse.open = false
  Test.pass(0.02)
}

// A house of five thousand items, as a full scan shows the player's realm's: the list builds the rows in view, and
// the wheel moves those same rows over the others.
function many(id: Integer): Game.TooltipData | nil {
  return { lines: [{ left: "Ware %d".format(id), kind: 0 }] }
}

test "five thousand items: the list builds the rows in view, and fifty notches of the wheel build none" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1200, height: 800, screen: true })
  Game.auctionHouse.open = true
  Game.items.tooltip = many
  let offers: Array<Game.Offer> = []
  for (id of 1..=5000) { offers.push({ key: id, copper: id, quantity: 1 }) }
  const before = Wow.made()
  Game.auctionQuery.results.emit(offers)
  Test.pass(0.02)
  const built = Wow.made() - before
  Test.expect(built < 1000)
  Test.moveTo(Test.holding("Ware 2", nil))
  const told = Test.calls((): nil => { Test.wheel(-1) })
  Test.note(`a notch of the wheel, the client told: ${told}`)
  for (i of 1..=50) { Test.wheel(-1) }
  Test.expect(Wow.made() - before == built)
  Test.shot("fifty-one notches down: the same rows hold the wares now in view")
  Game.auctionQuery.ready = false
  Game.auctionHouse.open = false
  Test.pass(0.02)
}

test "«Buy»: the last browse's items with their market and share, sorted, searched by name and filters" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1200, height: 800, screen: true })
  Game.auctionHouse.open = true
  Game.items.tooltip = names
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 45, quantity: 12 }, { key: COPPER_ORE, copper: 90, quantity: 40 }])
  Game.clock.server = START + 30 * HOUR
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }, { key: COPPER_ORE, copper: 100, quantity: 25 }])
  Game.auctionHouse.open = false
  Game.clock.server = START + 54 * HOUR
  Game.auctionHouse.open = true
  Test.pass(0.02)
  Test.shot("two items: listed, lowest, market, the lowest's share of it (green under 90%, red over 100%), a day old")
  Test.click(Test.holding("Lowest", nil), nil)
  Test.shot("sorted by the lowest: linen first")
  Test.click(Test.field(1), nil)
  Test.type("lin")
  Test.pass(0.3)
  Test.note("the typing settled, the house busy: nothing sent yet")
  Game.auctionQuery.ready = true
  Test.pass(0.02)
  Test.shot("filtered: linen alone; the house searched for «lin» once it took a query")
  Game.auctionQuery.ready = false
  Test.click(Test.painted(Ordaen.art.ctl.tool.filter, nil), nil)
  Test.shot("the filter's menu under the funnel: the classes, the level bands, the qualities, each under a rule")
  Test.click(Test.holding("Uncommon", nil), nil)
  Game.auctionQuery.ready = true
  Test.pass(0.02)
  // A click anywhere else closes the menu; the funnel's Tip says what it lets through.
  Test.click({ x: 5, y: 5 }, nil)
  Test.moveTo(Test.painted(Ordaen.art.ctl.tool.filter, nil))
  Test.flush()
  Test.expect(Test.surfaces().any(shown => shown.texts.join("|") == "Filter|Any level, Uncommon"))
  Game.auctionQuery.ready = false
  Game.auctionHouse.open = false
  Test.pass(0.02)
  Test.shot("the quality picked: searched again with it; the house shut")
}

test "a commodity picked: its listings asked, a quantity priced by the client, then bought; a list line added" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1200, height: 800, screen: true })
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.items.tooltip = names
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  Test.pass(0.02)
  Test.click(Test.holding("Linen Cloth", nil), nil)
  Test.pass(0.02)
  Game.auctionQuery.listed.emit(LINEN, [
    { auction: 0, unit: 36, quantity: 10, left: 7200, own: false, commodity: true },
    { auction: 0, unit: 40, quantity: 20, left: 86400, own: false, commodity: true },
  ])
  Test.pass(0.02)
  // The counter: Shift steps 10, then one a click.
  Game.input.shiftDown = (): Boolean => true
  Test.click(Test.holding("+", nil), nil)
  Game.input.shiftDown = (): Boolean => false
  Test.click(Test.holding("+", nil), nil)
  Test.click(Test.holding("+", nil), nil)
  Test.click(Test.holding("+", nil), nil)
  Test.click(Test.holding("+", nil), nil)
  Test.pass(0.02)
  Test.shot("15 of linen: both listings marked, 10 at 36 and 5 at 40")
  Test.click(Test.holding("Buy", nil), nil)
  Game.auctionActions.answered.emit(.Quoted { item: LINEN, quantity: 15, total: 570 })
  Test.pass(0.02)
  Test.shot("the client's price for 15: «Confirm»")
  Test.click(Test.holding("Confirm", nil), nil)
  Game.auctionActions.answered.emit(.Bought)
  Test.pass(0.02)
  Test.click(Test.holding("Add to shopping list", nil), nil)
  Test.pass(0.02)
  Test.expect(Auction.shopping.needed[ItemId.of(LINEN)] == 15)
  Game.auctionQuery.ready = false
  Game.auctionHouse.open = false
  Test.pass(0.02)
  Test.shot("bought: the listings asked again; 15 on the list; the house shut")
}

test "an item picked: its cheapest auction with a buyout bought out from a click; a refusal said" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1200, height: 800, screen: true })
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.items.tooltip = names
  Game.auctionQuery.results.emit([{ key: AXE, copper: 2100, quantity: 3 }])
  Test.pass(0.02)
  Test.click(Test.holding("Bronze Axe", nil), nil)
  Test.pass(0.02)
  Game.auctionQuery.listed.emit(AXE, [
    { auction: 71, unit: 0, quantity: 1, bid: 1500, left: 3600, own: false, commodity: false },
    { auction: 72, unit: 2100, quantity: 1, buyout: 2100, left: 7200, own: true, commodity: false },
    { auction: 73, unit: 2200, quantity: 1, buyout: 2200, left: 7200, own: false, commodity: false },
  ])
  Test.pass(0.02)
  Test.shot("the axe: a bid alone, the player's own, then the one the click buys out")
  Test.click(Test.holding("Buy", nil), nil)
  Game.auctionActions.answered.emit(.Refused { reason: "You don't have enough money" })
  Test.pass(0.02)
  Test.shot("refused: the client's words")
  Game.auctionQuery.ready = false
  Game.auctionHouse.open = false
}

// The player's case: a warhammer whose random suffixes are variants of their own, three of them on the house. A key is
// the item's id and its suffix × 2^20.
const WARHAMMER: Integer = 15216
const SUFFIXED: Integer = 1048576
const BEAR: Integer = 1017
const EAGLE: Integer = 1018
const MONKEY: Integer = 1019

function hammer(id: Integer): Game.TooltipData | nil {
  if (id == WARHAMMER) { return { lines: [{ left: "Sergeant's Warhammer", kind: 0 }] } }
  return names(id)
}

function variants(id: Integer, suffix: Integer): Game.TooltipData | nil {
  if (id != WARHAMMER) { return nil }
  const of = suffix == BEAR ? "the Bear" : suffix == EAGLE ? "the Eagle" : suffix == MONKEY ? "the Monkey" : nil
  if (of == nil) { return nil }
  return { lines: [{ left: "Sergeant's Warhammer of %s".format(of), kind: 0 }] }
}

test "variants: each named with its suffix, each with its own lowest and its share of its own market; folded, one row" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1400, height: 800, screen: true })
  Game.auctionHouse.open = true
  Game.items.tooltip = hammer
  Game.items.variant = variants
  // A day apart: each variant's market its own, the second browse's lowest mostly 9 s 33 c, the monkey's 12 s 50 c.
  Game.auctionQuery.results.emit([
    { key: WARHAMMER + BEAR * SUFFIXED, copper: 1100, quantity: 2 },
    { key: WARHAMMER + EAGLE * SUFFIXED, copper: 800, quantity: 1 },
    { key: WARHAMMER + MONKEY * SUFFIXED, copper: 1500, quantity: 1 },
  ])
  Game.clock.server = START + 24 * HOUR
  Game.auctionQuery.results.emit([
    { key: WARHAMMER + BEAR * SUFFIXED, copper: 933, quantity: 3 },
    { key: WARHAMMER + EAGLE * SUFFIXED, copper: 933, quantity: 1 },
    { key: WARHAMMER + MONKEY * SUFFIXED, copper: 1250, quantity: 2 },
  ])
  Test.pass(0.02)
  Test.expect(Test.holding("Sergeant's Warhammer of the Bear", nil).y < Test.holding("Sergeant's Warhammer of the Eagle", nil).y)
  Test.expect(Test.holding("Sergeant's Warhammer of the Monkey", nil).x > 0)
  Test.shot("three variants: each named with its suffix, its own lowest, its own market and its share of it")
  Test.click(Test.painted(Ordaen.art.ctl.tool.list, nil), nil)
  Test.click(Test.holding("One row an item", nil), nil)
  Test.pass(0.02)
  Test.expect(Test.holding("Sergeant's Warhammer", nil).x > 0)
  Test.shot("one row an item: the warhammer once, 6 listed, its lowest 9 s 33 c to 12 s 50 c")
  Game.auctionHouse.open = false
  Test.pass(0.02)
}

// The auctions bought out: the last one's number, each taken from the player's own click alone.
class Bids {
  public last = 0

  public heard(mut self, auction: Integer, copper: Integer): Boolean {
    Test.input("AuctionActions.bid", auction, copper)
    self.last = auction
    return true
  }
}

test "a row right-clicked: its menu under it; «Buy at the best price» buys its cheapest auction out from the click" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1200, height: 800, screen: true })
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.items.tooltip = names
  let bids = new Bids()
  Game.auctionActions.bid = (auction: Integer, copper: Integer): Boolean => bids.heard(auction, copper)
  Game.auctionQuery.results.emit([{ key: AXE, copper: 2100, quantity: 3 }])
  Test.pass(0.02)
  Test.click(Test.holding("Bronze Axe", nil), .Right)
  Test.pass(0.02)
  Game.auctionQuery.listed.emit(AXE, [
    { auction: 72, unit: 2100, quantity: 1, buyout: 2100, left: 7200, own: true, commodity: false },
    { auction: 73, unit: 2200, quantity: 1, buyout: 2200, left: 7200, own: false, commodity: false },
  ])
  Test.pass(0.02)
  Test.shot("the menu under the row: «Buy at the best price», then «Add to shopping list» and «Search for this item»")
  Test.click(Test.holding("Buy at the best price", nil), nil)
  Test.pass(0.02)
  Test.expect(bids.last == 73)
  Test.expect(!Test.surfaces().any(shown => shown.texts.any(text => text == "Search for this item")))
  Game.auctionActions.answered.emit(.Bought)
  Test.click(Test.holding("Bronze Axe", nil), .Right)
  Test.pass(0.02)
  // The second: the first is the card's button.
  Test.click(Test.holding("Add to shopping list", 2), nil)
  Test.pass(0.02)
  Test.expect(Auction.shopping.needed[ItemId.of(AXE)] == 1)
  Game.auctionQuery.ready = false
  Game.auctionHouse.open = false
  Test.pass(0.02)
}

test "the card beside the list in a window not full screen: the window grows to hold it" {
  Game.clock.server = START
  Test.mount(nil, { left: 0, top: 0, width: 1600, height: 900, screen: true })
  Game.auctionHouse.open = true
  Game.items.tooltip = names
  Game.auctionQuery.results.emit([{ key: LINEN, copper: 36, quantity: 30 }])
  Test.pass(0.02)
  Test.moveTo(Test.holding("Linen Cloth", nil))
  Test.flush()
  Test.click(Test.painted(Ordaen.art.ctl.corner.contract, nil), nil)
  Test.pass(0.02)
  const narrow = Test.surfaceHolding("Linen Cloth").x
  Test.click(Test.holding("Linen Cloth", nil), nil)
  Test.pass(0.02)
  Test.shot("a row picked: the card at the body's right, the window wider and every box inside it")
  Test.expect(Test.surfaceHolding("Linen Cloth").x > narrow)
  Game.auctionHouse.open = false
  Test.pass(0.02)
}
