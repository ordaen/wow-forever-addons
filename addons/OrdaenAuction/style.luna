// The house window's look, shared by its parts: sizes at the player's scale, colours, and how a time is said, as the
// professions window has them. A text's size is a step of the ladder (`$ltml`'s `TextSize`).
import { Edges, Line, Side } from "$ltml"
import { number, plural, PX, space } from "Ordaen"
import Locale from "@/locales"

// The window's body while it isn't full screen (it opens full screen), and the windows docked at the screen's right
// («Shopping list», «My auctions»).
public const WIDTH: Number = 1060 * PX
public const HEIGHT: Number = 700 * PX
public const SIDE_WIDTH: Number = 600 * PX
// An item's slot in a row, and the chosen item's.
public const SLOT: Number = 24 * PX
public const BIG_SLOT: Number = 40 * PX
// A table's row (`Table`'s `rowHeight`) with an item's slot, and one with a button: the row's padding round them.
public const ITEM_ROW: Number = SLOT + 8 * PX
public const BUTTON_ROW: Number = 42 * PX
// A list's note where it has no rows: a row of the list itself, its text in the row's middle (`yAlign`), a panel's
// space at its sides.
public const NOTE_PAD: Edges = { left: space(.Panel), right: space(.Panel) }
// What the item's section at the window's right holds, how wide: «Buy»'s picked row, «Sell»'s.
public const PANEL: Number = 280 * PX
// The categories at «Buy»'s left.
public const CATEGORIES: Number = 220 * PX
// A button as wide as the section holds.
public const PANEL_BUTTON: Number = PANEL
// A button that opens a docked window, at the search's row's right end.
public const OPENER: Number = 150 * PX

public const INK: Color = Color.hex("#e8dcc4")
public const DIM: Color = Color.hex("#a3977f")
public const GOLD: Color = Color.hex("#ffd100")
public const RED: Color = Color.hex("#ff4040")
public const GREEN: Color = Color.hex("#40c040")
public const AMBER: Color = Color.hex("#ffb02e")
public const LISTS_BACK: Color = Color.hex("#0000004d")
public const FRAME: Line = { width: 1 * PX, color: Color.hex("#3e2f1d") }
public const RULE: Line = { width: 1 * PX, color: Color.hex("#3e2f1d"), sides: [Side.Bottom] }

const MINUTE = 60
const HOUR = 3600
const DAY = 86400

// How long ago, in the largest whole unit: «12 min ago», «2 h ago», «3 d ago»; under a minute «just now».
public function agoText(seconds: Integer): String {
  if (seconds < MINUTE) { return Locale.AGO_NOW }
  if (seconds < HOUR) { return Locale.AGO_MINUTES.format((seconds / MINUTE).floor()) }
  if (seconds < DAY) { return Locale.AGO_HOURS.format((seconds / HOUR).floor()) }
  return Locale.AGO_DAYS.format((seconds / DAY).floor())
}

// How many items, as the game's language says the number: «1 item», «6 412 items».
public function itemsText(count: Integer): String {
  return plural(count, Locale.ITEMS_ONE, Locale.ITEMS_FEW, Locale.ITEMS_MANY).format(number(count))
}

// How many auctions: «1 auction», «31 870 auctions».
public function auctionsText(count: Integer): String {
  return plural(count, Locale.AUCTIONS_ONE, Locale.AUCTIONS_FEW, Locale.AUCTIONS_MANY).format(number(count))
}

// How long is left, rounded up to a whole minute, or an hour past one: «9 min», «2 h».
public function leftText(seconds: Integer): String {
  if (seconds <= HOUR) { return Locale.LEFT_MINUTES.format((seconds / MINUTE).ceil()) }
  return Locale.LEFT_HOURS.format((seconds / HOUR).ceil())
}
