// The shopping list: lines from two sources summed per item, against what this character holds, into what is left to
// buy; kept for the account across a reload; its page with «Search all» browsing every item in one query, a row
// removed, the rows bought cleared; an item added from «Buy».
import Game from "$game"
import Test from "$test"
import { ItemId } from "Ordaen"
import root Auction from "OrdaenAuction"

const COPPER_BAR: Integer = 2840
const LINEN: Integer = 2589
// The recipe, a spell's id, that makes a Bronze Axe.
const BRONZE_AXE: Integer = 2741
const PAGE: Test.Page = { left: 0, top: 0, width: 1200, height: 800, screen: true }

test "lines of one item are summed, held is taken off, and the list is kept across a reload" {
  Game.items.owned = (id: Integer): Integer => id == COPPER_BAR ? 4 : 0
  Auction.shopping.add(ItemId.of(COPPER_BAR), 12, .Queue { recipe: BRONZE_AXE, crafts: 6, character: "Regron" })
  Auction.shopping.add(ItemId.of(LINEN), 20, .ByHand)
  Auction.shopping.add(ItemId.of(COPPER_BAR), 2, .ByHand)
  Auction.shopping.add(ItemId.of(LINEN), 0, .ByHand)
  const rows = Auction.shopping.rows
  Test.expect(rows.length == 2)
  const bars = rows[1] ?? panic("two rows")
  Test.expect(bars.item == COPPER_BAR && bars.needed == 14 && bars.held == 4 && bars.toBuy == 10 && bars.lines.length == 2)
  Test.expect(Auction.shopping.needed[ItemId.of(LINEN)] == 20)
  Test.reload()
  Test.expect(Auction.shopping.rows.length == 2)
  Test.expect(Auction.shopping.needed[ItemId.of(COPPER_BAR)] == 14)
}

test "the page: every item browsed in one query, a row removed, what is bought cleared" {
  Test.mount(nil, PAGE)
  Game.auctionHouse.open = true
  Auction.page = 4
  Test.pass(0.02)
  Test.shot("empty: what to do")
  Game.items.owned = (id: Integer): Integer => id == LINEN ? 25 : 0
  Game.spells.name = (id: Integer): String | nil => id == BRONZE_AXE ? "Bronze Axe" : nil
  Auction.shopping.add(ItemId.of(LINEN), 4, .Queue { recipe: 9999, crafts: 2, character: "Regy" })
  Auction.shopping.add(ItemId.of(COPPER_BAR), 12, .Queue { recipe: BRONZE_AXE, crafts: 6, character: "Regron" })
  Auction.shopping.add(ItemId.of(LINEN), 20, .ByHand)
  Test.pass(0.02)
  Test.shot("two items, no prices yet; linen held in full, dimmed")
  Test.click(Test.holding("Search all", nil), nil)
  Test.click(Test.holding("Item 2840", nil), nil)
  Test.pass(0.02)
  Test.shot("«Search all» browsed both; copper bars picked: «Buy 12» off, «Remove» on")
  Test.click(Test.holding("Remove bought", nil), nil)
  Test.pass(0.02)
  Test.expect(Auction.shopping.rows.length == 1)
  Test.click(Test.holding("Remove", nil), nil)
  Test.pass(0.02)
  Test.expect(Auction.shopping.rows.length == 0)
  Test.shot("both gone: empty again")
  Game.auctionHouse.open = false
}

test "«Buy N» on a row: its listings asked first, then a commodity's N priced and bought in two clicks" {
  Game.clock.server = 1790002800
  Test.mount(nil, PAGE)
  Game.auctionHouse.open = true
  Game.auctionQuery.ready = true
  Game.items.owned = (id: Integer): Integer => id == COPPER_BAR ? 4 : 0
  Game.auctionQuery.results.emit([{ key: COPPER_BAR, copper: 52, quantity: 400 }])
  Auction.shopping.add(ItemId.of(COPPER_BAR), 22, .ByHand)
  Auction.page = 4
  Test.pass(0.02)
  Test.click(Test.holding("Buy 18", nil), nil)
  Game.auctionQuery.listed.emit(COPPER_BAR, [{ auction: 0, unit: 52, quantity: 400, own: false, commodity: true }])
  Test.pass(0.02)
  Test.click(Test.holding("Buy 18", nil), nil)
  Game.auctionActions.answered.emit(.Quoted { item: COPPER_BAR, quantity: 18, total: 954 })
  Test.pass(0.02)
  Test.shot("the client's price for 18 in the row's sum: «Confirm»")
  Test.click(Test.holding("Confirm", nil), nil)
  Game.auctionActions.answered.emit(.Bought)
  Game.items.owned = (id: Integer): Integer => id == COPPER_BAR ? 22 : 0
  Game.bags.changed.emit()
  Game.auctionQuery.ready = false
  Test.pass(0.02)
  Test.shot("bought: the row at 0, «Bought» off")
  Game.auctionHouse.open = false
}
