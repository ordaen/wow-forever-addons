// Ordaen Auction: the house's prices, homemade (`redesign/market.md`), every Ordaen addon's through `prices`; the
// merchants' prices; the sales ledger; the house's window (`redesign/market-ux.md` §1), shown while the house is open.
// A module loaded on demand: a player with it off loads none of its data.
import Game from "$game"
import { Track } from "$ltml"
import { Module, Placing, PX, Settings, SettingsPage, Window, WindowTabSpec } from "Ordaen"
import root Ordaen from "Ordaen"
import { BuyPage } from "@/buy"
import { DataPage } from "@/dataPage"
import { House } from "@/house"
import { Kept } from "@/kept"
import { Ledger } from "@/ledger"
import Locale from "@/locales"
import { OwnedPage } from "@/owned"
import { OrdaenPrices, takeMerchant } from "@/prices"
import { PriceSource } from "@/quote"
import { TooltipLines } from "@/rows"
import { Scanner } from "@/scan"
import { SellPage } from "@/sell"
import { ShoppingList } from "@/shopping"
import { ShoppingPage } from "@/shoppingPage"
import { Choices, DEFAULTS, GeneralPage } from "@/settings"
import { Status } from "@/status"
import Style from "@/style"

// What the module keeps, under its own saved variable.
const KEPT = "kept"

// The window's pages: its own tabs, as every Ordaen window's.
const BUY = 1
const SELL = 2
const OWNED = 3
const SHOPPING = 4
const DATA = 5
const TABS: Array<WindowTabSpec> = [
  { title: Locale.PAGE_BUY }, { title: Locale.PAGE_SELL }, { title: Locale.PAGE_OWNED },
  { title: Locale.PAGE_SHOPPING }, { title: Locale.PAGE_DATA },
]
const BODY: Array<Track> = ["auto", { fr: 1 }]

public class Auction implements Module, App {
  public const title: String = "Ordaen Auction"
  settings: mut Settings<Choices> = new Settings<Choices>(DEFAULTS)
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
  ]
  derived cut: Integer = self.settings.values.cut
  derived priceLine: Boolean = self.settings.values.priceLine

  kept: mut Kept
  house: mut House
  source: mut OrdaenPrices
  scanner: mut Scanner
  // Where every Ordaen addon reads a price.
  public const prices: any PriceSource
  // The sales and purchases the mailbox reads.
  public const ledger: mut Ledger
  // The shopping list: what Professions and the player ask to buy.
  public const shopping: mut ShoppingList
  // The lines in Ordaen Tooltips' item tooltip, while Tooltips is on.
  lines: TooltipLines

  // The window: its page (the window's tab) and where it stands. It shows while the house is open, and goes with it.
  state page = BUY
  state placing: Placing = { x: 0, y: 0, width: Style.WIDTH, height: Style.HEIGHT }
  derived shown: Boolean = Game.auctionHouse.open && self.settings.values.window

  constructor() {
    self.kept = load(.Own, KEPT, Kept {})
    Game.saved.store(.Own, KEPT, self.kept)
    // The current realm's house unpacked; the others stay packed.
    const realm = Game.player.realm
    self.house = new House(realm, self.kept.houses[realm])
    self.source = new OrdaenPrices(self.house, self.kept.vendor, self.cut)
    self.prices = self.source
    self.scanner = new Scanner(mut self.house, mut self.source, mut self.kept)
    self.ledger = new Ledger(mut self.kept.ledger)
    self.shopping = new ShoppingList(mut self.kept)
    self.lines = new TooltipLines(self.prices, self.priceLine, self.shopping)
    Game.auctionHouse.opened.listen(self.onOpened)
    Game.merchant.opened.listen(self.onMerchant)
    Ordaen.modules.add(self)
  }

  onOpened(mut self) {
    if (peek self.settings.values.scanOnOpen) { _ = self.scanner.full() }
  }

  onMerchant(mut self) {
    const given = Game.merchant.prices()
    if (given != nil) { takeMerchant(mut self.kept.vendor, given) }
  }

  // The window closed (its button, Escape): the player leaves the house, as the game's own window's close does.
  onClose(self) { Game.auctionHouse.close() }

  onSettings(self) { Ordaen.toggleSettings("OrdaenAuction") }

  public render(self): Template {
    return $ltml {
      <$if={self.shown}>
        // The game's own window stays open, unseen and off the screen: hiding it would close the house.
        <frame of={Game.frames.AuctionHouse} opacity={0} away={true} />
        <Window tabs={TABS} selected={mut self.page} placing={mut self.placing} withSettings={true}
                @close={self.onClose} @settings={self.onSettings}>
          <box rows={BODY} gap={8 * PX}>
            <Status house={self.house.name} items={self.scanner.known} lastFull={self.scanner.lastFull}
                    scanner={mut self.scanner} />
            <box $match={self.page}>
              <BuyPage $case={BUY} house={self.house} prices={self.prices} offers={self.scanner.offers}
                       items={self.scanner.known} shopping={mut self.shopping} />
              <SellPage $case={SELL} house={self.house} prices={self.prices} />
              <OwnedPage $case={OWNED} house={self.house} revision={self.source.revision} />
              <ShoppingPage $case={SHOPPING} prices={self.prices} list={mut self.shopping} />
              <DataPage $case={DATA} scanner={self.scanner} ledger={self.ledger} lastFull={self.scanner.lastFull}
                        items={self.scanner.known} settings={mut self.settings} />
            </box>
          </box>
        </Window>
      </>
    }
  }
}
