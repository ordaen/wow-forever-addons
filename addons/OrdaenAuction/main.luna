// Ordaen Auction: the house's prices, homemade (`redesign/market.md`), every Ordaen addon's through `prices`; the
// merchants' prices; the sales ledger; the house's window (`redesign/market-ux.md` §1), shown while the house is open.
// A module loaded on demand: a player with it off loads none of its data.
import Game from "$game"
import { Side, Track } from "$ltml"
import Runtime from "$runtime"
import { Module, Placing, Settings, SettingsPage, Window, WindowSide, WindowTabSpec } from "Ordaen"
import root Ordaen from "Ordaen"
import { BuyPage, Chosen, Found } from "@/buy"
import { DataPage } from "@/dataPage"
import { House } from "@/house"
import { Kept } from "@/kept"
import { Ledger } from "@/ledger"
import Locale from "@/locales"
import { OwnedPage } from "@/owned"
import { OrdaenPrices, takeMerchant } from "@/prices"
import { PriceSource } from "@/quote"
import { TooltipLines } from "@/rows"
import { Scanner } from "@/scan"
import { Offered, Posting, SellPage } from "@/sell"
import { ShoppingList } from "@/shopping"
import { ShoppingPage } from "@/shoppingPage"
import { Choices, DEFAULTS, GeneralPage } from "@/settings"
import { Status } from "@/status"
import Style from "@/style"

// What the module keeps, under its own saved variable.
const KEPT = "kept"

// The window's pages: its own tabs, as every Ordaen window's. «Shopping list» and «My auctions» are windows of their
// own, docked at the screen's right, opened from «Buy» and «Sell».
const BUY = 1
const SELL = 2
const DATA = 3
const TABS: Array<WindowTabSpec> = [{ title: Locale.PAGE_BUY }, { title: Locale.PAGE_SELL }, { title: Locale.PAGE_DATA }]
const SHOPPING_TABS: Array<WindowTabSpec> = [{ title: Locale.PAGE_SHOPPING }]
const OWNED_TABS: Array<WindowTabSpec> = [{ title: Locale.PAGE_OWNED }]
const FILL: Array<Track> = [{ fr: 1 }]

public class Auction implements Module, App {
  public const title: String = "Ordaen Auction"
  settings: mut Settings<Choices> = new Settings<Choices>(DEFAULTS)
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
  ]
  derived cut: Integer = self.settings.values.cut
  derived priceLine: Boolean = self.settings.values.priceLine

  kept: mut Kept
  house: mut House
  source: mut OrdaenPrices
  scanner: mut Scanner
  // Where every Ordaen addon reads a price.
  public const prices: any PriceSource
  // The sales and purchases the mailbox reads.
  public const ledger: mut Ledger
  // The shopping list: what Professions and the player ask to buy.
  public const shopping: mut ShoppingList
  // The lines in Ordaen Tooltips' item tooltip, while Tooltips is on.
  lines: TooltipLines

  // The window: its page (the window's tab) and where it stands while it isn't full screen. It shows while the house
  // is open, and goes with it; so do the docked windows, each open from its button until it is closed.
  state page = BUY
  state placing: Placing = { x: 0, y: 0, width: Style.WIDTH, height: Style.HEIGHT }
  derived shown: Boolean = Game.auctionHouse.open && self.settings.values.window
  state shoppingOpen = false
  state ownedOpen = false
  // A docked window's one tab, and its width (it stands the screen's height).
  state sideTab = 1
  state sidePlacing: Placing = { x: 0, y: 0, width: Style.SIDE_WIDTH, height: Style.HEIGHT }
  // What the full-screen window leaves clear at the screen's right: the docked windows' width, while one is open.
  derived room: Number = self.shoppingOpen || self.ownedOpen ? Style.SIDE_WIDTH : 0
  // The row picked on «Buy» and on «Sell»: the item's section at the window's right, the full height beside the
  // page, while the page shows one.
  state buyChosen: Array<Found> = []
  state sellChosen: Array<Offered> = []
  derived side: WindowSide | nil = self.sideOf()
  // The window's footer: the status under every page.
  const footer: Template = $ltml {
    <Status items={self.scanner.known} lastFull={self.scanner.lastFull} scanner={mut self.scanner} />
  }
  // The side section: the row picked on the page shown.
  const chosenPanel: Template = $ltml {
    <box $match={self.page} rows={FILL}>
      <box $case={BUY} rows={FILL}>
        <Chosen $for={found of self.buyChosen} $key={found.key} found={peek found} house={self.house}
                prices={self.prices} history={self.source} shopping={mut self.shopping} />
      </box>
      <box $case={SELL} rows={FILL}>
        <Posting $for={offered of self.sellChosen} $key={offered.item} offered={peek offered} house={self.house}
                 prices={self.prices} history={self.source} />
      </box>
      <box $else />
    </box>
  }

  constructor() {
    self.kept = load(.Own, KEPT, Kept {})
    Game.saved.store(.Own, KEPT, self.kept)
    // The current realm's house unpacked; the others stay packed.
    const realm = Game.player.realm
    self.house = new House(realm, self.kept.houses[realm])
    self.source = new OrdaenPrices(self.house, self.kept.vendor, self.cut)
    self.prices = self.source
    self.scanner = new Scanner(mut self.house, mut self.source, mut self.kept)
    self.ledger = new Ledger(mut self.kept.ledger)
    self.shopping = new ShoppingList(mut self.kept)
    self.lines = new TooltipLines(self.prices, self.priceLine, self.shopping)
    Game.auctionHouse.opened.listen(self.onOpened)
    Game.merchant.opened.listen(self.onMerchant)
    Ordaen.modules.add(self)
  }

  onOpened(mut self) {
    if (peek self.settings.values.scanOnOpen) { _ = self.scanner.full() }
  }

  onMerchant(mut self) {
    const given = Game.merchant.prices()
    if (given != nil) { takeMerchant(mut self.kept.vendor, given) }
  }

  // The window closed (its button, Escape): the player leaves the house, as the game's own window's close does.
  onClose(self) { Game.auctionHouse.close() }

  onSettings(self) { Ordaen.toggleSettings(Runtime.Addon.of(self)) }

  // «Shopping list» on «Buy», «My auctions» on «Sell»: each opens its window, or closes it.
  onShopping(mut self) { self.shoppingOpen = !self.shoppingOpen }
  onOwned(mut self) { self.ownedOpen = !self.ownedOpen }
  closeShopping(mut self) { self.shoppingOpen = false }
  closeOwned(mut self) { self.ownedOpen = false }

  sideOf(self): WindowSide | nil {
    const picked = self.page == BUY ? self.buyChosen.length > 0 : self.page == SELL && self.sellChosen.length > 0
    return picked ? { width: Style.PANEL, content: self.chosenPanel } : nil
  }

  public render(self): Template {
    return $ltml {
      <$if={self.shown}>
        // The game's own window stays open, unseen and off the screen: hiding it would close the house.
        <frame of={Game.frames.AuctionHouse} opacity={0} away={true} />
        <Window tabs={TABS} selected={mut self.page} placing={mut self.placing} withSettings={true} full={true}
                room={self.room} footer={self.footer} side={self.side} @close={self.onClose}
                @settings={self.onSettings}>
          <box $match={self.page} rows={FILL}>
            <BuyPage $case={BUY} house={mut self.house} prices={self.prices} offers={self.scanner.offers}
                     items={self.scanner.known} shopping={mut self.shopping} chosen={mut self.buyChosen}
                     @openList={self.onShopping} />
            <SellPage $case={SELL} house={self.house} prices={self.prices} chosen={mut self.sellChosen}
                      @openOwned={self.onOwned} />
            <DataPage $case={DATA} scanner={self.scanner} ledger={self.ledger} lastFull={self.scanner.lastFull}
                      items={self.scanner.known} settings={mut self.settings} />
          </box>
        </Window>
        <Window $if={self.shoppingOpen} tabs={SHOPPING_TABS} selected={mut self.sideTab}
                placing={mut self.sidePlacing} docked={Side.Right} @close={self.closeShopping}>
          <ShoppingPage prices={self.prices} list={mut self.shopping} />
        </Window>
        <Window $if={self.ownedOpen} tabs={OWNED_TABS} selected={mut self.sideTab} placing={mut self.sidePlacing}
                docked={Side.Right} @close={self.closeOwned}>
          <OwnedPage house={self.house} revision={self.source.revision} />
        </Window>
      </>
    }
  }
}
