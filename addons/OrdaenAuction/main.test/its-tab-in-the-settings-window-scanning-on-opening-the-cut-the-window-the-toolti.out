-- the defaults
box 0,0 560x16.67 opacity=1
  box 0,0.83 233.33x15 @enter @leave
    text 0,0.83 233.33x15 "Scan when the auction house opens" #cbb994
  box 248.33,0 31.67x16.67 Interface\AddOns\Ordaen\media\ctl-switch-track row 1 of 4 @click
    box 260.83,-2.5 21.67x21.67 absolute Interface\AddOns\Ordaen\media\ctl-switch-knob row 1 of 2
box 0,16.67 560x16.67 opacity=1
  box 0,17.5 233.33x15 @enter @leave
