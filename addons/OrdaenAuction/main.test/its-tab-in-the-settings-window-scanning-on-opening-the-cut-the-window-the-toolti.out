      box 291.67,15 13.33x26.67 absolute Interface\AddOns\Ordaen\media\ctl-slider-knob
    text 458.33,17.8 6x14.4 "5" #ffffff
box 0,33.33 560x16.67 opacity=1
  box 0,34.17 233.33x15 @enter @leave
