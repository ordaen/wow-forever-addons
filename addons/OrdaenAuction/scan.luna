// The house's prices taken in: a full scan read a few milliseconds a frame (the auctions whose item's data hadn't
// loaded read again as it comes) and set over the frames after, and every browse the house shows (ours or the game's)
// as it comes. The house closing drops a scan not yet read through (its answer is all or nothing) and puts the house
// at rest.
import Client from "$client"
import Game from "$game"
import { Hour } from "Ordaen"
import { House } from "@/house"
import { Kept } from "@/kept"
import { OrdaenPrices } from "@/prices"
import { Listing, PriceKey, serverSeconds } from "@/quote"

// What a frame of a scan's reading takes at most, in milliseconds (the client's `debugprofilestop`), asked every
// `CHECK` auctions: about 300 auctions a frame on a 160,000-auction house, a reading of eight or nine seconds.
const FRAME_MS: Number = 4
const CHECK = 50
// How long the auctions whose item's data was asked for are waited for, in seconds.
const LOAD_WAIT = 10
// The share of the progress bar the reading takes; setting the prices takes the rest.
const READ_SHARE: Number = 0.9
// The client answers a full scan once per account each 15 minutes.
public const FULL_EVERY = 900

public class Scanner {
  // A full scan's answer is being read; how far, from 0 to 1.
  public state reading = false
  public state progress: Number = 0
  // The last full scan of this session: how many auctions and items it held; none before one.
  public state auctions = 0
  public state items = 0
  // The bytes the house takes at rest.
  public state size = 0
  // How many items the house's prices cover.
  public state known = 0
  // The server's time of the account's last full scan; 0 before the first.
  public state lastFull = 0
  // What the house's last browse showed.
  public state offers: Array<Game.Offer> = []
  // A price moved since the house was last put at rest.
  dirty = false
  reader: Task<nil> | nil = nil
  // When the reading's work began this frame (`debugprofilestop`, ms).
  since: Number = 0
  house: mut House
  source: mut OrdaenPrices
  kept: mut Kept

  constructor(house: mut House, source: mut OrdaenPrices, kept: mut Kept) {
    self.house = house
    self.source = source
    self.kept = kept
    self.size = (kept.houses[house.name] ?? "").length
    self.known = house.count
    self.lastFull = kept.lastFull
    Game.auctionScan.finished.listen(self.onFinished)
    Game.auctionQuery.results.listen(self.onResults)
    Game.auctionHouse.closed.listen(self.onClosed)
  }

  // Seconds until the client takes another full scan from this account; 0 when it would now.
  public wait(self, now: Integer): Integer { return (FULL_EVERY - (now - self.lastFull)).max(0) }

  // A full scan is asked of the client, where the house is open, none runs, and the account's 15 minutes are past.
  public full(mut self): Boolean {
    const now = serverSeconds()
    if (!peek Game.auctionHouse.open || self.wait(now) > 0 || peek Game.auctionScan.running || peek self.reading) {
      return false
    }
    if (!Game.auctionScan.start()) { return false }
    self.kept.lastFull = now
    self.lastFull = now
    return true
  }

  onFinished(mut self, count: Integer) {
    if (self.reader != nil) { destroy self.reader }
    self.reader = self.read(count)
  }

  async read(mut self, count: Integer) {
    self.reading = true
    self.progress = 0
    const at = Hour.now()
    // An item listed once is its one auction; one listed more, its auctions: a list only where there are several.
    const alone: Map<PriceKey, Listing> = {}
    const several: Map<PriceKey, mut Array<Listing>> = {}
    self.since = Client.debugprofilestop()
    for (index of 1..=count) {
      const key, unit, many = Game.auctionScan.read(index)
      take(key, unit, many, mut alone, mut several)
      if (index % CHECK == 0 && index < count && self.spent()) {
        self.progress = index / count * READ_SHARE
        await Game.frame()
        self.since = Client.debugprofilestop()
      }
    }
    // The auctions read before their item's data came, read again as it comes; a while at most.
    const until = (peek Game.clock.time) + LOAD_WAIT
    let turn = 1
    for (round of 1..=Number.huge) {
      for (step of 1..=Number.huge) {
        const index = Game.auctionScan.again(turn)
        if (index == 0) { break }
        turn += 1
        const key, unit, many = Game.auctionScan.read(index)
        take(key, unit, many, mut alone, mut several)
        if (step % CHECK == 0 && self.spent()) {
          await Game.frame()
          self.since = Client.debugprofilestop()
        }
      }
      if (peek Game.auctionScan.waiting == 0 || peek Game.clock.time >= until) { break }
      await Game.frame()
      self.since = Client.debugprofilestop()
    }
    self.progress = READ_SHARE
    let items = 0
    for (key, auction of alone) {
      self.house.observe(key, auction.low(), auction.low(), auction.quantity(), at)
      items += 1
      if (items % CHECK == 0 && self.spent()) {
        await Game.frame()
        self.since = Client.debugprofilestop()
      }
    }
    for (key, list of several) {
      list.sort(cheaper)
      const unit, low, total = fifth(list)
      self.house.observe(key, unit, low, total, at)
      items += 1
      if (items % CHECK == 0 && self.spent()) {
        await Game.frame()
        self.since = Client.debugprofilestop()
      }
    }
    _ = self.house.prune(at)
    self.auctions = count
    self.items = items
    self.known = self.house.count
    self.progress = 1
    self.reading = false
    self.reader = nil
    self.source.moved()
    self.keep()
  }

  // This frame's share of a scan's work is spent.
  spent(self): Boolean { return Client.debugprofilestop() - self.since > FRAME_MS }

  // A browse's lowest prices: each an observation of its item.
  onResults(mut self, offers: Array<Game.Offer>) {
    self.offers = offers
    const at = Hour.now()
    let any = false
    for (offer of offers) {
      if (offer.key != 0 && offer.copper > 0 && offer.quantity > 0) {
        self.house.observe(PriceKey.given(offer.key), offer.copper, offer.copper, offer.quantity, at)
        any = true
      }
    }
    if (any) {
      self.dirty = true
      self.known = self.house.count
      self.source.moved()
    }
  }

  onClosed(mut self) {
    if (self.reader != nil) {
      destroy self.reader
      self.reading = false
    }
    if (self.dirty) { self.keep() }
  }

  // The house put at rest; where the client refuses, what was kept stays (the game's side says why).
  keep(mut self) {
    const packed = self.house.pack()
    if (packed == nil) { return }
    self.kept.houses[self.house.name] = packed
    self.size = packed.length
    self.dirty = false
  }
}

// One auction read, kept by its item where it is one (a key, a buyout, a count): an item's first auction alone, its
// later ones in a list with the first.
function take(key: Integer, unit: Integer, many: Integer, alone: mut Map<PriceKey, Listing>, several: mut Map<PriceKey, mut Array<Listing>>) {
  if (key == 0 || unit <= 0 || many <= 0) { return }
  const priced = PriceKey.given(key)
  const auction = Listing.of(unit, many)
  const list = several[priced]
  if (list != nil) {
    list.push(auction)
    return
  }
  const first = alone[priced]
  if (first == nil) {
    alone[priced] = auction
    return
  }
  alone[priced] = nil
  several[priced] = [first, auction]
}

function cheaper(a: Listing, b: Listing): Boolean { return a < b }

// One item's auctions, cheapest first: the price a buyer pays per unit for the cheapest fifth of the quantity listed,
// the lowest, and the quantity listed.
public function fifth(sorted: Array<Listing>): (Integer, Integer, Integer) {
  let total = 0
  for (auction of sorted) { total += auction.quantity() }
  const first = sorted[1]
  if (first == nil || total == 0) { return 0, 0, 0 }
  const wanted = (total / 5).ceil().max(1)
  let left = wanted
  let cost = 0
  for (auction of sorted) {
    const taken = auction.quantity().min(left)
    cost += taken * auction.low()
    left -= taken
    if (left == 0) { break }
  }
  return (cost / wanted).round(), first.low(), total
}
