// Waits for a version in `OrdaenTooltips/addon.json` (a range of it holds to nothing without one): Ordaen Auction's
// lines in Ordaen Tooltips' item tooltip: the shopping list's in `held`, gone with Tooltips turned off and back with
// it on; with Tooltips not installed, nothing is added and nothing breaks; the Auction line by age, which waits for
// `Game.clock`'s server time too. Built and passed (but the line by age) on a copy with Tooltips at 1.0.0.
import Client from "$client"
import Game from "$game"
import { Frame } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import { ItemId } from "Ordaen"
import root Auction from "OrdaenAuction"
import root Ordaen from "Ordaen"
import root Tooltips from "OrdaenTooltips"

const COPPER_ORE: Integer = 2770
const PAGE: Test.Page = { left: 100, top: 50, width: 700, height: 600, screen: true }

function corner(): any Frame {
  let made = Client.CreateFrame("Frame", "GameTooltip", Client.C_UI.GetUIParent(), nil)
  made.SetSize(200, 80)
  made.SetPoint("TOPLEFT", Client.C_UI.GetUIParent(), "TOPLEFT", 1300, -720)
  return made
}

function showing(at: any Frame, data: Game.TooltipData): Game.ShownTip {
  return { shown: true, data: data, placeable: false, ownerHigh: false, ownerRight: false, corner: at, below: false, right: true }
}

function ore(at: any Frame): Game.ShownTip {
  return showing(at, { kind: 0, id: COPPER_ORE, about: "item:2770", lines: [{ left: "Copper Ore", kind: 22 }] })
}

test "an item on the shopping list says how many are wanted and held, and the line follows Tooltips on and off" {
  const at = corner()
  Test.mount(nil, PAGE)
  Game.items.owned = (id: Integer): Integer => 4
  Auction.shopping.add(ItemId.of(COPPER_ORE), 12, nil)
  Game.tooltip.main = ore(at)
  Test.pass(0.02)
  Test.shot("copper ore: on the shopping list, 12 (4 held), after the tooltip's body")
  const tooltips = Runtime.Addon.of(Tooltips) ?? panic("the tooltips are installed")
  tooltips.disable()
  Test.pass(0.02)
  Test.expect(Tooltips == nil)
  Test.expect(Test.errors().length == 0)
  Test.expect(tooltips.enable() == nil)
  Game.tooltip.main = ore(at)
  Test.pass(0.02)
  Test.shot("Tooltips on again: the line is back")
  Game.tooltip.main = { shown: false, ..ore(at) }
  Test.pass(0.2)
}

test "an item off the list has no line of the list's" {
  const at = corner()
  Test.mount(nil, PAGE)
  Game.tooltip.main = ore(at)
  Test.pass(0.02)
  Test.shot("copper ore, off the list: the tooltip's body alone")
  Game.tooltip.main = { shown: false, ..ore(at) }
  Test.pass(0.2)
}

// Waits also for the server's time on `Game.clock` (`clock.test.luna.waiting`), to be set through its fake.
test "the Auction line: what one costs on the house, its age amber from a day, dim past three; off by the setting" {
  Client.GetServerTime = (): Number => 1790002800
  const at = corner()
  Test.mount(nil, PAGE)
  Game.auctionQuery.results.emit([{ key: COPPER_ORE, copper: 125, quantity: 12 }])
  Game.tooltip.main = ore(at)
  Test.pass(0.02)
  Test.shot("copper ore seen now: the Auction line, no age")
  Client.GetServerTime = (): Number => 1790002800 + 50 * 3600
  Game.tooltip.main = { shown: false, ..ore(at) }
  Test.pass(0.2)
  Game.tooltip.main = ore(at)
  Test.pass(0.02)
  Test.shot("50 hours on: the market, «(2 d.)» in amber")
  Client.GetServerTime = (): Number => 1790002800 + 100 * 3600
  Game.tooltip.main = { shown: false, ..ore(at) }
  Test.pass(0.2)
  Game.tooltip.main = ore(at)
  Test.pass(0.02)
  Test.shot("100 hours on: «(4 d.)» dim")
  Auction.settings.choose({ priceLine: false, ..Auction.settings.values })
  Ordaen.keeper.saveAll()
  Test.pass(0.02)
  Test.shot("the line off in the settings: gone")
  Game.tooltip.main = { shown: false, ..ore(at) }
  Test.pass(0.2)
}

test "without Tooltips installed the module runs and adds nothing" {
  Test.uninstall("OrdaenTooltips")
  Test.reload()
  const tooltips, _ = Client.C_AddOns.IsAddOnLoaded("OrdaenTooltips")
  Test.expect(!tooltips)
  Auction.shopping.add(ItemId.of(COPPER_ORE), 3, nil)
  Test.flush()
  Test.expect(Test.errors().length == 0)
  Test.expect(Auction.shopping.needed[ItemId.of(COPPER_ORE)] == 3)
}
