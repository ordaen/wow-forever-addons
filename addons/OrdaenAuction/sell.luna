// «Sell» (design `auction`): the bags' items the house takes (`Game.auctionActions.sellable()`, read again as the bags
// change), each with how many, its market, its merchant's price and which pays more (the market after the house's cut
// against the merchant). The one picked: a quantity (the counter Professions has), a price for one (the lowest listed
// less a copper, or the market), the duration, the merchant's price and the deposit as money, and «Post», one auction
// a click (the client's from a click alone). «My auctions» opens their window.
import Game from "$game"
import { Align, Track } from "$ltml"
import { Choice, Column, Component, Copper, CountInput, ItemButton, ItemId, Money, MoneyField, PushButton, PX, Segmented, Table, TableRow, tracksOf } from "Ordaen"
import { nameOf } from "@/buy"
import { PriceHistory } from "@/history"
import { House } from "@/house"
import { ItemPanel } from "@/itemPanel"
import Locale from "@/locales"
import { PriceKey, PriceSource } from "@/quote"
import Style from "@/style"

// One item of the bags, as its row draws it: every stack of it counted, the first one what a post names.
public struct Offered {
  from: Game.Sellable
  item: ItemId
  name: String
  color: Color
  count: Integer
  market: Copper | nil
  vendor: Copper | nil
  // The house pays more than the merchant, after its cut; none where neither price is known.
  house: Boolean | nil
}

const NAME_COLUMN = 1
const MARKET_COLUMN = 3
const VENDOR_COLUMN = 4

const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_ITEM, width: { fr: 1 }, sortable: true },
  { title: Locale.COLUMN_COUNT, width: 64 * PX, align: Align.End },
  { title: Locale.COLUMN_MARKET, width: 96 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_VENDOR, width: 96 * PX, align: Align.End, sortable: true },
  { title: Locale.COLUMN_BETTER, width: 90 * PX },
]
const TRACKS: Array<Track> = tracksOf(COLUMNS)
// The bags' side, and the picked item's panel at the right, the page's whole height.
const PAGE: Array<Track> = [{ fr: 1 }, Style.PANEL]
const FILL: Array<Track> = [{ fr: 1 }]
const SIDE: Array<Track> = ["auto", { fr: 1 }]
const TOOLS: Array<Track> = [{ fr: 1 }, "auto"]
const ITEM: Array<Track> = ["auto", { fr: 1 }]
// A label at the left, its value or control at the right.
const PAIR: Array<Track> = [{ fr: 1 }, "auto"]
const STEP = 28 * PX
const DURATIONS: Array<Choice<Game.Duration>> = [
  { value: Game.Duration.Short, label: Locale.HOURS.format(12) },
  { value: Game.Duration.Medium, label: Locale.HOURS.format(24) },
  { value: Game.Duration.Long, label: Locale.HOURS.format(48) },
]

class OfferedRow implements Component {
  public pick: Event<ItemId> = new Event()

  derived better: String = self.offered.house == nil ? "—" : self.offered.house == true ? Locale.BETTER_HOUSE :
    Locale.BETTER_VENDOR
  derived betterInk: Color = self.offered.house == nil ? Style.DIM : self.offered.house == true ? Style.GREEN :
    Style.GOLD
  derived market: Integer = self.offered.market ?? 0
  derived vendor: Integer = self.offered.vendor ?? 0

  // The row's item: the table hands the row to another item as it scrolls.
  offered: Signal<Offered>
  selected: Signal<Boolean>
  constructor(offered: Signal<Offered>, selected: Signal<Boolean>) {
    self.offered = offered
    self.selected = selected
  }

  onPick(self) { self.pick.emit(self.offered.item) }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={TRACKS} selected={self.selected} @pick={self.onPick}>
        <box columns={ITEM} gap={8 * PX} yAlign={Align.Center}>
          <ItemButton item={self.offered.item} size={Style.SLOT} />
          <box overflow={.Hidden}>
            <text value={self.offered.name} textColor={self.offered.color} wrap={false} />
          </box>
        </box>
        <box xAlign={Align.End}>
          <text value={"%d"} arguments={[self.offered.count]} textColor={Style.INK} />
        </box>
        <box xAlign={Align.End}>
          <Money $if={self.offered.market != nil} amount={self.market} />
          <text $else value={"—"} textColor={Style.DIM} />
        </box>
        <box xAlign={Align.End}>
          <Money $if={self.offered.vendor != nil} amount={self.vendor} />
          <text $else value={"—"} textColor={Style.DIM} />
        </box>
        <text value={self.better} textColor={self.betterInk} wrap={false} />
      </TableRow>
    }
  }
}

public class SellPage implements Component {
  // «My auctions» was clicked: its window opens, or closes.
  public openOwned: Event<nil> = new Event()

  state sorted = 0
  state descending = false
  state picked: ItemId | nil = nil
  // Moves as the bags change: what the house takes is read again.
  state bags = 0
  derived rows: Array<Offered> = self.rowsOf()
  derived chosen: Array<Offered> = self.chosenOf()
  // The item panel stands at the right while a row is picked.
  derived columns: Array<Track> = self.chosen.length > 0 ? PAGE : FILL

  const house: House
  const prices: any PriceSource
  const history: any PriceHistory | nil
  constructor(
    house: House,
    prices: any PriceSource,
    // The prices hour by hour, the item panel's chart.
    history: any PriceHistory | nil,
  ) {
    self.house = house
    self.prices = prices
    self.history = history
    Game.bags.changed.listen(self.onBags)
  }

  onBags(mut self) { self.bags += 1 }

  rowsOf(self): Array<Offered> {
    _ = self.bags
    _ = self.prices.revision
    const given = Game.auctionActions.sellable() ?? []
    let list: Array<Offered> = []
    const at: Map<ItemId, Integer> = {}
    for (stack of given) {
      const item = ItemId.of(stack.item)
      const index = at[item]
      if (index != nil) {
        const kept = list[index]
        if (kept != nil) { list[index] = { count: kept.count + stack.count, ..kept } }
      } else {
        const key = PriceKey.of(item)
        const name, color = nameOf(item)
        const market = self.prices.buy(key)?.copper()
        const net = self.prices.sell(key)?.copper()
        const vendor = self.prices.vendor(item)
        const house = net == nil && vendor == nil ? nil : (net ?? 0) > (vendor ?? 0)
        list.push({
          from: stack, item: item, name: name, color: color, count: stack.count, market: market, vendor: vendor,
          house: house,
        })
        at[item] = list.length
      }
    }
    const column = self.sorted
    const down = self.descending
    if (column != 0) { list.sort((a, b) => down ? before(b, a, column) : before(a, b, column)) }
    return list
  }

  chosenOf(self): Array<Offered> {
    const picked = self.picked
    const row = picked != nil ? self.rows.find(row => row.item == picked) : nil
    return row != nil ? [row] : []
  }

  onPick(mut self, item: ItemId) { self.picked = item }

  onOpenOwned(mut self) { self.openOwned.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} rows={FILL} gap={Style.GAP}>
        <box rows={SIDE} gap={Style.ROW_GAP}>
          // The row over the bags' items: «My auctions» at its right end.
          <box columns={TOOLS} gap={Style.ROW_GAP} yAlign={Align.Center}>
            <text value={Locale.SELLABLE} textColor={Style.DIM} wrap={false} />
            <PushButton label={Locale.PAGE_OWNED} width={Style.OPENER} @click={self.onOpenOwned} />
          </box>
          <box rows={FILL} border={Style.FRAME} background={Style.LISTS_BACK}>
            <Table columns={COLUMNS} sorted={mut self.sorted} descending={mut self.descending}
                   rowHeight={Style.ITEM_ROW}>
              <OfferedRow $for={row of self.rows} $key={row.item} offered={row}
                          selected={self.picked == row.item} @pick={self.onPick} />
              <box $if={self.rows.length == 0} padding={Style.NOTE_PAD} yAlign={Align.Center}>
                <text value={Locale.NOTHING_TO_SELL} textColor={Style.DIM} />
              </box>
            </Table>
          </box>
        </box>
        <Posting $for={offered of self.chosen} $key={offered.item} offered={peek offered} house={self.house}
                 prices={self.prices} history={self.history} />
      </box>
    }
  }
}

// The item picked, in the item panel: how many, the price for one, how long, the deposit, and «Post».
class Posting implements Component {
  state count = 1
  state unit: Integer
  state duration: Game.Duration = Game.Duration.Medium
  // The client's refusal of the last post, in its words.
  state refused: String | nil = nil
  // A post sent from here waits for its answer.
  state sending = false
  derived hasRefused: Boolean = self.refused != nil
  derived refusedText: String = self.refused ?? ""
  // A commodity is posted from every stack at once; an item's auction from its first stack.
  derived most: Integer = self.offered.from.commodity ? self.offered.count : self.offered.from.count
  derived canPost: Boolean = !Game.auctionActions.busy && self.count <= self.most && self.unit > 0
  // What the house holds back for this many for this long, as the client says it; «—» where it doesn't.
  derived deposit: Integer | nil = Game.auctionActions.deposit(self.offered.from, self.count, self.duration)
  derived depositAmount: Integer = self.deposit ?? 0

  const offered: Offered
  const house: House
  const prices: any PriceSource
  const history: any PriceHistory | nil
  // Under the item's name in its panel: how many the bags hold.
  const detail: String
  constructor(offered: Offered, house: House, prices: any PriceSource, history: any PriceHistory | nil) {
    self.offered = offered
    self.house = house
    self.prices = prices
    self.history = history
    self.detail = Locale.IN_BAGS.format(offered.count)
    // The posting rule: a copper under the lowest listed; the market where nothing is listed.
    const listed = house.listed(PriceKey.of(offered.item))
    self.unit = listed != nil ? (listed.low() - 1).max(1) : offered.market ?? 0
    Game.auctionActions.answered.listen(self.onAnswer)
  }

  // From the player's click alone: one auction.
  onPost(mut self) {
    const from = self.offered.from
    const count = peek self.count
    const unit = peek self.unit
    const duration = peek self.duration
    const sent = from.commodity ? Game.auctionActions.postCommodity(from, count, duration, unit) :
      Game.auctionActions.postItem(from, count, duration, nil, unit * count)
    if (sent) {
      self.sending = true
      self.refused = nil
    }
  }

  onAnswer(mut self, answer: Game.ActionAnswer) {
    if (!peek self.sending) { return }
    self.sending = false
    if (answer is Game.ActionAnswer.Refused) { self.refused = answer.reason }
  }

  public render(self): Template {
    return $ltml {
      <ItemPanel item={self.offered.item} name={self.offered.name} color={self.offered.color} detail={self.detail}
                 house={self.house} prices={self.prices} history={self.history}>
        <box gap={Style.ROW_GAP}>
          <box columns={PAIR} gap={Style.ROW_GAP} yAlign={Align.Center}>
            <text value={Locale.QUANTITY} textColor={Style.INK} />
            <CountInput value={mut self.count} least={1} most={self.most} step={STEP} />
          </box>
          <text value={Locale.UNIT_PRICE} textColor={Style.INK} />
          <MoneyField value={mut self.unit} />
          <text value={Locale.DURATION} textColor={Style.INK} />
          <Segmented value={mut self.duration} choices={DURATIONS} />
          <box columns={PAIR} gap={Style.ROW_GAP} yAlign={Align.Center}>
            <text value={Locale.DEPOSIT} textColor={Style.INK} />
            <Money $if={self.deposit != nil} amount={self.depositAmount} />
            <text $else value={"—"} textColor={Style.DIM} />
          </box>
          <text value={Locale.POSTING_RULE} textColor={Style.DIM} textSize={.Secondary} />
          <box>
            <text $if={self.hasRefused} value={self.refusedText} textColor={Style.RED} textSize={.Secondary} />
          </box>
          <PushButton label={Locale.POST} width={Style.PANEL_BUTTON} accent={true} disabled={!self.canPost}
                      @click={self.onPost} />
        </box>
      </ItemPanel>
    }
  }
}

// Whether `a` comes before `b` by the column: by name, cheapest first.
function before(a: Offered, b: Offered, column: Integer): Boolean {
  if (column == NAME_COLUMN) { return a.name < b.name }
  if (column == MARKET_COLUMN) { return (a.market ?? 0) < (b.market ?? 0) }
  return (a.vendor ?? 0) < (b.vendor ?? 0)
}
