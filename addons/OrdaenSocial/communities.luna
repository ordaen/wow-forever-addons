// The communities tab's own part: the picked community's card (its kind and size, its description and broadcast, and
// its streams). Each community is a tab of the communities' own row, its members in the roster under it.
import { Align, Overflow } from "$ltml"
import { Component, SECONDARY_TEXT, TITLE_LINE, TITLE_TEXT } from "Ordaen"
import { orDash } from "@/friends"
import Locale from "@/locales"
import { Club, Stream } from "@/people"
import Style from "@/style"

// What a community is: of Battle.net accounts or of characters, and how many are in it.
function kindOf(club: Club): String {
  return Locale.CLUB_KIND.format(club.battleNet ? Locale.CLUB_BATTLE_NET : Locale.CLUB_CHARACTERS, club.memberCount)
}

class StreamRow implements Component {
  stream: Signal<Stream>
  constructor(stream: Signal<Stream>) {
    self.stream = stream
  }

  public render(self): Template {
    return $ltml {
      <box columns={1}>
        <text value={self.stream.name} textColor={Style.INK} wrap={.None} />
        <text $if={self.stream.subject != ""} value={self.stream.subject} textColor={Style.DIM} textSize={SECONDARY_TEXT} />
      </box>
    }
  }
}

// The picked community's card, with no member picked.
public class ClubCard implements Component {
  club: Signal<Club>
  streams: Signal<Array<Stream>>
  constructor(club: Signal<Club>, streams: Signal<Array<Stream>>) {
    self.club = club
    self.streams = streams
  }

  public render(self): Template {
    return $ltml {
      <box columns={1} rows={["max-content", { fr: 1 }]} gap={6sp}>
        <box columns={1}>
          <text value={self.club.name} textColor={self.club.battleNet ? Style.BATTLE_NET : Style.GOLD} textSize={TITLE_TEXT} lineHeight={TITLE_LINE}
                textFont={.Title} wrap={.None} />
          <text value={kindOf(self.club)} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.None} />
        </box>
        <box columns={1} gap={3sp} overflow={Overflow.Scroll} yAlign={Align.Start}>
          <text value={Locale.CLUB_DESCRIPTION} textColor={Style.DIM} wrap={.None} />
          <text value={orDash(self.club.description)} textColor={Style.INK} />
          <text $if={self.club.broadcast != ""} value={Locale.QUOTED.format(self.club.broadcast)} textColor={Style.INK} />
          <text value={Locale.STREAMS.format(self.streams.length)} textColor={Style.DIM} wrap={.None} />
          <StreamRow $for={stream of self.streams} $key={stream.id} stream={stream} />
        </box>
      </box>
    }
  }
}
