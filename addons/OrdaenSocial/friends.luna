// The friends tab's parts: the list of both kinds of friends in one (with its sort, search and «Добавить друга»), the
// card beside it (the picked friend's, or the player's own), the requests waiting, and the black list.
//
// A row: the friend's status mark beside the name's line; the name (in the class colour of the character played, a
// Battle.net account playing none in Battle.net blue, grey while offline), the character's level right after it
// («25lvl») and a best friend's star; under it «Battle.net» first for an account, then the character and the zone,
// the game it plays, or when it was last seen. The mark and the star are one size, the name's line's height.
// The view switch draws the same friends as a table's columns instead. Best friends stay on top whatever the sort; the
// filter shows each kind and those online or offline. Left-click picks a friend (its card shows); again, the card is
// the player's own.
import { BattleNetSelf, Friend, FriendRequest, Hero, Ignored, Presence } from "$game"
import { Align, Art, ByInteractionState, Edges, MouseButton, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { ARTWORK, ButtonPlate, Choice, Column, CompactDropdown, Component, Fact, Field, FilterButton, FilterGroup, ModuleMemory, PushButton, SECONDARY_TEXT, ScrolledList, TITLE_TEXT, Table, TableCell, TableRow, ToolPick, ToolSort, Toolbar, agoText, classColor, rowShade, switched, tracksOf, trimmed } from "Ordaen"
import Locale from "@/locales"
import Style from "@/style"

// The filter's options: the friends' kinds, and online or not.
public enum FriendFilter implements Plain { BattleNet = "battleNet", Characters = "characters", Online = "online", Offline = "offline" }

const FILTERS: Array<FilterGroup<FriendFilter>> = [
  {
    options: [{ key: FriendFilter.BattleNet, label: Locale.BATTLE_NET }, { key: FriendFilter.Characters, label: Locale.FILTER_CHARACTERS }]
  },
  {
    options: [{ key: FriendFilter.Online, label: Locale.ONLINE }, { key: FriendFilter.Offline, label: Locale.OFFLINE }]
  }
]

// How the list is drawn: rows of two lines, or a table's columns.
public enum FriendView implements Plain { List = "list", Table = "table" }

const VIEWS: Array<Choice<FriendView>> = [
  { value: FriendView.List, label: Locale.VIEW_LIST, icon: ARTWORK.ctl.tool.list },
  { value: FriendView.Table, label: Locale.VIEW_TABLE, icon: ARTWORK.ctl.tool.table }
]
const LEVEL_WIDTH = 82.03125dp
// The table's columns; the name, the level and where sort the list (`ToolSort`), in the table and in the rows alike.
const COLUMNS: Array<Column> = [
  { title: Locale.COLUMN_NAME, width: { fr: 1 }, sortable: true },
  { title: Locale.COLUMN_LEVEL, width: LEVEL_WIDTH, align: Align.End, sortable: true },
  { title: Locale.WHERE, width: { fr: 1 }, sortable: true },
  { title: Locale.COLUMN_NOTE, width: { fr: 1 } }
]
const TRACKS: Array<Track> = tracksOf(COLUMNS)
// The sorts, by the table's column from 1, and the one no column shows: those online first.
const BY_LEVEL = 2
const BY_WHERE = 3
const BY_STATUS = 5
const MORE_SORTS: Array<String> = [Locale.SORT_STATUS]

// How the player left the friends' list, the profile's (`ModuleMemory`): its view, its sort and which way, and the
// filter (empty until the list first starts it from the settings). The search isn't kept.
public struct FriendsKept implements Plain {
  view: FriendView = FriendView.List
  sorted: Integer = BY_STATUS
  descending: Boolean = false
  filter: Map<FriendFilter, Boolean> = {}
}
public const FRIENDS_KEPT: FriendsKept = {}

// The status the player picks: the game's four.
const PRESENCES: Array<Choice<Presence>> = [
  { value: .Online, label: Locale.ONLINE },
  { value: .Away, label: Locale.AWAY },
  { value: .Busy, label: Locale.BUSY },
  { value: .Offline, label: Locale.INVISIBLE }
]
const ROW: Array<Track> = [Style.ROW_ICON, { fr: 1 }]
const ROW_PAD: Edges = { top: 1sp, right: 2sp, bottom: 1sp, left: 2sp }
// A friend's row's padding: a pickable row's (`PickRow`'s).
const PICK_PAD: Edges = { top: 2sp, right: 2sp, bottom: 2sp, left: 2sp }

// What a friend is called in the list: the account's name, or the character's.
public function titleOf(friend: Friend): String { return friend.account?.name ?? friend.hero?.name ?? "" }

// What tells a friend from every other: its kind and the account or the character.
public function keyOf(friend: Friend): String {
  const account = friend.account
  if (account != nil) { return `bn:${account.id}` }
  return `wow:${friend.hero?.name ?? ""}`
}

public function markOf(presence: Presence): Art {
  return match (presence) {
    .Online => Style.ONLINE_ICON
    .Away => Style.AWAY_ICON
    .Busy => Style.BUSY_ICON
    .Offline => Style.OFFLINE_ICON
  }
}

public function presenceText(presence: Presence): String {
  return match (presence) {
    .Online => Locale.ONLINE
    .Away => Locale.AWAY
    .Busy => Locale.BUSY
    .Offline => Locale.OFFLINE
  }
}

// What a Battle.net friend plays, by the client's code of the program.
public function gameName(program: String): String {
  return match (program) {
    "WoW" => Locale.GAME_WOW
    "App", "BSAp" => Locale.GAME_APP
    else => program
  }
}

function nameColorOf(friend: Friend): Color {
  if (friend.presence == .Offline) { return Style.OFFLINE }
  const heroColor = classColor(friend.hero?.classFile)
  if (heroColor != nil) { return heroColor }
  return friend.account != nil ? Style.BATTLE_NET : Style.INK
}

// The second line's points: «Battle.net» first for an account, then the character and its zone, the game, or when it
// was last seen (an account's, with the character it was last seen on here).
function pointsOf(friend: Friend): String {
  const points: Array<String> = []
  const account = friend.account
  if (account != nil) { points.push(Locale.BATTLE_NET) }
  const hero = friend.hero
  if (friend.presence == .Offline) {
    points.push(Locale.OFFLINE_LOWER)
    if (account != nil && hero != nil) { points.push(hero.name) }
    if (account != nil && account.lastOnline > 0) { points.push(agoText(account.lastOnline)) }
  } else if (account != nil && hero != nil) {
    points.push(hero.name)
    if (hero.area != "") { points.push(hero.area) }
  } else if (account != nil) {
    points.push(gameName(account.program))
  } else if (hero != nil && hero.area != "") {
    points.push(hero.area)
  }
  return points.join(" · ")
}

function online(friend: Friend): Boolean { return friend.presence != .Offline }

function levelOf(friend: Friend): Integer { return friend.hero?.level ?? 0 }

function whereOf(friend: Friend): String { return (friend.hero?.area ?? "").lower() }

// Below 0 where the first text comes first, above 0 where the second does, 0 where they are the same.
function textOrder(a: String, b: String): Integer {
  if (a == b) { return 0 }
  return a < b ? -1 : 1
}

// How two friends stand by the sort, each sort's own way first: names and places from A, the highest level, those
// online.
function sortOrder(a: Friend, b: Friend, sorted: Integer): Integer {
  return match (sorted) {
    BY_LEVEL => levelOf(b) - levelOf(a)
    BY_WHERE => textOrder(whereOf(a), whereOf(b))
    BY_STATUS => (online(a) ? 0 : 1) - (online(b) ? 0 : 1)
    else => 0
  }
}

// Whether a friend comes before another: best friends first whichever way, then the sort (turned round where the
// player turned it), then the name.
function before(a: Friend, b: Friend, sorted: Integer, descending: Boolean): Boolean {
  const aFavorite = a.account?.favorite == true
  const bFavorite = b.account?.favorite == true
  if (aFavorite != bFavorite) { return aFavorite }
  let order = sortOrder(a, b, sorted)
  if (order == 0) { order = textOrder(titleOf(a).lower(), titleOf(b).lower()) }
  return descending ? order > 0 : order < 0
}

// Whether a friend is found by what the player typed: in the names, the BattleTag, the zone or the note.
function found(friend: Friend, query: String): Boolean {
  if (query == "") { return true }
  const hero = friend.hero
  const account = friend.account
  const text = [account?.battleTag ?? "", hero?.name ?? "", hero?.area ?? "", friend.note].join(" ").lower()
  return text.contains(query.lower())
}

// Whether the filter lets a friend through: its kind's switch, and its presence's (a search finds those offline too).
function passes(friend: Friend, filter: Map<FriendFilter, Boolean>, query: String): Boolean {
  const kind = friend.account != nil ? FriendFilter.BattleNet : FriendFilter.Characters
  const presence = online(friend) ? FriendFilter.Online : FriendFilter.Offline
  return filter[kind] == true && (filter[presence] == true || (query != "" && !online(friend)))
}

// The friends the list shows, in its order.
public function shownOf(friends: Array<Friend>, query: String, kept: FriendsKept): Array<Friend> {
  const shown = friends.filter(friend => found(friend, query) && passes(friend, kept.filter, query))
  shown.sort((a, b) => before(a, b, kept.sorted, kept.descending))
  return shown
}

// The filter as the list starts it: both kinds, those online, and those offline as the settings say.
public function filterStart(offline: Boolean): mut Map<FriendFilter, Boolean> {
  return switched(switched({}, [FriendFilter.BattleNet, FriendFilter.Characters, FriendFilter.Online], true), [FriendFilter.Offline], offline)
}

// A friend as a row of the list: a left click, Enter or Space picks it, a right click opens the game's menu of it.
class FriendRow implements Component {
  public pick: Event<String> = new Event()
  public menu: Event<String> = new Event()

  derived level: String = self.friend.hero != nil ? Locale.ROW_LEVEL.format(levelOf(self.friend)) : ""
  derived favorite: Boolean = self.friend.account?.favorite == true
  derived background: Color | ByInteractionState<Color> = rowShade(self.picked)

  friend: Signal<Friend>
  picked: Signal<Boolean>
  constructor(friend: Signal<Friend>, picked: Signal<Boolean>) {
    self.friend = friend
    self.picked = picked
  }

  onPick(mut self) { self.pick.emit(keyOf(self.friend)) }
  onMenu(mut self) { self.menu.emit(keyOf(self.friend)) }

  public render(self): Template {
    return $ltml {
      <box columns={ROW} gap={2sp} yAlign={Align.Center} padding={PICK_PAD} background={self.background}
           @pointerPress(.Left)={self.onPick} @pointerPress(.Right)={self.onMenu} @keyPress(.Enter)={self.onPick}
           @keyPress(.Space)={self.onPick}>
        <box width={Style.ROW_ICON} height={Style.ROW_ICON} background={markOf(self.friend.presence)} />
        <box columns={{ each: "max-content" }} gap={2sp} yAlign={Align.Center}>
          <text value={titleOf(self.friend)} textColor={nameColorOf(self.friend)} wrap={.Cut} />
          <text $if={self.level != ""} value={self.level} textColor={Style.DIM} textFont={.Numbers} wrap={.None} />
          <box $if={self.favorite} width={Style.ROW_ICON} height={Style.ROW_ICON} background={Style.STAR_ICON} />
        </box>
        <box />
        <text value={pointsOf(self.friend)} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.Cut} />
      </box>
    }
  }
}

// A friend as a row of the table: the name (the star after a best friend's), the level, where it is or what it plays,
// and the note, the one text cut at its column. A right click opens the game's menu of it.
class FriendTableRow implements Component {
  public pick: Event<String> = new Event()
  public menu: Event<String> = new Event()

  derived level: String = self.friend.hero != nil ? String.of(levelOf(self.friend)) : ""
  derived favorite: Boolean = self.friend.account?.favorite == true

  friend: Signal<Friend>
  picked: Signal<Boolean>
  constructor(friend: Signal<Friend>, picked: Signal<Boolean>) {
    self.friend = friend
    self.picked = picked
  }

  onPick(mut self, button: MouseButton) {
    if (button == .Right) {
      self.menu.emit(keyOf(self.friend))
    } else {
      self.pick.emit(keyOf(self.friend))
    }
  }

  public render(self): Template {
    return $ltml {
      <TableRow tracks={TRACKS} selected={self.picked} @pick={self.onPick}>
        <TableCell>
          <box columns={[Style.DOT, { fr: 1 }, "max-content"]} gap={2sp} yAlign={Align.Center}>
            <box width={Style.DOT} height={Style.DOT} background={markOf(self.friend.presence)} />
            <text value={titleOf(self.friend)} textColor={nameColorOf(self.friend)} />
            <box $if={self.favorite} width={Style.STAR} height={Style.STAR} background={Style.STAR_ICON} />
          </box>
        </TableCell>
        <TableCell align={Align.End}>
          <text value={self.level} textColor={Style.DIM} textFont={.Numbers} />
        </TableCell>
        <TableCell>
          <text value={pointsOf(self.friend)} textColor={Style.DIM} />
        </TableCell>
        <TableCell>
          <text value={self.friend.note} textColor={Style.DIM} wrap={.Cut} />
        </TableCell>
      </TableRow>
    }
  }
}

// The friends' list with its tools, as every list window's: the toolbar (the search, the filter, the sort and the
// view) and «Добавить друга» beside it.
public class FriendList implements Component {
  public pick: Event<String> = new Event()
  public menu: Event<String> = new Event()
  public add: Event<nil> = new Event()

  state query = ""
  derived filterStarts: Map<FriendFilter, Boolean> = filterStart(self.offline)
  derived shown: Array<Friend> = shownOf(self.friends, self.query, self.kept.values)
  // The settings' «offline» as last heard: a change of it switches the kept filter's, the first hearing doesn't.
  offlineHeard: Boolean | nil = nil

  friends: Signal<Array<Friend>>
  picked: Signal<String>
  offline: Signal<Boolean>
  kept: mut ModuleMemory<FriendsKept>
  constructor(friends: Signal<Array<Friend>>, picked: Signal<String>, offline: Signal<Boolean>, kept: mut ModuleMemory<FriendsKept>) {
    self.friends = friends
    self.picked = picked
    self.offline = offline
    self.kept = kept
    watch (shows of self.offline) { self.onOffline(shows) }
  }

  // The filter starts as the settings say where none is kept, and follows a change of them.
  onOffline(mut self, shows: Boolean) {
    const now = peek self.kept.values
    const first = self.offlineHeard == nil
    self.offlineHeard = shows
    if (first && now.filter[FriendFilter.Online] != nil) { return }
    const filter = first ? filterStart(shows) : switched(now.filter, [FriendFilter.Offline], shows)
    self.kept.write({ filter: filter, ..now })
  }

  onPick(mut self, key: String) { self.pick.emit(key) }
  onMenu(mut self, key: String) { self.menu.emit(key) }
  onAdd(mut self) { self.add.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={1} rows={["max-content", { fr: 1 }]} gap={3sp}>
        <box columns={[{ fr: 1 }, "max-content"]} gap={3sp} yAlign={Align.Center} padding={Style.SIDE_ROOM}>
          <Toolbar search={mut self.query} placeholder={Locale.SEARCH}>
            <FilterButton values={mut self.kept.values.filter} start={self.filterStarts} groups={FILTERS} />
            <ToolSort sorted={mut self.kept.values.sorted} columns={COLUMNS} title={Locale.SORT} more={MORE_SORTS} />
            <ToolPick value={mut self.kept.values.view} choices={VIEWS} icon={Ordaen.art.ctl.tool.columns} title={Locale.VIEW} />
          </Toolbar>
          <PushButton label={Locale.ADD_FRIEND} width={Style.BUTTON} @click={self.onAdd} />
        </box>
        <box $if={self.kept.values.view == .Table} columns={1} rows={[{ fr: 1 }]}>
          <Table columns={COLUMNS} sorted={mut self.kept.values.sorted} descending={mut self.kept.values.descending} rowsVary={true}>
            <FriendTableRow $for={friend of self.shown} $key={keyOf(friend)} friend={friend}
                            picked={keyOf(friend) == self.picked} @pick={self.onPick} @menu={self.onMenu} />
          </Table>
        </box>
        <ScrolledList $else columns={1}>
          <text $if={self.shown.length == 0} value={Locale.NOTHING_FOUND} textColor={Style.DIM} />
          <FriendRow $for={friend of self.shown} $key={keyOf(friend)} friend={friend}
                     picked={keyOf(friend) == self.picked} @pick={self.onPick} @menu={self.onMenu} />
        </ScrolledList>
      </box>
    }
  }
}

// A character as the card says it: «Торгрим, Воин 25 · Пламегор».
function heroText(hero: Hero): String {
  const realm = hero.realm != "" ? ` · ${hero.realm}` : ""
  return `${hero.name}, ${hero.className} ${hero.level}${realm}`
}

public function orDash(text: String): String { return text != "" ? text : Locale.DASH }

// The picked friend's card: who it is, how it stands, what it plays and where (an offline Battle.net friend: the
// character last seen on), the note; Шепнуть, Пригласить, «Удалить» (which asks first) and ⋮, the game's own menu
// of the friend.
public class FriendCard implements Component {
  public whisper: Event<nil> = new Event()
  public invite: Event<nil> = new Event()
  public remove: Event<nil> = new Event()
  public menu: Event<nil> = new Event()

  derived title: String = titleOf(self.friend)
  derived color: Color = nameColorOf(self.friend)
  derived sub: String = self.subOf()
  derived favorite: Boolean = self.friend.account?.favorite == true
  derived status: String = self.statusOf()
  derived plays: String = self.friend.account != nil && online(self.friend) ? gameName(self.friend.account?.program ?? "") : ""
  derived hero: String = self.friend.hero != nil ? heroText(self.friend.hero ?? panic("tested")) : ""
  derived heroLabel: String = self.friend.account != nil && !online(self.friend) ? Locale.LAST_SEEN_AS : Locale.CHARACTER
  derived where: String = online(self.friend) ? orDash(self.friend.hero?.area ?? "") : Locale.DASH
  derived broadcast: String = self.friend.account?.broadcast ?? ""
  derived canWhisper: Boolean = online(self.friend)
  derived canInvite: Boolean = online(self.friend) && (self.friend.account == nil || self.friend.account?.gameAccount != 0)

  friend: Signal<Friend>
  constructor(friend: Signal<Friend>) {
    self.friend = friend
  }

  subOf(self): String {
    const account = self.friend.account
    if (account != nil) { return Locale.CARD_BATTLE_NET.format(account.battleTag) }
    const hero = self.friend.hero
    if (hero == nil) { return "" }
    return Locale.CARD_CHARACTER.format(hero.className, hero.level, hero.realm)
  }

  statusOf(self): String {
    const text = presenceText(self.friend.presence)
    const last = self.friend.account?.lastOnline ?? 0
    if (self.friend.presence == .Offline && last > 0) { return `${text} · ${agoText(last)}` }
    return text
  }

  onWhisper(mut self) { self.whisper.emit() }
  onInvite(mut self) { self.invite.emit() }
  onRemove(mut self) { self.remove.emit() }
  onMenu(mut self) { self.menu.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={1} rows={["max-content", { fr: 1 }, "max-content"]} gap={6sp}>
        <box columns={1} gap={3sp}>
          <box columns={[Style.BIG_DOT, { fr: 1 }]} gap={2sp} yAlign={Align.Center}>
            <box width={Style.BIG_DOT} height={Style.BIG_DOT} background={markOf(self.friend.presence)} />
            <box columns={1}>
              <box columns={["max-content", "max-content"]} gap={2sp}>
                <text value={self.title} textColor={self.color} textSize={TITLE_TEXT} leading={.Title} textFont={.Title} wrap={.None} />
                <box $if={self.favorite} width={Style.STAR} height={Style.STAR} background={Style.STAR_ICON} />
              </box>
              <text value={self.sub} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.None} />
            </box>
          </box>
          <text $if={self.broadcast != ""} value={Locale.QUOTED.format(self.broadcast)} textColor={Style.INK} />
          <Fact label={Locale.STATUS} value={self.status} />
          <Fact $if={self.plays != ""} label={Locale.PLAYS} value={self.plays} />
          <Fact $if={self.hero != ""} label={self.heroLabel} value={self.hero} />
          <Fact label={Locale.WHERE} value={self.where} />
          <Fact label={Locale.NOTE} value={orDash(self.friend.note)} />
        </box>
        <box />
        <box columns={["max-content", "max-content", "max-content", "max-content"]} gap={3sp}>
          <PushButton label={Locale.WHISPER} width={Style.SMALL_BUTTON} disabled={!self.canWhisper} @click={self.onWhisper} />
          <PushButton label={Locale.INVITE} width={Style.SMALL_BUTTON} disabled={!self.canInvite} @click={self.onInvite} />
          <PushButton label={Locale.REMOVE} width={Style.SMALL_BUTTON} plate={ButtonPlate.Danger} @click={self.onRemove} />
          <PushButton label={Locale.MORE} width={Style.MENU_BUTTON} @click={self.onMenu} />
        </box>
      </box>
    }
  }
}

// The player's own card, with no friend picked: the BattleTag, the status to pick (the game's four), the broadcast
// (read here, changed in its own dialog), the character and where it is.
public class MyCard implements Component {
  public presence: Event<Presence> = new Event()
  public edit: Event<nil> = new Event()
  public copy: Event<nil> = new Event()

  // The status picked here: the client's, until the player picks another.
  state picked: Presence = .Online
  derived connected: Boolean = self.me.battleTag != ""

  me: Signal<BattleNetSelf>
  constructor(me: Signal<BattleNetSelf>) {
    self.me = me
    watch (now of self.me) { self.picked = now.presence }
  }

  // A status picked, in the player's click: the client sets it from that click alone.
  onPick(mut self, chosen: Presence) {
    if (chosen != (peek self.me).presence) { self.presence.emit(chosen) }
  }

  onEdit(mut self) { self.edit.emit() }
  onCopy(mut self) { self.copy.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={1} rows={["max-content", { fr: 1 }, "max-content"]} gap={6sp}>
        <box columns={1} gap={3sp}>
          <box columns={[Style.BIG_DOT, { fr: 1 }]} gap={2sp} yAlign={Align.Center}>
            <box width={Style.BIG_DOT} height={Style.BIG_DOT} background={markOf(self.me.presence)} />
            <box columns={1}>
              <text value={self.connected ? self.me.battleTag : self.me.hero.name} textColor={Style.BATTLE_NET}
                    textSize={TITLE_TEXT} leading={.Title} textFont={.Title} wrap={.None} />
              <text value={Locale.YOU} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.None} />
            </box>
          </box>
          <box $if={self.connected} columns={[117.1875dp, { fr: 1 }]} gap={2sp} yAlign={Align.Center}>
            <text value={Locale.STATUS} textColor={Style.DIM} wrap={.None} />
            <CompactDropdown value={mut self.picked} choices={PRESENCES} width={Style.WIDE_BUTTON} @pick={self.onPick} />
          </box>
          <Fact $if={self.connected} label={Locale.BROADCAST} value={orDash(self.me.broadcast)} />
          <Fact label={Locale.CHARACTER} value={heroText(self.me.hero)} color={classColor(self.me.hero.classFile) ?? Style.INK} />
          <Fact label={Locale.WHERE} value={orDash(self.me.hero.area)} />
        </box>
        <box />
        <box $if={self.connected} columns={["max-content", "max-content"]} gap={3sp}>
          <PushButton label={Locale.EDIT_BROADCAST} width={Style.CARD_BUTTON} @click={self.onEdit} />
          <PushButton label={Locale.COPY_BATTLE_TAG} width={Style.CARD_BUTTON} @click={self.onCopy} />
        </box>
      </box>
    }
  }
}

class RequestRow implements Component {
  public answer: Event<(FriendRequest, Boolean)> = new Event()

  request: Signal<FriendRequest>
  constructor(request: Signal<FriendRequest>) {
    self.request = request
  }

  onAccept(mut self) { self.answer.emit(self.request, true) }
  onDecline(mut self) { self.answer.emit(self.request, false) }

  public render(self): Template {
    return $ltml {
      <box columns={[{ fr: 1 }, "max-content", "max-content"]} gap={3sp} yAlign={Align.Center} padding={ROW_PAD}>
        <box columns={1}>
          <text value={self.request.name} textColor={Style.BATTLE_NET} wrap={.None} />
          <text value={agoText(self.request.sent)} textColor={Style.DIM} textSize={SECONDARY_TEXT} wrap={.None} />
        </box>
        <PushButton label={Locale.ACCEPT} width={Style.SMALL_BUTTON} @click={self.onAccept} />
        <PushButton label={Locale.DECLINE} width={Style.SMALL_BUTTON} @click={self.onDecline} />
      </box>
    }
  }
}

// The requests received: Принять or Отклонить each.
public class RequestList implements Component {
  public answer: Event<(FriendRequest, Boolean)> = new Event()

  derived heading: String = Locale.RECEIVED.format(self.requests.length)

  requests: Signal<Array<FriendRequest>>
  constructor(requests: Signal<Array<FriendRequest>>) {
    self.requests = requests
  }

  onAnswer(mut self, request: FriendRequest, accept: Boolean) { self.answer.emit(request, accept) }

  public render(self): Template {
    return $ltml {
      <ScrolledList columns={1} gap={2sp}>
        <text value={self.heading} textColor={Style.GOLD} wrap={.None} />
        <text $if={self.requests.length == 0} value={Locale.NO_REQUESTS} textColor={Style.DIM} />
        <RequestRow $for={request of self.requests} $key={request.id} request={request} @answer={self.onAnswer} />
      </ScrolledList>
    }
  }
}

function ignoredName(entry: Ignored): String {
  return match (entry) {
    .Character => entry.name
    .Account => entry.name
  }
}

function ignoredKey(entry: Ignored): String {
  return match (entry) {
    .Character => `wow:${entry.name}`
    .Account => `bn:${entry.id}`
  }
}

class IgnoredRow implements Component {
  public unignore: Event<Ignored> = new Event()

  entry: Signal<Ignored>
  constructor(entry: Signal<Ignored>) {
    self.entry = entry
  }

  onUnignore(mut self) { self.unignore.emit(self.entry) }

  public render(self): Template {
    return $ltml {
      <box columns={[{ fr: 1 }, "max-content"]} gap={3sp} yAlign={Align.Center} padding={ROW_PAD}>
        <text value={ignoredName(self.entry)} textColor={Style.INK} wrap={.None} />
        <PushButton label={Locale.UNIGNORE} width={Style.SMALL_BUTTON} @click={self.onUnignore} />
      </box>
    }
  }
}

// The black list: a name added, each taken off with Убрать.
public class IgnoreList implements Component {
  public ignore: Event<String> = new Event()
  public unignore: Event<Ignored> = new Event()

  state name = ""
  derived heading: String = Locale.IGNORED.format(self.ignored.length)

  ignored: Signal<Array<Ignored>>
  constructor(ignored: Signal<Array<Ignored>>) {
    self.ignored = ignored
  }

  onIgnore(mut self) {
    const name = trimmed(peek self.name)
    if (name == "") { return }
    self.name = ""
    self.ignore.emit(name)
  }

  onUnignore(mut self, entry: Ignored) { self.unignore.emit(entry) }

  public render(self): Template {
    return $ltml {
      <box columns={1} rows={["max-content", "max-content", { fr: 1 }]} gap={3sp}>
        <box columns={[{ fr: 1 }, "max-content"]} gap={3sp} yAlign={Align.Center} padding={Style.SIDE_ROOM}>
          <Field value={mut self.name} maxLength={48} @submit={self.onIgnore} />
          <PushButton label={Locale.ADD_IGNORE} width={Style.WIDE_BUTTON} @click={self.onIgnore} />
        </box>
        <box padding={Style.SIDE_ROOM}>
          <text value={Locale.IGNORE_HINT} textColor={Style.DIM} textSize={SECONDARY_TEXT} />
        </box>
        <ScrolledList columns={1} gap={2sp}>
          <text value={self.heading} textColor={Style.GOLD} wrap={.None} />
          <text $if={self.ignored.length == 0} value={Locale.IGNORE_EMPTY} textColor={Style.DIM} />
          <IgnoredRow $for={entry of self.ignored} $key={ignoredKey(entry)} entry={entry} @unignore={self.onUnignore} />
        </ScrolledList>
      </box>
    }
  }
}
