// The guild tab's own parts: the guild's card beside its roster (its name, the message of the day and the information,
// «Пригласить в гильдию», «Покинуть гильдию», and the game's own guild window for a player who may manage the guild:
// the management the client keeps to itself stays there), and the guild's news, each line's text selected and copied.
// The counts are the footer's.
import Client from "$client"
import { GuildNews, GuildRoster, NewsFilter, NewsKind } from "$game"
import { Align, Overflow } from "$ltml"
import { ButtonPlate, Component, CopyText, FilterButton, FilterGroup, FilterOption, ItemButton, PushButton, TITLE_LINE, TITLE_TEXT, Tip, TipText } from "Ordaen"
import { orDash } from "@/friends"
import Locale from "@/locales"
import Style from "@/style"

const ROW_PAD = 1sp

// The guild's card, with no member picked.
public class GuildCard implements Component {
  public invite: Event<nil> = new Event()
  public leave: Event<nil> = new Event()
  public gameWindow: Event<nil> = new Event()

  guild: Signal<GuildRoster>
  constructor(guild: Signal<GuildRoster>) {
    self.guild = guild
  }

  onInvite(self) { self.invite.emit() }
  onLeave(self) { self.leave.emit() }
  onGameWindow(self) { self.gameWindow.emit() }

  public render(self): Template {
    return $ltml {
      <box columns={1} rows={["max-content", { fr: 1 }, "max-content"]} gap={6sp}>
        <text value={self.guild.name} textColor={Style.GOLD} textSize={TITLE_TEXT} lineHeight={TITLE_LINE} textFont={.Title} wrap={.None} />
        <box columns={1} rows={["max-content", "max-content", "max-content", { fr: 1 }]} gap={3sp} overflow={Overflow.Scroll}>
          <text value={Locale.MOTD} textColor={Style.DIM} wrap={.None} />
          <CopyText value={orDash(self.guild.motd)} />
          <text value={Locale.GUILD_INFO} textColor={Style.DIM} wrap={.None} />
          <CopyText value={orDash(self.guild.info)} />
        </box>
        <box columns={1} gap={3sp}>
          <PushButton $if={self.guild.rights.invite} label={Locale.GUILD_INVITE} width={Style.CARD_BUTTON} @click={self.onInvite} />
          <PushButton $if={self.guild.rights.manage} label={Locale.GAME_GUILD_WINDOW} width={Style.CARD_BUTTON} @click={self.onGameWindow} />
          <PushButton label={Locale.LEAVE_GUILD} width={Style.CARD_BUTTON} plate={ButtonPlate.Danger} @click={self.onLeave} />
        </box>
      </box>
    }
  }
}

// Whether a line of news is of an item: looted, crafted or bought (the game's own tooltip of the item is its).
function ofItem(kind: NewsKind): Boolean {
  return kind == .Looted || kind == .Crafted || kind == .Bought || kind == .LegendaryLooted
}

// What a line's tooltip says, as the game's guild news says it: an achievement's name and description, a boss and
// where it fell. Nothing for an item's (the item's own button shows the game's) or for the rest.
function tipOf(news: GuildNews): TipText | nil {
  if (news.kind == .Achievement || news.kind == .GuildAchievement) {
    let _, name, _, _, _, _, _, description, _, _, _, _, _, _ = Client.GetAchievementInfo(news.subject)
    if (name == nil) { return nil }
    return { title: name, text: description ?? "", rows: [] }
  }
  if (news.kind == .Encounter) { return { title: news.what, text: Locale.NEWS_ENCOUNTER, rows: [] } }
  return nil
}

class NewsRow implements Component {
  state hovered = false
  derived date: String = Locale.NEWS_DATE.format(self.news.day, self.news.month)
  derived item: Boolean = ofItem(self.news.kind)
  derived tip: TipText | nil = self.hovered ? tipOf(self.news) : nil

  news: Signal<GuildNews>
  constructor(news: Signal<GuildNews>) {
    self.news = news
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box columns={["max-content", { fr: 1 }]} gap={3sp} padding={{ top: ROW_PAD, bottom: ROW_PAD }}
           @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <text value={self.date} textColor={Style.DIM} textFont={.Numbers} wrap={.None} />
        <box columns={["max-content", "max-content", { fr: 1 }]} gap={2sp} yAlign={Align.Center}>
          <text value={self.news.who} textColor={self.news.sticky ? Style.GOLD : Style.INK} wrap={.None} />
          <ItemButton $if={self.item} item={self.news.subject} size={Style.NEWS_ITEM} />
          <box $else />
          <CopyText value={self.news.what} />
        </box>
        <Tip $if={self.tip != nil} title={self.tip?.title ?? ""} text={self.tip?.text ?? ""} />
      </box>
    }
  }
}

// The news filter's kinds the game offers, by their numbers: each on as the client keeps it.
function optionOf(filter: NewsFilter): FilterOption<Integer> { return { key: filter.kind, label: filter.label } }

function filterGroups(filters: Array<NewsFilter>): Array<FilterGroup<Integer>> {
  return [{ label: nil, options: filters.map(filter => optionOf(filter)) }]
}

function filterValues(filters: Array<NewsFilter>): Map<Integer, Boolean> {
  const values: Map<Integer, Boolean> = {}
  for (filter of filters) { values[filter.kind] = filter.shown }
  return values
}

function allShown(filters: Array<NewsFilter>): Map<Integer, Boolean> {
  const values: Map<Integer, Boolean> = {}
  for (filter of filters) { values[filter.kind] = true }
  return values
}

// The guild's news, as the game keeps it: the sticky lines first, then the newest. Its filter is the game's own (the
// server keeps it and sends the news again): a kind switched is asked of the game.
public class NewsList implements Component {
  public filter: Event<(Integer, Boolean)> = new Event()

  state picked: Map<Integer, Boolean> = {}
  derived shown: Array<GuildNews> = self.ordered()
  derived start: Map<Integer, Boolean> = allShown(self.filters)

  news: Signal<Array<GuildNews>>
  filters: Signal<Array<NewsFilter>>
  // The kinds the game offers here, as the list is made: the game's own, which don't change.
  const groups: Array<FilterGroup<Integer>>
  constructor(news: Signal<Array<GuildNews>>, filters: Signal<Array<NewsFilter>>) {
    self.news = news
    self.filters = filters
    self.groups = filterGroups(peek filters)
    watch (now of self.filters) { self.picked = filterValues(now) }
    watch (chosen of self.picked) { self.onPicked(chosen) }
  }

  // What the player switched, asked of the game: each kind whose switch isn't what the game keeps.
  onPicked(mut self, chosen: Map<Integer, Boolean>) {
    for (filter of peek self.filters) {
      const on = chosen[filter.kind] ?? false
      if (on != filter.shown) { self.filter.emit(filter.kind, on) }
    }
  }

  ordered(self): Array<GuildNews> {
    const list = self.news.filter(line => line.sticky)
    for (line of self.news) {
      if (!line.sticky) { list.push(line) }
    }
    return list
  }

  public render(self): Template {
    return $ltml {
      <box columns={1} rows={["max-content", { fr: 1 }]} gap={3sp}>
        <box columns={[{ fr: 1 }, "max-content"]} yAlign={Align.Center}>
          <box />
          <FilterButton values={mut self.picked} start={self.start} groups={self.groups} />
        </box>
        <box columns={1} overflow={Overflow.Scroll} yAlign={Align.Start}>
          <text $if={self.shown.length == 0} value={Locale.NO_NEWS} textColor={Style.DIM} />
          <NewsRow $for={line of self.shown} news={line} />
        </box>
      </box>
    }
  }
}
