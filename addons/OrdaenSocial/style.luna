public const HEIGHT: Number<Length> = 679.6875dp
// The friends' list; the card takes the rest.
public const CARD: Number<Length> = 492.1875dp
public const DOT: Number<Length> = 14.0625dp
public const BIG_DOT: Number<Length> = 18.75dp
public const FIELD: Number<Length> = 35.15625dp
public const SEARCH: Number<Length> = 164.0625dp
public const BUTTON: Number<Length> = 152.34375dp
public const WIDE_BUTTON: Number<Length> = 246.09375dp
public const SMALL_BUTTON: Number<Length> = 128.90625dp
// The player's own card's two buttons, side by side in it.
public const CARD_BUTTON: Number<Length> = 210.9375dp
public const ASK: Number<Length> = 515.625dp
public const ASK_BUTTON: Number<Length> = 175.78125dp
// The card beside a roster or the recent allies: a member's, the guild's, a community's, an ally's.
public const SIDE_CARD: Number<Length> = 351.5625dp

public const INK: Color = Color.hex("#e8dcc4")
public const DIM: Color = Color.hex("#a3977f")
public const GOLD: Color = Color.hex("#ffd100")
