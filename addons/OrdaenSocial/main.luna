// Ordaen Social: friends, the guild, communities and recent allies in one window of four tabs, each with its icon and its
// count. It opens in place of the game's own friends window and its guild and communities window: whatever shows the
// game's (O and J, the micro menu's button, the panel's friends cell, another addon's `ToggleFriendsFrame` or
// `ToggleGuildFrame`) shows ours, the game's held unseen and off the screen while ours shows, and the game's page picks
// ours (recent allies, the black list). Closing ours closes the game's. Its hooks are on the game's frames' show and
// hide, never in place of the game's code. The raid is a window of its own, not this one's.
//
// The guild's management the client keeps to itself (removing a member, ranks and their rights, editing the message of
// the day, the information and the notes) stays the game's: the guild's card opens the game's own window, shown as it
// is until it closes. What the window shows is read as it opens and again when the game says it changed, and only
// while it shows.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { AllyCategory, BattleNetSelf, Club, ClubStream, Friend, FriendRequest, GuildNews, GuildRights, GuildRoster, Ignored, Member, NewsFilter, Presence, RecentAlly } from "$game"
import { Align, Event, Frame } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { ButtonPlate, CopyBox, Dialog, Field, FooterCount, GamePass, KeptWindow, ListFooter, Module, ModuleMemory, PushButton, SECONDARY_TEXT, Settings, SettingsPage, Tabs, Window, WindowSide, WindowTabSpec, WindowsPage, trimmed, windowsTitle } from "Ordaen"
import { AllyCard, AllyFilter, AllyList, allyFilterStart, categoriesOf } from "@/allies"
import { ClubCard } from "@/communities"
import { FRIENDS_KEPT, FriendCard, FriendList, FriendsKept, IgnoreList, MyCard, RequestList, keyOf, titleOf } from "@/friends"
import { GuildCard, NewsList } from "@/guild"
import Locale from "@/locales"
import { MemberCard, MemberTable } from "@/members"
import { ClientPeople, People, namesAccount } from "@/people"
import { SEEN_HEROES, SeenHeroes, noteSeen, withSeen } from "@/seen"
import { Choices, GeneralPage } from "@/settings"
import Style from "@/style"
import { KeptTalk, KeptTalks, KnownPeople, THIS_SESSION, Talk, TalkWho, isBattleNet, isTold, isWhisper, keptOf, talkKey, whoOf } from "@/talks"
import { TalkPick, Whispers } from "@/whispers"

// The tabs, in order, and the friends' and the guild's own.
public const TAB_FRIENDS = 1
public const TAB_GUILD = 2
public const TAB_COMMUNITIES = 3
public const TAB_ALLIES = 4
public const TAB_WHISPERS = 5
public const SUB_STATUS = 1
public const SUB_REQUESTS = 2
public const SUB_IGNORE = 3
public const SUB_ROSTER = 1
public const SUB_NEWS = 2
// The tabs' icons: the game's own.
const ICON_FRIENDS: Asset = "Interface/Icons/Achievement_GuildPerk_EverybodysFriend"
const ICON_GUILD: Asset = "Interface/Icons/INV_Shirt_GuildTabard_01"
const ICON_COMMUNITIES: Asset = "Interface/Icons/INV_Misc_GroupNeedMore"
const ICON_ALLIES: Asset = "Interface/Icons/INV_Misc_GroupLooking"
const ICON_WHISPERS: Asset = "Interface/Icons/INV_Letter_15"
// Where the conversations' last lines are kept between sessions, the character's.
const TALKS_KEPT = "OrdaenSocial:whispers"
// The addon's folder, which Ordaen's notices are told by.
const FOLDER = "OrdaenSocial"
// A web address the chat made a link of in a whisper's words (Ordaen Chat's `linked`): shown to copy.
const WEB_LINK = "ordaenurl:"
// The game's friends window, and its pages, with the tab and the friends' page of ours each opens.
const FRIENDS_WINDOW = "FriendsFrame"
const GAME_WINDOWS: array<string> = [FRIENDS_WINDOW, "SocialUIFrame"]
// The game's guild and communities window, made as its addon loads.
const COMMUNITIES_ADDON = "Blizzard_Communities"
const COMMUNITIES_WINDOW = "CommunitiesFrame"
// The most the game's broadcast holds (`FriendsFrameBroadcastInput`'s letters), and a character's name.
const BROADCAST_MOST = 127
const NAME_MOST = 48
const NO_ME: BattleNetSelf = { battleTag: "", presence: .Online, broadcast: "", hero: { name: "", level: 0, className: "", classFile: "", area: "", realm: "" } }
// The most a recent ally's note holds (`RecentAlliesNoteEditBox`'s letters).
const NOTE_MOST = 48
const NO_RIGHTS: GuildRights = { invite: false, promote: false, demote: false, manage: false }
const GUILD_SUBS: array<string> = [Locale::SUB_ROSTER, Locale::SUB_NEWS]

function onlineOf(members: array<Member>): integer { return members.count(member => member.presence != .Offline) }

// A list's counts in the footer: how many it has, under its own label, and how many of them are online.
function counted(label: string, all: integer, online: integer): array<FooterCount> {
  return [{ label: label, value: string::of(all) }, { label: Locale::FOOT_ONLINE, value: string::of(online) }]
}

public class Social implements Module, App {
  public const title: string = "Ordaen Social"
  public window: mut KeptWindow = new KeptWindow("main", self.title, { x: 0ui, y: 0ui, width: Style::WIDTH, height: Style::HEIGHT })
  public const windows: mut array<mut KeptWindow> = [self.window]
  public const pages: array<SettingsPage> = [
    { title: Locale::TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
    { title: windowsTitle(), content: $ltml { <WindowsPage windows={mut self.windows} /> } }
  ]
  public settings: mut Settings<Choices> = new Settings<Choices>({ offline: true })
  // How the player left the friends' list: its view, its sort and its filter, the profile's.
  public friendsList: mut ModuleMemory<FriendsKept> = new ModuleMemory<FriendsKept>(FRIENDS_KEPT, .Profile, "friends")
  // What the window's clicks ask of the chat, the group and the clipboard: a test hands its own. The friends, the
  // guild, the communities and the recent allies are `"$game"`'s.
  public people: mut any People = new ClientPeople()
  // The character each Battle.net friend was last seen on, the account's.
  public seen: mut ModuleMemory<SeenHeroes> = new ModuleMemory<SeenHeroes>(SEEN_HEROES, .Account, "seen")

  public state open = false
  public state tab: integer = TAB_FRIENDS
  public state sub: integer = SUB_STATUS
  public state guildSub: integer = SUB_ROSTER
  // The game's own windows ours stands for, and those of them showing: held unseen and off the screen.
  games: mut array<any Client::Frame> = []
  state held: mut array<any Frame> = mut []
  // The game's guild and communities window once its addon has loaded, and the game's window the player asked for as
  // it is, until it closes.
  communities: any Client::Frame | nil = nil
  pass: mut GamePass = new GamePass()
  addonHeard: Handle | nil = nil
  // The friends as the client gives them; as the window shows them, an offline Battle.net friend with the character
  // last seen.
  state read: array<Friend> = []
  derived friends: array<Friend> = withSeen(self.read, self.seen.values.heroes)
  state requests: array<FriendRequest> = []
  state ignored: array<Ignored> = []
  state me: BattleNetSelf = NO_ME
  // The guild's message of the day: the client gives it in the player's input alone, and says it anew (`GUILD_MOTD`).
  state motd = ""
  state guild: GuildRoster | nil = nil
  state news: array<GuildNews> = []
  state newsFilters: array<NewsFilter> = []
  state clubs: array<Club> = []
  state clubMembers: array<Member> = []
  state streams: array<ClubStream> = []
  state allies: array<RecentAlly> = []
  // The recent allies' filter: the categories asked of the game, and online or not.
  state allyFilter: map<AllyFilter, boolean> = allyFilterStart()
  derived allyCategories: array<AllyCategory> | nil = categoriesOf(self.allyFilter)
  // The friend whose card shows, by `keyOf` (none: the player's own card); the guild member's, the community's
  // member's, the ally's, by their keys (none: the guild's card, the community's, no card). The community shown: its
  // tab's place.
  public state picked = ""
  public state member = ""
  public state clubTab = 1
  public state clubMember = ""
  public state ally = ""
  // The friend the player asked to remove, while the question shows.
  state removing: Friend | nil = nil
  // The add-friend window and the broadcast's, while they show, and what is typed in each.
  state adding = false
  state addText = ""
  state editing = false
  state draft = ""
  // The guild's invite window and the question before leaving it, while they show.
  state inviting = false
  state inviteText = ""
  state leaving = false
  // The recent ally's note dialog, while it shows, and what is typed in it.
  state noting = false
  state noteText = ""
  // The whisper conversations, the one last spoken in first, by their keys too; the one open in the whispers' tab.
  public state talks: array<Talk> = []
  talkMade: mut map<string, mut Talk> = {}
  public state talkOpen = ""
  // The whispers' lines waiting unread, all conversations': the whispers' tab says it, and the panel's friends cell.
  public state whispersUnread = 0
  // A web address in a whisper clicked: shown to copy.
  state copied = ""

  derived pickedFriend: Friend | nil = self.picked == "" ? nil : self.friends.find(friend => keyOf(friend) == self.picked)
  derived guildMembers: array<Member> = self.guild?.members ?? []
  // Who each conversation is with, by its key, as the people the window has read know them.
  derived talkWho: map<string, TalkWho> = self.talkWhoOf()
  derived rights: GuildRights = self.guild?.rights ?? NO_RIGHTS
  derived pickedMember: Member | nil = self.member == "" ? nil : self.guildMembers.find(one => one.key == self.member)
  derived chosenClub: Club | nil = self.clubs[self.clubTab] ?? self.clubs[1]
  derived clubNames: array<string> = self.clubs.map(one => one.name)
  derived clubId: string = self.chosenClub?.id ?? ""
  derived pickedClubMember: Member | nil = self.clubMember == "" ? nil : self.clubMembers.find(one => one.key == self.clubMember)
  derived pickedAlly: RecentAlly | nil = self.ally == "" ? nil : self.allies.find(one => one.member.key == self.ally)
  // The friends online, of the list as it was read (the window reads it while it shows, and shows nothing else).
  derived onlineCount: integer = self.friends.count(friend => friend.presence != .Offline)
  derived guildOnline: integer = onlineOf(self.guildMembers)
  derived tabs: array<WindowTabSpec> = [
    { title: Locale::TAB_FRIENDS, desc: Locale::ONLINE_COUNT.format(self.onlineCount), icon: ICON_FRIENDS, padding: Style::NO_ROOM },
    {
      title: Locale::TAB_GUILD, desc: self.guild != nil ? Locale::ONLINE_COUNT.format(self.guildOnline) : Locale::NO_GUILD_LOWER, icon: ICON_GUILD,
      padding: Style::NO_ROOM
    },
    { title: Locale::TAB_COMMUNITIES, desc: Locale::COMMUNITIES_COUNT.format(self.clubs.length), icon: ICON_COMMUNITIES, padding: Style::NO_ROOM },
    { title: Locale::TAB_ALLIES, desc: Locale::ALLIES_COUNT.format(self.allies.length), icon: ICON_ALLIES, padding: Style::NO_ROOM },
    { title: Locale::TAB_WHISPERS, desc: self.whispersDesc, icon: ICON_WHISPERS }
  ]
  derived whispersDesc: string = self.whispersUnread > 0 ? Locale::UNREAD_COUNT.format(self.whispersUnread) : Locale::TALKS_COUNT.format(self.talks.length)
  derived subTabs: array<string> = [Locale::SUB_STATUS, self.requestsTitle(), Locale::SUB_IGNORE]
  derived side: WindowSide | nil = self.sideOf()
  derived removeText: string = Locale::REMOVE_ASK.format(self.removing != nil ? titleOf(self.removing ?? panic("tested")) : "")
  derived removeDetail: string = self.removing?.account != nil ? Locale::REMOVE_BATTLE_NET : Locale::REMOVE_CHARACTER
  derived addRule: string = namesAccount(self.addText) ? Locale::ADD_RULE_BATTLE_NET : Locale::ADD_RULE_CHARACTER
  derived broadcastCount: string = Locale::BROADCAST_COUNT.format(self.draft.length, BROADCAST_MOST)
  derived leaveText: string = Locale::LEAVE_GUILD_ASK.format(self.guild?.name ?? "")
  derived counts: array<FooterCount> = self.countsOf()
  // The footer, as every list window's: the counts as label and value pairs.
  const footer: Template = $ltml { <ListFooter counts={self.counts} /> }

  constructor() {
    Ordaen.modules.add(self)
    self.recallTalks()
    Events::PLAYER_LOGOUT.listen(self.keepTalks)
    // The whispers waiting unread, for the panel's badge, which reads them by the folder.
    watch (unread of self.whispersUnread) { Ordaen.notice(FOLDER, unread) }
    // The whispers' tab shown with no conversation open opens one: the first waiting unread, else the newest. The open
    // one, while its tab shows, has nothing waiting.
    watch {
      if (!self.open || self.tab != TAB_WHISPERS) { return }
      if (self.talkMade[self.talkOpen] == nil) { self.talkOpen = self.firstTalk() }
      self.readTalk(self.talkOpen)
    }
    // The friends read: the characters Battle.net friends play here written down.
    watch (friends of self.read) { noteSeen(self.seen, friends, Client::GetServerTime()) }
    // The game's words about the people shown are heard while the window shows.
    watch (opened of self.open) {
      if (!opened) { return }
      self.refresh()
      Events::FRIENDLIST_UPDATE.listen(self.readFriends)
      Events::BN_FRIEND_INFO_CHANGED.listen(self.readFriends)
      Events::BN_FRIEND_LIST_SIZE_CHANGED.listen(self.readFriends)
      Events::BN_FRIEND_ACCOUNT_ONLINE.listen(self.readFriends)
      Events::BN_FRIEND_ACCOUNT_OFFLINE.listen(self.readFriends)
      Events::BN_FRIEND_INVITE_ADDED.listen(self.readRequests)
      Events::BN_FRIEND_INVITE_REMOVED.listen(self.readRequests)
      Events::BN_FRIEND_INVITE_LIST_INITIALIZED.listen(self.readRequests)
      Events::IGNORELIST_UPDATE.listen(self.readIgnored)
      Events::BN_BLOCK_LIST_UPDATED.listen(self.readIgnored)
      Events::BN_INFO_CHANGED.listen(self.readMe)
      Events::BN_CUSTOM_MESSAGE_CHANGED.listen(self.readMe)
      Events::GUILD_ROSTER_UPDATE.listen(self.readGuild)
      Events::PLAYER_GUILD_UPDATE.listen(self.readGuild)
      Events::GUILD_MOTD.listen(self.onMotd)
      Events::GUILD_NEWS_UPDATE.listen(self.readNews)
      Events::INITIAL_CLUBS_LOADED.listen(self.readClubs)
      Events::CLUB_ADDED.listen(self.readClubs)
      Events::CLUB_REMOVED.listen(self.readClubs)
      Events::CLUB_UPDATED.listen(self.readClubs)
      Events::CLUB_MEMBERS_UPDATED.listen(self.onClubChanged)
      Events::CLUB_MEMBER_UPDATED.listen(self.onClubChanged)
      Events::CLUB_MEMBER_PRESENCE_UPDATED.listen(self.onClubChanged)
      Events::CLUB_STREAMS_LOADED.listen(self.onClubChanged)
      Events::CLUB_STREAM_ADDED.listen(self.onClubChanged)
      Events::CLUB_STREAM_REMOVED.listen(self.onClubChanged)
      Events::CLUB_STREAM_UPDATED.listen(self.onClubChanged)
      Events::RECENT_ALLIES_CACHE_UPDATE.listen(self.readAllies)
      // The recent allies asked for again as the filter's categories change.
      watch { self.allies = Game::recentAllies.list(self.allyCategories) }
      // The picked community's members and streams, read as it is picked; its member's card goes.
      watch (id of self.clubId) {
        self.clubMember = ""
        self.readClub(id)
      }
    }
    for (name of GAME_WINDOWS) { self.hook(Runtime::frame(name), nil) }
    self.hookPage("FriendsListFrame", TAB_FRIENDS, SUB_STATUS)
    self.hookPage("FriendsFrame.IgnoreListWindow", TAB_FRIENDS, SUB_IGNORE)
    self.hookPage("RecentAlliesFrame", TAB_ALLIES, nil)
    // The game's guild and communities window: hooked once its addon has loaded.
    const communities = Runtime::frame(COMMUNITIES_WINDOW)
    if (communities != nil) {
      self.hookCommunities(communities)
    } else {
      self.addonHeard = Events::ADDON_LOADED.listen(self.onAddonLoaded)
    }
  }

  destructor() { Ordaen.notice(FOLDER, 0) }

  mut onAddonLoaded(name: string) {
    if (name != COMMUNITIES_ADDON) { return }
    if (self.addonHeard != nil) { destroy self.addonHeard }
    self.hookCommunities(Runtime::frame(COMMUNITIES_WINDOW))
  }

  // The game's guild and communities window: ours opens on the guild's tab (the communities' outside a guild).
  mut hookCommunities(frame: any Frame | nil) {
    if (frame == nil) { return }
    const window: any Client::Frame = frame
    self.communities = window
    self.hook(frame, TAB_GUILD)
  }

  // A game's window ours stands for: ours opens and closes with it (on `tab`, where it names one). Hooked as the game
  // names it, on its show and hide, which are rare.
  public mut hook(frame: any Frame | nil, tab: integer | nil) {
    if (frame == nil) { return }
    const window: any Client::Frame = frame
    self.games.push(window)
    _ = window.HookScript("OnShow", (): nil => {
      // In the key's or the click's own call: the message of the day, which the client gives then alone.
      if (!(peek self.open) && !self.pass.passes(frame)) { self.motd = Game::guild.motd() }
      self.onGameShown(frame, tab)
      return nil
    })
    _ = window.HookScript("OnHide", (): nil => {
      self.onGameHidden(frame)
      return nil
    })
    if (window.IsShown()) { self.onGameShown(frame, tab) }
  }

  // A page of the game's window (the friends' list, the black list, the recent allies): shown, ours turns to its tab
  // (and the friends' page).
  mut hookPage(name: string, tab: integer, sub: integer | nil) {
    const page = Runtime::frame(name)
    if (page == nil) { return }
    const shown: any Client::Frame = page
    _ = shown.HookScript("OnShow", (): nil => {
      self.window.ask(tab)
      if (sub != nil) { self.sub = sub }
      return nil
    })
  }

  // The game's window shown: ours shows in its place, unless the player asked for the game's window as it is.
  mut onGameShown(frame: any Frame, tab: integer | nil) {
    if (self.pass.passes(frame)) { return }
    if (tab == TAB_GUILD) {
      // The guild's window opens on the guild, outside one on the communities.
      self.readGuild()
      self.window.ask(peek self.guild != nil ? TAB_GUILD : TAB_COMMUNITIES)
    } else if (tab != nil) {
      self.window.ask(tab)
    }
    if (!(peek self.held).any(one => one == frame)) { self.held.push(frame) }
    if (!(peek self.open)) {
      self.open = true
      // In the key's or the click's own call, as the client's restricted calls want.
      Game::guild.ask()
      Game::recentAllies.ask()
    }
  }

  mut onGameHidden(frame: any Frame) {
    if (self.pass.hidden(frame)) { return }
    self.held = (peek self.held).filter(one => one != frame)
    if ((peek self.held).length == 0) { self.open = false }
  }

  public mut refresh() {
    self.readFriends()
    self.readRequests()
    self.readIgnored()
    self.readMe()
    self.readGuild()
    self.readNews()
    self.readClubs()
    self.readAllies()
  }

  // The friends read, and the characters Battle.net friends play here written down.
  mut readFriends() { self.read = Game::friends.list() }

  mut readRequests() { self.requests = Game::friends.requests() }
  mut readIgnored() { self.ignored = Game::friends.ignored() }
  mut readMe() { self.me = Game::friends.battleNetSelf() }
  mut readGuild() { self.guild = Game::guild.roster(peek self.motd) }

  mut onMotd(text: string) {
    self.motd = text
    self.readGuild()
  }

  mut readNews() {
    self.news = Game::guild.news()
    self.newsFilters = Game::guild.newsFilters()
  }
  mut readClubs() { self.clubs = Game::communities.clubs() }
  mut readAllies() { self.allies = Game::recentAllies.list(peek self.allyCategories) }

  mut readClub(id: string) {
    self.clubMembers = id == "" ? [] : Game::communities.members(id)
    self.streams = id == "" ? [] : Game::communities.streams(id)
  }

  // A community's members or streams changed: read again where it is the one shown.
  mut onClubChanged(club: string) {
    const shown = peek self.clubId
    if (club == shown) { self.readClub(shown) }
  }

  requestsTitle(): string {
    const waiting = self.requests.length
    return waiting > 0 ? Locale::SUB_REQUESTS_WAITING.format(waiting) : Locale::SUB_REQUESTS
  }

  // The footer's counts, of the tab shown.
  countsOf(): array<FooterCount> {
    return match (self.tab) {
      TAB_FRIENDS => counted(Locale::FOOT_FRIENDS, self.friends.length, self.onlineCount)
      TAB_GUILD => self.guild != nil ? counted(Locale::FOOT_MEMBERS, self.guildMembers.length, self.guildOnline) : []
      TAB_COMMUNITIES => self.chosenClub != nil ? counted(Locale::FOOT_MEMBERS, self.clubMembers.length, onlineOf(self.clubMembers)) : []
      TAB_ALLIES => [{ label: Locale::FOOT_ALLIES, value: string::of(self.allies.length) }]
      TAB_WHISPERS => [
        { label: Locale::FOOT_TALKS, value: string::of(self.talks.length) },
        { label: Locale::FOOT_UNREAD, value: string::of(self.whispersUnread) }
      ]
      else => []
    }
  }

  // A friend picked in the list: its card; picked again, the player's own. A guild's or a community's member, an ally:
  // the same.
  mut onPick(key: string) { self.picked = (peek self.picked) == key ? "" : key }
  mut onPickMember(key: string) { self.member = (peek self.member) == key ? "" : key }
  mut onPickClubMember(key: string) { self.clubMember = (peek self.clubMember) == key ? "" : key }
  mut onPickAlly(key: string) { self.ally = (peek self.ally) == key ? "" : key }

  // What the card's buttons ask, in the click's own call.
  // A friend whispered in the whispers' tab: a Battle.net friend by the account's token, which the client's whisper
  // takes; a character by name.
  mut onWhisper() {
    const friend = peek self.pickedFriend
    const account = friend?.account?.name
    const hero = friend?.hero?.name
    if (account != nil) {
      self.whisperTo(account, true)
    } else if (hero != nil) {
      self.whisperTo(hero, false)
    }
  }

  mut onInvite() {
    const friend = peek self.pickedFriend
    if (friend != nil) { Game::friends.invite(friend) }
  }

  // The game's own menu of a friend: a row's right click, the card's ⋮.
  mut onFriendMenu(key: string) {
    const friend = (peek self.friends).find(one => keyOf(one) == key)
    if (friend != nil) { Game::friends.menu(friend) }
  }

  mut onCardMenu() {
    const friend = peek self.pickedFriend
    if (friend != nil) { Game::friends.menu(friend) }
  }

  mut onRemove() { self.removing = peek self.pickedFriend }

  mut onRemoveYes() {
    const friend = peek self.removing
    self.removing = nil
    if (friend == nil) { return }
    Game::friends.remove(friend)
    self.picked = ""
    self.readFriends()
  }

  mut onRemoveNo() { self.removing = nil }

  mut onPresence(presence: Presence) {
    Game::friends.setPresence(presence)
    self.readMe()
  }

  mut onEditBroadcast() {
    self.draft = (peek self.me).broadcast
    self.editing = true
  }

  mut onBroadcastYes() {
    self.editing = false
    Game::friends.setBroadcast(trimmed(peek self.draft))
    self.readMe()
  }

  mut onBroadcastNo() { self.editing = false }

  mut onCopyTag() { self.people.copy((peek self.me).battleTag) }

  mut onAdd() {
    self.addText = ""
    self.adding = true
  }

  mut onAddYes() {
    const text = trimmed(peek self.addText)
    if (text == "") { return }
    self.adding = false
    Game::friends.add(text)
  }

  mut onAddNo() { self.adding = false }

  mut onAnswer(request: FriendRequest, accept: boolean) {
    Game::friends.answer(request, accept)
    self.readRequests()
    self.readFriends()
  }

  mut onIgnore(name: string) {
    Game::friends.ignore(name)
    self.readIgnored()
  }

  mut onUnignore(entry: Ignored) {
    Game::friends.unignore(entry)
    self.readIgnored()
  }

  // A guild's or a community's member, whispered or invited by name.
  mut onMemberWhisper() {
    const one = peek self.pickedMember ?? peek self.pickedClubMember
    if (one != nil) { self.whisperTo(one.name, false) }
  }

  mut onMemberInvite() {
    const one = peek self.pickedMember ?? peek self.pickedClubMember
    if (one != nil) { self.people.inviteTo(one.name) }
  }

  mut onPromote() {
    const one = peek self.pickedMember
    if (one == nil) { return }
    Game::guild.promote(one.name)
    self.readGuild()
  }

  mut onDemote() {
    const one = peek self.pickedMember
    if (one == nil) { return }
    Game::guild.demote(one.name)
    self.readGuild()
  }

  // The game's own menu of a guild member (its promote, demote, remove and notes among its entries) or of a
  // community's: a row's right click, the card's ⋮.
  mut onGuildMenu(key: string) { Game::guild.menu(key) }

  mut onClubMenu(key: string) {
    const club = peek self.clubId
    if (club != "") { Game::communities.menu(club, key) }
  }

  mut onMemberCardMenu() {
    const member = peek self.pickedMember
    if (member != nil) {
      self.onGuildMenu(member.key)
      return
    }
    const one = peek self.pickedClubMember
    if (one != nil) { self.onClubMenu(one.key) }
  }

  mut onNewsFilter(kind: integer, shown: boolean) {
    Game::guild.filterNews(kind, shown)
    self.newsFilters = Game::guild.newsFilters()
  }

  mut onGuildInvite() {
    self.inviteText = ""
    self.inviting = true
  }

  mut onGuildInviteYes() {
    const name = trimmed(peek self.inviteText)
    if (name == "") { return }
    self.inviting = false
    Game::guild.invite(name)
  }

  mut onGuildInviteNo() { self.inviting = false }
  mut onLeave() { self.leaving = true }

  mut onLeaveYes() {
    self.leaving = false
    Game::guild.leave()
    self.member = ""
    self.readGuild()
  }

  mut onLeaveNo() { self.leaving = false }

  // The game's own guild window, as it is: ours closes, the game's shows until it closes (loading its addon first where
  // nothing has yet).
  mut onGameGuild() {
    if (self.communities == nil) { _ = Client::C_AddOns::LoadAddOn(COMMUNITIES_ADDON) }
    const communities = self.communities
    if (communities != nil) { self.showGame(communities) }
  }

  // The game's window as it is: ours closes, the game's shows until it closes.
  mut showGame(frame: any Frame) {
    self.onClose()
    self.pass.pass(frame)
  }

  mut onAllyWhisper() {
    const one = peek self.pickedAlly
    if (one != nil) { self.whisperTo(one.fullName, false) }
  }

  mut onAllyInvite() {
    const one = peek self.pickedAlly
    if (one != nil) { self.people.inviteTo(one.fullName) }
  }

  mut onAllyPin() {
    const one = peek self.pickedAlly
    if (one == nil) { return }
    Game::recentAllies.pin(one.member.key, !one.pinned)
    self.readAllies()
  }

  mut onAllyBefriend() {
    const one = peek self.pickedAlly
    if (one == nil) { return }
    Game::friends.add(one.fullName)
    self.readAllies()
  }

  mut onAllyMenu(key: string) {
    const one = (peek self.allies).find(ally => ally.member.key == key)
    if (one != nil) { Game::recentAllies.menu(one) }
  }

  mut onAllyCardMenu() {
    const one = peek self.pickedAlly
    if (one != nil) { Game::recentAllies.menu(one) }
  }

  mut onAllyNote() {
    const one = peek self.pickedAlly
    if (one == nil) { return }
    self.noteText = one.member.note
    self.noting = true
  }

  mut onAllyNoteYes() {
    const one = peek self.pickedAlly
    self.noting = false
    if (one == nil) { return }
    Game::recentAllies.setNote(one.member.key, trimmed(peek self.noteText))
    self.readAllies()
  }

  mut onAllyNoteNo() { self.noting = false }

  // A line Ordaen Chat read (after every addon's filter), `whole` its words as the chat draws them; whether it was a
  // whisper, which is then the window's alone. A whisper is its conversation's, which goes first in the list; heard
  // while that conversation isn't the one shown, it waits unread.
  public mut heard(line: Game::ChatLine, whole: string): boolean {
    if (!isWhisper(line)) { return false }
    const told = isTold(line)
    const talk = self.talkOf(talkKey(line.sender, isBattleNet(line)))
    talk.add({ whole: whole, time: line.time, mine: told, secret: line.secret != "", sender: line.guid, session: THIS_SESSION })
    if (!told && !self.shows(talk.key)) { talk.unread = (peek talk.unread) + 1 }
    self.countUnread()
    return true
  }

  // A whisper started anywhere (a card's, the chat's, another addon's): the window shown on the whispers' tab, the
  // person's conversation open, a new one where there is none.
  public mut whisperTo(name: string, battleNet: boolean) {
    self.talkOpen = self.talkOf(talkKey(name, battleNet)).key
    if (!(peek self.open)) {
      const friends = Runtime::frame(FRIENDS_WINDOW)
      if (friends != nil) { Client::ShowUIPanel(friends) }
    }
    self.window.ask(TAB_WHISPERS)
  }

  // A player reported: their lines go from every conversation, as the game's windows take them away.
  public mut reported(guid: string) {
    if (guid == "") { return }
    for (_, talk of self.talkMade) { talk.forgetSender(guid) }
  }

  // The conversation the whispers' tab opens on: the first waiting unread, else the newest; none where there is none.
  firstTalk(): string {
    const talks = peek self.talks
    return (talks.find(talk => peek talk.unread > 0) ?? talks[1])?.key ?? ""
  }

  talkWhoOf(): map<string, TalkWho> {
    const members: array<Member> = mut []
    for (member of self.guildMembers) { members.push(member) }
    for (member of self.clubMembers) { members.push(member) }
    const known = KnownPeople { friends: self.friends, members: members, allies: self.allies }
    const who: map<string, TalkWho> = mut {}
    for (talk of self.talks) { who[talk.key] = whoOf(talk, known) }
    return who
  }

  // Whether a conversation is the one the player looks at.
  shows(key: string): boolean {
    return peek self.open && peek self.tab == TAB_WHISPERS && peek self.talkOpen == key
  }

  // A conversation, made where there is none, put first in the list.
  mut talkOf(key: string): mut Talk {
    const talk = self.talkMade[key] ?? new Talk(key)
    self.talkMade[key] = talk
    const talks: array<Talk> = mut [talk]
    for (other of peek self.talks) {
      if (other.key != key) { talks.push(other) }
    }
    self.talks = talks
    return talk
  }

  // A conversation looked at: nothing of it waits.
  mut readTalk(key: string) {
    const talk = self.talkMade[key]
    if (talk == nil || peek talk.unread == 0) { return }
    talk.unread = 0
    self.countUnread()
  }

  mut countUnread() {
    let unread = 0
    for (_, talk of self.talkMade) { unread += peek talk.unread }
    self.whispersUnread = unread
  }

  mut onTalkPick(talk: Talk) { self.talkOpen = talk.key }

  mut onTalkStart(name: string) { self.talkOpen = self.talkOf(talkKey(name, false)).key }

  // A conversation's menu picked: closed, or its lines cleared.
  mut onTalkMenu(pick: TalkPick) {
    const talk = self.talkMade[pick.talk.key]
    if (talk == nil) { return }
    match (pick.action) {
      .Close => { self.closeTalk(talk) }
      .Clear => { talk.clear() }
    }
    self.countUnread()
  }

  // A conversation closed: it leaves the list, nothing of it waiting; its lines are kept, and a whisper of the same
  // person brings it back with them (`talkOf`).
  mut closeTalk(talk: mut Talk) {
    talk.unread = 0
    self.talks = (peek self.talks).filter(other => other.key != talk.key)
    if (peek self.talkOpen == talk.key) { self.talkOpen = (peek self.talks)[1]?.key ?? "" }
  }

  // The words typed in a conversation, sent in the key's own call.
  mut onTalkSend(text: string) {
    const talk = self.talkMade[peek self.talkOpen]
    if (talk != nil) { _ = Game::chat.whisper(talk.partner, text, talk.battleNet) }
  }

  // A link in a whisper: a web address shown to copy; any other is the game's.
  mut onTalkLink(link: Event::Link) {
    if (link.link.sub(1, WEB_LINK.length) == WEB_LINK) {
      self.copied = link.link.sub(WEB_LINK.length + 1)
      return
    }
    Game::chat.click(link.link, link.text, link.button)
  }

  mut onCopyClose() { self.copied = "" }

  // The conversations' last lines and what of them waits unread, for the next session (a /reload among them): those in
  // the list in its order, then those closed, whose lines come back as their person whispers again. Written once, as
  // the player logs out.
  mut keepTalks() {
    const listed = peek self.talks
    const talks: array<KeptTalk> = listed.map(talk => keptOf(talk, false))
    for (key, talk of self.talkMade) {
      if (!listed.any(one => one.key == key)) { talks.push(keptOf(talk, true)) }
    }
    Game::saved.store(Game::Scope::Character, TALKS_KEPT, KeptTalks { talks: talks })
  }

  mut recallTalks() {
    const kept = KeptTalks::decode(Game::saved.stored(Game::Scope::Character, TALKS_KEPT), KeptTalks { talks: [] })
    const talks: array<Talk> = mut []
    for (one of kept.talks) {
      const talk = new Talk(one.key)
      talk.recall(one.lines)
      talk.unread = one.unread
      self.talkMade[one.key] = talk
      if (!one.closed) { talks.push(talk) }
    }
    self.talks = talks
    self.countUnread()
  }

  // Ours closed: the game's closes with it.
  mut onClose() {
    self.open = false
    for (game of self.games) {
      if (game.IsShown()) { Client::HideUIPanel(game) }
    }
  }

  onSettings() { Ordaen.toggleSettings(Runtime::Addon::of(self)) }

  // The card beside the list, of the tab shown: the picked friend's or the player's own; the picked member's, or the
  // guild's or the community's; the picked ally's. The whispers have none: the conversation is their tab's own.
  sideOf(): WindowSide | nil {
    if (self.tab == TAB_FRIENDS) { return self.sub == SUB_STATUS ? self.friendSide() : nil }
    if (self.tab == TAB_GUILD) { return self.guild != nil && self.guildSub == SUB_ROSTER ? self.guildSide() : nil }
    if (self.tab == TAB_COMMUNITIES) { return self.chosenClub != nil ? self.clubSide() : nil }
    if (self.tab == TAB_ALLIES) { return self.pickedAlly != nil ? self.allySide() : nil }
    return nil
  }

  friendSide(): WindowSide {
    return {
      width: Style::CARD,
      content: $ltml {
        <FriendCard $if={self.pickedFriend != nil} friend={self.pickedFriend ?? panic("tested")} @whisper={self.onWhisper}
                    @invite={self.onInvite} @remove={self.onRemove} @menu={self.onCardMenu} />
        <MyCard $else me={self.me} @presence={self.onPresence} @edit={self.onEditBroadcast} @copy={self.onCopyTag} />
      }
    }
  }

  guildSide(): WindowSide {
    return {
      width: Style::SIDE_CARD,
      content: $ltml {
        <MemberCard $if={self.pickedMember != nil} member={self.pickedMember ?? panic("tested")} rights={self.rights}
                    rankTitle={Locale::COLUMN_RANK} @whisper={self.onMemberWhisper} @invite={self.onMemberInvite}
                    @promote={self.onPromote} @demote={self.onDemote} @menu={self.onMemberCardMenu} />
        <GuildCard $else guild={self.guild ?? panic("tested")} @invite={self.onGuildInvite} @leave={self.onLeave}
                   @gameWindow={self.onGameGuild} />
      }
    }
  }

  clubSide(): WindowSide {
    return {
      width: Style::SIDE_CARD,
      content: $ltml {
        <MemberCard $if={self.pickedClubMember != nil} member={self.pickedClubMember ?? panic("tested")} rights={NO_RIGHTS}
                    rankTitle={Locale::COLUMN_ROLE} @whisper={self.onMemberWhisper} @invite={self.onMemberInvite}
                    @menu={self.onMemberCardMenu} />
        <ClubCard $else club={self.chosenClub ?? panic("tested")} streams={self.streams} />
      }
    }
  }

  allySide(): WindowSide {
    return {
      width: Style::SIDE_CARD,
      content: $ltml {
        <AllyCard ally={self.pickedAlly ?? panic("tested")} now={Game::clock.server} @whisper={self.onAllyWhisper}
                  @invite={self.onAllyInvite} @pin={self.onAllyPin} @befriend={self.onAllyBefriend} @note={self.onAllyNote}
                  @menu={self.onAllyCardMenu} />
      }
    }
  }

  public render(): Template {
    return $ltml {
      <frame $for={game of self.held} of={game} opacity={0} away={true} />
      <Window $if={self.open} tabs={self.tabs} selected={mut self.tab} declared={mut self.window} withSettings={true}
              side={self.side} footer={self.footer} @close={self.onClose} @settings={self.onSettings}>
        <box $if={self.tab == TAB_FRIENDS} columns={1} rows={["max-content", { fr: 1 }]} gap={3sp}>
          <box padding={Style::TOP_ROOM}> <Tabs tabs={self.subTabs} selected={mut self.sub} /> </box>
          <FriendList $if={self.sub == SUB_STATUS} friends={self.friends} picked={self.picked}
                      offline={self.settings.values.offline} kept={mut self.friendsList} @pick={self.onPick} @add={self.onAdd}
                      @menu={self.onFriendMenu} />
          <RequestList $elseif={self.sub == SUB_REQUESTS} requests={self.requests} @answer={self.onAnswer} />
          <IgnoreList $else ignored={self.ignored} @ignore={self.onIgnore} @unignore={self.onUnignore} />
        </box>
        <box $elseif={self.tab == TAB_GUILD && self.guild != nil} columns={1} rows={["max-content", { fr: 1 }]} gap={3sp}>
          <box padding={Style::TOP_ROOM}> <Tabs tabs={GUILD_SUBS} selected={mut self.guildSub} /> </box>
          <MemberTable $if={self.guildSub == SUB_ROSTER} members={self.guildMembers} chosen={self.member}
                       @pick={self.onPickMember} @menu={self.onGuildMenu} />
          <NewsList $else news={self.news} filters={self.newsFilters} @filter={self.onNewsFilter} />
        </box>
        <box $elseif={self.tab == TAB_GUILD} xAlign={Align::Center} yAlign={Align::Center}>
          <text value={Locale::NO_GUILD} textColor={Style::DIM} wrap={.None} />
        </box>
        <box $elseif={self.tab == TAB_COMMUNITIES && self.clubs.length > 0} columns={1} rows={["max-content", { fr: 1 }]} gap={3sp}>
          <box padding={Style::TOP_ROOM}> <Tabs tabs={self.clubNames} selected={mut self.clubTab} /> </box>
          <MemberTable members={self.clubMembers} chosen={self.clubMember} guild={false} @pick={self.onPickClubMember}
                       @menu={self.onClubMenu} />
        </box>
        <box $elseif={self.tab == TAB_COMMUNITIES} xAlign={Align::Center} yAlign={Align::Center}>
          <text value={Locale::NO_COMMUNITIES} textColor={Style::DIM} wrap={.None} />
        </box>
        <Whispers $elseif={self.tab == TAB_WHISPERS} talks={self.talks} who={self.talkWho} openKey={self.talkOpen} @picked={self.onTalkPick}
                  @talkPicked={self.onTalkMenu} @start={self.onTalkStart} @send={self.onTalkSend} @link={self.onTalkLink} />
        <AllyList $else allies={self.allies} chosen={self.ally} filter={mut self.allyFilter}
                  categories={peek Game::recentAllies.categories()} @pick={self.onPickAlly} @menu={self.onAllyMenu} />
      </Window>
      <CopyBox $if={self.copied != ""} title={Locale::COPY_TITLE} value={self.copied} @close={self.onCopyClose} />
      <Dialog $if={self.removing != nil} width={Style::ASK} title={Locale::REMOVE_FRIEND}>
        <box columns={1} gap={2sp}>
          <text value={self.removeText} textColor={Style::INK} />
          <text value={self.removeDetail} textColor={Style::DIM} textSize={SECONDARY_TEXT} />
        </box>
        <PushButton #buttons label={Locale::REMOVE} width={Style::ASK_BUTTON} plate={ButtonPlate::Danger} @click={self.onRemoveYes} />
        <PushButton #buttons label={Locale::CANCEL} width={Style::ASK_BUTTON} @click={self.onRemoveNo} />
      </Dialog>
      <Dialog $if={self.adding} width={Style::ASK} title={Locale::ADD_FRIEND}>
        <box columns={1} gap={2sp}>
          <Field value={mut self.addText} maxLength={64} @submit={self.onAddYes} />
          <text value={self.addRule} textColor={Style::DIM} textSize={SECONDARY_TEXT} />
        </box>
        <PushButton #buttons label={Locale::SEND_REQUEST} width={Style::ASK_BUTTON} disabled={trimmed(self.addText) == ""}
                    @click={self.onAddYes} />
        <PushButton #buttons label={Locale::CANCEL} width={Style::ASK_BUTTON} @click={self.onAddNo} />
      </Dialog>
      <Dialog $if={self.editing} width={Style::ASK} title={Locale::BROADCAST}>
        <box columns={1} gap={2sp} xAlign={Align::End}>
          <Field value={mut self.draft} maxLength={BROADCAST_MOST} @submit={self.onBroadcastYes} />
          <text value={self.broadcastCount} textColor={Style::DIM} textSize={SECONDARY_TEXT} wrap={.None} />
        </box>
        <PushButton #buttons label={Locale::UPDATE} width={Style::ASK_BUTTON} @click={self.onBroadcastYes} />
        <PushButton #buttons label={Locale::CANCEL} width={Style::ASK_BUTTON} @click={self.onBroadcastNo} />
      </Dialog>
      <Dialog $if={self.inviting} width={Style::ASK} title={Locale::GUILD_INVITE}>
        <box columns={1} gap={2sp}>
          <Field value={mut self.inviteText} maxLength={NAME_MOST} @submit={self.onGuildInviteYes} />
          <text value={Locale::GUILD_INVITE_RULE} textColor={Style::DIM} textSize={SECONDARY_TEXT} />
        </box>
        <PushButton #buttons label={Locale::INVITE} width={Style::ASK_BUTTON} disabled={trimmed(self.inviteText) == ""}
                    @click={self.onGuildInviteYes} />
        <PushButton #buttons label={Locale::CANCEL} width={Style::ASK_BUTTON} @click={self.onGuildInviteNo} />
      </Dialog>
      <Dialog $if={self.noting} width={Style::ASK} title={Locale::SET_NOTE}>
        <Field value={mut self.noteText} maxLength={NOTE_MOST} @submit={self.onAllyNoteYes} />
        <PushButton #buttons label={Locale::SAVE} width={Style::ASK_BUTTON} @click={self.onAllyNoteYes} />
        <PushButton #buttons label={Locale::CANCEL} width={Style::ASK_BUTTON} @click={self.onAllyNoteNo} />
      </Dialog>
      <Dialog $if={self.leaving} width={Style::ASK} title={Locale::LEAVE_GUILD}>
        <text value={self.leaveText} textColor={Style::INK} />
        <PushButton #buttons label={Locale::LEAVE_GUILD} width={Style::ASK_BUTTON} plate={ButtonPlate::Danger} @click={self.onLeaveYes} />
        <PushButton #buttons label={Locale::CANCEL} width={Style::ASK_BUTTON} @click={self.onLeaveNo} />
      </Dialog>
    }
  }
}
