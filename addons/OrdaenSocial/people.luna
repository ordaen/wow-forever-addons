// Who the social window shows, and what its clicks ask of the game: the player's friends of both kinds (Battle.net
// accounts and characters of this realm), the requests waiting, the black list, the player's own Battle.net self, the
// guild, the communities and the recent allies. `"$game"` has no part for these yet (what it should gain: the module's report), so `People` is the window's
// one door to them: `ClientPeople` reads the client, a test hands its own. Every act is called in the player's click,
// as the client's restricted calls (status, the broadcast, invites, a ready check) want.
import Client from "$client"
import Locale from "@/locales"

// How a friend stands: the client's four.
public enum Presence { Online, Away, Busy, Offline }

// A character in the game: a friend of this realm, or the one a Battle.net friend plays.
public struct Hero {
  const name: String
  const level: Integer
  const className: String
  // The class's colour, as the raid frames give it; none where the client doesn't say the class.
  const classColor: Color | nil
  const area: String
  const realm: String
}

// A Battle.net friend's account.
public struct Account {
  const id: Number
  // The account's name as the client gives it (a token the client shows as the name), and the BattleTag.
  const name: String
  const battleTag: String
  // What it plays: the client's code of the program (`WoW`, `App`, `BSAp`, ...); empty while offline.
  const program: String
  // The friend's broadcast, its «Объявление».
  const broadcast: String
  // A best friend: kept on top of the list.
  const favorite: Boolean
  // When it was last online, in seconds since 1970; 0 while online or where the client doesn't say.
  const lastOnline: Number
  // The World of Warcraft account it plays a character of this game on: 0 for none.
  const gameAccount: Number
}

// One friend of the player's: a character of this realm (`account` none), or a Battle.net friend (`hero` the
// character it plays in this game, while it does).
public struct Friend {
  // Its place in the client's list of its kind.
  const index: Integer
  const presence: Presence
  const note: String
  const hero: Hero | nil
  const account: Account | nil
}

// A friend request waiting for the player's answer.
public struct Request {
  const id: Number
  const name: String
  // When it was sent, in seconds since 1970.
  const sent: Number
}

// One on the black list: a character ignored (by its place in the client's list), or a Battle.net account blocked.
public enum Ignored {
  Character { index: Integer, name: String }
  Account { id: Number, name: String }
}

// The player as their Battle.net friends see them.
public struct Me {
  // The BattleTag; empty while Battle.net is off.
  const battleTag: String
  const presence: Presence
  const broadcast: String
  const hero: Hero
}

// One of a guild or a community: a character (in a community of Battle.net accounts, the account's name and the
// character it plays, where it plays one).
public struct Member {
  // What tells it from the others of its list: the character's GUID, or its name where the client gives none.
  const key: String
  const name: String
  const level: Integer
  const className: String
  const classColor: Color | nil
  const zone: String
  const presence: Presence
  // Its guild rank or its role in the community, as the client names it, and the rank's order (1 the highest).
  const rank: String
  const rankOrder: Integer
  const note: String
  // The guild's officer note: empty where the player may not read it.
  const officerNote: String
  // How long ago it was last online, in hours; 0 while online or where the client doesn't say.
  const away: Integer
}

// What the player may do in the guild, as the client says.
public struct Rights {
  const invite: Boolean
  const promote: Boolean
  const demote: Boolean
  // The guild's management the client keeps to its own window: the ranks (the leader's), removing a member, editing
  // the notes.
  const manage: Boolean
}

// The player's guild: its words to its members and its roster.
public struct Guild {
  const name: String
  // The message of the day and the guild's information, as its officers wrote them.
  const motd: String
  const info: String
  const members: Array<Member>
  const rights: Rights
}

// A line of the guild's news: who did what, and the day.
public struct News {
  const who: String
  const what: String
  // The day of the month and the month, from 1; a sticky line (kept on top by an officer) first.
  const day: Integer
  const month: Integer
  const sticky: Boolean
}

// A community the player is in: of Battle.net accounts, or of characters of this game.
public struct Club {
  const id: String
  const name: String
  const description: String
  const broadcast: String
  const battleNet: Boolean
  const memberCount: Integer
}

// One of a community's streams (its channels of chat), and what it is for.
public struct Stream {
  const id: String
  const name: String
  const subject: String
}

// Something the player did with a recent ally: the server's own words of it, and when.
public struct Meeting {
  const text: String
  // When it was, in seconds since 1970.
  const when: Number
}

// The game's categories of what was done with a recent ally (`RecentAlliesInteractionCategoryFilter`): the recent
// allies' filter, the game telling which ally falls in which (`C_RecentAllies.SearchRecentAllies`).
public enum AllyCategory { Professions, PvP, Raiding, Dungeons, Delves, Questing }

public const ALLY_CATEGORIES: Array<AllyCategory> = [.Professions, .PvP, .Raiding, .Dungeons, .Delves, .Questing]

function clientCategoryOf(category: AllyCategory): Client.RecentAlliesInteractionCategoryFilter {
  return match (category) {
    .Professions => .Professions
    .PvP => .PvP
    .Raiding => .Raiding
    .Dungeons => .Dungeons
    .Delves => .Delves
    .Questing => .Questing
  }
}

// One the player played with lately, as the game keeps them (`C_RecentAllies`): the character, what the player did
// with them (the newest first), and whether the player pinned them (kept on top, and kept longer).
public struct Ally {
  const member: Member
  // The character's name with its realm: what a whisper and an invite take.
  const fullName: String
  const meetings: Array<Meeting>
  const pinned: Boolean
}

// The client's door to the window's people; each list read as the window opens and when the client says it changed.
public trait People {
  public friends(self): Array<Friend>
  public requests(self): Array<Request>
  public ignored(self): Array<Ignored>
  public me(self): Me
  // The player's guild; none outside one.
  public guild(self): Guild | nil
  public news(self): Array<News>
  // The player's communities (the guild isn't one of them), each club's members and streams.
  public clubs(self): Array<Club>
  public clubMembers(self, club: String): Array<Member>
  public streams(self, club: String): Array<Stream>
  // The recent allies: all of them (nil), or those of these categories alone.
  public allies(self, categories: Array<AllyCategory> | nil): Array<Ally>
  // The categories the game sorts recent allies into here.
  public allyCategories(self): Array<AllyCategory>
  public whisper(mut self, friend: Friend)
  public invite(mut self, friend: Friend)
  public remove(mut self, friend: Friend)
  public answer(mut self, request: Request, accept: Boolean)
  public ignore(mut self, name: String)
  public unignore(mut self, entry: Ignored)
  // A BattleTag or an email makes a Battle.net friend, a character's name a friend of this realm.
  public addFriend(mut self, text: String)
  public setPresence(mut self, presence: Presence)
  public setBroadcast(mut self, text: String)
  public copy(mut self, text: String)
  // A character by its name (with its realm where it is of another): the chat's whisper opened to it, an invite to
  // the group.
  public whisperTo(mut self, name: String)
  public inviteTo(mut self, name: String)
  // The guild's own acts the client lets an addon ask, in the player's click.
  public guildInvite(mut self, name: String)
  public promote(mut self, name: String)
  public demote(mut self, name: String)
  public leaveGuild(mut self)
  // A recent ally pinned or unpinned, by the character's GUID.
  public pin(mut self, key: String, pinned: Boolean)
  // The game asked for what it sends late, as the window opens: the guild's roster, the recent allies (where it
  // hasn't them yet). Their events say when they come.
  public ask(mut self)
}

// Whether a text the player typed names a Battle.net account (a BattleTag or an email), as the add-friend window reads
// it; anything else is a character's name.
public function namesAccount(text: String): Boolean { return text.contains("#") || text.contains("@") }

// A text as the player meant it: without the spaces before and after.
public function trimmed(text: String): String { return text.match("^%s*(.-)%s*$") ?? "" }

// A class's colour by the client's tag of it (`WARRIOR`).
function classColorOf(tag: String | nil): Color | nil {
  if (tag == nil) { return nil }
  const rgb = Client.RAID_CLASS_COLORS[tag]
  if (rgb == nil) { return nil }
  return { r: rgb.r, g: rgb.g, b: rgb.b, a: 1 }
}

function presenceOf(online: Boolean, away: Boolean, busy: Boolean): Presence {
  if (!online) { return .Offline }
  if (busy) { return .Busy }
  if (away) { return .Away }
  return .Online
}

// How a member of a club stands: the client's six, as the four of a friend.
function clubPresenceOf(presence: Client.ClubMemberPresence): Presence {
  return match (presence) {
    .Online, .OnlineMobile => .Online
    .Away => .Away
    .Busy => .Busy
    else => .Offline
  }
}

// A community's role: its name and its order, the owner first.
function roleName(role: Client.ClubRoleIdentifier | nil): String {
  return match (role) {
    .Owner => Locale.ROLE_OWNER
    .Leader => Locale.ROLE_LEADER
    .Moderator => Locale.ROLE_MODERATOR
    else => Locale.ROLE_MEMBER
  }
}

function roleOrder(role: Client.ClubRoleIdentifier | nil): Integer {
  return match (role) {
    .Owner => 1
    .Leader => 2
    .Moderator => 3
    else => 4
  }
}

// How many hours ago a member was last online, from the client's years, months, days and hours ago (a month counted
// as thirty days).
function awayOf(info: Client.ClubMemberInfo): Integer {
  const months = (info.lastOnlineYear ?? 0) * 12 + (info.lastOnlineMonth ?? 0)
  return ((months * 30 + (info.lastOnlineDay ?? 0)) * 24 + (info.lastOnlineHour ?? 0)).floor()
}

// A member as the client gives it in a club: the guild's rank where it is the guild's, else its role.
function memberOf(info: Client.ClubMemberInfo, officerNotes: Boolean): Member {
  let className = ""
  let classColor: Color | nil = nil
  const classID = info.classID
  const classInfo = classID != nil ? Client.C_CreatureInfo.GetClassInfo(classID) : nil
  if (classInfo != nil) {
    className = classInfo.className
    classColor = classColorOf(classInfo.classFile)
  }
  const presence = clubPresenceOf(info.presence)
  return {
    key: info.guid ?? info.name ?? "", name: info.name ?? "", level: (info.level ?? 0).floor(), className: className,
    classColor: classColor, zone: info.zone ?? "", presence: presence,
    rank: info.guildRank ?? roleName(info.role), rankOrder: info.guildRankOrder ?? roleOrder(info.role),
    note: info.memberNote ?? "", officerNote: officerNotes ? info.officerNote ?? "" : "",
    away: presence == .Offline ? awayOf(info) : 0
  }
}

// A club's members as the client lists them.
function membersOf(club: String, officerNotes: Boolean): Array<Member> {
  const list: Array<Member> = []
  for (id of Client.C_Club.GetClubMembers(club, nil)) {
    const info = Client.C_Club.GetMemberInfo(club, id)
    if (info != nil) { list.push(memberOf(info, officerNotes)) }
  }
  return list
}

// A recent ally as the client keeps it.
function allyOf(data: Client.RecentAllyData): Ally {
  const state = data.stateData
  const character = data.characterData
  const classInfo = Client.C_CreatureInfo.GetClassInfo(character.classID)
  const meetings: Array<Meeting> = data.interactionData.interactions.map(seen => Meeting { text: seen.description, when: seen.timestamp })
  return {
    member: {
      key: character.guid, name: character.name, level: character.level.floor(), className: classInfo?.className ?? "",
      classColor: classColorOf(classInfo?.classFile), zone: state.currentLocation ?? "",
      presence: presenceOf(state.isOnline, state.isAFK, state.isDND), rank: "", rankOrder: 0,
      note: data.interactionData.note ?? "", officerNote: "", away: 0
    },
    fullName: character.fullName,
    meetings: meetings,
    pinned: Client.C_RecentAllies.IsRecentAllyPinned(character.guid)
  }
}

public class ClientPeople implements People {
  public friends(self): Array<Friend> {
    const list: Array<Friend> = []
    let accounts, _ = Client.BNGetNumFriends()
    for (index of 1..accounts.floor()) {
      const friend = ClientPeople.account(index)
      if (friend != nil) { list.push(friend) }
    }
    for (index of 1..Client.C_FriendList.GetNumFriends()) {
      const info = Client.C_FriendList.GetFriendInfoByIndex(index)
      if (info == nil) { continue }
      let _, tag, _, _, _, _, realm, _ = Client.GetPlayerInfoByGUID(info.guid)
      list.push({
        index: index,
        presence: presenceOf(info.connected, info.afk, info.dnd),
        note: info.notes ?? "",
        hero: {
          name: info.name, level: info.level.floor(), className: info.className ?? "", classColor: classColorOf(tag),
          area: info.area ?? "", realm: realm ?? ""
        },
        account: nil
      })
    }
    return list
  }

  // A Battle.net friend by their place in the client's list.
  account(index: Integer): Friend | nil {
    const info = Client.C_BattleNet.GetFriendAccountInfo(index, nil)
    if (info == nil) { return nil }
    const game = info.gameAccountInfo
    const playsHere = game.isOnline && game.clientProgram == "WoW" && game.characterName != nil && game.playerGuid != nil
    let hero: Hero | nil = nil
    if (playsHere) {
      hero = {
        name: game.characterName ?? "", level: (game.characterLevel ?? 0).floor(), className: game.className ?? "",
        classColor: classColorOf(game.classFilename), area: game.areaName ?? "",
        realm: game.realmDisplayName ?? game.realmName ?? ""
      }
    }
    return {
      index: index,
      presence: presenceOf(game.isOnline, info.isAFK || game.isGameAFK, info.isDND || game.isGameBusy),
      note: info.note,
      hero: hero,
      account: {
        id: info.bnetAccountID, name: info.accountName, battleTag: info.battleTag,
        program: game.isOnline ? game.clientProgram : "", broadcast: info.customMessage, favorite: info.isFavorite,
        lastOnline: game.isOnline ? 0 : info.lastOnlineTime, gameAccount: playsHere ? game.gameAccountID : 0
      }
    }
  }

  public requests(self): Array<Request> {
    const list: Array<Request> = []
    for (index of 1..Client.BNGetNumFriendInvites().floor()) {
      const info = Client.C_BattleNet.GetFriendInviteInfo(index)
      if (info == nil) { continue }
      const name = info.accountName
      list.push({ id: info.inviteID, name: name is String ? name : "", sent: info.creationTimestamp })
    }
    return list
  }

  public ignored(self): Array<Ignored> {
    const list: Array<Ignored> = []
    for (index of 1..Client.C_FriendList.GetNumIgnores()) {
      const name = Client.C_FriendList.GetIgnoreName(index)
      if (name != nil) { list.push(Ignored.Character { index: index, name: name }) }
    }
    for (index of 1..Client.BNGetNumBlocked().floor()) {
      let id, name = Client.BNGetBlockedInfo(index)
      list.push(Ignored.Account { id: id, name: name })
    }
    return list
  }

  public me(self): Me {
    let name, _ = Client.UnitName("player")
    let className, tag, _ = Client.UnitClass("player")
    const hero: Hero = {
      name: name, level: Client.UnitLevel("player").floor(), className: className ?? "", classColor: classColorOf(tag),
      area: Client.GetZoneText(), realm: Client.GetRealmName()
    }
    const guid = Client.UnitGUID("player")
    const info = guid == nil ? nil : Client.C_BattleNet.GetAccountInfoByGUID(guid)
    if (info == nil) { return { battleTag: "", presence: .Online, broadcast: "", hero: hero } }
    const presence: Presence = info.appearOffline ? .Offline : presenceOf(true, info.isAFK, info.isDND)
    return { battleTag: info.battleTag, presence: presence, broadcast: info.customMessage, hero: hero }
  }

  // The guild is a club of the client's: its roster read as the guild window's (the rank, the notes, when last
  // online), the message of the day and the information as its own page reads them.
  public guild(self): Guild | nil {
    if (!Client.IsInGuild()) { return nil }
    const club = Client.C_Club.GetGuildClubId()
    if (club == nil) { return nil }
    let name, _, _ = Client.GetGuildInfo("player")
    return {
      name: name ?? Client.C_Club.GetClubInfo(club)?.name ?? "",
      motd: Client.C_GuildInfo.GetMOTD(),
      info: Client.C_GuildInfo.GetInfoText(),
      members: membersOf(club, Client.C_GuildInfo.CanViewOfficerNote()),
      rights: {
        invite: Client.CanGuildInvite(),
        promote: Client.CanGuildPromote(),
        demote: Client.CanGuildDemote(),
        manage: Client.IsGuildLeader() || Client.CanGuildRemove() || Client.CanEditPublicNote() ||
          Client.C_GuildInfo.CanEditOfficerNote()
      }
    }
  }

  public news(self): Array<News> {
    const list: Array<News> = []
    for (index of 1..Client.GetNumGuildNews().floor()) {
      const info = Client.C_GuildInfo.GetGuildNewsInfo(index)
      if (info == nil || info.isHeader) { continue }
      list.push({
        who: info.whoText ?? "", what: info.whatText ?? "", day: info.day.floor() + 1, month: info.month.floor() + 1,
        sticky: info.isSticky
      })
    }
    return list
  }

  public clubs(self): Array<Club> {
    const list: Array<Club> = []
    for (info of Client.C_Club.GetSubscribedClubs()) {
      if (info.clubType == .Guild || info.clubType == .Other) { continue }
      list.push({
        id: info.clubId, name: info.name, description: info.description, broadcast: info.broadcast,
        battleNet: info.clubType == .BattleNet, memberCount: (info.memberCount ?? 0).floor()
      })
    }
    return list
  }

  public clubMembers(self, club: String): Array<Member> { return membersOf(club, false) }

  public streams(self, club: String): Array<Stream> {
    return Client.C_Club.GetStreams(club).map(info => Stream { id: info.streamId, name: info.name, subject: info.subject })
  }

  public allies(self, categories: Array<AllyCategory> | nil): Array<Ally> {
    if (!Client.C_RecentAllies.IsSystemEnabled() || !Client.C_RecentAllies.IsRecentAllyDataReady()) { return [] }
    if (categories == nil) { return Client.C_RecentAllies.GetRecentAllies().map(data => allyOf(data)) }
    if (categories.length == 0) { return [] }
    const search: Client.RecentAlliesSearchInfo = {
      searchText: "", isOnline: true, isDND: true, isAFK: true, isOffline: true,
      interactionCategoryFilters: categories.map(category => clientCategoryOf(category))
    }
    return Client.C_RecentAllies.SearchRecentAllies(search).map(data => allyOf(data))
  }

  public allyCategories(self): Array<AllyCategory> {
    return ALLY_CATEGORIES.filter(category => Client.C_RecentAllies.IsInteractionCategoryFilterSupportedForCurrentGameType(clientCategoryOf(category)))
  }

  // The chat's line opened to them, as the game's «Шепнуть» opens it: a character by name, a Battle.net friend by
  // the account's token, which the client's whisper takes.
  public whisper(mut self, friend: Friend) {
    const to = friend.account?.name ?? friend.hero?.name
    if (to != nil) { Client.ChatFrameUtil.OpenChat(`/w ${to} `) }
  }

  // A character asked to the group; a Battle.net friend's character through Battle.net, as the game's list does.
  public invite(mut self, friend: Friend) {
    const account = friend.account
    if (account != nil) {
      if (account.gameAccount != 0) { Client.C_BattleNet.InviteFriend(account.gameAccount) }
      return
    }
    const hero = friend.hero
    if (hero != nil) { Client.C_PartyInfo.InviteUnit(hero.name) }
  }

  public remove(mut self, friend: Friend) {
    const account = friend.account
    if (account != nil) {
      Client.BNRemoveFriend(account.id)
      return
    }
    Client.C_FriendList.RemoveFriendByIndex(friend.index)
  }

  public answer(mut self, request: Request, accept: Boolean) {
    if (accept) {
      Client.BNAcceptFriendInvite(request.id)
    } else {
      Client.BNDeclineFriendInvite(request.id)
    }
  }

  public ignore(mut self, name: String) { _ = Client.C_FriendList.AddIgnore(name) }

  public unignore(mut self, entry: Ignored) {
    match (entry) {
      .Character => Client.C_FriendList.DelIgnoreByIndex(entry.index)
      .Account => Client.C_BattleNet.SetBlocked(entry.id, false)
    }
  }

  public addFriend(mut self, text: String) {
    if (namesAccount(text)) {
      Client.BNSendFriendInvite(text, "")
    } else {
      Client.C_FriendList.AddFriend(text, nil)
    }
  }

  // The game's four: away and busy are flags of their own, invisible is appearing offline.
  public setPresence(mut self, presence: Presence) {
    Client.C_BattleNet.SetAppearOffline(presence == .Offline)
    Client.C_BattleNet.SetAFK(presence == .Away)
    Client.C_BattleNet.SetDND(presence == .Busy)
  }

  public setBroadcast(mut self, text: String) { _ = Client.C_BattleNet.SetCustomMessage(text) }

  public copy(mut self, text: String) { _ = Client.CopyToClipboard(text, nil) }

  public whisperTo(mut self, name: String) { Client.ChatFrameUtil.OpenChat(`/w ${name} `) }
  public inviteTo(mut self, name: String) { Client.C_PartyInfo.InviteUnit(name) }
  public guildInvite(mut self, name: String) { Client.C_GuildInfo.Invite(name) }
  public promote(mut self, name: String) { Client.C_GuildInfo.Promote(name) }
  public demote(mut self, name: String) { Client.C_GuildInfo.Demote(name) }
  public leaveGuild(mut self) { Client.C_GuildInfo.Leave() }
  public pin(mut self, key: String, pinned: Boolean) { Client.C_RecentAllies.SetRecentAllyPinned(key, pinned) }

  public ask(mut self) {
    if (Client.IsInGuild()) { Client.C_GuildInfo.GuildRoster() }
    if (Client.C_RecentAllies.IsSystemEnabled() && !Client.C_RecentAllies.IsRecentAllyDataReady()) {
      Client.C_RecentAllies.TryRequestRecentAlliesData()
    }
  }
}
