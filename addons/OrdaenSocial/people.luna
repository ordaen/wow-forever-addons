// What the social window's clicks ask of the game besides its parts (`"$game"`'s friends, guild, communities and
// recent allies): an invite to the group, the clipboard. `ClientPeople` asks the client, a test hands its own. Every
// act is called in the player's click, as the client's restricted calls want. A whisper is the window's own (its
// whispers' tab).
import Client from "$client"

public trait People {
  public mut copy(text: string)
  // A character by its name (with its realm where it is of another) invited to the group.
  public mut inviteTo(name: string)
}

// Whether a text the player typed names a Battle.net account (a BattleTag or an email), as the add-friend window reads
// it; anything else is a character's name.
public function namesAccount(text: string): boolean { return text.contains("#") || text.contains("@") }

public class ClientPeople implements People {
  public mut copy(text: string) { _ = Client::CopyToClipboard(text, nil) }
  public mut inviteTo(name: string) { Client::C_PartyInfo::InviteUnit(name) }
}
