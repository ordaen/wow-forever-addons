// The whispers' tab: a sidebar of the conversations, newest first with their unread count, a name typed at its top
// starting one, a conversation's «×» closing it (its history with it); beside it, in a well, the open one, drawn as
// WhisperMessenger draws it: each line a bubble, the other's on the left and the player's on the right, at most three
// quarters of the width; lines of one side close in time stand together, the group's time under its last. Under it, its
// own line to type in.
import Game from "$game"
import { Hero } from "$game"
import { Align, Edges, Event, Overflow, Position, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { BODY_LINE, Component, CountBadge, Field, SECONDARY_TEXT, classColor, timeText } from "Ordaen"
import Locale from "@/locales"
import { Talk, TalkLine, TalkWho } from "@/talks"

// Lines drawn at most, and a turn of the wheel.
const ROWS = 80
const STEP = 3
const MAX: "max-content" = "max-content"
// The conversations a sidebar at the left, the open one the rest.
const SIDEBAR_AND_TALK: Array<Track> = [240dp, { fr: 1 }]
// Between the well's rim and the bubbles: the least room a text keeps from a frame's line.
const WELL_ROOM: Number<Spacing> = 3sp
// The bubbles' floors (WhisperMessenger's warm look, on the wood): what is heard dark brown, what the player told
// copper; their words light on both.
public const HEARD_FILL: Color = Color.hex("#3d2e24e6")
public const TOLD_FILL: Color = Color.hex("#8c4d2ed6")
const INK: Color = Color.hex("#e8dcc4")
const BUBBLE_PAD: Edges = { top: 2sp, right: 3sp, bottom: 2sp, left: 3sp }
// Room above a bubble: little inside a group, more where a group starts.
const IN_GROUP: Edges = { top: 1sp }
const NEW_GROUP: Edges = { top: 3sp }
// Lines of one side this close (seconds) stand in one group.
const GROUP_SECONDS = 120
// A bubble's width against the rest of its row: three quarters.
const HEARD_COLUMNS: Array<Track> = [{ fr: 3 }, { fr: 1 }]
const TOLD_COLUMNS: Array<Track> = [{ fr: 1 }, { fr: 3 }]
const WHISPER: Color = Color.hex("#ff80ff")
const BATTLE_NET: Color = Color.hex("#00fff6")
const PICKED: Color = Color.hex("#2a1c10e6")
const HINT: Color = Color.hex("#857a66")
const ROW_PAD: Edges = { top: 1sp, right: 2sp, bottom: 1sp, left: 2sp }
const CLOSE_PAD: Edges = { right: 1sp, left: 1sp }
// A name cut where it is long, its level at the line's end.
const NAME_AND_LEVEL: Array<Track> = [{ fr: 1 }, MAX]
// The count's room at a conversation's right, kept while none waits: nothing moves as it comes or goes.
const COUNT_ROOM: Number<Length> = 28dp

// A line as a bubble: whether it starts its group (room above it) and ends it (its time under it).
public struct Bubbled {
  line: TalkLine
  starts: Boolean
  ends: Boolean
}

// A level after a name (`25lvl`); none where it isn't known.
function levelText(level: Integer): String { return level > 0 ? Locale.ROW_LEVEL.format(level) : "" }

// A conversation's partner as its name alone says it.
function unknownWho(talk: Talk): TalkWho { return { name: talk.partner, classFile: "", level: 0, hero: nil } }

// Two lines in one group: of one side, the second said soon after the first.
function together(first: TalkLine | nil, second: TalkLine | nil): Boolean {
  return first != nil && second != nil && first.mine == second.mine && second.time - first.time <= GROUP_SECONDS
}

// The lines as bubbles, each told where its group starts and ends.
function bubblesOf(lines: Array<TalkLine>): Array<Bubbled> {
  const bubbles: Array<Bubbled> = []
  for (index, line of lines) {
    bubbles.push({ line: line, starts: !together(lines[index - 1], line), ends: !together(line, lines[index + 1]) })
  }
  return bubbles
}

// A line of a conversation: its words on a bubble at its side, its group's time under the group's last. A secret line
// stands one line high, so nothing of it is measured.
public class Bubble implements Component {
  public link: Event<Event.Link> = new Event()

  derived mine: Boolean = self.item.line.mine
  derived columns: Array<Track> = self.mine ? TOLD_COLUMNS : HEARD_COLUMNS
  derived side: Align = self.mine ? Align.End : Align.Start
  derived fill: Color = self.mine ? TOLD_FILL : HEARD_FILL
  derived above: Edges = self.item.starts ? NEW_GROUP : IN_GROUP
  derived time: String = timeText(Game.clock.timeAt(self.item.line.time.floor()))

  item: Signal<Bubbled>
  lineHeight: Signal<Number<Length>>
  constructor(item: Signal<Bubbled>, lineHeight: Signal<Number<Length>>) {
    self.item = item
    self.lineHeight = lineHeight
  }

  onLink(mut self, link: Event.Link) { self.link.emit(link) }

  public render(self): Template {
    return $ltml {
      <box columns={self.columns} padding={self.above}>
        // The player's own stands in the second column: the first is the room on its left.
        <box $if={self.mine} />
        <box columns={1} gap={0.5sp}>
          <box xAlignSelf={self.side} padding={BUBBLE_PAD} background={self.fill} @linkPress={self.onLink}>
            <box $if={self.item.line.secret} height={self.lineHeight} overflow={Overflow.Hidden}>
              <text value={self.item.line.whole} secret={true} textColor={INK} wrap={.None} />
            </box>
            <text $else value={self.item.line.whole} textColor={INK} />
          </box>
          <text $if={self.item.ends} value={self.time} xAlignSelf={self.side} textColor={HINT} textFont={.Numbers}
                textSize={SECONDARY_TEXT} wrap={.None} />
        </box>
      </box>
    }
  }
}

// A conversation in the list, as the friends' list names a friend: a character's name in its class's colour (the
// whisper colour where the class isn't known) and its level after it; a Battle.net friend's account name in Battle.net
// blue, the character it plays under it the same way. The lines waiting unread are a badge out of the flow in a room
// kept for it; then «×».
public class TalkRow implements Component {
  public pick: Event<Talk> = new Event()
  public forget: Event<Talk> = new Event()

  derived color: Color = self.talk.battleNet ? BATTLE_NET : classColor(self.who.classFile) ?? WHISPER
  derived level: String = levelText(self.who.level)
  derived hero: Hero | nil = self.who.hero
  derived heroColor: Color = classColor(self.hero?.classFile) ?? INK
  derived heroLevel: String = levelText(self.hero?.level ?? 0)
  derived fill: Color | nil = self.open ? PICKED : nil
  derived waiting: Boolean = self.talk.unread > 0

  talk: Signal<Talk>
  who: Signal<TalkWho>
  open: Signal<Boolean>
  constructor(talk: Signal<Talk>, who: Signal<TalkWho>, open: Signal<Boolean>) {
    self.talk = talk
    self.who = who
    self.open = open
  }

  onPick(mut self) { self.pick.emit(peek self.talk) }

  onForget(mut self) { self.forget.emit(peek self.talk) }

  public render(self): Template {
    return $ltml {
      <box columns={[{ fr: 1 }, COUNT_ROOM, MAX]} gap={1sp} padding={ROW_PAD} background={self.fill} yAlign={Align.Center}
           @pointerPress={self.onPick} @keyPress(.Enter)={self.onPick} @keyPress(.Space)={self.onPick}>
        <box columns={1}>
          <box columns={NAME_AND_LEVEL} gap={2sp} yAlign={Align.Center}>
            <text value={self.who.name} textColor={self.color} wrap={.Cut} />
            <text $if={self.level != ""} value={self.level} textColor={HINT} textFont={.Numbers} wrap={.None} />
          </box>
          <box $if={self.hero != nil} columns={NAME_AND_LEVEL} gap={2sp} yAlign={Align.Center}>
            <text value={self.hero?.name ?? ""} textColor={self.heroColor} textSize={SECONDARY_TEXT} wrap={.Cut} />
            <text $if={self.heroLevel != ""} value={self.heroLevel} textColor={HINT} textFont={.Numbers} textSize={SECONDARY_TEXT}
                  wrap={.None} />
          </box>
        </box>
        <box yAlign={Align.Center}>
          <box $if={self.waiting} position={Position.Absolute} top={0ui} right={0ui} bottom={0ui} yAlign={Align.Center}>
            <CountBadge count={self.talk.unread} />
          </box>
        </box>
        <box padding={CLOSE_PAD} @pointerPress.self={self.onForget}>
          <text value={"×"} textColor={HINT} wrap={.None} />
        </box>
      </box>
    }
  }
}

public class Whispers implements Component {
  public picked: Event<Talk> = new Event()
  public forget: Event<Talk> = new Event()
  // A name typed to whisper to.
  public start: Event<String> = new Event()
  // The words typed in the open conversation, Enter pressed: in the key's own call, where the client sends them.
  public send: Event<String> = new Event()
  public link: Event<Event.Link> = new Event()

  state name = ""
  state draft = ""
  // Lines scrolled back from the newest.
  state back = 0
  // What was typed in each conversation and not sent, kept while another is open.
  drafts: mut Map<String, String> = {}
  derived open: Talk | nil = self.talks.find(talk => talk.key == self.openKey)
  derived shown: Array<TalkLine> = self.shownOf()
  derived bubbles: Array<Bubbled> = bubblesOf(self.shown)
  derived empty: Boolean = self.open == nil

  talks: Signal<Array<Talk>>
  who: Signal<Map<String, TalkWho>>
  openKey: Signal<String>
  constructor(
    talks: Signal<Array<Talk>>,
    // Who each conversation is with, by its key.
    who: Signal<Map<String, TalkWho>>,
    openKey: Signal<String>
  ) {
    self.talks = talks
    self.who = who
    self.openKey = openKey
    watch (key of self.openKey) { self.turnTo(key) }
  }

  // Another conversation opened: what was typed in the last is kept, this one's brought back.
  turnTo(mut self, key: String) {
    self.back = 0
    self.draft = self.drafts[key] ?? ""
  }

  shownOf(self): Array<TalkLine> {
    const talk = self.open
    // The lines change in place: their version is what tells the view.
    if (talk == nil || talk.version < 0) { return [] }
    return talk.slice(self.back, ROWS)
  }

  onPick(mut self, talk: Talk) {
    self.drafts[peek self.openKey] = peek self.draft
    self.picked.emit(talk)
  }

  onForget(mut self, talk: Talk) {
    self.drafts[talk.key] = nil
    self.forget.emit(talk)
  }

  onStart(mut self) {
    const name = (peek self.name).replace("^%s+", "").replace("%s+$", "")
    self.name = ""
    if (name != "") { self.start.emit(name) }
  }

  onSend(mut self) {
    const text = peek self.draft
    if (text == "" || peek self.empty) { return }
    self.draft = ""
    self.drafts[peek self.openKey] = nil
    self.back = 0
    self.send.emit(text)
  }

  onLink(mut self, link: Event.Link) { self.link.emit(link) }

  // The wheel scrolls three lines; with Shift, to the oldest or the newest.
  onWheel(mut self, wheel: Event.Wheel) {
    const talk = peek self.open
    if (talk == nil) { return }
    const most = (0).max(talk.lines.length - 1)
    const shift = Game.input.shiftDown()
    if (wheel.direction == .Up) {
      self.back = shift ? most : most.min((peek self.back) + STEP)
    } else {
      self.back = shift ? 0 : (0).max((peek self.back) - STEP)
    }
  }

  public render(self): Template {
    return $ltml {
      <box columns={SIDEBAR_AND_TALK} rows={[{ fr: 1 }]} gap={3sp}>
        <box rows={[MAX, { fr: 1 }]} gap={2sp}>
          <Field value={mut self.name} maxLength={60} placeholder={Locale.WHISPER_TO} @submit={self.onStart} />
          <box columns={1} overflow={Overflow.Scroll}>
            <TalkRow $for={talk of self.talks} $key={talk.key} talk={talk} who={self.who[talk.key] ?? unknownWho(talk)}
                     open={talk.key == self.openKey}
                     @pick={self.onPick} @forget={self.onForget} />
          </box>
        </box>
        <box rows={[{ fr: 1 }, MAX]} gap={2sp}>
          // The conversation sunk in a well, as the chat's lines stand in their frame: its rim the line between it and
          // the list, its floor its own. The newest line at the bottom; older ones go up past the top, which cuts them.
          <box border={Ordaen.art.ctl.well.rim} background={Ordaen.art.ctl.well.floor} padding={WELL_ROOM} rows={[{ fr: 1 }]}>
            <box overflow={Overflow.Hidden} @wheel={self.onWheel}>
              <box position={Position.Absolute} left={0ui} right={0ui} bottom={0ui} columns={1}>
                <Bubble $for={item of self.bubbles} item={item} lineHeight={Ordaen.lengthOf(BODY_LINE)} @link={self.onLink} />
              </box>
              <box $if={self.empty} xAlign={Align.Center} yAlign={Align.Center}>
                <text value={Locale.WHISPER_NONE} textColor={HINT} wrap={.None} />
              </box>
            </box>
          </box>
          <Field value={mut self.draft} maxLength={255} placeholder={Locale.WHISPER_TYPE} disabled={self.empty}
                 @submit={self.onSend} />
        </box>
      </box>
    }
  }
}
