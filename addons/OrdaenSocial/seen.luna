// The character each Battle.net friend was last seen playing here, so an offline friend's row and card still say who
// and what level: the client tells nothing of an offline account's characters. Kept in the account's saved variables
// (every character of the account sees the same friends), by BattleTag (the account's number changes each session),
// at most `SEEN_MOST` of them; one not seen for `SEEN_DAYS` days, or no longer a friend, goes.
import { Friend, Hero } from "$game"
import { ModuleMemory } from "Ordaen"

const SEEN_MOST = 200
const SEEN_DAYS = 180
const DAY = 86400

// A character a friend was seen on, and when (seconds since 1970).
public struct SeenHero implements Plain {
  name: string = ""
  level: integer = 0
  className: string = ""
  classFile: string = ""
  realm: string = ""
  at: number = 0
}

public struct SeenHeroes implements Plain {
  heroes: map<string, SeenHero> = {}
}
public const SEEN_HEROES: SeenHeroes = {}

function seenOf(hero: Hero, now: number): SeenHero {
  return { name: hero.name, level: hero.level, className: hero.className, classFile: hero.classFile, realm: hero.realm, at: now }
}

function same(a: SeenHero, b: SeenHero): boolean {
  return a.name == b.name && a.level == b.level && a.realm == b.realm && a.classFile == b.classFile
}

// What is kept after the friends were read at `now`: those playing here written down, those no longer friends and those
// not seen for long gone, the oldest gone past the cap. Nil where nothing changed (nothing to write). A list with no
// account (Battle.net off) drops nobody.
public function seenAfter(kept: map<string, SeenHero>, friends: array<Friend>, now: number): map<string, SeenHero> | nil {
  const next: map<string, SeenHero> = {}
  let changed = false
  const accounts = friends.filter(friend => friend.account != nil)
  const tags: map<string, boolean> = {}
  for (friend of accounts) {
    const tag = friend.account?.battleTag ?? ""
    tags[tag] = true
    const hero = friend.hero
    const before = kept[tag]
    if (hero != nil && (before == nil || !same(before, seenOf(hero, now)))) {
      next[tag] = seenOf(hero, now)
      changed = true
    } else if (before != nil) {
      next[tag] = before
    }
  }
  for (tag, seen of kept) {
    if (next[tag] != nil) { continue }
    if (accounts.length == 0) { next[tag] = seen } else { changed = true }
  }
  for (tag, seen of next) {
    if (now - seen.at > SEEN_DAYS * DAY) {
      next[tag] = nil
      changed = true
    }
  }
  const tagsKept: array<string> = []
  for (tag, _ of next) { tagsKept.push(tag) }
  if (tagsKept.length > SEEN_MOST) {
    tagsKept.sort((a: string, b: string) => (next[a]?.at ?? 0) > (next[b]?.at ?? 0))
    for (at of SEEN_MOST + 1..tagsKept.length) { next[tagsKept[at] ?? ""] = nil }
    changed = true
  }
  return changed ? next : nil
}

// The friends as the window shows them: an offline Battle.net friend with the character last seen, where one was.
public function withSeen(friends: array<Friend>, kept: map<string, SeenHero>): array<Friend> {
  return friends.map(friend => {
    const account = friend.account
    if (account == nil || friend.hero != nil) { return friend }
    const seen = kept[account.battleTag]
    if (seen == nil) { return friend }
    const hero: Hero = { name: seen.name, level: seen.level, className: seen.className, classFile: seen.classFile, area: "", realm: seen.realm }
    return Friend { index: friend.index, presence: friend.presence, note: friend.note, hero: hero, account: account }
  })
}

// The friends just read, written down in the saved list where anything changed.
public function noteSeen(memory: mut ModuleMemory<SeenHeroes>, friends: array<Friend>, now: number) {
  const next = seenAfter((peek memory.values).heroes, friends, now)
  if (next != nil) { memory.write({ heroes: next }) }
}
