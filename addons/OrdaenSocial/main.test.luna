// The social window as the player meets it: the game's friends window shown (O, its micro button, the panel's cell)
// shows ours in its place, and closing ours closes the game's; the game's guild window (J) shows ours on the guild; the
// friends' list holds both kinds, best friends on top; a friend picked shows their card, whose buttons ask the game;
// removing asks first; requests are answered; the black list is added to and taken from; the guild's roster sorts,
// filters and searches, its member's card asks the game, its card invites and leaves; the communities show the picked
// one's members and streams; the recent allies are pinned and befriended. The friends are `"$game"`'s, answered by
// the test (what the window asks of them is the fake game's requests); the door to the guild, the communities and
// the recent allies is the test's own (what the window asks of it is heard).
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Friend, Hero, Presence } from "$game"
import { Key } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Social from "OrdaenSocial"
import { Ally, AllyCategory, Club, Guild, Member, News, NewsFilter, People, Stream } from "@/people"
import { SeenHero, seenAfter } from "@/seen"

const PAGE: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
// A text the window always shows: its last tab.
const WINDOW = "Recent Allies"

// Whether a field in this part shows this text: the guild's message and information are texts to copy.
function fieldSays(part: Test.Part, text: String): Boolean {
  const fields = part.input()
  for (at of 1..fields.count()) {
    if (fields.nth(at).value() == text) { return true }
  }
  return false
}

function hero(name: String, level: Integer, area: String): Hero {
  return { name: name, level: level, className: "Warrior", classFile: "WARRIOR", area: area, realm: "Flamegor" }
}

function member(name: String, level: Integer, className: String, zone: String, presence: Presence, rank: String, order: Integer, note: String): Member {
  return {
    key: name, name: name, level: level, className: className, classColor: nil, zone: zone, presence: presence, rank: rank,
    rankOrder: order, note: note, officerNote: "", away: presence == .Offline ? 50 : 0, achievementPoints: level * 10,
    professions: name == "Ingrid" ? "Tailoring 225, Enchanting 180" : ""
  }
}

// The friends as the game gives them: two Battle.net friends (one a best friend playing here, one offline), two
// characters (one offline).
function friends(): Array<Friend> {
  return [
    {
      index: 1, presence: .Offline, note: "", hero: nil,
      account: {
        id: 11, name: "Irina", battleTag: "Iris#5512", program: "", broadcast: "", favorite: false, lastOnline: 0,
        gameAccount: 0
      }
    },
    {
      index: 2, presence: .Online, note: "tanks at night", hero: hero("Torgrim", 25, "Loch Modan"),
      account: {
        id: 12, name: "Alexei", battleTag: "Drake#2145", program: "WoW", broadcast: "LFG Deadmines",
        favorite: true, lastOnline: 0, gameAccount: 7
      }
    },
    { index: 1, presence: .Away, note: "", hero: hero("Eliana", 24, "Stormwind"), account: nil },
    { index: 2, presence: .Offline, note: "smith", hero: hero("Darrick", 22, ""), account: nil }
  ]
}

// The rest the game's friends part answers each test with: a request, one ignored, the player's Battle.net self.
function requests(): Array<Game.FriendRequest> { return [{ id: 31, name: "Ulfric#1111", sent: 0 }] }
function ignoredOnes(): Array<Game.Ignored> { return [Game.Ignored.Character { index: 1, name: "Rudegnome" }] }

function battleNetSelf(): Game.BattleNetSelf {
  return { battleTag: "Ordaen#2718", presence: .Online, broadcast: "", hero: hero("Torvald", 25, "Ironforge") }
}

// What the window asked of the game's friends part since last asked, as one line.
function askedFriends(): String { return Test.requests().filter(line => line.contains("Friends.")).join(", ") }

// The test's door: a guild of three (one offline) whose ranks the player may change, two lines of its news and the
// news' filter of three kinds; two communities; two recent allies, one pinned.
class FakePeople implements People {
  heard: mut Array<String> = []
  inGuild = true
  manages = true
  pinned = true
  asked = 0

  public motd(mut self): String { return "Raid on Friday" }

  public guild(self, motd: String): Guild | nil {
    if (!self.inGuild) { return nil }
    return {
      name: "Iron Vow", motd: motd, info: "Be kind to the new ones.",
      members: [
        member("Torvald", 25, "Warrior", "Ironforge", .Online, "Guild Master", 1, "the founder"),
        member("Ingrid", 24, "Priest", "Stormwind", .Online, "Officer", 2, "heals"),
        member("Branna", 27, "Mage", "Darnassus", .Offline, "Member", 3, "keeps the bank; ask her before taking anything from its second tab")
      ],
      rights: { invite: true, promote: true, demote: true, manage: self.manages }
    }
  }

  public news(self): Array<News> {
    return [
      { who: "Ingrid", what: "crafted [Copper Chain Vest]", kind: .Crafted, subject: 3471, day: 12, month: 11, sticky: false },
      { who: "Branna", what: "earned [Level 20]", kind: .Achievement, subject: 7, day: 10, month: 11, sticky: false },
      { who: "Torvald", what: "founded the guild", kind: .Founded, subject: 0, day: 2, month: 11, sticky: true }
    ]
  }

  public newsFilters(self): Array<NewsFilter> {
    return [
      { kind: 2, label: "Achievements", shown: true }, { kind: 3, label: "Dungeon Encounters", shown: true },
      { kind: 6, label: "Epic Items Crafted", shown: true }
    ]
  }

  public filterNews(mut self, kind: Integer, shown: Boolean) { self.heard.push(`filter ${kind} ${shown}`) }

  public clubs(self): Array<Club> {
    return [
      { id: "c1", name: "Night Fishers", description: "We fish at night.", broadcast: "Tonight at nine", battleNet: true, memberCount: 2 },
      { id: "c2", name: "Smiths of Ironforge", description: "", broadcast: "", battleNet: false, memberCount: 1 }
    ]
  }

  public clubMembers(self, club: String): Array<Member> {
    if (club == "c2") { return [member("Bjorn", 25, "Paladin", "Ironforge", .Online, "Owner", 1, "")] }
    return [
      member("Halvar", 23, "Hunter", "Wetlands", .Online, "Owner", 1, "the best rod"),
      member("Sigrun", 20, "Rogue", "", .Offline, "Member", 4, "")
    ]
  }

  public streams(self, club: String): Array<Stream> {
    return [{ id: "1", name: "General", subject: "Everything" }, { id: "2", name: "Catches", subject: "" }]
  }

  // Gunnar did a dungeon with the player: the game finds him among the dungeons; Astrid did nothing of either.
  public allies(self, categories: Array<AllyCategory> | nil): Array<Ally> {
    const gunnar: Ally = {
      member: member("Gunnar", 25, "Shaman", "Redridge", .Online, "", 0, ""), fullName: "Gunnar-Flamegor",
      meetings: [{ text: "Completed the Deadmines together", when: Game.clock.server - 7200 }, { text: "Traded", when: Game.clock.server - 259200 }],
      pinned: self.pinned, pinExpires: self.pinned ? Game.clock.server + 3 * 86400 + 60 : 0, requestSent: false
    }
    if (categories != nil) { return categories.any(category => category == .Dungeons) ? [gunnar] : [] }
    return [
      gunnar,
      {
        member: member("Astrid", 21, "Druid", "", .Offline, "", 0, ""), fullName: "Astrid-Flamegor", meetings: [], pinned: false,
        pinExpires: 0, requestSent: true
      }
    ]
  }

  public allyCategories(self): Array<AllyCategory> { return [.PvP, .Dungeons] }

  public whisper(mut self, friend: Friend) { self.heard.push(`whisper ${friend.hero?.name ?? ""}`) }
  public copy(mut self, text: String) { self.heard.push(`copy ${text}`) }
  public memberMenu(mut self, club: String, key: String) { self.heard.push(`menu ${club} ${key}`) }
  public allyMenu(mut self, ally: Ally) { self.heard.push(`ally menu ${ally.fullName}`) }
  public noteAlly(mut self, key: String, note: String) { self.heard.push(`note ${key} ${note}`) }
  public whisperTo(mut self, name: String) { self.heard.push(`whisper ${name}`) }
  public inviteTo(mut self, name: String) { self.heard.push(`invite ${name}`) }
  public guildInvite(mut self, name: String) { self.heard.push(`guild invite ${name}`) }
  public promote(mut self, name: String) { self.heard.push(`promote ${name}`) }
  public demote(mut self, name: String) { self.heard.push(`demote ${name}`) }

  public leaveGuild(mut self) {
    self.heard.push("leave guild")
    self.inGuild = false
  }

  public pin(mut self, key: String, pinned: Boolean) {
    self.heard.push(`pin ${key} ${pinned}`)
    self.pinned = pinned
  }

  public ask(mut self) { self.asked += 1 }
}

// The game's friends window, shown as its key or its micro button shows it, with the test's door: ours.
function opened(people: mut FakePeople): Test.Part {
  Social.people = people
  const game = Client.CreateFrame("Frame", "FriendsFrame", Client.UIParent, nil)
  game.Hide()
  Social.hook(game, nil)
  game.Show()
  return Test.page().window(WINDOW)
}

// The window

test "the game's friends window shown shows ours, and closing ours closes the game's" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const people = new FakePeople()
  Social.people = people
  const game = Client.CreateFrame("Frame", "FriendsFrame", Client.UIParent, nil)
  game.Hide()
  Social.hook(game, nil)
  Test.expect(!Test.page().window(WINDOW).shown())
  game.Show()
  const window = Test.page().window(WINDOW)
  Test.expect(window.text("Friends").shown())
  // What the game sends late is asked for once, as the window opens.
  Test.expect(people.asked == 1)
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!window.shown())
  Test.expect(!game.IsShown())
}

test "the game's guild window, hooked as its addon loads, shows ours on the guild; outside one on the communities" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const people = new FakePeople()
  Social.people = people
  const game = Client.CreateFrame("Frame", "CommunitiesFrame", Client.UIParent, nil)
  game.Hide()
  Events.ADDON_LOADED.emit("Blizzard_Communities", false)
  game.Show()
  const window = Test.page().window(WINDOW)
  Test.expect(fieldSays(window, "Raid on Friday"))
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!game.IsShown())
  people.inGuild = false
  game.Show()
  Test.expect(Test.page().window(WINDOW).text("We fish at night.").shown())
}

test "the raid isn't a tab of the window" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const window = opened(new FakePeople())
  Test.expect(!window.text("Raid").shown())
  Test.expect(window.text("Guild").shown() && window.text("Communities").shown())
}

// The friends

test "the list holds both kinds, the best friend first and those offline last" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const window = opened(new FakePeople())
  const texts = window.texts()
  const alexei = texts.find(text => text == "Alexei")
  Test.expect(alexei != nil)
  Test.expect(window.text("Battle.net · Torgrim · Loch Modan").shown())
  Test.expect(window.text("Eliana").shown())
  Test.expect(window.text("Battle.net · offline").shown())
  // The best friend's star: the game's own friends list's, after the name.
  Test.expect(window.text("Alexei").item().paintedWith("friendslist-favorite"))
  Test.shot("the friends: the best friend on top with its star, the levels at the right, the card the player's own")
}

test "the best friend's star stands after the name, never over it" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const window = opened(new FakePeople())
  const name = window.text("Alexei").rect()
  const star = window.text("Alexei").item().box("friendslist-favorite").rect()
  Test.expect(star.left >= name.right)
}

test "the filter shows each kind and those offline, and the view draws the friends as a table" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const window = opened(new FakePeople())
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test.page().text("Battle.net").nth(1).click()
  Test.expect(!window.text("Alexei").shown() && window.text("Eliana").shown())
  Test.page().text("Offline").click()
  Test.expect(!window.text("Darrick").shown())
  Test.page().text("Reset").click()
  Test.expect(window.text("Alexei").shown() && window.text("Darrick").shown())
  Test.key(Key.Escape)
  // The view's switch shows the view it is on.
  window.button(Ordaen.art.ctl.tool.list).click()
  Test.page().text("Table").click()
  Test.expect(window.text("Level").shown() && window.text("tanks at night").shown())
  Test.shot("the friends as a table: name with the star, level, where, note")
  window.text("Eliana").click()
  Test.expect(window.button("Whisper").shown())
}

// The friends' names as the list shows them, in its order, joined by «, ».
function friendsOrder(window: Test.Part): String {
  return window.texts().filter(text => text == "Alexei" || text == "Irina" || text == "Eliana" || text == "Darrick").join(", ")
}

function sortBy(window: Test.Part, choice: String) {
  window.button(Ordaen.art.ctl.tool.sort).click()
  Test.page().window("Online first").button(choice).click()
}

test "the sort is the table's: its headings and the toolbar's sort set one order, the best friend on top in every one" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const window = opened(new FakePeople())
  Test.expect(friendsOrder(window) == "Alexei, Eliana, Darrick, Irina")
  sortBy(window, "Level")
  Test.expect(friendsOrder(window) == "Alexei, Eliana, Darrick, Irina")
  sortBy(window, "Name")
  Test.expect(friendsOrder(window) == "Alexei, Darrick, Eliana, Irina")
  window.button(Ordaen.art.ctl.tool.list).click()
  Test.page().text("Table").click()
  // The heading of the sort picked in the list; clicked, the order turns round, the best friend still on top.
  window.button("Name").click()
  Test.expect(friendsOrder(window) == "Alexei, Irina, Eliana, Darrick")
  window.button("Level").click()
  Test.expect(friendsOrder(window) == "Alexei, Eliana, Darrick, Irina")
}

test "the friends' view, sort and filter are there after a reload" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const window = opened(new FakePeople())
  sortBy(window, "Name")
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test.page().text("Offline").click()
  Test.key(Key.Escape)
  window.button(Ordaen.art.ctl.tool.list).click()
  Test.page().text("Table").click()
  Test.reload()
  const again = opened(new FakePeople())
  Test.expect(again.text("Level").shown())
  Test.expect(friendsOrder(again) == "Alexei, Eliana")
}

test "a development build's footer button shows the game's own window of the tab, as it is, until it closes" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const people = new FakePeople()
  Social.people = people
  const game = Client.CreateFrame("Frame", "FriendsFrame", Client.UIParent, nil)
  game.Hide()
  Social.hook(game, nil)
  game.Show()
  Test.page().window(WINDOW).button("Blizzard window").click()
  Test.expect(!Test.page().window(WINDOW).shown())
  Test.expect(game.IsShown() && game.GetAlpha() == 1)
  game.Hide()
  game.Show()
  Test.expect(Test.page().window(WINDOW).text("Alexei").shown())
}

test "a friend picked shows their card, whose buttons ask the game in the click" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Eliana").click()
  Test.expect(window.text("Stormwind").shown())
  window.button("Whisper").click()
  window.button("Invite").click()
  Test.expect(people.heard.join(", ") == "whisper Eliana")
  Test.expect(askedFriends() == "Friends.invite Eliana")
  // Picked again: the player's own card.
  window.text("Eliana").nth(1).click()
  Test.expect(window.text("This is you").shown())
}

test "an offline friend can't be whispered or invited" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Darrick").click()
  window.button("Whisper").click()
  window.button("Invite").click()
  Test.expect(people.heard.length == 0 && askedFriends() == "")
}

test "removing a friend asks first, and only the yes removes" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Eliana").click()
  window.button("Remove").click()
  const ask = Test.page().window("Remove Eliana from your friends?")
  Test.expect(ask.text("The character leaves your friends list.").shown())
  ask.button("Cancel").click()
  Test.expect(askedFriends() == "")
  window.button("Remove").click()
  // The game's list as it is once she is gone.
  Game.friends.list = () => friends().filter(friend => friend.hero?.name != "Eliana")
  Test.page().window("Remove Eliana from your friends?").button("Remove").click()
  Test.expect(askedFriends() == "Friends.remove Eliana")
  Test.expect(!window.text("Eliana").shown())
  Test.expect(window.text("This is you").shown())
}

test "the search finds by name, note and BattleTag" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  const window = opened(new FakePeople())
  window.input().type("smith")
  Test.expect(window.text("Darrick").shown())
  Test.expect(!window.text("Eliana").shown())
}

test "add friend sends what is typed, and says which kind it makes" {
