// The guild

test "the guild's roster: those online first, a heading sorts it, «Show» keeps those online, the search finds a note" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  const window = opened(new FakePeople())
  window.text("Guild").click()
  Test.expect(window.text("Guild Master").shown() && window.text("Branna").shown())
  Test.expect(window.text("2 d ago").shown())
  // The counts are the footer's alone, as label and value pairs: the guild's card says none.
  Test.expect(window.text("Members").shown() && window.text("Online").shown())
  Test.expect(window.text("3").shown() && window.text("2").shown())
  // The message of the day is a text to copy: what is typed into it is put back.
  const fields = window.input()
  for (at of 1..fields.count()) {
    if (fields.nth(at).value() == "Raid on Friday") { fields.nth(at).click() }
  }
  Test.expect(Test.keyboard())
  Test.type("x")
  Test.expect(fieldSays(window, "Raid on Friday"))
  Test.key(Key.Escape)
  Test.shot("the guild: its roster by rank, Branna's long note cut at its column, every row's columns under the headings, the guild's card beside it")
  // By level, the highest last: those online still above Branna.
  window.text("Level").click()
  Test.expect(window.texts().find(text => text == "Ingrid") != nil)
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test.page().text("Online only").click()
  Test.expect(!window.text("Branna").shown() && window.text("Torvald").shown())
  // The search: the first field drawn, before the guild's message and information.
  window.input().nth(1).type("heals")
  Test.expect(window.text("Ingrid").shown() && !window.text("Torvald").shown())
}

// Where a text first stands among those a part says, in the order drawn.
function placeOf(part: Test.Part, text: String): Integer {
  for (at, said of part.texts()) {
    if (said == text) { return at }
  }
  return 0
}

test "the guild's toolbar sorts as its headings do, and by class, which no column shows" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
