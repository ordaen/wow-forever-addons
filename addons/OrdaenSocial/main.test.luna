// The social window as the player meets it: the game's friends window shown (O, its micro button, the panel's cell)
// shows ours in its place, and closing ours closes the game's; the game's guild window (J) shows ours on the guild; the
// friends' list holds both kinds, best friends on top; a friend picked shows their card, whose buttons ask the game;
// removing asks first; requests are answered; the black list is added to and taken from; the guild's roster sorts,
// filters and searches, its member's card asks the game, its card invites and leaves; the communities show the picked
// one's members and streams; the recent allies are pinned and befriended. The friends, the guild, the communities and
// the recent allies are `"$game"`'s, answered by the test (what the window asks of them is the fake game's requests);
// the door to the chat, the group and the clipboard is the test's own (what the window asks of it is heard).
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { AllyCategory, Club, ClubStream, Friend, GuildNews, GuildRoster, Hero, Member, NewsFilter, Presence, RecentAlly } from "$game"
import { Key } from "$ltml"
import Runtime from "$runtime"
import Test from "$test"
import root Ordaen from "Ordaen"
import { classColor } from "Ordaen"
import root Social from "OrdaenSocial"
import { People } from "@/people"
import { SeenHero, seenAfter } from "@/seen"
import { THIS_SESSION } from "@/talks"
import { HEARD_FILL, TOLD_FILL } from "@/whispers"

const PAGE: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
// A text the window always shows: its last tab.
const WINDOW = "Recent Allies"

// Whether a field in this part shows this text: the guild's message and information are texts to copy.
function fieldSays(part: Test.Part, text: String): Boolean {
  const fields = part.input()
  for (at of 1..fields.count()) {
    if (fields.nth(at).value() == text) { return true }
  }
  return false
}

function hero(name: String, level: Integer, area: String): Hero {
  return { name: name, level: level, className: "Warrior", classFile: "WARRIOR", area: area, realm: "Flamegor" }
}

function member(name: String, level: Integer, className: String, zone: String, presence: Presence, rank: String, order: Integer, note: String): Member {
  return {
    key: name, name: name, level: level, className: className, classFile: "", zone: zone, presence: presence, rank: rank,
    rankOrder: order, note: note, officerNote: "", away: presence == .Offline ? 50 : 0, achievementPoints: level * 10,
    professions: name == "Ingrid" ? "Tailoring 225, Enchanting 180" : ""
  }
}

// The friends as the game gives them: two Battle.net friends (one a best friend playing here, one offline), two
// characters (one offline).
function friends(): Array<Friend> {
  return [
    {
      index: 1, presence: .Offline, note: "", hero: nil,
      account: {
        id: 11, name: "Irina", battleTag: "Iris#5512", program: "", broadcast: "", favorite: false, lastOnline: 0,
        gameAccount: 0
      }
    },
    {
      index: 2, presence: .Online, note: "tanks at night", hero: hero("Torgrim", 25, "Loch Modan"),
      account: {
        id: 12, name: "Alexei", battleTag: "Drake#2145", program: "WoW", broadcast: "LFG Deadmines",
        favorite: true, lastOnline: 0, gameAccount: 7
      }
    },
    { index: 1, presence: .Away, note: "", hero: hero("Eliana", 24, "Stormwind"), account: nil },
    { index: 2, presence: .Offline, note: "smith", hero: hero("Darrick", 22, ""), account: nil }
  ]
}

// The rest the game's friends part answers each test with: a request, one ignored, the player's Battle.net self.
function requests(): Array<Game.FriendRequest> { return [{ id: 31, name: "Ulfric#1111", sent: 0 }] }
function ignoredOnes(): Array<Game.Ignored> { return [Game.Ignored.Character { index: 1, name: "Rudegnome" }] }

function battleNetSelf(): Game.BattleNetSelf {
  return { battleTag: "Ordaen#2718", presence: .Online, broadcast: "", hero: hero("Torvald", 25, "Ironforge") }
}

// What the window asked of the game's parts since last asked, as one line.
function askedGame(): String { return Test.requests().join(", ") }

// The guild: three (one offline) whose ranks the player may change and who may manage the guild, or not; none.
function guildOf(motd: String, manages: Boolean): GuildRoster {
  return {
    name: "Iron Vow", motd: motd, info: "Be kind to the new ones.",
    members: [
      member("Torvald", 25, "Warrior", "Ironforge", .Online, "Guild Master", 1, "the founder"),
      member("Ingrid", 24, "Priest", "Stormwind", .Online, "Officer", 2, "heals"),
      member("Branna", 27, "Mage", "Darnassus", .Offline, "Member", 3, "keeps the bank; ask her before taking anything from its second tab")
    ],
    rights: { invite: true, promote: true, demote: true, manage: manages }
  }
}

function guildRoster(motd: String): GuildRoster | nil { return guildOf(motd, true) }
function guildUnmanaged(motd: String): GuildRoster | nil { return guildOf(motd, false) }
function noGuild(motd: String): GuildRoster | nil { return nil }
function guildMotd(): String { return "Raid on Friday" }

// Three lines of the guild's news, one sticky, and the news' filter of three kinds.
function guildNews(): Array<GuildNews> {
  return [
    { who: "Ingrid", what: "crafted [Copper Chain Vest]", kind: .Crafted, subject: 3471, day: 12, month: 11, sticky: false },
    { who: "Branna", what: "earned [Level 20]", kind: .Achievement, subject: 7, day: 10, month: 11, sticky: false },
    { who: "Torvald", what: "founded the guild", kind: .Founded, subject: 0, day: 2, month: 11, sticky: true }
  ]
}

function newsFilters(): Array<NewsFilter> {
  return [
    { kind: 2, label: "Achievements", shown: true }, { kind: 3, label: "Dungeon Encounters", shown: true },
    { kind: 6, label: "Epic Items Crafted", shown: true }
  ]
}

// Two communities, each with its members and two streams.
function clubs(): Array<Club> {
  return [
    { id: "c1", name: "Night Fishers", description: "We fish at night.", broadcast: "Tonight at nine", battleNet: true, memberCount: 2 },
    { id: "c2", name: "Smiths of Ironforge", description: "", broadcast: "", battleNet: false, memberCount: 1 }
  ]
}

function clubMembers(club: String): Array<Member> {
  if (club == "c2") { return [member("Bjorn", 25, "Paladin", "Ironforge", .Online, "Owner", 1, "")] }
  return [
    member("Halvar", 23, "Hunter", "Wetlands", .Online, "Owner", 1, "the best rod"),
    member("Sigrun", 20, "Rogue", "", .Offline, "Member", 4, "")
  ]
}

function streams(club: String): Array<ClubStream> {
  return [{ id: "1", name: "General", subject: "Everything" }, { id: "2", name: "Catches", subject: "" }]
}

// Two recent allies: Gunnar, pinned or not, did a dungeon with the player (the game finds him among the dungeons);
// Astrid did nothing of either.
function alliesOf(categories: Array<AllyCategory> | nil, pinned: Boolean): Array<RecentAlly> {
  const gunnar: RecentAlly = {
    member: member("Gunnar", 25, "Shaman", "Redridge", .Online, "", 0, ""), fullName: "Gunnar-Flamegor",
    meetings: [{ text: "Completed the Deadmines together", when: Game.clock.server - 7200 }, { text: "Traded", when: Game.clock.server - 259200 }],
    pinned: pinned, pinExpires: pinned ? Game.clock.server + 3 * 86400 + 60 : 0, requestSent: false
  }
  if (categories != nil) { return categories.any(category => category == .Dungeons) ? [gunnar] : [] }
  return [
    gunnar,
    {
      member: member("Astrid", 21, "Druid", "", .Offline, "", 0, ""), fullName: "Astrid-Flamegor", meetings: [], pinned: false,
      pinExpires: 0, requestSent: true
    }
  ]
}

function allies(categories: Array<AllyCategory> | nil): Array<RecentAlly> { return alliesOf(categories, true) }
function alliesUnpinned(categories: Array<AllyCategory> | nil): Array<RecentAlly> { return alliesOf(categories, false) }
function allyCategories(): Array<AllyCategory> { return [.PvP, .Dungeons] }

// The test's door to the chat, the group and the clipboard: what it is asked is heard.
class FakePeople implements People {
  heard: mut Array<String> = []

  public copy(mut self, text: String) { self.heard.push(`copy ${text}`) }
  public inviteTo(mut self, name: String) { self.heard.push(`invite ${name}`) }
}

// The game's friends window, shown as its key or its micro button shows it, with the test's door: ours.
function opened(people: mut FakePeople): Test.Part {
  Social.people = people
  const game = Client.CreateFrame("Frame", "FriendsFrame", Client.UIParent, nil)
  game.Hide()
  Social.hook(game, nil)
  game.Show()
  // What the window asks of the game as it opens is no test's own.
  _ = Test.requests()
  return Test.page().window(WINDOW)
}

// The window

test "the game's friends window shown shows ours, and closing ours closes the game's" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  const people = new FakePeople()
  Social.people = people
  const game = Client.CreateFrame("Frame", "FriendsFrame", Client.UIParent, nil)
  game.Hide()
  Social.hook(game, nil)
  Test.expect(!Test.page().window(WINDOW).shown())
  game.Show()
  const window = Test.page().window(WINDOW)
  Test.expect(window.text("Friends").shown())
  // What the game sends late is asked for once, as the window opens.
  Test.expect(askedGame() == "Guild.ask, RecentAllies.ask")
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!window.shown())
  Test.expect(!game.IsShown())
}

// The panel off, the game's micro menu stands: its guild button loads the game's guild window, which shows ours.
test "the micro menu's guild button shows ours on the guild, and again closes it" {
  Test.mount(nil, PAGE)
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Runtime.press(Client.GuildMicroButton, .Left)
  const window = Test.page().window(WINDOW)
  Test.expect(window.shown() && fieldSays(window, "Raid on Friday"))
  Runtime.press(Client.GuildMicroButton, .Left)
  Test.expect(!Test.page().window(WINDOW).shown()) }

test "the game's guild window, hooked as its addon loads, shows ours on the guild; outside one on the communities" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  const people = new FakePeople()
  Social.people = people
  const game = Client.CreateFrame("Frame", "CommunitiesFrame", Client.UIParent, nil)
  game.Hide()
  Events.ADDON_LOADED.emit("Blizzard_Communities", false)
  game.Show()
  const window = Test.page().window(WINDOW)
  Test.expect(fieldSays(window, "Raid on Friday"))
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!game.IsShown())
  Game.guild.roster = noGuild
  game.Show()
  Test.expect(Test.page().window(WINDOW).text("We fish at night.").shown())
}

test "the raid isn't a tab of the window" {
  Test.mount(nil, PAGE)
