// The characters Battle.net friends were last seen on

test "an offline Battle.net friend shows the character and level last seen, kept over a reload" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  _ = opened(new FakePeople())
  // Alexei goes offline: his row still names Torgrim, and the level.
  Game.friends.list = () => friends().map(friend => friend.account?.name == "Alexei" ? Friend {
    index: friend.index, presence: .Offline, note: friend.note, hero: nil,
    account: { id: 12, name: "Alexei", battleTag: "Drake#2145", program: "", broadcast: "", favorite: true, lastOnline: 0, gameAccount: 0 }
  } : friend)
  Test.reload()
  const window = opened(new FakePeople())
  Test.expect(window.text("Battle.net · offline · Torgrim").shown())
  window.text("Alexei").click()
  Test.expect(window.text("Last seen as").shown() && window.text("Torgrim, Warrior 25 · Flamegor").shown())
}

test "the characters last seen are capped, go when not seen for long or no longer friends, and stay while Battle.net is off" {
  const now = 1800000000
  const old: SeenHero = { name: "Old", level: 10, className: "Mage", classFile: "MAGE", realm: "Flamegor", at: now - 200 * 86400 }
  const kept: Map<String, SeenHero> = {}
  kept["Old#1"] = old
  kept["Gone#2"] = { name: "Gone", level: 5, className: "", classFile: "", realm: "", at: now }
  kept["Drake#2145"] = { name: "Torgrim", level: 25, className: "Warrior", classFile: "WARRIOR", realm: "Flamegor", at: now }
  // Battle.net off: no account in the list, nobody dropped (but the one too old).
  const off = seenAfter(kept, [], now) ?? panic("the old one goes")
  Test.expect(off["Gone#2"] != nil && off["Old#1"] == nil)
  // The list read: Irina isn't seen playing, Alexei is as before; Gone and Old aren't friends.
  const read = seenAfter(kept, friends(), now) ?? panic("the others go")
  Test.expect(read["Drake#2145"] != nil && read["Gone#2"] == nil && read["Old#1"] == nil && read["Iris#5512"] == nil)
  // Nothing changed: nothing to write.
  Test.expect(seenAfter(read, friends(), now) == nil)
  // At most two hundred: the oldest go.
  const many: Map<String, SeenHero> = {}
  const list: Array<Friend> = []
  for (at of 1..205) {
    const tag = `Friend#${at}`
    many[tag] = { name: "A", level: 1, className: "", classFile: "", realm: "", at: now - at }
    list.push({ index: at, presence: .Offline, note: "", hero: nil, account: { id: at, name: "A", battleTag: tag, program: "", broadcast: "", favorite: false, lastOnline: 0, gameAccount: 0 } })
  }
  const capped = seenAfter(many, list, now) ?? panic("capped")
  Test.expect(capped["Friend#1"] != nil && capped["Friend#200"] != nil && capped["Friend#201"] == nil)
}
