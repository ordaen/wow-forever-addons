test "a conversation is bubbles: the other's on the left, the player's on the right, a group's time under its last" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  Game.clock.hours24 = true
  _ = Social.heard(whisper("Jaina", "hi", false, 12 * 3600), "hi")
  _ = Social.heard(whisper("Jaina", "are you there?", false, 12 * 3600 + 30), "are you there?")
  _ = Social.heard(whisper("Jaina", "yes", true, 12 * 3600 + 60), "yes")
  const window = opened(new FakePeople())
  Social.whisperTo("Jaina", false)
  const heard = window.text("hi").rect()
  const told = window.text("yes").rect()
  // Hers start at the conversation's left, his end at its right; each side on its own floor.
  Test.expect(heard.left < told.left && window.text("are you there?").rect().left == heard.left)
  // Two bubbles of hers and one of his, the last of each run with its tail in its colour, at its side.
  const tails = window.box("ChatBubble-Tail")
  Test.expect(window.box(HEARD_FILL).count() == 3 && window.box(TOLD_FILL).count() == 2 && tails.count() == 2)
  Test.expect(tails.nth(1).rect().left < window.text("are you there?").rect().left && tails.nth(2).rect().right > told.right)
  // Her two lines are one group: its time once, under the second; then his.
  Test.expect(window.texts().filter(t => t == "12:00").length == 1 && window.texts().filter(t => t == "12:01").length == 1)
  Test.expect(window.text("12:00").rect().top > window.text("are you there?").rect().bottom)
}
