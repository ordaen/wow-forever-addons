test "removing a friend asks first, and only the yes removes" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Eliana").click()
  window.button("Remove").click()
  const ask = Test.page().window("Remove Eliana from your friends?")
  Test.expect(ask.text("The character leaves your friends list.").shown())
  ask.button("Cancel").click()
  Test.expect(askedGame() == "")
  window.button("Remove").click()
  // The game's list as it is once she is gone.
  Game.friends.list = () => friends().filter(friend => friend.hero?.name != "Eliana")
  Test.page().window("Remove Eliana from your friends?").button("Remove").click()
  Test.expect(askedGame() == "Friends.remove Eliana")
  Test.expect(!window.text("Eliana").shown())
  Test.expect(window.text("This is you").shown())
}

