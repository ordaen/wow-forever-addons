}

// The whispers

// Two colours of the same channels.
function sameColor(a: Color, b: Color): Boolean { return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a }

// A whisper as Ordaen Chat hands it: heard (or told, by the player), its words what the bubble shows.
function whisper(sender: String, words: String, told: Boolean = false, time: Number = Game.clock.server): mut Game.ChatLine {
  const kind = told ? "WHISPER_INFORM" : "WHISPER"
  return {
    kind: kind, event: `CHAT_MSG_${kind}`, body: words, plain: words, text: words, sender: sender, guid: "", lineId: 1,
    channel: 0, channelName: "", stream: "", color: Color.hex("#ff80ff"), time: time, stamp: "", windows: [1], secret: ""
  }
}

test "whispers are the window's tab: a conversation a person, unread until opened, answered in its own line" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  // Heard while the window is closed: waiting unread, the count the micro menu's second badge shows.
  _ = Social.heard(whisper("Jaina", "psst"), "psst")
  Test.flush()
  Test.expect(Social.whispersUnread == 1 && Ordaen.noticeOf("OrdaenSocial") == 1)
  const window = opened(new FakePeople())
  Test.expect(window.text("1 unread").shown())
  window.text("Whispers").click()
  window.text("Jaina").click()
  Test.expect(window.text("psst").shown() && Social.whispersUnread == 0 && Ordaen.noticeOf("OrdaenSocial") == 0)
  window.input().nth(2).type("hello")
  _ = Test.key(Key.Enter)
  Test.expect(Test.requests().any(r => r == "Chat.whisper Jaina hello false"))
  // Another person's whisper: a conversation of their own, first in the list, waiting unread.
  _ = Social.heard(whisper("Thrall", "lok'tar"), "lok'tar")
  Test.expect(window.text("Thrall").rect().top < window.text("Jaina").rect().top)
  Test.expect(Social.whispersUnread == 1 && !window.text("lok'tar").shown())
  window.text("Thrall").click()
  Test.expect(window.text("lok'tar").shown() && Social.whispersUnread == 0)
  // A line of the open conversation is read as it comes.
  _ = Social.heard(whisper("Thrall", "for the horde"), "for the horde")
  Test.expect(Social.whispersUnread == 0 && window.text("for the horde").shown())
  // A name typed starts one.
  window.input().nth(1).type("Anduin")
  _ = Test.key(Key.Enter)
  Test.expect(window.text("Anduin").shown())
}

test "a whisper started anywhere opens the window on that conversation; a told line is never unread" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  const window = opened(new FakePeople())
  _ = Social.heard(whisper("Jaina", "on my way", true), "on my way")
  Test.expect(Social.whispersUnread == 0)
  Social.whisperTo("Jaina", false)
  Test.expect(Social.talkOpen == "t:Jaina" && window.text("on my way").shown())
  // The footer counts the whispers' own, never the allies; the conversation stands in a well, the sidebar beside it.
  Test.expect(window.text("Conversations").shown() && window.text("Unread").shown() && !window.text("Recent allies").shown())
  const well = window.box(Ordaen.art.ctl.well.floor).rect()
  const said = window.text("on my way").rect()
  Test.expect(said.left >= well.left && said.right <= well.right && window.text("Jaina").rect().right <= well.left)
  // The well takes the tab's height, the newest line at its foot.
  Test.expect(said.top >= well.top && said.bottom <= well.bottom && well.bottom - well.top > 100)
  Test.expect(window.text("on my way").shown())
}

test "a conversation names a character in its class colour with its level; a Battle.net friend by the account, its character under it" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  const window = opened(new FakePeople())
  _ = Social.heard(whisper("Eliana", "hi"), "hi")
  const told = whisper("Alexei", "ready?")
  told.kind = "BN_WHISPER"
  _ = Social.heard(told, "ready?")
  Social.whisperTo("Eliana", false)
  const warrior = classColor("WARRIOR") ?? panic("a warrior's colour")
  Test.expect(window.text("24lvl").shown() && sameColor(window.text("Eliana").textColor(), warrior))
  Test.expect(window.text("Alexei").shown() && sameColor(window.text("Torgrim").textColor(), warrior) && window.text("25lvl").shown())
  // The character under the account's name, a little room between them, never a body line's.
  const account = window.text("Alexei").rect()
  const character = window.text("Torgrim").rect()
  Test.expect(character.top - account.bottom >= 2 && character.top - account.bottom <= 8)
}

test "a conversation's right-click closes it, its lines kept for the person's next whisper, or clears them" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  _ = Social.heard(whisper("Jaina", "first"), "first")
  _ = Social.heard(whisper("Thrall", "lok'tar"), "lok'tar")
  const window = opened(new FakePeople())
  Social.whisperTo("Jaina", false)
  // No «×» on a row: its menu closes it.
  Test.expect(!window.text("×").shown())
  window.text("Jaina").rightClick()
  Test.page().text("Close").click()
  Test.expect(!window.text("Jaina").shown() && Social.talkOpen == "t:Thrall")
  // Jaina whispers again: her conversation is back, the lines before with it, kept over a reload while closed.
  Events.PLAYER_LOGOUT.emit()
  Test.reload()
  const again = opened(new FakePeople())
  Test.expect(Social.talks.length == 1)
  _ = Social.heard(whisper("Jaina", "second"), "second")
  Social.whisperTo("Jaina", false)
  Test.expect(again.text("first").shown() && again.text("second").shown())
  // Cleared: the conversation stays, its lines gone.
  again.text("Jaina").rightClick()
  Test.page().text("Clear history").click()
  Test.expect(again.text("Jaina").shown() && !again.text("first").shown() && !again.text("second").shown())
}

test "a conversation's sessions stand under a rule naming each, as the chat's do" {
  Test.mount(nil, PAGE)
  Game.friends.list = friends
  Game.friends.requests = requests
  Game.friends.ignored = ignoredOnes
  Game.friends.battleNetSelf = battleNetSelf
  Game.guild.roster = guildRoster
  Game.guild.motd = guildMotd
  Game.guild.news = guildNews
  Game.guild.newsFilters = newsFilters
  Game.communities.clubs = clubs
  Game.communities.members = clubMembers
  Game.communities.streams = streams
  Game.recentAllies.list = allies
  Game.recentAllies.categories = allyCategories
  _ = Social.heard(whisper("Jaina", "before"), "before")
  const first = opened(new FakePeople())
  Social.whisperTo("Jaina", false)
  // In this session alone: no rule.
  Test.expect(!first.texts().any(text => text.match("^Session · ") != nil))
  // A later session: the kept line under its session's rule, this session's rule over what it hears.
  Game.clock.server = THIS_SESSION.floor() + 3600
  Events.PLAYER_LOGOUT.emit()
  Test.reload()
  _ = Social.heard(whisper("Jaina", "now"), "now")
  const window = opened(new FakePeople())
  Social.whisperTo("Jaina", false)
  const rules = window.texts().filter(text => text.match("^Session · ") != nil)
  Test.expect(rules.length == 2)
  Test.expect(window.text(rules[1] ?? "").rect().bottom <= window.text("before").rect().top)
  Test.expect(window.text(rules[2] ?? "").rect().bottom <= window.text("now").rect().top)
}

