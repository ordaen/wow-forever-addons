// The social window as the player meets it: the game's friends window shown (O, its micro button, the panel's cell)
// shows ours in its place, and closing ours closes the game's; the game's guild window (J) shows ours on the guild; the
// friends' list holds both kinds, best friends on top; a friend picked shows their card, whose buttons ask the game;
// removing asks first; requests are answered; the black list is added to and taken from; the guild's roster sorts,
// filters and searches, its member's card asks the game, its card invites and leaves; the communities show the picked
// one's members and streams; the recent allies are pinned and befriended. The door to the client is the test's own
// (what the window asks of it is heard).
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Key } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Social from "OrdaenSocial"
import { Ally, AllyCategory, Club, Friend, Guild, Hero, Ignored, Me, Member, News, People, Presence, Request, Stream } from "@/people"

const PAGE: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
// A text the window always shows: its last tab.
const WINDOW = "Recent Allies"

// Whether a field in this part shows this text: the guild's message and information are texts to copy.
function fieldSays(part: Test.Part, text: String): Boolean {
  const fields = part.input()
  for (at of 1..fields.count()) {
    if (fields.nth(at).value() == text) { return true }
  }
  return false
}

function hero(name: String, level: Integer, area: String): Hero {
  return { name: name, level: level, className: "Warrior", classColor: nil, area: area, realm: "Flamegor" }
}

function member(name: String, level: Integer, className: String, zone: String, presence: Presence, rank: String, order: Integer, note: String): Member {
  return {
    key: name, name: name, level: level, className: className, classColor: nil, zone: zone, presence: presence, rank: rank,
    rankOrder: order, note: note, officerNote: "", away: presence == .Offline ? 50 : 0
  }
}

// The test's door: two Battle.net friends (one a best friend playing here, one offline), two characters (one
// offline), a request, one ignored; a guild of three (one offline) whose ranks the player may change, two lines of its
// news; two communities; two recent allies, one pinned.
class FakePeople implements People {
  heard: mut Array<String> = []
  removed = false
  inGuild = true
  manages = true
  pinned = true
  asked = 0

  public friends(self): Array<Friend> {
    const list: Array<Friend> = [
      {
        index: 1, presence: .Offline, note: "", hero: nil,
        account: {
          id: 11, name: "Irina", battleTag: "Iris#5512", program: "", broadcast: "", favorite: false, lastOnline: 0,
          gameAccount: 0
        }
      },
      {
        index: 2, presence: .Online, note: "tanks at night", hero: hero("Torgrim", 25, "Loch Modan"),
        account: {
          id: 12, name: "Alexei", battleTag: "Drake#2145", program: "WoW", broadcast: "LFG Deadmines",
          favorite: true, lastOnline: 0, gameAccount: 7
        }
      },
      { index: 1, presence: .Away, note: "", hero: hero("Eliana", 24, "Stormwind"), account: nil },
      { index: 2, presence: .Offline, note: "smith", hero: hero("Darrick", 22, ""), account: nil }
    ]
    if (self.removed) { _ = list.remove(3) }
    return list
  }

  public requests(self): Array<Request> { return [{ id: 31, name: "Ulfric#1111", sent: 0 }] }
  public ignored(self): Array<Ignored> { return [Ignored.Character { index: 1, name: "Rudegnome" }] }

  public me(self): Me {
    return { battleTag: "Ordaen#2718", presence: .Online, broadcast: "", hero: hero("Torvald", 25, "Ironforge") }
  }

  public guild(self): Guild | nil {
    if (!self.inGuild) { return nil }
    return {
      name: "Iron Vow", motd: "Raid on Friday", info: "Be kind to the new ones.",
      members: [
        member("Torvald", 25, "Warrior", "Ironforge", .Online, "Guild Master", 1, "the founder"),
        member("Ingrid", 24, "Priest", "Stormwind", .Online, "Officer", 2, "heals"),
        member("Branna", 27, "Mage", "Darnassus", .Offline, "Member", 3, "keeps the bank; ask her before taking anything from its second tab")
      ],
      rights: { invite: true, promote: true, demote: true, manage: self.manages }
    }
  }

  public news(self): Array<News> {
    return [
      { who: "Ingrid", what: "crafted [Copper Chain Vest]", day: 12, month: 11, sticky: false },
      { who: "Torvald", what: "founded the guild", day: 2, month: 11, sticky: true }
    ]
  }

  public clubs(self): Array<Club> {
    return [
      { id: "c1", name: "Night Fishers", description: "We fish at night.", broadcast: "Tonight at nine", battleNet: true, memberCount: 2 },
      { id: "c2", name: "Smiths of Ironforge", description: "", broadcast: "", battleNet: false, memberCount: 1 }
    ]
  }

  public clubMembers(self, club: String): Array<Member> {
    if (club == "c2") { return [member("Bjorn", 25, "Paladin", "Ironforge", .Online, "Owner", 1, "")] }
    return [
      member("Halvar", 23, "Hunter", "Wetlands", .Online, "Owner", 1, "the best rod"),
      member("Sigrun", 20, "Rogue", "", .Offline, "Member", 4, "")
    ]
  }

  public streams(self, club: String): Array<Stream> {
    return [{ id: "1", name: "General", subject: "Everything" }, { id: "2", name: "Catches", subject: "" }]
  }

  // Gunnar did a dungeon with the player: the game finds him among the dungeons; Astrid did nothing of either.
  public allies(self, categories: Array<AllyCategory> | nil): Array<Ally> {
    const gunnar: Ally = {
      member: member("Gunnar", 25, "Shaman", "Redridge", .Online, "", 0, ""), fullName: "Gunnar-Flamegor",
      meetings: [{ text: "Completed the Deadmines together", when: Game.clock.server - 7200 }, { text: "Traded", when: Game.clock.server - 259200 }],
      pinned: self.pinned
    }
    if (categories != nil) { return categories.any(category => category == .Dungeons) ? [gunnar] : [] }
    return [gunnar, { member: member("Astrid", 21, "Druid", "", .Offline, "", 0, ""), fullName: "Astrid-Flamegor", meetings: [], pinned: false }]
  }

  public allyCategories(self): Array<AllyCategory> { return [.PvP, .Dungeons] }

  public whisper(mut self, friend: Friend) { self.heard.push(`whisper ${friend.hero?.name ?? ""}`) }
  public invite(mut self, friend: Friend) { self.heard.push(`invite ${friend.hero?.name ?? ""}`) }

  public remove(mut self, friend: Friend) {
    self.heard.push(`remove ${friend.hero?.name ?? ""}`)
    self.removed = true
  }

  public answer(mut self, request: Request, accept: Boolean) { self.heard.push(`answer ${request.id} ${accept}`) }
  public ignore(mut self, name: String) { self.heard.push(`ignore ${name}`) }

  public unignore(mut self, entry: Ignored) {
    match (entry) {
      .Character => self.heard.push(`unignore ${entry.name}`)
      .Account => self.heard.push(`unblock ${entry.id}`)
    }
  }

  public addFriend(mut self, text: String) { self.heard.push(`add ${text}`) }
  public setPresence(mut self, presence: Presence) { self.heard.push(`presence ${presence}`) }
  public setBroadcast(mut self, text: String) { self.heard.push(`broadcast ${text}`) }
  public copy(mut self, text: String) { self.heard.push(`copy ${text}`) }
  public whisperTo(mut self, name: String) { self.heard.push(`whisper ${name}`) }
  public inviteTo(mut self, name: String) { self.heard.push(`invite ${name}`) }
  public guildInvite(mut self, name: String) { self.heard.push(`guild invite ${name}`) }
  public promote(mut self, name: String) { self.heard.push(`promote ${name}`) }
  public demote(mut self, name: String) { self.heard.push(`demote ${name}`) }

  public leaveGuild(mut self) {
    self.heard.push("leave guild")
    self.inGuild = false
  }

  public pin(mut self, key: String, pinned: Boolean) {
    self.heard.push(`pin ${key} ${pinned}`)
    self.pinned = pinned
  }

  public ask(mut self) { self.asked += 1 }
}

// The game's friends window, shown as its key or its micro button shows it, with the test's door: ours.
function opened(people: mut FakePeople): Test.Part {
  Social.people = people
  const game = Client.CreateFrame("Frame", "FriendsFrame", Client.UIParent, nil)
  game.Hide()
  Social.hook(game, nil)
  game.Show()
  return Test.page().window(WINDOW)
}

// The window

test "the game's friends window shown shows ours, and closing ours closes the game's" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  Social.people = people
  const game = Client.CreateFrame("Frame", "FriendsFrame", Client.UIParent, nil)
  game.Hide()
  Social.hook(game, nil)
  Test.expect(!Test.page().window(WINDOW).shown())
  game.Show()
  const window = Test.page().window(WINDOW)
  Test.expect(window.text("Friends").shown())
  // What the game sends late is asked for once, as the window opens.
  Test.expect(people.asked == 1)
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!window.shown())
  Test.expect(!game.IsShown())
}

test "the game's guild window, hooked as its addon loads, shows ours on the guild; outside one on the communities" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  Social.people = people
  const game = Client.CreateFrame("Frame", "CommunitiesFrame", Client.UIParent, nil)
  game.Hide()
  Events.ADDON_LOADED.emit("Blizzard_Communities", false)
  game.Show()
  const window = Test.page().window(WINDOW)
  Test.expect(fieldSays(window, "Raid on Friday"))
  window.button(Ordaen.art.ctl.corner.close).click()
  Test.expect(!game.IsShown())
  people.inGuild = false
  game.Show()
  Test.expect(Test.page().window(WINDOW).text("We fish at night.").shown())
}

test "the raid isn't a tab of the window" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  Test.expect(!window.text("Raid").shown())
  Test.expect(window.text("Guild").shown() && window.text("Communities").shown())
}

// The friends

test "the list holds both kinds, the best friend first and those offline last" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  const texts = window.texts()
  const alexei = texts.find(text => text == "Alexei")
  Test.expect(alexei != nil)
  Test.expect(window.text("Battle.net · Torgrim · Loch Modan").shown())
  Test.expect(window.text("Eliana").shown())
  Test.expect(window.text("Battle.net · offline").shown())
  // The best friend's star: the game's own friends list's, after the name.
  Test.expect(window.text("Alexei").item().paintedWith("friendslist-favorite"))
  Test.shot("the friends: the best friend on top with its star, the levels at the right, the card the player's own")
}

test "the filter shows each kind and those offline, and the view draws the friends as a table" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test.page().text("Battle.net").nth(1).click()
  Test.expect(!window.text("Alexei").shown() && window.text("Eliana").shown())
  Test.page().text("Offline").click()
  Test.expect(!window.text("Darrick").shown())
  Test.page().text("Reset").click()
  Test.expect(window.text("Alexei").shown() && window.text("Darrick").shown())
  Test.key(Key.Escape)
  // The view's switch shows the view it is on.
  window.button(Ordaen.art.ctl.tool.list).click()
  Test.page().text("Table").click()
  Test.expect(window.text("Level").shown() && window.text("tanks at night").shown())
  Test.shot("the friends as a table: name with the star, level, where, note")
  window.text("Eliana").click()
  Test.expect(window.button("Whisper").shown())
}

// The friends' names as the list shows them, in its order, joined by «, ».
function friendsOrder(window: Test.Part): String {
  return window.texts().filter(text => text == "Alexei" || text == "Irina" || text == "Eliana" || text == "Darrick").join(", ")
}

function sortBy(window: Test.Part, choice: String) {
  window.button(Ordaen.art.ctl.tool.sort).click()
  Test.page().window("Online first").button(choice).click()
}

test "the sort is the table's: its headings and the toolbar's sort set one order, the best friend on top in every one" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  Test.expect(friendsOrder(window) == "Alexei, Eliana, Darrick, Irina")
  sortBy(window, "Level")
  Test.expect(friendsOrder(window) == "Alexei, Eliana, Darrick, Irina")
  sortBy(window, "Name")
  Test.expect(friendsOrder(window) == "Alexei, Darrick, Eliana, Irina")
  window.button(Ordaen.art.ctl.tool.list).click()
  Test.page().text("Table").click()
  // The heading of the sort picked in the list; clicked, the order turns round, the best friend still on top.
  window.button("Name").click()
  Test.expect(friendsOrder(window) == "Alexei, Irina, Eliana, Darrick")
  window.button("Level").click()
  Test.expect(friendsOrder(window) == "Alexei, Eliana, Darrick, Irina")
}

test "the friends' view, sort and filter are there after a reload" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  sortBy(window, "Name")
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test.page().text("Offline").click()
  Test.key(Key.Escape)
  window.button(Ordaen.art.ctl.tool.list).click()
  Test.page().text("Table").click()
  Test.reload()
  const again = opened(new FakePeople())
  Test.expect(again.text("Level").shown())
  Test.expect(friendsOrder(again) == "Alexei, Eliana")
}

test "a development build's footer button shows the game's own window of the tab, as it is, until it closes" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  Social.people = people
  const game = Client.CreateFrame("Frame", "FriendsFrame", Client.UIParent, nil)
  game.Hide()
  Social.hook(game, nil)
  game.Show()
  Test.page().window(WINDOW).button("Blizzard window").click()
  Test.expect(!Test.page().window(WINDOW).shown())
  Test.expect(game.IsShown() && game.GetAlpha() == 1)
  game.Hide()
  game.Show()
  Test.expect(Test.page().window(WINDOW).text("Alexei").shown())
}

test "a friend picked shows their card, whose buttons ask the game in the click" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Eliana").click()
  Test.expect(window.text("Stormwind").shown())
  window.button("Whisper").click()
  window.button("Invite").click()
  Test.expect(people.heard.join(", ") == "whisper Eliana, invite Eliana")
  // Picked again: the player's own card.
  window.text("Eliana").nth(1).click()
  Test.expect(window.text("This is you").shown())
}

test "an offline friend can't be whispered or invited" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Darrick").click()
  window.button("Whisper").click()
  window.button("Invite").click()
  Test.expect(people.heard.length == 0)
}

test "removing a friend asks first, and only the yes removes" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Eliana").click()
  window.button("Remove").click()
  const ask = Test.page().window("Remove Eliana from your friends?")
  Test.expect(ask.text("The character leaves your friends list.").shown())
  ask.button("Cancel").click()
  Test.expect(people.heard.length == 0)
  window.button("Remove").click()
  Test.page().window("Remove Eliana from your friends?").button("Remove").click()
  Test.expect(people.heard.join(", ") == "remove Eliana")
  Test.expect(!window.text("Eliana").shown())
  Test.expect(window.text("This is you").shown())
}

test "the search finds by name, note and BattleTag" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  window.input().type("smith")
  Test.expect(window.text("Darrick").shown())
  Test.expect(!window.text("Eliana").shown())
}

test "add friend sends what is typed, and says which kind it makes" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.button("Add Friend").click()
  const add = Test.page().window("Send Request")
  Test.expect(add.text("A character's name: they are added to your World of Warcraft friends.").shown())
  add.input().type("Drake#2145")
  Test.expect(add.text("A BattleTag or an email: a Battle.net friend request is sent.").shown())
  add.button("Send Request").click()
  Test.expect(people.heard.join(", ") == "add Drake#2145")
}

test "the player's own card changes the broadcast in its dialog" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  Test.expect(window.text("Ordaen#2718").shown())
  window.button("Change Broadcast").click()
  const dialog = Test.page().window("Update")
  Test.expect(dialog.text("0 / 127").shown())
  dialog.input().type("  Raid at eight ")
  dialog.button("Update").click()
  Test.expect(people.heard.join(", ") == "broadcast Raid at eight")
}

test "a request is accepted or declined" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Requests (1)").click()
  window.button("Accept").click()
  window.button("Decline").click()
  Test.expect(people.heard.join(", ") == "answer 31 true, answer 31 false")
}

test "the black list takes a name and gives one back" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Ignore List").click()
  Test.expect(window.text("Rudegnome").shown())
  window.input().type("Goldseller")
  window.button("Add to Ignore List").click()
  window.text("Rudegnome").item().button("Remove").click()
  Test.expect(people.heard.join(", ") == "ignore Goldseller, unignore Rudegnome")
}

// The guild

test "the guild's roster: those online first, a heading sorts it, «Show» keeps those online, the search finds a note" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  window.text("Guild").click()
  Test.expect(window.text("Guild Master").shown() && window.text("Branna").shown())
  Test.expect(window.text("2 d ago").shown())
  // The counts are the footer's alone, as label and value pairs: the guild's card says none.
  Test.expect(window.text("Members").shown() && window.text("Online").shown())
  Test.expect(window.text("3").shown() && window.text("2").shown())
  // The message of the day is a text to copy: what is typed into it is put back.
  const fields = window.input()
  for (at of 1..fields.count()) {
    if (fields.nth(at).value() == "Raid on Friday") { fields.nth(at).click() }
  }
  Test.expect(Test.keyboard())
  Test.type("x")
  Test.expect(fieldSays(window, "Raid on Friday"))
  Test.key(Key.Escape)
  Test.shot("the guild: its roster by rank, Branna's long note cut at its column, every row's columns under the headings, the guild's card beside it")
  // By level, the highest last: those online still above Branna.
  window.text("Level").click()
  Test.expect(window.texts().find(text => text == "Ingrid") != nil)
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test.page().text("Online only").click()
  Test.expect(!window.text("Branna").shown() && window.text("Torvald").shown())
  // The search: the first field drawn, before the guild's message and information.
  window.input().nth(1).type("heals")
  Test.expect(window.text("Ingrid").shown() && !window.text("Torvald").shown())
}

// Where a text first stands among those a part says, in the order drawn.
function placeOf(part: Test.Part, text: String): Integer {
  for (at, said of part.texts()) {
    if (said == text) { return at }
  }
  return 0
}

test "the guild's toolbar sorts as its headings do, and by class, which no column shows" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  window.text("Guild").click()
  Test.expect(!window.text("Class").shown())
  // By rank: the Guild Master first.
  Test.expect(placeOf(window, "Torvald") < placeOf(window, "Ingrid"))
  window.button(Ordaen.art.ctl.tool.sort).click()
  Test.page().text("Class").click()
  // By class: the Priest before the Warrior.
  Test.expect(placeOf(window, "Ingrid") < placeOf(window, "Torvald"))
  // A heading sorts the toolbar's way too: by name.
  window.text("Name").click()
  Test.expect(placeOf(window, "Ingrid") < placeOf(window, "Torvald"))
}

test "a guild member's card whispers, invites, promotes and demotes in the click" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Guild").click()
  window.text("Ingrid").click()
  Test.expect(window.text("Priest, level 24").shown())
  window.button("Whisper").click()
  window.button("Invite").click()
  window.button("Promote").click()
  window.button("Demote").click()
  Test.expect(people.heard.join(", ") == "whisper Ingrid, invite Ingrid, promote Ingrid, demote Ingrid")
  // Picked again: the guild's card.
  window.text("Ingrid").nth(1).click()
  Test.expect(window.text("Iron Vow").shown())
}

test "the guild's card invites by name and asks before leaving" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Guild").click()
  Test.expect(fieldSays(window, "Be kind to the new ones."))
  window.button("Invite to Guild").click()
  const invite = Test.page().window("The character's name; from another realm, with the realm after a dash.")
  invite.input().type(" Ulfric ")
  invite.button("Invite").click()
  window.button("Leave Guild").click()
  const ask = Test.page().window("Leave Iron Vow?")
  ask.button("Cancel").click()
  Test.expect(people.heard.join(", ") == "guild invite Ulfric")
  window.button("Leave Guild").click()
  Test.page().window("Leave Iron Vow?").button("Leave Guild").click()
  Test.expect(people.heard.join(", ") == "guild invite Ulfric, leave guild")
  Test.expect(window.text("You aren't in a guild.").shown())
}

test "the guild's news: the sticky line first" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  window.text("Guild").click()
  window.text("News").click()
  // What each line says is a text to copy.
  Test.expect(window.input().nth(1).value() == "founded the guild")
  Test.expect(fieldSays(window, "crafted [Copper Chain Vest]"))
  Test.expect(window.text("02.11").shown())
}

test "«Guild Management» shows only to a player who may manage the guild" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  people.manages = false
  const window = opened(mut people)
  window.text("Guild").click()
  Test.expect(!window.button("Guild Management").shown() && window.button("Leave Guild").shown())
}

// The communities

test "the communities: the first one's members and streams, another picked shows its own" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Communities").click()
  Test.expect(window.text("Halvar").shown() && window.text("Owner").shown())
  Test.expect(window.text("Channels (2)").shown() && window.text("Everything").shown())
  Test.shot("the communities: a tab each, the first one's members under them and its card")
  window.text("Halvar").click()
  window.button("Whisper").click()
  Test.expect(people.heard.join(", ") == "whisper Halvar")
  window.text("Smiths of Ironforge").click()
  Test.expect(window.text("Bjorn").shown() && !window.text("Halvar").shown())
}

// The recent allies

test "the recent allies: those pinned first; an ally's card pins, whispers by full name and befriends" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Recent Allies").click()
  Test.expect(window.text("Pinned").shown())
  Test.expect(window.text("Completed the Deadmines together · 2 h ago").shown())
  window.text("Gunnar").click()
  Test.expect(window.text("Traded").shown())
  window.button("Whisper").click()
  window.button("Add Friend").click()
  window.button("Unpin").click()
  Test.expect(people.heard.join(", ") == "whisper Gunnar-Flamegor, add Gunnar-Flamegor, pin Gunnar false")
  Test.expect(!window.text("Pinned").shown() && window.button("Pin").shown())
  Test.shot("the recent allies: an ally's card with what was done together")
}

test "the allies' filter offers the game's categories here, and asks the game for the allies of those on" {
  Test.mount(nil, PAGE)
  const window = opened(new FakePeople())
  window.text("Recent Allies").click()
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test.expect(Test.page().text("Dungeons").shown() && !Test.page().text("Raiding").shown())
  // PvP switched off: the dungeons alone asked for, and Gunnar did one.
  Test.page().text("PvP").click()
  Test.expect(window.text("Gunnar").shown() && !window.text("Astrid").shown())
  Test.page().text("Dungeons").click()
  Test.expect(!window.text("Gunnar").shown())
  Test.page().text("Reset").click()
  Test.expect(window.text("Gunnar").shown() && window.text("Astrid").shown())
}

test "an offline ally can't be whispered or invited, and the filter hides them" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  window.text("Recent Allies").click()
  window.text("Astrid").click()
  window.button("Whisper").click()
  window.button("Invite").click()
  Test.expect(people.heard.length == 0)
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test.page().window("Dungeons").text("Offline").click()
  // Her card stays; her row goes.
  Test.expect(window.text("Astrid").count() == 1)
}

test "«Guild Management» shows the game's own guild window as it is, until it closes; the next one shown is ours" {
  Test.mount(nil, PAGE)
  const people = new FakePeople()
  const window = opened(mut people)
  const game = Client.CreateFrame("Frame", "CommunitiesFrame", Client.UIParent, nil)
  game.Hide()
  Events.ADDON_LOADED.emit("Blizzard_Communities", false)
  window.text("Guild").click()
  window.button("Guild Management").click()
  Test.expect(!Test.page().window(WINDOW).shown())
  Test.expect(game.IsShown() && game.GetAlpha() == 1)
  game.Hide()
  game.Show()
  Test.expect(fieldSays(Test.page().window(WINDOW), "Raid on Friday"))
}
