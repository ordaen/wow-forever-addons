// SettingRow: one setting's row on a settings page: its label in a 280 px column, its control beside it, 18 px
// apart, both centred on the row. The setting's hint shows in a Tip while the cursor is on the label, never inline.
// A disabled row draws at 45%. Every settings control draws its row with it, so the rows line up. Its unnamed slot
// takes the control.
import { Align } from "$ltml"
import Ordaen from "Ordaen"
import { PX } from "@/units"
import { Tip } from "@/tip"

const LABEL_WIDTH = 280 * PX
const LABEL: Color = Color.hex("#cbb994")

public class SettingRow implements Ordaen.Component {
  state hovered = false
  derived tipShown: Boolean = self.hovered && self.hint != ""
  derived opacity: Number = self.disabled ? 0.45 : 1

  label: Signal<String>
  hint: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    label: Signal<String>,
    hint: Signal<String> = "",
    disabled: Signal<Boolean> = false,
  ) {
    self.label = label
    self.hint = hint
    self.disabled = disabled
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box columns={[LABEL_WIDTH, { fr: 1 }]} gap={18 * PX} yAlign={Align.Center} opacity={self.opacity}>
        <box columns={1} @enter={self.onEnter} @leave={self.onLeave}>
          <text value={self.label} textColor={LABEL} textSize={15 * PX} />
        </box>
        <slot />
        <Tip $if={self.tipShown} title={self.label} text={self.hint} left={LABEL_WIDTH} top={0} />
      </box>
    }
  }
}
