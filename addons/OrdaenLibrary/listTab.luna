// ListTab: an entry in a list of pages (the settings window's modules, a module page's bars): its icon, its name,
// and what its slot holds at its right (a switch). The shade under the cursor; selected, a darker shade, the name
// white and a 3 px light along its left; off, name and icon dimmed. Left-click reports `pick`.
import { Align, Art, Color, Edges, Position, Stated, Track } from "$ltml"
import Ordaen from "Ordaen"
import { PX } from "@/units"

private const INK = $color("#e8dcc4")
private const WHITE = $color("#ffffff")
private const OFF = $color("#7a705f")
private const CLEAR = $color("#00000000")
private const SHADE: Stated<Color> = { default: CLEAR, hover: $color("#00000059") }
private const SELECTED = $color("#00000040")
// An icon that is off: darker.
private const DIM = $color("#999999")
private const LIGHT = $color("#d6a56b")
private const PADDING: Edges = { top: 7 * PX, right: 12 * PX, bottom: 7 * PX, left: 16 * PX }
private const WITH_ICON: Array<Track> = [22 * PX, { fr: 1 }, "auto"]
// An entry without an icon: its name from the left.
private const NO_ICON: Array<Track> = [{ fr: 1 }, "auto"]

public class ListTab implements Ordaen::Component {
  public pick: Event<nil> = $event()

  private hasIcon = $computed((): boolean => self.icon != "")
  private columns = $computed((): Array<Track> => self.hasIcon ? WITH_ICON : NO_ICON)
  private background = $computed((): Color | Stated<Color> => self.selected ? SELECTED : SHADE)
  private color = $computed((): Color => self.selected ? WHITE : self.off ? OFF : INK)
  private tint = $computed((): Color => self.off ? DIM : WHITE)

  $constructor(
    private label: Reactive<string>,
    private selected: Reactive<boolean>,
    // None for an entry without a picture.
    private icon: Reactive<Art> = "",
    private off: Reactive<boolean> = false,
  ) {}

  private mut onClick() { self.pick.emit() }

  public render(): Template {
    return $ltml {
      <box columns={self.columns} gap={10 * PX} padding={PADDING} yAlign={Align::Center}
           background={self.background} @click={self.onClick}>
        <box $if={self.selected} position={Position::Absolute} left={0} top={0} bottom={0} width={3 * PX}
             background={LIGHT} />
        <box $if={self.hasIcon} width={22 * PX} height={22 * PX} background={self.icon} tint={self.tint} />
        <text value={self.label} textColor={self.color} textSize={15 * PX} wrap={false} />
        <box>
          <slot />
        </box>
      </box>
    }
  }
}
