// Zones: where each of a part's items sits, edited by dragging. The zones stand side by side in one bronze-edged
// box, each with its name on top; under them the pool of what isn't placed. Each item is a chip in the zone it sits
// in; a chip dragged into another zone, or into the pool, is placed there. The cursor on a chip shows the item's
// hint.
import { Align, Edges, Line } from "$ltml"
import Ordaen from "Ordaen"
import { Choice } from "@/dropdown"
import { Tip } from "@/tip"
import { PX } from "@/units"

private const DIM = $color("#a3977f")
private const CHIP_TEXT = $color("#f3e1b8")
private const BOX = $color("#2a1e10")
private const BRONZE: Line = { width: 1 * PX, color: $color("#6c5535") }
// A zone after the first: a line on its left.
private const DIVIDER: Line = { width: 1 * PX, color: $color("#3e2f1d"), sides: ["left"] }
private const CHIP = $color("#5a4428")
private const CHIP_EDGE: Line = { width: 1 * PX, color: $color("#1a1306") }
private const CHIP_PAD: Edges = { top: 4 * PX, right: 10 * PX, bottom: 4 * PX, left: 10 * PX }
private const POOL = $color("#00000040")
private const POOL_EDGE: Line = { width: 1 * PX, color: $color("#4a3a24") }

// One of the items placed: what tells it from the others, its name on its chip, and what the cursor on it says.
public struct ZoneItem<K implements unknown> {
  key: K
  label: string
  hint: string | nil
}

// An item's chip: dragged from where it is, it is the one a zone takes when it is let go there.
public class ZoneChip<K implements unknown> implements Ordaen::Component {
  private opacity = $computed((): number => self.pooled ? 0.8 : 1)

  $constructor(
    private item: Reactive<ZoneItem<K>>,
    // The item being dragged, and the one under the cursor: none while there is none.
    private mut dragging: Reactive<K | nil>,
    private mut hinted: Reactive<K | nil>,
    // In the pool: greyed.
    private pooled: Reactive<boolean>,
  ) {}

  private mut onGrab() {
    self.dragging = self.item.key
    self.hinted = nil
  }

  private mut onRelease() { self.dragging = nil }

  private mut onEnter() {
    if (self.dragging == nil) { self.hinted = self.item.key }
  }

  private mut onLeave() { self.hinted = nil }

  public render(): Template {
    return $ltml {
      <box padding={CHIP_PAD} background={CHIP} border={CHIP_EDGE} desaturate={self.pooled} opacity={self.opacity}
           @dragStart={self.onGrab} @dragStop={self.onRelease} @enter={self.onEnter} @leave={self.onLeave}>
        <text value={self.item.label} textColor={CHIP_TEXT} textSize={14 * PX} wrap={false} />
      </box>
    }
  }
}

// One zone, or the pool: its name and the chips of the items that sit in it. What is dragged and let go over it is
// placed in it.
public class ZoneColumn<K implements unknown, Z implements unknown> implements Ordaen::Component {
  // The first zone's chips from the left, the second's in the middle, the third's to the right.
  private align = $computed((): Align => self.alignOf())
  private divider = $computed((): Line | nil => self.index > 1 ? DIVIDER : nil)
  private named = $computed((): boolean => !self.pool)

  $constructor(
    private zone: Reactive<Choice<Z>>,
    // Its place among the zones.
    private index: Reactive<integer>,
    private const items: Array<ZoneItem<K>>,
    // Where each item sits.
    private mut value: Reactive<Map<K, Z>>,
    private mut dragging: Reactive<K | nil>,
    private mut hinted: Reactive<K | nil>,
    // The pool has its name over it, not in it.
    private pool: Reactive<boolean> = false,
  ) {}

  private alignOf(): Align {
    if (self.pool) { return Align::Start }
    if (self.index == 2) { return Align::Center }
    if (self.index == 3) { return Align::End }
    return Align::Start
  }

  private mut onDrop() {
    let key = self.dragging
    if (key != nil && self.value[key] != self.zone.value) { self.value[key] = self.zone.value }
  }

  public render(): Template {
    return $ltml {
      <box columns={1} gap={6 * PX} padding={8 * PX} xAlign={self.align} yAlign={Align::Start} border={self.divider}
           @drop={self.onDrop}>
        <text $if={self.named} value={self.zone.label} textColor={DIM} textSize={12 * PX} />
        <$for={item of self.items}>
          <ZoneChip $if={self.value[item.key] == self.zone.value} item={item} dragging={mut self.dragging}
                    hinted={mut self.hinted} pooled={self.pool} />
        </>
      </box>
    }
  }
}

public class Zones<K implements unknown, Z implements unknown> implements Ordaen::Component {
  private mut dragging: Reactive<K | nil> = $reactive(nil)
  private mut hinted: Reactive<K | nil> = $reactive(nil)
  private hintTitle = $computed((): string => self.hintedItem()?.label ?? "")
  private hintText = $computed((): string => self.hintedItem()?.hint ?? "")
  private hintShown = $computed((): boolean => self.hintText != "")

  $constructor(
    private const items: Array<ZoneItem<K>>,
    // The zones, in order, and the pool: each a place an item can sit in, with its name.
    private const zones: Array<Choice<Z>>,
    private const off: Choice<Z>,
    // Where each item sits: every item has its place, a zone's or the pool's.
    private mut value: Reactive<Map<K, Z>>,
  ) {}

  private hintedItem(): ZoneItem<K> | nil {
    let key = self.hinted
    if (key == nil) { return nil }
    for (item of self.items) {
      if (item.key == key) { return item }
    }
    return nil
  }

  public render(): Template {
    return $ltml {
      <box columns={1} gap={8 * PX}>
        <box columns={self.zones.length} background={BOX} border={BRONZE}>
          <ZoneColumn $for={index, zone of self.zones} zone={zone} index={index} items={self.items}
                      value={mut self.value} dragging={mut self.dragging} hinted={mut self.hinted} />
        </box>
        <text value={self.off.label} textColor={DIM} textSize={13 * PX} />
        <box columns={1} background={POOL} border={POOL_EDGE}>
          <ZoneColumn zone={self.off} index={1} items={self.items} value={mut self.value}
                      dragging={mut self.dragging} hinted={mut self.hinted} pool={true} />
        </box>
        <Tip $if={self.hintShown} title={self.hintTitle} text={self.hintText} left={0} top={0} />
      </box>
    }
  }
}
