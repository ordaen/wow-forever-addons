// ColorPicker: a colour setting's row (SettingRow: its label, its hint, greyed while disabled) with a swatch of the
// colour in a fine bronze edge. Left-click opens the game's colour picker on it; each colour picked there is
// written to the setting, and the picker's Cancel puts back the colour it opened with. Disabled, it takes no click.
import Game from "$game"
import { Line } from "$ltml"
import Ordaen from "Ordaen"
import { SettingRow } from "@/settingRow"
import { PX } from "@/units"

const EDGE: Line = { width: 1 * PX, color: Color.hex("#6c5535") }

public class ColorPicker implements Ordaen.Component {
  // The game's picker as this one opened it: what it reports is for whoever opened it last.
  ticket: Integer = 0
  // The colour when the picker opened.
  before: Color | nil = nil

  label: Signal<String>
  value: mut Signal<Color>
  hint: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    label: Signal<String>,
    // The setting it shows and changes.
    value: mut Signal<Color>,
    hint: Signal<String> = "",
    disabled: Signal<Boolean> = false,
  ) {
    self.label = label
    self.value = value
    self.hint = hint
    self.disabled = disabled
    Game.colorPicker.picked.listen(self.onPicked)
    Game.colorPicker.cancelled.listen(self.onCancelled)
  }

  open(mut self) {
    if (self.disabled) { return }
    self.before = self.value
    self.ticket = Game.colorPicker.open(self.value)
  }

  onPicked(mut self, picked: Game.PickedColor) {
    if (picked.ticket == self.ticket) { self.value = picked.color }
  }

  onCancelled(mut self, ticket: Integer) {
    let before = self.before
    if (ticket == self.ticket && before != nil) { self.value = before }
  }

  public render(self): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <box width={44 * PX} height={22 * PX} border={EDGE} background={self.value} @click={self.open} />
      </SettingRow>
    }
  }
}
