// Dropdown: a setting that is one of several choices, as the bronze plate showing the picked choice in gold with an
// arrow. Left-click opens the menu under it, each choice with its mark (the picked one's gold), the light under the
// cursor. Left-click on a choice picks it and closes the menu; a click anywhere else closes it. Disabled, it doesn't
// open. A choice not built yet (`soon`) is listed dimmed, with «in development» after its name, and takes no click.
import { Align, Art, Edges, Line, Position, Shadow, Stated } from "$ltml"
import Ordaen from "Ordaen"
import Locale from "@/locales"
import { PX } from "@/units"
import { SettingRow } from "@/settingRow"

// One of a dropdown's choices: the value the setting takes, and what the player reads.
public struct Choice<T: Unknown> {
  value: T
  label: String
  soon: Boolean | nil
}

const WIDTH = 240 * PX
const HEIGHT = 34 * PX
const TEXT = 15 * PX
const GOLD: Color = Color.hex("#f0c860")
const WHITE: Color = Color.hex("#ffffff")
const DIM: Color = Color.hex("#ffffff73")
// The design's 700: the same colour one pixel to the right.
const BOLD: Shadow = { color: GOLD, x: 1 * PX, y: 0 }
const FACE_PAD: Edges = { right: 12 * PX, left: 18 * PX }
const ARROW_SHADOW: Shadow = { color: Color.hex("#14141fcc"), x: 1 * PX, y: 1 * PX }
const MENU_BACK: Color = Color.hex("#0a0806f7")
const MENU_EDGE: Line = { width: 1 * PX, color: Color.hex("#6c5535") }
const MENU_PAD: Edges = { top: 6 * PX, bottom: 6 * PX }
const ITEM_PAD: Edges = { top: 5 * PX, right: 14 * PX, bottom: 5 * PX, left: 30 * PX }
const CLEAR: Color = Color.hex("#00000000")
const LIGHT: Stated<Color> = { default: CLEAR, hover: Color.hex("#d6a56b2e") }

// One choice in the open menu.
public class DropdownItem<T: Unknown> implements Ordaen.Component {
  public pick: Event<T> = new Event()

  derived mark: Art = self.value == self.choice.value ? Ordaen.art.ctl.radioOn : Ordaen.art.ctl.radio
  derived text: String = self.choice.soon == true ? self.choice.label + " — " + Locale.SOON : self.choice.label
  derived color: Color = self.choice.soon == true ? DIM : WHITE
  derived light: Color | Stated<Color> = self.choice.soon == true ? CLEAR : LIGHT

  const choice: Choice<T>
  value: Signal<T>
  constructor(
    choice: Choice<T>,
    value: Signal<T>,
  ) {
    self.choice = choice
    self.value = value
  }

  onClick(mut self) {
    if (self.choice.soon != true) { self.pick.emit(self.choice.value) }
  }

  public render(self): Template {
    return $ltml {
      <box padding={ITEM_PAD} background={self.light} @click={self.onClick}>
        <box position={Position.Absolute} left={10 * PX} top={9 * PX} width={11 * PX} height={11 * PX}
             background={self.mark} />
        <text value={self.text} textColor={self.color} textSize={TEXT} />
      </box>
    }
  }
}

public class Dropdown<T: Unknown> implements Ordaen.Component {
  state open = false
  derived shown: String = self.labelOf()

  label: Signal<String>
  value: mut Signal<T>
  const choices: Array<Choice<T>>
  hint: Signal<String>
  disabled: Signal<Boolean>
  constructor(
    label: Signal<String>,
    value: mut Signal<T>,
    choices: Array<Choice<T>>,
    hint: Signal<String> = "",
    disabled: Signal<Boolean> = false,
  ) {
    self.label = label
    self.value = value
    self.choices = choices
    self.hint = hint
    self.disabled = disabled
  }

  labelOf(self): String {
    for (choice of self.choices) {
      if (choice.value == self.value) { return choice.label }
    }
    return ""
  }

  toggle(mut self) {
    if (!self.disabled) { self.open = !self.open }
  }

  close(mut self) { self.open = false }

  onPick(mut self, value: T) {
    self.value = value
    self.open = false
  }

  public render(self): Template {
    return $ltml {
      <SettingRow label={self.label} hint={self.hint} disabled={self.disabled}>
        <box width={WIDTH} height={HEIGHT}>
          <box position={Position.Absolute} left={0} top={0} width={WIDTH} height={HEIGHT} padding={FACE_PAD}
               columns={[{ fr: 1 }, 16 * PX]} gap={10 * PX} yAlign={Align.Center}
               background={Ordaen.art.ctl.button} @click={self.toggle}>
            <text value={self.shown} textColor={GOLD} textSize={TEXT} textShadow={BOLD} wrap={false} />
            <box width={16 * PX} height={16 * PX} background={Ordaen.art.ctl.dropdownArrow} shadow={ARROW_SHADOW} />
          </box>
          <box $if={self.open} position={Position.Absolute} left={0} top={38 * PX} width={WIDTH + 20 * PX}
               zLevel={50} background={MENU_BACK} border={MENU_EDGE} padding={MENU_PAD} columns={1}
               @clickOutside={self.close}>
            <DropdownItem $for={choice of self.choices} choice={choice} value={self.value} @pick={self.onPick} />
          </box>
        </box>
      </SettingRow>
    }
  }
}
