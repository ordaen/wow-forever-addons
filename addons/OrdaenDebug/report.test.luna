import Test from "$test"
import { Errors, noErrors } from "@/errors"
import { ReportPage, report } from "@/report"

const PAGE: Test.Page = { left: 0, top: 0, width: 600, height: 500 }

test "the report holds the game's build, the addons loaded with their versions, and the newest errors first" {
  let errors = new Errors(noErrors(), { client: "1.60.1", build: "70959", interface: 16001, locale: "enUS", core: "1.4.0" })
  _ = errors.add({ message: "Interface/AddOns/OrdaenMap/map.lua:1: first" })
  _ = errors.add({ message: "Interface/AddOns/OrdaenMap/map.lua:2: second", stack: "the stack" })
  const text = report(errors)
  Test.expect(text.contains("Ordaen bug report"))
  Test.expect(text.contains("Game 1.60.1 (build 70959), interface 16001, locale enUS. Ordaen 1.4.0."))
  Test.expect(text.contains("Addons loaded ("))
  Test.expect(text.contains("Errors, newest first (2 of 2):"))
  const second, _ = text.find("2: second")
  const first, _ = text.find("1: first")
  Test.expect(second != nil && first != nil && second < first)
  Test.expect(text.contains("the stack"))
}

test "a report with no error says so" {
  const text = report(new Errors(noErrors(), {}))
  Test.expect(text.contains("No error was caught."))
}

test "the tab counts the errors, and its button makes the report to copy" {
  let errors = new Errors(noErrors(), {})
  _ = errors.add({ message: "boom" })
  const page = new ReportPage(errors)
  Test.mount(page, PAGE)
  Test.flush()
  Test.expect(Test.page().text("Errors this session: 1. Kept from earlier sessions: 0.").shown())
  Test.click(Test.holding("Make the report", nil), nil)
  Test.flush()
  Test.expect(Test.page().text(report(errors)).shown())
}
