// The «Items» tab as the player meets it: every item the characters hold, the most first, each with its total and its
// holders by place, and a search over them. The character being played holds what the game's fakes give; the others
// hold what other sessions left in the module's saved records, read as the module is turned off and on in Ordaen's
// settings (in the same session, so the game's fakes are the module's).
import Client from "$client"
import Game from "$game"
import { Art } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import { Hour, ItemId } from "Ordaen"
import { Character, CharacterId, Kept, Place } from "@/character"
import Locale from "@/locales"

const SCREEN: Test::Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const TABS = "Characters | Items | Cooldowns | Professions"
const LINEN = 2589
const WOOL = 2592
const COPPER = 2840
const LINEN_ICON: Asset = "Interface/Icons/INV_Fabric_Linen_01"

// The window at its «Items» tab: `/alts`, the tab.
function items(): Test::Part {
  (Client::SlashCmdList["ALTS"] ?? panic("/alts is the module's command"))("")
  const window = Test::page().window(Locale::TAB_CHARACTERS)
  window.button(Locale::TAB_ITEMS).click()
  return window
}

// Whether the tab shows this, read whole: each item's total, name and holders, then the tabs. Where it shows something
// else, the test stops and says what.
function shows(expected: string): boolean {
  const said = Test::page().window(Locale::TAB_CHARACTERS).texts().join(" | ")
  if (said != expected) { panic(`the window shows «${said}»`) }
  return true
}

// The tab with an empty search: the table's headings, these rows, the totals under them, the tabs.
function listed(rows: string, count: integer, all: integer): string {
  return `Search items | Item | Bags | Bank | Mail | Auctions | Total | ${rows} | ${count} items, ${all} in all | ${TABS}`
}

// What a place holds, as the game gives it: item, count, item, count.
function counts(pairs: array<integer>): map<integer, integer> {
  const held: map<integer, integer> = mut {}
  for (i of 1..pairs.length step 2) { held[pairs[i] ?? 0] = pairs[i + 1] ?? 0 }
  return held
}

// The game's tooltip of an item: its name, for the items it knows.
function named(id: integer): Game::TooltipData | nil {
  const name = id == LINEN ? "Linen Cloth" : id == WOOL ? "Wool Cloth" : id == COPPER ? "Copper Bar" : nil
  if (name == nil) { return nil }
  return { lines: [{ left: name, kind: 0 }] }
}

// A character of the player's realm and side that holds these in a place.
function holder(name: string, place: Place, pairs: array<integer>): mut Character {
  const held: map<ItemId, integer> = mut {}
  for (id, count of counts(pairs)) { held[ItemId::of(id)] = count }
  const made = Character { name: name, realm: "Stand-in", faction: .Alliance, level: 10, seen: Hour::now(), mailExpires: nil }
  made.held[place] = held
  return made
}

// The characters other sessions recorded, kept as the module's saved records, read as the module is turned off and on.
function recorded(others: array<Character>) {
  const kept = Kept {}
  for (index, character of others) { kept.characters[CharacterId::of("Player-1-" + string::of(index + 1))] = character.clone() }
  Game::saved.store(.Own, "characters", kept)
  Test::open("/ordaen")
  const settings = Test::page().window("Move mode")
  settings.button(Ordaen.art.ctl.switchOn).click()
  settings.button(Ordaen.art.ctl.switchOff).click()
  settings.button(Ordaen.art.ctl.corner.close).click()
}

test "Items is a table of every item held, the most first: its count in each place, its total, and the totals under it" {
  Game::items.tooltip = named
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12, COPPER, 3])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  recorded([holder("Aria", .Bank, [LINEN, 20, WOOL, 5]), holder("Bram", .Mail, [COPPER, 1])])
  _ = items()
  Test::expect(shows(`Search items | Item | Bags | Bank | Mail | Auctions | Total | Linen Cloth | 12 | 20 | — | — | 32 | Wool Cloth | — | 5 | — | — | 5 | Copper Bar | 3 | — | 1 | — | 4 | 3 items, 41 in all | ${TABS}`))
}

test "items held alike are listed by their name" {
  Game::items.tooltip = named
  Game::bags.holdings = (): map<integer, integer> | nil => counts([COPPER, 5, LINEN, 5])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  _ = items()
  Test::expect(shows(`Search items | Item | Bags | Bank | Mail | Auctions | Total | Copper Bar | 5 | — | — | — | 5 | Linen Cloth | 5 | — | — | — | 5 | 2 items, 10 in all | ${TABS}`))
}

test "a search keeps the items whose name holds it, in any case" {
  Game::items.tooltip = named
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12, WOOL, 30, COPPER, 3])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  items().input().type("CLOTH")
  Test::expect(shows(`Item | Bags | Bank | Mail | Auctions | Total | Wool Cloth | 30 | — | — | — | 30 | Linen Cloth | 12 | — | — | — | 12 | 2 items, 42 in all | ${TABS}`))
}

test "a search by an item's number finds it" {
  Game::items.tooltip = named
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12, COPPER, 3])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  items().input().type("2840")
  Test::expect(shows(`Item | Bags | Bank | Mail | Auctions | Total | Copper Bar | 3 | — | — | — | 3 | 1 items, 3 in all | ${TABS}`))
}

test "a search that finds nothing says so" {
  Game::items.tooltip = named
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  items().input().type("iron")
  Test::expect(shows(`Item | Bags | Bank | Mail | Auctions | Total | ${Locale::NOTHING_FOUND} | 0 items, 0 in all | ${TABS}`))
}

test "an item the game has no name for yet is listed by its number" {
  Game::items.tooltip = named
  Game::bags.holdings = (): map<integer, integer> | nil => counts([4306, 2])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  _ = items()
  Test::expect(shows(`Search items | Item | Bags | Bank | Mail | Auctions | Total | #4306 | 2 | — | — | — | 2 | 1 items, 2 in all | ${TABS}`))
}

test "the game is asked an item's name once while the tab shows" {
  const asked: array<integer> = mut []
  Game::items.tooltip = (id: integer): Game::TooltipData | nil => {
    asked.push(id)
    return { lines: [{ left: "Linen Cloth", kind: 0 }] }
  }
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  items().input().type("lin")
  Test::expect(asked.length == 1)
}

test "the filter leaves a place out of its column and of the totals, and an item held only there leaves the table" {
  Game::items.tooltip = named
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  recorded([holder("Aria", .Bank, [LINEN, 20, WOOL, 5])])
  const window = items()
  window.button(Ordaen.art.ctl.tool.filter).click()
  Test::page().text(Locale::PLACE_BANK).click()
  Test::expect(window.text("Linen Cloth").item().texts().join(" | ") == "Linen Cloth | 12 | — | — | — | 12")
  Test::expect(!window.text("Wool Cloth").shown() && window.text("1 items, 12 in all").shown())
}

test "a heading sorts by its column: a place's count the most first, again the least" {
  Game::items.tooltip = named
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12, COPPER, 3])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  recorded([holder("Aria", .Bank, [COPPER, 40])])
  const window = items()
  window.button(Locale::COL_BAGS_HELD).click()
  Test::expect(window.texts().filter(text => text == "Linen Cloth" || text == "Copper Bar").join(", ") == "Linen Cloth, Copper Bar")
  window.button(Locale::COL_BAGS_HELD).click()
  Test::expect(window.texts().filter(text => text == "Linen Cloth" || text == "Copper Bar").join(", ") == "Copper Bar, Linen Cloth")
}

test "the cursor on an item's name says who holds how many, and where" {
  Game::items.tooltip = named
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  recorded([holder("Aria", .Bank, [LINEN, 20])])
  items().text("Linen Cloth").hover()
  Test::expect(Test::page().text("Aria (bank)").shown() && Test::page().text("Player (bags)").shown())
}

test "the cursor on an item's icon shows the game's tooltip of it" {
  Game::items.tooltip = named
  Game::items.icon = (id: integer): Art | nil => LINEN_ICON
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  const window = items()
  _ = Test::requests()
  window.box(LINEN_ICON).hover()
  Test::expect(Test::requests().any(r => r == `Items.show ${LINEN}`))
}

// What the character being played holds, as it plays

test "the bags are read each time they change, and where the game gives no count what was read stays" {
  Game::items.tooltip = named
  Test::mount(nil, SCREEN)
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12, COPPER, 3])
  Game::bags.changed.emit()
  Game::bags.changed.emit()
  _ = items()
  Game::bags.holdings = (): map<integer, integer> | nil => counts([COPPER, 4])
  Game::bags.changed.emit()
  Game::bags.changed.emit()
  Test::expect(shows(listed("Copper Bar | 4 | — | — | — | 4", 1, 4)))
  Game::bags.holdings = (): map<integer, integer> | nil => nil
  Game::bags.changed.emit()
  Test::expect(shows(listed("Copper Bar | 4 | — | — | — | 4", 1, 4)))
}

test "the bank is read as it opens and as it changes, and where the game gives nothing what was read stays" {
  Game::items.tooltip = named
  Test::mount(nil, SCREEN)
  Game::bankObserver.holdings = (): map<integer, integer> | nil => counts([LINEN, 20, WOOL, 5])
  Game::bankObserver.opened.emit()
  _ = items()
  Test::expect(shows(listed("Linen Cloth | — | 20 | — | — | 20 | Wool Cloth | — | 5 | — | — | 5", 2, 25)))
  Game::bankObserver.holdings = (): map<integer, integer> | nil => counts([LINEN, 1])
  Game::bankObserver.changed.emit()
  Test::expect(shows(listed("Linen Cloth | — | 1 | — | — | 1", 1, 1)))
  Game::bankObserver.holdings = (): map<integer, integer> | nil => nil
  Game::bankObserver.changed.emit()
  Test::expect(shows(listed("Linen Cloth | — | 1 | — | — | 1", 1, 1)))
}

test "the inbox is read as it opens and as it changes, and where the game gives nothing what was read stays" {
  Game::items.tooltip = named
  Test::mount(nil, SCREEN)
  Game::mailObserver.holdings = (): map<integer, integer> | nil => counts([LINEN, 3])
  Game::mailObserver.opened.emit()
  _ = items()
  Test::expect(shows(listed("Linen Cloth | — | — | 3 | — | 3", 1, 3)))
  Game::mailObserver.holdings = (): map<integer, integer> | nil => counts([WOOL, 2])
  Game::mailObserver.changed.emit()
  Test::expect(shows(listed("Wool Cloth | — | — | 2 | — | 2", 1, 2)))
  Game::mailObserver.holdings = (): map<integer, integer> | nil => nil
  Game::mailObserver.changed.emit()
  Test::expect(shows(listed("Wool Cloth | — | — | 2 | — | 2", 1, 2)))
}

test "the player's auctions are counted by item, the sold ones left out" {
  Game::items.tooltip = named
  Test::mount(nil, SCREEN)
  Game::ownedAuctions.list = [
    { auction: 1, item: COPPER, quantity: 20, buyout: 5000, sold: false, left: nil },
    { auction: 2, item: COPPER, quantity: 5, buyout: 900, sold: false, left: nil },
    { auction: 3, item: LINEN, quantity: 1, buyout: 100, sold: true, left: nil }
  ]
  _ = items()
  Test::expect(shows(listed("Copper Bar | — | — | — | 25 | 25", 1, 25)))
}

test "an empty list of auctions before the house answers keeps them, and one while it is open empties them" {
  Game::items.tooltip = named
  Test::mount(nil, SCREEN)
  Game::ownedAuctions.list = [{ auction: 1, item: COPPER, quantity: 20, buyout: 5000, sold: false, left: nil }]
  _ = items()
  Game::ownedAuctions.list = []
  Test::expect(shows(listed("Copper Bar | — | — | — | 20 | 20", 1, 20)))
  Game::auctionHouse.open = true
  Game::ownedAuctions.list = [{ auction: 2, item: LINEN, quantity: 1, buyout: nil, sold: false, left: nil }]
  Game::ownedAuctions.list = []
  Test::expect(shows(listed(Locale::NOTHING_FOUND, 0, 0)))
}

test "a character forgotten takes its items from the list" {
  Game::items.tooltip = named
  Test::mount(nil, SCREEN)
  recorded([holder("Aria", .Bank, [LINEN, 20])])
  const window = items()
  window.button(Locale::TAB_CHARACTERS).click()
  window.text("Aria").item().button(Locale::FORGET).click()
  Test::page().window(Locale::FORGET_TITLE).button(Locale::FORGET).click()
  window.button(Locale::TAB_ITEMS).click()
  Test::expect(shows(listed(Locale::NOTHING_FOUND, 0, 0)))
}

test "a search lists what it finds, the most held first" {
  Game::items.tooltip = (id: integer): Game::TooltipData | nil => {
    return { lines: [{ left: id == 4305 ? "Bolt of Cloth" : id == 9000 ? "Apron of Cloth" : "Cloth", kind: 0 }] }
  }
  Game::bags.holdings = (): map<integer, integer> | nil => counts([WOOL, 2, LINEN, 9, 4305, 3, 9000, 4, 2996, 5])
  Game::bags.changed.emit()
  Test::mount(nil, SCREEN)
  items().input().type("cloth")
  Test::expect(shows(
    `Item | Bags | Bank | Mail | Auctions | Total | Cloth | 9 | — | — | — | 9 | Cloth | 5 | — | — | — | 5 | Apron of Cloth | 4 | — | — | — | 4 | Bolt of Cloth | 3 | — | — | — | 3 | Cloth | 2 | — | — | — | 2 | 5 items, 23 in all | ${TABS}`
  ))
}

test "an item in two places loses only the place that changed" {
  Game::items.tooltip = named
  Test::mount(nil, SCREEN)
  Game::bankObserver.holdings = (): map<integer, integer> | nil => counts([LINEN, 20])
  Game::bankObserver.opened.emit()
  Game::bags.holdings = (): map<integer, integer> | nil => counts([LINEN, 12])
  Game::bags.changed.emit()
  _ = items()
  Test::expect(shows(listed("Linen Cloth | 12 | 20 | — | — | 32", 1, 32)))
  Game::bankObserver.holdings = (): map<integer, integer> | nil => counts([WOOL, 1])
  Game::bankObserver.changed.emit()
  Test::expect(shows(listed("Linen Cloth | 12 | — | — | — | 12 | Wool Cloth | — | 1 | — | — | 1", 2, 13)))
}
