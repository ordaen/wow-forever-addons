// The window's look: its size at the player's scale and colours, and how a number of hours reads. A text's size is a
// step of the ladder (`$ltml`'s `TextSize`).
import { PX } from "Ordaen"
import Locale from "@/locales"

public const WIDTH: Number = 1100 * PX
public const HEIGHT: Number = 560 * PX

public const INK: Color = Color.hex("#e8dcc4")
public const DIM: Color = Color.hex("#a3977f")
public const GOLD: Color = Color.hex("#ffd100")
public const RED: Color = Color.hex("#ff4040")
public const GREEN: Color = Color.hex("#40d060")
// A character the playing one can't send to, and one not played for a long time.
public const AWAY: Color = Color.hex("#7a7060")

// How long ago, from a number of hours: under a day in hours, then in days.
public function ago(hours: Integer): String {
  if (hours < 24) { return Locale.AGO_HOURS.format((0).max(hours)) }
  return Locale.AGO_DAYS.format((hours / 24).floor())
}

// How long until, from a number of hours: a day or more in days.
public function until(hours: Integer): String {
  if (hours < 24) { return Locale.IN_HOURS.format((0).max(hours)) }
  return Locale.IN_DAYS.format((hours / 24).floor())
}
