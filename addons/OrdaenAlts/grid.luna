// «Professions»: a table of the characters, a column for each profession any of them has, the skill in each cell; a
// click on a heading sorts by it (a profession's column by the skill, a character without it last), again reverses.
import { Align } from "$ltml"
import { Column, Component, Table, TableCell, TableRow, sortedBefore } from "Ordaen"
import { Character } from "@/character"
import Locale from "@/locales"
import { Records } from "@/records"
import Style from "@/style"

// A profession's cell: the skill, `150 / 300`, or a dash.
public struct Skill {
  text: String
  // The rank it sorts by: -1 for a character without the profession.
  rank: Integer
}

// One character as a row: its name and its skill in each profession, in the columns' order.
public struct SkillLine {
  key: String
  name: String
  skills: Array<Skill>
}

const NONE: Skill = { text: "—", rank: -1 }
// The least a column is wide: a character's name; a profession's heading in either language, and its skill.
const NAME_LEAST = 200dp
const SKILL_LEAST = 170dp

class SkillCell implements Component {
  derived ink: Color = self.skill.rank < 0 ? Style.DIM : Style.INK

  skill: Signal<Skill>
  constructor(skill: Signal<Skill>) { self.skill = skill }

  public render(self): Template {
    return $ltml {
      <TableCell align={Align.Center}>
        <text value={self.skill.text} textColor={self.ink} wrap={.None} />
      </TableCell>
    }
  }
}

class SkillRow implements Component {
  line: Signal<SkillLine>
  constructor(line: Signal<SkillLine>) { self.line = line }

  public render(self): Template {
    return $ltml {
      <TableRow>
        <TableCell> <text value={self.line.name} textColor={Style.INK} wrap={.Cut} /> </TableCell>
        <SkillCell $for={skill of self.line.skills} skill={skill} />
      </TableRow>
    }
  }
}

// Whether `a` comes before `b` by a column (`sortedBefore`): by name, then realm; a profession's skill the highest first.
function lineBefore(a: SkillLine, b: SkillLine, column: Integer): Boolean {
  if (column <= 1) { return a.name < b.name || (a.name == b.name && a.key < b.key) }
  return rankAt(a, column) > rankAt(b, column)
}

// A line's skill in a column's profession; -1 where it hasn't the profession.
function rankAt(line: SkillLine, column: Integer): Integer {
  return line.skills[column - 1]?.rank ?? -1
}

// A line without the column's profession: last, either way.
function skillMissing(line: SkillLine, column: Integer): Boolean {
  return column > 1 && rankAt(line, column) < 0
}

public class Grid implements Component {
  state sorts: Array<Integer> = [1]
  derived names: Array<String> = self.namesOf()
  derived columns: Array<Column> = self.columnsOf()
  derived lines: Array<SkillLine> = self.linesOf()
  derived ordered: Array<SkillLine> = self.order()

  const records: Records
  touched: Signal<Integer>
  constructor(records: Records, touched: Signal<Integer>) {
    self.records = records
    self.touched = touched
  }

  // The professions any character has, by name.
  namesOf(self): Array<String> {
    // Read again when any record changed.
    _ = self.touched
    const seen: Map<String, Boolean> = {}
    const list: Array<String> = []
    for (_, character of self.records.characters) {
      for (known of character.professions) {
        // A profession whose recipes were read before the game listed it has no name yet: no column.
        if (known.name != "" && seen[known.name] != true) {
          seen[known.name] = true
          list.push(known.name)
        }
      }
    }
    list.sort((a, b) => a < b)
    return list
  }

  // The name's column, then a profession's each, sharing the width beyond their least.
  columnsOf(self): Array<Column> {
    const list: Array<Column> = [{ title: Locale.COL_NAME, width: { fr: 1, min: NAME_LEAST }, sortable: true }]
    for (name of self.names) { list.push({ title: name, width: { fr: 1, min: SKILL_LEAST }, align: Align.Center, sortable: true }) }
    return list
  }

  // Each character a line, by name, then by realm where two share a name.
  linesOf(self): Array<SkillLine> {
    const characters: Array<Character> = []
    for (_, character of self.records.characters) { characters.push(character) }
    characters.sort((a, b) => a.name < b.name || (a.name == b.name && a.realm < b.realm))
    const list: Array<SkillLine> = []
    for (character of characters) {
      const skills: Array<Skill> = []
      for (name of self.names) {
        let skill = NONE
        for (known of character.professions) {
          if (known.name == name) { skill = { text: "%d / %d".format(known.rank, known.max), rank: known.rank } }
        }
        skills.push(skill)
      }
      list.push({ key: character.name + "-" + character.realm, name: character.name, skills: skills })
    }
    return list
  }

  // The lines by what the table is sorted by: the name, or a profession's skill (without it, last either way).
  order(self): Array<SkillLine> {
    const list: Array<SkillLine> = []
    for (line of self.lines) { list.push(line) }
    const sorts = self.sorts
    if (sorts.length > 0) { list.sort((a, b) => sortedBefore(a, b, sorts, lineBefore, skillMissing)) }
    return list
  }

  public render(self): Template {
    return $ltml {
      <Table columns={self.columns} sorts={mut self.sorts}>
        <SkillRow $for={line of self.ordered} $key={line.key} line={line} />
      </Table>
    }
  }
}
