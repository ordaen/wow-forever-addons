// «Professions»: the characters down the side, the professions across, the skill in each cell.
import { Align, Track } from "$ltml"
import { Component, ScrolledList } from "Ordaen"
import { Character } from "@/character"
import Locale from "@/locales"
import { Records } from "@/records"
import Style from "@/style"

// One cell: its text, its colour (a heading's gold, a profession a character lacks dim) and where it stands in its
// column: a character's name at the start, a profession and a skill in the middle.
public struct Cell {
  text: String
  color: Color
  align: Align
}

public class Grid implements Component {
  derived names: Array<String> = self.namesOf()
  derived tracks: Array<Track> = self.tracksOf()
  derived cells: Array<Cell> = self.cellsOf()

  const records: Records
  touched: Signal<Integer>
  constructor(records: Records, touched: Signal<Integer>) {
    self.records = records
    self.touched = touched
  }

  // The professions any character has, by name.
  namesOf(self): Array<String> {
    // Read again when any record changed.
    _ = self.touched
    const seen: Map<String, Boolean> = {}
    const list: Array<String> = []
    for (_, character of self.records.characters) {
      for (known of character.professions) {
        // A profession whose recipes were read before the game listed it has no name yet: no column.
        if (known.name != "" && seen[known.name] != true) {
          seen[known.name] = true
          list.push(known.name)
        }
      }
    }
    list.sort((a, b) => a < b)
    return list
  }

  tracksOf(self): Array<Track> {
    const list: Array<Track> = [{ fr: 2 }]
    for (index of 1..self.names.length) { list.push({ fr: 1 }) }
    return list
  }

  // A heading row, then a row for each character: its skill in each profession, `150 / 300`, or a dash.
  cellsOf(self): Array<Cell> {
    const list: Array<Cell> = [{ text: Locale.COL_NAME, color: Style.GOLD, align: Align.Start }]
    for (name of self.names) { list.push({ text: name, color: Style.GOLD, align: Align.Center }) }
    // Each character its own row, by name, then by realm where two share a name.
    const characters: Array<Character> = []
    for (_, character of self.records.characters) { characters.push(character) }
    characters.sort((a, b) => a.name < b.name || (a.name == b.name && a.realm < b.realm))
    for (character of characters) {
      list.push({ text: character.name, color: Style.INK, align: Align.Start })
      for (name of self.names) {
        let text = "—"
        for (known of character.professions) {
          if (known.name == name) { text = "%d / %d".format(known.rank, known.max) }
        }
        list.push({ text: text, color: text == "—" ? Style.DIM : Style.INK, align: Align.Center })
      }
    }
    return list
  }

  public render(self): Template {
    return $ltml {
      <ScrolledList columns={self.tracks} gap={3sp}>
        <box $for={cell of self.cells} $key={cell} xAlign={cell.align}>
          <text value={cell.text} textColor={cell.color} wrap={.None} />
        </box>
      </ScrolledList>
    }
  }
}
