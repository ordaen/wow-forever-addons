// What other modules read of the records, as they read it: who knows a recipe, who holds an item, whom the character
// being played can send to, and the revision that moves when those answers may have changed; and the bounds the
// records keep. The character being played is recorded through the game's fakes; the others are what other sessions
// left in the module's saved records, read as the module is turned off and on in Ordaen's settings.
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import { Hour, ItemId } from "Ordaen"
import root Alts from "OrdaenAlts"
import { Character, CharacterId, Kept, Known, Place, RecipeId } from "@/character"
import Locale from "@/locales"

// The open profession's recipes as the game's side reads them: these ids, each learned.
function learned(ids: array<integer>): array<Game::Recipe> {
  return ids.map(id => Game::Recipe {
    id: id, name: "", icon: "Interface/Icons/INV_Misc_Note_01", categoryID: 0, learned: true, difficulty: Game::Difficulty::Usually, craftable: 0
  })
}

const SCREEN: Test::Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }
const PLAYER = "Player-1-00000001"
const SMITHING = 164
const START = 1577836800 + 1000 * 3600

// What a place holds, as the game gives it: item, count, item, count.
function counts(pairs: array<integer>): map<integer, integer> {
  const held: map<integer, integer> = mut {}
  for (i of 1..pairs.length step 2) { held[pairs[i] ?? 0] = pairs[i + 1] ?? 0 }
  return held
}

// The characters other sessions recorded, by their GUIDs, kept as the module's saved records; the module turned off
// and on in Ordaen's settings reads them.
function recorded(guids: array<string>, characters: array<Character>) {
  const kept = Kept {}
  for (index, character of characters) { kept.characters[CharacterId::of(guids[index] ?? "")] = character.clone() }
  Game::saved.store(.Own, "characters", kept)
  Test::open("/ordaen")
  const settings = Test::page().window("Move mode")
  settings.button(Ordaen.art.ctl.switchOn).click()
  settings.button(Ordaen.art.ctl.switchOff).click()
  settings.button(Ordaen.art.ctl.corner.close).click()
}

// A smith of a realm and side who knows these recipes.
function smith(name: string, realm: string, faction: string, recipes: array<integer>): mut Character {
  const known = Known { skillLine: SMITHING, name: "Blacksmithing", rank: 300, max: 300 }
  for (id of recipes) { known.recipes.push(RecipeId::of(id)) }
  const made = Character {
    name: name, realm: realm, faction: faction == "Horde" ? .Horde : .Alliance, level: 60, seen: Hour::now(), mailExpires: nil
  }
  made.professions.push(known)
  return made
}

// The window, by its first tab.
function window(): Test::Part {
  return Test::page().window(Locale::TAB_CHARACTERS)
}

test "a recipe the character knows is answered with it, in reach, and the hour it is ready where it has a cooldown" {
  Game::clock.server = START
  Test::mount(nil, SCREEN)
  Game::tradeSkill.recipes = learned([2663, 2662])
  Game::recipeReader.cooldown = (recipe: integer): integer | nil => recipe == 2663 ? 7200 : nil
  const before = Alts.revision
  Game::tradeSkill.open = SMITHING
  Test::flush()
  Test::expect(Alts.revision > before)
  const cooling = Alts.knowers(RecipeId::of(2663))
  Test::expect(cooling.length == 1 && cooling[1]?.who == Alts.current && cooling[1]?.reachable == true)
  Test::expect(cooling[1]?.ready == Hour::now() + 2)
  const ready = Alts.knowers(RecipeId::of(2662))
  Test::expect(ready.length == 1 && ready[1]?.ready == nil)
  Test::expect(Alts.knowers(RecipeId::of(9999)).length == 0)
}

test "a character of another realm or side knows its recipes out of reach, and can't be sent to" {
  Test::mount(nil, SCREEN)
  recorded(
    ["Player-1-2", "Player-2-3", "Player-1-4"],
    [smith("Aria", "Stand-in", "Alliance", [2663]), smith("Regy", "Elsewhere", "Alliance", [2663]), smith("Horda", "Stand-in", "Horde", [2663])]
  )
  const reach: map<string, boolean> = mut {}
  for (knower of Alts.knowers(RecipeId::of(2663))) { reach[Alts.characters[knower.who]?.name ?? ""] = knower.reachable }
  Test::expect(reach["Aria"] == true && reach["Regy"] == false && reach["Horda"] == false)
  Test::expect(Alts.reaches(CharacterId::of("Player-1-2")) && Alts.reaches(Alts.current))
  Test::expect(!Alts.reaches(CharacterId::of("Player-2-3")) && !Alts.reaches(CharacterId::of("Player-1-4")))
  Test::expect(!Alts.reaches(CharacterId::of("Player-9-9")))
}

test "a recipe learned while its profession is open is known at once, and once" {
  Test::mount(nil, SCREEN)
  Game::tradeSkill.recipes = learned([2663])
  Game::tradeSkill.open = SMITHING
  Test::flush()
  const before = Alts.revision
  Game::tradeSkill.learned.emit(3320)
  Test::expect(Alts.knowers(RecipeId::of(3320)).length == 1 && Alts.revision > before)
  const after = Alts.revision
  Game::tradeSkill.learned.emit(3320)
  Test::expect(Alts.knowers(RecipeId::of(3320)).length == 1 && Alts.revision == after)
}

test "a recipe learned with no profession open, or of one never read, waits for the profession" {
  Test::mount(nil, SCREEN)
  Game::tradeSkill.learned.emit(3320)
  Test::expect(Alts.knowers(RecipeId::of(3320)).length == 0)
  Game::tradeSkill.recipes = []
  Game::tradeSkill.open = SMITHING
  Test::flush()
  Game::tradeSkill.learned.emit(3320)
  Test::expect(Alts.knowers(RecipeId::of(3320)).length == 0)
}

test "an item held is answered with each holder, how many and where" {
  Test::mount(nil, SCREEN)
  Game::bags.holdings = (): map<integer, integer> | nil => counts([2589, 12])
  Game::bags.changed.emit()
  Game::bankObserver.holdings = (): map<integer, integer> | nil => counts([2589, 20])
  Game::bankObserver.opened.emit()
  const where: map<string, integer> = mut {}
  for (held of Alts.holders(ItemId::of(2589))) {
    Test::expect(held.who == Alts.current)
    where[held.place == Place::Bags ? "bags" : held.place == Place::Bank ? "bank" : "?"] = held.count
  }
  Test::expect(where["bags"] == 12 && where["bank"] == 20 && Alts.holders(ItemId::of(2590)).length == 0)
}

test "a reading that changes nothing moves no revision; money moves none either" {
  Test::mount(nil, SCREEN)
  Game::bankObserver.holdings = (): map<integer, integer> | nil => counts([2589, 20])
  Game::bankObserver.opened.emit()
  const before = Alts.revision
  Game::bankObserver.changed.emit()
  Game::money.amount = 777
  Game::player.level = 12
  Test::expect(Alts.revision == before)
  Game::bankObserver.holdings = (): map<integer, integer> | nil => counts([2589, 21])
  Game::bankObserver.changed.emit()
  Test::expect(Alts.revision > before)
}

test "the professions read again alike move no revision; one more moves it" {
  Test::mount(nil, SCREEN)
  Game::professions.list = [{ skillLine: SMITHING, name: "Blacksmithing", icon: "x", rank: 150, max: 300, kind: .Crafting }]
  Test::flush()
  const before = Alts.revision
  Game::professions.list = [{ skillLine: SMITHING, name: "Blacksmithing", icon: "x", rank: 151, max: 300, kind: .Crafting }]
  Test::flush()
  Test::expect(Alts.revision == before)
  Game::professions.list = [
    { skillLine: SMITHING, name: "Blacksmithing", icon: "x", rank: 151, max: 300, kind: .Crafting },
    { skillLine: 186, name: "Mining", icon: "x", rank: 1, max: 75, kind: .Gathering }
  ]
  Test::flush()
  Test::expect(Alts.revision > before)
}

test "a profession read again with the same recipes moves no revision" {
  Test::mount(nil, SCREEN)
  Game::tradeSkill.recipes = learned([2663])
  Game::tradeSkill.open = SMITHING
  Test::flush()
  const before = Alts.revision
  Game::tradeSkill.open = nil
  Test::flush()
  Game::tradeSkill.open = SMITHING
  Test::flush()
  Test::expect(Alts.revision == before)
}

test "the bags read again with nothing changed tell the window nothing" {
  Game::bags.holdings = (): map<integer, integer> | nil => counts([2589, 12])
  Test::mount(nil, SCREEN)
  Game::bags.changed.emit()
  Test::open("/alts")
  Test::expect(window().shown() && Test::calls(() => { Game::bags.changed.emit() }) == "")
}

test "past forty characters the one played longest ago is dropped, never the one being played" {
  Game::clock.server = START
  const guids: array<string> = mut []
  const others: array<Character> = mut []
  for (i of 1..40) {
    guids.push("Player-1-" + string::of(100 + i))
    others.push(Character { name: "Alt " + string::of(i), realm: "Stand-in", faction: .Alliance, seen: Hour::fromNow((i - 1000) * 3600), mailExpires: nil })
  }
  Test::mount(nil, SCREEN)
  recorded(guids, others)
  Test::expect(Alts.characters[CharacterId::of("Player-1-101")] == nil)
  Test::expect(Alts.characters[CharacterId::of("Player-1-102")] != nil && Alts.characters[Alts.current] != nil)
  let count = 0
  for (id, _ of Alts.characters) { count += 1 }
  Test::expect(count == 40)
}

test "one fewer than the most characters drops none" {
  const guids: array<string> = mut []
  const others: array<Character> = mut []
  for (i of 1..39) {
    guids.push("Player-1-" + string::of(100 + i))
    others.push(Character { name: "Alt " + string::of(i), seen: Hour::fromNow((i - 1000) * 3600), mailExpires: nil })
  }
  Test::mount(nil, SCREEN)
  recorded(guids, others)
  Test::expect(Alts.characters[CharacterId::of("Player-1-101")] != nil)
}

test "a reading past the most recipes or kinds of items is refused, and says so" {
  Test::mount(nil, SCREEN)
  const recipes: array<integer> = mut []
  for (i of 1..1501) { recipes.push(i) }
  Game::tradeSkill.recipes = learned(recipes)
  Game::tradeSkill.open = SMITHING
  Test::flush()
  const items: map<integer, integer> = mut {}
  for (i of 1..1001) { items[i] = 1 }
  Game::bags.holdings = (): map<integer, integer> | nil => items
  Game::bags.changed.emit()
  Test::expect(Alts.knowers(RecipeId::of(1)).length == 0 && Alts.holders(ItemId::of(1)).length == 0)
  const heard = Test::errors()
  Test::expect(heard.length == 2)
  Test::expect(heard.any(e => e.contains("a profession of 1501 recipes is more than the 1500 kept")))
  Test::expect(heard.any(e => e.contains("a place of 1001 kinds of items is more than the 1000 kept")))
}

test "the most recipes and kinds of items are taken" {
  Test::mount(nil, SCREEN)
  const recipes: array<integer> = mut []
  for (i of 1..1500) { recipes.push(i) }
  Game::tradeSkill.recipes = learned(recipes)
  Game::tradeSkill.open = SMITHING
  Test::flush()
  const items: map<integer, integer> = mut {}
  for (i of 1..1000) { items[i] = 1 }
  Game::bags.holdings = (): map<integer, integer> | nil => items
  Game::bags.changed.emit()
  Test::expect(Alts.knowers(RecipeId::of(1)).length == 1 && Alts.holders(ItemId::of(1)).length == 1)
}

test "the character being played can't be forgotten; another is, once, and its recipes go with it" {
  Test::mount(nil, SCREEN)
  recorded(["Player-1-2"], [smith("Aria", "Stand-in", "Alliance", [555])])
  Test::expect(!Alts.forget(Alts.current) && Alts.characters[Alts.current] != nil)
  Test::expect(Alts.knowers(RecipeId::of(555)).length == 1)
  const before = Alts.revision
  Test::expect(Alts.forget(CharacterId::of("Player-1-2")) && Alts.revision > before)
  Test::expect(Alts.knowers(RecipeId::of(555)).length == 0 && !Alts.forget(CharacterId::of("Player-1-2")))
}

test "the saved size of twenty characters with three hundred recipes and a hundred and fifty items each" {
  const kept = Kept {}
  for (i of 1..20) {
    const known = Known { skillLine: SMITHING, name: "Blacksmithing", rank: 300, max: 300 }
    for (r of 1..300) { known.recipes.push(RecipeId::of(2000 + r * 7)) }
    const items: map<ItemId, integer> = mut {}
    for (n of 1..150) { items[ItemId::of(2000 + n * 13)] = n }
    const character = Character {
      name: "Regy Ironsight", realm: "CAMWOW EU5 Realm 4 PvP", faction: .Horde, level: 60, seen: Hour::now(), mailExpires: nil
    }
    character.professions.push(known)
    character.held[Place::Bank] = items
    character.read[Place::Bank] = Hour::now()
    kept.characters[CharacterId::of("Player-6946-" + string::of(100000 + i))] = character
  }
  const packed = Game::encoding.serialize(kept) ?? throw Error { message: "plain data packs" }
  Test::expect(packed.length < 40000)
}

test "a profession dropped for another takes its recipes from those known" {
  Test::mount(nil, SCREEN)
  Game::professions.list = [{ skillLine: SMITHING, name: "Blacksmithing", icon: "x", rank: 150, max: 300, kind: .Crafting }]
  Game::tradeSkill.recipes = learned([2663])
  Game::tradeSkill.open = SMITHING
  Test::flush()
  Test::expect(Alts.knowers(RecipeId::of(2663)).length == 1)
  const before = Alts.revision
  Game::professions.list = [{ skillLine: 186, name: "Mining", icon: "x", rank: 1, max: 75, kind: .Gathering }]
  Test::flush()
  Test::expect(Alts.knowers(RecipeId::of(2663)).length == 0 && Alts.revision > before)
}

test "the character played again on another realm knows its recipes in reach" {
  Test::mount(nil, SCREEN)
  recorded([PLAYER], [smith("Player", "Elsewhere", "Horde", [2663])])
  Test::expect(Alts.knowers(RecipeId::of(2663))[1]?.reachable == true)
}

test "a recipe learned past the most a profession keeps is left out" {
  Test::mount(nil, SCREEN)
  const recipes: array<integer> = mut []
  for (i of 1..1500) { recipes.push(i) }
  Game::tradeSkill.recipes = learned(recipes)
  Game::tradeSkill.open = SMITHING
  Test::flush()
  Game::tradeSkill.learned.emit(9999)
  Test::flush()
  Test::expect(Alts.knowers(RecipeId::of(1500)).length == 1 && Alts.knowers(RecipeId::of(9999)).length == 0)
}
