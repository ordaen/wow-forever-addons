// A window with two tabs over a page, for the run tests: what a module with a window of its own does, its footer on
// the window's bottom line (a dim note at its left, «Save» at its right).
import { Align, Track } from "$ltml"
import { Module, Placing, PushButton, SettingsPage, space, Window, WindowTabSpec } from "Ordaen"

const DIM: Color = Color.hex("#a3977f")
const FOOT: Array<Track> = [{ fr: 1 }, "auto"]

public class Windowed implements Module {
  public const title: String = "Windowed"
  public const pages: Array<SettingsPage> = []

  state tabs: Array<WindowTabSpec> = [
    { title: "Professions", desc: "Tailoring 75", icon: "Interface/Icons/Trade_Tailoring" },
    { title: "Recipes" },
  ]
  state tab = 1
  state placing: Placing = { x: 0, y: 0, width: 400, height: 300 }
  state open = true
  // How many times the window's settings button was clicked, and its «Save».
  state settingsOpened = 0
  state saved = 0
  derived body: String = self.tab == 1 ? "the first tab's page" : "the second tab's page"
  derived note: String = "saved %d times".format(self.saved)
  const footer: Template = $ltml {
    <box columns={FOOT} gap={space(.Group)} yAlign={Align.Center}>
      <text value={self.note} textSize={.Secondary} textColor={DIM} />
      <PushButton label={"Save"} width={100} @click={self.onSave} />
    </box>
  }

  onClose(mut self) { self.open = false }
  onSettings(mut self) { self.settingsOpened += 1 }
  onSave(mut self) { self.saved += 1 }

  public render(self): Template {
    return $ltml {
      <box padding={4}>
        <text value={"a page under the window"} />
        <Window keep={"windowed"} $if={self.open} tabs={self.tabs} selected={mut self.tab} placing={mut self.placing}
                maxWidth={600} withSettings={true} footer={self.footer} @close={self.onClose}
                @settings={self.onSettings}>
          <box>
            <text value={self.body} />
          </box>
        </Window>
      </box>
    }
  }
}
