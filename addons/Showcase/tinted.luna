// A page with the library's ColorPicker, for the run tests: two colours of one struct in a cell, and a row that is
// disabled.
import { ColorPicker, Component, space } from "Ordaen"

public struct Tints {
  frame: Color
  text: Color
}

public class Tinted implements Component {
  state tints: mut Tints = { frame: Color.hex("#804020"), text: Color.hex("#f3e1b8") }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={space(.Item)}>
        <ColorPicker label={"The frame"} hint={"Its metal."} value={mut self.tints.frame} />
        <ColorPicker label={"The text"} value={mut self.tints.text} />
        <ColorPicker label={"Greyed"} value={mut self.tints.text} disabled={true} />
      </box>
    }
  }
}
