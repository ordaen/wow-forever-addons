// A page with the library's ColorPicker, for the run tests: two colours of one struct in a cell, and a row that is
// disabled.
import { Color } from "$ltml"
import Ordaen from "Ordaen"
import { ColorPicker } from "OrdaenLibrary"

public struct Tints {
  frame: Color
  text: Color
}

public class Tinted implements Ordaen::Component {
  private mut tints: Reactive<Tints> = $reactive({ frame: $color("#804020"), text: $color("#f3e1b8") })

  public render(): Template {
    return $ltml {
      <box columns={1} gap={8}>
        <ColorPicker label={"The frame"} hint={"Its metal."} value={mut self.tints.frame} />
        <ColorPicker label={"The text"} value={mut self.tints.text} />
        <ColorPicker label={"Greyed"} value={mut self.tints.text} disabled={true} />
      </box>
    }
  }
}
