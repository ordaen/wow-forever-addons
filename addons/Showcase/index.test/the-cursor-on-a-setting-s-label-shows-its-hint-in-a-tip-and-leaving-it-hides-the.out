      box 0,129.67 700x25 opacity=0.45
        box 0,134.67 233.33x15 @enter @leave
          text 0,134.67 233.33x15 "Its name" #cbb994
        box 248.33,129.67 250x25 #0d0a08 input "" @change
      text 0,166.33 700x0 "" #ffffff
      box 0,178 31.67x16.67 Interface\AddOns\Ordaen\media\ctl-switch-track @click
