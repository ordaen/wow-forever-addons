      box 0,61.33 700x16.67 opacity=1
        box 0,62.17 233.33x15 @enter @leave
          text 0,62.17 233.33x15 "Button drawer" #cbb994
        box 248.33,61.33 31.67x16.67 Interface\AddOns\Ordaen\media\ctl-switch-track @click
