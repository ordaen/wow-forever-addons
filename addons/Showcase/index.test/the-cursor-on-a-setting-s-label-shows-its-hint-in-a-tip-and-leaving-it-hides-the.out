          text 253.58,81.58 235.67x18 "Button drawer" #ffffff
          text 253.58,101.25 235.67x14 "Other addons' buttons in one place." #cbb994
      box 0,89.67 700x28.33 opacity=0.45
        box 0,96.33 233.33x15 @enter @leave
          text 0,96.33 233.33x15 "Hide the map" #cbb994
        box 248.33,89.67 200x28.33
          box 248.33,89.67 200x28.33 absolute Interface\AddOns\Ordaen\media\button @click
            text 263.33,96.33 153.33x15 "Never" #f0c860
