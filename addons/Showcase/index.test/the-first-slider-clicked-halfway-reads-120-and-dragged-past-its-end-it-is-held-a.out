      box 121.94,0.83 65.56x1.67 absolute #00000000
      text 133.61,6.67 42.22x15.6 "Market" #a3977f
  box 0,33.93 700x132.27
    box 0,33.93 700x132.27
      box 0,33.93 700x15.6
        text 0,33.93 22.22x15.6 "Map" #e8c35a
        box 30.56,41.32 669.44x0.83 Interface\AddOns\Ordaen\media\ctl-rule
      box 0,61.2 700x18.33 opacity=1
        box 0,62.57 233.33x15.6 @enter @leave
          text 0,62.57 233.33x15.6 "Show the zone" #cbb994
        box 248.33,61.2 18.33x18.33 Interface\AddOns\Ordaen\media\ctl-check row 0 of 4 @click
          box 248.33,61.2 18.33x18.33 absolute Interface\AddOns\Ordaen\media\ctl-check row 2 of 4 opacity=1
      box 0,91.2 18.33x18.33 Interface\AddOns\Ordaen\media\ctl-check row 0 of 4 @click
        box 0,91.2 18.33x18.33 absolute Interface\AddOns\Ordaen\media\ctl-check row 2 of 4 opacity=1
      box 0,121.2 700x16.67 opacity=1
        box 0,121.73 233.33x15.6 @enter @leave
          text 0,121.73 233.33x15.6 "Size" #cbb994
        box 248.33,121.2 451.67x16.67
          box 248.33,121.2 200x16.67 @click @drag @dragStart @key
            box 248.33,126.2 200x6.67 absolute Interface\AddOns\Ordaen\media\ctl-slider row 0 of 4
            box 249.17,127.03 99.17x5 absolute Interface\AddOns\Ordaen\media\ctl-slider row 1 of 4
            box 341.67,119.53 13.33x26.67 absolute Interface\AddOns\Ordaen\media\ctl-slider-knob
          text 458.33,121.73 28.89x15.6 "120%" #ffffff
      box 0,149.53 700x16.67 opacity=1
        box 0,150.07 233.33x15.6 @enter @leave
          text 0,150.07 233.33x15.6 "Columns" #cbb994
        box 248.33,149.53 451.67x16.67
          box 248.33,149.53 200x16.67 @click @drag @dragStart @key
            box 248.33,154.53 200x6.67 absolute Interface\AddOns\Ordaen\media\ctl-slider row 0 of 4
            box 249.17,155.37 39.67x5 absolute Interface\AddOns\Ordaen\media\ctl-slider row 1 of 4
            box 281.67,147.87 13.33x26.67 absolute Interface\AddOns\Ordaen\media\ctl-slider-knob
          text 458.33,150.07 8.89x15.6 "4" #ffffff
  box 0,172.87 700x15.6 @enter @leave
    text 0,172.87 700x15.6 "zone shown" #ffffff
  box 0,195.13 120x28.33 Interface\AddOns\Ordaen\media\button row 0 of 8 @click @enter @leave
    box 0,195.13 120x28.33 absolute
      text 45.56,201.5 28.89x15.6 "Save" #ffd100 centred
  box 0,230.13 120x28.33 Interface\AddOns\Ordaen\media\button row 2 of 8 @click @enter @leave
