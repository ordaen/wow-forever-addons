// A page that uses every control of the library, for the run tests: what a settings page of a real addon does.
import { ButtonPlate, Checkbox, Choice, Dialog, Dropdown, Module, NumberInput, PushButton, Section, SettingsPage, SettingsTab, Switch, Tabs, TextBox, TextField, Tick, Tip, Toggle, Unit } from "Ordaen"
public import { Arranged } from "@/arranged"
public import { Market, Sale, Worth } from "@/market"
public import { Tinted } from "@/tinted"
public import { Windowed } from "@/windowed"

const TABS: array<string> = ["Map", "Drawer", "Market"]

public enum Hide { Never = "never", Combat = "combat", Transport = "transport" }

const HIDES: array<Choice<Hide>> = [
  { value: Hide::Never, label: "Never" },
  { value: Hide::Combat, label: "In combat" },
  { value: Hide::Transport, label: "On a mount", soon: true }
]

public struct Choices {
  showZone: boolean
  scale: number
  columns: integer
  drawer: boolean
  hide: Hide
  name: string
  // What the drawer's export box holds.
  exported: string
}

// A module's page, made by the tests and added to Ordaen's modules there: in the game nothing makes it (the
// addon has no root, so a build linked into the game leaves it out).
public class Showcase implements Module {
  public const title: string = "Showcase"
  public const pages: array<SettingsPage> = []

  state choices: mut Choices = { showZone: true, scale: 1, columns: 4, drawer: false, hide: Hide::Never, name: "",
    exported: "Ordaen:1:drawer\nhide=never" }
  state saved = 0
  state hint = false
  state tab = 1
  derived onMap: boolean = self.tab == 1
  derived onDrawer: boolean = self.tab == 2
  derived onMarket: boolean = self.tab == 3
  derived summary: string = self.describe()

  describe(): string {
    return self.choices.showZone ? "zone shown" : "zone hidden"
  }

  state asking = false

  mut onSave() { self.saved += 1 }
  mut onReset() { self.asking = true }
  mut onKeep() { self.asking = false }
  mut onDiscard() {
    self.saved = 0
    self.asking = false
  }
  mut onEnter() { self.hint = true }
  mut onLeave() { self.hint = false }

  public render(): Template {
    return $ltml {
      <box columns={1} gap={3sp}>
        <Tabs tabs={TABS} selected={mut self.tab} />
        <SettingsTab title={"Map"} shown={self.onMap}>
          <Section title={"Map"}>
            <Checkbox label={"Show the zone"} value={mut self.choices.showZone} />
            <Tick value={mut self.choices.showZone} />
            <NumberInput label={"Size"} value={mut self.choices.scale} least={0.8} most={1.6} step={0.05} unit={Unit::Percent} />
            <NumberInput label={"Columns"} value={mut self.choices.columns} least={2} most={12} disabled={!self.choices.showZone} />
          </Section>
        </SettingsTab>
        <SettingsTab title={"Drawer"} shown={self.onDrawer}>
          <Section title={"Drawer"}>
            <Switch label={"Button drawer"} hint={"Other addons' buttons in one place."} value={mut self.choices.drawer} />
            <Dropdown label={"Hide the map"} value={mut self.choices.hide} choices={HIDES} disabled={!self.choices.drawer} />
            <TextField label={"Its name"} hint={"Shown over the drawer."} value={mut self.choices.name} maxLength={12}
                       disabled={!self.choices.drawer} />
            <text value={self.choices.name} />
            <Toggle value={mut self.choices.drawer} />
          </Section>
          <Section title={"Export"}>
            <TextBox value={mut self.choices.exported} height={60ui} />
          </Section>
        </SettingsTab>
        <SettingsTab title={"Market"} shown={self.onMarket}>
          <Market />
        </SettingsTab>
        // The summary hears the cursor, not the page: the page draws nothing between its controls, where a click
        // goes on to what shows under it.
        <box @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
          <text value={self.summary} />
        </box>
        <PushButton label={"Save"} width={120ui} @click={self.onSave} />
        <PushButton label={"Reset"} width={120ui} plate={ButtonPlate::Accent} disabled={self.saved == 0} @click={self.onReset} />
        <Dialog $if={self.asking} width={360ui} title={"Reset"}>
          <text value={"Forget what was saved?"} />
          <PushButton #buttons label={"Forget"} width={100ui} plate={ButtonPlate::Accent} @click={self.onDiscard} />
          <PushButton #buttons label={"Keep"} width={100ui} @click={self.onKeep} />
        </Dialog>
        <Tip $if={self.hint} title={"Showcase"} text={self.summary} />
      </box>
    }
  }
}
