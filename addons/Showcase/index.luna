// A page that uses every control of the library, for the run tests: what a settings page of a real addon does.
public import { Windowed } from "@/windowed"
public import { Tinted } from "@/tinted"
public import { Arranged } from "@/arranged"
import { Age, Checkbox, Choice, Dialog, Dropdown, Input, Module, Money, ProgressBar, PushButton, Section, Segmented, SettingRow, SettingsPage, SettingsTab, Slider, Switch, Tabs, Tip, Toggle, TreeRow, Unit } from "Ordaen"
import root Ordaen from "Ordaen"

const TABS: Array<String> = ["Map", "Drawer", "Market"]

public enum Hide { Never = "never", Combat = "combat", Transport = "transport" }

const HIDES: Array<Choice<Hide>> = [
  { value: Hide.Never, label: "Never" },
  { value: Hide.Combat, label: "In combat" },
  { value: Hide.Transport, label: "On a mount", soon: true },
]

public enum Worth { Auction = "auction", Merchant = "merchant", Held = "held" }

const WORTHS: Array<Choice<Worth>> = [
  { value: Worth.Auction, label: "Auction" },
  { value: Worth.Merchant, label: "Merchant" },
  { value: Worth.Held, label: "Held", soon: true },
]

public struct Choices {
  showZone: Boolean
  scale: Number
  columns: Integer
  drawer: Boolean
  hide: Hide
  name: String
}

public class Showcase implements Module, App {
  public const title: String = "Showcase"
  public const pages: Array<SettingsPage> = []

  state choices: mut Choices = { showZone: true, scale: 1, columns: 4, drawer: false, hide: Hide.Never, name: "" }
  state saved = 0
  state hint = false
  state tab = 1
  derived onMap: Boolean = self.tab == 1
  derived onDrawer: Boolean = self.tab == 2
  derived onMarket: Boolean = self.tab == 3
  // The market's controls: a scan's progress, a price and how old it is.
  state scanned: Number = 0.4
  state price: Integer = 12345
  state seen: Number | nil = 2 * 86400
  state worth: Worth = Worth.Auction
  state treeOpen = true
  derived summary: String = self.describe()

  constructor() {
    Ordaen.modules.add(self)
  }

  describe(self): String {
    return self.choices.showZone ? "zone shown" : "zone hidden"
  }

  state asking = false

  onSave(mut self) { self.saved += 1 }
  onReset(mut self) { self.asking = true }
  onKeep(mut self) { self.asking = false }
  onDiscard(mut self) {
    self.saved = 0
    self.asking = false
  }
  onEnter(mut self) { self.hint = true }
  onLeave(mut self) { self.hint = false }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={8} @enter={self.onEnter} @leave={self.onLeave}>
        <Tabs tabs={TABS} selected={mut self.tab} />
        <SettingsTab title={"Map"} shown={self.onMap}>
          <Section title={"Map"}>
            <Checkbox label={"Show the zone"} value={mut self.choices.showZone} />
            <Slider label={"Size"} value={mut self.choices.scale} least={0.8} most={1.6} step={0.05} unit={Unit.Percent} />
            <Slider label={"Columns"} value={mut self.choices.columns} least={2} most={12} disabled={!self.choices.showZone} />
          </Section>
        </SettingsTab>
        <SettingsTab title={"Drawer"} shown={self.onDrawer}>
          <Section title={"Drawer"}>
            <Switch label={"Button drawer"} hint={"Other addons' buttons in one place."} value={mut self.choices.drawer} />
            <Dropdown label={"Hide the map"} value={mut self.choices.hide} choices={HIDES} disabled={!self.choices.drawer} />
            <Input label={"Its name"} hint={"Shown over the drawer."} value={mut self.choices.name} maxLength={12}
                   disabled={!self.choices.drawer} />
            <text value={self.choices.name} />
            <Toggle value={mut self.choices.drawer} />
          </Section>
        </SettingsTab>
        <SettingsTab title={"Market"} shown={self.onMarket}>
          <Section title={"Market"}>
            <SettingRow label={"Scan"}>
              <ProgressBar fraction={self.scanned} label={"Scanning"} />
            </SettingRow>
            <SettingRow label={"Price"}>
              <box columns={["auto", "auto"]} gap={8}>
                <Money amount={self.price} />
                <Age seconds={self.seen} />
              </box>
            </SettingRow>
            <SettingRow label={"Sold to"}>
              <Segmented value={mut self.worth} choices={WORTHS} />
            </SettingRow>
            <box columns={1}>
              <TreeRow label={"Bronze Axe"} depth={0} open={mut self.treeOpen}>
                <Money amount={self.price} />
              </TreeRow>
              <TreeRow $if={self.treeOpen} label={"Bronze Bar"} depth={1} open={mut self.treeOpen} leaf={true}>
                <Age seconds={self.seen} />
              </TreeRow>
            </box>
          </Section>
        </SettingsTab>
        <text value={self.summary} />
        <PushButton label={"Save"} width={120} @click={self.onSave} />
        <PushButton label={"Reset"} width={120} accent={true} disabled={self.saved == 0} @click={self.onReset} />
        <Dialog $if={self.asking} width={360} title={"Reset"}>
          <text value={"Forget what was saved?"} />
          <PushButton #buttons label={"Forget"} width={100} accent={true} @click={self.onDiscard} />
          <PushButton #buttons label={"Keep"} width={100} @click={self.onKeep} />
        </Dialog>
        <Tip $if={self.hint} title={"Showcase"} text={self.summary} left={0} top={0} />
      </box>
    }
  }
}
