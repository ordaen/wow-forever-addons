// The market's controls on a page, for the run tests: a scan's progress, a price with its age, a mode, a tree, item
// slots and a sortable table of sales.
import { Align, Click, MouseButton, Track } from "$ltml"
import { Age, Choice, Column, Component, Corner, ItemButton, Marker, Menu, MenuEntry, Money, MoneyInput, ProgressBar, Quality, Section, Segmented, SettingRow, space, Table, TableRow, ToolPick, Toolbar, TreeRow, tracksOf } from "Ordaen"
import root Ordaen from "Ordaen"

public enum Worth { Auction = "auction", Merchant = "merchant", Held = "held" }

public enum Order { Difficulty = "difficulty", Name = "name", Price = "price" }

public struct Sale {
  name: String
  price: Integer
  seen: Number
}

const FLAGS: Array<Marker> = [{ corner: Corner.TopLeft, color: Color.hex("#ffd100") }]

const WORTHS: Array<Choice<Worth>> = [
  { value: Worth.Auction, label: "Auction" },
  { value: Worth.Merchant, label: "Merchant" },
  { value: Worth.Held, label: "Held", soon: true },
]

const ORDERS: Array<Choice<Order>> = [
  { value: Order.Difficulty, label: "By difficulty" },
  { value: Order.Name, label: "By name" },
  { value: Order.Price, label: "By price", soon: true },
]

const COLUMNS: Array<Column> = [
  { title: "Item", width: { fr: 1 }, sortable: true },
  { title: "Each", width: 120, align: Align.End, sortable: true },
  { title: "Age", width: 60, align: Align.End, sortable: true },
]
const TRACKS: Array<Track> = tracksOf(COLUMNS)

public class Market implements Component {
  state scanned: Number = 0.4
  state price: Integer = 12345
  state seen: Number | nil = 2 * 86400
  state wanted: Integer = 12503
  state worth: Worth = Worth.Auction
  state treeOpen = true
  state chosenItem = 0
  state sales: Array<Sale> = [
    { name: "Copper Bar", price: 150, seen: 3 * 86400 },
    { name: "Bronze Axe", price: 12345, seen: 86400 },
    { name: "Arcane Dust", price: 40, seen: 9 * 86400 },
  ]
  state sorted = 0
  state descending = false
  // The button of the last click on a row of the sales.
  state clicked = "none"
  state sortBy: Order = Order.Difficulty
  state search = ""
  // The context menu: open under its box, the switch's state, the place of the last entry clicked.
  state menuOpen = false
  state menuOn = false
  state menuPicked = 0
  derived menuEntries: Array<MenuEntry> = self.entriesOf()
  derived ordered: Array<Sale> = self.order()

  // The sales by the column the table is sorted by, as the page keeps them when it is not.
  order(self): Array<Sale> {
    let list: Array<Sale> = []
    for (sale of self.sales) { list.push(sale) }
    const column = self.sorted
    const down = self.descending
    if (column == 0) { return list }
    list.sort((a, b) => {
      if (column == 1) { return down ? a.name > b.name : a.name < b.name }
      if (column == 2) { return down ? a.price > b.price : a.price < b.price }
      return down ? a.seen > b.seen : a.seen < b.seen
    })
    return list
  }

  entriesOf(self): Array<MenuEntry> {
    return [
      { label: "Link in chat" },
      { label: "Create [0]", disabled: true },
      { label: "Favorite", on: self.menuOn, group: true },
    ]
  }

  onMenuBox(mut self, click: Click) {
    if (click.button == MouseButton.Right) { self.menuOpen = true }
  }

  onMenuPick(mut self, index: Integer) {
    self.menuPicked = index
    if (index == 3) { self.menuOn = !self.menuOn } else { self.menuOpen = false }
  }

  onMenuClose(mut self) { self.menuOpen = false }

  onItem(mut self, item: Integer) { self.chosenItem = item }
  onSale(mut self, click: Click) { self.clicked = click.button == MouseButton.Right ? "right" : "left" }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={space(.Group)}>
        <Section title={"Market"}>
          <SettingRow label={"Scan"}>
            <ProgressBar fraction={self.scanned} label={"Scanning"} />
          </SettingRow>
          <SettingRow label={"Price"}>
            <box columns={["auto", "auto"]} gap={space(.Item)}>
              <Money amount={self.price} />
              <Age seconds={self.seen} />
            </box>
          </SettingRow>
          <MoneyInput label={"Wanted"} value={mut self.wanted} />
          <SettingRow label={"Wanted, written"}>
            <Money amount={self.wanted} />
          </SettingRow>
          <SettingRow label={"Sold to"}>
            <Segmented value={mut self.worth} choices={WORTHS} />
          </SettingRow>
          <SettingRow label={"Bought"}>
            <box columns={["auto", "auto", "auto"]} gap={space(.Item)}>
              <ItemButton item={6948} count={5} quality={Quality.Rare} markers={FLAGS} @pick={self.onItem} />
              <ItemButton item={2589} count={20} quality={Quality.Epic} @pick={self.onItem} />
              <ItemButton item={nil} />
            </box>
          </SettingRow>
          <box columns={1}>
            <TreeRow label={"Bronze Axe"} depth={0} open={mut self.treeOpen}>
              <Money amount={self.price} />
            </TreeRow>
            <TreeRow $if={self.treeOpen} label={"Bronze Bar"} depth={1} open={mut self.treeOpen} leaf={true}>
              <Age seconds={self.seen} />
            </TreeRow>
          </box>
        </Section>
        <Section title={"Sales"}>
          <SettingRow label={"Last click on a row"}>
            <text value={self.clicked} />
          </SettingRow>
          <Table columns={COLUMNS} sorted={mut self.sorted} descending={mut self.descending}>
            <TableRow $for={sale of self.ordered} $key={sale} tracks={TRACKS} @pick={self.onSale}>
              <text value={peek sale.name} />
              <box xAlign={Align.End}>
                <Money amount={peek sale.price} />
              </box>
              <box xAlign={Align.End}>
                <Age seconds={peek sale.seen} />
              </box>
            </TableRow>
          </Table>
        </Section>
        <Section title={"Menus"}>
          <SettingRow label={"Toolbar"}>
            <box width={300}>
              <Toolbar search={mut self.search} placeholder={"Search"}>
                <ToolPick value={mut self.sortBy} choices={ORDERS} icon={Ordaen.art.ctl.tool.sort} title={"Sort"} />
              </Toolbar>
            </box>
          </SettingRow>
          <SettingRow label={"Context menu"}>
            <box padding={4} @click={self.onMenuBox}>
              <text value={"Right-click here"} />
              <Menu $if={self.menuOpen} entries={self.menuEntries} @pick={self.onMenuPick} @close={self.onMenuClose} />
            </box>
          </SettingRow>
        </Section>
      </box>
    }
  }
}
