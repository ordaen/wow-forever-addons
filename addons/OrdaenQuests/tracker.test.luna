// Where a quest's figures stand: the first one's zone and how many places there; nothing where the client doesn't
// know the zone.
import Test from "$test"
import { Figure } from "@/questie"
import { whereOf } from "@/tracker"

const UNKNOWN_AREA = 999999

function wolf(area: integer): Figure {
  return { id: 1, kind: .Npc, name: "Wolf", spots: [{ area: area, x: 0.3, y: 0.3 }, { area: area, x: 0.4, y: 0.4 }, { area: 12, x: 0.1, y: 0.1 }] }
}

test "figures say their first one's zone and how many places there" {
  Test::expect(whereOf([wolf(40)]) == "Westfall · 2 places")
  Test::expect(whereOf([]) == "")
}

test "where the client doesn't know the zone, figures say nothing" {
  Test::expect(whereOf([wolf(UNKNOWN_AREA)]) == "")
}
