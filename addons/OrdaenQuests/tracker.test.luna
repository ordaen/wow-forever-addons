// What Quests adds under a tracked quest in the tracker: where to go while it is to do, whom to hand it to once done,
// nothing of a quest QuestieDB doesn't know.
import Test from "$test"
import { QuestFacts } from "@/questie"
import { TrackerLines } from "@/tracker"

class Holder {
  public state facts: Map<Integer, QuestFacts> = {}
}

const FACTS: QuestFacts = {
  name: "", level: 10, minLevel: 8, task: "", zone: 40, reputation: [], next: 0, nextName: "",
  givers: [],
  takers: [{ name: "Gryan Stoutmantle", spots: [{ area: 40, x: 0.56, y: 0.47 }] }],
  targets: [{ name: "Wolf", spots: [{ area: 40, x: 0.3, y: 0.3 }, { area: 40, x: 0.4, y: 0.4 }, { area: 12, x: 0.1, y: 0.1 }] }]
}

test "a quest to do says its objectives' zone and how many places there; done, whom to hand it to and where" {
  const holder = new Holder()
  holder.facts = { [1]: FACTS }
  const lines = new TrackerLines(holder.facts, (id: Integer): Boolean => false, (id: Integer): Boolean => false)
  Test.expect((lines.lines(1, false)[1] ?? panic("a line")).text == "Westfall · 2 places")
  const done = lines.lines(1, true)[1] ?? panic("a line")
  // The tracker says it after «Ready to turn in»: the taker and the zone, no coordinates.
  Test.expect(done.text == "Gryan Stoutmantle · Westfall" && done.done)
  Test.expect(lines.lines(2, false).length == 0)
}
