// What Quests adds to Ordaen Panel's experience bar: the experience the log's completed quests give once turned in, a
// green part past the player's fill, with its tooltip. An entry of the panel's `xpSources`, added while both are loaded.
import Game from "$game"
import { TipRow, number } from "Ordaen"
import type { XpPart, XpSource } from "OrdaenPanel"
import { LogQuest } from "@/book"
import Locale from "@/locales"

const DONE_GREEN: Color = Color::hex("#6fa04f")

// A part of the level's whole in percent, one decimal under ten, cut, never rounded up: as the bar says its own.
function percentOf(part: integer, whole: integer): string {
  if (whole <= 0) { return "0%" }
  const percent = 100 * part / whole
  return number(percent >= 10 ? percent.floor() : (percent * 10).floor() / 10) + "%"
}

public class DoneQuestsXp implements XpSource {
  quests: Signal<array<LogQuest>>
  constructor(quests: Signal<array<LogQuest>>) { self.quests = quests }

  public part(self): XpPart | nil {
    const done = self.quests.filter(quest => quest.done && quest.xp > 0)
    if (done.length == 0) { return nil }
    let amount = 0
    for (quest of done) { amount = amount + quest.xp }
    const whole = Game::player.xpMax
    const reached = Game::player.xp + amount
    // Past the level the next one's whole isn't known: the level reached is said alone.
    const after = reached >= whole ? Locale::PANEL_XP_LEVEL_UP.format(Game::player.level + 1) : percentOf(reached, whole)
    const rows: array<TipRow> = [
      { label: Locale::PANEL_XP_QUESTS, value: number(done.length) },
      { label: Locale::PANEL_XP_AMOUNT, value: "%s (%s)".format(number(amount), percentOf(amount, whole)) },
      { label: Locale::PANEL_XP_AFTER, value: after }
    ]
    return XpPart { amount: amount, color: DONE_GREEN, title: Locale::PANEL_XP_TITLE, text: Locale::PANEL_XP_TEXT, rows: rows }
  }
}
