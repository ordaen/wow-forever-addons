// What the world holds of a quest: who gives it, who takes it, where its objectives are. `QuestieData` asks QuestieDB
// once a quest and keeps what it said for the session (each read of QuestieDB makes fresh tables, so nothing is read
// from it while drawing or per event).
import Game from "$game"
import { LibQuestieDB } from "QuestieDB"
import Questie from "@/questie"
import { Figure, NpcQuests, QuestFacts, Seller } from "@/questie"

// The contract of QuestieDB's data this module is written against.
const CONTRACT = 4
const NO_QUESTS: NpcQuests = { starts: [], ends: [] }

// Of the sellers, those friendly to `side` (QuestieDB's "A" and "H"); none for a player of neither.
public function sellingTo(sellers: array<Seller>, side: Game::Faction): array<integer> {
  const letter = side == Game::Faction::Alliance ? "A" : side == Game::Faction::Horde ? "H" : nil
  if (letter == nil) { return [] }
  return sellers.filter(seller => seller.sides.contains(letter)).map(seller => seller.npc)
}

public class QuestieData {
  known: mut map<integer, QuestFacts> = {}
  // Quests asked of and not known, so they aren't asked again.
  unknown: mut map<integer, boolean> = {}
  // The NPCs' quests asked of.
  npcs: mut map<integer, NpcQuests> = {}

  // Why nothing can be read (QuestieDB of another contract, its own message); nil where it can be.
  public fault(): string | nil {
    let (fits, said) = LibQuestieDB::RequireContract(CONTRACT)
    return fits ? nil : said ?? "QuestieDB's contract doesn't match"
  }

  // A quest's facts; nil for one QuestieDB doesn't know (Forever's newest).
  public mut quest(id: integer): QuestFacts | nil {
    const kept = self.known[id]
    if (kept != nil || self.unknown[id] == true || self.fault() != nil) { return kept }
    const read = Questie::quest(id)
    if (read == nil) {
      self.unknown[id] = true
    } else {
      self.known[id] = read
    }
    return read
  }

  // The NPCs that sell an item who trade with `side`'s players; none where QuestieDB can't be read. Asked as a list
  // of things to buy opens, not kept.
  public vendorsOf(item: integer, side: Game::Faction): array<integer> {
    return self.fault() == nil ? sellingTo(Questie::vendors(item), side) : []
  }

  // An NPC's name and spawns; nil for one QuestieDB doesn't know, or where it can't be read. Asked on a click, not
  // kept.
  public npc(id: integer): Figure | nil {
    return self.fault() == nil ? Questie::npc(id) : nil
  }

  // The quests an NPC gives and takes back; none for one QuestieDB doesn't know. Asked as a creature's tooltip shows,
  // kept for the session.
  public mut npcQuests(id: integer): NpcQuests {
    const kept = self.npcs[id]
    if (kept != nil) { return kept }
    const read = self.fault() == nil ? Questie::npcQuests(id) ?? NO_QUESTS : NO_QUESTS
    self.npcs[id] = read
    return read
  }
}
