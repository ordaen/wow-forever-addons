// The quests of the world's tab, in the order their titles stand in the window.
function before(first: String, second: String): Boolean {
  const texts = Test.page().window("World").texts()
  let at = 0
  let then = 0
  for (index, text of texts) {
    if (text == first && at == 0) { at = index }
    if (text == second && then == 0) { then = index }
  }
  return at > 0 && then > at
}

// The window's filter menu, opened from its funnel.
function filter(): Test.Part {
  if (!Test.page().window("Tracked only").shown()) { Test.page().window("World").button(Ordaen.art.ctl.tool.filter).click() }
  return Test.page().window("Tracked only")
}

test "a quest's objectives still to do stand under its title, one a line; its row's right says only «Complete» or «Failed»" {
  const log = standing()
  log[3] = {
    objectives: [{ text: "Wolves slain: 5/10" }, { text: "Pelts: 4/4", done: true }, { text: "Fangs: 1/3" }],
    ..quest(103, "Elwynn Wolves", "Elwynn Forest")
  }
  log[1] = { complete: true, ..quest(101, "The Defias Brotherhood", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  Test.expect(window.text("Wolves slain").shown() && window.text("5/10").shown() && window.text("Fangs").shown())
  Test.expect(!window.text("Pelts").shown())
  Test.expect(before("Elwynn Wolves", "Wolves slain") && before("Wolves slain", "Fangs"))
  Test.expect(window.text("Complete").count() == 1)
  Test.shot("the world's tab: a quest's objectives left to do under its title; the count in the footer")
}

test "the select beside the search shows the quests in progress, the completed ones, or all" {
  const log = standing()
  log[3] = { complete: true, ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  // A select: only the picked choice shows until it is opened.
  Test.expect(window.text("All").shown() && !window.text("Completed").shown())
  window.text("All").click()
  Test.page().text("Completed").click()
  Test.expect(window.text("Elwynn Wolves").shown() && !window.text("The Defias Brotherhood").shown())
  window.text("Completed").click()
  Test.page().text("In progress").click()
  Test.expect(!window.text("Elwynn Wolves").shown() && window.text("The Defias Brotherhood").shown())
}

test "the search field takes the toolbar's width but its tools, as the professions window's" {
  opened(standing())
  const field = Test.page().window("World").input().rect()
  Test.expect(field.right - field.left > 200)
}

test "the search finds a quest by its title or an objective" {
  const log = standing()
  log[1] = { objectives: [{ text: "Talk to Gryan Stoutmantle" }], ..quest(101, "The Defias Brotherhood", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  window.input().click()
  Test.type("gryan")
  Test.flush()
  Test.expect(window.text("The Defias Brotherhood").shown() && !window.text("Elwynn Wolves").shown())
  Test.erase(5)
  Test.type("ELWYNN")
  Test.flush()
  Test.expect(!window.text("The Defias Brotherhood").shown() && window.text("Elwynn Wolves").shown())
}

test "the filter keeps the tracked quests alone, or the difficulties switched on; a tab it empties says so" {
  const log = standing()
  log[3] = { watched: true, ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  filter().button("Tracked only").click()
  Test.expect(window.text("Elwynn Wolves").shown() && !window.text("The Defias Brotherhood").shown())
  filter().button("Tracked only").click()
  // The quests are of the player's level: yellow. The group turns every colour off, and the list says why it's empty.
  Game.player.level = 14
  filter().button("Difficulty").click()
  Test.expect(!window.text("Elwynn Wolves").shown() && window.text("No quest fits the search and the filter.").shown())
  filter().button("Yellow").click()
  Test.expect(window.text("Elwynn Wolves").shown())
  filter().button("Reset").click()
  Test.expect(window.text("The Defias Brotherhood").shown() && window.text("Elwynn Wolves").shown())
}

test "a group quest passes the filter by «Group», one played alone by «Solo»" {
  const log = standing()
  log[1] = { group: 3, ..quest(101, "The Defias Brotherhood", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  filter().button("Group").click()
  Test.expect(!window.text("The Defias Brotherhood").shown() && window.text("Elwynn Wolves").shown())
  filter().button("Group").click()
  filter().button("Solo").click()
  Test.expect(window.text("The Defias Brotherhood").shown() && !window.text("Elwynn Wolves").shown())
}

test "one list leaves the headers out; by title orders it" {
  opened(standing())
  const window = Test.page().window("World")
  window.button(Ordaen.art.ctl.tool.categories).click()
  Test.page().window("By zone").button("One list").click()
  Test.expect(!window.text("Westfall").shown() && !window.text("you are here").shown())
  Test.expect(before("The Defias Brotherhood", "Elwynn Wolves"))
  window.button(Ordaen.art.ctl.tool.sort).click()
  Test.page().window("As in the log").button("By title").click()
  Test.expect(before("Elwynn Wolves", "The Defias Brotherhood"))
}

test "the count stands in the footer under its dim label, and red once the log is full" {
  const log = standing()
  opened(log)
  Test.expect(Test.page().window("World").text("In the log").textColor().equal(Color.hex("#a3977f")))
  const counted = Test.page().window("World").text("3/25")
  Test.expect(counted.textColor().equal(Color.hex("#e8dcc4")))
  for (id of 1..22) { log.push(quest(200 + id, `Quest ${id}`, "Westfall")) }
  // The client says its log changed.
  Test.questLog(log)
  Test.flush()
  Test.expect(Test.page().window("World").text("25/25").textColor().equal(Color.hex("#ff4040")))
}

test "the window's one tab is «Quests» with the game's quest log book; its kinds are sub-tabs, each with its count" {
  opened(standing())
  const window = Test.page().window("World")
  Test.expect(window.button("Interface/QuestFrame/UI-QuestLog-BookIcon").shown())
  // Two quests of the world, one of a dungeon, none of a raid or PvP.
  Test.expect(window.text("World").shown() && window.text("2").shown() && window.text("1").shown())
  Test.expect(window.text("0").count() == 2)
  // The professions window's inner tabs: the picked one with its light along the top, not a segmented strip.
  Test.expect(window.box(Color.hex("#d6a56b")).shown() && !window.box(Color.hex("#5a4428")).shown())
  window.text("Dungeons").click()
  Test.expect(window.text("Red Silk Bandanas").shown() && !window.text("Elwynn Wolves").shown())
}

test "«Abandon quest» in the question is the danger plate" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  Test.page().window("World").button("Abandon").click()
  Test.expect(Test.page().window("Abandon «The Defias Brotherhood»?").button("Abandon").paintedWith(Ordaen.art.ctl.buttonAccent))
}

test "Shift+Left-click on a title puts its chat link where a chat line is open, and tracks nothing then" {
  opened(standing())
  Game.chat.linkQuest = (id: Integer): Boolean => id == 103
  Test.hold([.Shift])
  Test.page().window("World").text("Elwynn Wolves").click()
  Test.hold([])
  Test.expect(Test.talked().length == 0)
}

test "the window's opening and closing, and a quest tracked, sound as the game's log does" {
  opened(standing())
  Test.expect(Test.sounds()[1] == 844)
  Test.hold([.Shift])
  Test.page().window("World").text("Elwynn Wolves").click()
  Test.hold([])
  const tracked = Test.sounds()
  Test.expect(tracked.length == 1 && tracked[1] == 856)
  Quests.flip()
  Test.flush()
  const closed = Test.sounds()
  Test.expect(closed.length == 1 && closed[1] == 845)
}

test "«Show the way» in a quest's menu has the client point the way to it" {
  opened(standing())
  Test.page().window("World").text("Elwynn Wolves").rightClick()
  Test.page().window("Abandon").button("Show the way").click()
  Test.expect(Test.talked().join(",") == "super-track 103")
}

test "a wrapped objective's lines sit at the text's own line; two objectives keep their gap" {
  const log = standing()
  log[3] = { objectives: [
    { text: "Gray forest wolves slain in the hills east of Goldshire and the woods past it, down to the river: 0/50" },
    { text: "Pelts: 1/4" }
  ], ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  const long = window.text("Gray forest wolves slain in the hills east of Goldshire and the woods past it, down to the river").letters()
  const next = window.text("Pelts").letters()
  const line = next.bottom - next.top
  // Two lines or more, each no taller than a line of letters and a little; the next objective a gap further.
  Test.expect(long.bottom - long.top > line * 1.5 && long.bottom - long.top < line * 2.6 * 1.3)
  Test.expect(next.top - long.bottom > 1 && next.top - long.bottom < line)
}

test "a header says how many of its quests are complete of all at its right" {
  const log = standing()
  log[1] = { complete: true, ..quest(101, "The Defias Brotherhood", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  Test.expect(window.text("1/1").shown() && window.text("0/1").shown())
  Test.expect(window.text("1/1").rect().left > window.text("Westfall").rect().right)
}

test "a row is its level, a dim bullet and its title; a level of one digit keeps two digits' room, so titles line up" {
  const log = standing()
  log[3] = { level: 7, ..quest(103, "Elwynn Wolves", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  Test.expect(!window.text("[").shown() && !window.text("]").shown())
  // Level 14 is its «1» and «4», level 7 an unseen «0» and its «7», each in the level's colour.
  const said = window.text("The Defias Brotherhood").item().texts()
  Test.expect(said[1] == "1" && said[2] == "4" && said[3] == "•" && said[4] == "The Defias Brotherhood")
  Test.expect(!window.text("7").textColor().equal(Color.hex("#a3977f")))
  Test.expect(window.text("•").nth(1).textColor().equal(Color.hex("#6b6352")))
  const two = window.text("The Defias Brotherhood").rect()
  const one = window.text("Elwynn Wolves").rect()
  Test.expect((two.left - one.left).abs() < 0.01)
  // The level is part of the title's line: the objectives under it start at the level's edge.
  const row = window.text("Elwynn Wolves").item()
  Test.expect((row.text("Wolves slain").rect().left - row.text("7").rect().left).abs() < 11)
  Test.expect(row.text("Wolves slain").rect().left < row.text("7").rect().left)
}

test "a header and its quests take the list's whole width, a rule between one quest and the next" {
  const log = standing()
  log[3] = { level: 7, ..quest(103, "Elwynn Wolves", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  const header = window.text("Westfall").item()
  Test.shot("a header's band over its quests, each quest's row the list's whole width")
  // Westfall's two quests, each a title and one objective: the first under its header with no rule, the second with
  // one above it, which takes its width (1.17dp) of the row.
  const first = window.text("The Defias Brotherhood").item().rect()
  const second = window.text("Elwynn Wolves").item().rect()
  Test.expect(((second.bottom - second.top) - (first.bottom - first.top) - 0.83).abs() < 0.05)
  const row = window.text("Elwynn Wolves").item().rect()
  Test.expect((row.left - header.rect().left).abs() < 0.01)
  Test.expect((row.right - header.rect().right).abs() < 0.01)
}

test "a quest's gains stand at its row's right in the body's size: one alone leaves no room after it" {
  const log = standing()
  log[3] = { xp: 735, money: 150, ..quest(103, "Elwynn Wolves", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  // Quest 101 gives experience alone, quest 103 experience and money: both end at the same right edge.
  const alone = window.text("420").rect()
  const money = window.text(Game.money.format(150)).rect()
  Test.expect((alone.right - money.right).abs() < 0.01)
  // The body's size: as high as a title's line.
  const title = window.text("Elwynn Wolves").rect()
  Test.expect(((alone.bottom - alone.top) - (title.bottom - title.top)).abs() < 0.5)
  Test.expect(window.text("Elwynn Wolves").item().texts().any(text => text == "•"))
}

test "with the game's difficulty colours off (the world map's filter), a level is in the title's colour, and back" {
  opened(standing())
  const window = Test.page().window("World")
  // Level 14's «4».
  const coloured = window.text("4").nth(1).textColor()
  Test.expect(!coloured.equal(Color.hex("#e8dcc4")))
  Test.cvar("showQuestDifficultyColor", "0")
  Test.flush()
  Test.expect(window.text("4").nth(1).textColor().equal(Color.hex("#e8dcc4")))
  Test.cvar("showQuestDifficultyColor", "1")
  Test.flush()
  Test.expect(window.text("4").nth(1).textColor().equal(coloured))
}

test "a complete quest says so under its title, in place of its objectives" {
  const log = standing()
  log[3] = { complete: true, objectives: [{ text: "Pelts: 4/4", done: true }], ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  const title = window.text("Elwynn Wolves").rect()
  const ready = window.text("Complete").rect()
  Test.expect(ready.top >= title.bottom && ready.left <= title.left + 1)
  Test.expect(!window.text("Pelts").shown())
}

test "a quest's experience and money stand at its title's right, a bullet between, the experience with its mark" {
  const log = standing()
  log[3] = { xp: 735, money: 150, ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  const title = window.text("Elwynn Wolves").rect()
  // Every row has a bullet after its level: the gains' one is the last of its row.
  const row = window.text("Elwynn Wolves").item()
  Test.expect(window.text("735").rect().left > title.right && row.text("•").count() == 2)
  Test.expect(row.text("•").nth(2).rect().left > window.text("735").rect().right)
  Test.expect(window.box("GarrMission_CurrencyIcon-Xp").shown())
}

test "the page's experience and money are larger than a secondary text" {
  const log = standing()
  log[3] = { xp: 735, money: 150, rewards: [{ item: 1001 }], ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  window.text("Elwynn Wolves").click()
  // The list's row has its own at a secondary text's size; the page's band is a third larger.
  const row = window.text("735").nth(1).letters()
  const page = window.text("735").nth(2).letters()
  Test.expect(page.bottom - page.top > (row.bottom - row.top) * 1.2)
}

test "the abandon button says only «Abandon»" {
  opened(standing())
  const window = Test.page().window("World")
  window.text("The Defias Brotherhood").click()
  Test.expect(window.button("Abandon").shown() && !window.text("Abandon quest").shown())
}

test "an objective that says the task again stands once on the page, not dark then muted" {
  const log = standing()
  log[3] = { task: "Speak to Marshal Dughan.", objectives: [{ text: "Speak to Marshal Dughan.", done: true }],
    ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  window.text("Elwynn Wolves").click()
  // Once on the page: done, it has left the list's row.
  Test.expect(window.text("Speak to Marshal Dughan.").count() == 1)
}

test "the parchment holds the lore alone: the objectives and their counts stand under it, on the well" {
  const log = standing()
  log[3] = {
    task: "Bring pelts to Eagan.", objectives: [{ text: "Pelts: 4/4", done: true }, { text: "Fangs: 1/3" }],
    ..quest(103, "Elwynn Wolves", "Elwynn Forest")
  }
  opened(log)
  const window = Test.page().window("World")
  window.text("Elwynn Wolves").click()
  // The task on the parchment; the objectives past its bottom roll, in the well's text as the switch's label is, a done
  // one dim.
  // The list's row says «Fangs» first; the page's is the second.
  const fangs = window.text("Fangs").nth(2)
  Test.expect(fangs.rect().top > window.text("Bring pelts to Eagan.").rect().bottom + 40)
  Test.expect(fangs.textColor().equal(window.text("Track").textColor()))
  // Done: a dimmed green, not grey.
  Test.expect(window.text("Pelts").textColor().equal(Color.hex("#6a9a62")))
}

test "a long objective wraps under the parchment and pushes what follows down" {
  const log = standing()
  const long = "Чародейский справочник: магические термины простыми словами"
  log[3] = {
    objectives: [{ text: `${long}: 0/1` }], choices: [{ item: 1002 }], ..quest(103, "Elwynn Wolves", "Elwynn Forest")
  }
  opened(log)
  const window = Test.page().window("World")
  window.text("Elwynn Wolves").click()
  const goal = window.text(long).nth(2)
  const next = window.text("You will be able to choose")
  // Two lines, and the rewards' title under the second.
  Test.expect(goal.rect().bottom - goal.rect().top > 30)
  Test.expect(goal.rect().bottom <= next.rect().top)
}

test "with the setting on, a quest's parchment opens folded to its title, and a click unfolds it" {
  const log = standing()
  log[3] = { task: "Bring pelts to Eagan.", ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  Quests.settings.values.foldedScroll = true
  const window = Test.page().window("World")
  window.text("Elwynn Wolves").click()
  Test.expect(window.text("Elwynn Wolves").count() == 2 && !window.text("Bring pelts to Eagan.").shown())
  Test.shot("a quest's page, its parchment folded to its title")
  window.text("Elwynn Wolves").nth(2).click()
  Test.expect(window.text("Bring pelts to Eagan.").shown())
  // Another quest opens folded again.
  window.text("The Defias Brotherhood").click()
  Test.expect(!window.text("Bring pelts to Eagan.").shown())
}

test "the parchment opens unfolded by default" {
  const log = standing()
  log[3] = { task: "Bring pelts to Eagan.", ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  Test.page().window("World").text("Elwynn Wolves").click()
  Test.expect(Test.page().window("World").text("Bring pelts to Eagan.").shown())
}
