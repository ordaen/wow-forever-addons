// The quest log as the player meets it: the game's quest log key and the micro menu's button open it, its tabs sort
// the quests by the client's tag, a quest's page says where to go, and what the player does with a quest reaches the
// client's log. The client's log is the stand-in's (`Test.questLog`), QuestieDB the stand-in's as the test fills it
// (`Test.questieDB`): it knows the first quest alone.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Key } from "$ltml"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Maps from "OrdaenMap"
import root Quests from "OrdaenQuests"
import root Tracker from "OrdaenTracker"
import { kindOfTag } from "@/kind"
import { QuestSort } from "@/model"

const PAGE: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }

function quest(id: Integer, title: String, header: String): Test.LogQuest {
  return { id: id, title: title, header: header, level: 14, objectives: [{ text: "Wolves slain: 5/10" }] }
}

// The player's log: two quests of the world, one of a dungeon.
function standing(): mut Array<Test.LogQuest> {
  return [
    { story: "Gryan asks you to look into Westfall.", xp: 420, ..quest(101, "The Defias Brotherhood", "Westfall") },
    { tag: 81, ..quest(102, "Red Silk Bandanas", "The Deadmines") },
    quest(103, "Elwynn Wolves", "Elwynn Forest")
  ]
}

// The module with this log, its window open; QuestieDB knows the first quest, given and taken back by Gryan.
function opened(log: Array<Test.LogQuest>) {
  Test.questieDB(
    {
      [101]: { name: "The Defias Brotherhood", questLevel: 14, zoneOrSort: 40, startedBy: [[234]], finishedBy: [[234]],
        nextQuestInChain: 166, reputationReward: [[72, 250], [470, -25]] },
      [166]: {
        name: "The Defias Brotherhood, part two", questLevel: 16, requiredLevel: 12, zoneOrSort: 40,
        objectivesText: ["Take the note to the Scout.", "Then report back."], startedBy: [[235]], nextQuestInChain: 167
      },
      [167]: { name: "The Defias Brotherhood, part three", questLevel: 18, requiredLevel: 14, zoneOrSort: 40 }
    },
    {
      [234]: { name: "Gryan Stoutmantle", spawns: { [40]: [[56, 47]] } },
      [235]: { name: "Scout Riell", spawns: { [12]: [[30, 60]] } }
    },
    {}
  )
  Test.factions({ [72]: "Stormwind", [470]: "Ratchet" })
  Test.questLog(log)
  Test.mount(nil, PAGE)
  Quests.flip()
  Quests.refresh()
  Test.flush()
  _ = Test.talked()
}

test "a quest's tab is the client's tag: dungeon, raid, battleground, else the world" {
  Test.expect(kindOfTag(81) == .Dungeon)
  Test.expect(kindOfTag(85) == .Dungeon)
  Test.expect(kindOfTag(62) == .Raid)
  Test.expect(kindOfTag(88) == .Raid)
  Test.expect(kindOfTag(89) == .Raid)
  Test.expect(kindOfTag(41) == .PvP)
  Test.expect(kindOfTag(1) == .World)
  Test.expect(kindOfTag(nil) == .World)
}

test "the game's quest log key opens the window, and again closes it" {
  Test.mount(nil, PAGE)
  _ = Client.SetBinding("L", "TOGGLEQUESTLOG")
  Events.UPDATE_BINDINGS.emit()
  Test.flush()
  Test.keyBound("L")
  Test.expect(Test.page().window("World").shown())
  Test.keyBound("L")
  Test.expect(!Test.page().window("World").shown())
}

test "the key stays the window's when Blizzard's map opens its own quest panel (the client's questLogOpen)" {
  Test.mount(nil, PAGE)
  _ = Client.SetBinding("L", "TOGGLEQUESTLOG")
  Events.UPDATE_BINDINGS.emit()
  Test.flush()
  _ = Client.C_CVar.SetCVar("questLogOpen", "1")
  Client.C_Map.OpenWorldMap(1436)
  Test.flush()
  Client.WorldMapFrame.Hide()
  Test.flush()
  Test.keyBound("L")
  Test.expect(Test.page().window("World").shown() && !Client.WorldMapFrame.IsShown())
}

test "another module opens a quest of the log at its page, and one not in it in the chain's window" {
  opened(standing())
  Quests.flip()
  Test.flush()
  Test.expect(Quests.openAt(101))
  Test.flush()
  Test.expect(Test.page().window("World").shown() && Quests.picked == 101)
  Test.expect(Quests.openAt(166))
  Test.flush()
  Test.expect(Quests.chained == 166 && Test.page().window("Level 16, available from level 12").shown())
  Test.expect(!Quests.openAt(99999))
}

test "switched off, the key is the game's again" {
  Test.mount(nil, PAGE)
  _ = Client.SetBinding("L", "TOGGLEQUESTLOG")
  Quests.settings.values.ownKey = false
  Test.flush()
  Test.keyBound("L")
  Test.expect(!Test.page().window("World").shown())
  Test.expect(Client.GetBindingAction("L", true) == "TOGGLEQUESTLOG")
}

test "the micro menu's quest log button opens the window, and has the game's click back as the module ends" {
  Test.mount(nil, PAGE)
  const button = Client.CreateFrame("Button", "QuestLogMicroButton", Client.UIParent, nil)
  button.SetSize(30, 40)
  // Where the game's micro menu stands, clear of the window it opens.
  button.SetPoint("BOTTOMRIGHT", Client.UIParent, "BOTTOMRIGHT", -160, 4)
  let gameClicks = 0
  button.SetScript("OnClick", (): nil => {
    gameClicks += 1
    return nil
  })
  Game.frames.QuestLogMicroButton = button
  Test.flush()
  Test.click(Test.centre(button), nil)
  Test.expect(Test.page().window("World").shown())
  Test.expect(gameClicks == 0)
  Quests.settings.values.ownKey = false
  Test.flush()
  Test.click(Test.centre(button), nil)
  Test.expect(gameClicks == 1)
}

test "each tab lists its own quests and counts them, the player's zone first" {
  opened(standing())
  const window = Test.page().window("World")
  Test.expect(window.text("Elwynn Wolves").shown())
  Test.expect(window.text("The Defias Brotherhood").shown())
  Test.expect(!window.text("Red Silk Bandanas").shown())
  Test.expect(window.text("you are here").shown())
  const texts = window.texts()
  Test.expect(texts.find(text => text == "Elwynn Forest") != nil)
  window.text("Dungeons").click()
  Test.expect(window.text("Red Silk Bandanas").shown())
  Test.expect(!window.text("Elwynn Wolves").shown())
  Test.expect(window.text("3/25").shown())
}

test "a header folds its quests away and back" {
  opened(standing())
  const window = Test.page().window("World")
  window.text("Westfall").click()
  Test.expect(!window.text("The Defias Brotherhood").shown())
  window.text("Westfall").click()
  Test.expect(window.text("The Defias Brotherhood").shown())
}

test "the toolbar's choices and the folded headers are there after a /reload; the search isn't" {
  opened(standing())
  Test.page().window("World").text("Westfall").click()
  Test.expect(Quests.folds.values.headers["Westfall"] == true)
  Quests.list.values.sort = QuestSort.Title
  Quests.search = "wolves"
  Test.reload()
  // The stand-in's log starts anew with the load; the player's is the same.
  Test.questLog(standing())
  Quests.flip()
  Quests.refresh()
  Test.flush()
  Test.expect(Quests.list.values.sort == QuestSort.Title && Quests.search == "")
  Test.expect(Quests.folds.values.headers["Westfall"] == true)
  const window = Test.page().window("World")
  Test.expect(window.text("Westfall").shown())
  Test.expect(!window.text("The Defias Brotherhood").shown())
  Test.expect(window.text("Elwynn Wolves").shown())
}

test "Shift+Left-click on a quest tracks it" {
  opened(standing())
  Test.hold([.Shift])
  Test.page().window("World").text("Elwynn Wolves").click()
  Test.hold([])
  Test.expect(Test.talked().join(",") == "watch 103")
}

test "a quest picked shows its page and the next quest of its chain; who gives and completes it is the map's" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  const window = Test.page().window("World")
  Test.expect(window.text("Gryan asks you to look into Westfall.").shown())
  Test.expect(window.text("420").shown())
  // The reputations it changes, QuestieDB's (the client says none), in one column of the band; each faction in its Tip.
  const reputation = window.text("-25–+250 reputation")
  Test.expect(reputation.shown())
  const at = reputation.rect()
  Test.moveTo({ x: (at.left + at.right) / 2, y: (at.top + at.bottom) / 2 })
  Test.flush()
  const tip = Test.page().window("Reputation")
  Test.expect(tip.text("Stormwind").shown() && tip.text("+250").shown() && tip.text("Ratchet").shown() && tip.text("-25").shown())
  // The chain: the quest after it, by QuestieDB's name, under the parchment in gold, a link.
  const next = window.text("The Defias Brotherhood, part two")
  Test.expect(window.text("Next quest").shown() && next.textColor().equal(Color.hex("#ffd100")))
  Test.expect(next.rect().top > window.text("Objectives").rect().bottom)
  // The giver and the turn-in aren't named on the page.
  Test.expect(!window.text("Gryan Stoutmantle (56, 47)").shown() && !window.text("Gryan Stoutmantle").shown())
}

test "the tracking switch stands at the page's right edge, over Abandon's" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  const window = Test.page().window("World")
  const face = window.box(Ordaen.art.ctl.switchOff).rect()
  Test.expect((face.right - window.button("Abandon").rect().right).abs() < 1)
}

test "a quest's page shows its rewards as Dialogue's quest page does: those to choose, those given, at its foot" {
  const log = standing()
  log[3] = { rewards: [{ item: 1001, count: 3 }], choices: [{ item: 1002 }, { item: 1003 }], ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  Test.page().window("World").text("Elwynn Wolves").click()
  const window = Test.page().window("World")
  Test.expect(window.text("You will be able to choose").shown() && window.text("You will also receive").shown())
  Test.expect(window.text("3").shown())
  // Under the scroll: below the quest's objectives, above its buttons.
  Test.expect(window.text("You will be able to choose").rect().top > window.text("Objectives").rect().bottom)
  Test.expect(window.text("You will also receive").rect().bottom < window.button("Share").rect().top)
}

test "many rewards give way to the parchment, which keeps its least height" {
  const log = standing()
  let choices: Array<Test.LogReward> = []
  for (index of 1..6) { choices.push({ item: 1001 + index % 3, count: index }) }
  log[3] = { rewards: [{ item: 1001 }, { item: 1002 }], choices: choices, xp: 735, money: 150, ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  window.text("Elwynn Wolves").click()
  const paper = window.text("You will be able to choose").rect().top - window.text("Elwynn Wolves").nth(2).rect().top
  // Without its least height the rewards squeeze the parchment to a line or two (38 here).
  Test.expect(paper > 100)
  Test.expect(window.button("Share").rect().bottom <= window.rect().bottom)
}

test "a quest's title stands in Dialogue's title type on the scroll, its lines tight, without its level" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  const window = Test.page().window("World")
  // The list's row, then the page's.
  const title = window.text("The Defias Brotherhood").nth(2)
  Test.expect(title.shown() && title.rect().bottom - title.rect().top < 40)
  Test.expect(!window.text("[14] The Defias Brotherhood").shown())
}

test "a quest's scroll fills its page's height: the rolls at its top and its foot, the paper repeated between them" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  const window = Test.page().window("World")
  const top = window.box(Ordaen.art.window.scroll.top).rect()
  const paper = window.box(Ordaen.art.window.scroll.paper).rect()
  const bottom = window.box(Ordaen.art.window.scroll.bottom).rect()
  Test.expect((paper.top - top.bottom).abs() < 0.5 && paper.bottom > bottom.top + 1 && paper.bottom < bottom.bottom)
  // The title on the paper, under the top roll, and clear of the paper's torn sides by a margin.
  const title = window.text("The Defias Brotherhood").nth(2).rect()
  Test.expect(title.top >= top.bottom - 10 && (title.left - paper.left) / (paper.right - paper.left) > 0.115)
  // It fills the page, whatever the text's size and however much the quest says: what stands under it starts right
  // under its foot (the next quest of its chain), and a quest of three lines (with no next quest under it, whose room
  // it takes too) has a scroll at least as tall, its foot well past its words.
  const under = window.text("Next quest").rect()
  Test.expect(under.top >= bottom.bottom && under.top - bottom.bottom < 40)
  window.text("Elwynn Wolves").click()
  const short = window.box(Ordaen.art.window.scroll.bottom).rect()
  Test.expect(short.bottom >= bottom.bottom - 0.5)
  // Its words: the title, the heading, one objective under it.
  Test.expect(short.top > window.text("Objectives").rect().bottom + 60)
}

test "a quest under the cursor has its tooltip" {
  const log = standing()
  log[1] = { task: "Find Gryan in Sentinel Hill.", ..log[1] ?? panic("a quest") }
  opened(log)
  const row = Test.page().window("World").text("The Defias Brotherhood")
  row.hover()
  // As the game's log's: its task, then what the clicks do.
  Test.expect(Test.page().text("Find Gryan in Sentinel Hill.").shown())
  Test.expect(Test.page().text("Left-click: open the quest").shown() && Test.page().text("Right-click: more").shown())
}

test "docked, the map open, the log stands over the map's side panel; a quest picked there shows its page and the way back" {
  opened(standing())
  Quests.flip()
  Test.flush()
  // Docked by Map's switch.
  Maps?.dock(true)
  Test.flush()
  Client.C_Map.OpenWorldMap(1436)
  Test.flush()
  Test.expect(Test.page().text("Red Silk Bandanas").shown() || Test.page().text("The Defias Brotherhood").shown())
  Test.page().text("The Defias Brotherhood").click()
  Test.expect(Test.page().text("Back to the list").shown())
  Test.page().text("Back to the list").click()
  Test.expect(!Test.page().text("Back to the list").shown())
  Client.WorldMapFrame.Hide()
  Test.flush()
  Test.expect(!Test.page().text("The Defias Brotherhood").shown())
}

test "in the tracker a quest to do says where, and its title opens its page in the window" {
  const log = standing()
  // In the player's zone (the stand-in's, Elwynn Forest): the tracker lists the zone's quests alone.
  log[1] = { watched: true, story: "Gryan asks you to look into Westfall.", ..quest(101, "The Defias Brotherhood", "Elwynn Forest") }
  opened(log)
  Quests.flip()
  Test.flush()
  const tracker = Tracker ?? panic("Ordaen Tracker")
  tracker.refresh()
  Test.flush()
  // QuestieDB places its giver alone: as a target it knows none, so the line is the turn-in's once done.
  Test.expect(Test.page().text("The Defias Brotherhood").shown())
  Test.page().text("The Defias Brotherhood").click()
  Test.flush()
  Test.expect(Quests.open && Quests.picked == 101)
}

test "a quest's page draws no figure, as Dialogue's quest page, even where the client names its giver" {
  const log = standing()
  log[3] = { portraitGiver: 1491, ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const drawn = Test.calls(() => {
    Test.page().window("World").text("Elwynn Wolves").click()
    Test.flush()
    return nil
  })
  Test.expect(!drawn.contains("SetDisplayInfo"))
}

test "the list's rows have no tracking box: a quest is tracked by the page's switch" {
  opened(standing())
  const window = Test.page().window("World")
  Test.expect(!window.box(Ordaen.art.ctl.check).shown())
  window.text("Elwynn Wolves").click()
  _ = Test.talked()
  window.text("Track").click()
  Test.expect(Test.talked().join(",") == "watch 103")
}

test "Abandon is the page's accent button and stands at the right, after the others" {
  opened(standing())
  const window = Test.page().window("World")
  window.text("The Defias Brotherhood").click()
  const abandon = window.button("Abandon").rect()
  const share = window.button("Share").rect()
  Test.expect(abandon.left > share.right + 50 && abandon.top == share.top)
  Test.expect(window.button("Abandon").paintedWith(Ordaen.art.ctl.buttonAccent))
  Test.expect(!window.button("Share").paintedWith(Ordaen.art.ctl.buttonAccent))
}

test "a long objective wraps on the page, its count standing at the right of the line" {
  const log = standing()
  log[3] = { objectives: [{ text: "Gray forest wolves slain in the hills east of Goldshire and the woods past it: 0/50" }], ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  window.text("Elwynn Wolves").click()
  const what = window.text("Gray forest wolves slain in the hills east of Goldshire and the woods past it")
  const count = window.text("0/50")
  Test.expect(what.count() == 2 && count.count() == 2)
  // The list's line and the page's: both wrap, the count after the words.
  for (n of 1..2) {
    const words = what.nth(n).rect()
    Test.expect(words.bottom - words.top > 25 && count.nth(n).rect().left > words.right)
  }
}

test "the window opened as the player opens it lists the log's quests, Map on and OpenMap's art not built yet" {
  Test.questLog(standing())
  Test.mount(nil, PAGE)
  Test.flush()
  Quests.flip()
