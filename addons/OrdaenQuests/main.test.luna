  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  const window = Test.page().window("World")
  Test.expect(window.text("-25–+265 reputation").shown())
}

test "the next quest's name opens its page in a window of its own, which follows the chain on, and closes" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  Test.page().window("World").text("The Defias Brotherhood, part two").click()
  Test.flush()
  const chain = Test.page().window("Level 16, available from level 12")
  Test.expect(chain.text("The Defias Brotherhood, part two").shown())
  Test.expect(chain.text("Take the note to the Scout. Then report back.").shown())
  Test.shot("the next quest of a chain in its window")
  chain.text("The Defias Brotherhood, part three").click()
  Test.flush()
  Test.expect(Test.page().window("Level 18, available from level 14").shown() && Quests.chained == 167)
  // The last of the chain QuestieDB knows: no line under it.
  Test.expect(!Test.page().window("Level 18, available from level 14").text("Next quest").shown())
  Test.key(Key.Escape)
  Test.flush()
  Test.expect(Quests.chained == 0 && Test.page().window("World").shown())
}

