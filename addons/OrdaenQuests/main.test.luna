// The quest log as the player meets it: the game's quest log key and the micro menu's button open it, its tabs sort
// the quests by the client's tag, a quest's page says where to go, and what the player does with a quest reaches the
// client's log. The client's log is the stand-in's (`Test.questLog`), QuestieDB the stand-in's as the test fills it
// (`Test.questieDB`): it knows the first quest alone.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import Test from "$test"
import root Ordaen from "Ordaen"
import root Quests from "OrdaenQuests"
import root Tracker from "OrdaenTracker"
import { kindOfTag } from "@/kind"

const PAGE: Test.Page = { left: 0, top: 0, width: 1600, height: 900, screen: true }

function quest(id: Integer, title: String, header: String): Test.LogQuest {
  return { id: id, title: title, header: header, level: 14, objectives: [{ text: "Wolves slain: 5/10" }] }
}

// The player's log: two quests of the world, one of a dungeon.
function standing(): mut Array<Test.LogQuest> {
  return [
    { story: "Gryan asks you to look into Westfall.", xp: 420, ..quest(101, "The Defias Brotherhood", "Westfall") },
    { tag: 81, ..quest(102, "Red Silk Bandanas", "The Deadmines") },
    quest(103, "Elwynn Wolves", "Elwynn Forest")
  ]
}

// The module with this log, its window open; QuestieDB knows the first quest, given and taken back by Gryan.
function opened(log: Array<Test.LogQuest>) {
  Test.questieDB(
    {
      [101]: { name: "The Defias Brotherhood", questLevel: 14, zoneOrSort: 40, startedBy: [[234]], finishedBy: [[234]],
               nextQuestInChain: 166 },
      [166]: { name: "The Defias Brotherhood, part two", zoneOrSort: 40 }
    },
    { [234]: { name: "Gryan Stoutmantle", spawns: { [40]: [[56, 47]] } } },
    {}
  )
  Test.questLog(log)
  Test.mount(nil, PAGE)
  Quests.flip()
  Quests.refresh()
  Test.flush()
  _ = Test.talked()
}

test "a quest's tab is the client's tag: dungeon, raid, battleground, else the world" {
  Test.expect(kindOfTag(81) == .Dungeon)
  Test.expect(kindOfTag(85) == .Dungeon)
  Test.expect(kindOfTag(62) == .Raid)
  Test.expect(kindOfTag(88) == .Raid)
  Test.expect(kindOfTag(89) == .Raid)
  Test.expect(kindOfTag(41) == .PvP)
  Test.expect(kindOfTag(1) == .World)
  Test.expect(kindOfTag(nil) == .World)
}

test "the game's quest log key opens the window, and again closes it" {
  Test.mount(nil, PAGE)
  _ = Client.SetBinding("L", "TOGGLEQUESTLOG")
  Events.UPDATE_BINDINGS.emit()
  Test.flush()
  Test.keyBound("L")
  Test.expect(Test.page().window("World").shown())
  Test.keyBound("L")
  Test.expect(!Test.page().window("World").shown())
}

test "switched off, the key is the game's again" {
  Test.mount(nil, PAGE)
  _ = Client.SetBinding("L", "TOGGLEQUESTLOG")
  Quests.settings.values.ownKey = false
  Test.flush()
  Test.keyBound("L")
  Test.expect(!Test.page().window("World").shown())
  Test.expect(Client.GetBindingAction("L", true) == "TOGGLEQUESTLOG")
}

test "the micro menu's quest log button opens the window, and has the game's click back as the module ends" {
  Test.mount(nil, PAGE)
  const button = Client.CreateFrame("Button", "QuestLogMicroButton", Client.UIParent, nil)
  button.SetSize(30, 40)
  // Where the game's micro menu stands, clear of the window it opens.
  button.SetPoint("BOTTOMRIGHT", Client.UIParent, "BOTTOMRIGHT", -160, 4)
  let gameClicks = 0
  button.SetScript("OnClick", (): nil => {
    gameClicks += 1
    return nil
  })
  Game.frames.QuestLogMicroButton = button
  Test.flush()
  Test.click(Test.centre(button), nil)
  Test.expect(Test.page().window("World").shown())
  Test.expect(gameClicks == 0)
  Quests.settings.values.ownKey = false
  Test.flush()
  Test.click(Test.centre(button), nil)
  Test.expect(gameClicks == 1)
}

test "each tab lists its own quests and counts them, the player's zone first" {
  opened(standing())
  const window = Test.page().window("World")
  Test.expect(window.text("Elwynn Wolves").shown())
  Test.expect(window.text("The Defias Brotherhood").shown())
  Test.expect(!window.text("Red Silk Bandanas").shown())
  Test.expect(window.text("you are here").shown())
  const texts = window.texts()
  Test.expect(texts.find(text => text == "Elwynn Forest") != nil)
  window.text("Dungeons").click()
  Test.expect(window.text("Red Silk Bandanas").shown())
  Test.expect(!window.text("Elwynn Wolves").shown())
  Test.expect(window.text("3/25").shown())
}

test "a header folds its quests away and back" {
  opened(standing())
  const window = Test.page().window("World")
  window.text("Westfall").click()
  Test.expect(!window.text("The Defias Brotherhood").shown())
  window.text("Westfall").click()
  Test.expect(window.text("The Defias Brotherhood").shown())
}

test "Shift+Left-click on a quest tracks it" {
  opened(standing())
  Test.hold([.Shift])
  Test.page().window("World").text("Elwynn Wolves").click()
  Test.hold([])
  Test.expect(Test.talked().join(",") == "watch 103")
}

test "a quest picked shows its page, with where its giver stands from QuestieDB" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  const window = Test.page().window("World")
  Test.expect(window.text("Gryan asks you to look into Westfall.").shown())
  Test.expect(window.text("Gryan Stoutmantle (56, 47)").count() == 2)
  Test.expect(window.text("420 experience").shown())
  // The chain: the quest after it, by QuestieDB's name.
  Test.expect(window.text("Next in chain").shown() && window.text("The Defias Brotherhood, part two").shown())
}

test "a quest's page shows its rewards as Dialogue's quest page does: those to choose, those given, at its foot" {
  const log = standing()
  log[3] = { rewards: [{ item: 1001, count: 3 }], choices: [{ item: 1002 }, { item: 1003 }], ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  Test.page().window("World").text("Elwynn Wolves").click()
  const window = Test.page().window("World")
  Test.expect(window.text("You will be able to choose").shown() && window.text("You will also receive").shown())
  Test.expect(window.text("3").shown())
  // Under the scroll: below the quest's objectives, above its buttons.
  Test.expect(window.text("You will be able to choose").rect().top > window.text("Objectives").rect().bottom)
  Test.expect(window.text("You will also receive").rect().bottom < window.button("Share").rect().top)
}

test "a quest's title stands in Dialogue's title type on the scroll, its lines tight" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  const title = Test.page().window("World").text("[14] The Defias Brotherhood")
  Test.expect(title.shown() && title.rect().bottom - title.rect().top < 40)
}

test "a quest under the cursor has its tooltip, and its pins on the map lit while it is there" {
  opened(standing())
  const row = Test.page().window("World").text("The Defias Brotherhood")
  row.hover()
  Test.expect(Test.page().text("Click: its page. Shift+click: its link in the chat. Right-click: more.").shown())
  Test.expect(Quests.hovered == 101)
  Test.page().window("World").text("In the log").hover()
  Test.expect(Quests.hovered == 0)
}

test "docked, the map open, the log stands over the map's side panel; a quest picked there shows its page and the way back" {
  opened(standing())
  Quests.flip()
  Test.flush()
  // Docked as the map's own toggle docks it: the client's setting.
  _ = Client.C_CVar.SetCVar("questLogOpen", "1")
  Client.C_Map.OpenWorldMap(1436)
  Test.flush()
  Test.expect(Test.page().text("Red Silk Bandanas").shown() || Test.page().text("The Defias Brotherhood").shown())
  Test.page().text("The Defias Brotherhood").click()
  Test.expect(Test.page().text("Back to the list").shown())
  Test.page().text("Back to the list").click()
  Test.expect(!Test.page().text("Back to the list").shown())
  Client.WorldMapFrame.Hide()
  Test.flush()
  Test.expect(!Test.page().text("The Defias Brotherhood").shown())
}

test "in the tracker a quest to do says where, and its title opens its page in the window" {
  const log = standing()
  log[1] = { watched: true, story: "Gryan asks you to look into Westfall.", ..quest(101, "The Defias Brotherhood", "Westfall") }
  opened(log)
  Quests.flip()
  Test.flush()
  const tracker = Tracker ?? panic("Ordaen Tracker")
  tracker.refresh()
  Test.flush()
  // QuestieDB places its giver alone: as a target it knows none, so the line is the turn-in's once done.
  Test.expect(Test.page().text("The Defias Brotherhood").shown())
  Test.page().text("The Defias Brotherhood").click()
  Test.flush()
  Test.expect(Quests.open && Quests.picked == 101)
}

test "a quest's page draws no figure, as Dialogue's quest page, even where the client names its giver" {
  const log = standing()
  log[3] = { portraitGiver: 1491, ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const drawn = Test.calls(() => {
    Test.page().window("World").text("Elwynn Wolves").click()
    Test.flush()
    return nil
  })
  Test.expect(!drawn.contains("SetDisplayInfo"))
}

test "the list's rows have no tracking box: a quest is tracked by the page's switch" {
  opened(standing())
  const window = Test.page().window("World")
  Test.expect(!window.box(Ordaen.art.ctl.check).shown())
  window.text("Elwynn Wolves").click()
  _ = Test.talked()
  window.text("Track").click()
  Test.expect(Test.talked().join(",") == "watch 103")
}

test "Abandon is the page's accent button and stands at the right, after the others" {
  opened(standing())
  const window = Test.page().window("World")
  window.text("The Defias Brotherhood").click()
  const abandon = window.button("Abandon quest").rect()
  const share = window.button("Share").rect()
  Test.expect(abandon.left > share.right + 50 && abandon.top == share.top)
  Test.expect(window.button("Abandon quest").paintedWith(Ordaen.art.ctl.buttonAccent))
  Test.expect(!window.button("Share").paintedWith(Ordaen.art.ctl.buttonAccent))
}

test "a long objective wraps on the page, its count standing at the right of the line" {
  const log = standing()
  log[3] = { objectives: [{ text: "Gray forest wolves slain in the hills east of Goldshire and the woods past it: 0/50" }], ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  window.text("Elwynn Wolves").click()
  const what = window.text("Gray forest wolves slain in the hills east of Goldshire and the woods past it")
  const count = window.text("0/50")
  Test.expect(what.count() == 2 && count.count() == 2)
  // The list's line and the page's: both wrap, the count after the words.
  for (n of 1..2) {
    const words = what.nth(n).rect()
    Test.expect(words.bottom - words.top > 25 && count.nth(n).rect().left > words.right)
  }
}

test "the window opened as the player opens it lists the log's quests, Map on and OpenMap's art not built yet" {
  Test.questLog(standing())
  Test.mount(nil, PAGE)
  Test.flush()
  Quests.flip()
  Test.flush()
  Test.expect(Test.page().window("World").text("The Defias Brotherhood").shown())
}

test "a quest QuestieDB doesn't know has no «Where»" {
  opened(standing())
  Test.page().window("World").text("Elwynn Wolves").click()
  Test.expect(!Test.page().window("World").text("Where").shown())
}

test "the question to abandon a quest names the items abandoning it destroys" {
  const log = standing()
  log[3] = { abandonItems: [2041], ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  Test.page().window("World").text("Elwynn Wolves").click()
  Test.page().window("World").button("Abandon quest").click()
  Test.expect(Test.page().text("Items from this quest that will be destroyed: item 2041").shown())
}

test "abandoning asks first, and only «Abandon quest» in the question abandons" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  Test.page().window("World").button("Abandon quest").click()
  Test.expect(Test.talked().length == 0)
  const asked = Test.page().window("Abandon «The Defias Brotherhood»?")
  asked.button("Cancel").click()
  Test.expect(Test.talked().length == 0)
  Test.page().window("World").button("Abandon quest").click()
  Test.page().window("Abandon «The Defias Brotherhood»?").button("Abandon quest").click()
  Test.expect(Test.talked().join(",") == "abandon 101")
  // The client's log no longer has it, and the window follows.
  Test.flush()
  Test.expect(!Test.page().window("World").text("The Defias Brotherhood").shown())
}

test "a quest that can't be shared has its button greyed: a click shares nothing" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  Test.page().window("World").button("Share").click()
  Test.expect(Test.talked().length == 0)
}

test "Right-click on a quest opens its menu, and «Track» there tracks it" {
  opened(standing())
  Test.page().window("World").text("Elwynn Wolves").rightClick()
  Test.page().window("Abandon quest").button("Track").click()
  Test.expect(Test.talked().join(",") == "watch 103")
}

test "its layers stand on Ordaen Map's settings page while Map is on" {
  Test.mount(nil, PAGE)
  Test.open("Ordaen")
  Test.page().window("Ordaen").text("Map").click()
  Test.expect(Test.page().text("Quest objectives").shown())
  Test.expect(Test.page().text("Turn in").shown())
}

// The quests of the world's tab, in the order their titles stand in the window.
function before(first: String, second: String): Boolean {
  const texts = Test.page().window("World").texts()
  let at = 0
  let then = 0
  for (index, text of texts) {
    if (text == first && at == 0) { at = index }
    if (text == second && then == 0) { then = index }
  }
  return at > 0 && then > at
}

// The window's filter menu, opened from its funnel.
function filter(): Test.Part {
  if (!Test.page().window("Tracked only").shown()) { Test.page().window("World").button(Ordaen.art.ctl.tool.filter).click() }
  return Test.page().window("Tracked only")
}

test "a quest's objectives stand under its title, one a line; its row's right says only «Complete» or «Failed»" {
  const log = standing()
  log[3] = { objectives: [{ text: "Wolves slain: 5/10" }, { text: "Pelts: 4/4", done: true }], ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  log[1] = { complete: true, ..quest(101, "The Defias Brotherhood", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  Test.expect(window.text("Pelts").shown() && window.text("Wolves slain").count() == 2 && window.text("5/10").count() == 2)
  Test.expect(before("Elwynn Wolves", "Wolves slain") && before("Wolves slain", "Pelts"))
  Test.expect(window.text("Complete").count() == 1)
  Test.shot("the world's tab: a quest's objectives under its title, the done one grey; the count in the footer")
}

test "the switch beside the search shows the quests in progress, the completed ones, or all" {
  const log = standing()
  log[3] = { complete: true, ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  window.button("Completed").click()
  Test.expect(window.text("Elwynn Wolves").shown() && !window.text("The Defias Brotherhood").shown())
  window.button("In progress").click()
  Test.expect(!window.text("Elwynn Wolves").shown() && window.text("The Defias Brotherhood").shown())
  window.button("All").click()
  Test.expect(window.text("Elwynn Wolves").shown() && window.text("The Defias Brotherhood").shown())
}

test "the search finds a quest by its title or an objective" {
  const log = standing()
  log[1] = { objectives: [{ text: "Talk to Gryan Stoutmantle" }], ..quest(101, "The Defias Brotherhood", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  window.input().click()
  Test.type("gryan")
  Test.flush()
  Test.expect(window.text("The Defias Brotherhood").shown() && !window.text("Elwynn Wolves").shown())
  Test.erase(5)
  Test.type("ELWYNN")
  Test.flush()
  Test.expect(!window.text("The Defias Brotherhood").shown() && window.text("Elwynn Wolves").shown())
}

test "the filter keeps the tracked quests alone, or the difficulties switched on; a tab it empties says so" {
  const log = standing()
  log[3] = { watched: true, ..quest(103, "Elwynn Wolves", "Elwynn Forest") }
  opened(log)
  const window = Test.page().window("World")
  filter().button("Tracked only").click()
  Test.expect(window.text("Elwynn Wolves").shown() && !window.text("The Defias Brotherhood").shown())
  filter().button("Tracked only").click()
  // The quests are of the player's level: yellow. The group turns every colour off, and the list says why it's empty.
  Game.player.level = 14
  filter().button("Difficulty").click()
  Test.expect(!window.text("Elwynn Wolves").shown() && window.text("No quest fits the search and the filter.").shown())
  filter().button("Yellow").click()
  Test.expect(window.text("Elwynn Wolves").shown())
  filter().button("Reset").click()
  Test.expect(window.text("The Defias Brotherhood").shown() && window.text("Elwynn Wolves").shown())
}

test "a group quest passes the filter by «Group», one played alone by «Solo»" {
  const log = standing()
  log[1] = { group: 3, ..quest(101, "The Defias Brotherhood", "Westfall") }
  opened(log)
  const window = Test.page().window("World")
  filter().button("Group").click()
  Test.expect(!window.text("The Defias Brotherhood").shown() && window.text("Elwynn Wolves").shown())
  filter().button("Group").click()
  filter().button("Solo").click()
  Test.expect(window.text("The Defias Brotherhood").shown() && !window.text("Elwynn Wolves").shown())
}

test "one list leaves the headers out; by title orders it" {
  opened(standing())
  const window = Test.page().window("World")
  window.button(Ordaen.art.ctl.tool.categories).click()
  Test.page().window("By zone").button("One list").click()
  Test.expect(!window.text("Westfall").shown() && !window.text("you are here").shown())
  Test.expect(before("The Defias Brotherhood", "Elwynn Wolves"))
  window.button(Ordaen.art.ctl.tool.sort).click()
  Test.page().window("As in the log").button("By title").click()
  Test.expect(before("Elwynn Wolves", "The Defias Brotherhood"))
}

test "the count stands in the footer under its dim label, and red once the log is full" {
  const log = standing()
  opened(log)
  Test.expect(Test.page().window("World").text("In the log").textColor().equal(Color.hex("#a3977f")))
  const counted = Test.page().window("World").text("3/25")
  Test.expect(counted.textColor().equal(Color.hex("#e8dcc4")))
  for (id of 1..22) { log.push(quest(200 + id, `Quest ${id}`, "Westfall")) }
  // The client says its log changed.
  Test.questLog(log)
  Test.flush()
  Test.expect(Test.page().window("World").text("25/25").textColor().equal(Color.hex("#ff4040")))
}

test "the window's one tab is «Quests» with the game's quest log book; its kinds are sub-tabs, each with its count" {
  opened(standing())
  const window = Test.page().window("World")
  Test.expect(window.button("Interface/QuestFrame/UI-QuestLog-BookIcon").shown())
  // Two quests of the world, one of a dungeon, none of a raid or PvP.
  Test.expect(window.text("World").shown() && window.text("2").shown() && window.text("1").shown())
  Test.expect(window.text("0").count() == 2)
  window.text("Dungeons").click()
  Test.expect(window.text("Red Silk Bandanas").shown() && !window.text("Elwynn Wolves").shown())
}

test "«Abandon quest» in the question is the danger plate" {
  opened(standing())
  Test.page().window("World").text("The Defias Brotherhood").click()
  Test.page().window("World").button("Abandon quest").click()
  Test.expect(Test.page().window("Abandon «The Defias Brotherhood»?").button("Abandon quest").paintedWith(Ordaen.art.ctl.buttonAccent))
}

test "Shift+Left-click on a title puts its chat link where a chat line is open, and tracks nothing then" {
  opened(standing())
  Game.chat.linkQuest = (id: Integer): Boolean => id == 103
  Test.hold([.Shift])
  Test.page().window("World").text("Elwynn Wolves").click()
  Test.hold([])
  Test.expect(Test.talked().length == 0)
}

test "the window's opening and closing, and a quest tracked, sound as the game's log does" {
  opened(standing())
  Test.expect(Test.sounds()[1] == 844)
  Test.hold([.Shift])
  Test.page().window("World").text("Elwynn Wolves").click()
  Test.hold([])
  const tracked = Test.sounds()
  Test.expect(tracked.length == 1 && tracked[1] == 856)
  Quests.flip()
  Test.flush()
  const closed = Test.sounds()
  Test.expect(closed.length == 1 && closed[1] == 845)
}

test "«Show the way» in a quest's menu has the client point the way to it" {
  opened(standing())
  Test.page().window("World").text("Elwynn Wolves").rightClick()
  Test.page().window("Abandon quest").button("Show the way").click()
  Test.expect(Test.talked().join(",") == "super-track 103")
}
