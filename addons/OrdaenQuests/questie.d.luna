// QuestieDB's entities (`_G.LibQuestieDB`, contract 4), as `questie.lua` reads them: what the world holds of a quest.
// QuestieDB is GPLv3: it is called from the player's own install, and nothing of it is copied here.

// A place in the world: an `AreaTable` area, and where in it, 0 to 1 across and down.
public struct Spot {
  area: Integer
  x: Number
  y: Number
}

// Which of the world's things a figure is.
public enum FigureKind { Npc = "npc", Object = "object" }

// An NPC or an object a quest names, by QuestieDB's number of it, its name in the client's language where QuestieDB
// has that (else English), and where it stands.
public struct Figure {
  id: Integer
  kind: FigureKind
  name: String
  spots: Array<Spot>
}

// An item a quest asks for: its number, and its name as QuestieDB has it in the client's language.
public struct WantedItem {
  id: Integer
  name: String
}

// A creature that drops an item, by its number, and the chance it does in percent where QuestieDB has one.
public struct DropSource {
  creature: Integer
  chance: Number | nil = nil
}

// An item a quest asks for and every creature QuestieDB says drops it: a creature's tooltip says the quest's count
// where the client's doesn't (an item that is ordinary loot, not a quest's own drop).
public struct ItemDrops {
  item: Integer
  name: String
  sources: Array<DropSource>
}

// A reputation a quest raises (or lowers, negative): the faction, and by how much before the player's bonuses.
public struct FactionGain {
  faction: Integer
  amount: Integer
}

// What QuestieDB says of a quest.
public struct QuestFacts {
  name: String
  level: Integer
  // The level it may be taken at, and the last it may (0: no last).
  minLevel: Integer
  maxLevel: Integer = 0
  // The races and classes it is for, by the client's numbers (`UnitRace`'s, `UnitClass`'s); none: every one.
  races: Array<Integer> = []
  classes: Array<Integer> = []
  // The quests turned in before it may be taken: every one of `after`, one of `afterAny`. None of `exclusive` may be
  // taken or turned in.
  after: Array<Integer> = []
  afterAny: Array<Integer> = []
  exclusive: Array<Integer> = []
  // What it asks, in the quest's own words (its lines, one paragraph); "" where QuestieDB says nothing.
  task: String
  // Positive: the `AreaTable` area it belongs to; negative: a `QuestSort`.
  zone: Integer
  // Who gives it, who takes it back, and where its objectives are (the creatures and objects it names, and those
  // that drop the items it asks for).
  givers: Array<Figure>
  takers: Array<Figure>
  targets: Array<Figure>
  // The items it asks for.
  items: Array<WantedItem>
  // Each of those items with every creature that drops it.
  drops: Array<ItemDrops> = []
  // The reputations it changes once turned in (the client's quest window doesn't say them).
  reputation: Array<FactionGain>
  // The quest after it in its chain; 0 for none.
  next: Integer
  // That quest's name; "" for none, or one QuestieDB doesn't name.
  nextName: String
}

// The quest's facts; nil for a quest QuestieDB doesn't know (Forever's newest). Asked only where its contract is the
// one this reader is written against (`QuestieData.fault`).
public function quest(id: Integer): QuestFacts | nil

// An NPC's name and where it stands; nil for one QuestieDB doesn't know. Asked as `quest` is.
public function npc(id: Integer): Figure | nil

// The quests an NPC gives and those it takes back, by their numbers.
public struct NpcQuests {
  starts: Array<Integer>
  ends: Array<Integer>
}

// An NPC's quests; nil for one QuestieDB doesn't know. Asked as `quest` is.
public function npcQuests(id: Integer): NpcQuests | nil
