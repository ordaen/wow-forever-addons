// The log as the window lists it: a tab's quests under the client's headers, the player's zone first; a quest's
// difficulty by its level against the player's (the library's `difficultyOf`).
import { Difficulty, difficultyOf, switched } from "Ordaen"
import { LogQuest } from "@/book"
import { QuestKind } from "@/kind"

// One header of a tab and its quests.
public struct Group {
  header: string
  // The player is in that zone: it stands first, marked.
  here: boolean
  quests: array<LogQuest>
}

// The quests of a kind under their headers, in the client's order, the player's zone first.
public function groupsOf(quests: array<LogQuest>, kind: QuestKind, zone: string): array<Group> {
  const headers: array<string> = mut []
  const byHeader: map<string, mut array<LogQuest>> = mut {}
  for (quest of quests) {
    if (quest.kind == kind) {
      const under = byHeader[quest.header]
      if (under == nil) {
        headers.push(quest.header)
        byHeader[quest.header] = mut [quest]
      } else {
        under.push(quest)
      }
    }
  }
  const groups: array<Group> = mut []
  for (header of headers.filter(header => header == zone)) { groups.push({ header: header, here: true, quests: byHeader[header] ?? [] }) }
  for (header of headers.filter(header => header != zone)) { groups.push({ header: header, here: false, quests: byHeader[header] ?? [] }) }
  return groups
}

// How many of the quests are of each kind, in the tabs' order.
public function countOf(quests: array<LogQuest>, kind: QuestKind): integer {
  return quests.count(quest => quest.kind == kind)
}

// The filter's options: only the tracked quests; each difficulty; a quest played alone or with a group.
public enum QuestFilter implements Plain {
  Tracked = "tracked"
  Trivial = "trivial"
  Easy = "easy"
  Even = "even"
  Hard = "hard"
  Impossible = "impossible"
  Solo = "solo"
  Group = "group"
}

// The filter as the window starts: every quest shown, tracked or not.
public const FILTER_START: map<QuestFilter, boolean> = switched({}, [
  QuestFilter::Trivial, QuestFilter::Easy, QuestFilter::Even, QuestFilter::Hard, QuestFilter::Impossible, QuestFilter::Solo,
  QuestFilter::Group
], true)

// The option a quest's difficulty passes by.
const function difficultyFilter(difficulty: Difficulty): QuestFilter {
  return match (difficulty) {
    .Trivial => QuestFilter::Trivial
    .Easy => QuestFilter::Easy
    .Even => QuestFilter::Even
    .Hard => QuestFilter::Hard
    .Impossible => QuestFilter::Impossible
  }
}

// The switch beside the search: the quests still to do, the completed ones, or all.
public enum QuestStatus implements Plain { Progress = "progress", Done = "done", All = "all" }
// How a header's quests are ordered: as the log has them, by level, by title.
public enum QuestSort implements Plain { Log = "log", Level = "level", Title = "title" }
// The list under the headers, or one list.
public enum QuestView implements Plain { Zones = "zones", List = "list" }

// How the player left the list's toolbar, the profile's: the status switch, the filter, the order and the view. The
// search isn't kept.
public struct ListChoices implements Plain {
  status: QuestStatus = QuestStatus::All
  filter: map<QuestFilter, boolean> = FILTER_START
  sort: QuestSort = QuestSort::Log
  view: QuestView = QuestView::Zones
}

// The headers the player folded, by their text, the character's (whose log they are): only those its log has, so
// it holds no more than the log's headers.
public struct Folds implements Plain {
  headers: map<string, boolean> = {}
}

// The quest whose page the log showed last, the character's: the log opens on it again after a /reload (0: the list).
public struct Opened implements Plain {
  quest: integer = 0
}

// The folds after the player folds or opens `header`: the log's other headers as they were.
public function foldedOnce(folds: Folds, header: string, quests: array<LogQuest>): Folds {
  const headers: map<string, boolean> = mut {}
  for (quest of quests) {
    const name = quest.header
    const was = folds.headers[name] == true
    if (name == header ? !was : was) { headers[name] = true }
  }
  return { headers: headers }
}

// What the window asks of the log: the search (lower case), the status switch, the filter's options on, and the
// player's level the difficulties are of.
public struct Asked {
  sought: string
  status: QuestStatus
  filter: map<QuestFilter, boolean>
  player: integer
}

// Whether a quest's title or one of its objectives holds what is sought.
function holds(quest: LogQuest, sought: string): boolean {
  return sought == "" || quest.title.lower().contains(sought) ||
    quest.objectives.any(objective => objective.text.lower().contains(sought))
}

function statusPasses(quest: LogQuest, status: QuestStatus): boolean {
  return match (status) {
    .Progress => !quest.done
    .Done => quest.done
    .All => true
  }
}

public function passes(quest: LogQuest, asked: Asked): boolean {
  if (asked.filter[QuestFilter::Tracked] == true && !quest.tracked) { return false }
  if (asked.filter[difficultyFilter(difficultyOf(quest.level, asked.player))] != true) { return false }
  if (asked.filter[quest.group > 1 ? QuestFilter::Group : QuestFilter::Solo] != true) { return false }
  return statusPasses(quest, asked.status) && holds(quest, asked.sought)
}

// The quests the search, the switch and the filter let through, in the order asked.
public function listedOf(quests: array<LogQuest>, asked: Asked, sort: QuestSort): array<LogQuest> {
  const listed = quests.filter(quest => passes(quest, asked))
  match (sort) {
    .Log => {}
    .Level => listed.sort((a, b) => a.level != b.level ? a.level < b.level : a.title < b.title)
    .Title => listed.sort((a, b) => a.title != b.title ? a.title < b.title : a.level < b.level)
  }
  return listed
}

// The quests of a kind, in the order they come.
public function ofKind(quests: array<LogQuest>, kind: QuestKind): array<LogQuest> {
  return quests.filter(quest => quest.kind == kind)
}
