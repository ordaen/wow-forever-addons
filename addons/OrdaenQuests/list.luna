// A tab's list: the quests the search, the status switch and the filter let through, under the client's headers (the
// player's zone first; a header folds) or as one list. A tab with no quest says so, and one whose quests are all
// left out says that.
import { Edges } from "$ltml"
import { Component, ScrolledList } from "Ordaen"
import { LogQuest } from "@/book"
import { QuestKind } from "@/kind"
import Locale from "@/locales"
import { Group, QuestView, groupsOf, ofKind } from "@/model"
import { Act, HeaderRow, QuestRow } from "@/view"

const DIM: color = #a3977f
// The rows bring their own padding (the list's well has none): the text that stands for them takes the same.
const EMPTY_PAD: Edges = { top: 4sp, right: 2sp, bottom: 4sp, left: 2sp }

// A group's rows: its header, and its quests while it isn't folded.
class GroupRows implements Component {
  public act: Event<(integer, Act)> = new Event()
  public fold: Event<string> = new Event()

  derived open: boolean = self.folded[self.group.header] != true

  group: Signal<Group>
  picked: Signal<integer>
  folded: Signal<map<string, boolean>>
  player: Signal<integer>
  constructor(group: Signal<Group>, picked: Signal<integer>, folded: Signal<map<string, boolean>>, player: Signal<integer>) {
    self.group = group
    self.picked = picked
    self.folded = folded
    self.player = player
  }

  mut onAct(id: integer, act: Act) { self.act.emit(id, act) }
  mut onFold(header: string) { self.fold.emit(header) }

  public render(): Template {
    return $ltml {
      <box columns={1}>
        <HeaderRow header={self.group.header} here={self.group.here} folded={!self.open} quests={self.group.quests}
                   @fold={self.onFold} />
        <box $if={self.open} columns={1}>
          <QuestRow $for={index, quest of self.group.quests} $key={quest.id} quest={quest} picked={quest.id == self.picked}
                    player={self.player} ruled={index > 1} @act={self.onAct} />
        </box>
      </box>
    }
  }
}

public class QuestList implements Component {
  public act: Event<(integer, Act)> = new Event()
  public fold: Event<string> = new Event()

  derived inZones: boolean = self.view == .Zones
  derived groups: array<Group> = groupsOf(self.quests, self.kind, self.zone)
  derived flat: array<LogQuest> = ofKind(self.quests, self.kind)
  derived empty: boolean = self.flat.length == 0
  derived emptyText: string = !self.any ? self.noneText() : Locale::NOTHING_FOUND

  quests: Signal<array<LogQuest>>
  kind: Signal<QuestKind>
  view: Signal<QuestView>
  zone: Signal<string>
  picked: Signal<integer>
  folded: Signal<map<string, boolean>>
  player: Signal<integer>
  any: Signal<boolean>
  constructor(
    // The quests let through, in the order asked.
    quests: Signal<array<LogQuest>>,
    kind: Signal<QuestKind>,
    view: Signal<QuestView>,
    zone: Signal<string>,
    picked: Signal<integer>,
    folded: Signal<map<string, boolean>>,
    player: Signal<integer>,
    // The tab has quests in the log, whether or not any is let through.
    any: Signal<boolean>
  ) {
    self.quests = quests
    self.kind = kind
    self.view = view
    self.zone = zone
    self.picked = picked
    self.folded = folded
    self.player = player
    self.any = any
  }

  noneText(): string {
    return match (self.kind) {
      .World => Locale::EMPTY_WORLD
      .Dungeon => Locale::EMPTY_DUNGEONS
      .Raid => Locale::EMPTY_RAIDS
      .PvP => Locale::EMPTY_PVP
    }
  }

  mut onAct(id: integer, act: Act) { self.act.emit(id, act) }
  mut onFold(header: string) { self.fold.emit(header) }

  public render(): Template {
    return $ltml {
      <ScrolledList columns={1} rowsPadded={true}>
        <box $if={self.empty} columns={1} padding={EMPTY_PAD}>
          <text value={self.emptyText} textColor={DIM} />
        </box>
        <box $elseif={self.inZones} columns={1}>
          <GroupRows $for={group of self.groups} $key={group.header} group={group} picked={self.picked}
                     folded={self.folded} player={self.player} @act={self.onAct} @fold={self.onFold} />
        </box>
        <box $else columns={1}>
          <QuestRow $for={index, quest of self.flat} $key={quest.id} quest={quest} picked={quest.id == self.picked}
                    player={self.player} ruled={index > 1} @act={self.onAct} />
        </box>
      </ScrolledList>
    }
  }
}
