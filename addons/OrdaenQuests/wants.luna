// What Quests says of a creature in Ordaen Tooltips' creature tooltips, from the log and QuestieDB:
// - the objectives it serves: each item objective of a quest to do whose item it drops, with the log's count. The
//   client's own quest rows say this only of a quest's own drops; an item that is ordinary loot (a boar's meat) gets
//   its rows from here. An item dropped by more than `COMMON` creatures is everyday loot (cloth, herbs, leather) and
//   names none, and a creature that drops it far less often than the best does (`RARE_SHARE`) isn't named either.
// - the quests it gives that the player may take now, and the log's done quests it takes back.
import Game from "$game"
import root Tooltips from "OrdaenTooltips"
import type { CreatureQuests, Offered, Wanted } from "OrdaenTooltips"
import { LogQuest } from "@/book"
import { ItemDrops, NpcQuests, QuestFacts } from "@/questie"

const NO_WANTS: Array<Wanted> = []
// More droppers than this: everyday loot.
const COMMON = 100
// A creature whose chance is under this share of the best creature's drops the item hardly ever.
const RARE_SHARE = 0.1

// An objective's text without its count, wherever the client puts it («Name: 2/4», «2/4 Name»).
function labelOf(text: String): String {
  return text.replace("^%d+%s*/%s*%d+%s*", "").replace("%s*:?%s*%d+%s*/%s*%d+%s*$", "")
}

// The creatures an item's objective is shown on: none for everyday loot; where QuestieDB has chances, those that drop
// it at least `RARE_SHARE` as often as the best one; else every one.
public function droppersOf(drop: ItemDrops): Array<Integer> {
  if (drop.sources.length > COMMON) { return [] }
  let best = 0.0
  for (source of drop.sources) { best = best.max(source.chance ?? 0) }
  const creatures: Array<Integer> = []
  for (source of drop.sources) {
    if (best == 0 || (source.chance ?? 0) >= best * RARE_SHARE) { creatures.push(source.creature) }
  }
  return creatures
}

// The log's objective a quest's item asks for: the log's item objectives stand in QuestieDB's order of its items, so
// where they are as many, the one at the item's place; else the one whose text names the item, whole.
function objectiveFor(quest: LogQuest, facts: QuestFacts, at: Integer): Game.QuestObjective | nil {
  const items = quest.objectives.filter(objective => objective.kind == .Item)
  if (items.length == facts.drops.length) { return items[at] }
  const drop = facts.drops[at]
  return drop == nil ? nil : items.find(objective => labelOf(objective.text) == drop.name)
}

// The log's quests to do by the creatures that drop what their item objectives ask for.
public function wantsOf(quests: Array<LogQuest>, facts: Map<Integer, QuestFacts>): Map<Integer, Array<Wanted>> {
  const by: Map<Integer, mut Array<Wanted>> = {}
  for (quest of quests) {
    const known = facts[quest.id]
    if (quest.done || quest.failed || known == nil) { continue }
    for (at, drop of known.drops) {
      const objective = objectiveFor(quest, known, at)
      if (objective == nil || objective.need == 0) { continue }
      const want: Wanted = {
        quest: quest.id, title: quest.title, objective: labelOf(objective.text), have: objective.have,
        need: objective.need, done: objective.done
      }
      for (creature of droppersOf(drop)) {
        const list = by[creature]
        if (list == nil) {
          by[creature] = [want]
        } else {
          list.push(want)
        }
      }
    }
  }
  return by
}

// What the player is, for a quest's needs.
public struct Seeker {
  level: Integer
  race: Integer
  classNumber: Integer
}

// Whether every one of `ids` is turned in, one of them is, or one is taken or turned in.
function allDone(ids: Array<Integer>, done: (id: Integer) => Boolean): Boolean { return ids.all(id => done(id)) }
function anyDone(ids: Array<Integer>, done: (id: Integer) => Boolean): Boolean { return ids.any(id => done(id)) }

// Whether the player may take a quest now: of the level, the race and the class it is for, the quests before it
// turned in, none it excludes taken or turned in, and it neither turned in nor in the log.
public function takeable(
  id: Integer, facts: QuestFacts, seeker: Seeker, logged: (id: Integer) => Boolean, done: (id: Integer) => Boolean
): Boolean {
  if (logged(id) || done(id)) { return false }
  if (seeker.level < facts.minLevel || (facts.maxLevel > 0 && seeker.level > facts.maxLevel)) { return false }
  if (facts.races.length > 0 && !facts.races.any(race => race == seeker.race)) { return false }
  if (facts.classes.length > 0 && !facts.classes.any(number => number == seeker.classNumber)) { return false }
  if (!allDone(facts.after, done)) { return false }
  if (facts.afterAny.length > 0 && !anyDone(facts.afterAny, done)) { return false }
  return !facts.exclusive.any(other => other != id && (logged(other) || done(other)))
}

// What an NPC offers the player: the log's done quests it takes back, then the quests it gives that may be taken now.
public function offersOf(
  npc: NpcQuests, quests: Array<LogQuest>, factsOf: (id: Integer) => QuestFacts | nil, seeker: Seeker,
  done: (id: Integer) => Boolean
): Array<Offered> {
  const offers: Array<Offered> = []
  for (id of npc.ends) {
    const quest = quests.find(quest => quest.id == id)
    if (quest != nil && quest.done) { offers.push({ title: quest.title, level: quest.level, turnIn: true }) }
  }
  const logged = (id: Integer): Boolean => quests.any(quest => quest.id == id)
  for (id of npc.starts) {
    const facts = factsOf(id)
    if (facts != nil && takeable(id, facts, seeker, logged, done)) {
      offers.push({ title: facts.name, level: facts.level, turnIn: false })
    }
  }
  return offers
}

public class QuestCreatures implements CreatureQuests {
  derived by: Map<Integer, Array<Wanted>> = wantsOf(self.quests, self.facts)
  derived seeker: Seeker = {
    level: Game.player.level, race: Game.player.raceNumber, classNumber: Game.player.classNumber
  }

  quests: Signal<Array<LogQuest>>
  facts: Signal<Map<Integer, QuestFacts>>
  const npcQuests: (id: Integer) => NpcQuests
  const factsOf: (id: Integer) => QuestFacts | nil
  constructor(
    quests: Signal<Array<LogQuest>>, facts: Signal<Map<Integer, QuestFacts>>, npcQuests: (id: Integer) => NpcQuests,
    factsOf: (id: Integer) => QuestFacts | nil
  ) {
    self.quests = quests
    self.facts = facts
    self.npcQuests = npcQuests
    self.factsOf = factsOf
  }

  public wants(self, creature: Integer): Array<Wanted> {
    return self.by[creature] ?? NO_WANTS
  }

  public offers(self, creature: Integer): Array<Offered> {
    return offersOf(
      self.npcQuests(creature), self.quests, self.factsOf, self.seeker, (id: Integer): Boolean => Game.questLog.completed(id)
    )
  }
}

// The creatures' quests, added to Tooltips' `creatures` while Tooltips is on: the watch's run owns them, so they end
// when either module does. Without Tooltips the root import stays nil and nothing is added.
public class TooltipCreatures {
  const creatures: QuestCreatures
  constructor(
    quests: Signal<Array<LogQuest>>, facts: Signal<Map<Integer, QuestFacts>>, npcQuests: (id: Integer) => NpcQuests,
    factsOf: (id: Integer) => QuestFacts | nil
  ) {
    self.creatures = new QuestCreatures(quests, facts, npcQuests, factsOf)
    watch (tooltips of Tooltips) {
      if (tooltips == nil) { return }
      tooltips.creatures.add(self.creatures)
    }
  }
}
