// What the player has: the client's quest log (`Game.questLog`), each quest with the tab it belongs to.
import Game from "$game"
import { QuestKind, kindOfTag } from "@/kind"

// A quest of the player's log, as the client says it, and its tab, worked out as it is read.
public struct LogQuest {
  id: Integer
  title: String
  level: Integer
  // The client's header it stands under: a zone, an instance, a battleground.
  header: String
  kind: QuestKind
  done: Boolean
  failed: Boolean
  tracked: Boolean
  // The group it is meant for (an elite quest, «Группа: 3»); 0 for one played alone.
  group: Integer
  // The player can share it now: the client lets it be shared, and the player is in a group.
  shareable: Boolean
  objectives: Array<Game.QuestObjective>
}

// The log's quests, in the client's order.
public function logQuests(): Array<LogQuest> {
  return Game.questLog.quests().map(quest => LogQuest {
    id: quest.id, title: quest.title, level: quest.level, header: quest.header, kind: kindOfTag(quest.tag),
    done: quest.done, failed: quest.failed, tracked: quest.tracked, group: quest.group, shareable: quest.shareable,
    objectives: quest.objectives
  })
}
