// What Quests puts on Ordaen Map: where the tracked quests' objectives are, whom to hand a tracked quest that is
// done (while the player asks to see one quest on the map, that quest's alone, tracked or not), where the quest of a
// chain whose page shows is given, and a dungeon's quests on its card. Each pin is a spot QuestieDB knows; a quest it
// doesn't know has none. They are added to Map's `layers` while Map is on, by the root.
import Game from "$game"
import type { DungeonSection, Layer, Pin } from "OrdaenMap"
import { LogQuest } from "@/book"
import Locale from "@/locales"
import { Figure, QuestFacts } from "@/questie"

// The log's quests of a dungeon on its card on the map: those under its instance's header, «[level] title».
public class DungeonQuests implements DungeonSection {
  quests: Signal<Array<LogQuest>>
  constructor(quests: Signal<Array<LogQuest>>) { self.quests = quests }

  public lines(self, names: Array<String>): Array<String> {
    const lines: Array<String> = []
    for (quest of self.quests) {
      if (names.find(name => name == quest.header) != nil) { lines.push(`[${quest.level}] ${quest.title}`) }
    }
    return lines
  }
}

// Which of a tracked quest's places a layer shows.
public enum PinKind {
  // Where what it asks for is: while it isn't done.
  Objectives
  // Whom to hand it to: once it is done.
  TurnIns
}

// The area a quest leads to: where its first objective is while it is to do, whom to hand it to once done; else the
// zone QuestieDB puts it in; nil where it says neither.
public function leadsTo(quest: LogQuest, facts: QuestFacts): Integer | nil {
  for (figure of quest.done ? facts.takers : facts.targets) {
    const spot = figure.spots[1]
    if (spot != nil) { return spot.area }
  }
  return facts.zone > 0 ? facts.zone : nil
}

// The area a quest not taken starts in: where its first giver stands; else its zone; nil where QuestieDB says neither.
public function startsAt(facts: QuestFacts): Integer | nil {
  for (figure of facts.givers) {
    const spot = figure.spots[1]
    if (spot != nil) { return spot.area }
  }
  return facts.zone > 0 ? facts.zone : nil
}

const AVAILABLE: Asset = "Interface/GossipFrame/AvailableQuestIcon"

// Where the quest of a chain whose page shows is given, while the player asked to see it on the map: its givers'
// spots, lit, under the game's mark of a quest to take.
public class ChainPins implements Layer {
  public const id: String = "quests.givers"
  public const title: String = Locale.LAYER_GIVERS
  public const hint: String = Locale.LAYER_GIVERS_TIP

  chained: Signal<Integer>
  facts: Signal<QuestFacts | nil>
  shown: Signal<Integer>
  constructor(
    // The quest of a chain whose page shows (0: none), and QuestieDB's facts of it.
    chained: Signal<Integer>,
    facts: Signal<QuestFacts | nil>,
    // The quest the player asked to see on the map (0: none).
    shown: Signal<Integer>
  ) {
    self.chained = chained
    self.facts = facts
    self.shown = shown
  }

  public pins(self): Array<Pin> {
    const facts = self.facts
    const pins: Array<Pin> = []
    if (facts == nil || self.shown == 0 || self.shown != self.chained) { return pins }
    for (figure of facts.givers) {
      for (spot of figure.spots) {
        pins.push({ of: self.chained, area: spot.area, x: spot.x, y: spot.y, icon: AVAILABLE, lit: true })
      }
    }
    return pins
  }

  // The quest's title, then who gives it.
  public lines(self, pin: Pin): Array<String> {
    const facts = self.facts
    if (facts == nil) { return [] }
    return [facts.name, Locale.GIVEN_BY.format(facts.givers.map(figure => figure.name).join(", "))]
  }

  // Not in the log: nothing to point the way to.
  public press(self, pin: Pin, shift: Boolean) {}
}

const OBJECTIVE: Asset = "Interface/GossipFrame/IncompleteQuestIcon"
const TURN_IN: Asset = "Interface/GossipFrame/ActiveQuestIcon"

public class QuestPins implements Layer {
  public const id: String
  public const title: String
  public const hint: String

  const kind: PinKind
  quests: Signal<Array<LogQuest>>
  facts: Signal<Map<Integer, QuestFacts>>
  hovered: Signal<Integer>
  shown: Signal<Integer>
  constructor(
    kind: PinKind,
    quests: Signal<Array<LogQuest>>,
    facts: Signal<Map<Integer, QuestFacts>>,
    // The quest under the cursor in the log (0: none): its pins are lit.
    hovered: Signal<Integer> = 0,
    // The quest the player asked to see on the map (0: none): its pins alone show, tracked or not, lit.
    shown: Signal<Integer> = 0
  ) {
    self.kind = kind
    self.quests = quests
    self.facts = facts
    self.hovered = hovered
    self.shown = shown
    self.id = kind == .Objectives ? "quests.objectives" : "quests.turnIns"
    self.title = kind == .Objectives ? Locale.LAYER_OBJECTIVES : Locale.LAYER_TURN_INS
    self.hint = kind == .Objectives ? Locale.LAYER_OBJECTIVES_TIP : Locale.LAYER_TURN_INS_TIP
  }

  // The figures of the quest this layer shows, and their pins' icon; none where it shows nothing of it.
  figuresOf(self, quest: LogQuest, facts: QuestFacts): Array<Figure> {
    if (!self.shows(quest)) { return [] }
    return match (self.kind) {
      .Objectives => quest.done ? [] : facts.targets
      .TurnIns => quest.done ? facts.takers : []
    }
  }

  // The quest asked to see on the map alone while there is one, else the tracked quests.
  shows(self, quest: LogQuest): Boolean {
    return self.shown != 0 ? quest.id == self.shown : quest.tracked
  }

  public pins(self): Array<Pin> {
    const icon = self.kind == .Objectives ? OBJECTIVE : TURN_IN
    const pins: Array<Pin> = []
    for (quest of self.quests) {
      const facts = self.facts[quest.id]
      if (facts != nil) {
        for (figure of self.figuresOf(quest, facts)) {
          for (spot of figure.spots) {
            pins.push({ of: quest.id, area: spot.area, x: spot.x, y: spot.y, icon: icon, lit: quest.id == self.hovered || quest.id == self.shown })
          }
        }
      }
    }
    return pins
  }

  // The quest's title, then what is still to do, or whom to hand it to.
  public lines(self, pin: Pin): Array<String> {
    const quest = self.quests.find(quest => quest.id == pin.of)
    if (quest == nil) { return [] }
    if (self.kind == .TurnIns) { return [quest.title, Locale.TURN_IN] }
    const lines: Array<String> = [quest.title]
    for (objective of quest.objectives) {
      if (!objective.done) { lines.push(objective.text) }
    }
    return lines
  }

  // As the game's map has its quest pins: a click points the way to the quest, Shift+click stops tracking it.
  public press(self, pin: Pin, shift: Boolean) {
    if (shift) {
      Game.questLog.track(pin.of, false)
    } else {
      Game.questLog.superTrack(pin.of)
    }
  }
}
