// What Quests puts on Ordaen Map: where the tracked quests' objectives are, and whom to hand a tracked quest that is
// done. Each pin is a spot QuestieDB knows; a quest it doesn't know has none. Both are added to Map's `layers` while
// Map is on, by the root.
import Game from "$game"
import type { Layer, Pin } from "OrdaenMap"
import { LogQuest } from "@/book"
import Locale from "@/locales"
import { Figure, QuestFacts } from "@/questie"

// Which of a tracked quest's places a layer shows.
public enum PinKind {
  // Where what it asks for is: while it isn't done.
  Objectives
  // Whom to hand it to: once it is done.
  TurnIns
}

const OBJECTIVE: Asset = "Interface/GossipFrame/IncompleteQuestIcon"
const TURN_IN: Asset = "Interface/GossipFrame/ActiveQuestIcon"

public class QuestPins implements Layer {
  public const id: String
  public const title: String
  public const hint: String

  const kind: PinKind
  quests: Signal<Array<LogQuest>>
  facts: Signal<Map<Integer, QuestFacts>>
  hovered: Signal<Integer>
  constructor(
    kind: PinKind,
    quests: Signal<Array<LogQuest>>,
    facts: Signal<Map<Integer, QuestFacts>>,
    // The quest under the cursor in the log (0: none): its pins are lit.
    hovered: Signal<Integer> = 0
  ) {
    self.kind = kind
    self.quests = quests
    self.facts = facts
    self.hovered = hovered
    self.id = kind == .Objectives ? "quests.objectives" : "quests.turnIns"
    self.title = kind == .Objectives ? Locale.LAYER_OBJECTIVES : Locale.LAYER_TURN_INS
    self.hint = kind == .Objectives ? Locale.LAYER_OBJECTIVES_TIP : Locale.LAYER_TURN_INS_TIP
  }

  // The figures of the quest this layer shows, and their pins' icon; none where it shows nothing of it.
  figuresOf(self, quest: LogQuest, facts: QuestFacts): Array<Figure> {
    if (!quest.tracked) { return [] }
    return match (self.kind) {
      .Objectives => quest.done ? [] : facts.targets
      .TurnIns => quest.done ? facts.takers : []
    }
  }

  public pins(self): Array<Pin> {
    const icon = self.kind == .Objectives ? OBJECTIVE : TURN_IN
    const pins: Array<Pin> = []
    for (quest of self.quests) {
      const facts = self.facts[quest.id]
      if (facts != nil) {
        for (figure of self.figuresOf(quest, facts)) {
          for (spot of figure.spots) {
            pins.push({ of: quest.id, area: spot.area, x: spot.x, y: spot.y, icon: icon, lit: quest.id == self.hovered })
          }
        }
      }
    }
    return pins
  }

  // The quest's title, then what is still to do, or whom to hand it to.
  public lines(self, pin: Pin): Array<String> {
    const quest = self.quests.find(quest => quest.id == pin.of)
    if (quest == nil) { return [] }
    if (self.kind == .TurnIns) { return [quest.title, Locale.TURN_IN] }
    const lines: Array<String> = [quest.title]
    for (objective of quest.objectives) {
      if (!objective.done) { lines.push(objective.text) }
    }
    return lines
  }

  // As the game's map has its quest pins: a click points the way to the quest, Shift+click stops tracking it.
  public press(self, pin: Pin, shift: Boolean) {
    if (shift) {
      Game.questLog.track(pin.of, false)
    } else {
      Game.questLog.superTrack(pin.of)
    }
  }
}
