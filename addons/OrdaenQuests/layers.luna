// What Quests puts on Ordaen Map, of the quest the player asked to see on the map alone: whom to hand it to once it
// is done, where the quest of a chain whose page shows is given; and a dungeon's quests on its card. Each pin is a
// spot QuestieDB knows; a quest it doesn't know has none. They are added to Map's `layers` while Map is on, by the root.
import Game from "$game"
import type { DungeonSection, Layer, Pin } from "OrdaenMap"
import { LogQuest } from "@/book"
import Locale from "@/locales"
import { Figure, QuestFacts, Spot } from "@/questie"

// The log's quests of a dungeon on its card on the map: those under its instance's header, «[level] title».
public class DungeonQuests implements DungeonSection {
  quests: Signal<array<LogQuest>>
  constructor(quests: Signal<array<LogQuest>>) { self.quests = quests }

  public lines(names: array<string>): array<string> {
    const lines: array<string> = mut []
    for (quest of self.quests) {
      if (names.find(name => name == quest.header) != nil) { lines.push(`[${quest.level}] ${quest.title}`) }
    }
    return lines
  }
}

// The area a quest leads to: where its first objective is while it is to do, whom to hand it to once done; else the
// zone QuestieDB puts it in; nil where it says neither.
public function leadsTo(quest: LogQuest, facts: QuestFacts): integer | nil {
  for (figure of quest.done ? facts.takers : facts.targets) {
    const spot = figure.spots[1]
    if (spot != nil) { return spot.area }
  }
  return facts.zone > 0 ? facts.zone : nil
}

// The area a quest not taken starts in: where its first giver stands; else its zone; nil where QuestieDB says neither.
public function startsAt(facts: QuestFacts): integer | nil {
  for (figure of facts.givers) {
    const spot = figure.spots[1]
    if (spot != nil) { return spot.area }
  }
  return facts.zone > 0 ? facts.zone : nil
}

const AVAILABLE: Asset = "Interface/GossipFrame/AvailableQuestIcon"

// Where the quest of a chain whose page shows is given, while the player asked to see it on the map: its givers'
// spots, lit, under the game's mark of a quest to take.
public class ChainPins implements Layer {
  public const id: string = "quests.givers"
  public const title: string = Locale::LAYER_GIVERS
  public const hint: string = Locale::LAYER_GIVERS_TIP

  chained: Signal<integer>
  facts: Signal<QuestFacts | nil>
  shown: Signal<integer>
  constructor(
    // The quest of a chain whose page shows (0: none), and QuestieDB's facts of it.
    chained: Signal<integer>,
    facts: Signal<QuestFacts | nil>,
    // The quest the player asked to see on the map (0: none).
    shown: Signal<integer>
  ) {
    self.chained = chained
    self.facts = facts
    self.shown = shown
  }

  public pins(): array<Pin> {
    const facts = self.facts
    const pins: array<Pin> = mut []
    if (facts == nil || self.shown == 0 || self.shown != self.chained) { return pins }
    for (figure of facts.givers) {
      for (spot of figure.spots) {
        pins.push({ of: self.chained, area: spot.area, x: spot.x, y: spot.y, icon: AVAILABLE, lit: true })
      }
    }
    return pins
  }

  // The quest's title, then who gives it.
  public lines(pin: Pin): array<string> {
    const facts = self.facts
    if (facts == nil) { return [] }
    return [facts.name, Locale::GIVEN_BY.format(facts.givers.map(figure => figure.name).join(", "))]
  }

  // Not in the log: nothing to point the way to.
  public press(pin: Pin, shift: boolean) {}
}

const TURN_IN: Asset = "Interface/GossipFrame/ActiveQuestIcon"

// Whom to hand the quest the player asked to see on the map, once it is done: its takers' spots, lit. Where it is to
// do, the game's own shaded area of its objectives shows (Map's), and nothing of this layer.
public class TurnInPins implements Layer {
  public const id: string = "quests.turnIns"
  public const title: string = Locale::LAYER_TURN_INS
  public const hint: string = Locale::LAYER_TURN_INS_TIP

  quests: Signal<array<LogQuest>>
  facts: Signal<map<integer, QuestFacts>>
  shown: Signal<integer>
  constructor(
    quests: Signal<array<LogQuest>>,
    facts: Signal<map<integer, QuestFacts>>,
    // The quest the player asked to see on the map (0: none).
    shown: Signal<integer>
  ) {
    self.quests = quests
    self.facts = facts
    self.shown = shown
  }

  public pins(): array<Pin> {
    const pins: array<Pin> = mut []
    const quest = self.quests.find(quest => quest.id == self.shown)
    const facts = self.facts[self.shown]
    if (quest == nil || facts == nil || !quest.done) { return pins }
    for (figure of facts.takers) {
      for (spot of figure.spots) {
        pins.push({ of: quest.id, area: spot.area, x: spot.x, y: spot.y, icon: TURN_IN, lit: true })
      }
    }
    return pins
  }

  // The quest's title, then that it is turned in there.
  public lines(pin: Pin): array<string> {
    const quest = self.quests.find(quest => quest.id == pin.of)
    return quest == nil ? [] : [quest.title, Locale::TURN_IN]
  }

  // As the game's map has its quest pins: a click points the way to the quest, Shift+click stops tracking it.
  public press(pin: Pin, shift: boolean) {
    if (shift) {
      Game::questLog.track(pin.of, false)
    } else {
      Game::questLog.superTrack(pin.of)
    }
  }
}

const NPC: Asset = "Interface/GossipFrame/GossipGossipIcon"

// An NPC and one of its spots.
public struct FigureSpot {
  figure: Figure
  spot: Spot
}

// Of the figures' spots, the one nearest the player by `distance` (nil: not measurable, another continent); where
// none is measurable, the first figure's first spot; nil where none has a spot.
public function nearestOf(figures: array<Figure>, distance: (spot: Spot) => number | nil): FigureSpot | nil {
  let best: FigureSpot | nil = nil
  let bestYards = 0.0
  let first: FigureSpot | nil = nil
  for (figure of figures) {
    for (spot of figure.spots) {
      if (first == nil) { first = mut { figure: figure, spot: spot } }
      const yards = distance(spot)
      if (yards != nil && (best == nil || yards < bestYards)) {
        best = mut { figure: figure, spot: spot }
        bestYards = yards
      }
    }
  }
  return best ?? first
}

// Of a figure's spots, the distance to the nearest by `distance`; nil where none is measurable.
public function nearestYards(figure: Figure, distance: (spot: Spot) => number | nil): number | nil {
  let best: number | nil = nil
  for (spot of figure.spots) {
    const yards = distance(spot)
    if (yards != nil && (best == nil || yards < best)) { best = yards }
  }
  return best
}

// The NPC another module asked to see on the map (a trainer or a vendor of a recipe): its spots, lit, its name in the
// tooltip, until the map hides.
public class NpcPins implements Layer {
  public const id: string = "quests.npc"
  public const title: string = Locale::LAYER_NPC
  public const hint: string = Locale::LAYER_NPC_TIP

  shown: Signal<Figure | nil>
  constructor(shown: Signal<Figure | nil>) { self.shown = shown }

  public pins(): array<Pin> {
    const figure = self.shown
    const pins: array<Pin> = mut []
    if (figure == nil) { return pins }
    for (spot of figure.spots) {
      pins.push({ of: figure.id, area: spot.area, x: spot.x, y: spot.y, icon: NPC, lit: true })
    }
    return pins
  }

  public lines(pin: Pin): array<string> { return [self.shown?.name ?? ""] }

  public press(pin: Pin, shift: boolean) {}
}
