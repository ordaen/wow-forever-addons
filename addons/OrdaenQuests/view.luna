// The quest log's parts: a header of the list (it folds), a quest's row, and the picked quest's page.
//
// A row as the client's log has it: the level in its difficulty colour (two digits' room), a dim bullet, the title, an elite
// quest's «Группа: 3», at the title's right the experience and money it gives; under the title its objectives, each
// wrapped at the text's own line with its count at the right, grey once done, or «Готово» / «Провалено» in their
// place. Left-click picks it (its page shows beside the list); Shift+Left-click and Space track it or stop tracking
// it; Right-click opens its menu: track, share, abandon.
import Game from "$game"
import { Align, Art, Bounds, ByInteractionState, Edges, Line, Side, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { ButtonPlate, Component, Cut, Menu, MenuEntry, Money, PushButton, SECONDARY_TEXT, Shown, SwitchFace, Tip, TipText, questLevelColor, rowShade } from "Ordaen"
import { Experience, Named, Reward, RewardView, Rewards, SCROLL_DIM, SCROLL_ROW, Scroll, ScrollHeading, ScrollText, Standing, WELL_TEXT, WIDE_SCROLL, choiceViews, logReward, scrollOverflows } from "OrdaenQuestPage"
import { LogQuest } from "@/book"
import Locale from "@/locales"
import { namedOf, namedOfFacts } from "@/names"
import { QuestFacts } from "@/questie"
import { standingsOf } from "@/reputation"

// What the player asks of a quest from its row or its page. `Link`: Shift+Left-click on its title, a chat link where a
// chat line is open, else tracking (the game's order). `ShowNext`: the next quest of a chain, by its id, opens its page
// in the chain's window.
public enum Act { Pick, Track, Link, Share, Abandon, ShowOnMap, SuperTrack, ShowNext }

const INK: Color = Color.hex("#e8dcc4")
// What the player's clicks on a quest's row do, in its tooltip.
const ROW_KEYS: Array<String> = [Locale.ROW_KEY_PAGE, Locale.ROW_KEY_LINK, Locale.ROW_KEY_MENU]
const GOLD: Color = Color.hex("#ffd100")
const DIM: Color = Color.hex("#a3977f")
const GREEN: Color = Color.hex("#40c040")
// Between the page's parts; the buttons stand further off the tracking switch.
const PAGE_GAP = 4sp
const BUTTONS_OFF = 3sp
const RED: Color = Color.hex("#ff4040")
// A row starts at its header's left: the header's band, not an indent, says what it stands under.
// Above and below its text alike: the rule above a row stands as far from its text as the next row's does.
const ROW_PAD: Edges = { top: 4sp, right: 2sp, bottom: 4sp, left: 2sp }
// The rule between two quests of a list.
const ROW_RULE: Line = { width: 1.171875dp, color: Color.hex("#d6a56b26"), sides: [Side.Top] }
const BUTTON = 131.25dp

// The client opens the map for an addon out of a fight alone: «Show on map» is off in one, its tip says why.
function mapTipOf(combat: Boolean): TipText | nil {
  return combat ? { title: Locale.SHOW_ON_MAP, text: Locale.MAP_IN_COMBAT, rows: [] } : nil
}
// The bullet between a row's level and its title, and between what a quest gives: dimmer than the dim text it parts.
const BULLET = "•"
const BULLET_COLOR: Color = Color.hex("#6b6352")
// The tens of a level under 10: an unseen «0», so no title moves.
const UNSEEN: Color = Color.hex("#00000000")
// A row's title line: its level, the bullet, its title, a group quest's size, what it gives. Its objectives stand under
// the whole line, from the level's edge.
const TITLE_LINE: Array<Track> = ["max-content", "max-content", { fr: 1 }, "max-content", "max-content"]
const HEADER_PAD: Edges = { top: 3sp, right: 2sp, bottom: 3sp, left: 2sp }
// A header's band: a gold wash over the well's floor, a brighter line under it, so it reads apart from its quests.
const HEADER_BAND: Color = Color.hex("#d6a56b38")
const HEADER_LINE: Line = { width: 1.171875dp, color: Color.hex("#d6a56b66"), sides: [Side.Bottom] }
// Between two objectives of a quest: what a wrapped one's lines don't have.
const GOAL_GAP = 1sp
// The fold mark's cell, as a tree's row has it.
const MARK = 18.75dp

// A text a quest's row ends with: «Готово», «Провалено», or none while it is in progress (its objectives say how far).
function stateOf(quest: LogQuest): String {
  if (quest.failed) { return Locale.FAILED }
  if (quest.done) { return Locale.DONE }
  return ""
}

// The header of a group: a fold mark and the header's text; «вы здесь» beside the player's zone; at the right how
// many of its quests are complete of all of them, «1/3».
public class HeaderRow implements Component {
  public fold: Event<String> = new Event()

  derived mark: Art = self.folded ? Ordaen.art.ctl.markClosed : Ordaen.art.ctl.markOpen
  derived counter: String = `${self.quests.filter(quest => quest.done).length}/${self.quests.length}`

  header: Signal<String>
  here: Signal<Boolean>
  folded: Signal<Boolean>
  quests: Signal<Array<LogQuest>>
  constructor(header: Signal<String>, here: Signal<Boolean>, folded: Signal<Boolean>, quests: Signal<Array<LogQuest>>) {
    self.header = header
    self.here = here
    self.folded = folded
    self.quests = quests
  }

  onFold(mut self) { self.fold.emit(self.header) }

  public render(self): Template {
    return $ltml {
      <box columns={["max-content", "max-content", { fr: 1 }, "max-content"]} gap={2sp} yAlign={Align.Center}
           padding={HEADER_PAD} background={HEADER_BAND} border={HEADER_LINE}
           @pointerPress={self.onFold} @keyPress(.Enter)={self.onFold} @keyPress(.Space)={self.onFold}>
        <box width={MARK} height={MARK} background={self.mark} tint={DIM} />
        <text value={self.header} textColor={GOLD} wrap={.None} />
        <text $if={self.here} value={Locale.HERE} textColor={DIM} textSize={SECONDARY_TEXT} wrap={.None} />
        <box $else />
        <text value={self.counter} textColor={DIM} textSize={SECONDARY_TEXT} textFont={.Numbers} wrap={.None} />
      </box>
    }
  }
}

public class QuestRow implements Component {
  public act: Event<(Integer, Act)> = new Event()

  state menuOpen = false
  state hovered = false
  // Its tooltip, as the game's log's: what is left to do (the quest's task), or that it is done or failed, and what the
  // player's clicks on it do. The task is asked of the client while the tooltip shows.
  derived tipShown: Boolean = self.hovered && !self.menuOpen
  derived tipText: String = self.ended ? self.progress : Game.questLog.text(self.quest.id).task
  // The level as two digits, each its own text of the numbers' font (whose digits are of one width): the tens unseen
  // under 10, so every level takes two digits' room. A group quest's «+» after them.
  derived tens: String = self.quest.level >= 10 ? String.of((self.quest.level / 10).floor() % 10) : "0"
  derived tensColor: Color = self.quest.level >= 10 ? self.levelColor : UNSEEN
  derived ones: String = `${self.quest.level % 10}${self.quest.group > 1 ? "+" : ""}`
  // Complete or failed: said under the title in place of its objectives.
  derived ended: Boolean = self.progress != ""
  // Its objectives still to do: one done leaves the list (the page says them all).
  derived goalsLeft: Array<Game.QuestObjective> = self.quest.objectives.filter(objective => !objective.done)
  derived levelColor: Color = questLevelColor(self.quest.level, self.player, INK)
  derived progress: String = stateOf(self.quest)
  derived progressColor: Color = self.quest.failed ? RED : GREEN
  derived background: Color | ByInteractionState<Color> = rowShade(self.picked)
  derived group: String = self.quest.group > 1 ? Locale.GROUP.format(self.quest.group) : ""
  derived entries: Array<MenuEntry> = [
    { label: self.quest.tracked ? Locale.UNTRACK : Locale.TRACK },
    { label: Locale.SUPER_TRACK },
    { label: Locale.SHARE, disabled: !self.quest.shareable },
    { label: Locale.ABANDON, group: true }
  ]

  derived rule: Line | nil = self.ruled ? ROW_RULE : nil

  quest: Signal<LogQuest>
  picked: Signal<Boolean>
  player: Signal<Integer>
  ruled: Signal<Boolean>
  constructor(
    quest: Signal<LogQuest>,
    picked: Signal<Boolean>,
    player: Signal<Integer>,
    // A quest after another of its list: a rule above it.
    ruled: Signal<Boolean> = false
  ) {
    self.quest = quest
    self.picked = picked
    self.player = player
    self.ruled = ruled
  }

  onPick(mut self) { self.act.emit(self.quest.id, Act.Pick) }
  onTrack(mut self) { self.act.emit(self.quest.id, Act.Track) }
  onLink(mut self) { self.act.emit(self.quest.id, Act.Link) }
  onMenu(mut self) { self.menuOpen = true }
  onClose(mut self) { self.menuOpen = false }
  onEnter(mut self) {
    self.hovered = true
  }
  onLeave(mut self) {
    self.hovered = false
  }

  onEntry(mut self, index: Integer) {
    self.menuOpen = false
    const act = match (index) {
      1 => Act.Track
      2 => Act.SuperTrack
      3 => Act.Share
      else => Act.Abandon
    }
    self.act.emit(self.quest.id, act)
  }

  public render(self): Template {
    return $ltml {
      <box columns={1} gap={GOAL_GAP} padding={ROW_PAD} background={self.background} border={self.rule}
           @pointerPress(.Left)={self.onPick} @pointerPress([.Shift, .Left])={self.onLink}
           @pointerPress(.Right)={self.onMenu} @keyPress(.Enter)={self.onPick} @keyPress(.Space)={self.onTrack}
           @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <Tip $if={self.tipShown} title={self.quest.title} text={self.tipText} keys={ROW_KEYS} />
        <box columns={TITLE_LINE} gap={2sp} yAlign={Align.Center}>
          <box columns={{ each: "max-content" }}>
            <text value={self.tens} textColor={self.tensColor} textFont={.Numbers} wrap={.None} />
            <text value={self.ones} textColor={self.levelColor} textFont={.Numbers} wrap={.None} />
          </box>
          <text value={BULLET} textColor={BULLET_COLOR} wrap={.None} />
          <text value={self.quest.title} textColor={INK} wrap={.None} />
          <text value={self.group} textColor={DIM} textSize={SECONDARY_TEXT} wrap={.None} />
          <Gains xp={self.quest.xp} money={self.quest.money} />
        </box>
        <text $if={self.ended} value={self.progress} textColor={self.progressColor} textSize={SECONDARY_TEXT}
              leading={.Tight} />
        <$else>
          <GoalLine $for={objective of self.goalsLeft} objective={objective} />
        </>
        <Menu $if={self.menuOpen} entries={self.entries} title={self.quest.title} @pick={self.onEntry}
              @close={self.onClose} />
      </box>
    }
  }
}

// What a quest gives, at its title's right: its experience and its money, a dim bullet between them; nothing where it
// gives neither, and no room after one alone.
class Gains implements Component {
  derived both: Boolean = self.xp > 0 && self.money > 0

  xp: Signal<Integer>
  money: Signal<Integer>
  constructor(xp: Signal<Integer>, money: Signal<Integer>) {
    self.xp = xp
    self.money = money
  }

  public render(self): Template {
    return $ltml {
      <box columns={{ each: "max-content" }} gap={3sp} yAlign={Align.Center}>
        <Experience $if={self.xp > 0} amount={self.xp} color={DIM} />
        <text $if={self.both} value={BULLET} textColor={BULLET_COLOR} wrap={.None} />
        <Money $if={self.money > 0} amount={self.money} color={DIM} />
      </box>
    }
  }
}

// An objective's text as the client gives it («Defias slain: 3/10»): what is to be done, and its count; a text
// without a count is all what.
public function goalParts(text: String): (String, String) {
  const what, count = text.match("^(.-):%s*(%d+%s*/%s*%d+)$")
  if (what == nil || count == nil) { return text, "" }
  return what, count
}

// One objective: what is to be done, wrapped, in `color`, and at its right its count, or the client's green check once
// it is done.
class GoalLine implements Component {
  derived what: String = whatOf(self.objective.text)
  derived count: String = countOf(self.objective.text)
  derived done: Boolean = self.objective.done

  objective: Signal<Game.QuestObjective>
  color: Signal<Color>
  // The list's small lines; the page's are the body's size.
  small: Signal<Boolean>
  constructor(objective: Signal<Game.QuestObjective>, color: Signal<Color> = DIM, small: Signal<Boolean> = true) {
    self.objective = objective
    self.color = color
    self.small = small
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.small} columns={[{ fr: 1 }, "max-content"]} gap={2sp}>
        <text value={self.what} textColor={self.color} textSize={SECONDARY_TEXT} leading={.Tight} />
        <box $if={self.done} width={CHECK_SMALL} height={CHECK_SMALL} background={CHECK} />
        <text $else value={self.count} textColor={self.color} textSize={SECONDARY_TEXT} textFont={.Numbers}
              leading={.Tight} wrap={.None} />
      </box>
      <box $else columns={[{ fr: 1 }, "max-content"]} gap={2sp} yAlign={Align.Start}>
        <text value={self.what} textColor={self.color} leading={.Tight} />
        <box $if={self.done} width={CHECK_SIZE} height={CHECK_SIZE} background={CHECK} />
        <text $else value={self.count} textColor={self.color} textFont={.Numbers} leading={.Tight} wrap={.None} />
      </box>
    }
  }
}

// The client's green check of a ready check: a goal done.
const CHECK: Asset = "Interface/RaidFrame/ReadyCheck-Ready"
const CHECK_SIZE = 18.75dp
const CHECK_SMALL = 16.40625dp

function whatOf(text: String): String {
  const what, _ = goalParts(text)
  return what
}

function countOf(text: String): String {
  const _, count = goalParts(text)
  return count
}

// A section under the scroll: the cut with its title, then what it holds.
const SECTION_GAP = 1sp
// The scroll's row: its least height unfolded, its own height folded.
function scrollRow(folded: Boolean): Track {
  if (folded) { return "max-content" }
  return SCROLL_ROW
}
const BUTTON_ALONE: Array<Track> = ["max-content", { fr: 1 }]

// The line under a quest's parchment: the quest after it in its chain, by QuestieDB's name, in gold as a link; a
// click, Enter or Space opens that quest's page. Nothing where QuestieDB knows none.
public class ChainLine implements Component {
  public open: Event<Integer> = new Event()

  derived next: Integer = self.facts?.next ?? 0
  derived name: String = self.next > 0 ? self.facts?.nextName ?? "" : ""

  facts: Signal<QuestFacts | nil>
  constructor(facts: Signal<QuestFacts | nil>) {
    self.facts = facts
  }

  onOpen(mut self) { self.open.emit(peek self.next) }

  public render(self): Template {
    return $ltml {
      <box $if={self.name != ""} gap={SECTION_GAP}>
        <Cut title={Locale.NEXT_IN_CHAIN} />
        <box @pointerPress={self.onOpen} @keyPress(.Enter)={self.onOpen} @keyPress(.Space)={self.onOpen}>
          <text value={self.name} textColor={GOLD} />
        </box>
      </box>
    }
  }
}

// A quest of a chain not in the log, as QuestieDB knows it: on the scroll its title, its level and the level it may be
// taken at, what it asks; under it the quest after it, and «Show on map», which shows where it is given.
public class ChainPage implements Component {
  public act: Event<(Integer, Act)> = new Event()

  // Folded as each quest opens where the settings say so; a click unfolds it.
  state folded = false
  derived levels: String = Locale.CHAIN_LEVELS.format(self.facts.level, self.facts.minLevel)
  // The things its task names, marked on the parchment.
  derived named: Array<Named> = namedOf(self.facts)
  derived combat: Boolean = Game.situation.combat
  derived mapTip: TipText | nil = mapTipOf(self.combat)
  // Its scroll, the line of the quest after it, its button.
  derived rows: Array<Track> = [scrollRow(self.folded), "max-content", "max-content"]

  quest: Signal<Integer>
  facts: Signal<QuestFacts>
  foldFirst: Signal<Boolean>
  constructor(quest: Signal<Integer>, facts: Signal<QuestFacts>, foldFirst: Signal<Boolean> = false) {
    self.quest = quest
    self.facts = facts
    self.foldFirst = foldFirst
    watch (id of self.quest) { self.folded = peek self.foldFirst }
  }

  onNext(mut self, next: Integer) { self.act.emit(next, Act.ShowNext) }
  onMap(mut self) { self.act.emit(self.quest, Act.ShowOnMap) }

  public render(self): Template {
    return $ltml {
      <box rows={self.rows} gap={PAGE_GAP}>
        <Scroll title={self.facts.name} folded={mut self.folded}>
          <text value={self.levels} textColor={SCROLL_DIM} />
          <ScrollHeading $if={self.facts.task != ""} title={Locale.SECTION_TASKS} />
          <ScrollText $if={self.facts.task != ""} value={self.facts.task} names={self.named} />
        </Scroll>
        <ChainLine facts={self.facts} @open={self.onNext} />
        <box columns={BUTTON_ALONE}>
          <PushButton label={Locale.SHOW_ON_MAP} width={BUTTON} disabled={self.combat} tip={self.mapTip} @click={self.onMap} />
          <box />
        </box>
      </box>
    }
  }
}
// The tracking switch's row: its label at the start, the switch at the page's right edge, over the Abandon button.
const LABEL_THEN_SWITCH: Array<Track> = [{ fr: 1 }, "max-content"]

// The picked quest's page, as Dialogue's quest page: on the scroll its title, its story and its task, the lore alone;
// under it its objectives (each wrapped, its count at the right), the next quest of its chain (QuestieDB's), what it gives, the library's reward
// rows and band; then its tracking switch, and its buttons (`QuestButtons`) under it where its window has no footer
// band for them. Abandoning asks first.
public class QuestPage implements Component {
  public act: Event<(Integer, Act)> = new Event()

  derived tracking: Shown = self.quest.tracked ? Shown.On : Shown.Off
  // Its objectives under the task: one that says the task again (a quest without counted objectives, whose one
  // objective is the task's own text) isn't said twice.
  derived goals: Array<Game.QuestObjective> = self.quest.objectives.filter(objective => objective.text != self.text.task)
  derived choiceRows: Array<RewardView> = choiceViews(rewardsOf(self.text.choices, true), [])
  derived givenRows: Array<Reward> = rewardsOf(self.text.rewards, false)
  derived standings: Array<Standing> = standingsOf(self.facts?.reputation ?? [])
  // The things its story and task name (QuestieDB's), marked on the parchment; none for a quest it doesn't know.
  derived named: Array<Named> = namedOfFacts(self.facts)
  // Folded as each quest opens where the settings say so; a click unfolds it.
  state folded = false
  derived questId: Integer = self.quest.id
  // Stacked: the scroll takes the room left; folded, the room left stands over the tracking switch.
  derived rows: Array<Track> = [scrollRow(self.folded), "max-content", self.folded ? FILL_ROW : CONTENT_ROW]
  derived wide: Boolean = !self.folded && scrollOverflows(self.quest.title, [self.text.story, Locale.SECTION_TASKS, self.text.task])

  quest: Signal<LogQuest>
  text: Signal<Game.QuestText>
  facts: Signal<QuestFacts | nil>
  player: Signal<Integer>
  foldFirst: Signal<Boolean>
  // Its buttons stand in its window's footer band (`QuestButtons`), not under it.
  footed: Signal<Boolean>
  constructor(
    quest: Signal<LogQuest>,
    text: Signal<Game.QuestText>,
    facts: Signal<QuestFacts | nil>,
    player: Signal<Integer>,
    foldFirst: Signal<Boolean> = false,
    footed: Signal<Boolean> = false
  ) {
    self.quest = quest
    self.text = text
    self.facts = facts
    self.player = player
    self.foldFirst = foldFirst
    self.footed = footed
    watch (id of self.questId) { self.folded = peek self.foldFirst }
  }

  onTrack(mut self) { self.act.emit(self.quest.id, Act.Track) }
  onAct(mut self, id: Integer, act: Act) { self.act.emit(id, act) }
  onNext(mut self, next: Integer) { self.act.emit(next, Act.ShowNext) }

  // Its scroll beside the rest, the page's whole height, where what it holds would overflow it at its least height;
  // over the rest otherwise.
  public render(self): Template {
    return $ltml {
      <box $if={self.wide} columns={WIDE_COLUMNS} rows={ONE_ROW} gap={PAGE_GAP}>
        {self.scroll()}
        <box width={DETAILS_LEAST} rows={DETAIL_ROWS} gap={PAGE_GAP}>
          {self.details()}
        </box>
      </box>
      <box $else rows={self.rows} gap={PAGE_GAP}>
        {self.scroll()}
        {self.details()}
      </box>
    }
  }

  scroll(self): Template {
    return $ltml {
      <Scroll title={self.quest.title} folded={mut self.folded}>
        <ScrollText $if={self.text.story != ""} value={self.text.story} names={self.named} />
        <ScrollHeading title={Locale.SECTION_TASKS} />
        <ScrollText $if={self.text.task != ""} value={self.text.task} names={self.named} />
      </Scroll>
    }
  }

  // What stands under the scroll, or beside it: the progress, the chain's next quest, the rewards, the tracking
  // switch, and the buttons where the window has no footer band for them.
  // Two parts, each always there: the sections from the top, and the foot (the tracking switch, and the buttons where
  // the window has no footer band for them) at the bottom of what is left.
  details(self): Template {
    return $ltml {
      <box gap={PAGE_GAP}>
        <box $if={self.goals.length > 0} gap={SECTION_GAP}>
          <Cut title={Locale.SECTION_PROGRESS} />
          <box gap={GOAL_GAP}>
            <GoalLine $for={objective of self.goals} objective={objective} color={WELL_TEXT}
                      small={false} />
          </box>
        </box>
        <ChainLine facts={self.facts} @open={self.onNext} />
        <box gap={0.5sp}>
          <Rewards views={self.choiceRows} also={self.givenRows} xp={self.text.experience} money={self.text.money}
                   standings={self.standings} paired={true} />
        </box>
      </box>
      <box yAlign={Align.End}>
        <box columns={LABEL_THEN_SWITCH} yAlign={Align.Center} @pointerPress={self.onTrack} @keyPress(.Enter)={self.onTrack}
             @keyPress(.Space)={self.onTrack}>
          <text value={Locale.TRACK} textColor={WELL_TEXT} />
          <SwitchFace state={self.tracking} />
        </box>
        <box $if={!self.footed} padding={{ top: BUTTONS_OFF }}>
          <QuestButtons quest={self.quest} @act={self.onAct} />
        </box>
      </box>
    }
  }
}

// A wide page: the scroll at its art's width, the rest beside it never narrower than `DETAILS_LEAST` (a least of its
// own, which the side grows for); the scroll the whole height, the rest from the top.
const WIDE_COLUMNS: Array<Track> = [WIDE_SCROLL, { fr: 1 }]
const DETAILS_LEAST: Bounds = { min: 375dp, max: nil }
const ONE_ROW: Array<Track> = [{ fr: 1 }]
const FILL_ROW: Track = { fr: 1 }
const CONTENT_ROW: Track = "max-content"
// Beside the scroll the sections from the top, the foot taking the room left (its switch at its bottom).
const DETAIL_ROWS: Array<Track> = ["max-content", { fr: 1 }]

// A quest's buttons: Abandon, the accent one, at the left; at the right «Share» while the player can share it (in a
// group, a quest the client lets be shared) and «Show on map» (not in a fight), the outermost. In a window's footer band, or under the page where
// it stands on its own.
public class QuestButtons implements Component {
  public act: Event<(Integer, Act)> = new Event()

  derived combat: Boolean = Game.situation.combat
  derived mapTip: TipText | nil = mapTipOf(self.combat)

  quest: Signal<LogQuest>
  constructor(quest: Signal<LogQuest>) {
    self.quest = quest
  }

  onShare(mut self) { self.act.emit(self.quest.id, Act.Share) }
  onAbandon(mut self) { self.act.emit(self.quest.id, Act.Abandon) }
  onMap(mut self) { self.act.emit(self.quest.id, Act.ShowOnMap) }

  public render(self): Template {
    return $ltml {
      <box columns={["max-content", { fr: 1 }, "max-content", "max-content"]} gap={3sp} yAlign={Align.Center}>
        <PushButton label={Locale.ABANDON} width={BUTTON} plate={ButtonPlate.Accent} @click={self.onAbandon} />
        <box />
        <PushButton $if={self.quest.shareable} label={Locale.SHARE} width={BUTTON} @click={self.onShare} />
        <box $else />
        <PushButton label={Locale.SHOW_ON_MAP} width={BUTTON} disabled={self.combat} tip={self.mapTip} @click={self.onMap} />
      </box>
    }
  }
}

// A quest's items as the reward rows show them: the choices numbered by their place, what is given anyway 0.
function rewardsOf(items: Array<Game.QuestItem>, chosen: Boolean): Array<Reward> {
  let rows: Array<Reward> = []
  for (index, item of items) { rows.push(logReward(item.item, item.count, chosen ? index : 0)) }
  return rows
}
