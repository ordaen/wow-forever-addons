// The quest log's parts: a header of the list (it folds), a quest's row, and the picked quest's page.
//
// A row as the client's log has it: the level in its difficulty colour between muted brackets, the title, an elite
// quest's «Группа: 3», at the title's right the experience and money it gives; under the title its objectives, each
// wrapped at the text's own line with its count at the right, grey once done, or «Готово» / «Провалено» in their
// place. Left-click picks it (its page shows beside the list); Shift+Left-click and Space track it or stop tracking
// it; Right-click opens its menu: track, share, abandon.
import Game from "$game"
import { Align, Art, ByInteractionState, Edges, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { BODY_LINE, ButtonPlate, Component, Experience, Menu, MenuEntry, Money, PushButton, Reward, RewardView, Rewards, SCROLL_DIM, SCROLL_HEAD, SCROLL_INK, SECONDARY_TEXT, Scroll, Shown, SwitchFace, TIGHT_LINE, TITLE_TEXT, Tip, WELL_DIM, WELL_TEXT, XP_MARK_SMALL, choiceViews, logReward, questLevelColor, rowShade } from "Ordaen"
import { LogQuest } from "@/book"
import Locale from "@/locales"
import { Figure, QuestFacts } from "@/questie"

// What the player asks of a quest from its row or its page. `Link`: Shift+Left-click on its title, a chat link where a
// chat line is open, else tracking (the game's order).
public enum Act { Pick, Track, Link, Share, Abandon, ShowOnMap, SuperTrack, Hover, Unhover }

const INK: Color = Color.hex("#e8dcc4")
// What the player's clicks on a quest's row do, in its tooltip.
const ROW_KEYS: Array<String> = [Locale.ROW_KEY_PAGE, Locale.ROW_KEY_LINK, Locale.ROW_KEY_MENU]
const GOLD: Color = Color.hex("#ffd100")
const DIM: Color = Color.hex("#a3977f")
const GREEN: Color = Color.hex("#40c040")
const GREY: Color = Color.hex("#808080")
const RED: Color = Color.hex("#ff4040")
const ROW_PAD: Edges = { top: 2sp, right: 2sp, bottom: 2sp, left: 5sp }
const BUTTON = 131.25dp
// The level's brackets in the muted colour around its number.
const LEVEL_CELLS: Array<Track> = ["max-content", "max-content", "max-content"]
const GAIN_CELLS: Array<Track> = ["max-content", "max-content", "max-content"]
const HEADER_PAD: Edges = { top: 2sp, right: 2sp, bottom: 2sp }
// Between two objectives of a quest: what a wrapped one's lines don't have.
const GOAL_GAP = 1sp
// The fold mark's cell, as a tree's row has it.
const MARK = 18.75dp

// A text a quest's row ends with: «Готово», «Провалено», or none while it is in progress (its objectives say how far).
function stateOf(quest: LogQuest): String {
  if (quest.failed) { return Locale.FAILED }
  if (quest.done) { return Locale.DONE }
  return ""
}

// The header of a group: a fold mark and the header's text; «вы здесь» beside the player's zone; at the right how
// many of its quests are complete of all of them, «1/3».
public class HeaderRow implements Component {
  public fold: Event<String> = new Event()

  derived mark: Art = self.folded ? Ordaen.art.ctl.markClosed : Ordaen.art.ctl.markOpen
  derived counter: String = `${self.quests.filter(quest => quest.done).length}/${self.quests.length}`

  header: Signal<String>
  here: Signal<Boolean>
  folded: Signal<Boolean>
  quests: Signal<Array<LogQuest>>
  constructor(header: Signal<String>, here: Signal<Boolean>, folded: Signal<Boolean>, quests: Signal<Array<LogQuest>>) {
    self.header = header
    self.here = here
    self.folded = folded
    self.quests = quests
  }

  onFold(mut self) { self.fold.emit(self.header) }

  public render(self): Template {
    return $ltml {
      <box columns={["max-content", "max-content", { fr: 1 }, "max-content"]} gap={2sp} yAlign={Align.Center}
           padding={HEADER_PAD} background={rowShade(false)}
           @pointerPress={self.onFold} @keyPress(.Enter)={self.onFold} @keyPress(.Space)={self.onFold}>
        <box width={MARK} height={MARK} background={self.mark} tint={DIM} />
        <text value={self.header} textColor={GOLD} wrap={.None} />
        <text $if={self.here} value={Locale.HERE} textColor={DIM} textSize={SECONDARY_TEXT} wrap={.None} />
        <box $else />
        <text value={self.counter} textColor={DIM} textSize={SECONDARY_TEXT} textFont={.Numbers} wrap={.None} />
      </box>
    }
  }
}

public class QuestRow implements Component {
  public act: Event<(Integer, Act)> = new Event()

  state menuOpen = false
  state hovered = false
  // Its tooltip, as the game's log's: what is left to do (the quest's task), or that it is done or failed, and what the
  // player's clicks on it do. The task is asked of the client while the tooltip shows.
  derived tipShown: Boolean = self.hovered && !self.menuOpen
  derived tipText: String = self.ended ? self.progress : Game.questLog.text(self.quest.id).task
  derived level: String = `${self.quest.level}${self.quest.group > 1 ? "+" : ""}`
  // Complete or failed: said under the title in place of its objectives.
  derived ended: Boolean = self.progress != ""
  derived levelColor: Color = questLevelColor(self.quest.level, self.player, INK)
  derived progress: String = stateOf(self.quest)
  derived progressColor: Color = self.quest.failed ? RED : GREEN
  derived background: Color | ByInteractionState<Color> = rowShade(self.picked)
  derived group: String = self.quest.group > 1 ? Locale.GROUP.format(self.quest.group) : ""
  derived entries: Array<MenuEntry> = [
    { label: self.quest.tracked ? Locale.UNTRACK : Locale.TRACK },
    { label: Locale.SUPER_TRACK },
    { label: Locale.SHARE, disabled: !self.quest.shareable },
    { label: Locale.ABANDON, group: true }
  ]

  quest: Signal<LogQuest>
  picked: Signal<Boolean>
  player: Signal<Integer>
  constructor(quest: Signal<LogQuest>, picked: Signal<Boolean>, player: Signal<Integer>) {
    self.quest = quest
    self.picked = picked
    self.player = player
  }

  onPick(mut self) { self.act.emit(self.quest.id, Act.Pick) }
  onTrack(mut self) { self.act.emit(self.quest.id, Act.Track) }
  onLink(mut self) { self.act.emit(self.quest.id, Act.Link) }
  onMenu(mut self) { self.menuOpen = true }
  onClose(mut self) { self.menuOpen = false }
  onEnter(mut self) {
    self.hovered = true
    self.act.emit(self.quest.id, Act.Hover)
  }
  onLeave(mut self) {
    self.hovered = false
    self.act.emit(self.quest.id, Act.Unhover)
  }

  onEntry(mut self, index: Integer) {
    self.menuOpen = false
    const act = match (index) {
      1 => Act.Track
      2 => Act.SuperTrack
      3 => Act.Share
      else => Act.Abandon
    }
    self.act.emit(self.quest.id, act)
  }

  public render(self): Template {
    return $ltml {
      <box columns={["max-content", { fr: 1 }]} gap={2sp} padding={ROW_PAD} background={self.background}
           @pointerPress(.Left)={self.onPick} @pointerPress([.Shift, .Left])={self.onLink}
           @pointerPress(.Right)={self.onMenu} @keyPress(.Enter)={self.onPick} @keyPress(.Space)={self.onTrack}
           @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <Tip $if={self.tipShown} title={self.quest.title} text={self.tipText} keys={ROW_KEYS} />
        <box columns={LEVEL_CELLS}>
          <text value={"["} textColor={DIM} textFont={.Numbers} wrap={.None} />
          <text value={self.level} textColor={self.levelColor} textFont={.Numbers} wrap={.None} />
          <text value={"]"} textColor={DIM} textFont={.Numbers} wrap={.None} />
        </box>
        <box columns={1} gap={GOAL_GAP}>
          <box columns={[{ fr: 1 }, "max-content", "max-content"]} gap={2sp} yAlign={Align.Center}>
            <text value={self.quest.title} textColor={INK} wrap={.None} />
            <text value={self.group} textColor={DIM} textSize={SECONDARY_TEXT} wrap={.None} />
            <Gains xp={self.quest.xp} money={self.quest.money} />
          </box>
          <text $if={self.ended} value={self.progress} textColor={self.progressColor} textSize={SECONDARY_TEXT}
                lineHeight={TIGHT_LINE} />
          <$else>
            <GoalLine $for={objective of self.quest.objectives} objective={objective} />
          </>
        </box>
        <Menu $if={self.menuOpen} entries={self.entries} title={self.quest.title} @pick={self.onEntry}
              @close={self.onClose} />
      </box>
    }
  }
}

// What a quest gives, at its title's right: its experience and its money, «• » between them; nothing where it gives
// neither.
class Gains implements Component {
  derived both: Boolean = self.xp > 0 && self.money > 0

  xp: Signal<Integer>
  money: Signal<Integer>
  constructor(xp: Signal<Integer>, money: Signal<Integer>) {
    self.xp = xp
    self.money = money
  }

  public render(self): Template {
    return $ltml {
      <box columns={GAIN_CELLS} gap={1sp} yAlign={Align.Center}>
        <Experience $if={self.xp > 0} amount={self.xp} textSize={SECONDARY_TEXT} mark={XP_MARK_SMALL} color={DIM} />
        <text $if={self.both} value={"•"} textColor={DIM} textSize={SECONDARY_TEXT} wrap={.None} />
        <Money $if={self.money > 0} amount={self.money} color={DIM} textSize={SECONDARY_TEXT} />
      </box>
    }
  }
}

// An objective's text as the client gives it («Defias slain: 3/10»): what is to be done, and its count; a text
// without a count is all what.
public function goalParts(text: String): (String, String) {
  const what, count = text.match("^(.-):%s*(%d+%s*/%s*%d+)$")
  if (what == nil || count == nil) { return text, "" }
  return what, count
}

// One objective: what is to be done, wrapped, and its count at the right; `color` while to do, `doneColor` once done.
class GoalLine implements Component {
  derived what: String = whatOf(self.objective.text)
  derived count: String = countOf(self.objective.text)
  derived color: Color = self.objective.done ? self.doneColor : self.todoColor

  objective: Signal<Game.QuestObjective>
  todoColor: Signal<Color>
  doneColor: Signal<Color>
  // The list's small lines; the page's are the body's size.
  small: Signal<Boolean>
  constructor(objective: Signal<Game.QuestObjective>, todoColor: Signal<Color> = DIM, doneColor: Signal<Color> = GREY,
    small: Signal<Boolean> = true) {
    self.objective = objective
    self.todoColor = todoColor
    self.doneColor = doneColor
    self.small = small
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.small} columns={[{ fr: 1 }, "max-content"]} gap={2sp}>
        <text value={self.what} textColor={self.color} textSize={SECONDARY_TEXT} lineHeight={TIGHT_LINE} />
        <text value={self.count} textColor={self.color} textSize={SECONDARY_TEXT} textFont={.Numbers} lineHeight={TIGHT_LINE}
              wrap={.None} />
      </box>
      <box $else columns={[{ fr: 1 }, "max-content"]} gap={2sp}>
        <text value={self.what} textColor={self.color} lineHeight={TIGHT_LINE} />
        <text value={self.count} textColor={self.color} textFont={.Numbers} lineHeight={TIGHT_LINE} wrap={.None} />
      </box>
    }
  }
}

function whatOf(text: String): String {
  const what, _ = goalParts(text)
  return what
}

function countOf(text: String): String {
  const _, count = goalParts(text)
  return count
}

// The lines under the scroll (QuestieDB's), each its label and who or what: the labels in one column as wide as the
// longest, so none is cut.
const WHERE_COLUMNS: Array<Track> = ["max-content", { fr: 1 }]
// The tracking switch's row: its label at the start, the switch at the page's right edge, over the Abandon button.
const LABEL_THEN_SWITCH: Array<Track> = [{ fr: 1 }, "max-content"]

// Who a list of figures is, and where the first stands: «Гриан Стаутмантл (56, 47)».
function whoOf(figures: Array<Figure>): String {
  const first = figures[1]
  if (first == nil) { return "" }
  const spot = first.spots[1]
  if (spot == nil) { return first.name }
  return `${first.name} (${(spot.x * 100).floor()}, ${(spot.y * 100).floor()})`
}

// The picked quest's page, as Dialogue's quest page: on the scroll its title, its story, its objectives (each wrapped,
// its count at the right), where its giver and its turn-in are (QuestieDB's); under it what it gives, the library's
// reward rows and band; then its tracking switch and its buttons, Abandon the accent one at the right. Abandoning
// asks first.
public class QuestPage implements Component {
  public act: Event<(Integer, Act)> = new Event()

  derived tracking: Shown = self.quest.tracked ? Shown.On : Shown.Off
  // Its objectives under the task: one that says the task again (a quest without counted objectives, whose one
  // objective is the task's own text) isn't said twice.
  derived goals: Array<Game.QuestObjective> = self.quest.objectives.filter(objective => objective.text != self.text.task)
  derived known: Boolean = self.facts != nil
  derived giver: String = whoOf(self.facts?.givers ?? [])
  derived taker: String = whoOf(self.facts?.takers ?? [])
  derived chain: String = self.facts?.nextName ?? ""
  derived choiceRows: Array<RewardView> = choiceViews(rewardsOf(self.text.choices, true), [])
  derived givenRows: Array<Reward> = rewardsOf(self.text.rewards, false)

  quest: Signal<LogQuest>
  text: Signal<Game.QuestText>
  facts: Signal<QuestFacts | nil>
  player: Signal<Integer>
  constructor(quest: Signal<LogQuest>, text: Signal<Game.QuestText>, facts: Signal<QuestFacts | nil>, player: Signal<Integer>) {
    self.quest = quest
    self.text = text
    self.facts = facts
    self.player = player
  }

  onTrack(mut self) { self.act.emit(self.quest.id, Act.Track) }
  onShare(mut self) { self.act.emit(self.quest.id, Act.Share) }
  onAbandon(mut self) { self.act.emit(self.quest.id, Act.Abandon) }
  onMap(mut self) { self.act.emit(self.quest.id, Act.ShowOnMap) }

  public render(self): Template {
    return $ltml {
      <box rows={[{ fr: 1 }, "max-content", "max-content", "max-content", "max-content"]} gap={1.5sp}>
        <Scroll>
          <text value={self.quest.title} textColor={SCROLL_HEAD} textSize={TITLE_TEXT} lineHeight={TIGHT_LINE} textFont={.Title} />
          <text $if={self.text.story != ""} value={self.text.story} textColor={SCROLL_INK} lineHeight={BODY_LINE} />
          <text value={Locale.SECTION_TASKS} textColor={SCROLL_HEAD} textFont={.Title} />
          <text $if={self.text.task != ""} value={self.text.task} textColor={SCROLL_INK} lineHeight={BODY_LINE} />
          <GoalLine $for={objective of self.goals} objective={objective} todoColor={SCROLL_INK}
                    doneColor={SCROLL_DIM} small={false} />
        </Scroll>
        <box $if={self.known} columns={WHERE_COLUMNS} gap={1sp}>
          <text $if={self.taker != ""} value={Locale.TAKER} textColor={WELL_DIM} />
          <text $if={self.taker != ""} value={self.taker} textColor={WELL_TEXT} />
          <text $if={self.giver != ""} value={Locale.GIVER} textColor={WELL_DIM} />
          <text $if={self.giver != ""} value={self.giver} textColor={WELL_TEXT} />
          <text $if={self.chain != ""} value={Locale.NEXT_IN_CHAIN} textColor={WELL_DIM} />
          <text $if={self.chain != ""} value={self.chain} textColor={WELL_TEXT} />
        </box>
        <box gap={0.5sp}>
          <Rewards views={self.choiceRows} also={self.givenRows} xp={self.text.experience} money={self.text.money} />
        </box>
        <box columns={LABEL_THEN_SWITCH} yAlign={Align.Center} @pointerPress={self.onTrack} @keyPress(.Enter)={self.onTrack}
             @keyPress(.Space)={self.onTrack}>
          <text value={Locale.TRACK} textColor={WELL_TEXT} />
          <SwitchFace state={self.tracking} />
        </box>
        <box columns={["max-content", "max-content", { fr: 1 }, "max-content"]} gap={3sp}>
          <PushButton label={Locale.SHOW_ON_MAP} width={BUTTON} @click={self.onMap} />
          <PushButton label={Locale.SHARE} width={BUTTON} disabled={!self.quest.shareable} @click={self.onShare} />
          <box />
          <PushButton label={Locale.ABANDON} width={BUTTON} plate={ButtonPlate.Accent} @click={self.onAbandon} />
        </box>
      </box>
    }
  }
}

// A quest's items as the reward rows show them: the choices numbered by their place, what is given anyway 0.
function rewardsOf(items: Array<Game.QuestItem>, chosen: Boolean): Array<Reward> {
  let rows: Array<Reward> = []
  for (index, item of items) { rows.push(logReward(item.item, item.count, chosen ? index : 0)) }
  return rows
}
