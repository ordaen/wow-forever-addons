// What Quests adds under a tracked quest to do in Ordaen Tracker, from QuestieDB: the zone of its objectives and how
// many places there. A quest QuestieDB doesn't know gets no line. Its title clicked opens it in Quests' window (or
// docked, on the map).
import Client from "$client"
import type { QuestLine, QuestLines } from "OrdaenTracker"
import Locale from "@/locales"
import { Figure, QuestFacts, Spot } from "@/questie"

// The zone's name of an `AreaTable` area, as the client names it; nil for one it doesn't know.
function zoneOf(area: Integer): String | nil {
  const name: String | nil = Client.C_Map.GetAreaInfo(area)
  return name
}

// The first place of the first figure; nil where none has one.
function firstSpot(figures: Array<Figure>): Spot | nil {
  const figure = figures[1]
  return figure == nil ? nil : figure.spots[1]
}

// Where the figures stand: the first one's zone, and how many places of theirs are in it; nothing where the client
// doesn't know that zone.
public function whereOf(figures: Array<Figure>): String {
  const first = firstSpot(figures)
  if (first == nil) { return "" }
  const zone = zoneOf(first.area)
  if (zone == nil) { return "" }
  let places = 0
  for (figure of figures) { places = places + figure.spots.count(spot => spot.area == first.area) }
  return Locale.ZONE_PLACES.format(zone, places)
}

public class TrackerLines implements QuestLines {
  facts: Signal<Map<Integer, QuestFacts>>
  const opening: (id: Integer) => Boolean
  const showing: (id: Integer) => Boolean
  constructor(facts: Signal<Map<Integer, QuestFacts>>, opening: (id: Integer) => Boolean, showing: (id: Integer) => Boolean) {
    self.facts = facts
    self.opening = opening
    self.showing = showing
  }

  public lines(self, quest: Integer): Array<QuestLine> {
    const facts = self.facts[quest]
    if (facts == nil) { return [] }
    const text = whereOf(facts.targets)
    return text == "" ? [] : [{ text: text }]
  }

  public open(self, quest: Integer): Boolean { return self.opening(quest) }

  public showOnMap(self, quest: Integer): Boolean { return self.showing(quest) }
}
