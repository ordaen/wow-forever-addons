// Ordaen Quests: the player's quests in Ordaen's window, in four tabs (World, Dungeons, Raids, PvP), the list by the
// client's headers on the left and the picked quest's page beside it; and a quest's places on Ordaen Map as the player
// asks to see it there.
// The window has a list window's shape: over the list its kinds' tabs with their counts and the toolbar (the search,
// the select of in progress, completed or all, then the filter, the sort and the view), and in the footer the count
// against the log's cap.
// What the player has is the client's quest log; who gives a quest, who takes it and where its objectives are is
// QuestieDB's.
//
// It opens in place of the game's log: while the log isn't docked on the map (Ordaen Map's switch), the game's quest
// log key (L) clicks Quests' own button (an override of the player's own binding, so the game's Key Bindings window
// stays where it is changed) and the micro menu's quest log button opens it. Docked, both are the game's.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Edges, Layer, Place, Point, Track } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import { ARTWORK, ButtonPlate, Choice, CompactDropdown, Dialog, FilterButton, FilterGroup, FooterBand, FooterCount, KeptWindow, ListFooter, Module, ModuleMemory, PushButton, SECONDARY_TEXT, Settings, SettingsPage, Tabs, ToolPick, Toolbar, Window, WindowSide, WindowTabSpec, WindowsPage, playSound, windowsTitle } from "Ordaen"
import root Maps from "OrdaenMap"
import type { SidePanel } from "OrdaenMap"
import root Panel from "OrdaenPanel"
import { Named, Standing } from "OrdaenQuestPage"
import root Tooltips from "OrdaenTooltips"
import root Tracker from "OrdaenTracker"
import { LogQuest, logQuests } from "@/book"
import { TakenClick } from "@/button"
import { QuestieData } from "@/data"
import { KINDS, QuestKind } from "@/kind"
import { ChainPins, DungeonQuests, NpcPins, TurnInPins, leadsTo, nearestOf, nearestYards, startsAt } from "@/layers"
import { QuestList } from "@/list"
import Locale from "@/locales"
import { Asked, FILTER_START, Folds, ListChoices, Opened, QuestFilter, QuestSort, QuestStatus, QuestView, countOf, foldedOnce, listedOf } from "@/model"
import { namedOfFacts } from "@/names"
import { DoneQuestsXp } from "@/panel"
import { Figure, NpcQuests, QuestFacts, Spot } from "@/questie"
import { standingsOf } from "@/reputation"
import { Choices, GeneralPage } from "@/settings"
import Style from "@/style"
import { TrackerOpener } from "@/tracker"
import { Act, ChainPage, QuestButtons, QuestPage } from "@/view"
import { TooltipCreatures } from "@/wants"

// The button the game's quest log key clicks: the client binds a key to a button by its name.
const TOGGLE = "OrdaenQuestsToggle"
// The game's binding of the quest log.
const QUEST_LOG_BINDING = "TOGGLEQUESTLOG"
const NO_TEXT: Game::QuestText = { story: "", task: "", experience: 0, money: 0, rewards: [], choices: [], giver: 0 }
const DIM: color = #a3977f
const RED: color = #ff4040
// The toolbar over the list, and the list.
const BODY: array<Track> = ["max-content", { fr: 1 }]
const FILL: array<Track> = [{ fr: 1 }]
// The log: its kinds' sub-tabs, the toolbar, the list.
const LOG_ROWS: array<Track> = ["max-content", "max-content", { fr: 1 }]
// The status select stands an item's step after the search, as wide as its longest choice.
const AFTER_SEARCH: Edges = { left: 3sp }
const STATUS_WIDTH = 164.0625dp

const STATUSES: array<Choice<QuestStatus>> = [
  { value: QuestStatus::Progress, label: Locale::STATUS_PROGRESS },
  { value: QuestStatus::Done, label: Locale::STATUS_DONE },
  { value: QuestStatus::All, label: Locale::STATUS_ALL }
]
const FILTERS: array<FilterGroup<QuestFilter>> = [
  { options: [{ key: QuestFilter::Tracked, label: Locale::FILTER_TRACKED }] },
  {
    label: Locale::FILTER_DIFFICULTY,
    options: [
      { key: QuestFilter::Trivial, label: Locale::FILTER_GREY }, { key: QuestFilter::Easy, label: Locale::FILTER_GREEN },
      { key: QuestFilter::Even, label: Locale::FILTER_YELLOW }, { key: QuestFilter::Hard, label: Locale::FILTER_ORANGE },
      { key: QuestFilter::Impossible, label: Locale::FILTER_RED }
    ]
  },
  {
    label: Locale::FILTER_PARTY,
    options: [{ key: QuestFilter::Solo, label: Locale::FILTER_SOLO }, { key: QuestFilter::Group, label: Locale::FILTER_GROUP }]
  }
]
const SORTS: array<Choice<QuestSort>> = [
  { value: QuestSort::Log, label: Locale::SORT_LOG },
  { value: QuestSort::Level, label: Locale::SORT_LEVEL },
  { value: QuestSort::Title, label: Locale::SORT_TITLE }
]
const VIEWS: array<Choice<QuestView>> = [
  { value: QuestView::Zones, label: Locale::VIEW_ZONES, icon: ARTWORK.ctl.tool.categories },
  { value: QuestView::List, label: Locale::VIEW_LIST, icon: ARTWORK.ctl.tool.list }
]

// The window's one tab: the game's quest log book.
const TAB_ICON: Asset = "Interface/QuestFrame/UI-QuestLog-BookIcon"
// The chain window's tab: the game's mark of a quest to take.
const CHAIN_ICON: Asset = "Interface/GossipFrame/AvailableQuestIcon"

// How many quests of the log are of each kind, in `KINDS`' order: the sub-tabs' counts.
function kindCounts(quests: array<LogQuest>): array<integer> {
  return KINDS.map(kind => countOf(quests, kind))
}

// A sub-tab's title by its kind.
function tabTitle(kind: QuestKind): string {
  return match (kind) {
    .World => Locale::TAB_WORLD
    .Dungeon => Locale::TAB_DUNGEONS
    .Raid => Locale::TAB_RAIDS
    .PvP => Locale::TAB_PVP
  }
}

// The sub-tabs' titles, in `KINDS`' order.
const KIND_TITLES: array<string> = KINDS.map(kind => tabTitle(kind))

// A spot's world yards from the player (Ordaen Map's); nil on another continent or without Ordaen Map.
function fromPlayer(spot: Spot): number | nil {
  return Maps?.distanceTo(spot.area, spot.x, spot.y)
}

public class Quests implements Module, App {
  public const title: string = "Ordaen Quests"
  public window: mut KeptWindow = new KeptWindow("log", self.title, { x: 0ui, y: 0ui, width: Style::WIDTH, height: Style::HEIGHT })
  // The next quest of a chain, beside the log at first.
  public chainWindow: mut KeptWindow = new KeptWindow(
    "chain", Locale::CHAIN_WINDOW, { x: Style::CHAIN_X, y: 0ui, width: Style::CHAIN_WIDTH, height: Style::CHAIN_HEIGHT }
  )
  public const windows: mut array<mut KeptWindow> = [self.window, self.chainWindow]
  public const pages: array<SettingsPage> = [
    { title: Locale::TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
    { title: windowsTitle(), content: $ltml { <WindowsPage windows={mut self.windows} /> } }
  ]
  public settings: mut Settings<Choices> = new Settings<Choices>({ ownKey: true })
  // The window's footer, as every list window's: the count against the log's cap (red when full) at its left, and
  // QuestieDB's absence at its right where it can't be read.
  const footer: Template = $ltml {
    <ListFooter counts={self.counted}>
      <text $if={!self.known} value={Locale::NO_QUESTIE} textColor={RED} textSize={SECONDARY_TEXT} />
    </ListFooter>
  }

  // What QuestieDB says of the log's quests, read once a quest.
  data: mut QuestieData = new QuestieData()

  public state open = false
  // The window's one tab, and the kind's sub-tab picked.
  state windowTab = 1
  state tab = 1
  public state quests: array<LogQuest> = []
  state most = 25
  state zone = ""
  // QuestieDB's facts of the log's quests it knows.
  public state facts: map<integer, QuestFacts> = {}
  // The quest whose page shows (0: none), kept for the character so the log opens on it again after a /reload; its
  // text, and the quest the player asked to abandon (0: none).
  public opened: mut ModuleMemory<Opened> = new ModuleMemory<Opened>({}, .Character, "opened")
  public derived picked: integer = self.opened.values.quest
  // The quest the player asked to see on the map (0: none): its marks alone show, until the map hides.
  public state shownOnMap = 0
  // The NPC another module asked to see on the map (nil: none): its pins show, until the map hides.
  state shownNpc: Figure | nil = nil
  // The quest of a chain whose page the chain window shows (0: none, the window closed), and QuestieDB's facts of it.
  public state chained = 0
  state chainedFacts: QuestFacts | nil = nil
  state chainTab = 1
  state text: Game::QuestText = NO_TEXT
  state abandoning = 0
  // The items abandoning it destroys, by name: the question says them, as the game's does.
  state abandonItems: array<string> = []
  // The headers the player folded, the character's.
  public folds: mut ModuleMemory<Folds> = new ModuleMemory<Folds>({}, .Character, "folds")
  // The toolbar: what is sought, and how the player left the rest of it, the profile's.
  public state search = ""
  public list: mut ModuleMemory<ListChoices> = new ModuleMemory<ListChoices>({}, .Profile, "list")

  // Docked on the map (Ordaen Map's switch): the game's log key and button are the game's.
  derived docked: boolean = Maps?.docked == true
  derived mapShowing: boolean = Maps?.showing == true
  derived ownKey: boolean = self.settings.values.ownKey && !self.docked
  // The log is read while something shows it: the window, Map's pins, Tooltips' creature rows, or Panel's experience
  // bar (the completed quests' part).
  derived reading: boolean = self.open || Maps != nil || Tooltips != nil || Panel != nil
  derived kind: QuestKind = KINDS[self.tab] ?? .World
  // One tab, the log's; its kinds are sub-tabs, each with its count.
  derived tabs: array<WindowTabSpec> = [{ title: Locale::TAB_QUESTS, desc: string::of(self.quests.length), icon: TAB_ICON }]
  derived kindsCounted: array<integer> = kindCounts(self.quests)
  derived count: integer = self.quests.length
  derived counted: array<FooterCount> = [
    { label: Locale::FOOT_QUESTS, value: "%d/%d".format(self.count, self.most), color: self.count >= self.most ? RED : nil }
  ]
  derived known: boolean = self.data.fault() == nil
  derived asked: Asked = {
    sought: self.search.lower(), status: self.list.values.status, filter: self.list.values.filter, player: self.level
  }
  derived listed: array<LogQuest> = listedOf(self.quests, self.asked, self.list.values.sort)
  derived kindHas: boolean = countOf(self.quests, self.kind) > 0
  derived pickedQuest: LogQuest | nil = self.quests.find(quest => quest.id == self.picked)
  derived pickedFacts: QuestFacts | nil = self.facts[self.picked]
  // The picked quest as a list of one, or none: the docked panel's page.
  derived pickedList: array<LogQuest> = self.pickedQuest == nil ? [] : [self.pickedQuest ?? panic("a quest")]
  // Docked on the map while it shows: the side panel Quests' log stands over, where, and how big.
  derived dockedSide: SidePanel | nil = Maps?.side
  derived dockedPlace: Place = { point: Point::TopLeft, to: Point::TopLeft, by: self.dockedSide?.frame }
  derived dockedWidth: number<Length> = (self.dockedSide?.width ?? 0) * 1ui
  derived dockedHeight: number<Length> = (self.dockedSide?.height ?? 0) * 1ui
  derived side: WindowSide | nil = self.pageOf(self.pickedQuest)
  derived abandonText: string = Locale::ABANDON_ASK.format(self.quests.find(quest => quest.id == self.abandoning)?.title ?? "")
  derived level: integer = Game::player.level
  derived chainTabs: array<WindowTabSpec> = [{ title: Locale::CHAIN_WINDOW, icon: CHAIN_ICON }]
  // The chain's quest as a list of one, or none: the chain window's page.
  derived chainedList: array<QuestFacts> = self.chainedFacts == nil ? [] : [self.chainedFacts ?? panic("facts")]

  const toggle: any Client::Frame
  const turnIns: TurnInPins
  const chainPins: ChainPins
  const npcPins: NpcPins
  const dungeonQuests: DungeonQuests
  const trackerOpener: TrackerOpener
  const tooltipCreatures: TooltipCreatures
  const doneXp: DoneQuestsXp

  constructor() {
    self.tooltipCreatures = new TooltipCreatures(
      self.quests, self.facts, (id: integer): NpcQuests => self.data.npcQuests(id),
      (id: integer): QuestFacts | nil => self.data.quest(id)
    )
    self.doneXp = new DoneQuestsXp(self.quests)
    self.turnIns = new TurnInPins(self.quests, self.facts, self.shownOnMap)
    self.chainPins = new ChainPins(self.chained, self.chainedFacts, self.shownOnMap)
    self.npcPins = new NpcPins(self.shownNpc)
    self.dungeonQuests = new DungeonQuests(self.quests)
    self.trackerOpener = new TrackerOpener((id: integer): boolean => self.openAt(id), (id: integer): boolean => self.showOnMap(id))
    self.toggle = Client::CreateFrame("Button", TOGGLE, Client::UIParent, nil)
    Ordaen.modules.add(self)
    self.toggle.SetScript("OnClick", (): nil => {
      self.flip()
      return nil
    })
    watch (maps of Maps) {
      if (maps == nil) { return }
      maps.layers.add(self.turnIns)
      maps.layers.add(self.chainPins)
      maps.layers.add(self.npcPins)
      maps.dungeons.add(self.dungeonQuests)
    }
    // What the player asked to see on the map stays until the map hides.
    watch (showing of self.mapShowing) {
      if (!showing) {
        self.shownOnMap = 0
        self.shownNpc = nil
      }
    }
    watch (panel of Panel) {
      if (panel == nil) { return }
      panel.xpSources.add(self.doneXp)
    }
    watch (tracker of Tracker) {
      if (tracker == nil) { return }
      tracker.openers.add(self.trackerOpener)
    }
    // The log's events are heard while something reads it.
    watch (on of self.reading) {
      if (!on) { return }
      self.refresh()
      Events::QUEST_LOG_UPDATE.listen(self.refresh)
      Events::QUEST_WATCH_LIST_CHANGED.listen(self.refresh)
      Events::ZONE_CHANGED_NEW_AREA.listen(self.refresh)
      // Whether a quest can be shared follows the player's group.
      Events::GROUP_ROSTER_UPDATE.listen(self.refresh)
    }
    watch (on of self.ownKey) { Ordaen.afterCombat(() => self.bind()) }
    // The micro menu's button opens the window while the key does.
    watch {
      const frame = Game::frames.QuestLogMicroButton
      if (frame == nil || !self.ownKey) { return }
      const button: any Client::Frame = frame
      _ = new TakenClick(button, () => self.flip())
    }
    Events::UPDATE_BINDINGS.listen(self.rebind)
    watch (id of self.picked) { self.text = id == 0 ? NO_TEXT : Game::questLog.text(id) }
  }

  destructor() {
    const toggle = self.toggle
    Ordaen.afterCombat(() => Client::ClearOverrideBindings(toggle))
  }

  // The window opens or closes: the game's key and button, and the close button.
  public mut flip() {
    self.open = !self.open
    playSound(self.open ? "IG_QUEST_LOG_OPEN" : "IG_QUEST_LOG_CLOSE")
  }

  // The log as the client has it now, and QuestieDB's facts of the quests not read before.
  public mut refresh() {
    const quests = logQuests()
    const facts: map<integer, QuestFacts> = mut {}
    for (id, known of peek self.facts) { facts[id] = known }
    for (quest of quests) {
      if (facts[quest.id] == nil) {
        const read = self.data.quest(quest.id)
        if (read != nil) { facts[quest.id] = read }
      }
    }
    self.quests = quests
    self.facts = facts
    self.most = Game::questLog.most()
    self.zone = Game::questLog.zone()
    // A quest gone from the log is no longer opened; the log read before it has its quests (at a login) drops nothing.
    const picked = peek self.picked
    if (picked != 0 && quests.length > 0 && quests.find(quest => quest.id == picked) == nil) { self.pick(0) }
  }

  mut rebind() { Ordaen.afterCombat(() => self.bind()) }

  // The player's own keys of the game's quest log click Quests' button while it is the player's choice; out of a
  // fight alone, as the client takes no binding in one.
  bind() {
    Client::ClearOverrideBindings(self.toggle)
    if (!(peek self.ownKey)) { return }
    let (first, second) = Client::GetBindingKey(QUEST_LOG_BINDING)
    if (first != nil) { Client::SetOverrideBindingClick(self.toggle, false, first, TOGGLE, "LeftButton") }
    if (second != nil) { Client::SetOverrideBindingClick(self.toggle, false, second, TOGGLE, "LeftButton") }
  }

  // What the player asked of a quest, from its row or its page; each in the click's own call.
  mut onAct(id: integer, act: Act) {
    match (act) {
      .Pick => { self.pick(id) }
      .Track => {
        const quest = (peek self.quests).find(quest => quest.id == id)
        if (quest != nil) {
          Game::questLog.track(id, !quest.tracked)
          // The checkbox's own sound, as the game's log plays it.
          playSound(quest.tracked ? "IG_MAINMENU_OPTION_CHECKBOX_OFF" : "IG_MAINMENU_OPTION_CHECKBOX_ON")
        }
        self.refresh()
      }
      // The game's order: a chat link where a chat line is open, else tracking.
      .Link => { if (!Game::chat.linkQuest(id)) { self.onAct(id, .Track) } }
      .SuperTrack => { Game::questLog.superTrack(id) }
      .Share => { Game::questLog.share(id) }
      .Abandon => {
        self.abandonItems = Game::questLog.abandonItems(id)
        self.abandoning = id
      }
      .ShowOnMap => { _ = self.showOnMap(id) }
      .ShowNext => { self.openChained(id) }
    }
  }

  // What QuestieDB says of a quest (its name, who gives it and where, ...), for another module: Spells' quest-taught
  // spells say where theirs starts. Nil for a quest it doesn't know, or without it.
  public mut questFacts(id: integer): QuestFacts | nil { return self.data.quest(id) }

  // An NPC's name and spawns by QuestieDB (its names are its own locale's), for another module: a trainer to point at.
  public npc(id: integer): Figure | nil { return self.data.npc(id) }

  // The things a quest names (who gives it and takes it back, its objectives' NPCs, objects and items), by QuestieDB:
  // Dialogue's parchment marks them in the quest's words. None for a quest it doesn't know.
  public mut questNames(id: integer): array<Named> { return namedOfFacts(self.data.quest(id)) }

  // The reputations a quest changes once turned in, by QuestieDB: Dialogue's band at a quest giver says them.
  public mut reputationOf(id: integer): array<Standing> {
    return standingsOf(self.data.quest(id)?.reputation ?? [])
  }

  // The chain window at a quest QuestieDB knows; nothing for one it doesn't.
  mut openChained(id: integer) {
    const facts = self.data.quest(id)
    if (facts == nil) { return }
    self.chainedFacts = facts
    self.chained = id
  }

  mut onChainClose() { self.chained = 0 }

  // The world map at where the quest leads (a quest of the log: its objectives while it is to do, whom to hand it to
  // once done; the chain window's: where it is given), its pins alone shown and lit until the map hides; without
  // Ordaen Map or a place QuestieDB knows, the map as it was. True where Ordaen Map opened it. Out of a fight alone:
  // the client opens the map for an addon there only, and every «Show on map» is off in one.
  public mut showOnMap(id: integer): boolean {
    const area = self.areaOf(id)
    if (Maps == nil || area == nil) {
      Client::C_Map::OpenWorldMap(nil)
      return false
    }
    self.shownOnMap = id
    Maps?.show(area, id)
    return true
  }

  // The world map at where an NPC stands by QuestieDB (its first spot), its pins lit with its name until the map hides:
  // another module's link to a trainer or a vendor. False, and the map as it was, without Ordaen Map, in a fight (the
  // client opens the map for an addon out of one alone), or for an NPC QuestieDB doesn't know or has no spot of.
  public mut showNpc(npc: integer): boolean {
    const figure = self.data.npc(npc)
    return figure != nil && self.showAt(figure, figure.spots[1])
  }

  // The world map at the spot nearest the player of all the NPCs' (QuestieDB's), that NPC's pins lit with its name
  // until the map hides: another module's «show the nearest» of trainers or vendors. Where none is on the player's
  // continent, the first NPC's first spot. False as `showNpc` is, and where QuestieDB knows no spot of any.
  public mut showNearest(npcs: array<integer>): boolean {
    const figures: array<Figure> = mut []
    for (npc of npcs) {
      const figure = self.data.npc(npc)
      if (figure != nil) { figures.push(figure) }
    }
    const nearest = nearestOf(figures, fromPlayer)
    return nearest != nil && self.showAt(nearest.figure, nearest.spot)
  }

  // The NPCs that sell an item (QuestieDB's) and trade with the player's side: another module's sellers of a reagent,
  // for `distanceTo` and `showNearest`. None without QuestieDB.
  public vendorsOf(item: integer): array<integer> {
    return self.data.vendorsOf(item, Game::player.faction)
  }

  // The world yards from the player to the NPC's nearest spot (QuestieDB's) on the player's continent, as
  // `showNearest` measures them: another module's distance column of trainers or vendors. Nil where QuestieDB has no
  // spot of it on this continent, or without Ordaen Map.
  public mut distanceTo(npc: integer): number | nil {
    const figure = self.data.npc(npc)
    return figure != nil ? nearestYards(figure, fromPlayer) : nil
  }

  // The map opened at a spot of an NPC's, its pins lit. Not without Ordaen Map, in a fight, or without a spot.
  mut showAt(figure: Figure, spot: Spot | nil): boolean {
    if (Maps == nil || Game::situation.combat || spot == nil) { return false }
    self.shownOnMap = 0
    self.shownNpc = figure
    Maps?.show(spot.area)
    return true
  }

  // Where a quest leads on the map: a quest of the log by its state, the chain window's where it starts.
  areaOf(id: integer): integer | nil {
    const quest = (peek self.quests).find(quest => quest.id == id)
    const facts = (peek self.facts)[id]
    if (quest != nil && facts != nil) { return leadsTo(quest, facts) }
    const chained = peek self.chainedFacts
    return id == peek self.chained && chained != nil ? startsAt(chained) : nil
  }

  mut onFold(header: string) { self.folds.write(foldedOnce(peek self.folds.values, header, peek self.quests)) }

  mut onAbandonYes() {
    const id = peek self.abandoning
    self.abandoning = 0
    if (id != 0) { Game::questLog.abandon(id) }
  }

  mut onAbandonNo() { self.abandoning = 0 }

  mut onClose() { self.open = false }
  onSettings() { Ordaen.toggleSettings(Runtime::Addon::of(self)) }

  pageOf(quest: LogQuest | nil): WindowSide | nil {
    if (quest == nil) { return nil }
    return {
      width: Style::PAGE,
      content: $ltml {
        <QuestPage quest={self.pickedQuest ?? quest} text={self.text} facts={self.pickedFacts} player={self.level}
                   foldFirst={self.settings.values.foldedScroll} footed={true} @act={self.onAct} />
      },
      bottom: .Own {
        footer: $ltml {
          <FooterBand>
            <QuestButtons quest={self.pickedQuest ?? quest} @act={self.onAct} />
          </FooterBand>
        }
      }
    }
  }

  mut onBack() { self.pick(0) }

  // The quest whose page shows, kept for the character.
  mut pick(id: integer) { self.opened.write({ quest: id }) }

  // The quest asked for from another module (the tracker, the chat's link): its page, in the window, or docked on the
  // map with its panel. In a fight, where the client opens no map for an addon, in the window. A quest not in the log
  // opens in the chain's window, as QuestieDB knows it; false where it knows nothing of it.
  public mut openAt(id: integer): boolean {
    if ((peek self.quests).find(quest => quest.id == id) == nil) {
      self.openChained(id)
      return peek self.chained == id
    }
    self.pick(id)
    if (peek self.docked && !Game::situation.combat) {
      Client::C_Map::OpenWorldMap(nil)
    } else if (!(peek self.open)) {
      self.flip()
    }
    return true
  }

  // The log: the toolbar over the list. The window's body, and the docked panel's while no quest is picked.
  logBody(): Template {
    return $ltml {
      <box rows={LOG_ROWS} gap={3sp}>
        <Tabs tabs={KIND_TITLES} selected={mut self.tab} counts={self.kindsCounted} />
        <Toolbar search={mut self.search} placeholder={Locale::SEARCH}>
          <box padding={AFTER_SEARCH}>
            <CompactDropdown value={mut self.list.values.status} choices={STATUSES} width={STATUS_WIDTH} />
          </box>
          <FilterButton values={mut self.list.values.filter} start={FILTER_START} groups={FILTERS} />
          <ToolPick value={mut self.list.values.sort} choices={SORTS} icon={ARTWORK.ctl.tool.sort} title={Locale::SORT} />
          <ToolPick value={mut self.list.values.view} choices={VIEWS} icon={ARTWORK.ctl.tool.categories} title={Locale::VIEW} />
        </Toolbar>
        <QuestList quests={self.listed} kind={self.kind} view={self.list.values.view} zone={self.zone} picked={self.picked}
                   folded={self.folds.values.headers} player={self.level} any={self.kindHas} @act={self.onAct} @fold={self.onFold} />
      </box>
    }
  }

  // The window; and docked, the log over the map's side panel, in exactly its rectangle, where a quest picked shows
  // its page with the way back to the list, as Blizzard's panel does.
  public render(): Template {
    return $ltml {
      <Window $if={self.open} tabs={self.tabs} selected={mut self.windowTab} declared={mut self.window} withSettings={true}
              side={self.side} footer={self.footer} @close={self.onClose} @settings={self.onSettings}>
        {self.logBody()}
      </Window>
      <Window $if={self.chained != 0} tabs={self.chainTabs} selected={mut self.chainTab} declared={mut self.chainWindow}
              @close={self.onChainClose}>
        <ChainPage $for={facts of self.chainedList} quest={self.chained} facts={facts}
                   foldFirst={self.settings.values.foldedScroll} @act={self.onAct} />
      </Window>
      <surface $if={self.dockedSide != nil} layer={Layer::Panel} place={self.dockedPlace} raise={true}
               width={self.dockedWidth} height={self.dockedHeight} background={Style::DOCKED_BACK}
               padding={Style::DOCKED_PAD} columns={1}>
        <box $if={self.pickedQuest == nil} rows={FILL}>
          {self.logBody()}
        </box>
        <box $if={self.pickedQuest != nil} rows={BODY} gap={3sp}>
          <PushButton label={Locale::BACK} width={Style::ASK_BUTTON} @click={self.onBack} />
          <QuestPage $for={quest of self.pickedList} quest={quest} text={self.text} facts={self.pickedFacts} player={self.level}
                     foldFirst={self.settings.values.foldedScroll} @act={self.onAct} />
        </box>
      </surface>
      <Dialog $if={self.abandoning != 0} width={Style::ASK} title={Locale::ABANDON}>
        <text value={self.abandonText} />
        <text $if={self.abandonItems.length > 0} value={Locale::ABANDON_ITEMS.format(self.abandonItems.join(", "))} />
        <PushButton #buttons label={Locale::ABANDON} width={Style::ASK_BUTTON} plate={ButtonPlate::Danger} @click={self.onAbandonYes} />
        <PushButton #buttons label={Locale::CANCEL} width={Style::ASK_BUTTON} @click={self.onAbandonNo} />
      </Dialog>
    }
  }
}
