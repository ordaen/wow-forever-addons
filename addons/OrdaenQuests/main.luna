// Ordaen Quests: the player's quests in Ordaen's window, in four tabs (World, Dungeons, Raids, PvP), the list by the
// client's headers on the left and the picked quest's page beside it; and the tracked quests' places on Ordaen Map.
// The window has a list window's shape: over the list the toolbar (the search, the switch of in progress, completed or
// all, then the filter, the sort and the view), and in the footer the count against the log's cap.
// What the player has is the client's quest log; who gives a quest, who takes it and where its objectives are is
// QuestieDB's.
//
// It opens in place of the game's log: while the log isn't docked on the map (Ordaen Map's switch), the game's quest
// log key (L) clicks Quests' own button (an override of the player's own binding, so the game's Key Bindings window
// stays where it is changed) and the micro menu's quest log button opens it. Docked, both are the game's.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Align, Edges, Track } from "$ltml"
import Runtime from "$runtime"
import root Ordaen from "Ordaen"
import {
  ARTWORK, ButtonPlate, Choice, Dialog, FilterButton, FilterGroup, FooterCount, FooterCounts, KeptWindow, Module, PushButton, SECONDARY_TEXT, Segmented, Settings,
  SettingsPage, ToolPick, Toolbar, Window, WindowSide, WindowTabSpec, WindowsPage, space, switched, windowsTitle
} from "Ordaen"
import root Maps from "OrdaenMap"
import { ClientQuestLog, LogQuest, QuestLog, QuestText } from "@/book"
import { TakenClick } from "@/button"
import { QuestData, QuestieData } from "@/data"
import { KINDS, QuestKind } from "@/kind"
import { PinKind, QuestPins } from "@/layers"
import { QuestList } from "@/list"
import Locale from "@/locales"
import { Asked, QuestFilter, QuestSort, QuestStatus, QuestView, countOf, listedOf } from "@/model"
import { QuestFacts } from "@/questie"
import { Choices, GeneralPage } from "@/settings"
import Style from "@/style"
import { Act, QuestPage } from "@/view"

// The button the game's quest log key clicks: the client binds a key to a button by its name.
const TOGGLE = "OrdaenQuestsToggle"
// The game's binding of the quest log.
const QUEST_LOG_BINDING = "TOGGLEQUESTLOG"
const NO_TEXT: QuestText = { story: "", task: "", experience: 0, money: 0 }
const DIM: Color = Color.hex("#a3977f")
const RED: Color = Color.hex("#ff4040")
// The toolbar over the list, and the list.
const BODY: Array<Track> = ["max-content", { fr: 1 }]
const FOOT: Array<Track> = [{ fr: 1 }, "max-content"]
// The status switch stands an item's step after the search.
const AFTER_SEARCH: Edges = { left: space(.Item) }

const STATUSES: Array<Choice<QuestStatus>> = [
  { value: QuestStatus.Progress, label: Locale.STATUS_PROGRESS },
  { value: QuestStatus.Done, label: Locale.STATUS_DONE },
  { value: QuestStatus.All, label: Locale.STATUS_ALL }
]
const FILTERS: Array<FilterGroup<QuestFilter>> = [
  { options: [{ key: QuestFilter.Tracked, label: Locale.FILTER_TRACKED }] },
  {
    label: Locale.FILTER_DIFFICULTY,
    options: [
      { key: QuestFilter.Trivial, label: Locale.FILTER_GREY }, { key: QuestFilter.Easy, label: Locale.FILTER_GREEN },
      { key: QuestFilter.Even, label: Locale.FILTER_YELLOW }, { key: QuestFilter.Hard, label: Locale.FILTER_ORANGE },
      { key: QuestFilter.Impossible, label: Locale.FILTER_RED }
    ]
  },
  {
    label: Locale.FILTER_PARTY,
    options: [{ key: QuestFilter.Solo, label: Locale.FILTER_SOLO }, { key: QuestFilter.Group, label: Locale.FILTER_GROUP }]
  }
]
// The filter as the window starts: every quest shown, tracked or not.
const FILTER_START: Map<QuestFilter, Boolean> = switched({}, [
  QuestFilter.Trivial, QuestFilter.Easy, QuestFilter.Even, QuestFilter.Hard, QuestFilter.Impossible, QuestFilter.Solo,
  QuestFilter.Group
], true)
const SORTS: Array<Choice<QuestSort>> = [
  { value: QuestSort.Log, label: Locale.SORT_LOG },
  { value: QuestSort.Level, label: Locale.SORT_LEVEL },
  { value: QuestSort.Title, label: Locale.SORT_TITLE }
]
const VIEWS: Array<Choice<QuestView>> = [
  { value: QuestView.Zones, label: Locale.VIEW_ZONES, icon: ARTWORK.ctl.tool.categories },
  { value: QuestView.List, label: Locale.VIEW_LIST, icon: ARTWORK.ctl.tool.list }
]

// A tab's title and its icon (the client's own) by its kind.
function tabTitle(kind: QuestKind): String {
  return match (kind) {
    .World => Locale.TAB_WORLD
    .Dungeon => Locale.TAB_DUNGEONS
    .Raid => Locale.TAB_RAIDS
    .PvP => Locale.TAB_PVP
  }
}
function tabIcon(kind: QuestKind): Asset {
  return match (kind) {
    .World => "Interface/Icons/INV_Misc_Map_01"
    .Dungeon => "Interface/Icons/INV_Misc_Bone_HumanSkull_01"
    .Raid => "Interface/Icons/INV_Misc_Head_Dragon_01"
    .PvP => "Interface/Icons/Ability_DualWield"
  }
}

public class Quests implements Module, App {
  public const title: String = "Ordaen Quests"
  public window: mut KeptWindow = new KeptWindow("log", self.title, { x: 0ui, y: 0ui, width: Style.WIDTH, height: Style.HEIGHT })
  public const windows: mut Array<mut KeptWindow> = [self.window]
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } },
    { title: windowsTitle(), content: $ltml { <WindowsPage windows={mut self.windows} /> } }
  ]
  public settings: mut Settings<Choices> = new Settings<Choices>({ ownKey: true })
  // The window's footer: QuestieDB's absence where it can't be read, and the count against the log's cap (red when
  // full), as label and value.
  const footer: Template = $ltml {
    <box columns={FOOT} gap={space(.Group)} yAlign={Align.Center}>
      <text $if={!self.known} value={Locale.NO_QUESTIE} textColor={RED} textSize={SECONDARY_TEXT} />
      <box $else />
      <FooterCounts counts={self.counted} />
    </box>
  }

  // The client's log, and QuestieDB: a test gives its own.
  public log: mut any QuestLog = new ClientQuestLog()
  public data: mut any QuestData = new QuestieData()

  public state open = false
  state tab = 1
  public state quests: Array<LogQuest> = []
  state most = 25
  state zone = ""
  // QuestieDB's facts of the log's quests it knows.
  public state facts: Map<Integer, QuestFacts> = {}
  // The quest whose page shows (0: none), its text, and the quest the player asked to abandon (0: none).
  public state picked = 0
  state text: QuestText = NO_TEXT
  state abandoning = 0
  // The headers the player folded, by their text.
  state folded: mut Map<String, Boolean> = {}
  // The toolbar: what is sought, the status switch, the filter, the order and the view.
  public state search = ""
  public state status: QuestStatus = .All
  public state filter: Map<QuestFilter, Boolean> = FILTER_START
  public state sort: QuestSort = .Log
  public state view: QuestView = .Zones

  // Docked on the map (Ordaen Map's switch): the game's log key and button are the game's.
  derived docked: Boolean = Maps?.docked == true
  derived ownKey: Boolean = self.settings.values.ownKey && !self.docked
  // The log is read while something shows it: the window, or Map's pins.
  derived reading: Boolean = self.open || Maps != nil
  derived kind: QuestKind = KINDS[self.tab] ?? .World
  derived tabs: Array<WindowTabSpec> = KINDS.map(kind => { title: tabTitle(kind), desc: String.of(countOf(self.quests, kind)), icon: tabIcon(kind) })
  derived count: Integer = self.quests.length
  derived counted: Array<FooterCount> = [
    { label: Locale.FOOT_QUESTS, value: "%d/%d".format(self.count, self.most), color: self.count >= self.most ? RED : nil }
  ]
  derived known: Boolean = self.data.fault() == nil
  derived asked: Asked = { sought: self.search.lower(), status: self.status, filter: self.filter, player: self.level }
  derived listed: Array<LogQuest> = listedOf(self.quests, self.asked, self.sort)
  derived kindHas: Boolean = countOf(self.quests, self.kind) > 0
  derived pickedQuest: LogQuest | nil = self.quests.find(quest => quest.id == self.picked)
  derived pickedFacts: QuestFacts | nil = self.facts[self.picked]
  derived side: WindowSide | nil = self.pageOf(self.pickedQuest)
  derived abandonText: String = Locale.ABANDON_ASK.format(self.quests.find(quest => quest.id == self.abandoning)?.title ?? "")
  derived level: Integer = Game.player.level

  const toggle: any Client.Frame
  const objectives: QuestPins
  const turnIns: QuestPins

  constructor() {
    self.objectives = new QuestPins(PinKind.Objectives, self.quests, self.facts)
    self.turnIns = new QuestPins(PinKind.TurnIns, self.quests, self.facts)
    self.toggle = Client.CreateFrame("Button", TOGGLE, Client.UIParent, nil)
    Ordaen.modules.add(self)
    self.toggle.SetScript("OnClick", (): nil => {
      self.flip()
      return nil
    })
    watch (maps of Maps) {
      if (maps == nil) { return }
      maps.layers.add(self.objectives)
      maps.layers.add(self.turnIns)
    }
    // The log's events are heard while something reads it.
    watch (on of self.reading) {
      if (!on) { return }
      self.refresh()
      Events.QUEST_LOG_UPDATE.listen(self.refresh)
      Events.QUEST_WATCH_LIST_CHANGED.listen(self.refresh)
      Events.ZONE_CHANGED_NEW_AREA.listen(self.refresh)
    }
    watch (on of self.ownKey) { Ordaen.afterCombat(() => self.bind()) }
    // The micro menu's button opens the window while the key does.
    watch {
      const frame = Game.frames.QuestLogMicroButton
      if (frame == nil || !self.ownKey) { return }
      const button: any Client.Frame = frame
      _ = new TakenClick(button, () => self.flip())
    }
    Events.UPDATE_BINDINGS.listen(self.rebind)
    watch (id of self.picked) { self.text = id == 0 ? NO_TEXT : self.log.text(id) }
  }

  destructor() {
    const toggle = self.toggle
    Ordaen.afterCombat(() => Client.ClearOverrideBindings(toggle))
  }

  // The window opens or closes: the game's key and button, and the close button.
  public flip(mut self) { self.open = !self.open }

  // The log as the client has it now, and QuestieDB's facts of the quests not read before.
  public refresh(mut self) {
    const quests = self.log.quests()
    const facts: Map<Integer, QuestFacts> = {}
    for (id, known of peek self.facts) { facts[id] = known }
    for (quest of quests) {
      if (facts[quest.id] == nil) {
        const read = self.data.quest(quest.id)
        if (read != nil) { facts[quest.id] = read }
      }
    }
    self.quests = quests
    self.facts = facts
    self.most = self.log.most()
    self.zone = self.log.zone()
    const picked = peek self.picked
    if (picked != 0 && quests.find(quest => quest.id == picked) == nil) { self.picked = 0 }
  }

  rebind(mut self) { Ordaen.afterCombat(() => self.bind()) }

  // The player's own keys of the game's quest log click Quests' button while it is the player's choice; out of a
  // fight alone, as the client takes no binding in one.
  bind(self) {
    Client.ClearOverrideBindings(self.toggle)
    if (!(peek self.ownKey)) { return }
    let first, second = Client.GetBindingKey(QUEST_LOG_BINDING)
    if (first != nil) { Client.SetOverrideBindingClick(self.toggle, false, first, TOGGLE, "LeftButton") }
    if (second != nil) { Client.SetOverrideBindingClick(self.toggle, false, second, TOGGLE, "LeftButton") }
  }

  // What the player asked of a quest, from its row or its page; each in the click's own call.
  onAct(mut self, id: Integer, act: Act) {
    match (act) {
      .Pick => { self.picked = id }
      .Track => {
        const quest = (peek self.quests).find(quest => quest.id == id)
        if (quest != nil) { self.log.track(id, !quest.tracked) }
        self.refresh()
      }
      .Share => { self.log.share(id) }
      .Abandon => { self.abandoning = id }
      .ShowOnMap => { Client.C_Map.OpenWorldMap(nil) }
    }
  }

  onFold(mut self, header: String) { self.folded[header] = self.folded[header] != true }

  onAbandonYes(mut self) {
    const id = peek self.abandoning
    self.abandoning = 0
    if (id != 0) { self.log.abandon(id) }
  }

  onAbandonNo(mut self) { self.abandoning = 0 }

  onClose(mut self) { self.open = false }
  onSettings(self) { Ordaen.toggleSettings(Runtime.Addon.of(self)) }

  pageOf(self, quest: LogQuest | nil): WindowSide | nil {
    if (quest == nil) { return nil }
    return {
      width: Style.PAGE,
      content: $ltml {
        <QuestPage quest={self.pickedQuest ?? quest} text={self.text} facts={self.pickedFacts} player={self.level} @act={self.onAct} />
      }
    }
  }

  public render(self): Template {
    return $ltml {
      <Window $if={self.open} tabs={self.tabs} selected={mut self.tab} declared={mut self.window} withSettings={true}
              side={self.side} footer={self.footer} @close={self.onClose} @settings={self.onSettings}>
        <box rows={BODY} gap={space(.Item)}>
          <Toolbar search={mut self.search} placeholder={Locale.SEARCH}>
            <box padding={AFTER_SEARCH}>
              <Segmented value={mut self.status} choices={STATUSES} />
            </box>
            <FilterButton values={mut self.filter} start={FILTER_START} groups={FILTERS} />
            <ToolPick value={mut self.sort} choices={SORTS} icon={ARTWORK.ctl.tool.sort} title={Locale.SORT} />
            <ToolPick value={mut self.view} choices={VIEWS} icon={ARTWORK.ctl.tool.categories} title={Locale.VIEW} />
          </Toolbar>
          <QuestList quests={self.listed} kind={self.kind} view={self.view} zone={self.zone} picked={self.picked}
                     folded={self.folded} player={self.level} any={self.kindHas} @act={self.onAct} @fold={self.onFold} />
        </box>
      </Window>
      <Dialog $if={self.abandoning != 0} width={Style.ASK} title={Locale.ABANDON}>
        <text value={self.abandonText} wrap={true} />
        <PushButton #buttons label={Locale.ABANDON} width={Style.ASK_BUTTON} plate={ButtonPlate.Danger} @click={self.onAbandonYes} />
        <PushButton #buttons label={Locale.CANCEL} width={Style.ASK_BUTTON} @click={self.onAbandonNo} />
      </Dialog>
    }
  }
}
