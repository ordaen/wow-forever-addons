// What Quests puts on Ordaen Map, and the colours of its levels: a tracked quest's objectives while it is to do, its
// turn-in once done, nothing of a quest not tracked or not known to QuestieDB.
import Test from "$test"
import type { Pin } from "OrdaenMap"
import { LogQuest } from "@/book"
import { DungeonQuests, PinKind, QuestPins } from "@/layers"
import { Difficulty, colorOf, difficultyOf } from "Ordaen"
import { QuestFacts } from "@/questie"

function quest(id: Integer, tracked: Boolean, done: Boolean): LogQuest {
  return {
    id: id, title: `Quest ${id}`, level: 10, header: "Westfall", kind: .World, done: done, failed: false,
    tracked: tracked, group: 0, shareable: false, xp: 0, money: 0,
    objectives: [{ text: "Wolves slain: 5/10", done: false }, { text: "Bears slain: 2/2", done: true }]
  }
}

// The log and the facts the layers follow.
class Holder {
  public state quests: Array<LogQuest> = []
  public state facts: Map<Integer, QuestFacts> = {}
  public state hovered = 0
}

const FACTS: QuestFacts = {
  name: "", level: 10, zone: 40, next: 0, nextName: "",
  givers: [{ name: "Giver", spots: [{ area: 40, x: 0.1, y: 0.1 }] }],
  takers: [{ name: "Taker", spots: [{ area: 40, x: 0.2, y: 0.2 }] }],
  targets: [{ name: "Wolf", spots: [{ area: 40, x: 0.3, y: 0.3 }, { area: 40, x: 0.4, y: 0.4 }] }]
}

test "the objectives' layer shows the tracked quests that aren't done, each of their spots" {
  const holder = new Holder()
  holder.quests = [quest(1, true, false), quest(2, false, false), quest(3, true, true), quest(4, true, false)]
  holder.facts = { [1]: FACTS, [2]: FACTS, [3]: FACTS }
  const layer = new QuestPins(PinKind.Objectives, holder.quests, holder.facts)
  const pins = layer.pins()
  Test.expect(pins.length == 2)
  Test.expect(pins.all(pin => pin.of == 1))
  const lines = layer.lines(pins[1] ?? panic("a pin"))
  Test.expect(lines.length == 2 && lines[1] == "Quest 1" && lines[2] == "Wolves slain: 5/10")
}

test "the turn-ins' layer shows whom to hand a tracked quest that is done" {
  const holder = new Holder()
  holder.quests = [quest(1, true, false), quest(3, true, true)]
  holder.facts = { [1]: FACTS, [3]: FACTS }
  const layer = new QuestPins(PinKind.TurnIns, holder.quests, holder.facts)
  const pins = layer.pins()
  Test.expect(pins.length == 1)
  Test.expect(pins[1]?.of == 3 && pins[1]?.x == 0.2)
}

test "the pins of the quest under the cursor in the log are lit, the others not" {
  const holder = new Holder()
  holder.quests = [quest(1, true, false), quest(4, true, false)]
  holder.facts = { [1]: FACTS, [4]: FACTS }
  holder.hovered = 4
  const layer = new QuestPins(PinKind.Objectives, holder.quests, holder.facts, holder.hovered)
  const pins = layer.pins()
  Test.expect(pins.filter(pin => pin.lit).all(pin => pin.of == 4) && pins.filter(pin => pin.lit).length == 2)
}

test "a pin clicked has the client point the way to its quest; Shift+click stops tracking it" {
  Test.questLog([{ id: 1, title: "Quest 1", header: "Westfall", watched: true }])
  const holder = new Holder()
  const layer = new QuestPins(PinKind.Objectives, holder.quests, holder.facts)
  const pin: Pin = { of: 1, area: 40, x: 0.3, y: 0.3, icon: "Interface/GossipFrame/IncompleteQuestIcon" }
  _ = Test.talked()
  layer.press(pin, false)
  layer.press(pin, true)
  Test.expect(Test.talked().join(",") == "super-track 1,unwatch 1")
}

test "a dungeon's card lists the log's quests under its instance's header, each with its level" {
  const holder = new Holder()
  const deadmines: LogQuest = { header: "The Deadmines", title: "Red Silk Bandanas", ..quest(2, false, false) }
  holder.quests = [quest(1, true, false), deadmines]
  const section = new DungeonQuests(holder.quests)
  Test.expect(section.lines(["The Deadmines"]).join(",") == "[10] Red Silk Bandanas")
  Test.expect(section.lines(["Ragefire Chasm"]).length == 0)
}

test "a quest's level is coloured as the client colours it against the player's" {
  Test.expect(difficultyOf(25, 20) == Difficulty.Impossible)
  Test.expect(difficultyOf(23, 20) == Difficulty.Hard)
  Test.expect(difficultyOf(18, 20) == Difficulty.Even)
  Test.expect(difficultyOf(13, 20) == Difficulty.Easy)
  Test.expect(difficultyOf(12, 20) == Difficulty.Trivial)
  Test.expect(colorOf(.Trivial).r == colorOf(.Trivial).g)
}
