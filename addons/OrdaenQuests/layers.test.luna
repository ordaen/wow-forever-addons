// What Quests puts on Ordaen Map, and the colours of its levels: the turn-in of the quest shown on the map once done,
// nothing of another quest or of one not known to QuestieDB; where the chain window's quest is given.
import Test from "$test"
import { Difficulty, colorOf, difficultyOf } from "Ordaen"
import type { Pin } from "OrdaenMap"
import { LogQuest } from "@/book"
import { ChainPins, DungeonQuests, NpcPins, TurnInPins, leadsTo, nearestOf, startsAt } from "@/layers"
import { Figure, QuestFacts, Spot } from "@/questie"

function quest(id: Integer, tracked: Boolean, done: Boolean): LogQuest {
  return {
    id: id, title: `Quest ${id}`, level: 10, header: "Westfall", kind: .World, done: done, failed: false,
    tracked: tracked, group: 0, shareable: false, xp: 0, money: 0,
    objectives: [{ text: "Wolves slain: 5/10", done: false }, { text: "Bears slain: 2/2", done: true }]
  }
}

// The log and the facts the layers follow.
class Holder {
  public state quests: Array<LogQuest> = []
  public state facts: Map<Integer, QuestFacts> = {}
  public state shown = 0
  public state npc: Figure | nil = nil
}

const FACTS: QuestFacts = {
  name: "", level: 10, minLevel: 8, task: "", zone: 40, reputation: [], items: [], next: 0, nextName: "",
  givers: [{ id: 1, kind: .Npc, name: "Giver", spots: [{ area: 40, x: 0.1, y: 0.1 }] }],
  takers: [{ id: 1, kind: .Npc, name: "Taker", spots: [{ area: 40, x: 0.2, y: 0.2 }] }],
  targets: [{ id: 1, kind: .Npc, name: "Wolf", spots: [{ area: 40, x: 0.3, y: 0.3 }, { area: 40, x: 0.4, y: 0.4 }] }]
}

test "the turn-ins' layer shows whom to hand the quest shown on the map, lit, once it is done; nothing else" {
  const holder = new Holder()
  holder.quests = [quest(1, true, false), quest(3, true, true), quest(4, false, true)]
  holder.facts = { [1]: FACTS, [3]: FACTS, [4]: FACTS }
  const layer = new TurnInPins(holder.quests, holder.facts, holder.shown)
  // Nothing shown: no pins, tracked and done or not.
  Test.expect(layer.pins().length == 0)
  holder.shown = 1
  Test.expect(layer.pins().length == 0)
  holder.shown = 4
  const pins = layer.pins()
  Test.expect(pins.length == 1 && pins[1]?.of == 4 && pins[1]?.x == 0.2 && pins[1]?.lit == true)
  Test.expect(layer.lines(pins[1] ?? panic("a pin")).join("|") == "Quest 4|Turn in here")
}

test "a quest leads to its first objective's area while to do, its turn-in's once done, else its zone" {
  const elsewhere: QuestFacts = {
    targets: [{ id: 1, kind: .Npc, name: "Wolf", spots: [{ area: 12, x: 0.3, y: 0.3 }] }], ..FACTS
  }
  Test.expect(leadsTo(quest(1, false, false), elsewhere) == 12)
  Test.expect(leadsTo(quest(1, false, true), elsewhere) == 40)
  Test.expect(leadsTo(quest(1, false, false), { targets: [], zone: 44, ..FACTS }) == 44)
  Test.expect(leadsTo(quest(1, false, false), { targets: [], zone: -21, ..FACTS }) == nil)
}

test "a quest not taken starts where its first giver stands, else in its zone" {
  Test.expect(startsAt(FACTS) == 40)
  Test.expect(startsAt({ givers: [], zone: 44, ..FACTS }) == 44)
  Test.expect(startsAt({ givers: [], zone: -21, ..FACTS }) == nil)
}

// The chain window's quest and its facts.
class Chain {
  public state quest = 0
  public state facts: QuestFacts | nil = nil
}

test "the chain's layer shows where its quest is given, lit, only while that quest is the one shown on the map" {
  const chain = new Chain()
  const holder = new Holder()
  chain.quest = 166
  chain.facts = FACTS
  const layer = new ChainPins(chain.quest, chain.facts, holder.shown)
  Test.expect(layer.pins().length == 0)
  holder.shown = 101
  Test.expect(layer.pins().length == 0)
  holder.shown = 166
  const pins = layer.pins()
  Test.expect(pins.length == 1 && pins[1]?.of == 166 && pins[1]?.x == 0.1 && pins[1]?.lit == true)
  Test.expect(layer.lines(pins[1] ?? panic("a pin")).join("|") == "|Given by: Giver")
}

test "a pin clicked has the client point the way to its quest; Shift+click stops tracking it" {
  Test.questLog([{ id: 1, title: "Quest 1", header: "Westfall", watched: true }])
  const holder = new Holder()
  const layer = new TurnInPins(holder.quests, holder.facts, holder.shown)
  const pin: Pin = { of: 1, area: 40, x: 0.3, y: 0.3, icon: "Interface/GossipFrame/ActiveQuestIcon" }
  _ = Test.talked()
  layer.press(pin, false)
  layer.press(pin, true)
  Test.expect(Test.talked().join(",") == "super-track 1,unwatch 1")
}

test "a dungeon's card lists the log's quests under its instance's header, each with its level" {
  const holder = new Holder()
  const deadmines: LogQuest = { header: "The Deadmines", title: "Red Silk Bandanas", ..quest(2, false, false) }
  holder.quests = [quest(1, true, false), deadmines]
  const section = new DungeonQuests(holder.quests)
  Test.expect(section.lines(["The Deadmines"]).join(",") == "[10] Red Silk Bandanas")
  Test.expect(section.lines(["Ragefire Chasm"]).length == 0)
}

test "a quest's level is coloured as the client colours it against the player's" {
  Test.expect(difficultyOf(25, 20) == Difficulty.Impossible)
  Test.expect(difficultyOf(23, 20) == Difficulty.Hard)
  Test.expect(difficultyOf(18, 20) == Difficulty.Even)
  Test.expect(difficultyOf(13, 20) == Difficulty.Easy)
  Test.expect(difficultyOf(12, 20) == Difficulty.Trivial)
  Test.expect(colorOf(.Trivial).r == colorOf(.Trivial).g)
}

test "the NPC's layer shows each of its spots, lit, its name in the tooltip, while one is asked for; none, nothing" {
  const holder = new Holder()
  const layer = new NpcPins(holder.npc)
  Test.expect(layer.pins().length == 0)
  holder.npc = { id: 7, kind: .Npc, name: "Trainer", spots: [{ area: 12, x: 0.3, y: 0.6 }, { area: 40, x: 0.5, y: 0.5 }] }
  const pins = layer.pins()
  Test.expect(pins.length == 2 && pins.filter(pin => pin.lit && pin.of == 7).length == 2)
  const first = pins[1] ?? panic("a pin")
  Test.expect(first.area == 12 && layer.lines(first).join(",") == "Trainer")
  holder.npc = nil
  Test.expect(layer.pins().length == 0)
}

test "of several NPCs' spots the one nearest the player is picked; with none measurable, the first NPC's first spot" {
  const far: Figure = { id: 1, kind: .Npc, name: "Far Trainer", spots: [{ area: 12, x: 0.9, y: 0.9 }, { area: 1519, x: 0.5, y: 0.5 }] }
  const near: Figure = { id: 2, kind: .Npc, name: "Near Vendor", spots: [{ area: 12, x: 0.4, y: 0.6 }] }
  // The player stands at 0.4, 0.5 of area 12; another area is another continent.
  const distance = (spot: Spot): Number | nil => spot.area == 12 ? ((spot.x - 0.4) ** 2 + (spot.y - 0.5) ** 2).sqrt() : nil
  const picked = nearestOf([far, near], distance) ?? panic("a spot")
  Test.expect(picked.figure.name == "Near Vendor" && picked.spot.y == 0.6)
  const none = nearestOf([far, near], (spot: Spot): Number | nil => nil) ?? panic("the first")
  Test.expect(none.figure.name == "Far Trainer" && none.spot.x == 0.9)
  Test.expect(nearestOf([{ id: 3, kind: .Npc, name: "Nowhere", spots: [] }], distance) == nil)
}
