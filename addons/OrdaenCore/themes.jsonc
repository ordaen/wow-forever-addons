// The shared part of every Ordaen theme: the tokens addons' look settings follow, the assets (art, fonts, bar
// textures) those refer to, and each theme's value for every token. The build checks it (every theme gives every
// token a value of its type) and generates ThemeTokens.lua. Addons never define their look: their look settings
// default to these tokens (docs/reference/settings.md). The UI renderer's surfaces and text styles are in
// OrdaenCore_UI/Theme.lua and take their accent and fonts from here.
{
  "assets": {
    "frame": {
      "bronze-rim": { "label": "FRAME_BRONZE_RIM", "file": "Interface\\AddOns\\OrdaenCore\\media\\bronze-rim-frame", "outset": 11 },
      "gold": { "label": "FRAME_GOLD", "edgeFile": "Interface\\DialogFrame\\UI-DialogBox-Border", "edgeSize": 24, "outset": 7 },
      "tooltip": { "label": "FRAME_TOOLTIP", "edgeFile": "Interface\\Tooltips\\UI-Tooltip-Border", "edgeSize": 16, "outset": 4 },
      "thin": { "label": "FRAME_THIN", "edgeFile": "Interface\\Buttons\\WHITE8X8", "edgeSize": 2, "outset": 2, "natural": [0, 0, 0] },
      "none": { "label": "FRAME_NONE" },
      // Blizzard's window art (inventory of 35 windows, 2026-11-07): `layout` names a NineSliceLayouts entry, drawn with
      // NineSliceUtil.ApplyLayoutByName, so the pieces and offsets are Blizzard's own.
      "metal": { "label": "FRAME_METAL", "layout": "ButtonFrameTemplateNoPortrait" },
      "metal-portrait": { "label": "FRAME_METAL_PORTRAIT", "layout": "PortraitFrameTemplate" },
      // even-edged metal without a title bar: small surfaces (tooltip, panel strip, chat window)
      "metal-thin": { "label": "FRAME_METAL_THIN", "layout": "GenericMetal" },
      "dialog": { "label": "FRAME_DIALOG", "layout": "Dialog" },
      "inset": { "label": "FRAME_INSET", "layout": "InsetFrameTemplate" }
    },
    // A surface's fill: an atlas, or a file (number = file ID) with `tile` (repeats instead of stretching).
    "background": {
      "general": { "label": "BACKGROUND_GENERAL", "atlas": "UI-Character-Info-General-BG" },
      "dialog": { "label": "BACKGROUND_DIALOG", "file": 131071, "tile": true },
      "inset": { "label": "BACKGROUND_INSET", "file": 374154, "tile": true },
      "none": { "label": "BACKGROUND_NONE" }
    },
    "font": {
      "body": { "label": "FONT_BODY", "object": "GameTooltipText" },
      "header": { "label": "FONT_HEADER", "object": "GameTooltipHeaderText" },
      "ui": { "label": "FONT_UI", "object": "GameFontNormal" },
      "numbers": { "label": "FONT_NUMBERS", "object": "NumberFontNormal" }
    },
    "bar": {
      "flat": { "label": "BAR_FLAT", "file": "Interface\\Buttons\\WHITE8X8" },
      "blizzard": { "label": "BAR_BLIZZARD", "file": "Interface\\TargetingFrame\\UI-StatusBar" }
    },
    "xpFill": {
      // The experience bar's fill in its glass tube (art/panel.py, the user's picks 2026-11-07): deep blue, a
      // texture each, tiling along the bar; `shine` warms the tube's glass highlight (steel's is amber).
      "deep": { "label": "XP_FILL_DEEP", "file": "Interface\\AddOns\\OrdaenCore\\media\\xp-fill-deep" },
      "grain": { "label": "XP_FILL_GRAIN", "file": "Interface\\AddOns\\OrdaenCore\\media\\xp-fill-grain" },
      "brushed": { "label": "XP_FILL_BRUSHED", "file": "Interface\\AddOns\\OrdaenCore\\media\\xp-fill-brushed" },
      "potion": { "label": "XP_FILL_POTION", "file": "Interface\\AddOns\\OrdaenCore\\media\\xp-fill-potion" },
      "clouds": { "label": "XP_FILL_CLOUDS", "file": "Interface\\AddOns\\OrdaenCore\\media\\xp-fill-clouds" },
      "steel": { "label": "XP_FILL_STEEL", "file": "Interface\\AddOns\\OrdaenCore\\media\\xp-fill-steel", "shine": [1, 0.84, 0.59] }
    },
    // Controls (OrdaenCore.UI roles of the same names). Each asset gives a piece per state; a piece is an atlas name,
    // { "atlas" | "file", "alpha"?, "coords"? }, or slices: { left, center, right } (stretched across) or
    // { top, middle, bottom } (stretched down), each slice a piece. `size` is the natural [width, height]; slices
    // stretch the center/middle. The art is Blizzard's own, as Forever's windows use it (the WindowArt dumps of the
    // character, collections, professions, group finder and game menu windows, 2026-11-07); every state named here
    // was seen there. States the dumps didn't show (a red button's pushed or disabled art) aren't listed: the
    // renderer draws those from `normal` (tinted) until they are seen in game.
    "tab": {
      "blizzard": {
        "label": "CONTROL_BLIZZARD",
        "normal": { "left": "uiframe-tab-left", "center": "_uiframe-tab-center", "right": "uiframe-tab-right" },
        "selected": { "left": "uiframe-activetab-left", "center": "_uiframe-activetab-center", "right": "uiframe-activetab-right" },
        "highlight": { "left": { "atlas": "uiframe-tab-left", "alpha": 0.4 }, "center": { "atlas": "_uiframe-tab-center", "alpha": 0.4 }, "right": { "atlas": "uiframe-tab-right", "alpha": 0.4 } }
      }
    },
    "sideTab": {
      "blizzard": {
        "label": "CONTROL_BLIZZARD", "size": [55, 60],
        "normal": "common-sidetab", "selected": "common-sidetab-selected", "highlight": "common-sidetab-hover",
        "mask": "common-sidetab-mask"
      }
    },
    "pushButton": {
      // Our own (art/button.py, media/button.tga; the user's pick 2026-11-07: the bronze plate): a dark plate in the
      // windows' bronze rim. Each state is a row of the file; the caps are half as wide as the button is high.
      "ordaen": {
        "label": "CONTROL_ORDAEN",
        "normal": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0, 0.125], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0, 0.125] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0, 0.125], "aspect": 0.5 } },
        "pushed": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.125, 0.25], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.125, 0.25] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.125, 0.25], "aspect": 0.5 } },
        "disabled": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.25, 0.375], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.25, 0.375] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.25, 0.375], "aspect": 0.5 } },
        "highlight": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.375, 0.5], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.375, 0.5] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.375, 0.5], "aspect": 0.5 } }
      },
      // The accent (the user's pick 2026-11-07: preview #1, red with the bronze rim) for buttons that need to stand
      // out: leaving the game, later other important actions. Rows 4-7 of the same file.
      "ordaen-accent": {
        "label": "CONTROL_ORDAEN_ACCENT",
        "normal": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.5, 0.625], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.5, 0.625] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.5, 0.625], "aspect": 0.5 } },
        "pushed": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.625, 0.75], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.625, 0.75] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.625, 0.75], "aspect": 0.5 } },
        "disabled": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.75, 0.875], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.75, 0.875] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.75, 0.875], "aspect": 0.5 } },
        "highlight": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.875, 1], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.875, 1] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.875, 1], "aspect": 0.5 } }
      },
      "blizzard": {
        "label": "CONTROL_BLIZZARD",
        "normal": { "left": "128-RedButton-Left", "center": "_128-RedButton-Center", "right": "128-RedButton-Right" },
        "highlight": "128-RedButton-Highlight"
      }
    },
    "marker": {
      // Marks a control that holds something new (Blizzard's floating «new» label): drawn at the control's left
      // end, `inset` UI units in from its left side (clear of the rim: 4 touched it, the user 2026-11-07), at `size`
      // (art/gem.py; the user's pick 2026-11-07).
      "gem": { "label": "MARKER_GEM", "file": "Interface\\AddOns\\OrdaenCore\\media\\new-gem", "size": [16, 16], "inset": 12 }
    },
    "panelCell": {
      // The bottom panel's cells (art/panel.py, the user's design 2026-11-07): our button's side rims only, the
      // panel's wood showing through. Rows of media/panel-cell.tga: 0 normal, 1 the hover glow alone, 2 pushed.
      "ordaen": {
        "label": "CONTROL_ORDAEN",
        "normal": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\panel-cell", "coords": [0, 0.125, 0, 0.25], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\panel-cell", "coords": [0.125, 0.875, 0, 0.25] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\panel-cell", "coords": [0.875, 1, 0, 0.25], "aspect": 0.5 } },
        "highlight": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\panel-cell", "coords": [0, 0.125, 0.25, 0.5], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\panel-cell", "coords": [0.125, 0.875, 0.25, 0.5] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\panel-cell", "coords": [0.875, 1, 0.25, 0.5], "aspect": 0.5 } },
        "pushed": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\panel-cell", "coords": [0, 0.125, 0.5, 0.75], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\panel-cell", "coords": [0.125, 0.875, 0.5, 0.75] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\panel-cell", "coords": [0.875, 1, 0.5, 0.75], "aspect": 0.5 } }
      }
    },
    "closeButton": {
      "blizzard": { "label": "CONTROL_BLIZZARD", "size": [28, 28], "normal": "RedButton-Exit", "highlight": "RedButton-Highlight" }
    },
    "checkbox": {
      // the classic check box (the group finder's): files, all states known
      "blizzard": {
        "label": "CONTROL_BLIZZARD", "size": [24, 24],
        "normal": { "file": "Interface\\Buttons\\UI-CheckBox-Up" },
        "pushed": { "file": "Interface\\Buttons\\UI-CheckBox-Down" },
        "highlight": { "file": "Interface\\Buttons\\UI-CheckBox-Highlight" },
        "checked": { "file": "Interface\\Buttons\\UI-CheckBox-Check" },
        "disabledChecked": { "file": "Interface\\Buttons\\UI-CheckBox-Check-Disabled" }
      }
    },
    "dropdown": {
      // Ours (the user's approved bags layout, 2026-11-07): the push button's bronze plate, its states the same rows of
      // media/button.tga, and a gold arrow (art/arrow.py: 16x16 UI units, the triangle centred) inside the right end.
      "ordaen": {
        "label": "CONTROL_ORDAEN",
        "normal": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0, 0.125], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0, 0.125] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0, 0.125], "aspect": 0.5 } },
        "pushed": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.125, 0.25], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.125, 0.25] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.125, 0.25], "aspect": 0.5 } },
        "disabled": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.25, 0.375], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.25, 0.375] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.25, 0.375], "aspect": 0.5 } },
        "highlight": { "left": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0, 0.125, 0.375, 0.5], "aspect": 0.5 }, "center": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.125, 0.875, 0.375, 0.5] }, "right": { "file": "Interface\\AddOns\\OrdaenCore\\media\\button", "coords": [0.875, 1, 0.375, 0.5], "aspect": 0.5 } },
        "arrow": { "file": "Interface\\AddOns\\OrdaenCore\\media\\dropdown-arrow", "size": [16, 16], "inset": 6 }
      },
      // Blizzard's: the field (its art includes a soft shadow: 41 high around a 26 high field) and the arrow button
      "blizzard": { "label": "CONTROL_BLIZZARD", "normal": "common-dropdown-textholder", "arrow": "common-dropdown-a-button" }
    },
    "input": {
      "blizzard": {
        "label": "CONTROL_BLIZZARD", "size": [0, 20],
        // a nine-slice: its ends at their own width, top and bottom 6 px of the art, so the border stays thin when taller;
        // drawn at 0.4 of the art (about 2.4 px edges), as thin as the plates' rims (the user, 2026-11-07)
        "normal": { "left": "common-search-border-left", "center": "common-search-border-middle", "right": "common-search-border-right", "edges": [6], "scale": 0.4 }
      }
    },
    "scrollTrack": {
      "blizzard": {
        "label": "CONTROL_BLIZZARD", "size": [8, 0],
        "normal": { "top": "minimal-scrollbar-track-top", "middle": "!minimal-scrollbar-track-middle", "bottom": "minimal-scrollbar-track-bottom" }
      }
    },
    "scrollThumb": {
      "blizzard": {
        "label": "CONTROL_BLIZZARD", "size": [8, 0],
        "normal": { "top": "minimal-scrollbar-small-thumb-top", "middle": "minimal-scrollbar-small-thumb-middle", "bottom": "minimal-scrollbar-small-thumb-bottom" }
      }
    },
    "scrollStepper": {
      "blizzard": { "label": "CONTROL_BLIZZARD", "size": [17, 11], "back": "minimal-scrollbar-arrow-top", "forward": "minimal-scrollbar-arrow-bottom" }
    },
    "slot": {
      // an item slot: the character window's ring behind a 37 px icon (the ring is 55: 9 px around), the square
      // highlight and the icon's rounded mask, as on the character window's slots
      "blizzard": {
        "label": "CONTROL_BLIZZARD", "size": [37, 37],
        "background": { "atlas": "UI-Character-Info-GearSlot", "outset": 9 },
        "highlight": { "file": "Interface\\Buttons\\ButtonHilight-Square" },
        "mask": { "file": 2922105 }
      }
    }
  },
  "tokens": {
    "frame.border": "frame",
    // window, dialog and inset (panes inside a window): border and fill each
    "frame.background": "background",
    "frame.portrait": "frame", // a window with Blizzard's portrait ring (Ordaen Reskin)
    "frame.borderSmall": "frame", // small surfaces (tooltip, panel strip, chat window), at frame.scale.small
    "frame.dialog": "frame",
    "frame.dialogBackground": "background",
    "frame.inset": "frame",
    "frame.insetBackground": "background",
    // the window border's scale: windows, and small surfaces (tooltip, panel strip, chat window)
    "frame.scale.window": "number",
    "frame.scale.small": "number",
    "font.body": "font",
    "font.header": "font",
    "font.numbers": "font",
    "font.world": "font",
    "color.accent": "color",
    "color.positive": "color",
    "color.negative": "color",
    "color.warning": "color",
    "color.disabled": "color",
    "color.icon": "color",
    "color.muted": "color",
