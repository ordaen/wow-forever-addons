    "color.palette.violet": "color", "color.palette.violet.text": "color",
    "color.palette.pink": "color", "color.palette.pink.text": "color",
    "color.palette.tan": "color", "color.palette.tan.text": "color",
    "color.palette.white": "color", "color.palette.white.text": "color",
