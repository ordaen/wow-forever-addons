      "icon.crop": 0.08,
      "motion.fade": 0.15, "tooltip.delay": 0,
      "sound.open": "IG_MAINMENU_OPEN", "sound.close": "IG_MAINMENU_CLOSE", "sound.click": "U_CHAT_SCROLL_BUTTON",
      "control.tab": "blizzard", "control.sideTab": "blizzard", "control.pushButton": "ordaen", "control.pushButtonAccent": "ordaen-accent", "control.panelCell": "ordaen", "control.closeButton": "blizzard", "control.newMarker": "gem", "control.checkbox": "blizzard", "control.dropdown": "ordaen", "control.input": "blizzard", "control.scrollTrack": "blizzard", "control.scrollThumb": "blizzard", "control.scrollStepper": "blizzard", "control.slot": "blizzard"
