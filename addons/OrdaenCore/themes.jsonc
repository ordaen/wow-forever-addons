      "frame.inset": "inset", "frame.insetBackground": "inset",
      "frame.scale.window": 1, "frame.scale.small": 0.5,
      "font.body": "body", "font.header": "header", "font.numbers": "numbers", "font.world": "ui",
      "color.accent": [0.72, 0.56, 0.34],
