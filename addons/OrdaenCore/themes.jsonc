// Ordaen's themes (design settings/, «Темы»): a theme is a preset of the look's values, the ones below. Three ship;
// the player edits any of them (only what they change is stored) or makes their own as a copy (OrdaenCore/Themes.lua).
// The build checks it (every theme gives every value one of its type) and writes it for the game (ns.THEMES) and as
// themes.json, which the design site's previews read: these presets exist only here.
//   assets: what a choice value picks from, per kind, in menu order; a font's file (and its bold) or `standard`, the
//           client's own text font (STANDARD_TEXT_FONT, Cyrillic on ruRU); a bar's file. Labels by key:
//           THEME_<KIND>_<ID> (THEME_FONT_FIRASANS).
//   values: each value's type: color ({ r, g, b } from 0 to 1), boolean, or an asset kind. Labels THEME_<KEY>
//           (dots as underscores: THEME_PALETTE_RED), tips THEME_<KEY>_TIP.
//   themes: each built-in theme's value for every value.
{
  "assets": {
    "font": {
      "firaSans": {"file": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\FiraSans-Regular.ttf", "bold": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\FiraSans-Medium.ttf"},
      "alegreyaSans": {"file": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\AlegreyaSans-Regular.ttf", "bold": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\AlegreyaSans-Medium.ttf"},
      "ptSans": {"file": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\PTSans-Regular.ttf", "bold": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\PTSans-Bold.ttf"},
      "philosopher": {"file": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\Philosopher-Regular.ttf", "bold": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\Philosopher-Bold.ttf"},
      "alegreyaSC": {"file": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\AlegreyaSC-Medium.ttf"},
      "forum": {"file": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\Forum-Regular.ttf"},
      "cormorantSC": {"file": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\CormorantSC-SemiBold.ttf"},
      "firaCondensed": {"file": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\FiraSansCondensed-Medium.ttf"},
      "ptSansNarrow": {"file": "Interface\\AddOns\\OrdaenCore\\media\\fonts\\PTSansNarrow-Regular.ttf"},
      "friz": {"standard": true},
      "arialNarrow": {"file": "Fonts\\ARIALN.TTF"}
    },
