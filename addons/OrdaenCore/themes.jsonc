// The shared part of every Ordaen theme: the tokens addons' look settings follow, the assets (art, fonts, bar
// textures) those refer to, and each theme's value for every token. The build checks it (every theme gives every
// token a value of its type) and generates ThemeTokens.lua. Addons never define their look: their look settings
// default to these tokens (docs/reference/settings.md). The UI renderer's surfaces and text styles are in
// OrdaenCore_UI/Theme.lua and take their accent and fonts from here.
{
  "assets": {
    "frame": {
      "bronze-rim": { "label": "FRAME_BRONZE_RIM", "file": "Interface\\AddOns\\OrdaenCore\\media\\bronze-rim-frame", "outset": 11 },
      "gold": { "label": "FRAME_GOLD", "edgeFile": "Interface\\DialogFrame\\UI-DialogBox-Border", "edgeSize": 24, "outset": 7 },
      "tooltip": { "label": "FRAME_TOOLTIP", "edgeFile": "Interface\\Tooltips\\UI-Tooltip-Border", "edgeSize": 16, "outset": 4 },
      "thin": { "label": "FRAME_THIN", "edgeFile": "Interface\\Buttons\\WHITE8X8", "edgeSize": 2, "outset": 2, "natural": [0, 0, 0] },
      "none": { "label": "FRAME_NONE" }
    },
    "font": {
      "body": { "label": "FONT_BODY", "object": "GameTooltipText" },
      "header": { "label": "FONT_HEADER", "object": "GameTooltipHeaderText" },
      "ui": { "label": "FONT_UI", "object": "GameFontNormal" },
      "numbers": { "label": "FONT_NUMBERS", "object": "NumberFontNormal" }
    },
    "bar": {
      "ordaen": { "label": "BAR_ORDAEN", "file": "Interface\\AddOns\\OrdaenCore\\media\\bar-ordaen" },
      "flat": { "label": "BAR_FLAT", "file": "Interface\\Buttons\\WHITE8X8" },
      "blizzard": { "label": "BAR_BLIZZARD", "file": "Interface\\TargetingFrame\\UI-StatusBar" }
    }
  },
  "tokens": {
    "frame.border": "frame",
    "font.body": "font",
    "font.header": "font",
    "font.numbers": "font",
    "font.world": "font",
    "color.accent": "color",
    "color.positive": "color",
    "color.negative": "color",
    "color.warning": "color",
    "color.disabled": "color",
    "color.icon": "color",
    "color.muted": "color",
    "bar.texture": "bar",
    "color.xp": "color",
    "color.quest": "color",
    "color.rested": "color",
    "color.reputation.hated": "color",
    "color.reputation.hostile": "color",
    "color.reputation.unfriendly": "color",
    "color.reputation.neutral": "color",
    "color.reputation.friendly": "color",
    "color.reputation.honored": "color",
    "color.reputation.revered": "color",
    "color.reputation.exalted": "color",
    "icon.crop": "number",
    "motion.fade": "number",
    "tooltip.delay": "number",
    "sound.open": "sound",
    "sound.close": "sound",
    "sound.click": "sound"
  },
  "themes": {
    "ordaen": {
      "frame.border": "bronze-rim",
      "font.body": "body", "font.header": "header", "font.numbers": "numbers", "font.world": "ui",
      "color.accent": [0.72, 0.56, 0.34],
      "color.positive": [0.45, 0.80, 0.40], "color.negative": [1, 0.34, 0.28], "color.warning": [1, 0.62, 0.25],
      "color.disabled": [0.5, 0.5, 0.5], "color.icon": [0.92, 0.85, 0.72], "color.muted": [0.62, 0.58, 0.52],
      "bar.texture": "ordaen",
      "color.xp": [0.58, 0.12, 0.66], "color.quest": [0.8, 0.5, 0.86], "color.rested": [0.1, 0.42, 0.9],
      "color.reputation.hated": [0.8, 0.3, 0.22], "color.reputation.hostile": [0.8, 0.3, 0.22],
      "color.reputation.unfriendly": [0.75, 0.27, 0], "color.reputation.neutral": [0.9, 0.7, 0],
      "color.reputation.friendly": [0, 0.6, 0.1], "color.reputation.honored": [0, 0.6, 0.1],
      "color.reputation.revered": [0, 0.6, 0.1], "color.reputation.exalted": [0, 0.6, 0.1],
      "icon.crop": 0.08,
      "motion.fade": 0.15, "tooltip.delay": 0,
      "sound.open": "IG_MAINMENU_OPEN", "sound.close": "IG_MAINMENU_CLOSE", "sound.click": "U_CHAT_SCROLL_BUTTON"
    }
    // Planned, not built (user's decision, 2026-11-07): "blizzard" (mostly Blizzard's default look) and "minimal"
    // (little to no textures). Only Ordaen is worked on now; add them back here, with every token, when they are.
  }
}
