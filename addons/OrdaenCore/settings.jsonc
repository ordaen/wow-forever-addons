// Ordaen Core's settings: how every Ordaen addon looks (docs/reference/settings.md).
{
  "db": "OrdaenCoreDB",
  "title": "SETTINGS_TITLE",
  "sections": [
    {
      "header": "HEADER_APPEARANCE",
      "settings": {
        "ui.theme": {
          "type": "choice",
          // Only Ordaen for now (Blizzard and Minimal are planned, not built): kept as a setting, not on the page.
          "choices": [
            { "id": "ordaen", "label": "THEME_ORDAEN" }
          ],
          "default": "ordaen",
          "page": false
        },
        "ui.textSize": {
          "type": "number", "min": 10, "max": 16, "step": 1, "format": "px", "default": 12,
          "label": "TEXT_SIZE", "tooltip": "TEXT_SIZE_TOOLTIP"
        }
      }
    },
    {
      "settings": {
        // "<ours>:<theirs>" -> true: the player kept both addons of a conflict (Conflict.lua; at most 50)
        "keptConflicts": { "type": "map", "of": "boolean", "default": {}, "page": false }
      }
    }
  ]
}
