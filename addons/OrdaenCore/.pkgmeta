package-as: OrdaenCore

# CHANGELOG.md is written by release-please; ship it instead of a generated git log.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - version.txt

# Ship the optional debug module as its own addon folder in the same zip.
move-folders:
  OrdaenCore/OrdaenCore_Debug: OrdaenCore_Debug
