package-as: OrdaenCore

# CHANGELOG.md is written by release-please; ship it instead of a generated git log.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - version.txt

# Ship the UI framework module as its own (load-on-demand) addon folder in the same zip.
move-folders:
  OrdaenCore/OrdaenCore_UI: OrdaenCore_UI
