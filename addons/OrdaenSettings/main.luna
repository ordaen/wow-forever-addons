// Ordaen Settings: the one settings window. Ordaen's own page (General: the settings every module follows) and
// every module in the list on the left with its switch, the chosen one's page beside it: its tabs, and the picked
// tab's rows, which are the module's own. Every page's changes wait in the drafts until «Save»; closing with
// changes unsaved asks first.
import { Align, Edges, Overflow, Position, Track } from "$ltml"
import Ordaen from "Ordaen"
import { Dialog, ListTab, Placing, PushButton, PX, Tabs, Window, WindowTabSpec } from "OrdaenLibrary"
import Locale from "@/locales"
import { ModuleRow } from "@/moduleRow"
import { BehaviourPage, NumbersPage, ScalePage } from "@/general"
import { LookPage } from "@/look"

// The window's body at first, and the smallest it resizes to: the list, a row and the foot fit.
const WIDTH = 1160 * PX
const HEIGHT = 700 * PX
const MIN_WIDTH = 900 * PX
const MIN_HEIGHT = 480 * PX
// The pages that aren't a module's: Ordaen's own, and its look.
const GENERAL = ""
const LOOK = "look"

// The question on closing with unsaved changes: as wide as its three buttons, the room round them and its frame.
const CONFIRM_WIDTH = 484 * PX

const DIM: Color = Color.hex("#a3977f")
const INK: Color = Color.hex("#e8dcc4")
const PAGE_BACK: Color = Color.hex("#00000040")
const FILL: Array<Track> = [{ fr: 1 }]
const BODY: Array<Track> = ["auto", { fr: 1 }]
// The list's heading over the modules: 10 px above, 4 below.
const HEADING: Edges = { top: 10 * PX, right: 16 * PX, bottom: 4 * PX, left: 16 * PX }
const FOOT_HEIGHT = 34 * PX
const ROWS_PAD: Edges = { top: 14 * PX, right: 18 * PX, left: 18 * PX }
const ROWS_BOTTOM = (18 + 6) * PX + FOOT_HEIGHT
const FOOT: Array<Track> = ["auto", { fr: 1 }, "auto"]
const SAVE_ROW: Array<Track> = ["auto", "auto"]

public class Settings implements Ordaen.Module {
  public const title: String = "Ordaen Settings"
  // Ordaen's own page: the settings every module follows.
  public const pages: Array<Ordaen.SettingsPage> = [
    { title: Locale.GLOBAL_TAB_SCALE, content: $ltml { <ScalePage globals={mut Ordaen.globals} /> } },
    { title: Locale.GLOBAL_TAB_NUMBERS, content: $ltml { <NumbersPage globals={mut Ordaen.globals} /> } },
    { title: Locale.GLOBAL_TAB_BEHAVIOR, content: $ltml { <BehaviourPage globals={mut Ordaen.globals} /> } },
  ]

  state open = false
  // The page shown: Ordaen's own, its look, or a module's folder; and its tab.
  state page = GENERAL
  state tab = 1
  // Asking about unsaved changes.
  state closing = false
  state placing: Placing = { x: 0, y: 0, width: WIDTH, height: HEIGHT }
  state titles: Array<WindowTabSpec> = [{ title: Ordaen.title }]
  state titleTab = 1

  const nothing: Template = $ltml {}
  derived heading: String = Locale.LIST_MODULES.upper()
  derived onGeneral: Boolean = self.page == GENERAL
  derived onLook: Boolean = self.page == LOOK
  // The module whose page is shown, where it is a module's.
  derived entry: any Ordaen.Entry | nil = self.entryOf()
  derived isOff: Boolean = self.offNow()
  derived shown: Array<Ordaen.SettingsPage> = self.pagesOf()
  derived names: Array<String> = self.namesOf()
  derived hasTabs: Boolean = self.names.length > 1
  derived content: Template = self.contentOf()
  derived unchanged: Boolean = Ordaen.unsaved == 0

  entryOf(self): any Ordaen.Entry | nil {
    for (entry of Ordaen.modules) {
      if (entry.folder == self.page) { return entry }
    }
    return nil
  }

  offNow(self): Boolean {
    let entry = self.entry
    if (entry == nil) { return false }
    return !entry.on
  }

  pagesOf(self): Array<Ordaen.SettingsPage> {
    let entry = self.entry
    if (entry == nil) { return self.pages }
    return entry.pages
  }

  namesOf(self): Array<String> {
    let list: Array<String> = []
    for (page of self.shown) { list.push(page.title) }
    return list
  }

  contentOf(self): Template {
    let page = self.shown[self.tab]
    if (page == nil) { return self.nothing }
    return page.content
  }

  // /ordaen, /ordaen <module> and every Ordaen button: open on that page, or close when it is the one shown.
  constructor() {
    Ordaen.settingsAsked.listen(self.asked)
  }

  // Ordaen was asked for its settings: its button by the minimap, its command.
  asked(mut self, page: String | nil) {
    self.toggle(page ?? "")
  }

  public toggle(mut self, page: String) {
    if (self.open && self.page == page) {
      self.onClose()
      return
    }
    self.show(page)
    self.open = true
  }

  show(mut self, page: String) {
    if (self.page != page) {
      self.page = page
      self.tab = 1
    }
  }

  pickGeneral(mut self) { self.show(GENERAL) }
  pickLook(mut self) { self.show(LOOK) }
  onPick(mut self, folder: String) { self.show(folder) }

  // Closing asks first while anything is unsaved.
  onClose(mut self) {
    if (Ordaen.unsaved > 0) {
      self.closing = true
      return
    }
    self.open = false
  }

  save(mut self) { Ordaen.saveAll() }
  rollback(mut self) { Ordaen.rollbackAll() }
  placingMode(mut self) { Ordaen.togglePlacing() }
  stay(mut self) { self.closing = false }

  closeSaving(mut self) {
    Ordaen.saveAll()
    self.closing = false
    self.open = false
  }

  closeDiscarding(mut self) {
    Ordaen.discardAll()
    self.closing = false
    self.open = false
  }

  public render(self): Template {
    return $ltml {
      <Window $if={self.open} tabs={self.titles} selected={mut self.titleTab} placing={mut self.placing}
              minWidth={MIN_WIDTH} minHeight={MIN_HEIGHT} @close={self.onClose}>
        <box columns={BODY} rows={FILL}>
          <box columns={1}>
            <ListTab label={Locale.LIST_GLOBAL} icon={Ordaen.icon} selected={self.onGeneral}
                     @pick={self.pickGeneral} />
            <ListTab label={Locale.LIST_THEMES} icon={Ordaen.icon} selected={self.onLook}
                     @pick={self.pickLook} />
            <box padding={HEADING}>
              <text value={self.heading} textColor={DIM} textSize={12 * PX} textFamily={Ordaen.lookArt.fontNumbers} />
            </box>
            <box columns={1}>
              <ModuleRow $for={entry of Ordaen.modules} entry={peek entry} shown={self.page} @pick={self.onPick} />
            </box>
          </box>
          <box background={PAGE_BACK}>
            <box position={Position.Absolute} left={0} right={0} top={0} bottom={ROWS_BOTTOM}
                 padding={ROWS_PAD} columns={1} gap={14 * PX} overflow={Overflow.Scroll}>
              <LookPage $if={self.onLook} look={mut Ordaen.look} />
              <text $elseif={self.isOff} value={Locale.MODULE_OFF} textColor={DIM} textSize={15 * PX} />
              <$else>
                <Tabs $if={self.hasTabs} tabs={self.names} selected={mut self.tab} />
                <box columns={1} gap={14 * PX}>
                  {self.content}
                </box>
              </>
            </box>
            <box position={Position.Absolute} left={18 * PX} right={18 * PX} bottom={18 * PX}
                 height={FOOT_HEIGHT} columns={FOOT} yAlign={Align.Center} gap={12 * PX}>
              <PushButton label={Locale.PLACING} width={200 * PX} @click={self.placingMode} />
              <box>
                <text $if={self.onGeneral} value={Locale.OPENS_PAGE} textColor={DIM} textSize={13 * PX} />
              </box>
              <box columns={SAVE_ROW} gap={8 * PX}>
                <PushButton $if={Ordaen.rollbackable} label={Locale.ROLLBACK} width={130 * PX}
                            @click={self.rollback} />
                <PushButton label={Locale.SAVE} width={140 * PX} disabled={self.unchanged} @click={self.save} />
              </box>
            </box>
          </box>
        </box>
      </Window>
      <Dialog $if={self.closing} title={Locale.UNSAVED_TITLE} width={CONFIRM_WIDTH}>
        <text value={Locale.UNSAVED_ASK} textColor={INK} textSize={15 * PX} />
        <PushButton #buttons label={Locale.CANCEL} width={120 * PX} @click={self.stay} />
        <PushButton #buttons label={Locale.DONT_SAVE} width={150 * PX} @click={self.closeDiscarding} />
        <PushButton #buttons label={Locale.SAVE} width={140 * PX} @click={self.closeSaving} />
      </Dialog>
    }
  }
}
