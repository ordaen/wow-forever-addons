// The tracker's tab in the settings window: how many quests it lists, when its ground shows and how dark it is. Each
// control writes one entry of the settings, at once; where it stands is the placing mode's.
import { Choice, Component, Dropdown, NumberInput, Settings, Unit } from "Ordaen"
import Locale from "@/locales"

// The most quests the client tracks (`MAX_WATCHABLE_QUESTS`).
const MOST_TRACKED = 25

// When the ground under the list shows: while the cursor is over the tracker, or all the time (an opacity of 0 shows
// none either way).
public enum GroundShown implements Plain { Hover = "hover", Always = "always" }

const GROUND_SHOWN: array<Choice<GroundShown>> = [
  { value: GroundShown::Hover, label: Locale::GROUND_ON_HOVER },
  { value: GroundShown::Always, label: Locale::GROUND_ALWAYS }
]

public struct Choices implements Plain {
  // The most quests it lists, the first of the tracked; the rest wait until one before them goes.
  public mut listed: integer
  // When its ground shows, and how opaque it is, from 0 to 1.
  public mut groundShown: GroundShown
  public mut ground: number
}

public const DEFAULTS: Choices = { listed: MOST_TRACKED, groundShown: GroundShown::Hover, ground: 0.55 }

public class GeneralPage implements Component {
  settings: mut Settings<Choices>
  constructor(settings: mut Settings<Choices>) {
    self.settings = settings
  }

  public render(): Template {
    return $ltml {
      <NumberInput label={Locale::LISTED} hint={Locale::LISTED_TIP} value={mut self.settings.values.listed} least={1}
                   most={MOST_TRACKED} />
      <Dropdown label={Locale::GROUND_SHOWN} hint={Locale::GROUND_SHOWN_TIP} value={mut self.settings.values.groundShown}
                choices={GROUND_SHOWN} />
      <NumberInput label={Locale::GROUND} hint={Locale::GROUND_TIP} value={mut self.settings.values.ground} least={0}
                   most={1} step={0.05} unit={Unit::Percent} />
    }
  }
}
