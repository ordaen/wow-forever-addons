// Ordaen Tracker: the tracked quests at the screen's right in Ordaen's look, in place of the game's objective tracker,
// which is kept unseen while it is on. It draws each tracked quest from the client by itself (its level, title, tag,
// objectives); other modules add lines under a quest through `questLines` (Quests: where to go, whom to hand it to).
// The clicks are Blizzard's tracker's: a chat link first, Shift+click untracks, a click opens the quest in the log,
// Right-click opens its menu, which also points the way to it. Its settings say how many quests it lists, when its
// ground shows (on hover by default) and how dark it is (the chat's rounded ground); the placing mode moves it.
import Client from "$client"
import Events from "$events"
import Game from "$game"
import { Action, Align, Anchored, Bounds, Edges, FillDuration, Gaps, Overflow, Point, Track } from "$ltml"
import root Ordaen from "Ordaen"
import { BRIGHT_TEXT, ButtonPlate, Component, Dialog, ItemButton, Menu, MenuEntry, Module, Placed, PushButton, RoundedFill, SECONDARY_TEXT, Settings, SettingsPage, playSound, questLevelColor } from "Ordaen"
import { QuestLevel } from "OrdaenQuestPage"
import { QuestLine, QuestLines } from "@/extend"
import Locale from "@/locales"
import { Choices, DEFAULTS, GeneralPage, GroundShown } from "@/settings"

// As wide as the design's tracker (360 px), never narrower.
const WIDTH: Bounds = { min: 351.5625dp, max: nil }
// Off the screen's right edge, and off what stands over and under it.
const EDGE = 11.71875dp
const GAP = 7.03125dp
// The tracker's part, as the placing mode keeps where the player put it.
const PART = "OrdaenTracker.quests"
const PAD: Edges = { top: 3sp, right: 3sp, bottom: 3sp, left: 3sp }
const DIM: Color = Color.hex("#a3977f")
const RED: Color = Color.hex("#ff2020")
// Its quests, in all its height.
const ROWS: Array<Track> = [{ fr: 1 }]
// A quest: its level, and beside it its title line with its lines under, which start where the title starts.
const QUEST: Array<Track> = ["max-content", { fr: 1 }]
// Between a quest's title line and its lines, and its level and its title.
const LINES_GAP: Gaps = { columns: 2sp, rows: 1sp }
const TITLE: Array<Track> = [{ fr: 1 }, "max-content", "max-content", "max-content"]
// The mark of a quest done, at its title's right, as the game's ready check says ready.
const CHECK: Asset = "Interface/RaidFrame/ReadyCheck-Ready"
const CHECK_SIZE = 14ui
const ITEM = 24.375dp
const ASK = 468.75dp
const ASK_BUTTON = 140.625dp

// The client's quest tags as Forever writes them after a tracked quest's title (`GetQuestTagText`).
function tagText(tag: Integer | nil): String {
  return match (tag ?? 0) {
    1 => Locale.TAG_GROUP
    41 => Locale.TAG_PVP
    62 => Locale.TAG_RAID
    81 => Locale.TAG_DUNGEON
    else => ""
  }
}

// The first `count` of the quests, or all of them where there are fewer.
function firstOf(quests: Array<Game.LogQuest>, count: Integer): Array<Game.LogQuest> {
  const first: Array<Game.LogQuest> = []
  for (quest of quests) {
    if (first.length >= count) { break }
    first.push(quest)
  }
  return first
}

// Whether one of the quests has its special item.
function hasItem(quests: Array<Game.LogQuest>): Boolean {
  for (quest of quests) {
    if (quest.item > 0) { return true }
  }
  return false
}

// What a tracked quest's row asks of the tracker.
public enum Ask { Open, Link, Untrack, SuperTrack, ShowOnMap, Share, Abandon }

public class Tracker implements Module, App {
  public const title: String = "Ordaen Tracker"
  public settings: mut Settings<Choices> = new Settings<Choices>(DEFAULTS)
  public const pages: Array<SettingsPage> = [
    { title: Locale.TAB_GENERAL, content: $ltml { <GeneralPage settings={mut self.settings} /> } }
  ]
  // What the modules add under each tracked quest.
  public const questLines = new Registry<any QuestLines>()

  // The tracked quests, in the log's order; the one the client points the way to; the log's size.
  public state quests: Array<Game.LogQuest> = []
  public state superTracked = 0
  // The zone the player is in, as the log's headers name it: only its quests are listed.
  state zone = ""
  // The cursor over it: what shows its ground where the settings say on hover.
  state hovered = false
  // The quest the player asked to abandon (0: none).
  state abandoning = 0
  // Every objective's text, to hear progress roll forward.
  state heard: Map<Integer, String> = {}
  // The cooldown running on each tracked quest's item, by the quest.
  state cooldowns: Map<Integer, FillDuration> = {}

  derived abandonText: String = Locale.ABANDON_ASK.format(self.quests.find(quest => quest.id == self.abandoning)?.title ?? "")
  derived level: Integer = Game.player.level
  // The tracked quests of the zone the player is in (an instance's own in a dungeon, a raid or a battleground: the
  // log heads them by its name), as many as the settings list.
  derived here: Array<Game.LogQuest> = self.quests.filter(quest => quest.header == self.zone)
  derived listed: Array<Game.LogQuest> = firstOf(self.here, self.settings.values.listed)
  derived ground: Color = { r: 0, g: 0, b: 0, a: self.settings.values.ground }
  derived grounded: Boolean = self.settings.values.groundShown == GroundShown.Always || self.hovered
  // Shown while it lists a quest, and in the placing mode, to be moved.
  derived drawn: Boolean = self.here.length > 0 || Ordaen.placing
  // Its place while the player never moved it: along the right edge, from under what keeps the top right corner (the
  // minimap) down to above what keeps the bottom edge (the bottom panel, a damage meter there), all of that height; it
  // scrolls past it.
  derived home: Anchored = { point: Point.TopRight, to: Point.TopRight, x: -EDGE, y: Ordaen.topRightTaken + GAP }
  // The most it is: as high as its quests up to that, its list scrolling past it.
  derived height: Number<Length> = (Client.UIParent.GetHeight() * 1ui - Ordaen.topRightTaken - Ordaen.bottomTaken - 2 * GAP).max(0ui)

  constructor() {
    Ordaen.modules.add(self)
    self.refresh()
    Events.QUEST_LOG_UPDATE.listen(self.refresh)
    Events.QUEST_WATCH_LIST_CHANGED.listen(self.refresh)
    Events.SUPER_TRACKING_CHANGED.listen(self.refresh)
    Events.BAG_UPDATE_COOLDOWN.listen(self.readCooldowns)
    Events.ZONE_CHANGED_NEW_AREA.listen(self.refresh)
  }

  // The tracked quests as the client has them now; an objective that moved on sounds as the game's tracker does.
  public refresh(mut self) {
    const tracked = Game.questLog.quests().filter(quest => quest.tracked)
    const heard: Map<Integer, String> = {}
    let rolled = false
    const before = peek self.heard
    for (quest of tracked) {
      const now = quest.objectives.map(objective => objective.text).join("|")
      heard[quest.id] = now
      const was = before[quest.id]
      if (was != nil && was != now) { rolled = true }
    }
    if (rolled) { playSound("UI_QUEST_ROLLING_FORWARD_01") }
    self.heard = heard
    self.quests = tracked
    self.superTracked = Game.questLog.superTracked()
    self.zone = Game.questLog.zone()
    self.readCooldowns()
  }

  // The cooldowns running on the tracked quests' items, as the client says one started or ended
  // (`BAG_UPDATE_COOLDOWN`, which every use of an item or a spell sends: nothing is read while no quest has an item).
  readCooldowns(mut self) {
    const quests = peek self.quests
    // A quest without its item draws no button: what is kept of it stays unread.
    if (!hasItem(quests)) { return }
    const running: Map<Integer, FillDuration> = {}
    for (quest of quests) {
      const cooldown = quest.item > 0 ? Game.questLog.itemCooldown(quest.id) : nil
      if (cooldown != nil) { running[quest.id] = cooldown }
    }
    self.cooldowns = running
  }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  onAsk(mut self, id: Integer, ask: Ask) {
    match (ask) {
      .Open => { self.open(id) }
      // Shift+click, the game's order: a chat link where a chat line is open, else it stops tracking it.
      .Link => { if (!Game.chat.linkQuest(id)) { Game.questLog.track(id, false) } }
      .Untrack => { Game.questLog.track(id, false) }
      .SuperTrack => { Game.questLog.superTrack(peek self.superTracked == id ? 0 : id) }
      .ShowOnMap => { self.showOnMap(id) }
      .Share => { Game.questLog.share(id) }
      .Abandon => { self.abandoning = id }
    }
  }

  // The quest in the log: the first module that opens it, else the game's map with its log.
  open(self, id: Integer) {
    for (entry of self.questLines) {
      if (entry.open(id)) { return }
    }
    // The client opens the map for an addon out of a fight alone.
    if (!Game.situation.combat) { Client.C_Map.OpenWorldMap(nil) }
  }

  // The quest on the map: the first module that shows where it leads, else the game's map as it was.
  showOnMap(self, id: Integer) {
    for (entry of self.questLines) {
      if (entry.showOnMap(id)) { return }
    }
    Client.C_Map.OpenWorldMap(nil)
  }

  onAbandonYes(mut self) {
    const id = peek self.abandoning
    self.abandoning = 0
    if (id != 0) { Game.questLog.abandon(id) }
  }

  onAbandonNo(mut self) { self.abandoning = 0 }

  // The lines the modules add under a quest still to do.
  public linesOf(self, quest: Game.LogQuest): Array<QuestLine> {
    const lines: Array<QuestLine> = []
    if (quest.done || quest.failed) { return lines }
    for (entry of self.questLines) {
      for (line of entry.lines(quest.id)) { lines.push(line) }
    }
    return lines
  }

  public render(self): Template {
    return $ltml {
      <frame of={Game.frames.ObjectiveTracker} opacity={0} away={true} />
      <Placed $if={self.drawn} id={PART} title={Locale.PLACE} home={self.home}>
        <box width={WIDTH} height={{ max: self.height }} padding={PAD} rows={ROWS} gap={3sp} mouseThrough={true}
             @pointerEnter={self.onEnter}
             @pointerLeave={self.onLeave}>
          <RoundedFill $if={self.grounded} color={self.ground} />
          <box columns={1} gap={3sp} overflow={Overflow.Scroll}>
            <TrackedQuest $for={quest of self.listed} $key={quest.id} quest={quest} lines={self.linesOf(quest)}
                          pointed={quest.id == self.superTracked} player={self.level} cooldown={self.cooldowns[quest.id]}
                          @ask={self.onAsk} />
          </box>
        </box>
      </Placed>
      <Dialog $if={self.abandoning != 0} width={ASK} title={Locale.ABANDON}>
        <text value={self.abandonText} />
        <PushButton #buttons label={Locale.ABANDON} width={ASK_BUTTON} plate={ButtonPlate.Danger} @click={self.onAbandonYes} />
        <PushButton #buttons label={Locale.CANCEL} width={ASK_BUTTON} @click={self.onAbandonNo} />
      </Dialog>
    }
  }
}

// One tracked quest: its level and title, its tag, its item; its objectives, or that it
// is done or failed; the lines the modules add.
class TrackedQuest implements Component {
  public ask: Event<(Integer, Ask)> = new Event()
  state menuOpen = false

  derived levelColor: Color = questLevelColor(self.quest.level, self.player, BRIGHT_TEXT)
  derived tag: String = tagText(self.quest.tag)
  // The quest's item, used by the client's own secure click, as the game's tracker's item button uses it.
  derived use: Action | nil = Action.UseQuestItem { quest: self.quest.id }
  // Done: a green check at its title's right, no line of where to hand it in. Failed: said under its title.
  derived checked: Boolean = self.quest.done && !self.quest.failed
  derived entries: Array<MenuEntry> = [
    { label: self.pointed ? Locale.UNSUPER_TRACK : Locale.SUPER_TRACK },
    { label: Locale.OPEN_IN_LOG },
    // The client opens the map for an addon out of a fight alone.
    { label: Locale.SHOW_ON_MAP, disabled: Game.situation.combat },
    { label: Locale.UNTRACK },
    { label: Locale.SHARE, disabled: !self.quest.shareable },
    { label: Locale.ABANDON, group: true }
  ]

  quest: Signal<Game.LogQuest>
  lines: Signal<Array<QuestLine>>
  pointed: Signal<Boolean>
  player: Signal<Integer>
  // The cooldown running on its item, its button's sweep.
  cooldown: Signal<FillDuration | nil>
  constructor(
    quest: Signal<Game.LogQuest>,
    lines: Signal<Array<QuestLine>>,
    pointed: Signal<Boolean>,
    player: Signal<Integer>,
    cooldown: Signal<FillDuration | nil>
  ) {
    self.quest = quest
    self.lines = lines
    self.pointed = pointed
    self.player = player
    self.cooldown = cooldown
  }

  onOpen(mut self) { self.ask.emit(self.quest.id, Ask.Open) }
  onShift(mut self) { self.ask.emit(self.quest.id, Ask.Link) }
  onMenu(mut self) { self.menuOpen = true }
  onClose(mut self) { self.menuOpen = false }

  onEntry(mut self, index: Integer) {
    self.menuOpen = false
    const ask = match (index) {
      1 => Ask.SuperTrack
      2 => Ask.Open
      3 => Ask.ShowOnMap
      4 => Ask.Untrack
      5 => Ask.Share
      else => Ask.Abandon
    }
    self.ask.emit(self.quest.id, ask)
  }

  public render(self): Template {
    return $ltml {
      <box columns={QUEST} gap={LINES_GAP} yAlign={Align.Center}>
        <QuestLevel level={self.quest.level} group={self.quest.group > 1} color={self.levelColor} />
        <box columns={TITLE} gap={2sp} yAlign={Align.Center} @pointerPress(.Left)={self.onOpen} @pointerPress([.Shift, .Left])={self.onShift}
             @pointerPress(.Right)={self.onMenu}>
          <text value={self.quest.title} textColor={BRIGHT_TEXT} wrap={.Cut} />
          <text value={self.tag} textColor={DIM} textSize={SECONDARY_TEXT} wrap={.None} />
          <box $if={self.checked} width={CHECK_SIZE} height={CHECK_SIZE} background={CHECK} />
          <box $else />
          <ItemButton $if={self.quest.item > 0} item={self.quest.item} size={ITEM} action={self.use} linkOnShift={true}
                      cooldown={self.cooldown} />
          <box $else />
        </box>
        <box />
        <box columns={1} gap={1sp}>
          <box $if={!self.quest.done && !self.quest.failed} columns={1} gap={1sp}>
            <text $for={objective of self.quest.objectives} value={objective.text} textColor={BRIGHT_TEXT} />
          </box>
          <text $if={self.quest.failed} value={Locale.FAILED} textColor={RED} />
          <text $for={line of self.lines} value={line.text} textColor={DIM} />
          <Menu $if={self.menuOpen} entries={self.entries} title={self.quest.title} @pick={self.onEntry} @close={self.onClose} />
        </box>
      </box>
    }
  }
}
