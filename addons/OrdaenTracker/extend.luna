// What other modules do for the tracker: the contract, imported by type alone
// (`import type { QuestOpener } from "OrdaenTracker"`). An entry of the tracker's `openers` registry, added in a watch
// that follows the tracker's root, so it ends when either module ends. Without the tracker, Blizzard's stays and
// nothing is added.
public trait QuestOpener {
  // The player asked for the quest in the log (its row clicked, «Open in the log»): true where this entry opened it.
  public open(quest: integer): boolean
  // The player asked to see the quest on the map («Show on the map»): true where this entry showed it.
  public showOnMap(quest: integer): boolean
}
