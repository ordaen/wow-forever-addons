// What other modules add to the tracker: the contract, imported by type alone
// (`import type { QuestLines } from "OrdaenTracker"`). An entry of the tracker's `questLines` registry, added in a
// watch that follows the tracker's root, so it ends when either module ends. Without the tracker, Blizzard's stays and
// nothing is added.

// A line under a tracked quest's objectives, while it is to do (where to go): its text.
public struct QuestLine {
  const text: String
}

public trait QuestLines {
  // Its lines for a tracked quest still to do; none for a quest it knows nothing of. Asked as the tracker draws the
  // quest and again as what it read changes, never per frame. A done quest has none: its title's check says it.
  public lines(self, quest: Integer): Array<QuestLine>
  // The player asked for the quest in the log (its title clicked, «Open in the log»): true where this entry opened
  // it.
  public open(self, quest: Integer): Boolean
  // The player asked to see the quest on the map («Show on the map»): true where this entry showed it.
  public showOnMap(self, quest: Integer): Boolean
}
