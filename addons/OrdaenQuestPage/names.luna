// The names a quest's text speaks of (an NPC, an object, an item), found in its words however the language bends
// them («Кобольд-геомант» in «кобольдов-геомантов», «Gryan» in «Gryan's»), each marked in its ink as a link whose
// tooltip shows under the cursor: the game's own of an item, a tip of where an NPC or an object stands.
import Game from "$game"
import { Event, Frame } from "$ltml"
import { Component, Tip } from "Ordaen"
import { SCROLL_INK, SCROLL_LEADING } from "@/questPage"

// What a named thing is: an NPC or an object (a tip says its lines), or an item (the game's tooltip of its link).
public enum NamedKind { Figure = "figure", Item = "item" }

// A thing a quest names: its name in the player's language, what it is, the link its name is marked with
// (`ordaen:npc:448`, `item:2589`), and the lines a tip of a figure says under its name.
public struct Named {
  name: String
  kind: NamedKind
  link: String
  lines: Array<String>
}

// The inks a name is marked in on the parchment: a figure's rust, an item's deep blue; each 6:1 on the paper.
const FIGURE_INK = "7a2200"
const ITEM_INK = "123c6e"

// A word of a text: where it starts and ends (bytes), and how many letters it has.
struct Word {
  from: Integer
  to: Integer
  letters: Integer
}

// How many bytes the letter at `at` takes; 0 where no letter starts there (a space, a sign, a quote, a dash). A
// letter is a Latin one or a digit, an apostrophe inside a name (Mo'grosh), or any letter of two or three bytes but
// the general punctuation's (« » — … ’, which start with 0xC2 or 0xE2).
function letterAt(text: String, at: Integer): Integer {
  const b = text.byte(at) ?? 0
  if ((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 39) { return 1 }
  if (b >= 195 && b <= 223) { return 2 }
  if (b >= 224 && b <= 239 && b != 226) { return 3 }
  return 0
}

// The words of a text, in order.
function wordsOf(text: String): Array<Word> {
  const words: Array<Word> = []
  const end = text.length
  let from = 0
  let letters = 0
  let at = 1
  for (step of 1..) {
    if (at > end) { break }
    const size = letterAt(text, at)
    if (size == 0) {
      if (letters > 0) { words.push({ from: from, to: at - 1, letters: letters }) }
      letters = 0
      at += 1
    } else {
      if (letters == 0) { from = at }
      letters += 1
      at += size
    }
  }
  if (letters > 0) { words.push({ from: from, to: end, letters: letters }) }
  return words
}

// A word's first letter in small case, where it is a capital of Latin or Cyrillic (Ё too), else as it is: a name
// begins with a capital, the text that speaks of it often doesn't. Its other letters are compared as they stand.
function smallFirst(text: String, word: Word): String {
  const b = text.byte(word.from) ?? 0
  if (b >= 65 && b <= 90) { return String.char(b + 32) }
  if (b == 208) {
    const c = text.byte(word.from + 1) ?? 0
    // А–П (D0 90–9F) to а–п (D0 B0–BF); Р–Я (D0 A0–AF) to р–я (D1 80–8F); Ё (D0 81) to ё (D1 91).
    if (c >= 144 && c <= 159) { return String.char(208) + String.char(c + 32) }
    if (c >= 160 && c <= 175) { return String.char(209) + String.char(c - 32) }
    if (c == 129) { return String.char(209) + String.char(145) }
  }
  return text.sub(word.from, word.from + letterAt(text, word.from) - 1)
}

// A word as it is compared: its first letter small, the rest as it stands, through its `letters` first letters.
function keyOf(text: String, word: Word, letters: Integer): String {
  let at = word.from + letterAt(text, word.from)
  for (n of 2..letters) { at += letterAt(text, at) }
  return smallFirst(text, word) + text.sub(word.from + letterAt(text, word.from), at - 1)
}

// How many of a name's word's letters a word of the text must begin with: all of a short one (three letters or
// fewer, which the language doesn't bend into another word), else all but its last two (one of four letters), where
// the language puts its endings («Бергворт» in «Бергворту», «геомант» in «геомантов»).
function stemOf(letters: Integer): Integer {
  if (letters <= 3) { return letters }
  if (letters == 4) { return 3 }
  return letters - 2
}

// Whether the text's word is the name's word bent: it begins with the name's stem, is the name's word itself where
// that is short, and is at most four letters longer (an ending, not another word).
function bends(text: String, word: Word, name: String, part: Word): Boolean {
  if (word.letters < stemOf(part.letters) || word.letters > part.letters + 4) { return false }
  if (part.letters <= 3 && word.letters != part.letters) { return false }
  const stem = stemOf(part.letters)
  return keyOf(text, word, stem) == keyOf(name, part, stem)
}

// Whether only a space or a hyphen stands between two words of the text, as between the words of a name.
function joined(text: String, before: Word, after: Word): Boolean {
  const gap = text.sub(before.to + 1, after.from - 1)
  return gap == " " || gap == "-" || gap == " - "
}

// Where a name stands in the text, as a span of bytes.
struct Found {
  from: Integer
  to: Integer
  named: Named
}

// The text with each name it speaks of marked as its link, in its ink: the names with the most words first, a name
// found where another already stands left out. A text with the game's own codes in it (`|c…|r`, a link of its own)
// is left as it is: a mark inside one of them would break it.
public function markNames(text: String, names: Array<Named>): String {
  if (text.contains("|")) { return text }
  const words = wordsOf(text)
  const found: Array<Found> = []
  const ordered = names.filter(named => named.name != "")
  ordered.sort((a: Named, b: Named): Boolean => wordsOf(a.name).length > wordsOf(b.name).length)
  for (named of ordered) {
    const parts = wordsOf(named.name)
    if (parts.length == 0) { continue }
    for (i of 1..words.length - parts.length + 1) {
      let fits = true
      for (k of 1..parts.length) {
        const word = words[i + k - 1] ?? panic("a word within the text's")
        const part = parts[k] ?? panic("a word within the name's")
        if (!bends(text, word, named.name, part) || (k > 1 && !joined(text, words[i + k - 2] ?? word, word))) {
          fits = false
          break
        }
      }
      if (!fits) { continue }
      const from = (words[i] ?? panic("a word within the text's")).from
      const to = (words[i + parts.length - 1] ?? panic("a word within the text's")).to
      if (found.any(other => other.from <= to && from <= other.to)) { continue }
      found.push({ from: from, to: to, named: named })
    }
  }
  if (found.length == 0) { return text }
  found.sort((a: Found, b: Found): Boolean => a.from < b.from)
  const pieces: Array<String> = []
  let at = 1
  for (one of found) {
    pieces.push(text.sub(at, one.from - 1))
    const ink = one.named.kind == NamedKind.Item ? ITEM_INK : FIGURE_INK
    pieces.push(`|H${one.named.link}|h|cff${ink}${text.sub(one.from, one.to)}|r|h`)
    at = one.to + 1
  }
  pieces.push(text.sub(at))
  return pieces.join("")
}

// A text on the parchment, its names marked: under the cursor an item's name shows the game's tooltip of it, an NPC's
// or an object's a tip of its lines (who it is to the quest, where it stands).
public class ScrollText implements Component {
  derived marked: String = markNames(self.value, self.names)
  state hovered: Named | nil = nil
  derived tipShown: Boolean = self.hovered != nil
  derived tipTitle: String = self.hovered?.name ?? ""
  derived tipText: String = (self.hovered?.lines ?? []).join("\n")
  // The box the game's tooltip of an item was shown by, hidden there when the cursor leaves the name.
  shownBy: any Frame | nil = nil

  value: Signal<String>
  names: Signal<Array<Named>>
  constructor(value: Signal<String>, names: Signal<Array<Named>> = []) {
    self.value = value
    self.names = names
  }

  onLinkEnter(mut self, hover: Event.LinkHover) {
    const named = (peek self.names).find(one => one.link == hover.link)
    if (named == nil) { return }
    if (named.kind == NamedKind.Item) {
      Game.items.showLink(hover.target, named.link)
      self.shownBy = hover.target
    } else {
      self.hovered = named
    }
  }

  onLinkLeave(mut self) {
    const by = self.shownBy
    if (by != nil) { Game.items.hideAt(by) }
    self.shownBy = nil
    self.hovered = nil
  }

  public render(self): Template {
    return $ltml {
      <box @linkEnter={self.onLinkEnter} @linkLeave={self.onLinkLeave}>
        <text value={self.marked} textColor={SCROLL_INK} leading={SCROLL_LEADING} />
        <Tip $if={self.tipShown} title={self.tipTitle} text={self.tipText} />
      </box>
    }
  }
}
