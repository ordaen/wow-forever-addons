// A quest's page as the game's quest windows show it, the pieces Dialogue's quest page and Quests' log share: the
// scroll (the game's quest parchment tinted to the native gossip window's colour between its rolled ends, dark ink
// only) and, under it in the dark well, its rewards: a row each (its key where it is picked by one, its slot, its name
// in its quality's colour with its slot and type under it, Pawn's column while Pawn is loaded, its sell price, the
// dearest one's in gold), then experience, reputation and money in one band, one size, parted by rules; each section
// under an engraved cut with its title.
import Client from "$client"
import Game from "$game"
import {
  Align, Art, Blend, Columns, Edges, Event, Gaps, Leading, Line, MouseButton, Overflow, Position, Side, TextAlign, Tile, Track
} from "$ltml"
import Runtime from "$runtime"
import {
  BODY_TEXT, Component, Cut, ItemButton, Money, PickRow, Quality, SECONDARY_TEXT, TITLE_TEXT, Tip, TipRow, qualityColor, qualityFrom,
  usableItem
} from "Ordaen"
import Locale from "@/locales"

// On the parchment: the body's ink, a section heading's, and the quest's title's, darkest, in its font's bold face.
public const SCROLL_INK: Color = Color.hex("#160c03")
public const SCROLL_HEAD: Color = Color.hex("#3a1000")
const SCROLL_TITLE: Color = Color.hex("#200800")
// The rule each side of a section's heading: the heading's ink, faded.
const SCROLL_RULE: Color = Color.hex("#3a100080")
const RULE_HEIGHT: Number<Length> = 1.171875dp
const HEADING_ACROSS: Array<Track> = [{ fr: 1 }, "max-content", { fr: 1 }]
// The body's lines on the parchment: as tight as a title's, a written page's (the window's prose stands looser).
public const SCROLL_LEADING: Leading = .Title
// What the parchment holds is read as a page of sentences: a unit over the window's body, as a book's text stands
// larger than its labels.
const SCROLL_TEXT: Number<TextSize> = (BODY_TEXT + 1ui) / BODY_TEXT * 1rem
// The muted ink: still 6:1 on the tinted parchment (≈#d9bb85), the weakest monitor's least; lighter than the ink.
public const SCROLL_DIM: Color = Color.hex("#4a3520")
// In the well.
public const WELL_TEXT: Color = Color.hex("#f0e6d0")
public const WELL_DIM: Color = Color.hex("#a3977f")
public const WELL_RED: Color = Color.hex("#e0301e")
public const WELL_GREEN: Color = Color.hex("#40bf40")
public const WELL_GOLD: Color = Color.hex("#ffd100")
public const WELL_RULE: Line = { width: 1.171875dp, color: Color.hex("#3e2f1d"), sides: [Side.Top] }
public const REWARD_ICON: Number<Length> = 39.84375dp

const BEST: Color = Color.hex("#40ff40")
// A section of the rewards: the cut with its title, then its rows, off the section before.
const SECTION: Edges = { top: 1.5sp, right: 0sp, bottom: 0sp, left: 0sp }
const SECTION_GAP = 1sp
// A section's rows, and its two columns where it has them.
const ROWS_GAP: Gaps = { columns: 4sp, rows: 0.5sp }
// Past this many rows a section stands in two columns where its page asks for them (`paired`), each as wide as its
// widest row: no name is cut, and the page grows for them.
const PAIRED_PAST = 3
const PAIRED: Array<Track> = ["max-content", "max-content"]

function columnsFor(paired: Boolean, rows: Integer): Columns { return paired && rows > PAIRED_PAST ? PAIRED : 1 }
// The rule that parts the band's cells, and the room each keeps on its sides.
const RULE_BEFORE: Line = { width: 1.171875dp, color: Color.hex("#3e2f1d"), sides: [Side.Left] }
const BAND_CELL: Edges = { top: 0sp, right: 3sp, bottom: 0sp, left: 3sp }
// The band's one size, for experience, the reputations and money alike.
const BAND_TEXT: Number<TextSize> = TITLE_TEXT
const KEYCAP: Color = Color.hex("#00000080")
const KEYCAP_EDGE: Line = { width: 1.171875dp, color: Color.hex("#4a3a24") }
const KEY_TEXT: Color = Color.hex("#c9a76a")
const KEYCAP_SMALL = 25.78125dp
const PAWN_WIDTH = 70.3125dp
const WITH_PAWN: Array<Track> = ["max-content", "max-content", { fr: 1 }, PAWN_WIDTH, "max-content"]
const NO_PAWN: Array<Track> = ["max-content", "max-content", { fr: 1 }, "max-content"]
// The game's green arrow of an upgrade, before the best one's word.
const UPGRADE: Atlas = "bags-greenarrow"
const ARROW = 14.0625dp
// The arrow's room and the word, the word at the column's end.
const PAWN_CELLS: Array<Track> = [ARROW, { fr: 1 }]

// The scroll's width, its art's (1024 texels): where it stands, it is about as wide, its rolls barely stretched.
public const SCROLL_WIDTH: Number<Length> = 468.75dp
// Whether what a scroll holds would overflow it at its least height (`SCROLL_ROW`): where it would, a page stands it in
// a column of its own, the page's whole height, beside the rest. An estimate that errs long, so a scroll that fits
// never stands alone needlessly scrolled: its lines at the paper's width with the widest letters (Cyrillic, each
// counted by its bytes, twice a Latin letter), each paragraph starting a line, the title's letters half again as high.
public function scrollOverflows(title: String, texts: Array<String>): Boolean {
  let lines = linesOf(title, TITLE_LETTERS) * 1.5
  for (text of texts) { lines += linesOf(text, LINE_LETTERS) }
  return lines > LEAST_LINES
}

// How many lines a text takes at `letters` a line, each paragraph starting one; none for no text.
function linesOf(text: String, letters: Integer): Integer {
  if (text == "") { return 0 }
  let lines = 0
  for (paragraph of text.split("\n")) { lines += (paragraph.length.max(1) / letters).ceil() }
  return lines
}

// A line of the paper's body letters at the scroll's width, and of its title's; the lines its least height shows.
const LINE_LETTERS = 44
const TITLE_LETTERS = 30
const LEAST_LINES = 4

// The scroll where it stands in a column of its own (a page whose text is long): half again as wide.
public const WIDE_SCROLL: Number<Length> = SCROLL_WIDTH * 1.5

// The scroll's art (art/pieces/scroll.json), in parts that repeat, so it is drawn at any width and height unstretched:
// each roll its two ends with a straight piece of roll repeating across between them, the paper its plain middle
// repeating both ways under its torn edges, which repeat down. A texel of it is the 1024th of the scroll's width.
public struct ScrollParts {
  left: Art
  middle: Art
  right: Art
}
public struct ScrollArt {
  top: ScrollParts
  paper: ScrollParts
  bottom: ScrollParts
  // The sheet's shading and spots, drawn once over the paper's repeating grain, stretched, multiplied into it.
  tone: Art
}
const TEXEL: Number<Length> = SCROLL_WIDTH / 1024
public const SCROLL_ART: ScrollArt = {
  top: {
    left: "@/media/scroll-top-left.tga",
    middle: { file: "@/media/scroll-top-middle.tga", width: 1, height: 128, tile: Tile.Across },
    right: "@/media/scroll-top-right.tga"
  },
  paper: {
    left: { file: "@/media/scroll-paper-left.tga", width: 128, height: 256, tile: Tile.Down },
    middle: { file: "@/media/scroll-paper-middle.tga", width: 256, height: 256, repeatSize: TEXEL * 256 / 1ui },
    right: { file: "@/media/scroll-paper-right.tga", width: 128, height: 256, tile: Tile.Down }
  },
  bottom: {
    left: "@/media/scroll-bottom-left.tga",
    middle: { file: "@/media/scroll-bottom-middle.tga", width: 1, height: 128, tile: Tile.Across },
    right: "@/media/scroll-bottom-right.tga"
  },
  tone: "@/media/scroll-paper-tone.tga"
}
// A roll's ends and its height (their 128 texels), and the roll between them.
const ROLL_HEIGHT: Number<Length> = TEXEL * 128
const ROLL_ACROSS: Array<Track> = [ROLL_HEIGHT, { fr: 1 }, ROLL_HEIGHT]
const ROLL_DOWN: Array<Track> = [{ fr: 1 }]
// The paper's torn edges (128 texels), their inner 24 fading into its middle, which runs on under them that far.
const EDGE_WIDTH: Number<Length> = TEXEL * 128
const UNDER_EDGE: Number<Length> = TEXEL * 104
const ROLLS: Array<Track> = ["max-content", { fr: 1 }, "max-content"]
// The scroll's row where it stands over other things (a quest page's rewards): the room left, never less than four
// rolls' height, about five lines on the paper, so what stands beside it gives way first.
public const SCROLL_ROW: Track = { fr: 1, min: ROLL_HEIGHT * 4 }
// A roll's paper that fades over the paper (32 texels): the paper runs on under both rolls that far.
const FADE_HEIGHT: Number<Length> = TEXEL * 32
const UNDER_FADE: Number<Length> = ROLL_HEIGHT - FADE_HEIGHT
// What stands over what on the scroll: the sheet's shading over the paper's middle, its torn edges over both, and the
// rolls and the text over all of it.
const OVER_GRAIN = 1
const OVER_TONE = 2
const OVER_EDGES = 3
const OVER_PAPER = 4
// Where the text stands on the paper, in the art's measure (not the spacing setting's): in from its torn sides (80
// texels) and a margin past them as wide as a line is high, and off the rolls by half that, past their paper's fade.
const OFF_SIDES: Number<Length> = 60.9375dp
const OFF_ROLLS: Number<Length> = 11.71875dp
const OFF_FADES: Number<Length> = FADE_HEIGHT + OFF_ROLLS
// Folded: the title's row between the rolls, as far in from the torn sides and off the rolls as the text unfolded.
const FOLDED_ROLLS: Array<Track> = ["max-content", "max-content", "max-content"]
const FOLDED_ACROSS: Array<Track> = [OFF_SIDES, { fr: 1 }, OFF_SIDES]
const FOLDED_DOWN: Array<Track> = [OFF_ROLLS, "max-content", OFF_ROLLS]

// The scroll: what is said of a quest on the parchment between its rolls, its title first. It fills the cell it
// stands in, at any width and height (its art repeats), the paper on under both rolls' fading edges; what it holds
// scrolls past the paper's height. The text stands in the paper's box, so it is drawn over the paper and never meets
// a roll (boxes that overlap at one level draw in the client's order). Folded, the rolls stand close round the title
// alone, the scroll as high as that (its row is the holder's: `max-content`, not SCROLL_ROW), and a click on it,
// Enter or Space, unfolds it.
public class Scroll implements Component {
  derived titled: Boolean = self.title != ""

  title: Signal<String>
  folded: mut Signal<Boolean>
  constructor(
    // The quest's name, over what the scroll holds; none: what it holds alone.
    title: Signal<String> = "",
    folded: mut Signal<Boolean> = false
  ) {
    self.title = title
    self.folded = folded
  }

  unfold(mut self) { self.folded = false }

  public render(self): Template {
    return $ltml {
      <box $if={self.folded} rows={FOLDED_ROLLS} @pointerPress={self.unfold} @keyPress(.Enter)={self.unfold}
           @keyPress(.Space)={self.unfold}>
        <ScrollRoll parts={SCROLL_ART.top} />
        <box columns={FOLDED_ACROSS} rows={FOLDED_DOWN} zLevel={OVER_PAPER}>
          <box />
          <box />
          <box />
          <box />
          <ScrollTitle title={self.title} />
        </box>
        <ScrollRoll parts={SCROLL_ART.bottom} />
        <box position={Position.Absolute} left={0dp} right={0dp} top={UNDER_FADE} bottom={UNDER_FADE}>
          <ScrollPaper />
        </box>
      </box>
      <box $else rows={ROLLS}>
        <ScrollRoll parts={SCROLL_ART.top} />
        <box />
        <ScrollRoll parts={SCROLL_ART.bottom} />
        <box position={Position.Absolute} left={0dp} right={0dp} top={UNDER_FADE} bottom={UNDER_FADE}>
          <ScrollPaper />
          <box position={Position.Absolute} left={OFF_SIDES} right={OFF_SIDES} top={OFF_FADES} bottom={OFF_FADES}
               overflow={Overflow.Scroll} gap={1.5sp} zLevel={OVER_PAPER} textSize={SCROLL_TEXT}
               textFont={.Book}>
            <ScrollTitle $if={self.titled} title={self.title} />
            <slot />
          </box>
        </box>
      </box>
    }
  }
}

// A roll of the scroll, over the paper: its ends at their own size, the roll between them repeating across.
class ScrollRoll implements Component {
  const parts: ScrollParts
  constructor(parts: ScrollParts) { self.parts = parts }

  public render(self): Template {
    return $ltml {
      <box height={ROLL_HEIGHT} columns={ROLL_ACROSS} rows={ROLL_DOWN} zLevel={OVER_PAPER}>
        <box background={self.parts.left} />
        <box background={self.parts.middle} />
        <box background={self.parts.right} />
      </box>
    }
  }
}

// The scroll's paper, filling the box it is drawn in: its middle's grain repeating both ways, the sheet's shading
// stretched over it once and multiplied in, and over its sides the torn edges repeating down, their inner texels
// fading into the middle.
class ScrollPaper implements Component {
  public render(self): Template {
    return $ltml {
      <box position={Position.Absolute} left={UNDER_EDGE} right={UNDER_EDGE} top={0dp} bottom={0dp}
           background={SCROLL_ART.paper.middle} zLevel={OVER_GRAIN} />
      <box position={Position.Absolute} left={UNDER_EDGE} right={UNDER_EDGE} top={0dp} bottom={0dp}
           background={SCROLL_ART.tone} blend={Blend.Multiply} zLevel={OVER_TONE} />
      <box position={Position.Absolute} left={0dp} width={EDGE_WIDTH} top={0dp} bottom={0dp}
           background={SCROLL_ART.paper.left} zLevel={OVER_EDGES} />
      <box position={Position.Absolute} right={0dp} width={EDGE_WIDTH} top={0dp} bottom={0dp}
           background={SCROLL_ART.paper.right} zLevel={OVER_EDGES} />
    }
  }
}

// A quest's name at the head of its scroll, in the scroll's heading ink.
class ScrollTitle implements Component {
  title: Signal<String>
  constructor(title: Signal<String>) { self.title = title }

  public render(self): Template {
    return $ltml {
      <text value={self.title} textColor={SCROLL_TITLE} textSize={TITLE_TEXT} leading={.Tight} textFont={.Title}
            textWeight={.Bold} />
    }
  }
}

// A section's heading on the parchment («Objectives»): its title in the middle of a rule, the rule each side of it.
public class ScrollHeading implements Component {
  title: Signal<String>
  constructor(title: Signal<String>) { self.title = title }

  public render(self): Template {
    return $ltml {
      <box columns={HEADING_ACROSS} gap={2sp} yAlign={Align.Center}>
        <box height={RULE_HEIGHT} background={SCROLL_RULE} />
        <text value={self.title} textColor={SCROLL_HEAD} textFont={.Title} textWeight={.Bold} wrap={.None} />
        <box height={RULE_HEIGHT} background={SCROLL_RULE} />
      </box>
    }
  }
}

// A picture the client gave: a file's number or a path.
public function artOf(texture: Number | String | nil): Art | nil {
  if (texture is String) {
    if (texture is Asset) { return texture }
    if (texture is Atlas) { return texture }
    return nil
  }
  if (texture is Number) {
    const id = texture.floor()
    if (id is FileId) { return id }
  }
  return nil
}

public enum RewardKind { Item, Currency, Spell, Title, Skill }

// A reward, to choose or given: an item as the game names it (its slot and type under it, red where the player can't
// wear it; its sell price), a spell learned, a title, a currency, a skill's points.
public struct Reward {
  const kind: RewardKind
  const name: String
  const icon: Art | nil
  const count: Integer
  const quality: Quality
  const item: Integer | nil
  const link: String | nil
  const detail: String
  const unusable: Boolean
  // The item's sell price at a vendor, all of the count; 0 where it sells for nothing.
  const sell: Integer
  // Its place among the quest's choices (`GetQuestReward(index)`); 0 for what is given.
  const index: Integer
  // A currency's number, whose tooltip its slot shows (with the count); none for anything else.
  const currency: Integer | nil = nil
}

// A reputation a quest raises.
public struct Standing {
  const name: String
  const amount: Integer
}

// An item's second line: its slot as the game names it and its type («Waist · Leather»).
function itemDetail(subType: String | nil, slot: String | nil): String {
  const slotName = slot != nil && slot != "" ? Runtime.text(slot) ?? "" : ""
  const kind = subType ?? ""
  if (slotName != "" && kind != "") { return `${slotName} · ${kind}` }
  return slotName != "" ? slotName : kind
}

// An item a quest gives, as the quest's own window names it (its name, icon and link, whether the player can use it),
// with what the item's own data adds: its quality, its slot and type, its sell price.
public function itemReward(
  item: Integer | nil, count: Integer, name: String, icon: Art | nil, usable: Boolean, link: String | nil, index: Integer
): Reward {
  let quality = Quality.Common
  let detail = ""
  let sell = 0
  if (item != nil) {
    const _, _, itemQuality, _, _, _, subType, _, slot, _, price, _, _, _, _, _, _, _ = Client.C_Item.GetItemInfo(item)
    quality = qualityFrom(itemQuality)
    detail = itemDetail(subType, slot)
    sell = (price ?? 0).floor() * count.max(1)
  }
  return {
    kind: .Item, name: name, icon: icon, count: count, quality: quality, item: item, link: link, detail: detail,
    unusable: !usable, sell: sell, index: index
  }
}

// An item a quest in the log gives, all of it read from the item's own data.
public function logReward(item: Integer, count: Integer, index: Integer): Reward {
  const name, link, _, _, _, _, _, _, _, texture, _, _, _, _, _, _, _, _ = Client.C_Item.GetItemInfo(item)
  return itemReward(item, count, name ?? "", artOf(texture), usableItem(item), link, index)
}

// Pawn's word on a reward: «+8%»; nothing for no upgrade.
public function pawnText(percent: Number | nil): String {
  if (percent == nil || percent <= 0) { return "" }
  return `+${(percent * 100).round()}%`
}

// Keycap: the key that picks a line or a reward, in a small dark cap; as big as a reward's icon where it stands
// beside one. An empty key keeps the cap's width alone, so the column holds.
public class Keycap implements Component {
  derived shown: Boolean = self.key != ""

  key: Signal<String>
  size: Signal<Number<Length>>
  constructor(key: Signal<String>, size: Signal<Number<Length>> = KEYCAP_SMALL) {
    self.key = key
    self.size = size
  }

  public render(self): Template {
    return $ltml {
      <box $if={self.shown} width={self.size} height={self.size} background={KEYCAP} border={KEYCAP_EDGE}
           xAlign={Align.Center} yAlign={Align.Center}>
        <text value={self.key} textColor={KEY_TEXT} textSize={SECONDARY_TEXT} textFont={.Numbers} leading={.Tight}
              wrap={.None} />
      </box>
      <box $else width={self.size} height={self.size} />
    }
  }
}

// A reward as its row shows it: Pawn's word on it, and whether it is the best upgrade and the dearest.
public struct RewardView {
  const reward: Reward
  // Pawn's upgrade, 0.15 for 15%; 0 for none.
  const pawn: Number
  const best: Boolean
  const dearest: Boolean
}

// The rows of rewards to choose: Pawn's best upgrade marked, and the dearest at a vendor.
public function choiceViews(rewards: Array<Reward>, upgrades: Array<Number>): Array<RewardView> {
  let best: Number = 0
  let dearest = 0
  for (index, reward of rewards) {
    best = best.max(upgrades[index] ?? 0)
    dearest = dearest.max(reward.sell)
  }
  let views: Array<RewardView> = []
  for (index, reward of rewards) {
    const pawn = upgrades[index] ?? 0
    views.push({ reward: reward, pawn: pawn, best: pawn > 0 && pawn == best, dearest: dearest > 0 && reward.sell == dearest })
  }
  return views
}

// A quest's rewards: those to choose («Choose your reward» where they are chosen, «You will be able to choose»
// before), those given anyway, and the band of experience, reputation and money.
public class Rewards implements Component {
  public choose: Event<Integer> = new Event()

  derived hasChoices: Boolean = self.views.length > 0
  derived hasAlso: Boolean = self.also.length > 0
  derived chooseTitle: String = self.pickable ? Locale.QUEST_CHOOSE_REWARD : Locale.QUEST_CAN_CHOOSE
  derived alsoTitle: String = self.hasChoices ? Locale.QUEST_ALSO_GET : Locale.QUEST_REWARD
  derived banded: Boolean = self.xp > 0 || self.money > 0 || self.standings.length > 0
  // What is given anyway, the band with it: one section under one cut.
  derived received: Boolean = self.hasAlso || self.banded
  derived choiceColumns: Columns = columnsFor(self.paired, self.views.length)
  derived alsoColumns: Columns = columnsFor(self.paired, self.also.length)
  derived bandColumns: Array<Track> = bandOf(self.xp > 0, self.standings.length > 0, self.money > 0)
  derived moneyParted: Boolean = self.xp > 0 || self.standings.length > 0

  views: Signal<Array<RewardView>>
  also: Signal<Array<Reward>>
  xp: Signal<Integer>
  money: Signal<Integer>
  standings: Signal<Array<Standing>>
  pickable: Signal<Boolean>
  choice: Signal<Integer>
  hints: Signal<Boolean>
  pawnColumn: Signal<Boolean>
  // Many rows stand in two columns, the page growing for them (a window's side); else one, whatever their names.
  paired: Signal<Boolean>
  constructor(
    views: Signal<Array<RewardView>>,
    also: Signal<Array<Reward>>,
    xp: Signal<Integer>,
    money: Signal<Integer>,
    standings: Signal<Array<Standing>> = [],
    pickable: Signal<Boolean> = false,
    choice: Signal<Integer> = 0,
    hints: Signal<Boolean> = false,
    pawnColumn: Signal<Boolean> = false,
    paired: Signal<Boolean> = false
  ) {
    self.paired = paired
    self.views = views
    self.also = also
    self.xp = xp
    self.money = money
    self.standings = standings
    self.pickable = pickable
    self.choice = choice
    self.hints = hints
    self.pawnColumn = pawnColumn
  }

  onChoose(mut self, index: Integer) { self.choose.emit(index) }

  public render(self): Template {
    return $ltml {
      <box $if={self.hasChoices} gap={SECTION_GAP} padding={SECTION}>
        <Cut title={self.chooseTitle} />
        <box columns={self.choiceColumns} gap={ROWS_GAP}>
          <RewardRow $for={view of self.views} reward={view.reward} pickable={self.pickable}
                     picked={view.reward.index == self.choice} hints={self.hints} pawnColumn={self.pawnColumn}
                     pawn={view.pawn} best={view.best} dearest={view.dearest} @choose={self.onChoose} />
        </box>
      </box>
      <box $if={self.received} gap={SECTION_GAP} padding={SECTION}>
        <Cut title={self.alsoTitle} />
        <box columns={self.alsoColumns} gap={ROWS_GAP}>
          <RewardRow $for={reward of self.also} reward={reward} />
        </box>
        <box $if={self.banded} padding={{ top: 1sp, bottom: 1sp }} xAlign={Align.Center}>
          <box columns={self.bandColumns} yAlign={Align.Center}>
            <box $if={self.xp > 0} padding={BAND_CELL}>
              <Experience amount={self.xp} textSize={BAND_TEXT} mark={XP_MARK_LARGE} />
            </box>
            <box $if={self.standings.length > 0} padding={BAND_CELL} border={self.xp > 0 ? RULE_BEFORE : nil}>
              <BandStandings standings={self.standings} />
            </box>
            <box $if={self.money > 0} padding={BAND_CELL} border={self.moneyParted ? RULE_BEFORE : nil}>
              <Money amount={self.money} textSize={BAND_TEXT} />
            </box>
          </box>
        </box>
      </box>
    }
  }
}

// The client's own mark of experience (a mission's currency), before an amount of it.
const XP_MARK: Atlas = "GarrMission_CurrencyIcon-Xp"
// The mark beside the body's letters, beside a secondary text's, and beside the band's.
public const XP_MARK_SIZE: Number<Length> = 18.75dp
public const XP_MARK_SMALL: Number<Length> = 16.40625dp
const XP_MARK_LARGE: Number<Length> = 23.4375dp

// An amount of experience a quest gives: the client's mark of it, then the number in the letters Money writes its
// amount in, in one line; the mark says what the number is.
public class Experience implements Component {
  derived text: String = String.of(self.amount)

  amount: Signal<Integer>
  textSize: Signal<Number<TextSize>>
  // The mark's side: as high as the letters of `textSize`.
  mark: Signal<Number<Length>>
  color: Signal<Color>
  constructor(amount: Signal<Integer>, textSize: Signal<Number<TextSize>> = 1rem, mark: Signal<Number<Length>> = XP_MARK_SIZE,
    color: Signal<Color> = WELL_TEXT) {
    self.amount = amount
    self.textSize = textSize
    self.mark = mark
    self.color = color
  }

  public render(self): Template {
    return $ltml {
      <box columns={["max-content", "max-content"]} gap={1sp} yAlign={Align.Center}>
        <box width={self.mark} height={self.mark} background={XP_MARK} />
        <text value={self.text} textColor={self.color} textSize={self.textSize} wrap={.None} />
      </box>
    }
  }
}

// The band's columns: one for each of experience, the reputations and money, each as wide as what it says; the band
// stands centred, as wide as they are, and widens what holds it before it squeezes them.
function bandOf(xp: Boolean, standings: Boolean, money: Boolean): Array<Track> {
  let columns: Array<Track> = []
  const count = (xp ? 1 : 0) + (standings ? 1 : 0) + (money ? 1 : 0)
  for (column of 1..count) { columns.push("max-content") }
  return columns
}

// The reputations in the band's one line: one by its faction's name («+250 Stormwind»), several by the span of their
// amounts and «reputation» («+25–100 reputation», «+25 reputation» where all are the same), each faction then in the
// Tip.
function standingsLine(standings: Array<Standing>): String {
  const first = standings[1]
  if (first == nil) { return "" }
  if (standings.length == 1) { return Locale.QUEST_REPUTATION.format(first.amount, first.name) }
  let least = first.amount
  let most = first.amount
  for (standing of standings) {
    least = least.min(standing.amount)
    most = most.max(standing.amount)
  }
  // The span's end keeps its sign only where its start is a loss: «+25–100», «-25–+100».
  const span = least == most ? "%+d".format(least) : least > 0 ? "%+d–%d".format(least, most) : "%+d–%+d".format(least, most)
  return Locale.QUEST_REPUTATIONS.format(span)
}

// The reputations a quest changes, in one column of the band; under the cursor a Tip with each faction and its amount.
class BandStandings implements Component {
  state hovered = false
  derived text: String = standingsLine(self.standings)
  derived rows: Array<TipRow> = self.standings.map(standing => ({ label: standing.name, value: "%+d".format(standing.amount) }))

  standings: Signal<Array<Standing>>
  constructor(standings: Signal<Array<Standing>>) { self.standings = standings }

  onEnter(mut self) { self.hovered = true }
  onLeave(mut self) { self.hovered = false }

  public render(self): Template {
    return $ltml {
      <box xAlign={Align.Center} @pointerEnter={self.onEnter} @pointerLeave={self.onLeave}>
        <text value={self.text} textColor={WELL_TEXT} textSize={BAND_TEXT} wrap={.None} />
        <Tip $if={self.hovered} title={Locale.QUEST_REPUTATION_TIP} text={""} rows={self.rows} />
      </box>
    }
  }
}

// A quest's reward, one to a row and never wrapped: its key where it is picked by one (as big as its icon), its slot
// (the item's icon, its tooltip under the cursor, Shift+Left-click its link into the chat, Ctrl+Left-click tried on),
// its name in its quality's colour with its slot and type under it (dimmed, red where the player can't wear it), Pawn's
// column while Pawn is loaded (how much better than what is worn, the best with the game's green arrow; empty for no
// upgrade) and its sell price, the dearest one's in gold. A reward to choose is a row the player picks (click, its
// key, or the keyboard's focus and Enter); one given is a row alone.
public class RewardRow implements Component {
  public choose: Event<Integer> = new Event()

  derived columns: Array<Track> = self.pawnColumn ? WITH_PAWN : NO_PAWN
  derived keyed: Boolean = self.hints && self.pickable
  derived key: String = self.reward.index <= 9 ? String.of(self.reward.index) : ""
  derived nameColor: Color = qualityColor(self.reward.quality)
  derived detailColor: Color = self.reward.unusable ? WELL_RED : WELL_DIM
  derived hasDetail: Boolean = self.reward.detail != ""
  derived pawnWord: String = pawnText(self.pawn)
  derived pawnColor: Color = self.best ? BEST : WELL_GREEN
  derived priced: Boolean = self.reward.sell > 0
  derived priceColor: Color = self.dearest ? WELL_GOLD : WELL_DIM
  state pawnHovered = false
  derived pawnTipShown: Boolean = self.pawnHovered && self.pawnWord != ""
  derived pawnTip: String = Locale.QUEST_PAWN_TIP.format(((self.pawn ?? 0) * 100).round())

  reward: Signal<Reward>
  pickable: Signal<Boolean>
  picked: Signal<Boolean>
  hints: Signal<Boolean>
  pawnColumn: Signal<Boolean>
  pawn: Signal<Number | nil>
  best: Signal<Boolean>
  dearest: Signal<Boolean>
  constructor(
    reward: Signal<Reward>,
    // A reward to choose on the page where it is chosen.
    pickable: Signal<Boolean> = false,
    picked: Signal<Boolean> = false,
    hints: Signal<Boolean> = false,
    pawnColumn: Signal<Boolean> = false,
    pawn: Signal<Number | nil> = nil,
    best: Signal<Boolean> = false,
    dearest: Signal<Boolean> = false
  ) {
    self.reward = reward
    self.pickable = pickable
    self.picked = picked
    self.hints = hints
    self.pawnColumn = pawnColumn
    self.pawn = pawn
    self.best = best
    self.dearest = dearest
  }

  // A plain click picks; one with Shift or Ctrl is the slot's (a link, a try-on), never a pick.
  onPick(mut self) {
    if (peek self.pickable && !Game.input.shiftDown() && !Game.input.controlDown()) {
      self.choose.emit((peek self.reward).index)
    }
  }

  // Ctrl+click on the slot tries the item on, as the game's own reward does; Shift's link the slot puts in the chat
  // itself.
  onSlot(mut self, press: Event.Press) {
    const link = (peek self.reward).link
    if (press.button == MouseButton.Left && Game.input.controlDown() && link != nil) { _ = Client.DressUpItemLink(link) }
  }

  onPawnEnter(mut self) { self.pawnHovered = true }
  onPawnLeave(mut self) { self.pawnHovered = false }

  public render(self): Template {
    return $ltml {
      <PickRow $if={self.pickable} columns={self.columns} picked={self.picked} @pick={self.onPick}>
        <RewardCells reward={self.reward} keyed={self.keyed} key={self.key} nameColor={self.nameColor}
                     detailColor={self.detailColor} hasDetail={self.hasDetail} pawnColumn={self.pawnColumn}
                     pawnWord={self.pawnWord} pawnColor={self.pawnColor} pawnTipShown={self.pawnTipShown}
                     pawnTip={self.pawnTip} best={self.best} priced={self.priced} priceColor={self.priceColor}
                     @slot={self.onSlot} @pawnEnter={self.onPawnEnter} @pawnLeave={self.onPawnLeave} />
      </PickRow>
      <box $else columns={self.columns} gap={1sp} yAlign={Align.Center} padding={1sp}>
        <RewardCells reward={self.reward} keyed={false} key={""} nameColor={self.nameColor}
                     detailColor={self.detailColor} hasDetail={self.hasDetail} pawnColumn={self.pawnColumn}
                     pawnWord={self.pawnWord} pawnColor={self.pawnColor} pawnTipShown={self.pawnTipShown}
                     pawnTip={self.pawnTip} best={self.best} priced={self.priced} priceColor={self.priceColor}
                     @slot={self.onSlot} @pawnEnter={self.onPawnEnter} @pawnLeave={self.onPawnLeave} />
      </box>
    }
  }
}

// A reward row's cells, the same in a row picked from and in one given.
class RewardCells implements Component {
  public slot: Event<Event.Press> = new Event()
  public pawnEnter: Event<nil> = new Event()
  public pawnLeave: Event<nil> = new Event()

  reward: Signal<Reward>
  keyed: Signal<Boolean>
  key: Signal<String>
  nameColor: Signal<Color>
  detailColor: Signal<Color>
  hasDetail: Signal<Boolean>
  pawnColumn: Signal<Boolean>
  pawnWord: Signal<String>
  pawnColor: Signal<Color>
  pawnTipShown: Signal<Boolean>
  pawnTip: Signal<String>
  best: Signal<Boolean>
  priced: Signal<Boolean>
  priceColor: Signal<Color>
  constructor(
    reward: Signal<Reward>, keyed: Signal<Boolean>, key: Signal<String>, nameColor: Signal<Color>,
    detailColor: Signal<Color>, hasDetail: Signal<Boolean>, pawnColumn: Signal<Boolean>, pawnWord: Signal<String>,
    pawnColor: Signal<Color>, pawnTipShown: Signal<Boolean>, pawnTip: Signal<String>, best: Signal<Boolean>, priced: Signal<Boolean>,
    priceColor: Signal<Color>
  ) {
    self.reward = reward
    self.keyed = keyed
    self.key = key
    self.nameColor = nameColor
    self.detailColor = detailColor
    self.hasDetail = hasDetail
    self.pawnColumn = pawnColumn
    self.pawnWord = pawnWord
    self.pawnColor = pawnColor
    self.pawnTipShown = pawnTipShown
    self.pawnTip = pawnTip
    self.best = best
    self.priced = priced
    self.priceColor = priceColor
  }

  onSlot(mut self, press: Event.Press) { self.slot.emit(press) }
  onPawnEnter(mut self) { self.pawnEnter.emit() }
  onPawnLeave(mut self) { self.pawnLeave.emit() }

  public render(self): Template {
    return $ltml {
      <Keycap $if={self.keyed} key={self.key} size={REWARD_ICON} />
      <box $else />
      <ItemButton item={self.reward.item} count={self.reward.count} quality={self.reward.quality} art={self.reward.icon}
                  currency={self.reward.currency} size={REWARD_ICON} @pressed={self.onSlot} />
      <box gap={0.25sp}>
        <text value={self.reward.name} textColor={self.nameColor} wrap={.None} />
        <text $if={self.hasDetail} value={self.reward.detail} textColor={self.detailColor} textSize={SECONDARY_TEXT}
              wrap={.None} />
      </box>
      <box $if={self.pawnColumn} columns={PAWN_CELLS} gap={1sp} yAlign={Align.Center}
           @pointerEnter={self.onPawnEnter} @pointerLeave={self.onPawnLeave}>
        <box width={ARROW} height={ARROW} background={UPGRADE} opacity={self.best ? 1 : 0} />
        <text value={self.pawnWord} textColor={self.pawnColor} textSize={SECONDARY_TEXT} textFont={.Numbers}
              textAlign={TextAlign.End} wrap={.None} />
        <Tip $if={self.pawnTipShown} title={"Pawn"} text={self.pawnTip} />
      </box>
      <box xAlign={Align.End}>
        <Money $if={self.priced} amount={self.reward.sell} color={self.priceColor} />
      </box>
    }
  }
}
