// A quest's scroll folded and unfolded; its rewards' band of experience, reputation and money in one size.
import Test from "$test"
import { Quality } from "Ordaen"
import Locale from "@/locales"
import { Reward, Rewards, SCROLL_ART, SCROLL_ROW, SCROLL_WIDTH, Scroll, ScrollHeading, Standing } from "@/questPage"

function given(name: String): Reward {
  return {
    kind: .Title, name: name, icon: nil, count: 1, quality: Quality.Common, item: nil, link: nil, detail: "",
    unusable: false, sell: 0, index: 0
  }
}

class Page {
  public state also: Array<Reward> = [given("One"), given("Two"), given("Three"), given("Four")]
  public state standings: Array<Standing> = [{ name: "Stormwind", amount: 250 }]

  public render(self): Template {
    return $ltml {
      <box width={500dp}>
        <Rewards views={[]} also={self.also} xp={1200} money={0} standings={self.standings} />
      </box>
    }
  }
}

class Parchment {
  public state folded = true

  public render(self): Template {
    return $ltml {
      <box width={SCROLL_WIDTH} rows={[SCROLL_ROW]}>
        <Scroll title={"The Defias Brotherhood"} folded={mut self.folded}>
          <text value={"Find the Defias hideout."} />
        </Scroll>
      </box>
    }
  }
}

test "a folded scroll holds its title alone between close rolls, and a click on it unfolds it" {
  const page = new Parchment()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 600 })
  const title = Test.page().text("The Defias Brotherhood").rect()
  Test.expect(Test.page().texts().filter(text => text == "Find the Defias hideout.").length == 0)
  const bottom = Test.edges(SCROLL_ART.bottom.left, 0)
  Test.expect(bottom.top - title.bottom < 30)
  Test.page().text("The Defias Brotherhood").click()
  Test.expect(!page.folded)
  Test.expect(Test.page().text("Find the Defias hideout.").rect().top > Test.page().text("The Defias Brotherhood").rect().bottom)
  destroy page
}

class WideParchment {
  public state folded = false

  public render(self): Template {
    return $ltml {
      <box width={SCROLL_WIDTH * 2} rows={[SCROLL_ROW]}>
        <Scroll title={"The Defias Brotherhood"} folded={mut self.folded}>
          <text value={"Find the Defias hideout."} />
        </Scroll>
      </box>
    }
  }
}

test "in a place twice its art's width the scroll fills it, its rolls' ends at their own size, the roll between them" {
  const page = new WideParchment()
  Test.mount(page, { left: 0, top: 0, width: 1400, height: 600 })
  const art = SCROLL_WIDTH / 1ui
  const left = Test.edges(SCROLL_ART.top.left, 0)
  const middle = Test.edges(SCROLL_ART.top.middle, 0)
  const right = Test.edges(SCROLL_ART.top.right, 0)
  // An end is 128 of the art's 1024 texels, square; the roll runs from one end to the other, as high.
  Test.expect((left.right - left.left - art / 8).abs() < 0.5 && (left.bottom - left.top - art / 8).abs() < 0.5)
  Test.expect((right.right - left.left - art * 2).abs() < 0.5)
  Test.expect((middle.left - left.right).abs() < 0.5 && (right.left - middle.right).abs() < 0.5)
  Test.expect((middle.top - left.top).abs() < 0.5 && (middle.bottom - left.bottom).abs() < 0.5)
  // The paper's middle reaches under its torn edges, which stand at the scroll's sides.
  const paper = Test.edges(SCROLL_ART.paper.middle, 0)
  const edge = Test.edges(SCROLL_ART.paper.left, 0)
  Test.expect((edge.left - left.left).abs() < 0.5 && paper.left < edge.right && paper.left > edge.left)
  destroy page
}

class Heading {
  public render(self): Template {
    return $ltml {
      <box width={400ui}>
        <ScrollHeading title={"Objectives"} />
      </box>
    }
  }
}

test "a section's heading on the parchment stands in the middle of its rule, the rule each side of it" {
  const page = new Heading()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 600 })
  const title = Test.page().text("Objectives").rect()
  Test.expect(((title.left + title.right) / 2 - 200).abs() < 1 && title.left > 50)
  destroy page
}

test "the band says experience and reputation in one size" {
  const page = new Page()
  Test.mount(page, { left: 0, top: 0, width: 600, height: 600 })
  const xp = Test.page().text("1200").rect()
  const standing = Test.page().text(Locale.QUEST_REPUTATION.format(250, "Stormwind")).rect()
  Test.expect(((xp.bottom - xp.top) - (standing.bottom - standing.top)).abs() < 0.5)
  destroy page
}
